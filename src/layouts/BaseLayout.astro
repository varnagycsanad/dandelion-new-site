    <script>
      (() => {
        const buildMailtoHref = (localPart, domain) => `mailto:${localPart}@${domain}`;

        const initMailtoLinks = () => {
          const mailtoLinks = document.querySelectorAll("[data-mailto-local][data-mailto-domain]");

          mailtoLinks.forEach((link) => {
            if (!(link instanceof HTMLAnchorElement)) {
              return;
            }

            const localPart = link.dataset.mailtoLocal;
            const domain = link.dataset.mailtoDomain;

            if (!localPart || !domain) {
              return;
            }

            const mailtoHref = buildMailtoHref(localPart, domain);
            link.addEventListener("click", (event) => {
              event.preventDefault();
              window.location.href = mailtoHref;
            });
          });
        };

        const initHeader = () => {
          const header = document.querySelector("[data-dnd-header]");
          const toggles = document.querySelectorAll("[data-dnd-menu-toggle]");
          const languageToggle = document.querySelector("[data-dnd-language-toggle]");
          const languagePopover = document.querySelector("[data-dnd-language-popover]");
          const mobileMenu = document.querySelector("[data-dnd-mobile-menu]");
          const quickContact = document.querySelector("[data-dnd-quick-contact]");
          const quickContactToggle = document.querySelector("[data-dnd-quick-contact-toggle]");

          if (!header) {
            return;
          }

          let headerScrollFrame = 0;
          let isHeaderScrolled = false;

          const applyHeaderScrollState = () => {
            headerScrollFrame = 0;
            const nextScrolled = window.scrollY > 24;

            if (nextScrolled === isHeaderScrolled) {
              return;
            }

            isHeaderScrolled = nextScrolled;
            header.classList.toggle("is-scrolled", nextScrolled);
          };

          const queueHeaderScrollState = () => {
            if (headerScrollFrame) {
              return;
            }

            headerScrollFrame = window.requestAnimationFrame(applyHeaderScrollState);
          };

          applyHeaderScrollState();
          window.addEventListener("scroll", queueHeaderScrollState, { passive: true });

          toggles.forEach((toggle) => {
            toggle.addEventListener("click", () => {
              const isOpen = header.classList.toggle("is-menu-open");
              toggles.forEach((item) => item.setAttribute("aria-expanded", String(isOpen)));
              mobileMenu?.setAttribute("data-open", String(isOpen));
              languageToggle?.setAttribute("aria-expanded", "false");
              languagePopover?.setAttribute("data-open", "false");
            });
          });

          languageToggle?.addEventListener("click", () => {
            const isOpen = languageToggle.getAttribute("aria-expanded") !== "true";
            languageToggle.setAttribute("aria-expanded", String(isOpen));
            languagePopover?.setAttribute("data-open", String(isOpen));
          });

          quickContactToggle?.addEventListener("click", () => {
            const isOpen = quickContact?.classList.toggle("is-open") ?? false;
            quickContactToggle.setAttribute("aria-expanded", String(isOpen));
          });
        };

        const playAutoplayVideo = (video) => {
          video.muted = true;
          video.defaultMuted = true;
          video.autoplay = true;
          video.playsInline = true;
          video.controls = false;
          video.disableRemotePlayback = true;
          if ("disablePictureInPicture" in video) {
            video.disablePictureInPicture = true;
          }
          video.setAttribute("muted", "");
          video.setAttribute("autoplay", "");
          video.setAttribute("playsinline", "");
          video.setAttribute("webkit-playsinline", "");
          video.setAttribute("disableremoteplayback", "");
          video.setAttribute("disablepictureinpicture", "");
          video.removeAttribute("controls");
          video.dataset.dndAutoplayState = "pending";

          const playback = video.play();

          if (playback && typeof playback.catch === "function") {
            playback.catch(() => {
              video.dataset.dndAutoplayState = "blocked";
              video.controls = false;
              video.removeAttribute("controls");

              if (video.readyState < 2) {
                video.addEventListener("canplay", () => playAutoplayVideo(video), { once: true });
              }
            });
            playback.then(() => {
              video.dataset.dndAutoplayState = "playing";
            });
          } else if (!video.paused) {
            video.dataset.dndAutoplayState = "playing";
          }
        };

        const initAutoplayVideos = () => {
          const videos = document.querySelectorAll("video[autoplay]");

          videos.forEach((video) => {
            if (!(video instanceof HTMLVideoElement)) {
              return;
            }

            playAutoplayVideo(video);
          });

          document.addEventListener("visibilitychange", () => {
            if (document.visibilityState !== "visible") {
              return;
            }

            videos.forEach((video) => {
              if (video instanceof HTMLVideoElement && video.paused) {
                playAutoplayVideo(video);
              }
            });
          });
        };

        const boot = () => {
          initMailtoLinks();
          initHeader();
          initAutoplayVideos();
        };

        if (document.readyState === "loading") {
          window.addEventListener("DOMContentLoaded", boot, { once: true });
        } else {
          boot();
        }
      })();
    </script>
