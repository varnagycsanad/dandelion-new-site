---
import "../styles/global.css";
import { accommodations } from "../data/accommodations";
import SiteFooter from "../components/SiteFooter.astro";

interface Props {
  title?: string;
  description?: string;
  hideHeader?: boolean;
  hideFooter?: boolean;
}

const {
  title = "Dandelion Vendégházak",
  description = "Természetközeli szállások a Balaton-felvidéken."
} = Astro.props;

const { hideHeader = false, hideFooter = false } = Astro.props;

const quickContacts = [
  { label: "Telefon", href: "tel:+36207730807", shortLabel: "TEL" },
  { label: "E-mail", href: "mailto:hello@dandelionhouse.hu", shortLabel: "MAIL" },
  { label: "WhatsApp", href: "https://wa.me/36207730807", shortLabel: "WA" }
];

const homeHref = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const staysHref = `${homeHref}#stays`;
const experiencesHref = `${homeHref}#elmenyek`;
const stayLabelOverrides: Record<string, string> = {
  fugehaz: "Dandelion Fügeház",
  "vintage-vendeghaz": "Dandelion Vintage",
};
const resolveLocalStayHref = (href: string) =>
  href.startsWith("/") ? `${homeHref}${href.replace(/^\/+/, "")}` : href;
const buildStayHref = (slug: string, url: string) =>
  slug === "dandelion-d2"
    ? `${homeHref}dandelion-d2/`
    : slug === "fugehaz"
      ? `${homeHref}fuge/`
      : slug === "royal-homes"
        ? `${homeHref}dandelion-royal-homes/`
        : resolveLocalStayHref(url);
const stayLinkMap = new Map(
  accommodations.map((stay) => [
    stay.slug,
    {
      label: stayLabelOverrides[stay.slug] ?? stay.name,
      href: buildStayHref(stay.slug, stay.url)
    }
  ])
);
const groupedStayLinks = [
  {
    title: "Tapolcai-medence",
    items: [
      stayLinkMap.get("dandelion-d2"),
      stayLinkMap.get("fugehaz"),
      stayLinkMap.get("dandelion-d1"),
      stayLinkMap.get("szololiget-vendeghaz"),
      stayLinkMap.get("zsalya-vendeghaz"),
      stayLinkMap.get("vintage-vendeghaz")
    ].filter(Boolean)
  },
  {
    title: "Balaton mellett",
    items: [
      stayLinkMap.get("royal-homes"),
      stayLinkMap.get("szepvolgyi-vendeghaz")
    ].filter(Boolean)
  },
  {
    title: "Káli-medence",
    items: [
      {
        label: "Dandelion Köveskál",
        href: `${homeHref}dandelion-koveskal/`
      }
    ]
  }
];
---

<!DOCTYPE html>
<html lang="hu">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="https://dandelionhouse.hu/wp-content/uploads/2025/02/cropped-Reklam-anyagok-a-hazakhoz.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
    <slot name="head" />
  </head>
  <body>
    {!hideHeader && <header class="dnd-header" data-dnd-header>
      <div class="dnd-container dnd-header__desktop">
        <div class="dnd-header__top">
          <div class="dnd-header__contact" aria-label="Kapcsolat">
            <a href="tel:+36207730807" aria-label="Telefon">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M6.6 10.8c1.5 3 3.6 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1.1-.3 1.2.4 2.4.6 3.7.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.7 21 3 13.3 3 3.8c0-.6.4-1 1-1h3.6c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.7.1.4 0 .8-.3 1.1l-2.3 2.2Z" />
              </svg>
            </a>
            <a href="mailto:hello@dandelionhouse.hu" aria-label="E-mail">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M4.5 6.5h15c.8 0 1.5.7 1.5 1.5v8.5c0 .8-.7 1.5-1.5 1.5h-15c-.8 0-1.5-.7-1.5-1.5V8c0-.8.7-1.5 1.5-1.5Z" />
                <path d="m4 8 8 5.4L20 8" />
              </svg>
            </a>
            <a href="https://wa.me/36207730807" target="_blank" rel="noopener noreferrer" aria-label="WhatsApp">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M4.2 20 5.4 16.5A8.2 8.2 0 1 1 8 19l-3.8 1Z" />
                <path d="M9.1 8.4c.2-.4.4-.4.7-.4h.5c.2 0 .4.1.5.4l.7 1.6c.1.2.1.4 0 .6l-.5.6c-.1.1-.1.3 0 .5.5.9 1.3 1.7 2.2 2.2.2.1.4.1.5 0l.7-.6c.2-.1.4-.2.6-.1l1.6.8c.3.1.4.3.4.6v.5c0 .3-.1.5-.4.7-.5.3-1.2.5-1.9.4-3.4-.5-6.1-3.2-6.6-6.6-.1-.7.1-1.3.4-1.8Z" />
              </svg>
            </a>
          </div>

          <a href={homeHref} class="dnd-logo" aria-label="Dandelion Vendégházak">
            <img src="https://dandelionhouse.hu/wp-content/uploads/2026/02/DND-Vendeghaz-logo-fejslec-2.png" alt="Dandelion Vendégházak" />
          </a>

          <div class="dnd-header__actions">
            <nav class="dnd-language" aria-label="Nyelvváltó">
              <a href="/" aria-current="page">HU</a>
              <a href="/en">EN</a>
              <a href="/de">DE</a>
            </nav>
            <a
              href="https://ibe.sabeeapp.com/v3/p/Dandelion-Vendeghazak?p=3970b30e1042d58f"
              class="dnd-header-cta"
              target="_blank"
              rel="noopener noreferrer"
            >
              <span>Foglalás / Árak</span>
              <small>Elérhetőség ellenőrzése</small>
            </a>
          </div>
        </div>

        <nav class="dnd-nav" aria-label="Fő navigáció">
          <a href={homeHref}>Főoldal</a>
          <div class="dnd-nav__item dnd-nav__item--has-submenu">
            <a href={staysHref}>Szállások–Házak</a>
            <div class="dnd-nav__submenu" aria-label="Szállások almenü">
              {groupedStayLinks.map((group) => (
                <div class="dnd-nav__submenu-group">
                  <span class="dnd-nav__submenu-group-title">{group.title}</span>
                  <div class="dnd-nav__submenu-group-items">
                    {group.items.map((stay) => (
                      <a href={stay.href}>{stay.label}</a>
                    ))}
                  </div>
                </div>
              ))}
            </div>
          </div>
          <a href={experiencesHref}>Élmények</a>
          <a href="/">Galéria</a>
        </nav>
      </div>

      <div class="dnd-container dnd-header__mobile">
        <a href={homeHref} class="dnd-logo dnd-logo--mobile" aria-label="Dandelion Vendégházak">
          <img src="https://dandelionhouse.hu/wp-content/uploads/2026/02/DND-Vendeghaz-logo-fejslec-2.png" alt="Dandelion Vendégházak" />
        </a>

        <div class="dnd-header__mobile-actions">
          <a
            href="https://ibe.sabeeapp.com/v3/p/Dandelion-Vendeghazak?p=3970b30e1042d58f"
            class="dnd-header-cta dnd-header-cta--mobile"
            target="_blank"
            rel="noopener noreferrer"
          >
            Foglalás / Árak
          </a>
          <button class="dnd-menu-toggle" type="button" aria-label="Menü megnyitása" aria-expanded="false" data-dnd-menu-toggle>
            <span></span>
            <span></span>
            <span></span>
          </button>
        </div>
      </div>

      <nav class="dnd-mobile-menu" aria-label="Mobil navigáció" data-dnd-mobile-menu>
        <a href={homeHref}>Főoldal</a>
        <a href={staysHref}>Szállások–Házak</a>
        <div class="dnd-mobile-menu__groups" aria-label="Szálláscsoportok">
          {groupedStayLinks.map((group) => (
            <div class="dnd-mobile-menu__group">
              <span class="dnd-mobile-menu__group-title">{group.title}</span>
              <div class="dnd-mobile-menu__group-items">
                {group.items.map((stay) => (
                  <a href={stay.href} class="dnd-mobile-menu__subitem">{stay.label}</a>
                ))}
              </div>
            </div>
          ))}
        </div>
        <a href={experiencesHref}>Élmények</a>
        <a href="/">Galéria</a>
      </nav>
    </header>}

    <main>
      <slot />
    </main>

    {!hideFooter && <SiteFooter />}

    {!hideHeader && <div class="dnd-quick-contact" data-dnd-quick-contact>
      <div class="dnd-quick-contact__panel" data-dnd-quick-contact-panel>
        {quickContacts.map((item) => (
          <a href={item.href} class="dnd-quick-contact__item">
            <span>{item.shortLabel}</span>
            {item.label}
          </a>
        ))}
      </div>
      <button class="dnd-quick-contact__toggle" type="button" aria-label="Gyors kapcsolat megnyitása" aria-expanded="false" data-dnd-quick-contact-toggle>
        Kapcsolat
      </button>
    </div>}

    <script>
      (() => {
        const header = document.querySelector("[data-dnd-header]");
        const toggle = document.querySelector("[data-dnd-menu-toggle]");
        const mobileMenu = document.querySelector("[data-dnd-mobile-menu]");
        const quickContact = document.querySelector("[data-dnd-quick-contact]");
        const quickContactToggle = document.querySelector("[data-dnd-quick-contact-toggle]");

        if (!header) return;

        const updateHeader = () => {
          header.classList.toggle("is-scrolled", window.scrollY > 24);
        };

        updateHeader();
        window.addEventListener("scroll", updateHeader, { passive: true });

        toggle?.addEventListener("click", () => {
          const isOpen = header.classList.toggle("is-menu-open");
          toggle.setAttribute("aria-expanded", String(isOpen));
          mobileMenu?.setAttribute("data-open", String(isOpen));
        });

        quickContactToggle?.addEventListener("click", () => {
          const isOpen = quickContact?.classList.toggle("is-open") ?? false;
          quickContactToggle.setAttribute("aria-expanded", String(isOpen));
        });
      })();
    </script>
    <style>
      .dnd-nav__submenu {
        min-width: 280px;
        gap: 12px;
      }

      .dnd-nav__submenu-group + .dnd-nav__submenu-group {
        padding-top: 10px;
        border-top: 1px solid rgba(94, 65, 39, 0.08);
      }

      .dnd-nav__submenu-group-title {
        display: block;
        margin: 0 10px 6px;
        color: rgba(45, 36, 28, 0.52);
        font-size: 0.63rem;
        font-weight: 600;
        letter-spacing: 0.16em;
        line-height: 1.45;
        text-transform: uppercase;
      }

      .dnd-nav__submenu-group-items {
        display: grid;
        gap: 4px;
      }

      .dnd-mobile-menu__groups {
        display: grid;
        gap: 14px;
      }

      .dnd-mobile-menu__group {
        display: grid;
        gap: 6px;
      }

      .dnd-mobile-menu__group + .dnd-mobile-menu__group {
        padding-top: 10px;
        border-top: 1px solid rgba(45, 36, 28, 0.1);
      }

      .dnd-mobile-menu__group-title {
        display: block;
        color: rgba(45, 36, 28, 0.52);
        font-size: 0.58rem;
        font-weight: 600;
        letter-spacing: 0.18em;
        line-height: 1.45;
        text-transform: uppercase;
      }

      .dnd-mobile-menu__group-items {
        display: grid;
        gap: 4px;
      }

      .dnd-mobile-menu[data-open="true"] {
        max-height: 560px;
      }
    </style>
  </body>
</html>
