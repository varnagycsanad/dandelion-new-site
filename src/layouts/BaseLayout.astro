  { label: "WhatsApp", href: "https://wa.me/36207730807", shortLabel: "WA" }
];

const bookingLanguage = isEnglishPage || isGermanPage || isCzechPage ? "En" : "Hu";
const bookingHref = `https://ibe.sabeeapp.com/v3/p/Dandelion-Vendégházak?p=3970b30e1042d58f&lang=${bookingLanguage}`;
const bookingTarget = "_blank";
const bookingRel = "noopener noreferrer";
const stayLabelOverrides: Record<string, string> = {
  fugehaz: "Dandelion Fügeház",
  "vintage-vendeghaz": "Dandelion Vintage",
};
const resolveLocalStayHref = (href: string) =>
  href.startsWith("/") ? `${homeHref}${href.replace(/^\/+/, "")}` : href;
const buildStayHref = (slug: string, url: string) =>
  slug === "dandelion-d2"
    ? `${homeHref}dandelion-d2/`
    : slug === "fugehaz"
      ? `${homeHref}fuge/`
      : slug === "royal-homes"
        ? `${homeHref}royal/`
        : resolveLocalStayHref(url);
const stayLinkMap = new Map(
  accommodations.map((stay) => [
    stay.slug,
    {
      label: stayLabelOverrides[stay.slug] ?? stay.name,
      href: buildStayHref(stay.slug, stay.url)
    }
  ])
);
const groupedStayLinks = [
  {
    title: "Tapolcai-medence",
    items: [
      stayLinkMap.get("dandelion-d2"),
      stayLinkMap.get("fugehaz"),
      stayLinkMap.get("dandelion-d1"),
      stayLinkMap.get("szololiget-vendeghaz"),
      stayLinkMap.get("zsalya-vendeghaz"),
      stayLinkMap.get("vintage-vendeghaz")
