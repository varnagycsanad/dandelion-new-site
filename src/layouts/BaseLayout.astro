      mobileNavAria: "Mobile navigation",
      mobileStayGroupsAria: "Accommodation groups",
      menuOpenAria: "Open menu",
      quickContactOpenAria: "Open quick contact",
      quickContactLabel: "Contact"
    }
  : isGermanPage
    ? {
        contactAria: "Kontakt",
        phoneAria: "Telefon",
        languageAria: "Sprachwechsel",
        bookingLabel: "Buchung / Preise",
        bookingShortLabel: "Buchen",
        bookingSmallLabel: "Verfügbarkeit prüfen",
