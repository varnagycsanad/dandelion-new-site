---
import "../styles/global.css";
import { accommodations } from "../data/accommodations";
import SiteFooter from "../components/SiteFooter.astro";
import {
  SITE_DEFAULT_DESCRIPTION,
  SITE_DEFAULT_DESCRIPTION_EN,
  SITE_DEFAULT_OG_IMAGE,
  SITE_DEFAULT_TITLE,
  SITE_NAME,
  getCanonicalPath,
  getLocalizedRouteAlternates,
  isCanonicalAliasPath,
  normalizePathname,
  toAbsoluteUrl
} from "../data/site-seo";

// [CHANGE 2026-05-19 00:00] Minimal locale props added for the first English entry point without changing Hungarian defaults.

interface Props {
  title?: string;
  description?: string;
  hideHeader?: boolean;
  hideFooter?: boolean;
  canonicalPath?: string;
  ogImage?: string;
  ogImageAlt?: string;
  noindex?: boolean;
  lang?: "hu" | "en" | "de" | "sk" | "pl" | "cs";
  ogLocale?: string;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
  headerMode?: "auto" | "transparent" | "solid";
}

const {
  title = SITE_DEFAULT_TITLE,
  description = SITE_DEFAULT_DESCRIPTION,
  canonicalPath,
  ogImage = SITE_DEFAULT_OG_IMAGE,
  ogImageAlt = title,
  noindex = false,
  lang = "hu",
  ogLocale,
  structuredData = [],
  headerMode = "auto"
} = Astro.props;

const { hideHeader = false, hideFooter = false } = Astro.props;
const normalizedCurrentPath = normalizePathname(Astro.url.pathname);
const resolvedCanonicalPath = canonicalPath ? normalizePathname(canonicalPath) : getCanonicalPath(normalizedCurrentPath);
const canonicalUrl = toAbsoluteUrl(resolvedCanonicalPath);
const resolvedOgImage = toAbsoluteUrl(ogImage);
const shouldNoindex = noindex || isCanonicalAliasPath(normalizedCurrentPath);
const robotsContent = shouldNoindex ? "noindex,follow" : "index,follow";
const alternateLinks = shouldNoindex
  ? []
  : getLocalizedRouteAlternates(resolvedCanonicalPath).map((alternate) => ({
      hreflang: alternate.hreflang,
      href: toAbsoluteUrl(alternate.path)
    }));
const structuredDataItems = Array.isArray(structuredData) ? structuredData : [structuredData];
const defaultOgLocaleByLang: Record<NonNullable<Props["lang"]>, string> = {
  hu: "hu_HU",
  en: "en_US",
  de: "de_DE",
  sk: "sk_SK",
  pl: "pl_PL",
  cs: "cs_CZ"
};
const schemaLanguageByLang: Record<NonNullable<Props["lang"]>, string> = {
  hu: "hu-HU",
  en: "en-US",
  de: "de-DE",
  sk: "sk-SK",
  pl: "pl-PL",
  cs: "cs-CZ"
};
const resolvedOgLocale = ogLocale ?? defaultOgLocaleByLang[lang];
const schemaLanguage = schemaLanguageByLang[lang];
const isEnglishPage = lang === "en";
const homeHref = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const emailLocalPart = "hello";
const emailDomain = "dandelionhouse.hu";
const contactPageHref = isEnglishPage ? `${homeHref}en/contact/` : `${homeHref}kapcsolat/`;
const headerHomeHref = isEnglishPage ? `${homeHref}en/` : homeHref;
const headerStaysHref = isEnglishPage ? `${homeHref}en/szallasok/` : `${homeHref}szallasok/`;
const headerExperiencesHref = isEnglishPage ? `${homeHref}en/experiences/` : `${homeHref}elmenyek/`;
const headerGalleryHref = isEnglishPage ? `${homeHref}en/#gallery` : homeHref;
const headerText = isEnglishPage
  ? {
      contactAria: "Contact",
      phoneAria: "Phone",
      languageAria: "Language switcher",
      bookingLabel: "Booking / Prices",
      bookingShortLabel: "Book now",
      bookingSmallLabel: "Check availability",
      bookingAria: "Booking and prices",
      mainNavAria: "Main navigation",
      homeLabel: "Home",
      staysLabel: "Accommodations",
      experiencesLabel: "Experiences",
      galleryLabel: "Gallery",
      languageLabel: "Language",
      staysSubmenuAria: "Accommodations submenu",
      mobileNavAria: "Mobile navigation",
      mobileStayGroupsAria: "Accommodation groups",
      menuOpenAria: "Open menu",
      quickContactOpenAria: "Open quick contact",
      quickContactLabel: "Contact"
    }
  : {
      contactAria: "Kapcsolat",
      phoneAria: "Telefon",
      languageAria: "Nyelvváltó",
      bookingLabel: "Foglalás / Árak",
      bookingShortLabel: "Foglalás",
      bookingSmallLabel: "Elérhetőség ellenőrzése",
      bookingAria: "Foglalás és árak",
      mainNavAria: "Fő navigáció",
      homeLabel: "Főoldal",
      staysLabel: "Szállások–Házak",
      experiencesLabel: "Élmények",
      galleryLabel: "Galéria",
      languageLabel: "Nyelv",
      staysSubmenuAria: "Szállások almenü",
      mobileNavAria: "Mobil navigáció",
      mobileStayGroupsAria: "Szálláscsoportok",
      menuOpenAria: "Menü megnyitása",
      quickContactOpenAria: "Gyors kapcsolat megnyitása",
      quickContactLabel: "Kapcsolat"
    };
const schemaScripts = [
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "@id": `${toAbsoluteUrl("/")}#organization`,
    name: SITE_NAME,
    url: toAbsoluteUrl("/"),
    logo: toAbsoluteUrl("/images/LOGO/dandelion-vendeghazak-header-logo-optimized-v2.png"),
    telephone: "+36207730807"
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "@id": `${toAbsoluteUrl("/")}#website`,
    name: SITE_NAME,
    url: toAbsoluteUrl("/"),
    inLanguage: schemaLanguage,
    description: isEnglishPage ? SITE_DEFAULT_DESCRIPTION_EN : SITE_DEFAULT_DESCRIPTION,
    publisher: {
      "@id": `${toAbsoluteUrl("/")}#organization`
    }
  },
  ...structuredDataItems
];

const quickContacts = [
  { label: isEnglishPage ? "Phone" : "Telefon", href: "tel:+36207730807", shortLabel: "TEL" },
  {
    label: "E-mail",
    href: contactPageHref,
    shortLabel: "MAIL",
    emailLocalPart,
    emailDomain
  },
  { label: "WhatsApp", href: "https://wa.me/36207730807", shortLabel: "WA" }
];

const bookingLanguage = isEnglishPage ? "En" : "Hu";
const bookingHref = `https://ibe.sabeeapp.com/v3/p/Dandelion-Vendégházak?p=3970b30e1042d58f&lang=${bookingLanguage}`;
const stayLabelOverrides: Record<string, string> = {
  fugehaz: "Dandelion Fügeház",
  "vintage-vendeghaz": "Dandelion Vintage",
};
const resolveLocalStayHref = (href: string) =>
  href.startsWith("/") ? `${homeHref}${href.replace(/^\/+/, "")}` : href;
const buildStayHref = (slug: string, url: string) =>
  slug === "dandelion-d2"
    ? `${homeHref}dandelion-d2/`
    : slug === "fugehaz"
      ? `${homeHref}fuge/`
      : slug === "royal-homes"
        ? `${homeHref}royal/`
        : resolveLocalStayHref(url);
const stayLinkMap = new Map(
  accommodations.map((stay) => [
    stay.slug,
    {
      label: stayLabelOverrides[stay.slug] ?? stay.name,
      href: buildStayHref(stay.slug, stay.url)
    }
  ])
);
const groupedStayLinks = [
  {
    title: "Tapolcai-medence",
    items: [
      stayLinkMap.get("dandelion-d2"),
      stayLinkMap.get("fugehaz"),
      stayLinkMap.get("dandelion-d1"),
      stayLinkMap.get("szololiget-vendeghaz"),
      stayLinkMap.get("zsalya-vendeghaz"),
      stayLinkMap.get("vintage-vendeghaz")
    ].filter(Boolean)
  },
  {
    title: "Balaton mellett",
    items: [
      stayLinkMap.get("royal-homes"),
      stayLinkMap.get("szepvolgyi-vendeghaz")
    ].filter(Boolean)
  },
  {
    title: "Káli-medence",
    items: [
      {
        label: "Dandelion Köveskál",
        href: `${homeHref}dandelion-koveskal/`
      }
    ]
  }
];
const englishGroupedStayLinks = [
  {
    title: "Available in English",
    items: [
      {
        label: "Dandelion D2",
        href: `${homeHref}en/dandelion-d2/`
      },
      {
        label: "Fügeház",
        href: `${homeHref}en/dandelion-fugehaz/`
      },
      {
        label: "Dandelion D1",
        href: `${homeHref}en/dandelion-d1/`
      },
      {
        label: "Zsálya Vendégház",
        href: `${homeHref}en/dandelion-zsalya/`
      },
      {
        label: "Szőlőliget Vendégház",
        href: `${homeHref}en/szololiget/`
      },
      {
        label: "Szépvölgyi Vendégház",
        href: `${homeHref}en/szepvolgyi/`
      },
      {
        label: "Dandelion Royal Homes",
        href: `${homeHref}en/royal/`
      },
      {
        label: "Dandelion Vintage Vendégház",
        href: `${homeHref}en/dandelion-vintage/`
      },
      {
        label: "Dandelion Köveskál",
        href: `${homeHref}en/dandelion-koveskal/`
      }
    ]
  }
];
const headerStayGroups = isEnglishPage ? englishGroupedStayLinks : groupedStayLinks;

const transparentHeaderPaths = new Set([
  "/",
  "/en/",
  "/szallasok/",
  "/en/szallasok/",
  "/elmenyek/",
  "/en/experiences/",
  "/elmenyek/kerekpar/",
  "/en/bike-rental/",
  "/elmenyek/bor-es-panorama/",
  "/en/wineries/",
  "/elmenyek/balaton/",
  "/en/lake-balaton/",
  "/elmenyek/tanuhegyek/",
  "/en/witness-hills/",
  "/panorama-pool/",
  "/dandelion-d1/",
  "/dandelion-d2/",
  "/en/dandelion-d2/",
  "/en/dandelion-fugehaz/",
  "/en/dandelion-d1/",
  "/en/dandelion-zsalya/",
  "/en/szololiget/",
  "/en/szepvolgyi/",
  "/en/royal/",
  "/en/dandelion-vintage/",
  "/en/dandelion-koveskal/",
  "/dandelion-koveskal/",
  "/dandelion-royal-homes/",
  "/dandelion-szepvolgyi-vendeghaz/",
  "/dandelion-szololiget/",
  "/dandelion-vintage/",
  "/dandelion-zsalya/",
  "/royal/",
  "/fuge/",
  "/szepvolgyi/",
  "/szololiget/"
]);

const isTransparentHeaderStart =
  headerMode === "transparent"
    ? true
    : headerMode === "solid"
      ? false
      : transparentHeaderPaths.has(normalizedCurrentPath);

// [CHANGE 2026-05-19 00:00] Header language links now point only to existing Hungarian and English routes.
const languageRoutesByPath: Record<string, { hu: string; en?: string }> = {
  "/": { hu: "/", en: "/en/" },
  "/en/": { hu: "/", en: "/en/" },
  "/kapcsolat/": { hu: "/kapcsolat/", en: "/en/contact/" },
  "/en/contact/": { hu: "/kapcsolat/", en: "/en/contact/" },
  "/szallasok/": { hu: "/szallasok/", en: "/en/szallasok/" },
  "/en/szallasok/": { hu: "/szallasok/", en: "/en/szallasok/" },
  "/elmenyek/": { hu: "/elmenyek/", en: "/en/experiences/" },
  "/en/experiences/": { hu: "/elmenyek/", en: "/en/experiences/" },
  "/elmenyek/kerekpar/": { hu: "/elmenyek/kerekpar/", en: "/en/bike-rental/" },
  "/en/bike-rental/": { hu: "/elmenyek/kerekpar/", en: "/en/bike-rental/" },
  "/elmenyek/bor-es-panorama/": { hu: "/elmenyek/bor-es-panorama/", en: "/en/wineries/" },
  "/en/wineries/": { hu: "/elmenyek/bor-es-panorama/", en: "/en/wineries/" },
  "/elmenyek/balaton/": { hu: "/elmenyek/balaton/", en: "/en/lake-balaton/" },
  "/en/lake-balaton/": { hu: "/elmenyek/balaton/", en: "/en/lake-balaton/" },
  "/elmenyek/tanuhegyek/": { hu: "/elmenyek/tanuhegyek/", en: "/en/witness-hills/" },
  "/en/witness-hills/": { hu: "/elmenyek/tanuhegyek/", en: "/en/witness-hills/" },
  "/dandelion-d2/": { hu: "/dandelion-d2/", en: "/en/dandelion-d2/" },
  "/en/dandelion-d2/": { hu: "/dandelion-d2/", en: "/en/dandelion-d2/" },
  "/fuge/": { hu: "/fuge/", en: "/en/dandelion-fugehaz/" },
  "/en/dandelion-fugehaz/": { hu: "/fuge/", en: "/en/dandelion-fugehaz/" },
  "/dandelion-d1/": { hu: "/dandelion-d1/", en: "/en/dandelion-d1/" },
  "/en/dandelion-d1/": { hu: "/dandelion-d1/", en: "/en/dandelion-d1/" },
  "/dandelion-zsalya/": { hu: "/dandelion-zsalya/", en: "/en/dandelion-zsalya/" },
  "/en/dandelion-zsalya/": { hu: "/dandelion-zsalya/", en: "/en/dandelion-zsalya/" },
  "/szololiget/": { hu: "/szololiget/", en: "/en/szololiget/" },
  "/en/szololiget/": { hu: "/szololiget/", en: "/en/szololiget/" },
  "/szepvolgyi/": { hu: "/szepvolgyi/", en: "/en/szepvolgyi/" },
  "/en/szepvolgyi/": { hu: "/szepvolgyi/", en: "/en/szepvolgyi/" },
  "/royal/": { hu: "/royal/", en: "/en/royal/" },
  "/en/royal/": { hu: "/royal/", en: "/en/royal/" },
  "/dandelion-vintage/": { hu: "/dandelion-vintage/", en: "/en/dandelion-vintage/" },
  "/en/dandelion-vintage/": { hu: "/dandelion-vintage/", en: "/en/dandelion-vintage/" },
  "/dandelion-koveskal/": { hu: "/dandelion-koveskal/", en: "/en/dandelion-koveskal/" },
  "/en/dandelion-koveskal/": { hu: "/dandelion-koveskal/", en: "/en/dandelion-koveskal/" },
  "/de/": { hu: "/" }
};
const localizedHref = (path: string) =>
  path === "/" ? homeHref : `${homeHref}${path.replace(/^\/+/, "")}`;
const currentLanguageRoutes = languageRoutesByPath[normalizedCurrentPath] ?? {
  hu: lang === "en" ? "/" : normalizedCurrentPath
};
const headerLanguageLinks = [
  {
    label: "HU",
    name: isEnglishPage ? "Hungarian" : "Magyar",
    href: localizedHref(currentLanguageRoutes.hu),
    active: lang === "hu"
  },
  {
    label: "EN",
    name: isEnglishPage ? "English" : "Angol",
    href: currentLanguageRoutes.en ? localizedHref(currentLanguageRoutes.en) : undefined,
    active: lang === "en"
  }
];
const mobileCurrentLanguageLabel = lang.toUpperCase();
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robotsContent} />
    <link rel="canonical" href={canonicalUrl} />
    {alternateLinks.map((alternate) => (
      <link rel="alternate" hreflang={alternate.hreflang} href={alternate.href} />
    ))}
    <meta property="og:locale" content={resolvedOgLocale} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedOgImage} />
    <link rel="icon" type="image/png" sizes="256x244" href="/favicon.png?v=20260519" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=20260519" />
    <link rel="shortcut icon" href="/favicon.ico?v=20260519" />
    <link rel="apple-touch-icon" href="/favicon.png?v=20260519" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600&family=Poppins:wght@400;600;700&display=swap"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600&family=Poppins:wght@400;600;700&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600&family=Poppins:wght@400;600;700&display=swap"
        rel="stylesheet"
      />
    </noscript>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      window.gtag = window.gtag || function () {
        window.dataLayer.push(arguments);
      };
      window.gtag("consent", "default", {
        analytics_storage: "denied",
        ad_storage: "denied",
        ad_user_data: "denied",
        ad_personalization: "denied"
      });
      window.gtag("set", "ads_data_redaction", true);
    </script>
    <script is:inline>
      (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
      new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
      j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
      'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
      })(window,document,'script','dataLayer','GTM-P75FHKLJ');
    </script>
    <script defer src="/scripts/consent-init.js"></script>
    {schemaScripts.map((item) => (
      <script type="application/ld+json" set:html={JSON.stringify(item)} />
    ))}
    <slot name="head" />
  </head>
  <body>
    <noscript>
      <iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-P75FHKLJ"
        height="0"
        width="0"
        style="display:none;visibility:hidden"
      ></iframe>
    </noscript>
    {!hideHeader && <header class={`dnd-header ${isTransparentHeaderStart ? "dnd-header--transparent-start" : "dnd-header--solid-start"}`} data-dnd-header>
      <div class="dnd-container dnd-header__desktop">
        <div class="dnd-header__top">
          <div class="dnd-header__contact" aria-label={headerText.contactAria}>
            <a href="tel:+36207730807" aria-label={headerText.phoneAria}>
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M6.6 10.8c1.5 3 3.6 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1.1-.3 1.2.4 2.4.6 3.7.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.7 21 3 13.3 3 3.8c0-.6.4-1 1-1h3.6c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.7.1.4 0 .8-.3 1.1l-2.3 2.2Z" />
              </svg>
            </a>
            <a
              href={contactPageHref}
              aria-label="E-mail"
              data-mailto-local={emailLocalPart}
              data-mailto-domain={emailDomain}
            >
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M4.5 6.5h15c.8 0 1.5.7 1.5 1.5v8.5c0 .8-.7 1.5-1.5 1.5h-15c-.8 0-1.5-.7-1.5-1.5V8c0-.8.7-1.5 1.5-1.5Z" />
                <path d="m4 8 8 5.4L20 8" />
              </svg>
            </a>
            <a href="https://wa.me/36207730807" target="_blank" rel="noopener noreferrer" aria-label="WhatsApp">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M4.2 20 5.4 16.5A8.2 8.2 0 1 1 8 19l-3.8 1Z" />
                <path d="M9.1 8.4c.2-.4.4-.4.7-.4h.5c.2 0 .4.1.5.4l.7 1.6c.1.2.1.4 0 .6l-.5.6c-.1.1-.1.3 0 .5.5.9 1.3 1.7 2.2 2.2.2.1.4.1.5 0l.7-.6c.2-.1.4-.2.6-.1l1.6.8c.3.1.4.3.4.6v.5c0 .3-.1.5-.4.7-.5.3-1.2.5-1.9.4-3.4-.5-6.1-3.2-6.6-6.6-.1-.7.1-1.3.4-1.8Z" />
              </svg>
            </a>
          </div>

          <a href={headerHomeHref} class="dnd-logo" aria-label="Dandelion Vendégházak">
              <img
              src="/images/LOGO/dandelion-vendeghazak-header-logo-optimized-v2.png"
              alt="Dandelion Vendégházak"
              width="512"
              height="135"
            />
          </a>

          <div class="dnd-header__actions">
            <nav class="dnd-language" aria-label={headerText.languageAria}>
              {headerLanguageLinks.map((languageLink) => languageLink.href ? (
                <a href={languageLink.href} aria-current={languageLink.active ? "page" : undefined}>
                  {languageLink.label}
                </a>
              ) : (
                <span class="dnd-language__pending" aria-disabled="true">{languageLink.label}</span>
              ))}
              <span class="dnd-language__pending" aria-disabled="true">DE</span>
            </nav>
            <a
              href={bookingHref}
              class="dnd-header-cta"
              target="_blank"
              rel="noopener noreferrer"
            >
              <span>{headerText.bookingLabel}</span>
              <small>{headerText.bookingSmallLabel}</small>
            </a>
          </div>
        </div>

        <nav class="dnd-nav" aria-label={headerText.mainNavAria}>
          <a href={headerHomeHref}>{headerText.homeLabel}</a>
          <div class="dnd-nav__item dnd-nav__item--has-submenu">
            <a href={headerStaysHref}>{headerText.staysLabel}</a>
            <div class="dnd-nav__submenu" aria-label={headerText.staysSubmenuAria}>
              {headerStayGroups.map((group) => (
                <div class="dnd-nav__submenu-group">
                  <span class="dnd-nav__submenu-group-title">{group.title}</span>
                  <div class="dnd-nav__submenu-group-items">
                    {group.items.map((stay) => (
                      <a href={stay.href} class="dnd-nav__submenu-stay-link">{stay.label}</a>
                    ))}
                  </div>
                </div>
              ))}
            </div>
          </div>
          <a href={headerExperiencesHref}>{headerText.experiencesLabel}</a>
          <a href={headerGalleryHref}>{headerText.galleryLabel}</a>
          <a href={bookingHref} target="_blank" rel="noopener noreferrer">{headerText.bookingLabel}</a>
        </nav>
      </div>

      <div class="dnd-container dnd-header__mobile">
        <a href={headerHomeHref} class="dnd-logo dnd-logo--mobile" aria-label="Dandelion Vendégházak">
          <img
            src="/images/LOGO/dandelion-vendeghazak-header-logo-optimized-v2.png"
            alt="Dandelion Vendégházak"
            width="512"
            height="135"
          />
        </a>

        <!-- [CHANGE 2026-05-20 08:30] Mobile header shows the current language only; full language choices live in the menu. -->
        <button
          class="dnd-mobile-language-current"
          type="button"
          aria-label={headerText.languageAria}
          aria-expanded="false"
          data-dnd-menu-toggle
        >
          <span>{mobileCurrentLanguageLabel}</span>
          <span aria-hidden="true">▾</span>
        </button>

        <div class="dnd-header__mobile-actions">
          <a
            href={bookingHref}
            class="dnd-header-cta dnd-header-cta--mobile"
            aria-label={headerText.bookingAria}
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="dnd-header-cta__label-full">{headerText.bookingLabel}</span>
            <span class="dnd-header-cta__label-short">{headerText.bookingShortLabel}</span>
          </a>
          <button class="dnd-menu-toggle" type="button" aria-label={headerText.menuOpenAria} aria-expanded="false" data-dnd-menu-toggle>
            <span></span>
            <span></span>
            <span></span>
          </button>
        </div>
      </div>

      <nav class="dnd-mobile-menu" aria-label={headerText.mobileNavAria} data-dnd-mobile-menu>
        <a href={headerHomeHref}>{headerText.homeLabel}</a>
        <a href={headerStaysHref}>{headerText.staysLabel}</a>
        <div class="dnd-mobile-menu__groups" aria-label={headerText.mobileStayGroupsAria}>
          {headerStayGroups.map((group) => (
            <div class="dnd-mobile-menu__group">
              <span class="dnd-mobile-menu__group-title">{group.title}</span>
              <div class="dnd-mobile-menu__group-items">
                {group.items.map((stay) => (
                  <a href={stay.href} class="dnd-mobile-menu__subitem dnd-mobile-menu__stay-link">{stay.label}</a>
                ))}
              </div>
            </div>
          ))}
        </div>
        <a href={headerExperiencesHref}>{headerText.experiencesLabel}</a>
        <a href={headerGalleryHref}>{headerText.galleryLabel}</a>
        <div class="dnd-mobile-menu__language" aria-label={headerText.languageAria}>
          <span class="dnd-mobile-menu__language-title">{headerText.languageLabel}</span>
          <div class="dnd-mobile-menu__language-list">
            {headerLanguageLinks.map((languageLink) => languageLink.href ? (
              <a href={languageLink.href} aria-current={languageLink.active ? "page" : undefined}>
                <span>{languageLink.label}</span>
                {languageLink.name}
              </a>
            ) : (
              <span class="dnd-mobile-menu__language-pending" aria-disabled="true">
                <span>{languageLink.label}</span>
                {languageLink.name}
              </span>
            ))}
            <span class="dnd-mobile-menu__language-pending" aria-disabled="true">
              <span>DE</span>
              Deutsch
            </span>
          </div>
        </div>
        <a
          href={bookingHref}
          class="dnd-mobile-menu__booking"
          target="_blank"
          rel="noopener noreferrer"
        >
          {headerText.bookingSmallLabel}
        </a>
      </nav>
    </header>}

    <main>
      <slot />
    </main>

    {!hideFooter && <SiteFooter lang={lang} />}

    {!hideHeader && <div class="dnd-quick-contact" data-dnd-quick-contact>
      <div class="dnd-quick-contact__panel" data-dnd-quick-contact-panel>
        {quickContacts.map((item) => (
          <a
            href={item.href}
            class="dnd-quick-contact__item"
            data-mailto-local={item.emailLocalPart}
            data-mailto-domain={item.emailDomain}
          >
            <span>{item.shortLabel}</span>
            {item.label}
          </a>
        ))}
      </div>
      <button class="dnd-quick-contact__toggle" type="button" aria-label={headerText.quickContactOpenAria} aria-expanded="false" data-dnd-quick-contact-toggle>
        {headerText.quickContactLabel}
      </button>
    </div>}

    <script>
      (() => {
        const buildMailtoHref = (localPart, domain) => `mailto:${localPart}@${domain}`;

        const initMailtoLinks = () => {
          const mailtoLinks = document.querySelectorAll("[data-mailto-local][data-mailto-domain]");

          mailtoLinks.forEach((link) => {
            if (!(link instanceof HTMLAnchorElement)) {
              return;
            }

            const localPart = link.dataset.mailtoLocal;
            const domain = link.dataset.mailtoDomain;

            if (!localPart || !domain) {
              return;
            }

            const mailtoHref = buildMailtoHref(localPart, domain);
            link.addEventListener("click", (event) => {
              event.preventDefault();
              window.location.href = mailtoHref;
            });
          });
        };

        const initHeader = () => {
          const header = document.querySelector("[data-dnd-header]");
          const toggles = document.querySelectorAll("[data-dnd-menu-toggle]");
          const mobileMenu = document.querySelector("[data-dnd-mobile-menu]");
          const quickContact = document.querySelector("[data-dnd-quick-contact]");
          const quickContactToggle = document.querySelector("[data-dnd-quick-contact-toggle]");

          if (!header) {
            return;
          }

          let headerScrollFrame = 0;
          let isHeaderScrolled = false;

          const applyHeaderScrollState = () => {
            headerScrollFrame = 0;
            const nextScrolled = window.scrollY > 24;

            if (nextScrolled === isHeaderScrolled) {
              return;
            }

            isHeaderScrolled = nextScrolled;
            header.classList.toggle("is-scrolled", nextScrolled);
          };

          const queueHeaderScrollState = () => {
            if (headerScrollFrame) {
              return;
            }

            headerScrollFrame = window.requestAnimationFrame(applyHeaderScrollState);
          };

          applyHeaderScrollState();
          window.addEventListener("scroll", queueHeaderScrollState, { passive: true });

          toggles.forEach((toggle) => {
            toggle.addEventListener("click", () => {
              const isOpen = header.classList.toggle("is-menu-open");
              toggles.forEach((item) => item.setAttribute("aria-expanded", String(isOpen)));
              mobileMenu?.setAttribute("data-open", String(isOpen));
            });
          });

          quickContactToggle?.addEventListener("click", () => {
            const isOpen = quickContact?.classList.toggle("is-open") ?? false;
            quickContactToggle.setAttribute("aria-expanded", String(isOpen));
          });
        };

        const boot = () => {
          initMailtoLinks();
          initHeader();
        };

        if (document.readyState === "loading") {
          window.addEventListener("DOMContentLoaded", boot, { once: true });
        } else {
          boot();
        }
      })();
    </script>
