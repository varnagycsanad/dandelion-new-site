      contactAria: "Kapcsolat",
      phoneAria: "Telefon",
      languageAria: "Nyelvváltó",
      bookingLabel: "Foglalás / Árak",
      bookingShortLabel: "Foglalás",
      bookingSmallLabel: "Elérhetőség ellenőrzése",
      bookingAria: "Foglalás és árak",
      mainNavAria: "Fő navigáció",
      homeLabel: "Főoldal",
      staysLabel: "Szállások–Házak",
      experiencesLabel: "Élmények",
      galleryLabel: "Galéria",
      staysSubmenuAria: "Szállások almenü",
      mobileNavAria: "Mobil navigáció",
      mobileStayGroupsAria: "Szálláscsoportok",
      menuOpenAria: "Menü megnyitása",
      quickContactOpenAria: "Gyors kapcsolat megnyitása",
      quickContactLabel: "Kapcsolat"
    };
const schemaScripts = [
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "@id": `${toAbsoluteUrl("/")}#organization`,
    name: SITE_NAME,
    url: toAbsoluteUrl("/"),
    logo: toAbsoluteUrl("/images/LOGO/dandelion-vendeghazak-header-logo-header.png"),
    telephone: "+36207730807"
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "@id": `${toAbsoluteUrl("/")}#website`,
    name: SITE_NAME,
    url: toAbsoluteUrl("/"),
    inLanguage: schemaLanguage,
    description: isCzechPage
      ? SITE_DEFAULT_DESCRIPTION_CS
      : isGermanPage
        ? SITE_DEFAULT_DESCRIPTION_DE
        : isEnglishPage
          ? SITE_DEFAULT_DESCRIPTION_EN
          : SITE_DEFAULT_DESCRIPTION,
    publisher: {
      "@id": `${toAbsoluteUrl("/")}#organization`
    }
  },
  ...structuredDataItems
];

const quickContacts = [
  { label: isEnglishPage ? "Phone" : "Telefon", href: "tel:+36207730807", shortLabel: "TEL" },
  {
    label: "E-mail",
    href: contactPageHref,
    shortLabel: "MAIL",
    emailLocalPart,
    emailDomain
