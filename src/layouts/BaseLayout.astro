---
import "../styles/global.css";
import { accommodations } from "../data/accommodations";
import SiteFooter from "../components/SiteFooter.astro";
import {
  SITE_DEFAULT_DESCRIPTION,
  SITE_DEFAULT_DESCRIPTION_DE,
  SITE_DEFAULT_DESCRIPTION_EN,
  SITE_DEFAULT_DESCRIPTION_CS,
  SITE_DEFAULT_OG_IMAGE,
  SITE_DEFAULT_TITLE,
  SITE_NAME,
  getCanonicalPath,
  getLocalizedRouteAlternates,
  isCanonicalAliasPath,
  normalizePathname,
  toAbsoluteUrl
} from "../data/site-seo";

// [CHANGE 2026-05-19 00:00] Minimal locale props added for the first English entry point without changing Hungarian defaults.

interface Props {
  title?: string;
  description?: string;
  hideHeader?: boolean;
  hideFooter?: boolean;
  canonicalPath?: string;
  ogImage?: string;
  ogImageAlt?: string;
  noindex?: boolean;
  lang?: "hu" | "en" | "de" | "sk" | "pl" | "cs";
  ogLocale?: string;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
  headerMode?: "auto" | "transparent" | "solid";
}

const {
  title = SITE_DEFAULT_TITLE,
  description = SITE_DEFAULT_DESCRIPTION,
  canonicalPath,
  ogImage = SITE_DEFAULT_OG_IMAGE,
  ogImageAlt = title,
  noindex = false,
  lang = "hu",
  ogLocale,
  structuredData = [],
  headerMode = "auto"
} = Astro.props;

const { hideHeader = false, hideFooter = false } = Astro.props;
const normalizedCurrentPath = normalizePathname(Astro.url.pathname);
const resolvedCanonicalPath = canonicalPath ? normalizePathname(canonicalPath) : getCanonicalPath(normalizedCurrentPath);
const canonicalUrl = toAbsoluteUrl(resolvedCanonicalPath);
const resolvedOgImage = toAbsoluteUrl(ogImage);
const shouldNoindex = noindex || isCanonicalAliasPath(normalizedCurrentPath);
const robotsContent = shouldNoindex ? "noindex,follow" : "index,follow";
const alternateLinks = shouldNoindex
  ? []
  : getLocalizedRouteAlternates(resolvedCanonicalPath).map((alternate) => ({
      hreflang: alternate.hreflang,
      href: toAbsoluteUrl(alternate.path)
    }));
const structuredDataItems = Array.isArray(structuredData) ? structuredData : [structuredData];
const defaultOgLocaleByLang: Record<NonNullable<Props["lang"]>, string> = {
  hu: "hu_HU",
  en: "en_US",
  de: "de_DE",
  sk: "sk_SK",
  pl: "pl_PL",
  cs: "cs_CZ"
};
const schemaLanguageByLang: Record<NonNullable<Props["lang"]>, string> = {
  hu: "hu-HU",
  en: "en-US",
  de: "de-DE",
  sk: "sk-SK",
  pl: "pl-PL",
  cs: "cs-CZ"
};
const resolvedOgLocale = ogLocale ?? defaultOgLocaleByLang[lang];
const schemaLanguage = schemaLanguageByLang[lang];
const isEnglishPage = lang === "en";
const isGermanPage = lang === "de";
const isCzechPage = lang === "cs";
const homeHref = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const emailLocalPart = "hello";
const emailDomain = "dandelionhouse.hu";
const contactPageHref = isCzechPage
  ? `${homeHref}cs/kontakt/`
  : isGermanPage
    ? `${homeHref}de/kontakt/`
    : isEnglishPage
      ? `${homeHref}en/contact/`
      : `${homeHref}kapcsolat/`;
const headerHomeHref = isCzechPage ? `${homeHref}cs/` : isGermanPage ? `${homeHref}de/` : isEnglishPage ? `${homeHref}en/` : homeHref;
const headerStaysHref = isCzechPage
  ? `${homeHref}cs/ubytovani/`
  : isGermanPage
    ? `${homeHref}de/unterkuenfte/`
    : isEnglishPage
      ? `${homeHref}en/szallasok/`
      : `${homeHref}szallasok/`;
const headerExperiencesHref = isCzechPage
  ? `${homeHref}cs/zazitky/`
  : isGermanPage
    ? `${homeHref}de/erlebnisse/`
    : isEnglishPage
      ? `${homeHref}en/experiences/`
      : `${homeHref}elmenyek/`;
const headerGalleryHref = isCzechPage ? `${homeHref}cs/` : isGermanPage ? `${homeHref}de/#gallery` : isEnglishPage ? `${homeHref}en/#gallery` : homeHref;
const headerText = isEnglishPage
  ? {
      contactAria: "Contact",
      phoneAria: "Phone",
      languageAria: "Language switcher",
      bookingLabel: "Booking / Prices",
      bookingShortLabel: "Book now",
      bookingSmallLabel: "Check availability",
      bookingAria: "Booking and prices",
      mainNavAria: "Main navigation",
      homeLabel: "Home",
      staysLabel: "Accommodations",
      experiencesLabel: "Experiences",
