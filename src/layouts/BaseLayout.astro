---
import "../styles/global.css";
import { accommodations } from "../data/accommodations";
import SiteFooter from "../components/SiteFooter.astro";
import {
  SITE_DEFAULT_DESCRIPTION,
  SITE_DEFAULT_OG_IMAGE,
  SITE_DEFAULT_TITLE,
  SITE_NAME,
  getCanonicalPath,
  isCanonicalAliasPath,
  normalizePathname,
  toAbsoluteUrl
} from "../data/site-seo";

interface Props {
  title?: string;
  description?: string;
  hideHeader?: boolean;
  hideFooter?: boolean;
  canonicalPath?: string;
  ogImage?: string;
  ogImageAlt?: string;
  noindex?: boolean;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title = SITE_DEFAULT_TITLE,
  description = SITE_DEFAULT_DESCRIPTION,
  canonicalPath,
  ogImage = SITE_DEFAULT_OG_IMAGE,
  ogImageAlt = title,
  noindex = false,
  structuredData = []
} = Astro.props;

const { hideHeader = false, hideFooter = false } = Astro.props;
const normalizedCurrentPath = normalizePathname(Astro.url.pathname);
const resolvedCanonicalPath = canonicalPath ? normalizePathname(canonicalPath) : getCanonicalPath(normalizedCurrentPath);
const canonicalUrl = toAbsoluteUrl(resolvedCanonicalPath);
const resolvedOgImage = toAbsoluteUrl(ogImage);
const shouldNoindex = noindex || isCanonicalAliasPath(normalizedCurrentPath);
const robotsContent = shouldNoindex ? "noindex,follow" : "index,follow";
const structuredDataItems = Array.isArray(structuredData) ? structuredData : [structuredData];
const schemaScripts = [
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "@id": `${toAbsoluteUrl("/")}#organization`,
    name: SITE_NAME,
    url: toAbsoluteUrl("/"),
    logo: toAbsoluteUrl("/images/LOGO/dandelion-vendeghazak-header-logo.png"),
    email: "hello@dandelionhouse.hu",
    telephone: "+36207730807"
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "@id": `${toAbsoluteUrl("/")}#website`,
    name: SITE_NAME,
    url: toAbsoluteUrl("/"),
    inLanguage: "hu-HU",
    description: SITE_DEFAULT_DESCRIPTION,
    publisher: {
      "@id": `${toAbsoluteUrl("/")}#organization`
    }
  },
  ...structuredDataItems
];

const quickContacts = [
  { label: "Telefon", href: "tel:+36207730807", shortLabel: "TEL" },
  { label: "E-mail", href: "mailto:hello@dandelionhouse.hu", shortLabel: "MAIL" },
  { label: "WhatsApp", href: "https://wa.me/36207730807", shortLabel: "WA" }
];

const homeHref = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const staysHref = `${homeHref}#stays`;
const experiencesHref = `${homeHref}#elmenyek`;
const stayLabelOverrides: Record<string, string> = {
  fugehaz: "Dandelion Fügeház",
  "vintage-vendeghaz": "Dandelion Vintage",
};
const resolveLocalStayHref = (href: string) =>
  href.startsWith("/") ? `${homeHref}${href.replace(/^\/+/, "")}` : href;
const buildStayHref = (slug: string, url: string) =>
  slug === "dandelion-d2"
    ? `${homeHref}dandelion-d2/`
    : slug === "fugehaz"
      ? `${homeHref}fuge/`
      : slug === "royal-homes"
        ? `${homeHref}royal/`
        : resolveLocalStayHref(url);
const stayLinkMap = new Map(
  accommodations.map((stay) => [
    stay.slug,
    {
      label: stayLabelOverrides[stay.slug] ?? stay.name,
      href: buildStayHref(stay.slug, stay.url)
    }
  ])
);
const groupedStayLinks = [
  {
    title: "Tapolcai-medence",
    items: [
      stayLinkMap.get("dandelion-d2"),
      stayLinkMap.get("fugehaz"),
      stayLinkMap.get("dandelion-d1"),
      stayLinkMap.get("szololiget-vendeghaz"),
      stayLinkMap.get("zsalya-vendeghaz"),
      stayLinkMap.get("vintage-vendeghaz")
    ].filter(Boolean)
  },
  {
    title: "Balaton mellett",
    items: [
      stayLinkMap.get("royal-homes"),
      stayLinkMap.get("szepvolgyi-vendeghaz")
    ].filter(Boolean)
  },
  {
    title: "Káli-medence",
    items: [
      {
        label: "Dandelion Köveskál",
        href: `${homeHref}dandelion-koveskal/`
      }
    ]
  }
];
---

<!DOCTYPE html>
<html lang="hu">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robotsContent} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:locale" content="hu_HU" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedOgImage} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      window.gtag = window.gtag || function () {
        window.dataLayer.push(arguments);
      };
      window.gtag("consent", "default", {
        analytics_storage: "denied",
        ad_storage: "denied",
        ad_user_data: "denied",
        ad_personalization: "denied"
      });
      window.gtag("set", "ads_data_redaction", true);
    </script>
    <script is:inline>
      (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
      new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
      j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
      'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
      })(window,document,'script','dataLayer','GTM-P75FHKLJ');
    </script>
    <script defer src="/scripts/consent-init.js"></script>
    {schemaScripts.map((item) => (
      <script type="application/ld+json" set:html={JSON.stringify(item)} />
    ))}
    <slot name="head" />
  </head>
  <body>
    <noscript>
      <iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-P75FHKLJ"
        height="0"
        width="0"
        style="display:none;visibility:hidden"
      ></iframe>
    </noscript>
    {!hideHeader && <header class="dnd-header" data-dnd-header>
      <div class="dnd-container dnd-header__desktop">
        <div class="dnd-header__top">
          <div class="dnd-header__contact" aria-label="Kapcsolat">
            <a href="tel:+36207730807" aria-label="Telefon">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M6.6 10.8c1.5 3 3.6 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1.1-.3 1.2.4 2.4.6 3.7.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.7 21 3 13.3 3 3.8c0-.6.4-1 1-1h3.6c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.7.1.4 0 .8-.3 1.1l-2.3 2.2Z" />
              </svg>
            </a>
            <a href="mailto:hello@dandelionhouse.hu" aria-label="E-mail">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M4.5 6.5h15c.8 0 1.5.7 1.5 1.5v8.5c0 .8-.7 1.5-1.5 1.5h-15c-.8 0-1.5-.7-1.5-1.5V8c0-.8.7-1.5 1.5-1.5Z" />
                <path d="m4 8 8 5.4L20 8" />
              </svg>
            </a>
            <a href="https://wa.me/36207730807" target="_blank" rel="noopener noreferrer" aria-label="WhatsApp">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M4.2 20 5.4 16.5A8.2 8.2 0 1 1 8 19l-3.8 1Z" />
                <path d="M9.1 8.4c.2-.4.4-.4.7-.4h.5c.2 0 .4.1.5.4l.7 1.6c.1.2.1.4 0 .6l-.5.6c-.1.1-.1.3 0 .5.5.9 1.3 1.7 2.2 2.2.2.1.4.1.5 0l.7-.6c.2-.1.4-.2.6-.1l1.6.8c.3.1.4.3.4.6v.5c0 .3-.1.5-.4.7-.5.3-1.2.5-1.9.4-3.4-.5-6.1-3.2-6.6-6.6-.1-.7.1-1.3.4-1.8Z" />
              </svg>
            </a>
          </div>

          <a href={homeHref} class="dnd-logo" aria-label="Dandelion Vendégházak">
            <img
              src="/images/LOGO/dandelion-vendeghazak-header-logo.png"
              alt="Dandelion Vendégházak"
              width="2226"
              height="586"
            />
          </a>

          <div class="dnd-header__actions">
            <nav class="dnd-language" aria-label="Nyelvváltó">
              <a href="/" aria-current="page">HU</a>
              <span class="dnd-language__pending" aria-label="English oldal hamarosan">EN</span>
              <span class="dnd-language__pending" aria-label="Deutsch oldal hamarosan">DE</span>
            </nav>
            <a
              href="https://ibe.sabeeapp.com/v3/p/Dandelion-Vendeghazak?p=3970b30e1042d58f"
              class="dnd-header-cta"
              target="_blank"
              rel="noopener noreferrer"
            >
              <span>Foglalás / Árak</span>
              <small>Elérhetőség ellenőrzése</small>
            </a>
          </div>
        </div>

        <nav class="dnd-nav" aria-label="Fő navigáció">
          <a href={homeHref}>Főoldal</a>
          <div class="dnd-nav__item dnd-nav__item--has-submenu">
            <a href={staysHref}>Szállások–Házak</a>
            <div class="dnd-nav__submenu" aria-label="Szállások almenü">
              {groupedStayLinks.map((group) => (
                <div class="dnd-nav__submenu-group">
                  <span class="dnd-nav__submenu-group-title">{group.title}</span>
                  <div class="dnd-nav__submenu-group-items">
                    {group.items.map((stay) => (
                      <a href={stay.href} class="dnd-nav__submenu-stay-link">{stay.label}</a>
                    ))}
                  </div>
                </div>
              ))}
            </div>
          </div>
          <a href={experiencesHref}>Élmények</a>
          <a href="/">Galéria</a>
        </nav>
      </div>

      <div class="dnd-container dnd-header__mobile">
        <a href={homeHref} class="dnd-logo dnd-logo--mobile" aria-label="Dandelion Vendégházak">
          <img
            src="/images/LOGO/dandelion-vendeghazak-header-logo.png"
            alt="Dandelion Vendégházak"
            width="2226"
            height="586"
          />
        </a>

        <div class="dnd-header__mobile-actions">
          <a
            href="https://ibe.sabeeapp.com/v3/p/Dandelion-Vendeghazak?p=3970b30e1042d58f"
            class="dnd-header-cta dnd-header-cta--mobile"
            target="_blank"
            rel="noopener noreferrer"
          >
            Foglalás / Árak
          </a>
          <button class="dnd-menu-toggle" type="button" aria-label="Menü megnyitása" aria-expanded="false" data-dnd-menu-toggle>
            <span></span>
            <span></span>
            <span></span>
          </button>
        </div>
      </div>

      <nav class="dnd-mobile-menu" aria-label="Mobil navigáció" data-dnd-mobile-menu>
        <a href={homeHref}>Főoldal</a>
        <a href={staysHref}>Szállások–Házak</a>
        <div class="dnd-mobile-menu__groups" aria-label="Szálláscsoportok">
          {groupedStayLinks.map((group) => (
            <div class="dnd-mobile-menu__group">
              <span class="dnd-mobile-menu__group-title">{group.title}</span>
              <div class="dnd-mobile-menu__group-items">
                {group.items.map((stay) => (
                  <a href={stay.href} class="dnd-mobile-menu__subitem dnd-mobile-menu__stay-link">{stay.label}</a>
                ))}
              </div>
            </div>
          ))}
        </div>
        <a href={experiencesHref}>Élmények</a>
        <a href="/">Galéria</a>
      </nav>
    </header>}

    <main>
      <slot />
    </main>

    {!hideFooter && <SiteFooter />}

    <div class="dnd-consent" data-dnd-consent hidden>
      <div class="dnd-consent__backdrop" data-dnd-consent-close></div>
      <section class="dnd-consent__panel" aria-label="Süti beállítások">
        <div class="dnd-consent__summary" data-dnd-consent-summary>
          <p class="dnd-consent__eyebrow">Süti beállítások</p>
          <h2>Szeretnénk tisztán kezelni a hozzájárulásokat.</h2>
          <p>
            A szükséges működésen felül külön engedélyezheted az analitikai és marketing célú mérést.
            A beállításokat később is módosíthatod.
          </p>
          <div class="dnd-consent__actions">
            <button type="button" class="dnd-consent__button dnd-consent__button--ghost" data-dnd-consent-open-settings>
              Beállítások
            </button>
            <button type="button" class="dnd-consent__button dnd-consent__button--ghost" data-dnd-consent-reject>
              Elutasítom
            </button>
            <button type="button" class="dnd-consent__button dnd-consent__button--primary" data-dnd-consent-accept-all>
              Elfogadom
            </button>
          </div>
        </div>

        <div class="dnd-consent__details" data-dnd-consent-details hidden>
          <div class="dnd-consent__detail-grid">
            <article class="dnd-consent__option">
              <div>
                <h3>Szükséges</h3>
                <p>Ezek biztosítják a weboldal alapvető működését, ezért mindig aktívak maradnak.</p>
              </div>
              <span class="dnd-consent__badge">Mindig aktív</span>
            </article>

            <label class="dnd-consent__option" for="dnd-consent-analytics">
              <div>
                <h3>Analitika</h3>
                <p>Segít megérteni, hogyan használják a látogatók az oldalt.</p>
              </div>
              <input id="dnd-consent-analytics" type="checkbox" data-dnd-consent-analytics />
            </label>

            <label class="dnd-consent__option" for="dnd-consent-marketing">
              <div>
                <h3>Marketing</h3>
                <p>Lehetővé teszi a remarketing és közösségi hirdetési méréseket.</p>
              </div>
              <input id="dnd-consent-marketing" type="checkbox" data-dnd-consent-marketing />
            </label>
          </div>

          <div class="dnd-consent__actions">
            <button type="button" class="dnd-consent__button dnd-consent__button--ghost" data-dnd-consent-back>
              Vissza
            </button>
            <button type="button" class="dnd-consent__button dnd-consent__button--primary" data-dnd-consent-save>
              Beállítások mentése
            </button>
          </div>
        </div>
      </section>
    </div>

    {!hideHeader && <div class="dnd-quick-contact" data-dnd-quick-contact>
      <div class="dnd-quick-contact__panel" data-dnd-quick-contact-panel>
        {quickContacts.map((item) => (
          <a href={item.href} class="dnd-quick-contact__item">
            <span>{item.shortLabel}</span>
            {item.label}
          </a>
        ))}
      </div>
      <button class="dnd-quick-contact__toggle" type="button" aria-label="Gyors kapcsolat megnyitása" aria-expanded="false" data-dnd-quick-contact-toggle>
        Kapcsolat
      </button>
    </div>}

    <script>
      (() => {
        const header = document.querySelector("[data-dnd-header]");
        const toggle = document.querySelector("[data-dnd-menu-toggle]");
        const mobileMenu = document.querySelector("[data-dnd-mobile-menu]");
        const quickContact = document.querySelector("[data-dnd-quick-contact]");
        const quickContactToggle = document.querySelector("[data-dnd-quick-contact-toggle]");

        if (!header) return;

        const updateHeader = () => {
          header.classList.toggle("is-scrolled", window.scrollY > 24);
        };

        updateHeader();
        window.addEventListener("scroll", updateHeader, { passive: true });

        toggle?.addEventListener("click", () => {
          const isOpen = header.classList.toggle("is-menu-open");
          toggle.setAttribute("aria-expanded", String(isOpen));
          mobileMenu?.setAttribute("data-open", String(isOpen));
        });

        quickContactToggle?.addEventListener("click", () => {
          const isOpen = quickContact?.classList.toggle("is-open") ?? false;
          quickContactToggle.setAttribute("aria-expanded", String(isOpen));
        });

        const consentRoot = document.querySelector("[data-dnd-consent]");
        const consentSummary = document.querySelector("[data-dnd-consent-summary]");
        const consentDetails = document.querySelector("[data-dnd-consent-details]");
        const analyticsInput = document.querySelector("[data-dnd-consent-analytics]");
        const marketingInput = document.querySelector("[data-dnd-consent-marketing]");
        const openSettingsButton = document.querySelector("[data-dnd-consent-open-settings]");
        const acceptAllButton = document.querySelector("[data-dnd-consent-accept-all]");
        const rejectButton = document.querySelector("[data-dnd-consent-reject]");
        const saveButton = document.querySelector("[data-dnd-consent-save]");
        const backButton = document.querySelector("[data-dnd-consent-back]");
        const closeElements = document.querySelectorAll("[data-dnd-consent-close]");

        if (!consentRoot || !analyticsInput || !marketingInput) {
          return;
        }

        const showConsent = () => {
          consentRoot.hidden = false;
          document.body.classList.add("has-consent-open");
        };

        const hideConsent = () => {
          consentRoot.hidden = true;
          document.body.classList.remove("has-consent-open");
        };

        const showSummary = () => {
          consentSummary?.removeAttribute("hidden");
          consentDetails?.setAttribute("hidden", "true");
        };

        const showDetails = () => {
          consentSummary?.setAttribute("hidden", "true");
          consentDetails?.removeAttribute("hidden");
        };

        const syncInputs = (consent) => {
          analyticsInput.checked = Boolean(consent?.analytics);
          marketingInput.checked = Boolean(consent?.marketing);
        };

        const persistConsent = (consent) => {
          window.dndSaveConsent?.(consent);
          window.dndApplyConsent?.(consent);
          hideConsent();
        };

        const storedConsent = window.dndGetStoredConsent?.();

        if (storedConsent) {
          syncInputs(storedConsent);
          window.dndApplyStoredConsent?.();
        } else {
          syncInputs({ analytics: false, marketing: false });
          showSummary();
          showConsent();
        }

        openSettingsButton?.addEventListener("click", showDetails);
        backButton?.addEventListener("click", showSummary);
        acceptAllButton?.addEventListener("click", () => {
          persistConsent({ analytics: true, marketing: true });
        });
        rejectButton?.addEventListener("click", () => {
          persistConsent({ analytics: false, marketing: false });
        });
        saveButton?.addEventListener("click", () => {
          persistConsent({
            analytics: analyticsInput.checked,
            marketing: marketingInput.checked
          });
        });
        closeElements.forEach((element) => {
          element.addEventListener("click", () => {
            if (window.dndGetStoredConsent?.()) {
              hideConsent();
            }
          });
        });
      })();
    </script>
    <style>
      body.has-consent-open {
        overflow: hidden;
      }

      .dnd-nav__submenu {
        min-width: 280px;
        gap: 16px;
      }

      .dnd-nav__submenu-group + .dnd-nav__submenu-group {
        padding-top: 14px;
        border-top: 1px solid rgba(94, 65, 39, 0.08);
      }

      .dnd-nav__submenu-group-title {
        display: block;
        margin: 0 10px 8px 18px;
        color: rgba(45, 36, 28, 0.52);
        font-size: 0.63rem;
        font-weight: 600;
        letter-spacing: 0.16em;
        line-height: 1.45;
        text-transform: uppercase;
      }

      .dnd-nav__submenu-group-items {
        display: grid;
        gap: 6px;
      }

      .dnd-nav__submenu-stay-link,
      .dnd-mobile-menu__stay-link {
        position: relative;
        padding-left: 16px;
      }

      .dnd-nav__submenu-stay-link::before,
      .dnd-mobile-menu__stay-link::before {
        content: "";
        position: absolute;
        left: 2px;
        top: 50%;
        width: 4px;
        height: 4px;
        border-radius: 999px;
        background: rgba(94, 65, 39, 0.34);
        transform: translateY(-50%);
      }

      .dnd-mobile-menu__groups {
        display: grid;
        gap: 18px;
      }

      .dnd-mobile-menu__group {
        display: grid;
        gap: 8px;
      }

      .dnd-mobile-menu__group + .dnd-mobile-menu__group {
        padding-top: 14px;
        border-top: 1px solid rgba(45, 36, 28, 0.1);
      }

      .dnd-mobile-menu__group-title {
        display: block;
        margin-left: 18px;
        color: rgba(45, 36, 28, 0.52);
        font-size: 0.58rem;
        font-weight: 600;
        letter-spacing: 0.18em;
        line-height: 1.45;
        text-transform: uppercase;
      }

      .dnd-mobile-menu__group-items {
        display: grid;
        gap: 6px;
      }

      .dnd-language__pending {
        display: inline-flex;
        align-items: center;
        opacity: 0.55;
        cursor: default;
      }

      .dnd-mobile-menu[data-open="true"] {
        max-height: 560px;
      }

      .dnd-consent {
        position: fixed;
        inset: 0;
        z-index: 1200;
      }

      .dnd-consent__backdrop {
        position: absolute;
        inset: 0;
        background: rgba(45, 36, 28, 0.36);
        backdrop-filter: blur(3px);
      }

      .dnd-consent__panel {
        position: absolute;
        right: 24px;
        bottom: 24px;
        width: min(100%, 460px);
        padding: 24px;
        border: 1px solid rgba(94, 65, 39, 0.16);
        border-radius: 24px;
        background: #fdfbf7;
        box-shadow: 0 20px 60px rgba(45, 36, 28, 0.16);
        font-family: "Poppins", Arial, sans-serif;
        color: #000000;
      }

      .dnd-consent__eyebrow {
        margin: 0 0 10px;
        color: #d99e2b;
        font-size: 0.75rem;
