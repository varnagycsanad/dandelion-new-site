        staysLabel: "Unterkünfte",
        experiencesLabel: "Erlebnisse",
        galleryLabel: "Galerie",
        staysSubmenuAria: "Unterkünfte Untermenü",
        mobileNavAria: "Mobile Navigation",
        mobileStayGroupsAria: "Unterkunftsgruppen",
        menuOpenAria: "Menü öffnen",
        quickContactOpenAria: "Schnellkontakt öffnen",
        quickContactLabel: "Kontakt"
      }
    : isCzechPage
      ? {
          contactAria: "Kontakt",
          phoneAria: "Telefon",
          languageAria: "Přepínač jazyka",
          bookingLabel: "Rezervace / Ceny",
          bookingShortLabel: "Rezervace",
          bookingSmallLabel: "Ověřit dostupnost",
          bookingAria: "Rezervace a ceny",
          mainNavAria: "Hlavní navigace",
          homeLabel: "Úvod",
          staysLabel: "Ubytování",
          experiencesLabel: "Zážitky",
          galleryLabel: "Galerie",
