---
import BaseLayout from "../layouts/BaseLayout.astro";
import PoolRulesSection from "../components/PoolRulesSection.astro";
import { getPoolRulesContent } from "../data/pool-rules";

const pageTitle = "Panorama Pool - vendéginformációk | Dandelion";
const description =
  "QR-kóddal megnyitható medenceoldal: aktuális vízhőmérséklet, használati segítségek, rövid szabályok és teljes medencehasználati szabályzat.";
const poolLiveWidgetSrc = import.meta.env.DEV
  ? "http://127.0.0.1:8091/api/pool-live-widget.php?mode=guide"
  : "/api/pool-live-widget.php?mode=guide";
const rulesContent = getPoolRulesContent("hu");
const poolTemperatureFallback = "Hamarosan";
const airTemperatureFallback = "Hamarosan";
const languageLinks = [
  { label: "HU", href: "/medence/", isActive: true },
  { label: "EN", href: "/en/panorama-pool/" },
  { label: "DE", href: "/de/panorama-pool/" },
  { label: "CS", href: "/cs/panorama-pool/" },
  { label: "SK", href: "/sk/panorama-pool/" }
];

const quickRules = [
  "Nyitvatartás: minden nap 10:00-21:00.",
  "A medence használata saját felelősségre történik, úszómester nincs.",
  "Gyermek csak felnőtt felügyelete mellett lehet a medencénél.",
  "Zuhanyzás használat előtt kötelező.",
  "Ugrálni, fejest ugrani, futni és lökdösődni tilos.",
  "Üveget, ételt és törékeny tárgyat ne vigyetek a medence közelébe.",
  "Vihar, villámlás vagy erős szél esetén a medencét azonnal hagyjátok el.",
  "Utolsó esti használat után a medencefedést vissza kell húzni."
];

const helpSteps = [
  {
    title: "Fürdés előtt",
    text:
      "Nézzétek meg a vízhőmérsékletet, zuhanyozzatok le, és ellenőrizzétek, hogy az időjárás biztonságos-e."
  },
  {
    title: "Fürdés közben",
    text:
      "Figyeljetek egymásra, gyereket ne hagyjatok felügyelet nélkül, és kerüljétek a csúszós, rohanós mozgást."
  },
  {
    title: "Ha valami gond van",
    text:
      "Szennyeződés, sérülés, rosszullét vagy hibás medencefedés esetén azonnal szóljatok a szállásadónak."
  },
  {
    title: "Távozás előtt",
    text:
      "Vigyétek magatokkal a saját holmikatokat, hagyjatok rendet, és utolsó esti használat után húzzátok vissza a fedést."
  }
];
---

<BaseLayout
  title={pageTitle}
  description={description}
  canonicalPath="/medence/"
  noindex={true}
  hideHeader={true}
  hideFooter={true}
>
  <main class="pool-qr-page">
    <section class="pool-qr-hero">
      <div class="pool-qr-hero__content">
        <nav class="pool-qr-language-switch" aria-label="Nyelvválasztó">
          {languageLinks.map((link) => (
            <a
              href={link.href}
              class:list={["pool-qr-language-switch__link", { "is-active": link.isActive }]}
              aria-current={link.isActive ? "page" : undefined}
            >
              {link.label}
            </a>
          ))}
        </nav>

        <p class="pool-qr-eyebrow">Dandelion vendégoldal</p>
        <h1>Panorama Pool</h1>
        <p class="pool-qr-hero__lead">
          Ez az oldal gyors segítség a medence használatához. Itt találjátok egy helyen a legfontosabb
          tudnivalókat, az aktuális hőmérsékleteket és a rövid szabályokat is.
        </p>

        <div class="pool-qr-hero__facts" aria-label="Legfontosabb medence információk">
          <article
            class="pool-qr-hero-card pool-qr-hero-card--temperature"
            data-pool-temperature
            data-endpoint="/api/pool-temperature.json"
            aria-live="polite"
          >
            <span class="pool-qr-hero-card__label">Aktuális hőmérsékletek</span>
            <div class="pool-qr-temperature-grid">
              <div class="pool-qr-temperature-item">
                <span class="pool-qr-temperature-item__title">Víz most</span>
                <strong class="pool-qr-hero-card__value" data-pool-temperature-value>{poolTemperatureFallback}</strong>
              </div>
              <div class="pool-qr-temperature-item">
                <span class="pool-qr-temperature-item__title">Levegő</span>
                <strong class="pool-qr-hero-card__value pool-qr-hero-card__value--air" data-pool-air-temperature-value>
                  {airTemperatureFallback}
                </strong>
              </div>
            </div>
          </article>

          <article class="pool-qr-hero-card">
            <span class="pool-qr-hero-card__label">Nyitvatartás</span>
            <div class="pool-qr-temperature-grid">
              <div class="pool-qr-temperature-item">
                <span class="pool-qr-temperature-item__title">Minden nap</span>
                <strong class="pool-qr-hero-card__value pool-qr-hero-card__value--air">10:00-21:00</strong>
              </div>
              <div class="pool-qr-temperature-item">
                <span class="pool-qr-temperature-item__title">Mélység</span>
                <strong class="pool-qr-hero-card__value pool-qr-hero-card__value--air">125 cm</strong>
              </div>
            </div>
          </article>

          <article class="pool-qr-hero-card">
            <span class="pool-qr-hero-card__label">Belépés előtt</span>
            <strong class="pool-qr-hero-card__value">Gyerek csak felügyelettel</strong>
            <span class="pool-qr-hero-card__meta">Viharban azonnal hagyjátok el</span>
          </article>
        </div>

        <div class="pool-qr-hero__actions">
          <a href="#pool-live-title" class="pool-qr-hero__action pool-qr-hero__action--primary">
            Aktuális adatok
          </a>
          <a href="#medencehasznalati-szabalyok" class="pool-qr-hero__action">
            Szabályzat
          </a>
        </div>

        <div class="pool-qr-hero__note">
          <strong>Csak D1, D2 és Fügeház vendégeknek.</strong>
          <span>Gyors tájékozódáshoz készült, kifejezetten telefonos megnyitásra.</span>
        </div>
      </div>
    </section>

    <section class="pool-qr-section pool-qr-section--live" aria-labelledby="pool-live-title">
      <div class="pool-qr-shell">
        <div class="pool-qr-section-head">
          <p class="pool-qr-eyebrow">Aktuális adatok</p>
          <h2 id="pool-live-title">Medence- és időjárásadatok most</h2>
          <p>Víz, levegő, páratartalom és egyéb friss mérések a fürdés előtti gyors döntéshez.</p>
        </div>

        <div class="pool-qr-live-card">
          <iframe
            class="pool-qr-live-frame"
            src={poolLiveWidgetSrc}
            title="Panorama Pool aktuális mérések"
            loading="lazy"
            scrolling="no"
          ></iframe>
        </div>
      </div>
    </section>

    <section class="pool-qr-section" aria-labelledby="pool-summary-title">
      <div class="pool-qr-shell">
        <div class="pool-qr-section-head">
          <p class="pool-qr-eyebrow">Röviden</p>
          <h2 id="pool-summary-title">Medence ÁSZF kivonat</h2>
          <p>A legfontosabb szabályok, amiket érdemes gyorsan átfutni fürdés előtt.</p>
        </div>

        <ul class="pool-qr-summary-list">
          {quickRules.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </div>
    </section>

    <section class="pool-qr-section" aria-labelledby="pool-help-title">
      <div class="pool-qr-shell">
        <div class="pool-qr-section-head">
          <p class="pool-qr-eyebrow">Használati segítség</p>
          <h2 id="pool-help-title">Mit érdemes csinálni lépésről lépésre?</h2>
          <p>Egyszerű segítség ahhoz, hogy a medencehasználat kényelmes és biztonságos maradjon.</p>
        </div>

        <div class="pool-qr-help-grid">
          {helpSteps.map((step, index) => (
            <article class="pool-qr-help-card">
              <span class="pool-qr-help-card__index">0{index + 1}</span>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="pool-qr-section" aria-labelledby="pool-practical-title">
      <div class="pool-qr-shell">
        <div class="pool-qr-section-head">
          <p class="pool-qr-eyebrow">Gyakorlati tudnivalók</p>
          <h2 id="pool-practical-title">Amit még jó tudni a medencénél</h2>
        </div>

        <div class="pool-qr-practical-grid">
          <article>
            <h3>Ki használhatja?</h3>
            <p>A Panorama Pool a Dandelion D1, Dandelion D2 és Fügeház vendégei számára elérhető a szezonban.</p>
          </article>
          <article>
            <h3>Biztonság</h3>
            <p>A medence nem ugrómedence. Gyermekekért mindig a velük érkező felnőtt felel.</p>
          </article>
          <article>
            <h3>Időjárás</h3>
            <p>Villámlás, vihar vagy erős szél esetén a medencét ne használjátok, a napernyőt pedig csukjátok le.</p>
          </article>
          <article>
            <h3>Medencefedés</h3>
            <p>Ha a fedés akad vagy nem mozog rendesen, ne erőltessétek, hanem szóljatok a szállásadónak.</p>
          </article>
        </div>
      </div>
    </section>

    <PoolRulesSection content={rulesContent} />
  </main>
</BaseLayout>

<script is:inline>
  (() => {
    const updatePoolTemperature = async () => {
      const widget = document.querySelector("[data-pool-temperature]");
      const valueNode = widget ? widget.querySelector("[data-pool-temperature-value]") : null;
      const airValueNode = widget ? widget.querySelector("[data-pool-air-temperature-value]") : null;
      const endpoint = widget ? widget.getAttribute("data-endpoint") || "/api/pool-temperature.json" : "/api/pool-temperature.json";
      const fallbackText = "Hamarosan";

      if (!widget || !valueNode) return;

      try {
        const url = new URL(endpoint, window.location.href);
        url.searchParams.set("refresh", Date.now().toString());

        const response = await fetch(url.toString(), {
          headers: { Accept: "application/json" },
          cache: "no-store"
        });

        if (!response.ok) {
          throw new Error("Pool temperature is unavailable.");
        }

        const data = await response.json();
        const temperature = Number(data.temperature);

        if (!Number.isFinite(temperature)) {
          throw new Error("Pool temperature is invalid.");
        }

        const unit = typeof data.unit === "string" && data.unit.trim() ? data.unit.trim() : "°C";
        valueNode.textContent = `${temperature.toLocaleString("hu-HU", {
          minimumFractionDigits: 1,
          maximumFractionDigits: 1
        })} ${unit}`;

        const rawAirTemperature =
          data.airTemperature !== undefined && data.airTemperature !== null
            ? data.airTemperature
            : data.air_temperature !== undefined && data.air_temperature !== null
              ? data.air_temperature
              : data.outdoorTemperature;
        const airTemperature = Number(rawAirTemperature);
        if (airValueNode && Number.isFinite(airTemperature)) {
          airValueNode.textContent = `${airTemperature.toLocaleString("hu-HU", {
            minimumFractionDigits: 1,
            maximumFractionDigits: 1
          })} ${unit}`;
        } else if (airValueNode) {
          airValueNode.textContent = fallbackText;
        }
      } catch {
        valueNode.textContent = fallbackText;
        if (airValueNode) {
          airValueNode.textContent = fallbackText;
        }
      }
    };

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", updatePoolTemperature, { once: true });
    } else {
      updatePoolTemperature();
    }
  })();
</script>

<style>
  :global(body) {
    background:
      radial-gradient(circle at top, rgba(150, 210, 222, 0.34), transparent 34%),
      linear-gradient(180deg, #eef7f7 0%, #f8f4ec 52%, #ffffff 100%);
  }

  .pool-qr-page {
    min-height: 100vh;
    color: #1f2f2c;
    padding-bottom: 44px;
    text-align: center;
  }

  .pool-qr-hero {
    position: relative;
    min-height: 380px;
    overflow: hidden;
    background:
      radial-gradient(circle at top left, rgba(152, 220, 234, 0.52), transparent 30%),
      radial-gradient(circle at right 20%, rgba(255, 231, 185, 0.75), transparent 24%),
      linear-gradient(180deg, #f8fffe 0%, #eef7f7 48%, #f8f4ec 100%);
    color: #17313a;
  }

  .pool-qr-hero__content,
  .pool-qr-shell {
    width: min(100% - 28px, 860px);
    margin: 0 auto;
  }

  .pool-qr-hero__content {
    position: relative;
    display: grid;
    gap: 16px;
    padding: 60px 0 40px;
    justify-items: center;
  }

  .pool-qr-language-switch {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
  }

  .pool-qr-language-switch__link {
    display: inline-flex;
    min-width: 48px;
    min-height: 36px;
    padding: 0 12px;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(23, 49, 58, 0.14);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.72);
    color: #17313a;
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-decoration: none;
  }

  .pool-qr-language-switch__link.is-active {
    background: #17313a;
    border-color: #17313a;
    color: #fffdf8;
  }

  .pool-qr-eyebrow {
    margin: 0;
    color: #4b8d98;
    font-size: var(--dnd-text-xs);
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .pool-qr-hero h1,
  .pool-qr-section-head h2,
  .pool-qr-help-card h3,
  .pool-qr-practical-grid h3 {
    margin: 0;
    font-family: var(--dnd-font-display);
  }

  .pool-qr-hero h1 {
    font-size: clamp(2.8rem, 10vw, 5rem);
    line-height: 0.94;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .pool-qr-hero__lead,
  .pool-qr-section-head p,
  .pool-qr-help-card p,
  .pool-qr-practical-grid p,
  .pool-qr-summary-list li {
    margin: 0;
    font-size: var(--dnd-text-base);
    line-height: 1.65;
  }

  .pool-qr-hero__lead {
    max-width: 34rem;
    color: rgba(23, 49, 58, 0.78);
    text-align: center;
  }

  .pool-qr-hero__facts {
    display: grid;
    gap: 10px;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .pool-qr-hero-card {
    display: grid;
    gap: 6px;
    padding: 14px 15px;
    border: 1px solid rgba(53, 110, 118, 0.12);
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.8);
    box-shadow: 0 16px 34px rgba(24, 53, 59, 0.08);
    text-align: center;
  }

  .pool-qr-hero-card__label {
    color: #3f7f89;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    line-height: 1.1;
    text-transform: uppercase;
  }

  .pool-qr-hero-card__value {
    color: #17313a;
    font-family: var(--dnd-font-display);
    font-size: 1.08rem;
    font-weight: 600;
    line-height: 1.14;
    letter-spacing: 0.02em;
  }

  .pool-qr-hero-card--temperature .pool-qr-hero-card__value {
    font-size: clamp(1.25rem, 3vw, 1.7rem);
  }

  .pool-qr-hero-card__value--air {
    font-size: clamp(1.05rem, 2.4vw, 1.3rem);
  }

  .pool-qr-temperature-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
  }

  .pool-qr-temperature-item {
    display: grid;
    gap: 4px;
    min-width: 0;
    justify-items: center;
  }

  .pool-qr-temperature-item__title {
    color: rgba(23, 49, 58, 0.68);
    font-size: 0.78rem;
    font-weight: 700;
    line-height: 1.2;
  }

  .pool-qr-hero-card__meta {
    color: rgba(23, 49, 58, 0.68);
    font-size: 0.78rem;
    line-height: 1.35;
  }

  .pool-qr-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    justify-content: center;
  }

  .pool-qr-hero__action {
    display: inline-flex;
    min-height: 44px;
    padding: 0 16px;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(23, 49, 58, 0.16);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.72);
    color: #17313a;
    font-size: var(--dnd-text-sm);
    font-weight: 700;
    text-decoration: none;
  }

  .pool-qr-hero__action--primary {
    background: #17313a;
    border-color: #17313a;
    color: #fffdf8;
  }

  .pool-qr-hero__note {
    display: grid;
    gap: 2px;
    color: rgba(23, 49, 58, 0.72);
    font-size: 0.82rem;
    line-height: 1.4;
    justify-items: center;
  }

  .pool-qr-hero__note strong {
    color: #17313a;
    font-size: 0.84rem;
  }

  .pool-qr-section {
    padding-top: 28px;
  }

  .pool-qr-section-head {
    display: grid;
    gap: 10px;
    max-width: 700px;
    margin-bottom: 18px;
    justify-items: center;
  }

  .pool-qr-section-head h2 {
    font-size: clamp(1.5rem, 4vw, 2.3rem);
    line-height: 1.08;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #1f2a24;
  }

  .pool-qr-section-head p {
    color: rgba(31, 47, 44, 0.76);
  }

  .pool-qr-live-card,
  .pool-qr-summary-list li,
  .pool-qr-help-card,
  .pool-qr-practical-grid article {
    border: 1px solid rgba(70, 100, 93, 0.12);
    border-radius: 18px;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.96), rgba(247, 244, 238, 0.96)),
      #fff;
    box-shadow: 0 18px 40px rgba(35, 45, 39, 0.08);
  }

  .pool-qr-live-card {
    padding: 10px;
    background:
      radial-gradient(circle at top left, rgba(58, 171, 224, 0.18), transparent 28%),
      linear-gradient(135deg, rgba(10, 32, 43, 0.98), rgba(9, 46, 68, 0.96));
    border-color: rgba(122, 198, 255, 0.18);
  }

  .pool-qr-live-frame {
    display: block;
    width: 100%;
    height: 660px;
    border: 0;
    background: transparent;
  }

  .pool-qr-summary-list {
    display: grid;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pool-qr-summary-list li {
    padding: 16px 18px;
    color: #2f3933;
    font-size: var(--dnd-text-sm);
    text-align: center;
  }

  .pool-qr-help-grid,
  .pool-qr-practical-grid {
    display: grid;
    gap: 14px;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .pool-qr-help-card,
  .pool-qr-practical-grid article {
    display: grid;
    gap: 10px;
    padding: 18px;
    justify-items: center;
    text-align: center;
  }

  .pool-qr-help-card__index {
    color: #c28f2d;
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.12em;
  }

  .pool-qr-help-card h3,
  .pool-qr-practical-grid h3 {
    font-size: 1.05rem;
    line-height: 1.2;
    letter-spacing: 0.03em;
    color: #28332d;
  }

  .pool-qr-help-card p,
  .pool-qr-practical-grid p {
    color: rgba(31, 47, 44, 0.78);
    font-size: var(--dnd-text-sm);
  }

  .pool-qr-page :global(.dnd-pool-rules),
  .pool-qr-page :global(.dnd-pool-rules__header),
  .pool-qr-page :global(.dnd-pool-rules__meta),
  .pool-qr-page :global(.dnd-pool-rules__section),
  .pool-qr-page :global(.dnd-pool-rules__details summary) {
    text-align: center;
  }

  .pool-qr-page :global(.dnd-pool-rules__header),
  .pool-qr-page :global(.dnd-pool-rules__meta),
  .pool-qr-page :global(.dnd-pool-rules__section) {
    justify-items: center;
  }

  .pool-qr-page :global(.dnd-pool-rules__section ul) {
    padding-left: 0;
    list-style-position: inside;
  }

  @media (max-width: 767px) {
    .pool-qr-hero {
      min-height: 340px;
    }

    .pool-qr-hero__content {
      gap: 14px;
      padding: 34px 0 28px;
    }

    .pool-qr-language-switch {
      gap: 6px;
    }

    .pool-qr-hero h1 {
      font-size: clamp(2.1rem, 11vw, 3rem);
    }

    .pool-qr-hero__lead {
      font-size: var(--dnd-text-sm);
      line-height: 1.55;
    }

    .pool-qr-hero__facts {
      grid-template-columns: 1fr;
    }

    .pool-qr-hero-card {
      padding: 12px 14px;
    }

    .pool-qr-temperature-grid {
      gap: 8px;
    }

    .pool-qr-hero__actions {
      display: grid;
      grid-template-columns: 1fr 1fr;
    }

    .pool-qr-hero__action {
      min-height: 42px;
      padding: 0 12px;
      font-size: 0.82rem;
    }

    .pool-qr-live-frame {
      height: 500px;
    }

    .pool-qr-help-grid,
    .pool-qr-practical-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
