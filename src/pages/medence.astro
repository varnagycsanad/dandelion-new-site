---
import BaseLayout from "../layouts/BaseLayout.astro";
import PoolRulesSection from "../components/PoolRulesSection.astro";
import { getPoolRulesContent } from "../data/pool-rules";

const pageTitle = "Panorama Pool - vendéginformációk | Dandelion";
const description =
  "QR-kóddal megnyitható medenceoldal: aktuális vízhőmérséklet, használati segítségek, rövid szabályok és teljes medencehasználati szabályzat.";
const poolLiveWidgetSrc = import.meta.env.DEV
  ? "http://127.0.0.1:8091/api/pool-live-widget.php?mode=guide"
  : "/api/pool-live-widget.php?mode=guide";
const rulesContent = getPoolRulesContent("hu");
const poolTemperatureFallback = "Hamarosan";
const airTemperatureFallback = "Hamarosan";
const kisapatiLatitude = "46.8662";
const kisapatiLongitude = "17.4583";
const whatsappHref = "https://wa.me/36207730807";
const googleReviewHref = "https://g.page/r/CeSF0sgReF3QEBM/review";
const windAlertFallbackTitle = "Szél állapot betöltése...";
const windAlertFallbackText = "Röviden jelezzük, ha a szél miatt teendő van a medencénél.";
const stormAlertFallbackTitle = "Eső / vihar állapot betöltése...";
const stormAlertFallbackText = "Röviden jelezzük, ha a következő órákban eső vagy vihar közeleg.";
const radarMapHref = `https://www.windy.com/?radar,${kisapatiLatitude},${kisapatiLongitude},10`;
const languageLinks = [
  { label: "HU", href: "/medence/", isActive: true },
  { label: "EN", href: "/en/panorama-pool/" },
  { label: "DE", href: "/de/panorama-pool/" },
  { label: "CS", href: "/cs/panorama-pool/" },
  { label: "SK", href: "/sk/panorama-pool/" }
];

const quickRules = [
  "Nyitvatartás: minden nap 10:00-21:00.",
  "A medence használata saját felelősségre történik, úszómester nincs.",
  "Gyermek csak felnőtt felügyelete mellett lehet a medencénél.",
  "Zuhanyzás használat előtt kötelező.",
  "Ugrálni, fejest ugrani, futni és lökdösődni tilos.",
  "Üveget, ételt és törékeny tárgyat ne vigyetek a medence közelébe.",
  "Vihar, villámlás vagy erős szél esetén a medencét azonnal hagyjátok el.",
  "Utolsó esti használat után a medencefedést vissza kell húzni."
];

const helpSteps = [
  {
    title: "Fürdés előtt",
    text:
      "Nézzétek meg a vízhőmérsékletet, zuhanyozzatok le, és ellenőrizzétek, hogy az időjárás biztonságos-e."
  },
  {
    title: "Fürdés közben",
    text:
      "Figyeljetek egymásra, gyereket ne hagyjatok felügyelet nélkül, és kerüljétek a csúszós, rohanós mozgást."
  },
  {
    title: "Ha valami gond van",
    text:
      "Szennyeződés, sérülés, rosszullét vagy hibás medencefedés esetén azonnal szóljatok a szállásadónak."
  },
  {
    title: "Távozás előtt",
    text:
      "Vigyétek magatokkal a saját holmikatokat, hagyjatok rendet, és utolsó esti használat után húzzátok vissza a fedést."
  }
];
---

<BaseLayout
  title={pageTitle}
  description={description}
  canonicalPath="/medence/"
  noindex={true}
  hideHeader={true}
  hideFooter={true}
>
  <main class="pool-qr-page">
    <section class="pool-qr-hero">
      <div class="pool-qr-hero__content">
        <nav class="pool-qr-language-switch" aria-label="Nyelvválasztó">
          {languageLinks.map((link) => (
            <a
              href={link.href}
              class:list={["pool-qr-language-switch__link", { "is-active": link.isActive }]}
              aria-current={link.isActive ? "page" : undefined}
            >
              {link.label}
            </a>
          ))}
        </nav>

        <p class="pool-qr-eyebrow">Dandelion vendégoldal</p>
        <h1>Panorama Pool</h1>
        <p class="pool-qr-hero__lead">
          Ez az oldal gyors segítség a medence használatához. Itt találjátok egy helyen a legfontosabb
          tudnivalókat, az aktuális hőmérsékleteket és a rövid szabályokat is.
        </p>

        <div class="pool-qr-hero__facts" aria-label="Legfontosabb medence információk">
          <article
            class="pool-qr-hero-card pool-qr-hero-card--temperature"
            data-pool-temperature
            data-endpoint="/api/pool-temperature.json"
            aria-live="polite"
          >
            <span class="pool-qr-hero-card__label">Aktuális hőmérsékletek</span>
            <div class="pool-qr-temperature-grid">
              <div class="pool-qr-temperature-item">
                <span class="pool-qr-temperature-item__title">Víz most</span>
                <strong class="pool-qr-hero-card__value" data-pool-temperature-value>{poolTemperatureFallback}</strong>
              </div>
              <div class="pool-qr-temperature-item">
                <span class="pool-qr-temperature-item__title">Levegő</span>
                <strong class="pool-qr-hero-card__value pool-qr-hero-card__value--air" data-pool-air-temperature-value>
                  {airTemperatureFallback}
                </strong>
              </div>
            </div>
          </article>

          <article class="pool-qr-hero-card">
            <span class="pool-qr-hero-card__label">Használat ma</span>
            <div class="pool-qr-temperature-grid">
              <div class="pool-qr-temperature-item">
                <span class="pool-qr-temperature-item__title">Minden nap</span>
                <strong class="pool-qr-hero-card__value pool-qr-hero-card__value--air">10:00-21:00</strong>
              </div>
              <div class="pool-qr-temperature-item">
                <span class="pool-qr-temperature-item__title">Vízmélység</span>
                <strong class="pool-qr-hero-card__value pool-qr-hero-card__value--air">125 cm</strong>
              </div>
            </div>
            <div class="pool-qr-weather-alert-stack" aria-live="polite">
              <div class="pool-qr-weather-alert is-loading" data-pool-wind-alert>
                <span class="pool-qr-weather-alert__eyebrow">Szél</span>
                <strong class="pool-qr-weather-alert__title" data-pool-wind-alert-title>
                  {windAlertFallbackTitle}
                </strong>
                <span class="pool-qr-weather-alert__text" data-pool-wind-alert-text>
                  {windAlertFallbackText}
                </span>
              </div>
              <div class="pool-qr-weather-alert is-loading" data-pool-storm-alert>
                <span class="pool-qr-weather-alert__eyebrow">Eső / vihar</span>
                <strong class="pool-qr-weather-alert__title" data-pool-storm-alert-title>
                  {stormAlertFallbackTitle}
                </strong>
                <span class="pool-qr-weather-alert__text" data-pool-storm-alert-text>
                  {stormAlertFallbackText}
                </span>
              </div>
            </div>
            <div class="pool-qr-radar-card">
              <span class="pool-qr-weather-alert__eyebrow">Radar térkép</span>
              <strong class="pool-qr-radar-card__title">Kisapáti élő csapadékkép</strong>
              <p class="pool-qr-radar-card__text">
                Ha részletesen megnéznétek, merre közeleg az eső vagy a vihar, nyissátok meg teljes nézetben.
              </p>
              <a
                href={radarMapHref}
                class="pool-qr-radar-card__action"
                target="_blank"
                rel="noreferrer noopener"
              >
                Radar megnyitása
              </a>
            </div>
            <div class="pool-qr-quick-links">
              <a
                href={whatsappHref}
                class="pool-qr-quick-link pool-qr-quick-link--whatsapp"
                target="_blank"
                rel="noreferrer noopener"
              >
                <span class="pool-qr-quick-link__icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24">
                    <path d="M4.2 20 5.4 16.5A8.2 8.2 0 1 1 8 19l-3.8 1Z" />
                    <path d="M9.1 8.4c.2-.4.4-.4.7-.4h.5c.2 0 .4.1.5.4l.7 1.6c.1.2.1.4 0 .6l-.5.6c-.1.1-.1.3 0 .5.5.9 1.3 1.7 2.2 2.2.2.1.4.1.5 0l.7-.6c.2-.1.4-.2.6-.1l1.6.8c.3.1.4.3.4.6v.5c0 .3-.1.5-.4.7-.5.3-1.2.5-1.9.4-3.4-.5-6.1-3.2-6.6-6.6-.1-.7.1-1.3.4-1.8Z" />
                  </svg>
                </span>
                <span class="pool-qr-quick-link__eyebrow">Kérdésed van?</span>
                <strong class="pool-qr-quick-link__title">WhatsApp</strong>
                <span class="pool-qr-quick-link__text">Írj üzenetet nekünk</span>
              </a>
              <a
                href={googleReviewHref}
                class="pool-qr-quick-link pool-qr-quick-link--review"
                target="_blank"
                rel="noreferrer noopener"
              >
                <span class="pool-qr-quick-link__icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24">
                    <path d="M12 2.4 14.96 8.4l6.62.96-4.79 4.67 1.13 6.58L12 17.5l-5.92 3.11 1.13-6.58L2.42 9.36l6.62-.96L12 2.4Z" />
                  </svg>
                </span>
                <span class="pool-qr-quick-link__eyebrow">Tetszett a medence?</span>
                <strong class="pool-qr-quick-link__title">Google</strong>
                <span class="pool-qr-quick-link__text">Adj egy véleményt</span>
              </a>
            </div>
          </article>

          <article class="pool-qr-hero-card">
            <span class="pool-qr-hero-card__label">Belépés előtt</span>
            <strong class="pool-qr-hero-card__value">Gyerek csak felügyelettel</strong>
            <span class="pool-qr-hero-card__meta">Viharban azonnal hagyjátok el</span>
          </article>
        </div>

        <div class="pool-qr-hero__actions">
          <a href="#pool-live-title" class="pool-qr-hero__action pool-qr-hero__action--primary">
            Aktuális adatok
          </a>
          <a href="#medencehasznalati-szabalyok" class="pool-qr-hero__action">
            Szabályzat
          </a>
        </div>

        <div class="pool-qr-hero__note">
          <strong>Csak D1, D2 és Fügeház vendégeknek.</strong>
          <span>Gyors tájékozódáshoz készült, kifejezetten telefonos megnyitásra.</span>
        </div>
      </div>
    </section>

    <section class="pool-qr-section pool-qr-section--live" aria-labelledby="pool-live-title">
      <div class="pool-qr-shell">
        <div class="pool-qr-section-head">
          <p class="pool-qr-eyebrow">Aktuális adatok</p>
          <h2 id="pool-live-title">Medence- és időjárásadatok most</h2>
          <p>Víz, levegő, páratartalom és egyéb friss mérések a fürdés előtti gyors döntéshez.</p>
        </div>

        <div class="pool-qr-live-card">
          <iframe
            class="pool-qr-live-frame"
            src={poolLiveWidgetSrc}
            title="Panorama Pool aktuális mérések"
            loading="lazy"
            scrolling="no"
          ></iframe>
        </div>
      </div>
    </section>

    <section class="pool-qr-section" aria-labelledby="pool-summary-title">
      <div class="pool-qr-shell">
        <div class="pool-qr-section-head">
          <p class="pool-qr-eyebrow">Röviden</p>
          <h2 id="pool-summary-title">Medence ÁSZF kivonat</h2>
          <p>A legfontosabb szabályok, amiket érdemes gyorsan átfutni fürdés előtt.</p>
        </div>

        <ul class="pool-qr-summary-list">
          {quickRules.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </div>
    </section>

    <section class="pool-qr-section" aria-labelledby="pool-help-title">
      <div class="pool-qr-shell">
        <div class="pool-qr-section-head">
          <p class="pool-qr-eyebrow">Használati segítség</p>
          <h2 id="pool-help-title">Mit érdemes csinálni lépésről lépésre?</h2>
          <p>Egyszerű segítség ahhoz, hogy a medencehasználat kényelmes és biztonságos maradjon.</p>
        </div>

        <div class="pool-qr-help-grid">
          {helpSteps.map((step, index) => (
            <article class="pool-qr-help-card">
              <span class="pool-qr-help-card__index">0{index + 1}</span>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="pool-qr-section" aria-labelledby="pool-practical-title">
      <div class="pool-qr-shell">
        <div class="pool-qr-section-head">
          <p class="pool-qr-eyebrow">Gyakorlati tudnivalók</p>
          <h2 id="pool-practical-title">Amit még jó tudni a medencénél</h2>
        </div>

        <div class="pool-qr-practical-grid">
          <article>
            <h3>Ki használhatja?</h3>
            <p>A Panorama Pool a Dandelion D1, Dandelion D2 és Fügeház vendégei számára elérhető a szezonban.</p>
          </article>
          <article>
            <h3>Biztonság</h3>
            <p>A medence nem ugrómedence. Gyermekekért mindig a velük érkező felnőtt felel.</p>
          </article>
          <article>
            <h3>Időjárás</h3>
            <p>Villámlás, vihar vagy erős szél esetén a medencét ne használjátok, a napernyőt pedig csukjátok le.</p>
          </article>
          <article>
            <h3>Medencefedés</h3>
            <p>Ha a fedés akad vagy nem mozog rendesen, ne erőltessétek, hanem szóljatok a szállásadónak.</p>
          </article>
        </div>
      </div>
    </section>

    <PoolRulesSection content={rulesContent} />
  </main>
</BaseLayout>

<script is:inline>
  (() => {
    const updatePoolTemperature = async () => {
      const widget = document.querySelector("[data-pool-temperature]");
      const valueNode = widget ? widget.querySelector("[data-pool-temperature-value]") : null;
      const airValueNode = widget ? widget.querySelector("[data-pool-air-temperature-value]") : null;
      const endpoint = widget ? widget.getAttribute("data-endpoint") || "/api/pool-temperature.json" : "/api/pool-temperature.json";
      const fallbackText = "Hamarosan";

      if (!widget || !valueNode) return;

      try {
        const url = new URL(endpoint, window.location.href);
        url.searchParams.set("refresh", Date.now().toString());

        const response = await fetch(url.toString(), {
          headers: { Accept: "application/json" },
          cache: "no-store"
        });

        if (!response.ok) {
          throw new Error("Pool temperature is unavailable.");
        }

        const data = await response.json();
        const temperature = Number(data.temperature);

        if (!Number.isFinite(temperature)) {
          throw new Error("Pool temperature is invalid.");
        }

        const unit = typeof data.unit === "string" && data.unit.trim() ? data.unit.trim() : "°C";
        valueNode.textContent = `${temperature.toLocaleString("hu-HU", {
          minimumFractionDigits: 1,
          maximumFractionDigits: 1
        })} ${unit}`;

        const rawAirTemperature =
          data.airTemperature !== undefined && data.airTemperature !== null
            ? data.airTemperature
            : data.air_temperature !== undefined && data.air_temperature !== null
              ? data.air_temperature
              : data.outdoorTemperature;
        const airTemperature = Number(rawAirTemperature);
        if (airValueNode && Number.isFinite(airTemperature)) {
          airValueNode.textContent = `${airTemperature.toLocaleString("hu-HU", {
            minimumFractionDigits: 1,
            maximumFractionDigits: 1
          })} ${unit}`;
        } else if (airValueNode) {
          airValueNode.textContent = fallbackText;
        }
      } catch {
        valueNode.textContent = fallbackText;
        if (airValueNode) {
          airValueNode.textContent = fallbackText;
        }
      }
    };

    const updateWeatherAlert = async () => {
      const windNode = document.querySelector("[data-pool-wind-alert]");
      const windTitleNode = windNode ? windNode.querySelector("[data-pool-wind-alert-title]") : null;
      const windTextNode = windNode ? windNode.querySelector("[data-pool-wind-alert-text]") : null;
      const stormNode = document.querySelector("[data-pool-storm-alert]");
      const stormTitleNode = stormNode ? stormNode.querySelector("[data-pool-storm-alert-title]") : null;
      const stormTextNode = stormNode ? stormNode.querySelector("[data-pool-storm-alert-text]") : null;

      if (!windNode || !windTitleNode || !windTextNode || !stormNode || !stormTitleNode || !stormTextNode) return;

      const setAlertState = (node, titleNode, textNode, state, title, text) => {
        node.classList.remove("is-loading", "is-calm", "is-caution", "is-warning");
        node.classList.add(state);
        titleNode.textContent = title;
        textNode.textContent = text;
      };

      try {
        const url = new URL("https://api.open-meteo.com/v1/forecast");
        url.searchParams.set("latitude", "46.8662");
        url.searchParams.set("longitude", "17.4583");
        url.searchParams.set("current", "weather_code,wind_speed_10m,wind_gusts_10m");
        url.searchParams.set("hourly", "precipitation_probability,weather_code,wind_gusts_10m,precipitation");
        url.searchParams.set("forecast_days", "1");
        url.searchParams.set("timezone", "auto");

        const response = await fetch(url.toString(), {
          headers: { Accept: "application/json" },
          cache: "no-store"
        });

        if (!response.ok) {
          throw new Error("Weather alert is unavailable.");
        }

        const data = await response.json();
        const current = data.current ?? {};
        const hourly = data.hourly ?? {};
        const hourlyTimes = Array.isArray(hourly.time) ? hourly.time : [];
        const precipitationValues = Array.isArray(hourly.precipitation_probability) ? hourly.precipitation_probability : [];
        const precipitationAmounts = Array.isArray(hourly.precipitation) ? hourly.precipitation : [];
        const hourlyCodes = Array.isArray(hourly.weather_code) ? hourly.weather_code : [];
        const hourlyGusts = Array.isArray(hourly.wind_gusts_10m) ? hourly.wind_gusts_10m : [];
        const thunderstormCodes = new Set([95, 96, 99]);
        const rainCodes = new Set([51, 53, 55, 56, 57, 61, 63, 65, 66, 67, 80, 81, 82]);
        const currentCode = Number(current.weather_code);
        const currentWindGust = Number(current.wind_gusts_10m);
        const currentWindSpeed = Number(current.wind_speed_10m);
        const startIndex =
          typeof current.time === "string" && hourlyTimes.includes(current.time)
            ? hourlyTimes.indexOf(current.time)
            : 0;
        const windowEnd = Math.min(startIndex + 3, hourlyTimes.length || 3);
        const upcomingCodes = hourlyCodes.slice(startIndex, windowEnd).map((value) => Number(value));
        const upcomingPrecipitation = precipitationValues.slice(startIndex, windowEnd).map((value) => Number(value));
        const upcomingAmounts = precipitationAmounts.slice(startIndex, windowEnd).map((value) => Number(value));
        const upcomingGusts = hourlyGusts.slice(startIndex, windowEnd).map((value) => Number(value));
        const maxUpcomingPrecipitation = upcomingPrecipitation.reduce(
          (max, value) => (Number.isFinite(value) ? Math.max(max, value) : max),
          0
        );
        const maxUpcomingRainAmount = upcomingAmounts.reduce(
          (max, value) => (Number.isFinite(value) ? Math.max(max, value) : max),
          0
        );
        const maxUpcomingGust = upcomingGusts.reduce(
          (max, value) => (Number.isFinite(value) ? Math.max(max, value) : max),
          Number.isFinite(currentWindGust) ? currentWindGust : 0
        );
        const hasThunderstorm = thunderstormCodes.has(currentCode) || upcomingCodes.some((code) => thunderstormCodes.has(code));
        const hasRainRisk = rainCodes.has(currentCode) || upcomingCodes.some((code) => rainCodes.has(code));
        const immediateStormRisk = hasThunderstorm;
        const nearRainRisk = maxUpcomingPrecipitation >= 50 || maxUpcomingRainAmount >= 1 || hasRainRisk;

        if (maxUpcomingGust >= 45) {
          setAlertState(
            windNode,
            windTitleNode,
            windTextNode,
            "is-warning",
            "Erős szél közeleg",
            "Húzzátok vissza a medence tetejét, és ne használjátok a medencét."
          );
        } else if (maxUpcomingGust >= 25 || currentWindSpeed >= 25) {
          setAlertState(
            windNode,
            windTitleNode,
            windTextNode,
            "is-caution",
            "Szelesebb idő jöhet",
            "Kérlek húzzátok be a napernyőket."
          );
        } else {
          setAlertState(windNode, windTitleNode, windTextNode, "is-calm", "Szél: rendben", "Nincs teendő.");
        }

        if (immediateStormRisk) {
          setAlertState(
            stormNode,
            stormTitleNode,
            stormTextNode,
            "is-warning",
            "Vihar közeleg",
            "Hagyjátok el a medencét, és tegyetek mindent biztonságos helyre."
          );
        } else if (nearRainRisk) {
          setAlertState(
            stormNode,
            stormTitleNode,
            stormTextNode,
            "is-caution",
            "Eső vagy vihar jöhet",
            "Készítsétek elő a kinti dolgokat, és figyeljétek az időt."
          );
        } else {
          setAlertState(
            stormNode,
            stormTitleNode,
            stormTextNode,
            "is-calm",
            "Eső / vihar: nem várható",
            "Közelben nincs csapadék."
          );
        }
      } catch {
        setAlertState(windNode, windTitleNode, windTextNode, "is-caution", "Szél adat nincs", "Nézzetek rá külön az időjárásra.");
        setAlertState(
          stormNode,
          stormTitleNode,
          stormTextNode,
          "is-caution",
          "Eső / vihar adat nincs",
          "Nézzetek rá külön az időjárásra."
        );
      }
    };

    if (document.readyState === "loading") {
      document.addEventListener(
        "DOMContentLoaded",
        () => {
          updatePoolTemperature();
          updateWeatherAlert();
        },
        { once: true }
      );
    } else {
      updatePoolTemperature();
      updateWeatherAlert();
    }
  })();
</script>

<style>
  :global(body) {
    background:
      radial-gradient(circle at top, rgba(150, 210, 222, 0.34), transparent 34%),
      linear-gradient(180deg, #eef7f7 0%, #f8f4ec 52%, #ffffff 100%);
  }

  .pool-qr-page {
    min-height: 100vh;
    color: #1f2f2c;
    padding-bottom: 44px;
    text-align: center;
  }

  .pool-qr-hero {
    position: relative;
    min-height: 380px;
    overflow: hidden;
    background:
      radial-gradient(circle at top left, rgba(152, 220, 234, 0.52), transparent 30%),
      radial-gradient(circle at right 20%, rgba(255, 231, 185, 0.75), transparent 24%),
      linear-gradient(180deg, #f8fffe 0%, #eef7f7 48%, #f8f4ec 100%);
    color: #17313a;
  }

  .pool-qr-hero__content,
  .pool-qr-shell {
    width: min(100% - 28px, 860px);
    margin: 0 auto;
  }

  .pool-qr-hero__content {
    position: relative;
    display: grid;
    gap: 16px;
    padding: 60px 0 40px;
    justify-items: center;
  }

  .pool-qr-language-switch {
