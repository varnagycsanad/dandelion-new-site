---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Hero from "../../sections/Hero.astro";
import PanoramaPoolHighlight from "../../sections/PanoramaPoolHighlight.astro";
import HomeReviews from "../../sections/HomeReviews.astro";
import HomeRegionGuide from "../../sections/HomeRegionGuide.astro";
import RegionStories from "../../sections/RegionStories.astro";
import Experiences from "../../sections/Experiences.astro";
import NewsletterSignup from "../../sections/NewsletterSignup.astro";
import GoogleRegionMap from "../../sections/GoogleRegionMap.astro";
import HomeGeoFaq from "../../sections/HomeGeoFaq.astro";
import bikingImage from "../../assets/home/experiences/dandelion-home-experience-bike-01-mobile-optimized.webp";
import wineTourImage from "../../assets/home/experiences/dandelion-home-experience-wine-gastro-01-optimized.webp";
import balatonImage from "../../assets/home/experiences/dandelion-home-experience-balaton-01.webp";
import mountainsImage from "../../assets/home/experiences/dandelion-home-experience-tanuhegyek-01.webp";
import kisapatiStoryImage from "../../assets/home/region-stories/dandelion-home-tanuhegyek-story-01.webp";
import balatonStoryImage from "../../assets/home/region-stories/dandelion-home-balaton-story-02.webp";
import kaliStoryImage from "../../assets/accommodations/koveskal/gallery/dandelion-koveskal-source-001.webp";
import { buildVideoObject } from "../../data/video-seo";
import { buildHomeGeoFaqStructuredData } from "../../data/home-geo-faq";

// [CHANGE 2026-05-20 00:00] English homepage now follows the Hungarian homepage video and section system.
const enTitle = "Dandelion Guesthouses | Countryside stays near Lake Balaton";
const enDescription =
  "Peaceful countryside guesthouses around the Balaton Uplands, Szent György Hill and Badacsony, with gardens, terraces and direct booking.";
const bookingHref = "https://ibe.sabeeapp.com/v3/p/Dandelion-Vendégházak?p=3970b30e1042d58f&lang=En";

// [CHANGE 2026-05-29 00:00] English homepage hero video now has poster and VideoObject data for Google indexing.
const homepageHeroVideo = "/videos/fooldal/hero/DND_Fooldal_hero_05-21.mp4?v=20260521";
const homepageHeroMobileVideo = "/videos/fooldal/hero/DND_Fooldal_hero_05-21-mobile-lite.mp4?v=20260606-mobile-lite";
const homepageHeroPoster = kisapatiStoryImage.src;
const homepageVideoStructuredData = buildVideoObject({
  id: "/en/#homepage-hero-video",
  name: "Dandelion Guesthouses homepage mood video",
  description: "Homepage mood video introducing peaceful Dandelion guesthouses near Lake Balaton.",
  contentUrl: homepageHeroVideo,
  thumbnailUrl: homepageHeroPoster,
  uploadDate: "2026-05-21T00:00:00+02:00",
  inLanguage: "en-US"
});
const homepageStructuredData = [homepageVideoStructuredData, buildHomeGeoFaqStructuredData("en")];

const englishRegionStories = [
  {
    kicker: "Kisapáti · Szent György Hill · Tapolca Basin",
    title: "Among the witness hills",
    description:
      "Vine rows, quiet roads and slow mornings shape this side of the Balaton Uplands.",
    meta: "A calm countryside base near Szent György Hill.",
    ctaLabel: "View stays near the hills",
    mobileCtaLabel: "Stays near Szent György Hill",
    ctaHref: "/en/szallasok/#balaton-uplands",
    image: kisapatiStoryImage,
    imageAlt: "Kisapáti and the witness hills in the Balaton Uplands"
  },
  {
    kicker: "Keszthely · Badacsonyörs · Lake Balaton",
    title: "Close to the lake",
    description:
      "Easy lake days, harbours and summer evenings, still with the slower Dandelion rhythm.",
    meta: "For guests who want Lake Balaton nearby without giving up calm surroundings.",
    ctaLabel: "View stays near Lake Balaton",
    mobileCtaLabel: "Stays near Lake Balaton",
    ctaHref: "/en/szallasok/#near-lake-balaton",
    image: balatonStoryImage,
    imageAlt: "Dandelion stay near Lake Balaton with waterside atmosphere"
  },
  {
    kicker: "Köveskál · Káli-medence",
    title: "The quieter Káli side",
    description:
      "Stone walls, village streets and a softer pace for guests looking for a more withdrawn stay.",
    meta: "A good fit for slow days, wine roads and village walks.",
    ctaLabel: "View stays in Káli-medence",
    mobileCtaLabel: "Stays in Káli-medence",
    ctaHref: "/en/szallasok/#kali-medence",
    image: kaliStoryImage,
    imageAlt: "Káli-medence countryside landscape near Köveskál"
  }
];

const englishExperiences = [
  {
    title: "CYCLING",
    description: "Village roads, vineyards and soft hills for easy rides.",
    image: bikingImage,
    imageAlt: "Cycling route in the Balaton Uplands countryside",
    href: "/en/bike-rental/"
  },
  {
    title: "WINE AND FOOD",
    description: "Cellars, terraces and small local stops around the hills.",
    image: wineTourImage,
    imageAlt: "Outdoor wine and gastronomy setting near the Balaton Uplands",
    href: "/en/wineries/"
  },
  {
    title: "LAKE BALATON",
    description: "Beaches, boats and simple summer programmes nearby.",
    image: balatonImage,
    imageAlt: "Badacsony and Lake Balaton panorama",
    href: "/en/lake-balaton/"
  },
  {
    title: "WITNESS HILLS",
    description: "Lookouts and walking routes around Szent György Hill and Badacsony.",
    image: mountainsImage,
    imageAlt: "Witness hills in the Balaton Uplands",
    href: "/en/witness-hills/"
  }
];

---

<BaseLayout
  title={enTitle}
  description={enDescription}
  canonicalPath="/en/"
  lang="en"
  ogLocale="en_US"
  structuredData={homepageStructuredData}
>
  <Hero
    titleTopLines={["Countryside", "guesthouses"]}
    titleBottomLines={["near", "Lake Balaton"]}
    description="Peaceful stays around the Balaton Uplands, Szent György Hill and Badacsony."
    ctas={[
      { label: "View accommodations", href: "/en/szallasok/" },
      { label: "Check availability", href: bookingHref, target: "_blank", rel: "noopener noreferrer" }
    ]}
    videoDesktopSrc={homepageHeroVideo}
    videoMobileSrc={homepageHeroMobileVideo}
    posterSrc={homepageHeroPoster}
    posterAlt="Kisapáti and the witness hills in the Balaton Uplands"
    videoFallbackText="Your browser does not support background video playback."
  />

  <PanoramaPoolHighlight lang="en" />
  <HomeReviews lang="en" />

  <HomeRegionGuide lang="en" />

  <RegionStories
    kickerLabel="Accommodations"
    heading="One Dandelion mood, three landscapes"
    lead="Choose between witness hills, Lake Balaton days and the quieter Káli-medence villages."
    stories={englishRegionStories}
  />

  <Experiences
    sectionId="experiences"
    title="EXPERIENCES"
    lead="Cycling, wine, Lake Balaton and hill walks in the easy rhythm of the region."
    ctaLabel="PLAN FROM YOUR STAY"
    ctaHref="/en/experiences/"
    mobileCtaLabel="MORE"
    experiences={englishExperiences}
  />

  <NewsletterSignup lang="en" />
  <HomeGeoFaq lang="en" />
  <GoogleRegionMap lang="en" />
</BaseLayout>
