---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Hero from "../../sections/Hero.astro";
import RegionStories from "../../sections/RegionStories.astro";
import Experiences from "../../sections/Experiences.astro";
import bikingImage from "../../assets/home/experiences/dandelion-home-experience-bike-01-optimized.webp";
import wineTourImage from "../../assets/home/experiences/dandelion-home-experience-wine-gastro-01-optimized.webp";
import balatonImage from "../../assets/home/experiences/dandelion-home-experience-balaton-01.webp";
import mountainsImage from "../../assets/home/experiences/dandelion-home-experience-tanuhegyek-01.webp";
import kisapatiStoryImage from "../../assets/home/region-stories/dandelion-home-tanuhegyek-story-01.webp";
import balatonStoryImage from "../../assets/home/region-stories/dandelion-home-balaton-story-02.webp";
import kaliStoryImage from "../../assets/accommodations/koveskal/gallery/dandelion-koveskal-source-001.webp";
import galleryD2Image from "../../assets/accommodations/d2/gallery/dandelion-d2-source-002.webp";
import galleryFugehazImage from "../../assets/accommodations/fugehaz/gallery/dandelion-fugehaz-source-001.webp";
import galleryRoyalImage from "../../assets/accommodations/royal_homes/gallery/dandelion-royal-homes-source-001.webp";

// [CHANGE 2026-05-20 00:00] English homepage now follows the Hungarian homepage video and section system.
const enTitle = "Dandelion Guesthouses | Countryside stays near Lake Balaton";
const enDescription =
  "Peaceful countryside guesthouses around the Balaton Uplands, Szent György Hill and Badacsony, with gardens, terraces and direct booking.";
const bookingHref = "https://ibe.sabeeapp.com/v3/p/Dandelion-Vendégházak?p=3970b30e1042d58f&lang=En";

const englishRegionStories = [
  {
    kicker: "Kisapáti · Szent György Hill · Tapolca Basin",
    title: "Among the witness hills",
    description:
      "Vine rows, quiet roads and slow mornings shape this side of the Balaton Uplands.",
    meta: "A calm countryside base near Szent György Hill.",
    ctaLabel: "View stays near the hills",
    mobileCtaLabel: "Stays near Szent György Hill",
    ctaHref: "/en/szallasok/#balaton-uplands",
    image: kisapatiStoryImage,
    imageAlt: "Kisapáti and the witness hills in the Balaton Uplands"
  },
  {
    kicker: "Keszthely · Badacsonyörs · Lake Balaton",
    title: "Close to the lake",
    description:
      "Easy lake days, harbours and summer evenings, still with the slower Dandelion rhythm.",
    meta: "For guests who want Lake Balaton nearby without giving up calm surroundings.",
    ctaLabel: "View stays near Lake Balaton",
    mobileCtaLabel: "Stays near Lake Balaton",
    ctaHref: "/en/szallasok/#near-lake-balaton",
    image: balatonStoryImage,
    imageAlt: "Dandelion stay near Lake Balaton with waterside atmosphere"
  },
  {
    kicker: "Köveskál · Káli-medence",
    title: "The quieter Káli side",
    description:
      "Stone walls, village streets and a softer pace for guests looking for a more withdrawn stay.",
    meta: "A good fit for slow days, wine roads and village walks.",
    ctaLabel: "View stays in Káli-medence",
    mobileCtaLabel: "Stays in Káli-medence",
    ctaHref: "/en/szallasok/#kali-medence",
    image: kaliStoryImage,
    imageAlt: "Káli-medence countryside landscape near Köveskál"
  }
];

const englishExperiences = [
  {
    title: "CYCLING",
    description: "Village roads, vineyards and soft hills for easy rides.",
    image: bikingImage,
    imageAlt: "Cycling route in the Balaton Uplands countryside",
    href: "/en/bike-rental/"
  },
  {
    title: "WINE AND FOOD",
    description: "Cellars, terraces and small local stops around the hills.",
    image: wineTourImage,
    imageAlt: "Outdoor wine and gastronomy setting near the Balaton Uplands",
    href: "/en/wineries/"
  },
  {
    title: "LAKE BALATON",
    description: "Beaches, boats and simple summer programmes nearby.",
    image: balatonImage,
    imageAlt: "Badacsony and Lake Balaton panorama",
    href: "/en/lake-balaton/"
  },
  {
    title: "WITNESS HILLS",
    description: "Lookouts and walking routes around Szent György Hill and Badacsony.",
    image: mountainsImage,
    imageAlt: "Witness hills in the Balaton Uplands",
    href: "/en/witness-hills/"
  }
];

const galleryItems = [
  {
    image: galleryD2Image,
    alt: "Dandelion D2 terrace with outdoor seating",
    label: "Dandelion D2"
  },
  {
    image: galleryFugehazImage,
    alt: "Fügeház terrace and countryside setting",
    label: "Fügeház"
  },
  {
    image: galleryRoyalImage,
    alt: "Dandelion Royal Homes apartment near Lake Balaton",
    label: "Dandelion Royal Homes"
  }
];
---

<BaseLayout
  title={enTitle}
  description={enDescription}
  canonicalPath="/en/"
  lang="en"
  ogLocale="en_US"
>
  <Hero
    titleTopLines={["Countryside", "guesthouses"]}
    titleBottomLines={["near", "Lake Balaton"]}
    description="Peaceful stays around the Balaton Uplands, Szent György Hill and Badacsony."
    ctas={[
      { label: "View accommodations", href: "/en/szallasok/" },
      { label: "Check availability", href: bookingHref, target: "_blank", rel: "noopener noreferrer" }
    ]}
    videoFallbackText="Your browser does not support background video playback."
  />

  <section class="en-home-intro dnd-section" aria-labelledby="english-home-intro-title">
    <div class="dnd-container en-home-intro__inner">
      <span class="dnd-section-kicker">Dandelion Guesthouses</span>
      <h2 id="english-home-intro-title">Quiet countryside places with gardens, terraces and room to breathe.</h2>
      <p>
        Dandelion is for guests who want Lake Balaton close, but not the rush: family-friendly houses,
        apartments with outdoor spaces and a calm rural rhythm around the Balaton Uplands.
      </p>
    </div>
  </section>

  <RegionStories
    kickerLabel="Accommodations"
    heading="One Dandelion mood, three landscapes"
    lead="Choose between witness hills, Lake Balaton days and the quieter Káli-medence villages."
    stories={englishRegionStories}
  />

  <Experiences
    sectionId="experiences"
    title="EXPERIENCES"
    lead="Cycling, wine, Lake Balaton and hill walks in the easy rhythm of the region."
    ctaLabel="PLAN FROM YOUR STAY"
    ctaHref="/en/experiences/"
    mobileCtaLabel="MORE"
    experiences={englishExperiences}
  />

  <section id="gallery" class="en-home-gallery dnd-section" aria-labelledby="english-gallery-title">
    <div class="dnd-container">
      <div class="en-home-gallery__head">
        <span class="dnd-section-kicker">Gallery</span>
        <h2 id="english-gallery-title">A first look at the Dandelion atmosphere.</h2>
        <p>Terraces, gardens and calm interiors from the first English accommodation selection.</p>
      </div>
      <div class="en-home-gallery__grid">
        {galleryItems.map((item) => (
          <figure class="en-home-gallery__item">
            <img
              src={item.image.src}
              alt={item.alt}
              width={item.image.width}
              height={item.image.height}
              loading="lazy"
              decoding="async"
            />
            <figcaption>{item.label}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="en-home-booking dnd-section" aria-labelledby="english-booking-title">
    <div class="dnd-container en-home-booking__inner">
      <div>
        <span class="dnd-section-kicker">Direct booking</span>
        <h2 id="english-booking-title">Ask directly, choose calmly.</h2>
        <p>
          Direct booking keeps the conversation simple: you can ask about the house, arrival details,
          location or which Dandelion stay fits your group before you decide.
        </p>
      </div>
      <a class="en-home-booking__cta" href={bookingHref} target="_blank" rel="noopener noreferrer">
        Check availability
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .en-home-intro {
    padding: 64px 0 34px;
    background: #fdfbf7;
  }

  .en-home-intro__inner {
    max-width: 760px;
    text-align: center;
  }

  .en-home-intro h2,
  .en-home-gallery h2,
  .en-home-booking h2 {
    margin: 10px 0 0;
    font-family: var(--dnd-font-display);
    font-size: clamp(1.65rem, 2.7vw, 2.45rem);
    font-weight: 400;
    line-height: 1.1;
    color: rgba(0, 0, 0, 0.86);
  }

  .en-home-intro p,
  .en-home-gallery p,
  .en-home-booking p {
    margin: 16px auto 0;
    max-width: 58ch;
    color: rgba(0, 0, 0, 0.66);
    font-size: var(--dnd-text-body);
    line-height: 1.68;
  }

  .en-home-gallery {
    padding: 86px 0 76px;
    background: #fdfbf7;
    scroll-margin-top: 150px;
  }

  .en-home-gallery__head {
    max-width: 720px;
    margin-bottom: 26px;
  }

  .en-home-gallery__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
  }

  .en-home-gallery__item {
    position: relative;
    min-height: 340px;
    margin: 0;
    overflow: hidden;
    border-radius: 18px;
    background: #ddd5c8;
  }

  .en-home-gallery__item img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .en-home-gallery__item::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 42%, rgba(17, 13, 9, 0.56));
  }

  .en-home-gallery__item figcaption {
    position: absolute;
    left: 18px;
    bottom: 16px;
    z-index: 1;
    color: #fff;
    font-size: var(--dnd-text-sm);
    font-weight: 700;
    line-height: 1.35;
  }

  .en-home-booking {
    padding: 74px 0 84px;
    background: #f7f2e7;
  }

  .en-home-booking__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
    padding: 32px;
    border: 1px solid rgba(91, 70, 42, 0.12);
    border-radius: 18px;
    background: #fffdfa;
  }

  .en-home-booking h2 {
    margin-top: 8px;
  }

  .en-home-booking p {
    margin-left: 0;
  }

  .en-home-booking__cta {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    min-height: 50px;
    padding: 0 24px;
    border-radius: 999px;
    background: #d99e2b;
    color: #17120e;
    font-size: var(--dnd-text-sm);
    font-weight: 700;
    line-height: 1.2;
    text-decoration: none;
  }

  @media (max-width: 820px) {
    .en-home-intro {
      padding: 52px 0 28px;
    }

    .en-home-gallery {
      padding: 64px 0 58px;
    }

    .en-home-gallery__grid {
      grid-template-columns: 1fr;
    }

    .en-home-gallery__item {
      min-height: 300px;
      border-radius: 14px;
    }

    .en-home-booking__inner {
      display: grid;
      padding: 24px 18px;
    }

    .en-home-booking__cta {
      width: 100%;
    }
  }
</style>
