---
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import wineImage from "../../assets/experiences/szent-gyorgy-hegy-szolo.jpg";
import balatonImage from "../../assets/experiences/balaton-shore.jpg";
import mountainsImage from "../../assets/experiences/tanuhegyek-drone-dji-20260512.jpg";
import { toAbsoluteUrl } from "../../data/site-seo";
import { buildVideoObject } from "../../data/video-seo";

const title = "Experiences near Lake Balaton | Dandelion Guesthouses";
const description =
  "Cycling, wineries, Lake Balaton beaches and witness hill walks around the Dandelion guesthouses in the Balaton Uplands.";
const heroVideo = "/videos/elmenyek/hero/elmenyek-hero-0516.mp4?v=20260520-faststart";
// [CHANGE 2026-05-29 00:00] English experiences hero video now has poster and VideoObject data for Google indexing.
const heroPoster = mountainsImage.src;
const bikingImage = "/images/bicikli/balaton-felvidek-bicikli-desktop.webp";

const quickFacts = [
  "cycling routes and quiet side roads",
  "wineries around Szent György Hill",
  "Lake Balaton beaches nearby",
  "witness hill walks and sunsets"
];

const experiences = [
  {
    eyebrow: "Active days",
    title: "Bike rental",
    description:
      "Easy village loops, vineyard roads and slower rides through the Balaton Uplands.",
    highlights: ["short rides or full-day plans", "standard bikes and e-bike option"],
    image: bikingImage,
    imageAlt: "Bicycle in a nature-close Balaton Uplands setting",
    href: "/en/bike-rental/",
    ctaLabel: "Bike details"
  },
  {
    eyebrow: "Wine and panorama",
    title: "Wineries",
    description:
      "Cellars, terraces and slow afternoons around Szent György Hill and Badacsony.",
    highlights: ["hill cellars", "sunset wine stops"],
    image: wineImage,
    imageAlt: "Vineyards around Szent György Hill in the Balaton Uplands",
    href: "/en/wineries/",
    ctaLabel: "Wineries"
  },
  {
    eyebrow: "Lake days",
    title: "Lake Balaton",
    description:
      "Beaches, waterside walks and easy summer programmes within a short drive.",
    highlights: ["nearby beaches", "kayak, canoe and SUP ideas"],
    image: balatonImage,
    imageAlt: "Stony Lake Balaton shoreline in summer light",
    href: "/en/lake-balaton/",
    ctaLabel: "Lake details"
  },
  {
    eyebrow: "Nature-close programmes",
    title: "Witness hills",
    description:
      "Lookouts, shorter walks and quiet hiking routes around the region's volcanic hills.",
    highlights: ["panoramic lookout points", "sunset routes"],
    image: mountainsImage,
    imageAlt: "Drone view of the witness hills and the Tapolca Basin",
    href: "/en/witness-hills/",
    ctaLabel: "Hill walks"
  }
];

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Home",
        item: toAbsoluteUrl("/en/")
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Experiences",
        item: toAbsoluteUrl("/en/experiences/")
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: "Experiences near Lake Balaton",
    itemListElement: experiences.map((item, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: item.title,
      description: item.description,
      url: toAbsoluteUrl(item.href)
    }))
  },
  buildVideoObject({
    id: "/en/experiences/#hero-video",
    name: "Dandelion experiences hero video",
    description: "Hero video introducing cycling, wineries, Lake Balaton and witness hill experiences near Dandelion guesthouses.",
    contentUrl: heroVideo,
    thumbnailUrl: heroPoster,
    uploadDate: "2026-05-20T00:00:00+02:00",
    inLanguage: "en-US"
  })
];
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath="/en/experiences/"
  lang="en"
  ogLocale="en_US"
  structuredData={structuredData}
  headerMode="transparent"
>
  <section class="experiences-page">
    <section class="experiences-hero">
      <video
        class="experiences-hero__video"
        src={heroVideo}
        poster={heroPoster}
        autoplay
        muted
        loop
        playsinline
        webkit-playsinline
        preload="auto"
        disablepictureinpicture
        disableremoteplayback
      >
        Your browser does not support background video playback.
      </video>

      <div class="experiences-hero__content">
        <div class="dnd-container experiences-hero__inner">
          <div class="experiences-hero__headline">
            <span class="experiences-page__eyebrow">Region and things to do</span>
            <h1>Choose the mood of your day, then plan it from your stay.</h1>
          </div>
        </div>
      </div>
    </section>

    <div class="dnd-container experiences-page__inner">
      <section class="experiences-page__intro">
        <p class="experiences-page__lead">
          The Dandelion houses sit between Lake Balaton, Szent György Hill and the Balaton Uplands.
          Some days are made for cycling, some for a quiet wine terrace, a beach afternoon or a walk
          among the witness hills. This page gathers the main directions, with the first detailed
          English page available for bike rental.
        </p>

        <div class="experiences-page__facts" aria-label="Experience quick overview">
          {quickFacts.map((fact) => (
            <span>{fact}</span>
          ))}
        </div>
      </section>

      <section class="experiences-page__grid" aria-label="Featured experiences">
        {experiences.map((item) => (
          <article class="experience-card">
            <div class="experience-card__media">
              {typeof item.image === "string" ? (
                <img src={item.image} alt={item.imageAlt} loading="lazy" />
              ) : (
                <Image src={item.image} alt={item.imageAlt} loading="lazy" />
              )}
            </div>

            <div class="experience-card__body">
              <span class="experience-card__eyebrow">{item.eyebrow}</span>
              <h2>{item.title}</h2>
              <p>{item.description}</p>

              <ul class="experience-card__highlights" aria-label={`${item.title} highlights`}>
                {item.highlights.map((highlight) => (
                  <li>{highlight}</li>
                ))}
              </ul>

              {item.href ? (
                <a class="experience-card__cta" href={item.href}>{item.ctaLabel}</a>
              ) : (
                <span class="experience-card__cta experience-card__cta--pending" aria-disabled="true">
                  {item.ctaLabel}
                </span>
              )}
            </div>
          </article>
        ))}
      </section>

      <section class="experiences-page__cta-panel">
        <h2>Ready to choose the house around the plan?</h2>
        <p>
          Browse the English accommodation selection and pick the landscape that fits your rhythm:
          witness hills, Lake Balaton or the quieter Káli-medence side.
        </p>
        <div class="experiences-page__cta-actions">
          <a href="/en/szallasok/" class="experiences-page__cta-primary">View accommodations</a>
          <a href="/en/" class="experiences-page__cta-secondary">Back to English home</a>
        </div>
      </section>
    </div>
  </section>
</BaseLayout>

<style>
  .experiences-page {
    padding-bottom: 88px;
    background:
      radial-gradient(circle at top left, rgba(215, 188, 127, 0.16), transparent 34%),
      linear-gradient(180deg, #fcfbf7 0%, #f6f0e7 100%);
  }

  .experiences-page__inner {
    display: grid;
    gap: 26px;
    margin-top: 28px;
  }

  .experiences-hero {
    position: relative;
    min-height: 640px;
    height: 84vh;
    overflow: hidden;
    background: #171717;
  }

  .experiences-hero__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .experiences-hero__content {
    position: relative;
    z-index: 2;
    min-height: 100%;
    color: #fff;
  }

  .experiences-hero__inner {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    min-height: 100%;
    max-width: none;
    padding: 148px clamp(48px, 7vw, 96px) 96px;
  }

  .experiences-hero__headline {
    display: grid;
    justify-items: center;
    gap: 16px;
    width: min(100%, 1040px);
    text-align: center;
  }

  .experiences-page__eyebrow,
  .experience-card__eyebrow {
    display: inline-block;
    color: #a56d1f;
    font-size: var(--dnd-text-2xs);
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .experiences-hero .experiences-page__eyebrow {
    color: rgba(255, 255, 255, 0.96);
    text-shadow: 0 1px 10px rgba(0, 0, 0, 0.18);
  }

  .experiences-page h1,
  .experiences-page__cta-panel h2,
  .experience-card h2 {
    margin: 0;
    color: #261d16;
    font-family: var(--dnd-font-display);
    font-weight: 500;
    line-height: 1.08;
  }

  .experiences-hero h1 {
    max-width: 32ch;
    font-size: clamp(2.2rem, 3.35vw, 3.55rem);
    line-height: 1.08;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: #ffffff;
    text-wrap: balance;
    text-transform: uppercase;
    text-shadow: 0 2px 18px rgba(0, 0, 0, 0.2);
  }

  .experiences-page__intro,
  .experiences-page__cta-panel {
    display: grid;
    gap: 14px;
    padding: 28px;
    border: 1px solid rgba(88, 63, 38, 0.12);
    border-radius: 24px;
    background: rgba(255, 252, 246, 0.84);
    box-shadow: 0 20px 56px rgba(43, 28, 14, 0.07);
  }

  .experiences-page__lead,
  .experience-card p,
  .experiences-page__cta-panel p {
    margin: 0;
    color: rgba(38, 29, 22, 0.76);
    font-size: var(--dnd-text-body);
    line-height: 1.68;
  }

  .experiences-page__intro {
    justify-items: center;
    text-align: center;
  }

  .experiences-page__lead {
    max-width: 72ch;
  }

  .experiences-page__facts {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    justify-content: center;
  }

  .experiences-page__facts span,
  .experience-card__highlights li {
    padding: 8px 11px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.9);
    border: 1px solid rgba(88, 63, 38, 0.12);
    color: rgba(38, 29, 22, 0.86);
    font-size: var(--dnd-text-md);
  }

  .experiences-page__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 18px;
    align-items: stretch;
  }

  .experience-card {
    display: grid;
    grid-template-rows: auto 1fr;
    border: 1px solid rgba(88, 63, 38, 0.12);
    border-radius: 24px;
    background: rgba(255, 255, 255, 0.92);
    overflow: hidden;
    box-shadow: 0 20px 56px rgba(43, 28, 14, 0.07);
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease,
      border-color 0.2s ease;
  }

  .experience-card:hover,
  .experience-card:focus-within {
    transform: translateY(-3px);
    box-shadow: 0 28px 64px rgba(43, 28, 14, 0.12);
    border-color: rgba(88, 63, 38, 0.22);
  }

  .experience-card__media {
    overflow: hidden;
  }

  .experience-card__media :global(picture),
  .experience-card__media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .experience-card__media :global(img) {
    aspect-ratio: 1 / 0.88;
    object-fit: cover;
  }

  .experience-card__body {
    display: grid;
    grid-template-rows: auto auto auto auto 1fr auto;
    gap: 10px;
    padding: 18px;
  }

  .experience-card h2 {
    font-size: clamp(1.06rem, 1.42vw, 1.34rem);
  }

  .experience-card p {
    line-height: 1.54;
  }

  .experience-card__highlights {
    margin: 2px 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-self: start;
  }

  .experience-card__cta,
  .experiences-page__cta-primary,
  .experiences-page__cta-secondary {
    min-height: 46px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0 18px;
    text-decoration: none;
    font-size: var(--dnd-text-xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    border: 1px solid rgba(65, 47, 30, 0.4);
    transition: all 0.2s ease;
  }

  .experience-card__cta {
    margin-top: 2px;
    width: 100%;
    justify-self: stretch;
    align-self: end;
    background: #2b2016;
    color: #fff;
    border-color: #2b2016;
  }

  .experience-card__cta--pending {
    background: #f8f2e8;
    color: rgba(38, 29, 22, 0.6);
    border-color: rgba(88, 63, 38, 0.14);
  }

  .experience-card__cta:focus-visible {
    outline: 2px solid rgba(165, 109, 31, 0.3);
    outline-offset: 2px;
  }

  .experiences-page__cta-panel h2 {
    font-size: clamp(1.5rem, 2.3vw, 2.2rem);
  }

  .experiences-page__cta-actions {
    margin-top: 4px;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .experiences-page__cta-primary {
    background: #fff;
    color: #2b2016;
  }

  .experiences-page__cta-secondary {
    background: #2b2016;
    color: #fff;
    border-color: #2b2016;
  }

  .experiences-page__cta-primary:hover,
  .experiences-page__cta-primary:focus-visible {
    background: #f7efe2;
  }

  .experiences-page__cta-secondary:hover,
  .experiences-page__cta-secondary:focus-visible,
  .experience-card:hover .experience-card__cta:not(.experience-card__cta--pending),
  .experience-card:focus-within .experience-card__cta:not(.experience-card__cta--pending) {
    background: #3a2a1d;
  }

  @media (max-width: 1100px) {
    .experiences-page__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 768px) {
    .experiences-hero__content {
      position: absolute;
      inset: 0;
    }

    .experiences-hero__inner {
      position: relative;
      justify-content: flex-end;
      height: 100%;
      min-height: 100%;
    }

    .experiences-hero__headline {
      position: absolute;
      left: 50%;
      bottom: clamp(92px, 12vh, 132px);
      width: min(calc(100% - 96px), 1040px);
      transform: translateX(-50%);
    }
  }

  @media (max-width: 767px) {
    .experiences-page {
      padding-bottom: 64px;
    }

    .experiences-page__inner {
      gap: 20px;
      margin-top: 20px;
    }

    .experiences-hero,
    .experiences-hero__content,
    .experiences-hero__inner {
      min-height: 520px;
    }

    .experiences-hero {
      height: auto;
    }

    .experiences-hero__inner {
      justify-content: center;
      padding: 0;
    }

    .experiences-hero__headline {
      width: 100%;
      max-width: 340px;
      gap: 12px;
    }

    .experiences-hero h1 {
      max-width: 12ch;
      font-size: clamp(2rem, 9vw, 2.8rem);
      line-height: 1.03;
    }

    .experiences-page__intro,
    .experiences-page__cta-panel,
    .experience-card__body {
      padding: 16px;
    }

    .experiences-page__intro,
    .experiences-page__cta-panel,
    .experience-card {
      border-radius: 18px;
    }

    .experiences-page__lead {
      font-size: var(--dnd-text-md);
      line-height: 1.56;
    }

    .experiences-page__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }

    .experience-card__media :global(img) {
      aspect-ratio: 1 / 1;
    }

    .experience-card__body {
      grid-template-rows: auto auto auto 1fr auto;
      gap: 9px;
    }

    .experience-card h2 {
      font-size: var(--dnd-text-body);
    }

    .experience-card p {
      font-size: var(--dnd-text-sm);
      line-height: 1.42;
    }

    .experience-card__highlights {
      display: none;
    }

    .experience-card__cta {
      min-height: 40px;
      padding-inline: 12px;
      font-size: var(--dnd-text-2xs);
      letter-spacing: 0.08em;
    }
  }
</style>
