---
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { accommodationSections, accommodations } from "../../data/accommodations";
import { SITE_NAME, toAbsoluteUrl } from "../../data/site-seo";
import { readHomepageImageMapping } from "../../lib/homepage-image-mapping";

// [CHANGE 2026-05-19 00:00] First safe English accommodations list page, without registry or SabeeApp changes.
type SectionKey = (typeof accommodationSections)[number]["key"];

interface EnglishStayCopy {
  name: string;
  location: string;
  description: string;
  hoverText: string;
  facts: string[];
  imageAlt: string;
}

const title = "Accommodations in the Balaton Uplands | Dandelion Guesthouses";
const description =
  "Discover peaceful countryside guesthouses and apartments near Szent György Hill, Badacsony, Kisapáti, Keszthely and the Balaton Uplands.";
const accommodationsOgImage = "/images/pages/szallasok-hero-bg.webp";
const accommodationsHeroVideo = "/videos/szallasok/202507%20V1.mp4?v=20260603-lite";
const accommodationsHeroMobileVideo = "/videos/szallasok/202507%20V1-mobile.mp4?v=20260603-mobile-crop";
const accommodationsOgImageAlt =
  "Dandelion guesthouse selection page for countryside stays in the Balaton Uplands";

const imageMapping = await readHomepageImageMapping();
const baseHref = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const contactHref = `${baseHref}en/contact/`;

const resolveStayHref = (href: string) =>
  href.startsWith("/") ? `${baseHref}${href.replace(/^\/+/, "")}` : href;
const resolveEnglishStayHref = (slug: string, href: string) =>
  slug === "dandelion-d2"
    ? `${baseHref}en/dandelion-d2/`
    : slug === "fugehaz"
      ? `${baseHref}en/dandelion-fugehaz/`
      : slug === "dandelion-d1"
        ? `${baseHref}en/dandelion-d1/`
        : slug === "zsalya-vendeghaz"
          ? `${baseHref}en/dandelion-zsalya/`
          : slug === "szololiget-vendeghaz"
            ? `${baseHref}en/szololiget/`
            : slug === "szepvolgyi-vendeghaz"
              ? `${baseHref}en/szepvolgyi/`
              : slug === "royal-homes"
                ? `${baseHref}en/royal/`
                : slug === "vintage-vendeghaz"
                  ? `${baseHref}en/dandelion-vintage/`
                  : slug === "dandelion-koveskal"
                    ? `${baseHref}en/dandelion-koveskal/`
                  : resolveStayHref(href);

const sectionCopy: Record<
  SectionKey,
  {
    eyebrow: string;
    title: string;
    subtitle: string;
    audienceText: string;
    anchorId: string;
  }
> = {
  upland: {
    eyebrow: "Szent György Hill · Tapolcai Basin · Kisapáti · Nemesgulács",
    title: "Around the witness hills",
    subtitle:
      "Kisapáti, Nemesgulács and the Szent György Hill area work well if you want a hillside house, open views, a garden and easy-to-reach walks.",
    audienceText: "For hills, views, family stays and trips with friends.",
    anchorId: "balaton-uplands"
  },
  shore: {
    eyebrow: "Keszthely · Badacsonyörs · Lake Balaton",
    title: "Easy days near the lake",
    subtitle:
      "Keszthely and Badacsonyörs are the better direction when lake access, beaches and convenient waterside programmes matter more than a hillside retreat.",
    audienceText: "For the lakeshore, beaches and Balaton programmes.",
    anchorId: "near-lake-balaton"
  },
  kali: {
    eyebrow: "Köveskál · Káli-medence · quiet village stay",
    title: "The quieter side of Káli-medence",
    subtitle:
      "Köveskál is the slower, quieter choice: village surroundings, Káli-medence walks, wineries and a more understated stay.",
    audienceText: "For quiet, village surroundings and Káli-medence walks.",
    anchorId: "kali-medence"
  }
};

const stayCopy: Record<string, EnglishStayCopy> = {
  "dandelion-d2": {
    name: "Dandelion D2",
    location: "Kisapáti / Balaton Uplands",
    description:
      "A family-friendly Kisapáti apartment with a large garden, covered terrace, fireplace and shared summer Panorama Pool access.",
    hoverText: "For 4-6 guests, with a garden, terrace and shared Panorama Pool access.",
    facts: ["4-6 guests", "2 bedrooms + living room", "Panorama Pool access", "Air conditioning", "Family-friendly"],
    imageAlt: "Dandelion D2 countryside accommodation near Szent György Hill"
  },
  fugehaz: {
    name: "Fügeház",
    location: "Near Szent György Hill",
    description:
      "A guesthouse close to the hill with terraces, views and calm outdoor spaces for smaller families or friends.",
    hoverText: "For 4-6 guests, with terraces, views and shared Panorama Pool access.",
    facts: ["4-6 guests", "2 levels / 2 rooms", "Panorama Pool access", "Panorama", "Air conditioning"],
    imageAlt: "Fügeház guesthouse with countryside setting near Szent György Hill"
  },
  "dandelion-d1": {
    name: "Dandelion D1",
    location: "Kisapáti / Balaton Uplands",
    description:
      "A spacious Kisapáti guesthouse for larger families or friends, with three bedrooms, two bathrooms, a terrace and shared summer pool use.",
    hoverText: "For 6-8 guests, with three bedrooms and a panoramic terrace.",
    facts: ["6-8 guests", "3 bedrooms + living room", "Panorama Pool access", "Panoramic terrace", "Air conditioning"],
    imageAlt: "Dandelion D1 spacious countryside guesthouse in Kisapáti"
  },
  "szololiget-vendeghaz": {
    name: "Szőlőliget Vendégház",
    location: "Kisapáti / eastern side of Szent György Hill",
    description:
      "A separate house with a large terrace and views towards Csobánc, suited to slower hillside days.",
    hoverText: "For 2-4 guests, with a large terrace and open hillside views.",
    facts: ["2-4 guests", "1 bedroom + living room", "Panorama", "Quiet hillside setting", "Air conditioning"],
    imageAlt: "Szőlőliget Vendégház countryside stay near Szent György Hill"
  },
  "zsalya-vendeghaz": {
    name: "Zsálya Vendégház",
    location: "Eastern side of Szent György Hill / Kisapáti",
    description:
      "A separate Kisapáti guesthouse with a covered terrace and witness-hill views when you want a quieter, more intimate house.",
    hoverText: "For 2-4 guests, with a covered terrace and witness-hill panorama.",
    facts: ["2-4 guests", "2 bedrooms + living room", "Covered terrace", "Panorama", "Air conditioning"],
    imageAlt: "Zsálya Vendégház with covered terrace near Szent György Hill"
  },
  "vintage-vendeghaz": {
    name: "Dandelion Vintage Vendégház",
    location: "Nemesgulács / Balaton Uplands",
    description:
      "A Nemesgulács guesthouse with a private garden and two bedrooms, a practical choice for Balaton programmes and quieter evenings.",
    hoverText: "In Nemesgulács, with two bedrooms and a private garden.",
    facts: ["Guesthouse", "2 bedrooms + living room", "Private garden", "Air conditioning", "Quiet evenings"],
    imageAlt: "Dandelion Vintage Vendégház countryside guesthouse in Nemesgulács"
  },
  "royal-homes": {
    name: "Dandelion Royal Homes",
    location: "Keszthely / Lake Balaton",
    description:
      "A modern Keszthely apartment for 4-6 guests with a large terrace, rooftop jacuzzi and direct lakeside surroundings.",
    hoverText: "For 4-6 guests, near the lakeshore and with a rooftop jacuzzi.",
    facts: ["4-6 guests", "2 bedrooms + living room", "Lake Balaton", "Rooftop jacuzzi", "Large terrace"],
    imageAlt: "Dandelion Royal Homes apartment near Lake Balaton in Keszthely"
  },
  "szepvolgyi-vendeghaz": {
    name: "Szépvölgyi Vendégház",
    location: "Badacsonyörs / Szépvölgyi út",
    description:
      "A Badacsonyörs house for larger groups, with four bedrooms, Balaton views and beaches a few minutes away by car.",
    hoverText: "For 8 guests, with four bedrooms and Balaton views.",
    facts: ["8 guests", "4 bedrooms + living room", "Balaton panorama", "2 bathrooms", "Large garden"],
    imageAlt: "Szépvölgyi Vendégház spacious holiday home in Badacsonyörs"
  },
  "dandelion-koveskal": {
    name: "Dandelion Köveskál",
    location: "Köveskál / Káli-medence",
    description:
      "A quiet Köveskál guesthouse close to the villages, walks and wineries of Káli-medence.",
    hoverText: "In Köveskál, for slower Káli-medence days.",
    facts: ["Guesthouse", "Köveskál", "Káli-medence", "Nature-close", "Quiet village"],
    imageAlt: "Dandelion Köveskál quiet countryside guesthouse in Káli-medence"
  }
};

const sections = accommodationSections.map((section) => ({
  ...sectionCopy[section.key],
  key: section.key,
  gridClass: section.gridClass,
  stays: accommodations
    .filter((stay) => stay.section === section.key && stayCopy[stay.slug])
    .map((stay) => ({
      ...stay,
      ...stayCopy[stay.slug],
      image: imageMapping[stay.imageSlot],
      href: resolveEnglishStayHref(stay.slug, stay.url)
    }))
})).filter((section) => section.stays.length > 0);

const accommodationsStructuredData = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "@id": `${toAbsoluteUrl("/en/szallasok/")}#collection`,
  name: title,
  url: toAbsoluteUrl("/en/szallasok/"),
  inLanguage: "en-US",
  description,
  isPartOf: {
    "@id": `${toAbsoluteUrl("/en/")}#website`
  },
  mainEntity: {
    "@type": "ItemList",
    itemListElement: sections.flatMap((section, sectionIndex) =>
      section.stays.map((stay, stayIndex) => ({
        "@type": "ListItem",
        position: sectionIndex * 10 + stayIndex + 1,
        url: toAbsoluteUrl(stay.href),
        name: stay.name
      }))
    )
  },
  about: ["Balaton Uplands", "Szent György Hill", "Lake Balaton", "Káli-medence"],
  provider: {
    "@type": "LodgingBusiness",
    name: SITE_NAME,
    url: toAbsoluteUrl("/")
  }
};
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath="/en/szallasok/"
  lang="en"
  ogLocale="en_US"
  ogImage={accommodationsOgImage}
  ogImageAlt={accommodationsOgImageAlt}
  structuredData={accommodationsStructuredData}
  headerMode="solid"
>
  <section class="dnd-accommodations-hero">
    <video
      class="dnd-accommodations-hero__video"
      autoplay
      muted
      loop
      playsinline
      webkit-playsinline
      preload="auto"
      disablepictureinpicture
      disableremoteplayback
      aria-hidden="true"
    >
      <source src={accommodationsHeroMobileVideo} media="(max-width: 640px)" type="video/mp4" />
      <source src={accommodationsHeroVideo} type="video/mp4" />
      Your browser does not support background video playback.
    </video>
    <div class="dnd-accommodations-hero__content">
      <div class="dnd-container dnd-accommodations-hero__inner">
        <div class="dnd-accommodations-hero__text">
          <p class="dnd-accommodations-hero__eyebrow">Accommodations</p>
          <h1 class="dnd-accommodations-hero__title">
            <span>Stays by region</span>
            <span>and practical needs</span>
          </h1>
          <p class="dnd-accommodations-hero__lead">
            Kisapáti hillsides, the Balaton shore or the quiet Káli-medence: compare which Dandelion house fits what.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="dnd-accommodations-picker" aria-labelledby="accommodation-regions-title">
    <div class="dnd-container">
      <div class="dnd-accommodations-picker__intro">
        <p class="dnd-accommodations-picker__eyebrow">Region chooser</p>
        <h2 id="accommodation-regions-title">Where would you like to stay?</h2>
        <p>
          If you are not looking for a specific house yet, start with the area: Szent György Hill,
          Lake Balaton or Káli-medence.
        </p>
      </div>

      <div class="dnd-accommodations-picker__grid">
        {sections.map((section, regionIndex) => (
          <a class={`dnd-region-picker-card dnd-region-picker-card--${regionIndex + 1}`} href={`#${section.anchorId}`}>
            <span class="dnd-region-picker-card__top">
              <span class="dnd-region-picker-card__eyebrow">{section.eyebrow}</span>
              <span class="dnd-region-picker-card__icon" aria-hidden="true"></span>
            </span>
            <strong class="dnd-region-picker-card__title">{section.title}</strong>
            <span class="dnd-region-picker-card__text">{section.audienceText}</span>
            <span class="dnd-region-picker-card__cta">Explore</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <div id="accommodations-list" class="dnd-apts-anchor">
    <div id="dnd-apts-final" lang="en">
      <div class="dnd-wrap">
        {sections.map((section) => (
          <section id={section.anchorId} class="dnd-section dnd-region-block">
            <div class="dnd-region-block__header">
              <p class="dnd-eyebrow">{section.eyebrow}</p>
              <h2 class="dnd-h2">{section.title}</h2>
              <p class="dnd-sub">{section.subtitle}</p>
              <p class="dnd-region-block__audience">{section.audienceText}</p>
            </div>

            <div class={`dnd-grid ${section.gridClass}`}>
              {section.stays.map((stay) => {
                const primaryFacts = stay.facts.slice(0, 3);
                const secondaryFacts = stay.facts.slice(3, 6);
                const imageAlt = stay.imageAlt || `${stay.name} countryside accommodation near ${stay.location}`;

                const cardContent = (
                  <>
                    <div class="dnd-media">
                      {stay.image ? (
                        stay.image.astroSrc ? (
                          <Image
                            src={stay.image.astroSrc}
                            alt={imageAlt}
                            loading="lazy"
                          />
                        ) : (
                          <img
                            src={stay.image.sourceUrl}
                            alt={imageAlt}
                            width={stay.image.width || 1600}
                            height={stay.image.height || 1067}
                            loading="lazy"
                          />
                        )
                      ) : (
                        <div class="dnd-media-placeholder" aria-label={`${stay.name} image coming soon`}>
                          <span>{stay.name}</span>
                          <small>Image coming soon</small>
                        </div>
                      )}
                      <div class="dnd-overlay"></div>
                      <p class="dnd-hover-text">{stay.hoverText}</p>
                    </div>
                    <div class="dnd-info">
                      <div class="dnd-title-row">
                        <h3 class="dnd-title">{stay.name}</h3>
                        <span class="dnd-location">{stay.location}</span>
                      </div>
                      <div class="dnd-card-highlights" aria-label={`${stay.name} key details`}>
                        {primaryFacts.map((fact) => (
                          <span class="dnd-chip dnd-chip--accent">{fact}</span>
                        ))}
                      </div>
                      <p class="dnd-description">{stay.description}</p>
                      <div class="dnd-chips" aria-label={`${stay.name} more details`}>
                        {secondaryFacts.map((fact) => (
                          <span class="dnd-chip dnd-chip--secondary">{fact}</span>
                        ))}
                      </div>
                      <span class="dnd-card-cta">View details</span>
                    </div>
                  </>
                );

                return (
                  <a class="dnd-card is-link" href={stay.href}>
                    {cardContent}
                  </a>
                );
              })}
            </div>
          </section>
        ))}
      </div>
    </div>
  </div>

  <section class="dnd-accommodations-closing" aria-labelledby="accommodation-closing-title">
    <div class="dnd-container">
      <div class="dnd-accommodations-closing__inner">
        <h2 id="accommodation-closing-title">Not sure which stay fits best?</h2>
        <p>
          Tell us how many guests are coming, when you would travel and which area or feature matters most.
          We can help you narrow the choice.
        </p>
        <div class="dnd-accommodations-closing__actions">
          <a class="dnd-accommodations-closing__cta" href={contactHref}>Send inquiry</a>
          <a class="dnd-accommodations-closing__cta dnd-accommodations-closing__cta--secondary" href="/en/">
            Back to English home
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .dnd-accommodations-hero {
    position: relative;
    box-sizing: border-box;
    min-height: calc(600px + 118px);
    height: calc(84vh + 118px);
    padding-top: 118px;
    overflow: hidden;
    background: #171717;
  }

  .dnd-accommodations-hero::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background: linear-gradient(180deg, rgba(15, 16, 15, 0.18), rgba(15, 16, 15, 0.32));
  }

  .dnd-accommodations-hero__video {
    position: absolute;
    inset: 0;
    z-index: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 50%;
  }

  .dnd-accommodations-hero__content {
    position: relative;
    z-index: 1;
    min-height: 100%;
    color: #fff;
  }

  .dnd-accommodations-hero__inner {
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    align-items: center;
    min-height: 100%;
    max-width: none;
    padding: clamp(168px, 24vh, 236px) clamp(48px, 7vw, 96px) 88px;
  }

  .dnd-accommodations-hero__text {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: min(100%, 1040px);
    text-align: center;
  }

  .dnd-accommodations-hero__eyebrow {
    margin: 0 0 12px;
    color: rgba(255, 250, 241, 0.88);
    font-size: var(--dnd-text-xs);
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .dnd-accommodations-hero__title {
    margin: 0;
    color: rgba(255, 255, 255, 0.94);
    font-size: clamp(30px, 2.35vw, 42px);
    line-height: 1.08;
    font-family: var(--dnd-font-display);
    font-weight: 400;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .dnd-accommodations-hero__title span {
    display: inline;
  }

  .dnd-accommodations-hero__lead {
    max-width: 48ch;
    margin: 18px auto 0;
    color: rgba(255, 255, 255, 0.84);
    font-size: var(--dnd-text-lead);
    line-height: 1.55;
  }

  .dnd-accommodations-picker {
    margin-top: 26px;
    position: relative;
    z-index: 2;
  }

  .dnd-accommodations-picker__intro {
    max-width: 700px;
    margin: 0 auto 18px;
    text-align: center;
  }

  .dnd-accommodations-picker__eyebrow {
    margin: 0 0 10px;
    color: #b06200;
    font-size: var(--dnd-text-xs);
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .dnd-accommodations-picker__intro h2 {
    margin: 0;
    color: #1f2937;
    font-family: var(--dnd-font-display);
    font-size: clamp(1.55rem, 2.5vw, 2.2rem);
    font-weight: 400;
    line-height: 1.12;
  }

  .dnd-accommodations-picker__intro p:last-child {
    max-width: 58ch;
    margin: 12px auto 0;
    color: #5d554b;
    line-height: 1.6;
  }

  .dnd-accommodations-picker__grid {
    display: grid;
    gap: 14px;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .dnd-region-picker-card {
    position: relative;
    isolation: isolate;
    display: grid;
    overflow: hidden;
    gap: 10px;
    min-height: 184px;
    align-content: start;
    padding: 20px;
    border: 1px solid rgba(217, 158, 43, 0.18);
    border-radius: 18px;
    background: linear-gradient(180deg, rgba(255, 253, 249, 0.98), rgba(255, 248, 237, 0.94));
    box-shadow: 0 12px 30px rgba(42, 31, 17, 0.07);
    --region-accent: #b06200;
    --region-accent-soft: rgba(176, 98, 0, 0.12);
    transition: transform 0.22s ease, box-shadow 0.22s ease, border-color 0.22s ease, background 0.22s ease;
  }

  .dnd-region-picker-card::before {
    content: "";
    position: absolute;
    z-index: -1;
    inset: 0 0 auto;
    height: 4px;
    background: var(--region-accent);
  }

  .dnd-region-picker-card--1 {
    --region-accent: #9a6a20;
    --region-accent-soft: rgba(154, 106, 32, 0.13);
  }

  .dnd-region-picker-card--2 {
    --region-accent: #247a83;
    --region-accent-soft: rgba(36, 122, 131, 0.13);
  }

  .dnd-region-picker-card--3 {
    --region-accent: #637b3f;
    --region-accent-soft: rgba(99, 123, 63, 0.14);
  }

  .dnd-region-picker-card:hover,
  .dnd-region-picker-card:focus-visible {
    border-color: color-mix(in srgb, var(--region-accent) 38%, transparent);
    background: linear-gradient(180deg, rgba(255, 253, 249, 1), var(--region-accent-soft));
    box-shadow: 0 18px 38px rgba(42, 31, 17, 0.11);
    transform: translateY(-2px);
  }

  .dnd-region-picker-card__top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 14px;
  }

  .dnd-region-picker-card__eyebrow {
    color: color-mix(in srgb, var(--region-accent) 78%, #473520);
    font-size: var(--dnd-text-2xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 1.5;
    text-transform: uppercase;
  }

  .dnd-region-picker-card__icon {
    display: grid;
    width: 38px;
    height: 38px;
    flex: 0 0 auto;
    place-items: center;
    border: 1px solid color-mix(in srgb, var(--region-accent) 24%, transparent);
    border-radius: 999px;
    background: var(--region-accent-soft);
    color: var(--region-accent);
    font-family: var(--dnd-font-display);
    font-size: 1.2rem;
    line-height: 1;
  }

  .dnd-region-picker-card--1 .dnd-region-picker-card__icon::before {
    content: "△";
  }

  .dnd-region-picker-card--2 .dnd-region-picker-card__icon::before {
    content: "≈";
  }

  .dnd-region-picker-card--3 .dnd-region-picker-card__icon::before {
    content: "⌂";
  }

  .dnd-region-picker-card__title {
    color: #1f2937;
    font-size: var(--dnd-heading-card);
    font-weight: 650;
    line-height: 1.25;
  }

  .dnd-region-picker-card__text {
    color: #5b5348;
    font-size: var(--dnd-text-md);
    line-height: 1.5;
  }

  .dnd-region-picker-card__cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: auto;
    color: var(--region-accent);
    font-size: var(--dnd-text-xs);
    font-weight: 700;
    letter-spacing: 0.04em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .dnd-region-picker-card__cta::after {
    content: "→";
    font-size: var(--dnd-text-body);
    line-height: 1;
    transition: transform 0.18s ease;
  }

