---
// [CHANGE 2026-05-02 00:00] Fügeház publikus lakásoldal létrehozása file-based Astro galériával.
import BaseLayout from "../layouts/BaseLayout.astro";
import accommodationSeoTestImages from "../data/images/accommodation-images.seo-test.json";

const bookingLink = "https://ibe.sabeeapp.com/v3/p/Dandelion-Vendeghazak?p=3970b30e1042d58f";
const baseHref = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const apartmentKey = "fugehaz";

type FugeGalleryImage = {
  id: string;
  src: string;
  thumb: string;
  alt: string;
  title: string;
  caption: string;
  sortOrder: number;
};

const resolveImagePath = (imagePath: string) =>
  imagePath.startsWith("/") ? `${baseHref}${imagePath.replace(/^\/+/, "")}` : imagePath;

const hasEncodingIssue = (value: string | undefined) =>
  Boolean(value && /[\u00C3\u0102\u00E2\uFFFD]/.test(value));

const safeText = (value: string | undefined, fallback: string) =>
  value && !hasEncodingIssue(value) ? value : fallback;

const fugeGalleryImages: FugeGalleryImage[] = (accommodationSeoTestImages[apartmentKey]?.gallery || [])
  .slice()
  .sort((left, right) => left.sortOrder - right.sortOrder)
  .map((image, index) => {
    const fallbackTitle = `Fügeház galériakép ${index + 1}`;

    return {
      id: image.id,
      src: resolveImagePath(image.src),
      thumb: resolveImagePath(image.thumb),
      alt: safeText(image.seoDraft.altHu, fallbackTitle),
      title: safeText(image.seoDraft.titleHu, fallbackTitle),
      caption: safeText(image.seoDraft.captionHu, "Részlet a Fügeház hangulatából."),
      sortOrder: image.sortOrder
    };
  });

const heroImage = fugeGalleryImages[0];
const galleryPreviewImages = fugeGalleryImages.slice(0, 12);
const galleryHasMore = fugeGalleryImages.length > galleryPreviewImages.length;
const galleryMoreCount = Math.max(fugeGalleryImages.length - galleryPreviewImages.length, 0);

const fugeShortDescription =
  "A Fügeház panorámás, kétszintes vendégház a Szent György-hegy közelében: 4 főnek ideális, pótággyal akár 6 főnek is kényelmes, intim terasszal és székely dézsával.";

const introParagraphs = [
  "A Fügeház azoknak készült, akik a Balaton-felvidéki napokhoz csendes, jól belakható házat keresnek: reggeli kávé a teraszon, esti dézsázás, körben tanúhegyek.",
  "A ház 4 főnek ideális, pótággyal akár 6 főnek is használható. A panorámában a Szent György-hegy, a Csobánc, a Tóti-hegy, a Gulács és Badacsony is megjelenik."
];

const fugeLongDescription = [
  "Az alsó szinten a felszerelt konyha, a zuhanyzós fürdőszoba, az étkező-nappali és a franciaágyas hálórész alkotja a ház mindennapi központját.",
  "Az emeleten egy franciaágy és egy kihúzható kanapé ad rugalmas alvóhelyet családnak vagy baráti társaságnak.",
  "A terasz intim, mégis nyitott a táj felé: grillezéshez, lassú reggelekhez és esti beszélgetésekhez is természetes helye a háznak.",
  "A fűtés-hűtésről klíma, kandalló és norvég panelek gondoskodnak, babával érkezőknek pedig utazóágy, etetőszék, fürdetőkád, pelenkázólap és fellépő kérhető."
];

const featureGroups = [
  {
    title: "Alapadatok",
    items: [
      ["Férőhely", "4 fő ideális, pótággyal akár 6 fő"],
      ["Elrendezés", "alsó szint és emelet"],
      ["Kültér", "intim terasz, grillező, székely dézsa"],
      ["Panoráma", "Szent György-hegy, Csobánc, Tóti-hegy, Gulács, Badacsony"]
    ]
  },
  {
    title: "Kényelem",
    items: [
      ["Konyha", "felszerelt konyha Nespresso kávéfőzővel"],
      ["Fürdő", "zuhanyzós fürdőszoba WC-vel"],
      ["Fűtés-hűtés", "klíma, kandalló, norvég panelek"],
      ["Bababarát", "felszerelés kérésre"]
    ]
  }
] as const;

const mobileFactItems = featureGroups.flatMap((group) => group.items);

const lowerLevelItems = [
  "felszerelt konyha hűtőszekrénnyel, indukciós főzőlappal, mikrohullámú sütővel, kenyérpirítóval, vízforralóval és Nespresso kávéfőzővel",
  "zuhanyzós fürdőszoba WC-vel",
  "étkező-nappali és franciaágyas hálórész"
];

const upperLevelItems = [
  "egy légtérben franciaágy és kihúzható kanapé",
  "barátságos tetőtéri hangulat",
  "kényelmes pihenőtér családnak vagy barátoknak"
];

const babyItems = ["utazóágy", "etetőszék", "fürdetőkád", "pelenkázólap", "fellépő"];

const featureHighlights = [
  { label: "Ingyenes WiFi", icon: "wifi" },
  { label: "Felszerelt konyha", icon: "utensils" },
  { label: "Zuhanyzós fürdő", icon: "shower" },
  { label: "Klíma és kandalló", icon: "flame" },
  { label: "Bababarát felszerelés", icon: "users" },
  { label: "Székely dézsa", icon: "sparkles" },
  { label: "Intim terasz", icon: "leaf" },
  { label: "Tanúhegyi panoráma", icon: "mountain" }
] as const;

const locationBenefits = [
  { label: "Szent György-hegy közeli kirándulások", icon: "trail" },
  { label: "Csobánc, Tóti-hegy és Gulács panoráma", icon: "mountain" },
  { label: "Badacsony és a Balaton rövid autózással", icon: "route" }
] as const;

const surroundings = ["Szent György-hegy", "Csobánc", "Tóti-hegy", "Gulács", "Badacsony"];

const locationImage = fugeGalleryImages.find((image) => image.sortOrder === 5) || fugeGalleryImages[1] || heroImage;
const d2RelatedImage = (accommodationSeoTestImages.d2?.gallery || [])
  .slice()
  .sort((left, right) => left.sortOrder - right.sortOrder)
  .map((image, index) => ({
    src: resolveImagePath(image.thumb || image.src),
    alt: safeText(image.seoDraft.altHu, `Dandelion D2 képe ${index + 1}`)
  }))[0];
const relatedStays = [
  {
    name: "Dandelion D2",
    location: "Kisapáti / Szent György-hegy",
    href: `${baseHref}dandelion-d2/`,
    image: d2RelatedImage
  }
];
---

<BaseLayout
  title="Fügeház | Dandelion Vendégházak"
  description="Fügeház panorámás, természetközeli vendégház intim terasszal, székely dézsával és balatoni tanúhegyi kilátással."
>
  <section class="fuge-hero">
    {heroImage ? (
      <img
        src={heroImage.src}
        alt={heroImage.alt}
        class="fuge-hero__image"
        loading="eager"
        decoding="async"
        fetchpriority="high"
      />
    ) : (
      <div class="fuge-hero__fallback" aria-hidden="true"></div>
    )}
    <div class="fuge-hero__overlay"></div>
    <div class="dnd-container fuge-hero__content">
      <div class="fuge-hero__copy">
        <span class="fuge-kicker">Balaton-felvidék · panorámás nyugalom</span>
        <h1>Fügeház</h1>
        <p class="fuge-hero__subtitle">PANORÁMÁS NYUGALOM A HEGYEK ÖLELÉSÉBEN</p>
        <p class="fuge-hero__lead">
          Intim terasz, székely dézsa és tanúhegyi panoráma egy könnyen belakható, természetközeli vendégházban.
        </p>
        <div class="fuge-hero__actions">
          <button type="button" class="dnd-btn dnd-btn--primary fuge-hero__booking" onclick="OpenBE()">Árak és foglalás</button>
          <a href="#fuge-gallery" class="dnd-btn dnd-btn--secondary" data-fuge-gallery-jump>Képek megtekintése</a>
        </div>
      </div>
    </div>
  </section>

  <section class="fuge-intro dnd-section">
    <div class="dnd-container">
      <div class="fuge-intro__inner">
        <span class="dnd-section-kicker">Fügeház · panorámás nyugalom</span>
        <h2 class="fuge-intro__title">Meghitt ház széles panorámával</h2>
        <p class="dnd-section-intro">
          Intim terasz, székely dézsa és két szinten használható, otthonos tér azoknak, akik a tanúhegyek között szeretnének lelassulni.
        </p>
      </div>
    </div>
  </section>

  <section class="fuge-details dnd-section">
    <div class="dnd-container fuge-details__grid">
      <div class="fuge-details__story">
        <span class="dnd-section-kicker">A ház kialakítása</span>
        <h2 class="fuge-section-title">Két szint, praktikus elrendezés</h2>
        <p>{fugeShortDescription}</p>
        <details class="fuge-details__more">
          <summary>Bővebben a Fügeházról</summary>
          <div>
            {fugeLongDescription.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </div>
        </details>
        <button type="button" class="dnd-btn dnd-btn--secondary fuge-details__cta" onclick="OpenBE()">
          Árak és foglalás
        </button>

        <div class="fuge-levels">
          <section>
            <h3>Alsó szint</h3>
            <ul>
              {lowerLevelItems.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </section>
          <section>
            <h3>Emelet</h3>
            <ul>
              {upperLevelItems.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </section>
        </div>
      </div>

      <div class="fuge-details__facts">
        <div class="fuge-details__fact-grid">
          {featureGroups.map((group) => (
            <section class="fuge-fact-group">
              <h3>{group.title}</h3>
              <dl>
                {group.items.map(([term, value]) => (
                  <div>
                    <dt>{term}</dt>
                    <dd>{value}</dd>
                  </div>
                ))}
              </dl>
            </section>
          ))}
        </div>

        <div class="fuge-details__mobile-facts">
          {mobileFactItems.map(([term, value]) => (
            <div class="fuge-details__mobile-fact">
              <span>{term}</span>
              <strong>{value}</strong>
            </div>
          ))}
        </div>

        <section class="fuge-feature-icons">
          <h3>Felszereltség</h3>
          <div class="fuge-feature-icons__grid">
            {featureHighlights.map((item) => (
              <div class="fuge-feature-icons__item">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <use href={`#fuge-icon-${item.icon}`}></use>
                </svg>
                <strong>{item.label}</strong>
              </div>
            ))}
          </div>
        </section>
      </div>
    </div>
  </section>

  <section class="fuge-comfort dnd-section">
    <div class="dnd-container fuge-comfort__grid">
      <div>
        <span class="dnd-section-kicker">Fűtés · hűtés</span>
        <h2 class="fuge-section-title">Egész évben kényelmes</h2>
        <p>
          Fent modern split klíma, lent Gree fűtő-hűtő klíma, fatüzelésű kandalló és norvég panelek segítik,
          hogy a Fügeház több évszakban is otthonos legyen.
        </p>
      </div>
      <div>
        <span class="dnd-section-kicker">Babával érkezőknek</span>
        <h2 class="fuge-section-title">Kérésre előkészítve</h2>
        <ul class="fuge-chip-list">
          {babyItems.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section id="fuge-gallery" class="fuge-gallery dnd-section">
    <div class="dnd-container">
      <div class="fuge-gallery__heading">
        <span class="dnd-section-kicker">Galéria</span>
        <h2 class="fuge-section-title">Fügeház képekben</h2>
        <p class="fuge-gallery__hint">
          {galleryHasMore ? "További képekért kattints" : "A galéria képei kattinthatók"}
        </p>
      </div>
      {galleryPreviewImages.length > 0 ? (
        <div class="fuge-gallery__grid">
          {galleryPreviewImages.map((image, index) => (
            <figure class="fuge-gallery__item">
              <button
                type="button"
                class="fuge-gallery__trigger"
                data-fuge-gallery-trigger
                data-fuge-gallery-index={index}
                data-fuge-gallery-id={image.id}
                aria-label="Galériakép megnyitása"
              >
                <img src={image.thumb || image.src} alt={image.alt} loading={index < 2 ? "eager" : "lazy"} />
                {galleryHasMore && index === galleryPreviewImages.length - 1 && (
                  <span class="fuge-gallery__more-badge">+{galleryMoreCount} kép</span>
                )}
              </button>
            </figure>
          ))}
        </div>
      ) : (
        <div class="fuge-gallery__empty" role="status">A Fügeház galériához jelenleg nincs feloldható kép.</div>
      )}
    </div>
  </section>

  <section class="fuge-location dnd-section">
    <div class="dnd-container fuge-location__grid">
      <div class="fuge-location__media">
        {locationImage ? (
          <img src={locationImage.src} alt={locationImage.alt} loading="lazy" />
        ) : (
          <div class="fuge-location__placeholder" aria-hidden="true"></div>
        )}
      </div>
      <div class="fuge-location__copy">
        <span class="dnd-section-kicker">Környék és elhelyezkedés</span>
        <h2 class="fuge-section-title">Tanúhegyek és csendes esték</h2>
        <p>
          A Fügeház környezetét a Balaton-felvidék jellegzetes hegyei adják. A teraszról és a ház körüli
          pihenőpontokról a Szent György-hegy, a Csobánc, a Tóti-hegy, a Gulács és Badacsony látványa is része a napnak.
        </p>
        <div class="fuge-location__benefits">
          {locationBenefits.map((item) => (
            <div class="fuge-location__benefit">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <use href={`#fuge-icon-${item.icon}`}></use>
              </svg>
              <span>{item.label}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="fuge-map dnd-section">
    <div class="dnd-container fuge-map__inner">
      <div class="fuge-map__copy">
        <span class="dnd-section-kicker">Szent György-hegy · Kisapáti</span>
        <h2 class="fuge-section-title">Fügeház környéke</h2>
        <p>
          A ház jó kiindulópont a tanúhegyekhez, badacsonyi kitérőkhöz és balatoni programokhoz, miközben a nap végén
          csendes, saját teraszos pihenésbe lehet visszaérkezni.
        </p>
        <ul class="fuge-surroundings">
          {surroundings.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </div>

      <div class="fuge-map__card">
        <div class="fuge-map__frame" data-fuge-map-frame>
          <iframe
            class="fuge-map__canvas"
            src="https://www.google.com/maps?q=Szent%20Gy%C3%B6rgy-hegy%20Kisap%C3%A1ti&output=embed"
            title="Fügeház környéke térkép"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
          <button class="fuge-map__overlay" type="button" data-fuge-map-activate>
            Kattints a térkép aktiválásához
          </button>
        </div>
        <a
          class="fuge-map__link"
          href="https://www.google.com/maps/search/?api=1&query=Szent%20Gy%C3%B6rgy-hegy%20Kisap%C3%A1ti"
          target="_blank"
          rel="noopener noreferrer"
        >
          Megnyitás Google Térképen
        </a>
      </div>
    </div>
  </section>

  <section class="fuge-booking dnd-section">
    <div class="dnd-container">
      <div class="fuge-booking__panel">
        <span class="dnd-section-kicker">Foglalás</span>
        <h2 class="fuge-section-title">Megnéznéd, mikor szabad a Fügeház?</h2>
        <p>
          Ha fontos a panoráma, a saját terasz, a dézsa és a családbarát felszereltség, nézd meg az elérhető időpontokat.
        </p>
        <button type="button" class="dnd-btn dnd-btn--primary fuge-booking__cta" onclick="OpenBE()">
          Árak és foglalás
        </button>
      </div>
    </div>
  </section>

  <section class="fuge-related dnd-section">
    <div class="dnd-container">
      <div class="fuge-related__heading">
        <span class="dnd-section-kicker">További szállások</span>
        <h2 class="fuge-section-title">Más Dandelion helyek ugyanebben a tájban</h2>
      </div>
      <div class="fuge-related__grid">
        {relatedStays.map((stay) => (
          <a href={stay.href} class="fuge-related__card">
            {stay.image ? (
              <img src={stay.image.src} alt={stay.image.alt} loading="lazy" />
            ) : (
              <div class="fuge-related__placeholder">Kép hamarosan</div>
            )}
            <div class="fuge-related__copy">
              <strong>{stay.name}</strong>
              <span>{stay.location}</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <div class="fuge-lightbox" data-fuge-lightbox hidden>
    <div class="fuge-lightbox__backdrop" data-fuge-lightbox-close></div>
    <div class="fuge-lightbox__dialog" role="dialog" aria-modal="true" aria-label="Fügeház galéria">
      <button type="button" class="fuge-lightbox__close" data-fuge-lightbox-close aria-label="Galéria bezárása">×</button>
      <button type="button" class="fuge-lightbox__nav fuge-lightbox__nav--prev" data-fuge-lightbox-prev aria-label="Előző kép">‹</button>
      <figure>
        <img src="" alt="" class="fuge-lightbox__image" data-fuge-lightbox-image />
        <figcaption>
          <strong data-fuge-lightbox-title></strong>
          <span data-fuge-lightbox-caption></span>
          <small data-fuge-lightbox-counter></small>
        </figcaption>
      </figure>
      <button type="button" class="fuge-lightbox__nav fuge-lightbox__nav--next" data-fuge-lightbox-next aria-label="Következő kép">›</button>
    </div>
  </div>

  <script define:vars={{ bookingLink, fugeGalleryImages }}>
    if (typeof window.OpenBE !== "function") {
      window.OpenBE = () => {
        window.open(bookingLink, "_blank", "noopener,noreferrer");
      };
    }

    const galleryJump = document.querySelector("[data-fuge-gallery-jump]");
    const lightbox = document.querySelector("[data-fuge-lightbox]");
    const lightboxImage = document.querySelector("[data-fuge-lightbox-image]");
    const lightboxTitle = document.querySelector("[data-fuge-lightbox-title]");
    const lightboxCaption = document.querySelector("[data-fuge-lightbox-caption]");
    const lightboxCounter = document.querySelector("[data-fuge-lightbox-counter]");
    const galleryTriggers = Array.from(document.querySelectorAll("[data-fuge-gallery-trigger]"));
    const closeButtons = Array.from(document.querySelectorAll("[data-fuge-lightbox-close]"));
    const prevButton = document.querySelector("[data-fuge-lightbox-prev]");
    const nextButton = document.querySelector("[data-fuge-lightbox-next]");
    let activeIndex = 0;

    galleryJump?.addEventListener("click", (event) => {
      const gallery = document.getElementById("fuge-gallery");

      if (!gallery) {
        return;
      }

      event.preventDefault();
      gallery.scrollIntoView({ behavior: "smooth", block: "start" });
    });

    const renderLightbox = () => {
      const currentImage = fugeGalleryImages[activeIndex];

      if (!currentImage || !lightboxImage || !lightboxCounter) {
        return;
      }

      lightboxImage.src = currentImage.src;
      lightboxImage.alt = currentImage.alt;
      lightboxCounter.textContent = `${activeIndex + 1} / ${fugeGalleryImages.length}`;

      if (lightboxTitle) {
        lightboxTitle.textContent = currentImage.title || "";
      }

      if (lightboxCaption) {
        lightboxCaption.textContent = currentImage.caption || "";
      }
    };

    const openLightbox = (index) => {
      if (!lightbox || !fugeGalleryImages.length) {
        return;
      }

      activeIndex = index;
      lightbox.hidden = false;
      document.body.classList.add("fuge-lightbox-open");
      renderLightbox();
    };

    const closeLightbox = () => {
      if (!lightbox) {
        return;
      }

      lightbox.hidden = true;
      document.body.classList.remove("fuge-lightbox-open");
    };

    const stepLightbox = (direction) => {
      activeIndex = (activeIndex + direction + fugeGalleryImages.length) % fugeGalleryImages.length;
      renderLightbox();
    };

    galleryTriggers.forEach((trigger) => {
      trigger.addEventListener("click", () => {
        const nextIndex = Number(trigger.getAttribute("data-fuge-gallery-index"));
        openLightbox(Number.isFinite(nextIndex) ? nextIndex : 0);
      });
    });

    closeButtons.forEach((button) => {
      button.addEventListener("click", closeLightbox);
    });

    prevButton?.addEventListener("click", () => stepLightbox(-1));
    nextButton?.addEventListener("click", () => stepLightbox(1));

    document.addEventListener("keydown", (event) => {
      if (!lightbox || lightbox.hidden) {
        return;
      }

      if (event.key === "Escape") {
        closeLightbox();
      }

      if (event.key === "ArrowLeft") {
        stepLightbox(-1);
      }

      if (event.key === "ArrowRight") {
        stepLightbox(1);
      }
    });
  </script>

  <svg class="fuge-icon-sprite" aria-hidden="true">
    <symbol id="fuge-icon-wifi" viewBox="0 0 24 24">
      <path d="M4.5 9.5a11 11 0 0 1 15 0"></path>
      <path d="M8 13a6 6 0 0 1 8 0"></path>
      <path d="M11 16.5a1.5 1.5 0 0 1 2 0"></path>
      <path d="M12 19h.01"></path>
    </symbol>
    <symbol id="fuge-icon-utensils" viewBox="0 0 24 24">
      <path d="M7 3v8"></path>
      <path d="M4.5 3v5.5A2.5 2.5 0 0 0 7 11v10"></path>
      <path d="M9.5 3v5.5A2.5 2.5 0 0 1 7 11"></path>
      <path d="M17 3v18"></path>
      <path d="M17 3c2 1.2 3 3 3 5.6 0 2.2-1.1 3.9-3 4.8"></path>
    </symbol>
    <symbol id="fuge-icon-shower" viewBox="0 0 24 24">
      <path d="M5 11a7 7 0 0 1 14 0"></path>
      <path d="M8 11h8"></path>
      <path d="M8 15h.01"></path>
