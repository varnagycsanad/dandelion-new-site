  <script>
    document.querySelectorAll("[data-fuge-map-frame]").forEach((frame) => {
      const activator = frame.querySelector("[data-fuge-map-activate]");

      activator?.addEventListener("click", () => {
        frame.classList.add("is-active");
      });
    });
  </script>

  <style>
    :global(body.fuge-lightbox-open) {
      overflow: hidden;
    }

    .fuge-hero {
      position: relative;
      min-height: 92vh;
      display: flex;
      align-items: flex-end;
      overflow: hidden;
      background: #17140f;
      color: #fff;
    }

    .fuge-hero__image,
    .fuge-hero__fallback {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .fuge-hero__fallback {
      background: #2a2419;
    }

    .fuge-hero__overlay {
      position: absolute;
      inset: 0;
      background: linear-gradient(180deg, rgba(0, 0, 0, 0.22), rgba(0, 0, 0, 0.64));
    }

    .fuge-hero__content {
      position: relative;
      z-index: 1;
      width: 100%;
      padding-bottom: clamp(3rem, 8vw, 6rem);
    }

    .fuge-hero__copy {
      max-width: 760px;
    }

    .fuge-kicker,
    .dnd-section-kicker {
      display: inline-block;
      margin-bottom: 0.9rem;
      font-size: 0.76rem;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: #d99e2b;
    }

    .fuge-hero h1 {
      margin: 0;
      font-family: "Playfair Display", Georgia, serif;
      font-size: clamp(4rem, 12vw, 9rem);
      font-weight: 500;
      line-height: 0.95;
      letter-spacing: 0;
    }

    .fuge-hero__subtitle {
      max-width: 720px;
      margin: 1.25rem 0 0;
      font-size: clamp(1.25rem, 3vw, 2.2rem);
      font-weight: 700;
      line-height: 1.2;
    }

    .fuge-hero__lead {
      max-width: 650px;
      margin: 1rem 0 0;
      font-size: 1rem;
      line-height: 1.8;
    }

    .fuge-hero__actions,
    .fuge-booking__panel .dnd-btn {
      margin-top: 1.5rem;
    }

    .fuge-section-title {
      margin: 0 0 1rem;
      font-size: clamp(2rem, 4vw, 3.4rem);
      line-height: 1.08;
      letter-spacing: 0;
    }

    .fuge-intro__title {
      margin: 0 0 1rem;
      font-size: clamp(2.4rem, 5vw, 4.4rem);
      line-height: 1.02;
      letter-spacing: 0;
    }

    .fuge-intro__inner {
      max-width: 860px;
    }

    .fuge-intro p,
    .fuge-details p,
    .fuge-comfort p,
    .fuge-map p,
    .fuge-location p,
    .fuge-booking p {
      color: rgba(0, 0, 0, 0.72);
      font-size: 1rem;
      line-height: 1.85;
    }

    .fuge-details,
    .fuge-gallery,
    .fuge-map,
    .fuge-booking {
      background: #fdfbf7;
    }

    .fuge-details__grid,
    .fuge-comfort__grid,
    .fuge-location__grid,
    .fuge-map__inner {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(320px, 0.85fr);
      gap: clamp(2rem, 5vw, 4rem);
      align-items: start;
    }

    .fuge-levels,
    .fuge-details__fact-grid {
      display: grid;
      gap: 1rem;
    }

    .fuge-levels section,
    .fuge-fact-group,
    .fuge-feature-icons,
    .fuge-comfort__grid > div,
    .fuge-surroundings {
      border: 1px solid rgba(0, 0, 0, 0.1);
      border-radius: 8px;
      background: #fff;
      padding: 1.25rem;
    }

    .fuge-details__more {
      margin-top: 1rem;
      border-top: 1px solid rgba(0, 0, 0, 0.1);
      border-bottom: 1px solid rgba(0, 0, 0, 0.1);
      padding: 1rem 0;
    }

    .fuge-details__more summary {
      cursor: pointer;
      font-weight: 700;
    }

    .fuge-details__cta {
      margin: 1.25rem 0 1.5rem;
    }

    .fuge-levels h3,
    .fuge-fact-group h3,
    .fuge-feature-icons h3 {
      margin: 0 0 0.9rem;
      font-size: 1rem;
    }

    .fuge-levels ul,
    .fuge-chip-list,
    .fuge-surroundings {
      margin: 0;
      padding-left: 1.1rem;
      color: rgba(0, 0, 0, 0.72);
      line-height: 1.75;
    }

    .fuge-fact-group dl {
      display: grid;
      gap: 0.85rem;
      margin: 0;
    }

    .fuge-fact-group div {
      display: grid;
      gap: 0.2rem;
      padding-bottom: 0.85rem;
      border-bottom: 1px solid rgba(0, 0, 0, 0.08);
    }

    .fuge-fact-group div:last-child {
      padding-bottom: 0;
      border-bottom: 0;
    }

    .fuge-fact-group dt {
      font-size: 0.78rem;
      font-weight: 700;
      text-transform: uppercase;
      color: #d99e2b;
    }

    .fuge-fact-group dd {
      margin: 0;
      color: rgba(0, 0, 0, 0.72);
      line-height: 1.55;
    }

    .fuge-feature-icons {
      margin-top: 1rem;
    }

    .fuge-details__mobile-facts {
      display: none;
    }

    .fuge-feature-icons__grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.75rem;
    }

    .fuge-feature-icons__item {
      display: flex;
      gap: 0.6rem;
      align-items: center;
      min-height: 46px;
      padding: 0.7rem;
      border-radius: 8px;
      background: #fdfbf7;
      font-size: 0.86rem;
    }

    .fuge-feature-icons__item svg,
    .fuge-location__benefit svg {
      width: 1.25rem;
      height: 1.25rem;
      flex: 0 0 auto;
      fill: none;
      stroke: #d99e2b;
      stroke-width: 1.8;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .fuge-gallery__heading {
      max-width: 720px;
      margin-bottom: 2rem;
    }

    .fuge-gallery__hint {
      margin: 0;
      color: rgba(0, 0, 0, 0.58);
    }

    .fuge-gallery__grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 0.75rem;
    }

    .fuge-gallery__item {
      min-width: 0;
      margin: 0;
      aspect-ratio: 4 / 3;
      overflow: hidden;
      border-radius: 8px;
      background: #eee5d8;
    }

    .fuge-gallery__trigger {
      position: relative;
      width: 100%;
      height: 100%;
      padding: 0;
      border: 0;
      cursor: pointer;
      background: transparent;
    }

    .fuge-gallery__item img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 240ms ease;
    }

    .fuge-gallery__trigger:hover img {
      transform: scale(1.04);
    }

    .fuge-gallery__more-badge {
      position: absolute;
      inset: 0;
      display: grid;
      place-items: center;
      background: rgba(0, 0, 0, 0.54);
      color: #fff;
      font-weight: 700;
      font-size: 1.4rem;
    }

    .fuge-gallery__empty {
      padding: 2rem;
      border: 1px solid rgba(0, 0, 0, 0.1);
      border-radius: 8px;
      background: #fff;
    }

    .fuge-location {
      background: #fff;
    }

    .fuge-location__media,
    .fuge-location__placeholder {
      overflow: hidden;
      min-height: 420px;
      border-radius: 8px;
      background: #eee5d8;
    }

    .fuge-location__media img {
      width: 100%;
      height: 100%;
      min-height: 420px;
      object-fit: cover;
    }

    .fuge-location__benefits {
      display: grid;
      gap: 0.75rem;
      margin-top: 1.5rem;
    }

    .fuge-location__benefit {
      display: flex;
      gap: 0.75rem;
      align-items: center;
      min-height: 54px;
      padding: 0.9rem 1rem;
      border: 1px solid rgba(0, 0, 0, 0.1);
      border-radius: 8px;
      background: #fdfbf7;
      font-weight: 700;
    }

    .fuge-map__copy {
      max-width: 660px;
    }

    .fuge-map__card {
      display: grid;
      gap: 0.8rem;
    }

    .fuge-map__frame {
      position: relative;
      min-height: 380px;
      overflow: hidden;
      border-radius: 8px;
      background: #e9ddca;
    }

    .fuge-map__canvas,
    .fuge-map__overlay {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
    }

    .fuge-map__canvas {
      border: 0;
      filter: saturate(0.9);
      pointer-events: none;
    }

    .fuge-map__frame.is-active .fuge-map__canvas {
      pointer-events: auto;
    }

    .fuge-map__overlay {
      display: grid;
      place-items: center;
      border: 0;
      background: rgba(0, 0, 0, 0.44);
      color: #fff;
      font-weight: 700;
      cursor: pointer;
    }

    .fuge-map__frame.is-active .fuge-map__overlay {
      display: none;
    }

    .fuge-map__link {
      color: #000;
      font-weight: 700;
      text-decoration: underline;
      text-underline-offset: 0.25em;
    }

    .fuge-surroundings {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.7rem;
      padding-left: 1.25rem;
    }

    .fuge-booking__panel {
      max-width: 780px;
      text-align: center;
      margin: 0 auto;
      padding: clamp(2rem, 5vw, 4rem);
      border-radius: 8px;
      background: #fff;
    }

    .fuge-booking__cta {
      margin-top: 1.25rem;
    }

    .fuge-related {
      background: #fff;
    }

    .fuge-related__heading {
      max-width: 760px;
      margin-bottom: 2rem;
    }

    .fuge-related__grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1rem;
    }

    .fuge-related__card {
      display: grid;
      overflow: hidden;
      border-radius: 8px;
      color: inherit;
      text-decoration: none;
      background: #fdfbf7;
    }

    .fuge-related__card img,
    .fuge-related__placeholder {
      width: 100%;
      aspect-ratio: 4 / 3;
      object-fit: cover;
      background: #eee5d8;
    }

    .fuge-related__placeholder {
      display: grid;
      place-items: center;
      color: rgba(0, 0, 0, 0.58);
    }

    .fuge-related__copy {
      display: grid;
      gap: 0.25rem;
      padding: 1rem;
    }

    .fuge-related__copy strong {
      font-size: 1rem;
    }

    .fuge-related__copy span {
      color: rgba(0, 0, 0, 0.62);
      font-size: 0.9rem;
    }

    .fuge-icon-sprite {
      display: none;
    }

    .fuge-lightbox[hidden] {
      display: none;
    }

    .fuge-lightbox {
      position: fixed;
      inset: 0;
      z-index: 1000;
    }

    .fuge-lightbox__backdrop {
      position: absolute;
      inset: 0;
      background: rgba(0, 0, 0, 0.82);
    }

    .fuge-lightbox__dialog {
      position: absolute;
      inset: 2rem;
      display: grid;
      place-items: center;
      color: #fff;
    }

    .fuge-lightbox figure {
      display: grid;
      gap: 1rem;
      max-width: min(1100px, 100%);
      max-height: 100%;
      margin: 0;
    }

    .fuge-lightbox__image {
      max-width: 100%;
      max-height: 72vh;
      object-fit: contain;
      border-radius: 8px;
    }

    .fuge-lightbox figcaption {
      display: grid;
      gap: 0.35rem;
      text-align: center;
      line-height: 1.5;
    }

    .fuge-lightbox figcaption span,
    .fuge-lightbox figcaption small {
      color: rgba(255, 255, 255, 0.76);
    }

    .fuge-lightbox__close,
    .fuge-lightbox__nav {
      position: absolute;
      display: grid;
      place-items: center;
      width: 44px;
      height: 44px;
      border: 1px solid rgba(255, 255, 255, 0.32);
      border-radius: 999px;
      color: #fff;
      background: rgba(0, 0, 0, 0.28);
      cursor: pointer;
    }

    .fuge-lightbox__close {
      top: 0;
      right: 0;
      font-size: 1.8rem;
    }

    .fuge-lightbox__nav {
      top: 50%;
      transform: translateY(-50%);
      font-size: 2rem;
    }

    .fuge-lightbox__nav--prev {
      left: 0;
    }

    .fuge-lightbox__nav--next {
      right: 0;
    }

    @media (max-width: 900px) {
      .fuge-details__grid,
      .fuge-comfort__grid,
      .fuge-location__grid,
      .fuge-map__inner {
        grid-template-columns: 1fr;
      }

      .fuge-gallery__grid {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }

      .fuge-related__grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    @media (max-width: 640px) {
      .fuge-hero {
        min-height: 84vh;
      }

      .fuge-hero__actions {
        display: grid;
        gap: 0.75rem;
      }

      .fuge-details__fact-grid {
        display: none;
      }

      .fuge-details__mobile-facts {
        display: grid;
        gap: 0.75rem;
      }

      .fuge-details__mobile-fact {
        display: grid;
        gap: 0.2rem;
        padding: 0.9rem 1rem;
        border-radius: 8px;
        background: #fff;
      }

      .fuge-details__mobile-fact span {
        color: #d99e2b;
        font-size: 0.76rem;
        font-weight: 700;
        text-transform: uppercase;
      }

      .fuge-details__mobile-fact strong {
        font-size: 0.95rem;
        line-height: 1.45;
      }

      .fuge-feature-icons__grid,
      .fuge-gallery__grid,
      .fuge-surroundings,
      .fuge-related__grid {
        grid-template-columns: 1fr;
      }

      .fuge-map__frame,
      .fuge-location__media,
      .fuge-location__media img,
      .fuge-location__placeholder {
        min-height: 300px;
      }

      .fuge-lightbox__dialog {
        inset: 1rem;
      }

      .fuge-lightbox__nav {
        top: auto;
        bottom: 0;
        transform: none;
      }
    }
  </style>
</BaseLayout>
