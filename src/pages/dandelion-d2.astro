---
import BaseLayout from "../layouts/BaseLayout.astro";
import { accommodations } from "../data/accommodations";
import { apartments } from "../data/apartments";
import { readApartmentImageAssignments } from "../lib/apartment-image-assignments";
import { readHomepageImageMapping } from "../lib/homepage-image-mapping";
import { readMediaApartmentAssignments } from "../lib/media-apartment-assignments";
import { fetchWordPressMedia } from "../lib/wp-media";

const bookingLink = "https://ibe.sabeeapp.com/v3/p/Dandelion-Vendeghazak?p=3970b30e1042d58f";
const baseHref = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const resolveStayHref = (href: string) => (href.startsWith("/") ? `${baseHref}${href.replace(/^\/+/, "")}` : href);
const apartmentKey = apartments.d2.key;
const buildApartmentImageConfigUrl = (nextApartmentKey: string) =>
  `/wp-json/dandelion/v1/apartment-image-config/${nextApartmentKey}`;
const d2RuntimeGalleryEndpoint = buildApartmentImageConfigUrl(apartmentKey);

// [CHANGE 2026-04-23 20:15] Keep the full D2 page image set in one place so later real photos are easy to swap in.
const d2PlaceholderGallery = [
  {
    id: -1,
    src: "https://images.pexels.com/photos/271624/pexels-photo-271624.jpeg?auto=compress&cs=tinysrgb&w=1600",
    alt: "Világos, természetközeli nappali nagy ablakokkal"
  },
  {
    id: -2,
    src: "https://images.pexels.com/photos/1457842/pexels-photo-1457842.jpeg?auto=compress&cs=tinysrgb&w=1600",
    alt: "Letisztult étkező és nappali természetes fénnyel"
  },
  {
    id: -3,
    src: "https://images.pexels.com/photos/6489127/pexels-photo-6489127.jpeg?auto=compress&cs=tinysrgb&w=1600",
    alt: "Világos étkező és konyha természetes anyagokkal"
  },
  {
    id: -4,
    src: "https://images.pexels.com/photos/6585619/pexels-photo-6585619.jpeg?auto=compress&cs=tinysrgb&w=1600",
    alt: "Nyugodt hálószoba puha, világos tónusokkal"
  },
  {
    id: -5,
    src: "https://images.pexels.com/photos/5998138/pexels-photo-5998138.jpeg?auto=compress&cs=tinysrgb&w=1600",
    alt: "Terasz vidéki környezetben"
  },
  {
    id: -6,
    src: "https://images.pexels.com/photos/3935331/pexels-photo-3935331.jpeg?auto=compress&cs=tinysrgb&w=1600",
    alt: "Nappali részlet nagy üvegfelületekkel"
  },
  {
    id: -7,
    src: "https://images.pexels.com/photos/7031408/pexels-photo-7031408.jpeg?auto=compress&cs=tinysrgb&w=1600",
    alt: "Letisztult enteriőr természetes fénnyel"
  },
  {
    id: -8,
    src: "https://images.pexels.com/photos/5997994/pexels-photo-5997994.jpeg?auto=compress&cs=tinysrgb&w=1600",
    alt: "Kültéri pihenősarok növények között"
  },
  {
    id: -9,
    src: "https://images.pexels.com/photos/7534556/pexels-photo-7534556.jpeg?auto=compress&cs=tinysrgb&w=1600",
    alt: "Világos apartmanrészlet otthonos hangulattal"
  },
  {
    id: -10,
    src: "https://images.pexels.com/photos/7031406/pexels-photo-7031406.jpeg?auto=compress&cs=tinysrgb&w=1600",
    alt: "Tágas, családbarát enteriőr nyugodt színekkel"
  }
] as const;

const primaryFacts = [
  "A D2 jól felszerelt, családbarát apartman, ahol a világos terek és a praktikus elrendezés a nyugodt pihenést szolgálják.",
  "Kényelmes nappali, használható konyha és otthonos szobák várják azokat, akik szeretnének egyszerűen megérkezni és kikapcsolni."
];

const featureGroups = [
  {
    title: "Alapadatok",
    items: [
      ["Férőhely", "4–6 fő"],
      ["Méret", "kb. 75 m²"],
      ["Ágyak", "2 háló + nappali"],
      ["Parkolás", "ingyenes udvari parkolás"]
    ]
  },
  {
    title: "Kényelem",
    items: [
      ["Wifi", "gyors, stabil kapcsolat"],
      ["Konyha", "jól felszerelt"],
      ["Fürdő", "kényelmes, családbarát"],
      ["Jelleg", "családbarát pihenés"]
    ]
  }
] as const;

const featureHighlights = [
  "Gyors wifi",
  "Jól felszerelt konyha",
  "Kényelmes fürdő",
  "Saját parkolás",
  "Családbarát elrendezés",
  "Nyugodt kertkapcsolat"
] as const;

// [CHANGE 2026-04-24 11:35] Keep legacy D2 assignments as the gallery source and apply admin sortOrder only as ordering metadata.
const apartmentImageAssignments = await readApartmentImageAssignments();
const d2GalleryAssignments = apartmentImageAssignments[apartmentKey]?.gallery || [];

const legacyApartmentAssignments = await readMediaApartmentAssignments();
const legacyD2AssignedIds = Object.entries(legacyApartmentAssignments)
  .filter(([, assignedApartmentKey]) => assignedApartmentKey === apartmentKey)
  .map(([id]) => Number(id))
  .filter((id) => Number.isInteger(id) && id > 0);

let d2GalleryImages = d2PlaceholderGallery;

try {
  const mediaResult = await fetchWordPressMedia();

  if (mediaResult.warning) {
    console.warn(`[D2 gallery] WordPress media warning: ${mediaResult.warning}`);
  }

  if (mediaResult.error) {
    console.warn(`[D2 gallery] WordPress media error: ${mediaResult.error}`);
  }

  const sortOrderById = new Map(d2GalleryAssignments.map((item) => [item.id, item.sortOrder]));
  const mediaById = new Map(mediaResult.items.map((item) => [item.id, item]));
  const orderedD2GalleryIds = [...legacyD2AssignedIds].sort((leftId, rightId) => {
    const leftSortOrder = sortOrderById.get(leftId);
    const rightSortOrder = sortOrderById.get(rightId);
    const leftHasSortOrder = typeof leftSortOrder === "number";
    const rightHasSortOrder = typeof rightSortOrder === "number";

    if (leftHasSortOrder && rightHasSortOrder && leftSortOrder !== rightSortOrder) {
      return leftSortOrder - rightSortOrder;
    }

    if (leftHasSortOrder !== rightHasSortOrder) {
      return leftHasSortOrder ? -1 : 1;
    }

    return legacyD2AssignedIds.indexOf(leftId) - legacyD2AssignedIds.indexOf(rightId);
  });
  const resolvedAssignedImages = orderedD2GalleryIds
    .map((id) => {
      const item = mediaById.get(id);

      if (!item || !item.sourceUrl) {
        return null;
      }

      return {
        id,
        src: item.sourceUrl,
        alt: item.altText || item.title || `Dandelion D2 gallery image ${id}`
      };
    })
    .filter((item): item is { id: number; src: string; alt: string } => Boolean(item));

  const mediaIds = new Set(mediaResult.items.map((item) => item.id));
  const missingAssignedIds = legacyD2AssignedIds.filter((id) => !mediaIds.has(id));

  console.warn(
    `[D2 gallery] source=media-apartment-assignments, assigned=${legacyD2AssignedIds.length}, ordered=${d2GalleryAssignments.length}, fetched=${mediaResult.items.length}, resolved=${resolvedAssignedImages.length}, missing=${missingAssignedIds.length}`
  );

  if (missingAssignedIds.length) {
    console.warn(
      `[D2 gallery] ${missingAssignedIds.length} assigned media item missing from fetched WP media: ${missingAssignedIds.join(", ")}`
    );
  }

  if (resolvedAssignedImages.length > 0) {
    d2GalleryImages = resolvedAssignedImages;
  } else {
    console.warn("[D2 gallery] No usable D2 gallery images resolved from active assignment source; using placeholder fallback.");
  }
} catch (error) {
  console.warn(
    `[D2 gallery] Failed to resolve assigned gallery images: ${
      error instanceof Error ? error.message : "Unknown error"
    }`
  );
}

const d2GalleryPreviewImages = d2GalleryImages.slice(0, 12);
const d2GalleryHasMore = d2GalleryImages.length > d2GalleryPreviewImages.length;
const d2GalleryMoreCount = Math.max(d2GalleryImages.length - d2GalleryPreviewImages.length, 0);

const imageMapping = await readHomepageImageMapping();
const relatedStays = accommodations
  .filter((stay) => stay.slug !== "dandelion-d2")
  .slice(0, 3)
  .map((stay) => ({
    ...stay,
    href: resolveStayHref(stay.url),
    image: imageMapping[stay.imageSlot]
  }));
---

<BaseLayout
  title="Dandelion D2 | Dandelion Vendégházak"
  description="Dandelion D2 külön oldal a Balaton-felvidéki, családbarát pihenés hangulatára építve."
>
  <section class="d2-hero">
    <img
      src={d2PlaceholderGallery[0].src}
      alt={d2PlaceholderGallery[0].alt}
      class="d2-hero__image"
      data-d2-hero-image
    />
    <div class="d2-hero__overlay"></div>
    <div class="dnd-container d2-hero__content">
      <div class="d2-hero__copy">
        <span class="d2-kicker">Balaton-felvidék · Szent György-hegy</span>
        <h1>Dandelion D2</h1>
        <p class="d2-hero__subtitle">családbarát apartman a Szent György-hegy lábánál</p>
        <p class="d2-hero__lead">
          Világos terek, kertkapcsolat és kényelmes, természetközeli pihenés a Balaton-felvidék nyugodt ritmusában.
        </p>
        <div class="d2-hero__actions">
          <button type="button" class="dnd-btn dnd-btn--primary" onclick="OpenBE()">Árak és foglalás</button>
          <a href="#d2-gallery" class="dnd-btn dnd-btn--secondary">Galéria megtekintése</a>
        </div>
      </div>
    </div>
  </section>

  <section class="d2-intro dnd-section">
    <div class="dnd-container">
      <div class="d2-intro__inner">
        <span class="dnd-section-kicker">Nyugalom · családbarát pihenés</span>
        <h2 class="d2-intro__title">Otthonos terek, nyugodt pihenés</h2>
        <p class="dnd-section-intro">
          Világos belső terek, kellemes terasz és praktikus elrendezés várja azokat, akik kényelmes, családbarát pihenést keresnek a Balaton-felvidéken.
        </p>
      </div>
    </div>
  </section>

  <section class="d2-details dnd-section">
    <div class="dnd-container d2-details__grid">
      <div class="d2-details__story">
        <span class="dnd-section-kicker">Dandelion D2</span>
        <h2 class="d2-section-title">Gazdag felszereltség, otthonos terek</h2>
        {primaryFacts.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
        <button type="button" class="dnd-btn dnd-btn--secondary d2-details__cta" onclick="OpenBE()">
          Árak és foglalás
        </button>
      </div>

      <div class="d2-details__facts">
        <div class="d2-details__fact-grid">
          {featureGroups.map((group) => (
            <section class="d2-fact-group">
              <h3>{group.title}</h3>
              <dl>
                {group.items.map(([term, value]) => (
                  <div>
                    <dt>{term}</dt>
                    <dd>{value}</dd>
                  </div>
                ))}
              </dl>
            </section>
          ))}
        </div>

        <section class="d2-feature-icons">
          <h3>Felszereltség</h3>
          <div class="d2-feature-icons__grid">
            {featureHighlights.map((item) => (
              <div class="d2-feature-icons__item">
                <strong>{item}</strong>
              </div>
            ))}
          </div>
        </section>
      </div>
    </div>
  </section>

  <section id="d2-gallery" class="d2-gallery dnd-section">
    <div class="dnd-container">
      <div class="d2-gallery__heading">
        <span class="dnd-section-kicker">Galéria</span>
        <h2 class="d2-section-title">Tizenkét pillanat a D2 hangulatából</h2>
        <p class="d2-gallery__hint">
          {d2GalleryHasMore ? "További képekért kattints" : "A galéria képei kattinthatók"}
        </p>
      </div>
      <div class="d2-gallery__grid">
        {d2GalleryPreviewImages.map((image, index) => (
          <figure class="d2-gallery__item">
            <button
              type="button"
              class="d2-gallery__trigger"
              data-d2-gallery-trigger
              data-d2-gallery-index={index}
              data-d2-gallery-id={image.id}
              aria-label="Galériakép megnyitása"
            >
              <img src={image.src} alt={image.alt} loading={index < 2 ? "eager" : "lazy"} />
              {d2GalleryHasMore && index === d2GalleryPreviewImages.length - 1 && (
                <span class="d2-gallery__more-badge">+{d2GalleryMoreCount} kép</span>
              )}
            </button>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="d2-map dnd-section">
    <div class="dnd-container d2-map__inner">
      <div class="d2-map__copy">
        <span class="dnd-section-kicker">SZENT GYÖRGY-HEGY · KISAPÁTI</span>
        <h2 class="d2-section-title">D2 környéke</h2>
        <p>
          A Dandelion D2 apartman a Szent György-hegy lábánál, Kisapátiban található. Innen könnyen elérhető a Tapolcai-medence, Badacsony és a Balaton-felvidék több kirándulóhelye.
        </p>
      </div>

      <div class="d2-map__card">
        <div class="d2-map__frame" data-d2-map-frame>
          <iframe
            class="d2-map__canvas"
            src="https://www.google.com/maps?q=Szent%20Gy%C3%B6rgy-hegy%20Kisap%C3%A1ti&output=embed"
            title="Dandelion D2 környéke térkép"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
          <button class="d2-map__overlay" type="button" data-d2-map-activate>
            Kattints a térkép aktiválásához
          </button>
        </div>
        <a
          class="d2-map__link"
          href="https://www.google.com/maps/search/?api=1&query=Szent%20Gy%C3%B6rgy-hegy%20Kisap%C3%A1ti"
          target="_blank"
          rel="noopener noreferrer"
        >
          Megnyitás Google Térképen
        </a>
      </div>
    </div>
  </section>

  <section class="d2-location dnd-section">
    <div class="dnd-container d2-location__grid">
      <div class="d2-location__media">
        <img src={d2PlaceholderGallery[4].src} alt="Terasz zöld környezetben" loading="lazy" />
      </div>
      <div class="d2-location__copy">
        <span class="dnd-section-kicker">Környék és elhelyezkedés</span>
        <h2 class="d2-section-title">Tanúhegyek, Balaton, csendes utak</h2>
        <p>
          A Szent György-hegy közelsége karaktert és nyugalmat ad ennek a környéknek: rövid kirándulások, szőlőhegyek és balatoni kitérők egy helyen.
        </p>
        <p>
          A Balaton innen természetes része a napnak, a D2 pedig visszaérkezve csendet és kényelmes ritmust ad.
        </p>
      </div>
    </div>
  </section>

  <section class="d2-booking dnd-section">
    <div class="dnd-container">
      <div class="d2-booking__panel">
        <span class="dnd-section-kicker">Foglalás</span>
        <h2 class="d2-section-title">Megnéznéd a szabad időpontokat?</h2>
        <p>
          Nézd meg, mikor szabad a D2, és tervezd meg nyugodtan a következő balatoni napokat.
        </p>
        <button type="button" class="dnd-btn dnd-btn--primary d2-booking__cta" onclick="OpenBE()">
          Árak és foglalás
        </button>
      </div>
    </div>
  </section>

  <section class="d2-related dnd-section">
    <div class="dnd-container">
      <div class="d2-related__heading">
        <span class="dnd-section-kicker">További szállások</span>
        <h2 class="d2-section-title">Más Dandelion helyek ugyanebben a hangulatban</h2>
      </div>
      <div class="d2-related__grid">
        {relatedStays.map((stay) => (
          <a href={stay.href} class="d2-related__card">
            {stay.image ? (
              <img src={stay.image.sourceUrl} alt={stay.image.altText || stay.name} loading="lazy" />
            ) : (
              <div class="d2-related__placeholder">Kép hamarosan</div>
            )}
            <div class="d2-related__copy">
              <strong>{stay.name}</strong>
              <span>{stay.location}</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <div class="d2-lightbox" data-d2-lightbox hidden>
    <div class="d2-lightbox__backdrop" data-d2-lightbox-close></div>
    <div class="d2-lightbox__dialog" role="dialog" aria-modal="true" aria-label="D2 galéria">
      <button type="button" class="d2-lightbox__close" data-d2-lightbox-close aria-label="Galéria bezárása">
        ×
      </button>
      <button type="button" class="d2-lightbox__nav d2-lightbox__nav--prev" data-d2-lightbox-prev aria-label="Előző kép">
        ‹
      </button>
      <figure class="d2-lightbox__figure">
        <img src="" alt="" class="d2-lightbox__image" data-d2-lightbox-image />
        <figcaption class="d2-lightbox__meta">
          <span class="d2-lightbox__counter" data-d2-lightbox-counter></span>
        </figcaption>
      </figure>
      <button type="button" class="d2-lightbox__nav d2-lightbox__nav--next" data-d2-lightbox-next aria-label="Következő kép">
        ›
      </button>
    </div>
  </div>

  <script>
    document.querySelectorAll("[data-d2-map-frame]").forEach((frame) => {
      const activator = frame.querySelector("[data-d2-map-activate]");

      activator?.addEventListener("click", () => {
        frame.classList.add("is-active");
      });
    });
  </script>

  <script define:vars={{ bookingLink, d2GalleryImages, d2RuntimeGalleryEndpoint }}>
    if (typeof window.OpenBE !== "function") {
      window.OpenBE = () => {
        window.open(bookingLink, "_blank", "noopener,noreferrer");
      };
    }

    const heroImage = document.querySelector("[data-d2-hero-image]");
    const lightbox = document.querySelector("[data-d2-lightbox]");
    const lightboxImage = document.querySelector("[data-d2-lightbox-image]");
    const lightboxCounter = document.querySelector("[data-d2-lightbox-counter]");
    const galleryGrid = document.querySelector(".d2-gallery__grid");
    const galleryTriggers = Array.from(document.querySelectorAll("[data-d2-gallery-trigger]"));
    const closeButtons = Array.from(document.querySelectorAll("[data-d2-lightbox-close]"));
    const prevButton = document.querySelector("[data-d2-lightbox-prev]");
    const nextButton = document.querySelector("[data-d2-lightbox-next]");

    if (lightbox && lightboxImage && lightboxCounter && galleryTriggers.length && d2GalleryImages.length) {
      let activeIndex = 0;
      let autoplayTimer = null;
      let runtimeHeroImages = null;
      const heroMediaQuery = window.matchMedia("(max-width: 767px)");
      const heroFallback = heroImage
        ? {
            src: heroImage.getAttribute("src") || "",
            alt: heroImage.getAttribute("alt") || ""
          }
        : null;
      const previewItems = galleryTriggers
        .map((trigger) => ({
          trigger,
          figure: trigger.closest(".d2-gallery__item"),
          image: trigger.querySelector("img"),
          badge: trigger.querySelector(".d2-gallery__more-badge")
        }))
        .filter((item) => item.figure && item.image);

      const stopAutoplay = () => {
        if (autoplayTimer) {
          window.clearInterval(autoplayTimer);
          autoplayTimer = null;
        }
      };

      const renderLightbox = () => {
        const currentImage = d2GalleryImages[activeIndex];

        if (!currentImage) {
          return;
        }

        lightboxImage.src = currentImage.src;
        lightboxImage.alt = currentImage.alt;
        lightboxCounter.textContent = `${activeIndex + 1} / ${d2GalleryImages.length}`;
      };

      const renderPreviewGrid = () => {
        if (!galleryGrid || !previewItems.length) {
          return;
        }

        const previewImages = d2GalleryImages.slice(0, previewItems.length);
        const hasMore = d2GalleryImages.length > previewImages.length;
        const moreCount = Math.max(d2GalleryImages.length - previewImages.length, 0);

        previewItems.forEach((item, index) => {
          const nextImage = previewImages[index];

          if (!nextImage || !item.image || !item.figure) {
            return;
          }

          item.trigger.setAttribute("data-d2-gallery-index", String(index));
          item.trigger.setAttribute("data-d2-gallery-id", String(nextImage.id));
          item.image.src = nextImage.src;
          item.image.alt = nextImage.alt;
          item.image.loading = index < 2 ? "eager" : "lazy";

          if (item.badge) {
            item.badge.remove();
          }

          if (hasMore && index === previewImages.length - 1) {
            const nextBadge = document.createElement("span");
            nextBadge.className = "d2-gallery__more-badge";
            nextBadge.textContent = `+${moreCount} kép`;
            item.trigger.appendChild(nextBadge);
          }

          galleryGrid.appendChild(item.figure);
        });
      };

      const applyRuntimeGalleryOrder = (galleryAssignments) => {
        if (!Array.isArray(galleryAssignments) || !galleryAssignments.length) {
          return;
        }

        const sortOrderById = new Map(
          galleryAssignments
            .map((item) => {
              const id = Number(item?.id);
              const sortOrder = Number(item?.sortOrder);

              if (!Number.isInteger(id) || id <= 0 || !Number.isFinite(sortOrder)) {
                return null;
              }

              return [id, sortOrder];
            })
            .filter(Boolean)
        );

        if (!sortOrderById.size) {
          return;
        }

        const orderedImages = d2GalleryImages
          .map((image, originalIndex) => ({
            ...image,
            originalIndex,
            sortOrder: sortOrderById.get(Number(image.id))
          }))
          .sort((left, right) => {
            const leftHasSortOrder = typeof left.sortOrder === "number";
            const rightHasSortOrder = typeof right.sortOrder === "number";

            if (leftHasSortOrder && rightHasSortOrder && left.sortOrder !== right.sortOrder) {
              return left.sortOrder - right.sortOrder;
            }

            if (leftHasSortOrder !== rightHasSortOrder) {
              return leftHasSortOrder ? -1 : 1;
            }

            return left.originalIndex - right.originalIndex;
          })
          .map(({ id, src, alt }) => ({ id, src, alt }));

        d2GalleryImages.splice(0, d2GalleryImages.length, ...orderedImages);
        renderPreviewGrid();

        if (!lightbox.hidden) {
          activeIndex = Math.min(activeIndex, d2GalleryImages.length - 1);
          renderLightbox();
        }
      };

      const getActiveRuntimeHeroImage = () => {
        if (!runtimeHeroImages) {
          return null;
        }

        if (heroMediaQuery.matches) {
          return runtimeHeroImages.mobile || runtimeHeroImages.desktop || null;
        }

        return runtimeHeroImages.desktop || null;
      };

      const renderHeroImage = () => {
        if (!heroImage || !heroFallback) {
          return;
        }

        const nextHeroImage = getActiveRuntimeHeroImage();

        if (!nextHeroImage?.url) {
          heroImage.src = heroFallback.src;
          heroImage.alt = heroFallback.alt;
          return;
        }

        heroImage.src = nextHeroImage.url;
        heroImage.alt = nextHeroImage.alt || nextHeroImage.title || heroFallback.alt;
      };

      const startAutoplay = () => {
        stopAutoplay();
        autoplayTimer = window.setInterval(() => {
          activeIndex = (activeIndex + 1) % d2GalleryImages.length;
          renderLightbox();
        }, 4800);
      };

      const openLightbox = (index) => {
        activeIndex = index;
        lightbox.hidden = false;
        document.body.classList.add("d2-lightbox-open");
        renderLightbox();
        startAutoplay();
      };

      const closeLightbox = () => {
        lightbox.hidden = true;
        document.body.classList.remove("d2-lightbox-open");
        stopAutoplay();
      };

      const stepLightbox = (direction) => {
        activeIndex = (activeIndex + direction + d2GalleryImages.length) % d2GalleryImages.length;
        renderLightbox();
        startAutoplay();
      };

      galleryTriggers.forEach((trigger) => {
        trigger.addEventListener("click", () => {
          const nextIndex = Number(trigger.getAttribute("data-d2-gallery-index"));
          openLightbox(Number.isFinite(nextIndex) ? nextIndex : 0);
        });
      });

      closeButtons.forEach((button) => {
        button.addEventListener("click", closeLightbox);
      });

      prevButton?.addEventListener("click", () => stepLightbox(-1));
      nextButton?.addEventListener("click", () => stepLightbox(1));

      document.addEventListener("keydown", (event) => {
        if (lightbox.hidden) {
          return;
        }

        if (event.key === "Escape") {
          closeLightbox();
        }

        if (event.key === "ArrowLeft") {
          stepLightbox(-1);
        }

        if (event.key === "ArrowRight") {
          stepLightbox(1);
        }
      });

      fetch(d2RuntimeGalleryEndpoint, {
        headers: {
          Accept: "application/json"
        }
      })
        .then((response) => {
          if (!response.ok) {
            throw new Error("Runtime gallery order request failed.");
          }

          return response.json();
        })
        .then((payload) => {
          const desktopHeroImage =
            payload?.heroImages?.desktop && typeof payload.heroImages.desktop.url === "string"
              ? payload.heroImages.desktop
              : null;
          const mobileHeroImage =
            payload?.heroImages?.mobile && typeof payload.heroImages.mobile.url === "string"
              ? payload.heroImages.mobile
              : null;

          runtimeHeroImages = {
            desktop: desktopHeroImage,
            mobile: mobileHeroImage
          };

          applyRuntimeGalleryOrder(payload?.gallery || []);
          renderHeroImage();
        })
        .catch((error) => {
          // Keep the build-time gallery order when the runtime config is unavailable.
          console.warn(
            `[D2 hero] Runtime apartment image config unavailable: ${
              error instanceof Error ? error.message : "Unknown error"
            }`
          );
        });

      const handleHeroViewportChange = () => {
        renderHeroImage();
      };

      if (typeof heroMediaQuery.addEventListener === "function") {
        heroMediaQuery.addEventListener("change", handleHeroViewportChange);
      } else if (typeof heroMediaQuery.addListener === "function") {
        heroMediaQuery.addListener(handleHeroViewportChange);
      }

      window.addEventListener("resize", handleHeroViewportChange);
      window.addEventListener("orientationchange", handleHeroViewportChange);
    }
  </script>
</BaseLayout>

