---
import BaseLayout from "../layouts/BaseLayout.astro";
import { accommodationImages } from "../data/images/accommodation-images";
import { readHomepageImageMapping } from "../lib/homepage-image-mapping";

const bookingLink = "https://ibe.sabeeapp.com/v3/p/Dandelion-Vendeghazak?p=3970b30e1042d58f";
const baseHref = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
// [CHANGE 2026-04-26 00:00] D2 mobil hero kép útvonalának átkötése az új strukturált WebP-re.
const d2MobileHeroImage = `${baseHref}images/accommodations/d2/hero/dandelion-d2-kisapati-hero-mobile-01.webp`;
// [CHANGE 2026-04-26 00:00] D2 desktop hero átkötése az image registry lokális WebP képére.
const d2DesktopHeroRegistryImage = accommodationImages.d2?.hero.desktop;
const d2DesktopHeroImage = d2DesktopHeroRegistryImage?.src
  ? `${baseHref}${d2DesktopHeroRegistryImage.src.replace(/^\/+/, "")}`
  : "";
const d2DesktopHeroAlt = d2DesktopHeroRegistryImage?.alt.hu || "Dandelion D2";
const resolveStayHref = (href: string) => (href.startsWith("/") ? `${baseHref}${href.replace(/^\/+/, "")}` : href);

type D2GalleryImage = {
  id: number | string;
  src: string;
  thumb: string;
  alt: string;
  title?: string;
  caption?: string;
  sortOrder?: number;
};
type D2HeroImage = { src: string; alt: string };

const d2ShortDescription =
  "A Dandelion D2 világos, családbarát apartman Kisapátin, a Szent György-hegy lábánál. Kényelmes választás 4–6 főnek, saját parkolóval, terasszal és nyugodt kertkapcsolattal.";

const d2LongDescription = [
  "A D2 Kisapátiban, a Szent György-hegy lábánál ad nyugodt, jól használható bázist a Balaton-felvidéki napokhoz.",
  "A lakás 4 főnek kényelmes, a kihúzható kanapéval pedig akár 6 főnek is megoldást ad. A nappali, a konyha és az étkező egy praktikus, világos élettérben kapcsolódik össze.",
  "A terasz és a kertkapcsolat lassabb reggelekhez és esti beszélgetésekhez is jól működik, saját parkolóval, klímával és kandallóval egész évben kényelmes.",
  "A Balaton rövid autózással elérhető, bababarát felszereltség kérésre adható, a D1 vendégházzal együtt pedig nagyobb családnak vagy baráti társaságnak is jó választás lehet."
];

const featureGroups = [
  {
    title: "Alapadatok",
    items: [
      ["Férőhely", "4–6 fő"],
      ["Méret", "65 m²"],
      ["Ágyak", "1 franciaágy, 2 szimpla ágy, 1 kihúzható kanapé"],
      ["Parkolás", "ingyenes udvari parkolás"]
    ]
  },
  {
    title: "Kényelem",
    items: [
      ["Wifi", "Gigabites Wi-Fi"],
      ["Konyha", "jól felszerelt"],
      ["Fürdő", "kényelmes, családbarát"],
      ["Jelleg", "családbarát pihenés"]
    ]
  }
] as const;

const mobileFactItems = featureGroups.flatMap((group) => group.items);

const featureHighlights = [
  { label: "Gigabites Wi-Fi", icon: "wifi" },
  { label: "Jól felszerelt konyha", icon: "utensils" },
  { label: "Kényelmes fürdő", icon: "shower" },
  { label: "Saját parkolás", icon: "car" },
  { label: "Családbarát elrendezés", icon: "users" },
  { label: "Nyugodt kertkapcsolat", icon: "leaf" }
] as const;

const locationBenefits = [
  { label: "Túrák a közelben", icon: "trail" },
  { label: "Borvidék és szőlőhegyek", icon: "grapes" },
  { label: "Balaton rövid autózással", icon: "route" }
] as const;

const d2Reviews = [
  {
    source: "Google",
    logoSrc: `${baseHref}images/brand/google-logo-compact.png`,
    logoAlt: "Google értékelés",
    quote: "„Idilli környezet, kedves házigazdák, sok hely a gyerekeknek és nyugodt, szerethető hangulat.”",
    meta: "Vanessa L. · Google · 5/5"
  },
  {
    source: "Google",
    logoSrc: `${baseHref}images/brand/google-logo-compact.png`,
    logoAlt: "Google értékelés",
    quote: "„A ház minden igényt kielégít, és jó szívvel ajánlom annak, aki pár napra elvonulna.”",
    meta: "Ildikó Barna · Google · 5/5"
  },
  {
    source: "Google",
    logoSrc: `${baseHref}images/brand/google-logo-compact.png`,
    logoAlt: "Google értékelés",
    quote: "„Szép, rendezett hely, csendes környezet és gördülékeny érkezés. Kifejezetten jó pihenéshez.”",
    meta: "Eszter K. · Google · 5/5"
  },
  {
    source: "Booking.com",
    logoSrc: `${baseHref}images/brand/booking-logo-compact.png`,
    logoAlt: "Booking.com értékelés",
    quote: "„Abszolút pozitív élmény, gyors válaszokkal és nagyon segítőkész házigazdákkal.”",
    meta: "Bernadett · Booking.com · 10/10"
  },
  {
    source: "Booking.com",
    logoSrc: `${baseHref}images/brand/booking-logo-compact.png`,
    logoAlt: "Booking.com értékelés",
    quote: "„Tökéletes pihentető napokhoz: csendes hely, barátságos házigazdák és kényelmes szállás.”",
    meta: "Angelika · Booking.com · 9,0/10"
  }
] as const;

const d2MobileGoogleReviews = d2Reviews.filter((review) => review.source === "Google").slice(0, 2);
const d2MobileBookingReviews = d2Reviews.filter((review) => review.source === "Booking.com").slice(0, 2);

const resolveRegistryImagePath = (imagePath: string) =>
  imagePath.startsWith("/") ? `${baseHref}${imagePath.replace(/^\/+/, "")}` : imagePath;

const d2RegistryGalleryImages: D2GalleryImage[] = (accommodationImages.d2?.gallery || [])
  .slice()
  .sort((left, right) => left.sortOrder - right.sortOrder)
  .map((image) => ({
    id: typeof image.source.wpId === "number" ? image.source.wpId : image.sortOrder,
    src: resolveRegistryImagePath(image.src),
    thumb: resolveRegistryImagePath(image.thumb),
    alt: image.alt.hu,
    title: image.title.hu,
    caption: image.caption.hu,
    sortOrder: image.sortOrder
  }));
// [CHANGE 2026-04-26 00:00] D2 galéria átkötése az image registry lokális WebP és thumb képeire.
// [CHANGE 2026-04-26 00:00] D2 nem használt WP galéria és legacy fallback képlogika cleanup 1. kör.
let d2GalleryImages: D2GalleryImage[] = d2RegistryGalleryImages;

let d2GalleryWarning = "";

if (!d2GalleryImages.length) {
  d2GalleryWarning = "A D2 galériához jelenleg nincs feloldható kép.";
}

// [CHANGE 2026-04-26 00:00] D2 nem használt Pexels placeholder/fallback képlogika eltávolítása.
const d2LocalHeroFallback: D2HeroImage = {
  src: d2MobileHeroImage,
  alt: "Dandelion D2"
};
const d2HeroFallback = d2GalleryImages[0] || d2LocalHeroFallback;
const d2InitialHeroImage: D2HeroImage = {
  src: d2DesktopHeroImage || d2HeroFallback.src,
  alt: d2DesktopHeroAlt || d2HeroFallback.alt
};
const d2GalleryPreviewImages = d2GalleryImages.slice(0, 8);
const d2GalleryHasMore = d2GalleryImages.length > d2GalleryPreviewImages.length;
const d2GalleryMoreCount = Math.max(d2GalleryImages.length - d2GalleryPreviewImages.length, 0);

const imageMapping = await readHomepageImageMapping();
const compactRelatedStays = [
  {
    name: "Fügeház",
    meta: "2–4 fő · panoráma · dézsa",
    href: `${baseHref}fuge/`,
    image: imageMapping.fugehaz_card_image
  },
  {
    name: "Dandelion D1",
    meta: "6–8 fő · nagy kert · családoknak",
    href: "https://dandelionhouse.hu/dandelion-d1/",
    image: imageMapping.d1_card_image
  },
  {
    name: "Zsálya Vendégház",
    meta: "csendes, természetközeli pihenés",
    href: "https://dandelionhouse.hu/zsalya/",
    image: imageMapping.zsalya_card_image
  },
  {
    name: "Szőlőliget Vendégház",
    meta: "elvonulás a szőlők között",
    href: "https://dandelionhouse.hu/szololiget/",
    image: imageMapping.szololiget_card_image
  },
  {
    name: "Dandelion Köveskál",
    meta: "Káli-medence · nyugodt falusi hangulat",
    href: "https://dandelionhouse.hu/koveskal/",
    image: {
      sourceUrl: `${baseHref}images/accommodations/koveskal/gallery/dandelion-koveskal-source-001.webp`,
      altText: "Dandelion Köveskál vendégház külső képe"
    }
  }
] as const;
---

<BaseLayout
  title="Dandelion D2 | Dandelion Vendégházak"
  description="Dandelion D2 külön oldal a Balaton-felvidéki, családbarát pihenés hangulatára építve."
>
  <Fragment slot="head">
    <link
      rel="preload"
      as="image"
      href={d2MobileHeroImage}
      type="image/webp"
      media="(max-width: 767px)"
      fetchpriority="high"
    />
    <meta name="theme-color" content="#efe4d3" media="(max-width: 767px)" />
  </Fragment>

  <section class="d2-hero">
    <picture class="d2-hero__picture">
      <source media="(max-width: 767px)" srcset={d2MobileHeroImage} data-d2-hero-mobile-source />
      <img
        src={d2InitialHeroImage.src}
        alt={d2InitialHeroImage.alt}
        class="d2-hero__image"
        loading="eager"
        decoding="async"
        fetchpriority="high"
        data-d2-hero-image
      />
    </picture>
    <div class="d2-hero__overlay"></div>
    <div class="dnd-container d2-hero__content">
      <div class="d2-hero__copy">
        <span class="d2-kicker">Balaton-felvidék · Szent György-hegy</span>
        <h1>Dandelion <span>D2</span></h1>
        <p class="d2-hero__subtitle">KERTES HÁZ A SZENT GYÖRGY-HEGY LÁBÁNÁL</p>
        <p class="d2-hero__lead">
          Családbarát pihenés 4–6 főnek, a ház és a kert kizárólagos használatával.
        </p>
        <div class="d2-hero__actions">
          <button type="button" class="dnd-btn dnd-btn--primary d2-hero__booking" onclick="OpenBE()">Árak és foglalás</button>
          <a href="#d2-gallery" class="dnd-btn dnd-btn--secondary" data-d2-gallery-jump>Képek megtekintése</a>
        </div>
      </div>
    </div>
  </section>

  <section class="d2-reviews dnd-section" aria-labelledby="d2-reviews-title">
    <div class="dnd-container">
      <div class="d2-reviews__shell">
        <div class="d2-reviews__heading">
          <span class="dnd-section-kicker">Vendégértékelések</span>
          <h2 id="d2-reviews-title" class="d2-reviews__title">Vendégeink szerint</h2>
          <p class="d2-reviews__intro">Valódi vendégértékelések Google és Booking.com forrásból</p>
        </div>

        <div class="d2-reviews__grid">
          {d2Reviews.map((review) => (
            <article class="d2-review-card">
              <div class="d2-review-card__top">
                <img
                  src={review.logoSrc}
                  alt={review.logoAlt}
                  class:list={["d2-review-card__logo", review.source === "Google" ? "is-google" : "is-booking"]}
                  loading="lazy"
                  decoding="async"
                />
                <span class="d2-review-card__stars" aria-hidden="true">★★★★★</span>
              </div>
              <blockquote class="d2-review-card__quote">{review.quote}</blockquote>
              <p class="d2-review-card__meta">{review.meta}</p>
            </article>
          ))}
        </div>

        <div class="d2-reviews__mobile">
          <section class="d2-reviews__mobile-group" aria-label="Google értékelések">
            <div class="d2-reviews__mobile-head">
              <img
                src={`${baseHref}images/brand/google-logo-compact.png`}
                alt="Google értékelés"
                class="d2-reviews__mobile-logo is-google"
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="d2-reviews__mobile-list">
              {d2MobileGoogleReviews.map((review) => (
                <article class="d2-review-card d2-review-card--mobile">
                  <div class="d2-review-card__top d2-review-card__top--mobile">
                    <span class="d2-review-card__stars" aria-hidden="true">★★★★★</span>
                  </div>
                  <blockquote class="d2-review-card__quote">{review.quote}</blockquote>
                  <p class="d2-review-card__meta">{review.meta}</p>
                </article>
              ))}
            </div>
          </section>

          <section class="d2-reviews__mobile-group" aria-label="Booking.com értékelések">
            <div class="d2-reviews__mobile-head">
              <img
                src={`${baseHref}images/brand/booking-logo-compact.png`}
                alt="Booking.com értékelés"
                class="d2-reviews__mobile-logo is-booking"
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="d2-reviews__mobile-list">
              {d2MobileBookingReviews.map((review) => (
                <article class="d2-review-card d2-review-card--mobile">
                  <div class="d2-review-card__top d2-review-card__top--mobile">
                    <span class="d2-review-card__stars" aria-hidden="true">★★★★★</span>
                  </div>
                  <blockquote class="d2-review-card__quote">{review.quote}</blockquote>
                  <p class="d2-review-card__meta">{review.meta}</p>
                </article>
              ))}
            </div>
          </section>
        </div>
      </div>
    </div>
  </section>

  <section class="d2-intro dnd-section">
    <div class="dnd-container">
      <div class="d2-intro__inner">
        <span class="dnd-section-kicker">Nyugalom · családbarát pihenés</span>
        <h2 class="d2-intro__title">Otthonos terek, nyugodt pihenés</h2>
        <p class="dnd-section-intro">
          Világos belső terek, kellemes terasz és praktikus elrendezés várja azokat, akik kényelmes, családbarát pihenést keresnek a Balaton-felvidéken.
        </p>
      </div>
    </div>
  </section>

  <section class="d2-details dnd-section">
    <div class="dnd-container d2-details__grid">
      <div class="d2-details__story">
        <span class="dnd-section-kicker">Dandelion D2</span>
        <h2 class="d2-section-title">Gazdag felszereltség, otthonos terek</h2>
        <p>{d2ShortDescription}</p>
        <details class="d2-details__more">
          <summary>Bővebben a D2-ről</summary>
          <div>
            {d2LongDescription.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </div>
        </details>
        <button type="button" class="dnd-btn dnd-btn--secondary d2-details__cta" onclick="OpenBE()">
          Árak és foglalás
        </button>
      </div>

      <div class="d2-details__facts">
        <div class="d2-details__fact-grid">
          {featureGroups.map((group) => (
            <section class="d2-fact-group">
              <h3>{group.title}</h3>
              <dl>
                {group.items.map(([term, value]) => (
                  <div>
                    <dt>{term}</dt>
                    <dd>{value}</dd>
                  </div>
                ))}
              </dl>
            </section>
          ))}
        </div>

        <div class="d2-details__mobile-facts">
          {mobileFactItems.map(([term, value]) => (
            <div class="d2-details__mobile-fact">
              <span>{term}</span>
              <strong>{value}</strong>
            </div>
          ))}
        </div>

        <section class="d2-feature-icons">
          <h3>Felszereltség</h3>
          <div class="d2-feature-icons__grid">
            {featureHighlights.map((item) => (
              <div class="d2-feature-icons__item">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <use href={`#d2-icon-${item.icon}`}></use>
                </svg>
                <strong>{item.label}</strong>
              </div>
            ))}
          </div>
        </section>
      </div>
    </div>
  </section>

  <section id="d2-gallery" class="d2-gallery dnd-section">
    <div class="dnd-container">
      <div class="d2-gallery__heading">
        <span class="dnd-section-kicker">Galéria</span>
        <h2 class="d2-section-title">Nyolc pillanat a D2 hangulatából</h2>
        <p class="d2-gallery__hint">
          {d2GalleryHasMore ? "További képekért kattints" : "A galéria képei kattinthatók"}
        </p>
      </div>
      {d2GalleryPreviewImages.length > 0 ? (
        <div class="d2-gallery__grid">
          {d2GalleryPreviewImages.map((image, index) => (
            <figure class="d2-gallery__item">
              <button
                type="button"
                class="d2-gallery__trigger"
                data-d2-gallery-trigger
                data-d2-gallery-index={index}
                data-d2-gallery-id={image.id}
                aria-label="Galériakép megnyitása"
              >
                <img src={image.thumb || image.src} alt={image.alt} loading={index < 2 ? "eager" : "lazy"} />
                <span class="d2-gallery__hover-label" aria-hidden="true">Kép megtekintése</span>
                {d2GalleryHasMore && index === d2GalleryPreviewImages.length - 1 && (
                  <span class="d2-gallery__more-badge">+{d2GalleryMoreCount} kép</span>
                )}
              </button>
            </figure>
          ))}
        </div>
      ) : (
        <div class="d2-gallery__empty" role="status">{d2GalleryWarning}</div>
      )}
    </div>
  </section>

  <section class="d2-map dnd-section">
    <div class="dnd-container d2-map__inner">
      <div class="d2-map__copy">
        <span class="dnd-section-kicker">SZENT GYÖRGY-HEGY · KISAPÁTI</span>
        <h2 class="d2-section-title">D2 környéke</h2>
        <p>
          A Dandelion D2 a Szent György-hegy lábánál, Kisapátiban van. Onnan könnyen elérhető a Tapolcai-medence, Badacsony és a Balaton-felvidék csendesebb része.
        </p>
      </div>

      <div class="d2-map__card">
        <div class="d2-map__frame">
          <iframe
            class="d2-map__canvas"
            src="https://www.google.com/maps/d/u/0/embed?mid=1YRCy3UzpGcrJ6YJ4ihdVcluhJWtisVk&ehbc=2E312F"
            title="Dandelion D2 környéke térkép"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
        </div>
      </div>
    </div>
  </section>

  <section class="d2-closer dnd-section" aria-labelledby="d2-related-stays-title">
    <div class="dnd-container">
      <div class="d2-closer__head">
        <span class="dnd-section-kicker">További szállások</span>
        <h2 id="d2-related-stays-title" class="d2-section-title">További Dandelion szállások</h2>
        <p>Ha más hangulatot keresel, nézd meg a többi vendégházunkat is.</p>
      </div>

      <div class="d2-closer__grid">
        {compactRelatedStays.map((stay) => (
          <a href={stay.href} class="d2-closer__card">
            <div class="d2-closer__media">
              <img src={stay.image?.sourceUrl} alt={stay.image?.altText || stay.name} loading="lazy" />
              <div class="d2-closer__overlay"></div>
            </div>
            <div class="d2-closer__copy">
              <strong>{stay.name}</strong>
              <span>{stay.meta}</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <div class="d2-lightbox" data-d2-lightbox hidden>
    <div class="d2-lightbox__backdrop" data-d2-lightbox-close></div>
    <div class="d2-lightbox__dialog" role="dialog" aria-modal="true" aria-label="D2 galéria">
      <button type="button" class="d2-lightbox__close" data-d2-lightbox-close aria-label="Galéria bezárása">
        ×
      </button>
      <button type="button" class="d2-lightbox__nav d2-lightbox__nav--prev" data-d2-lightbox-prev aria-label="Előző kép">
        ‹
      </button>
      <figure class="d2-lightbox__figure">
        <img src="" alt="" class="d2-lightbox__image" data-d2-lightbox-image />
        <figcaption class="d2-lightbox__meta">
          <span class="d2-lightbox__counter" data-d2-lightbox-counter></span>
        </figcaption>
      </figure>
      <button type="button" class="d2-lightbox__nav d2-lightbox__nav--next" data-d2-lightbox-next aria-label="Következő kép">
        ›
      </button>
    </div>
  </div>

  <svg class="d2-icon-sprite" aria-hidden="true">
    <symbol id="d2-icon-wifi" viewBox="0 0 24 24">
      <path d="M4.5 9.5a11 11 0 0 1 15 0"></path>
      <path d="M8 13a6 6 0 0 1 8 0"></path>
      <path d="M11 16.5a1.5 1.5 0 0 1 2 0"></path>
      <path d="M12 19h.01"></path>
    </symbol>
    <symbol id="d2-icon-utensils" viewBox="0 0 24 24">
      <path d="M7 3v8"></path>
      <path d="M4.5 3v5.5A2.5 2.5 0 0 0 7 11v10"></path>
      <path d="M9.5 3v5.5A2.5 2.5 0 0 1 7 11"></path>
      <path d="M17 3v18"></path>
      <path d="M17 3c2 1.2 3 3 3 5.6 0 2.2-1.1 3.9-3 4.8"></path>
    </symbol>
    <symbol id="d2-icon-shower" viewBox="0 0 24 24">
      <path d="M5 11a7 7 0 0 1 14 0"></path>
      <path d="M8 11h8"></path>
      <path d="M8 15h.01"></path>
      <path d="M12 15h.01"></path>
      <path d="M16 15h.01"></path>
      <path d="M10 19h.01"></path>
      <path d="M14 19h.01"></path>
    </symbol>
    <symbol id="d2-icon-car" viewBox="0 0 24 24">
      <path d="m5 12 1.5-4.2A2.5 2.5 0 0 1 8.8 6h6.4a2.5 2.5 0 0 1 2.3 1.8L19 12"></path>
      <path d="M4 12h16v6H4z"></path>
      <path d="M7 18v2"></path>
      <path d="M17 18v2"></path>
      <path d="M7.5 15h.01"></path>
      <path d="M16.5 15h.01"></path>
    </symbol>
