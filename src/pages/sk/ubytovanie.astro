---
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { accommodationSections, accommodations } from "../../data/accommodations";
import { SITE_NAME, toAbsoluteUrl } from "../../data/site-seo";
import { readHomepageImageMapping } from "../../lib/homepage-image-mapping";

// [CHANGE 2026-06-11 00:00] Text výberu ubytovania je konkrétnejší a menej všeobecný.
type SectionKey = (typeof accommodationSections)[number]["key"];

interface SlovakStayCopy {
  name: string;
  location: string;
  description: string;
  hoverText: string;
  facts: string[];
  imageAlt: string;
}

const title = "Ubytovanie v Balatonskej vrchovine | Dandelion";
const description =
  "Vyberte si pokojné penzióny a apartmány pri Szent György-hegy, Badacsonyi, Kisapáti, Keszthelyi a v Balatonskej vrchovine.";
const accommodationsOgImage = "/images/pages/szallasok-hero-bg.webp";
const accommodationsHeroVideo = "/videos/szallasok/202507%20V1.mp4?v=20260603-lite";
const accommodationsHeroMobileVideo = "/videos/szallasok/202507%20V1-mobile-lite.mp4?v=20260606-mobile-lite";
const accommodationsOgImageAlt =
  "Výber ubytovania Dandelion v Balatonskej vrchovine";
const accommodationsTransitionImage = "/images/pages/dandelion-panorama-pool-szallasvalaszto-desktop.webp?v=20260610-img1527-q64";
const accommodationsTransitionMobileImage = "/images/pages/dandelion-panorama-pool-szallasvalaszto-mobile.webp?v=20260610-img1527-q64";
const accommodationsTransitionImageAlt =
  "Dandelion Panorama Pool s modrou vodou, ležadlami a panorámou Balatonskej vrchoviny";
const accommodationsTransitionImageTitle =
  "Panorama Pool so slnečnou terasou a výhľadom na svedecké vrchy";

const imageMapping = await readHomepageImageMapping();
const baseHref = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const englishBookingHref = "https://ibe.sabeeapp.com/v3/p/Dandelion-Vendégházak?p=3970b30e1042d58f&lang=En";

const resolveStayHref = (href: string) =>
  href.startsWith("/") ? `${baseHref}${href.replace(/^\/+/, "")}` : href;
const resolveSlovakStayHref = (slug: string, href: string) =>
  slug === "dandelion-d2"
    ? `${baseHref}sk/dandelion-d2/`
    : slug === "fugehaz"
      ? `${baseHref}sk/dandelion-fugehaz/`
      : slug === "dandelion-d1"
        ? `${baseHref}sk/dandelion-d1/`
        : slug === "zsalya-vendeghaz"
          ? `${baseHref}sk/dandelion-zsalya/`
          : slug === "szololiget-vendeghaz"
            ? `${baseHref}sk/szololiget/`
            : slug === "szepvolgyi-vendeghaz"
              ? `${baseHref}sk/szepvolgyi/`
              : slug === "royal-homes"
                ? `${baseHref}sk/royal/`
                : slug === "vintage-vendeghaz"
                  ? `${baseHref}sk/dandelion-vintage/`
                  : slug === "dandelion-koveskal"
                    ? `${baseHref}sk/dandelion-koveskal/`
                  : resolveStayHref(href);

const sectionCopy: Record<
  SectionKey,
  {
    eyebrow: string;
    title: string;
    subtitle: string;
    audienceText: string;
    anchorId: string;
  }
> = {
  upland: {
    eyebrow: "Szent György-hegy · Tapolcai-medence · Kisapáti · Nemesgulács",
    title: "Okolo svedeckých vrchov",
    subtitle:
      "Kisapáti, Nemesgulács a okolie Szent György-hegy sa hodia, ak hľadáte dom vo svahu, výhľady, záhradu a ľahko dostupné výlety.",
    audienceText: "Pre vrchy, výhľady, rodiny a pobyt s priateľmi.",
    anchorId: "balaton-uplands"
  },
  shore: {
    eyebrow: "Keszthely · Badacsonyörs · Balaton",
    title: "Jednoduché dni pri Balatone",
    subtitle:
      "Keszthely a Badacsonyörs sa hodia, keď je pre vás dôležitá blízkosť Balatonu, pláže a programy pri vode skôr než dom vo svahu.",
    audienceText: "Pre breh Balatonu, pláže a balatonské programy.",
    anchorId: "near-lake-balaton"
  },
  kali: {
    eyebrow: "Köveskál · Káli-medence · dedinské prostredie",
    title: "Tichšia strana oblasti Káli",
    subtitle:
      "Köveskál ponúka dedinské prostredie, prechádzky v Káli-medence a vinárstva, ak hľadáte tichšiu základňu.",
    audienceText: "Pre ticho, dedinské prostredie a výlety v Káli-medence.",
    anchorId: "kali-medence"
  }
};

const stayCopy: Record<string, SlovakStayCopy> = {
  "dandelion-d2": {
    name: "Dandelion D2",
    location: "Kisapáti / Balatonská vrchovina",
    description:
      "Rodinný apartmán v Kisapáti s veľkou záhradou, krytou terasou, krbom a letným prístupom k Panorama Pool.",
    hoverText: "Pre 4-6 hostí, so záhradou, terasou a Panorama Pool.",
    facts: ["4-6 hostí", "2 spálne + obývačka", "Panorama Pool", "Klimatizácia", "Rodinné"],
    imageAlt: "Dandelion D2 vidiecke ubytovanie pri Szent György-hegy"
  },
  fugehaz: {
    name: "Dandelion Fügeház",
    location: "Pri Szent György-hegy",
    description:
      "Penzión s terasami, výhľadom na svedecké vrchy a letným prístupom k Panorama Pool.",
    hoverText: "Pre 4-6 hostí, s terasami, výhľadmi a Panorama Pool.",
    facts: ["4-6 hostí", "2 podlažia", "Panorama Pool", "Panoráma", "Klimatizácia"],
    imageAlt: "Dandelion Fügeház penzión pri Szent György-hegy"
  },
  "dandelion-d1": {
    name: "Dandelion D1",
    location: "Kisapáti / Balatonská vrchovina",
    description:
      "Priestranný penzión v Kisapáti pre väčšie rodiny alebo priateľov, s tromi spálňami, dvoma kúpeľňami, terasou a letným prístupom k Panorama Pool.",
    hoverText: "Pre 6-8 hostí, s tromi spálňami a záhradou.",
    facts: ["6-8 hostí", "3 spálne + obývačka", "Panorama Pool", "Terasa", "Klimatizácia"],
    imageAlt: "Dandelion D1 priestranný vidiecky penzión v Kisapáti"
  },
  "szololiget-vendeghaz": {
    name: "Dandelion Szőlőliget",
    location: "Kisapáti / Szent György-hegy",
    description:
      "Samostatný dom s veľkou terasou a výhľadom smerom na Csobánc, vhodný na pokojnejšie dni vo svahu.",
    hoverText: "Pre 2-4 hostí, s veľkou terasou a otvoreným výhľadom.",
    facts: ["2-4 hostia", "1 spálňa + obývačka", "Panoráma", "Pokojný svah", "Klimatizácia"],
    imageAlt: "Dandelion Szőlőliget ubytovanie pri Szent György-hegy"
  },
  "zsalya-vendeghaz": {
    name: "Dandelion Zsálya",
    location: "Szent György-hegy / Kisapáti",
    description:
      "Samostatný penzión v Kisapáti s krytou terasou a výhľadom na svedecké vrchy, keď hľadáte pokojnejší a súkromnejší dom.",
    hoverText: "Pre 2-4 hostí, s krytou terasou a panorámou svedeckých vrchov.",
    facts: ["2-4 hostia", "2 spálne", "Krytá terasa", "Panoráma", "Klimatizácia"],
    imageAlt: "Dandelion Zsálya s krytou terasou pri Szent György-hegy"
  },
  "vintage-vendeghaz": {
    name: "Dandelion Vintage",
    location: "Nemesgulács / Balatonská vrchovina",
    description:
      "Penzión v Nemesgulácsi s vlastným dvorom a dvoma spálňami, praktická voľba pre balatonské programy a pokojnejšie večery.",
    hoverText: "V Nemesgulácsi, s dvoma spálňami a vlastným dvorom.",
    facts: ["Penzión", "2 spálne", "Vlastný dvor", "Klimatizácia", "Pokojnejšie večery"],
    imageAlt: "Dandelion Vintage vidiecky penzión v Nemesgulácsi"
  },
  "royal-homes": {
    name: "Dandelion Royal Homes",
    location: "Keszthely / Balaton",
    description:
      "Moderný apartmán v Keszthelyi pre 4-6 hostí s veľkou terasou, jacuzzi na strešnej terase a prostredím pri vode.",
    hoverText: "Pre 4-6 hostí, pri Balatone a s jacuzzi na strešnej terase.",
    facts: ["4-6 hostí", "2 spálne + obývačka", "Balaton", "Strešné jacuzzi", "Keszthely"],
    imageAlt: "Dandelion Royal Homes apartmán pri Balatone v Keszthelyi"
  },
  "szepvolgyi-vendeghaz": {
    name: "Dandelion Szépvölgyi",
    location: "Badacsonyörs / Szépvölgyi út",
    description:
      "Dom v Badacsonyörsi pre väčšie skupiny, so štyrmi spálňami, výhľadom na Balaton a plážami pár minút autom.",
    hoverText: "Pre 8 hostí, so štyrmi spálňami a výhľadom na Balaton.",
    facts: ["8 hostí", "4 spálne", "Balatonská panoráma", "2 kúpeľne", "Veľká záhrada"],
    imageAlt: "Dandelion Szépvölgyi priestranný dom v Badacsonyörsi"
  },
  "dandelion-koveskal": {
    name: "Dandelion Köveskál",
    location: "Köveskál / Káli-medence",
    description:
      "Pokojný penzión v Köveskáli, blízko dedín, prechádzok a vinárstiev v Káli-medence.",
    hoverText: "V Köveskáli, blízko prechádzok a vinárstiev v Káli-medence.",
    facts: ["Penzión", "Köveskál", "Káli-medence", "Dedinské prostredie", "Vinárstva blízko"],
    imageAlt: "Dandelion Köveskál pokojný vidiecky penzión v Káli-medence"
  }
};

const sections = accommodationSections.map((section) => ({
  ...sectionCopy[section.key],
  key: section.key,
  gridClass: section.gridClass,
  stays: accommodations
    .filter((stay) => stay.section === section.key && stayCopy[stay.slug])
    .map((stay) => ({
      ...stay,
      ...stayCopy[stay.slug],
      image: imageMapping[stay.imageSlot],
      href: resolveSlovakStayHref(stay.slug, stay.url)
    }))
})).filter((section) => section.stays.length > 0);

const accommodationFaqItems = [
  {
    question: "Ktoré domy Dandelion majú prístup k bazénu?",
    answer:
      "Dandelion D1, Dandelion D2 a Fügeház sú hlavné možnosti s prístupom k Panorama Pool pri Szent György-hegy.",
    href: "#balaton-uplands"
  },
  {
    question: "Kde sa ubytovať v Kisapáti?",
    answer:
      "V Kisapáti sú hlavnou voľbou D1, D2, Zsálya a Szőlőliget. D1 je pre väčšie skupiny, D2 pre rodiny, Zsálya a Szőlőliget pre pokojnejší pobyt vo svahu.",
    href: "#balaton-uplands"
  },
  {
    question: "Ktoré ubytovanie Dandelion je vhodné pre rodiny?",
    answer:
      "Pre rodiny je zvyčajne prvou voľbou D2. Pre väčšie rodiny je praktickejší D1, menšie rodiny môžu porovnať Zsálya alebo Szőlőliget.",
    href: "#balaton-uplands"
  },
  {
    question: "Ktoré ubytovanie je najbližšie k Balatonu?",
    answer:
      "Royal Homes v Keszthelyi sa hodí, keď je dôležitá blízkosť Balatonu a strešné jacuzzi. Szépvölgyi v Badacsonyörsi sa hodí pre väčšie skupiny a výhľad na Balaton.",
    href: "#near-lake-balaton"
  },
  {
    question: "Ktorý dom je dobrý pri Szent György-hegy?",
    answer:
      "D1, D2, Fügeház, Zsálya a Szőlőliget sa hodia na pobyt pri Szent György-hegy, výhľady a krátke výlety medzi svedeckými vrchmi.",
    href: "#balaton-uplands"
  },
  {
    question: "Ktoré ubytovanie je pokojnejšie?",
    answer:
      "Pre pokojnejšie dni sa hodia Köveskál, Szőlőliget a Zsálya. Köveskál je dedinská základňa, Szőlőliget a Zsálya sú skôr domy vo svahu.",
    href: "#kali-medence"
  }
];

const accommodationsStructuredData = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "@id": `${toAbsoluteUrl("/sk/ubytovanie/")}#collection`,
  name: title,
  url: toAbsoluteUrl("/sk/ubytovanie/"),
  inLanguage: "sk-SK",
  description,
  isPartOf: {
    "@id": `${toAbsoluteUrl("/sk/")}#website`
  },
  mainEntity: {
    "@type": "ItemList",
    itemListElement: sections.flatMap((section, sectionIndex) =>
      section.stays.map((stay, stayIndex) => ({
        "@type": "ListItem",
        position: sectionIndex * 10 + stayIndex + 1,
        url: toAbsoluteUrl(stay.href),
        name: stay.name
      }))
    )
  },
  about: ["Balatonská vrchovina", "Szent György-hegy", "Balaton", "Káli-medence"],
  provider: {
    "@type": "LodgingBusiness",
    name: SITE_NAME,
    url: toAbsoluteUrl("/")
  }
};

const accommodationFaqStructuredData = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "@id": `${toAbsoluteUrl("/sk/ubytovanie/")}#faq`,
  inLanguage: "sk-SK",
  mainEntity: accommodationFaqItems.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.answer
    }
  }))
};
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath="/sk/ubytovanie/"
  lang="sk"
  ogLocale="sk_SK"
  ogImage={accommodationsOgImage}
  ogImageAlt={accommodationsOgImageAlt}
  structuredData={[accommodationsStructuredData, accommodationFaqStructuredData]}
>
  <section class="dnd-accommodations-hero">
    <video
      class="dnd-accommodations-hero__video"
      autoplay
      muted
      loop
      playsinline
      webkit-playsinline
      preload="metadata"
      poster={accommodationsOgImage}
      disablepictureinpicture
      disableremoteplayback
      aria-hidden="true"
    >
      <source src={accommodationsHeroMobileVideo} media="(max-width: 640px)" type="video/mp4" />
      <source src={accommodationsHeroVideo} type="video/mp4" />
      Váš prehliadač nepodporuje prehrávanie videa na pozadí.
    </video>
    <div class="dnd-accommodations-hero__content">
      <div class="dnd-container dnd-accommodations-hero__inner">
        <div class="dnd-accommodations-hero__text">
          <p class="dnd-accommodations-hero__eyebrow">Ubytovanie</p>
          <h1 class="dnd-accommodations-hero__title">
            <span>Ubytovanie podľa oblasti</span>
            <span>a potrieb</span>
          </h1>
          <p class="dnd-accommodations-hero__lead">
            Svahy Kisapáti, breh Balatonu alebo tichá Káli-medence: tu uvidíte, ktorý dom Dandelion sa na čo hodí.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="dnd-accommodations-picker" aria-labelledby="ubytovanie-regions-title">
    <div class="dnd-container">
      <div class="dnd-accommodations-picker__intro">
        <p class="dnd-accommodations-picker__eyebrow">Výber oblasti</p>
        <h2 id="ubytovanie-regions-title">Kde sa chcete ubytovať?</h2>
        <p>
          Ak ešte nehľadáte konkrétny dom, začnite okolím: Szent György-hegy,
          breh Balatonu alebo Káli-medence.
        </p>
      </div>

      <div class="dnd-accommodations-picker__grid">
        {sections.map((section, regionIndex) => (
          <a class={`dnd-region-picker-card dnd-region-picker-card--${regionIndex + 1}`} href={`#${section.anchorId}`}>
            <span class="dnd-region-picker-card__top">
              <span class="dnd-region-picker-card__eyebrow">{section.eyebrow}</span>
              <span class="dnd-region-picker-card__icon" aria-hidden="true"></span>
            </span>
            <strong class="dnd-region-picker-card__title">{section.title}</strong>
            <span class="dnd-region-picker-card__text">{section.audienceText}</span>
            <span class="dnd-region-picker-card__cta">Zobraziť</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="dnd-accommodations-transition" aria-labelledby="ubytovanie-pool-title">
    <div class="dnd-container">
      <div class="dnd-accommodations-transition__panel">
        <picture class="dnd-accommodations-transition__media">
          <source srcset={accommodationsTransitionMobileImage} media="(max-width: 640px)" />
          <img
            src={accommodationsTransitionImage}
            alt={accommodationsTransitionImageAlt}
            title={accommodationsTransitionImageTitle}
            loading="lazy"
            width="1600"
            height="560"
          />
        </picture>
        <div class="dnd-accommodations-transition__content">
          <p class="dnd-accommodations-transition__eyebrow">Panorama Pool</p>
          <h2 id="ubytovanie-pool-title">Dni pri bazéne pod Szent György-hegy</h2>
        </div>
      </div>
    </div>
  </section>

  <section class="dnd-accommodations-qa" aria-labelledby="ubytovanie-qa-title">
    <div class="dnd-container">
      <div class="dnd-accommodations-qa__layout">
        <div class="dnd-accommodations-qa__intro">
          <p class="dnd-accommodations-qa__eyebrow">Rýchly výber</p>
          <h2 id="ubytovanie-qa-title">Ktoré ubytovanie Dandelion sa hodí na vašu cestu?</h2>
          <p>
            Ak nezačínate konkrétnym názvom domu, začnite otázkami hostí: počet osôb, oblasť,
            bazén, blízkosť Balatonu, výhľady alebo pokojnejšie okolie.
          </p>
          <a class="dnd-accommodations-qa__summary-link" href="#accommodations-list">
            Prejsť na zoznam ubytovania
          </a>
        </div>

        <div class="dnd-accommodations-qa__grid">
          {accommodationFaqItems.map((item) => (
            <article class="dnd-accommodations-qa__item">
              <h3>{item.question}</h3>
              <p>{item.answer}</p>
              <a href={item.href}>Súvisiace ubytovanie</a>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <div id="accommodations-list" class="dnd-apts-anchor">
    <div id="dnd-apts-final" lang="sk">
      <div class="dnd-wrap">
        {sections.map((section) => (
          <section id={section.anchorId} class="dnd-section dnd-region-block">
            <div class="dnd-region-block__header">
              <p class="dnd-eyebrow">{section.eyebrow}</p>
              <h2 class="dnd-h2">{section.title}</h2>
              <p class="dnd-sub">{section.subtitle}</p>
              <p class="dnd-region-block__audience">{section.audienceText}</p>
            </div>

            <div class={`dnd-grid ${section.gridClass}`}>
              {section.stays.map((stay) => {
                const primaryFacts = stay.facts.slice(0, 3);
                const secondaryFacts = stay.facts.slice(3, 6);
                const imageAlt = stay.imageAlt || `${stay.name} ubytovanie pri ${stay.location}`;

                const cardContent = (
                  <>
                    <div class="dnd-media">
                      {stay.image ? (
                        stay.image.astroSrc ? (
                          <Image
                            src={stay.image.astroSrc}
                            alt={imageAlt}
                            loading="lazy"
                          />
                        ) : (
                          <img
                            src={stay.image.sourceUrl}
                            alt={imageAlt}
                            width={stay.image.width || 1600}
                            height={stay.image.height || 1067}
                            loading="lazy"
                          />
                        )
                      ) : (
                        <div class="dnd-media-placeholder" aria-label={`${stay.name} fotografia čoskoro`}>
                          <span>{stay.name}</span>
                          <small>Fotografia čoskoro</small>
                        </div>
                      )}
                      <div class="dnd-overlay"></div>
                      <p class="dnd-hover-text">{stay.hoverText}</p>
                    </div>
                    <div class="dnd-info">
                      <div class="dnd-title-row">
                        <h3 class="dnd-title">{stay.name}</h3>
                        <span class="dnd-location">{stay.location}</span>
                      </div>
                      <div class="dnd-card-highlights" aria-label={`${stay.name} hlavné údaje`}>
                        {primaryFacts.map((fact) => (
                          <span class="dnd-chip dnd-chip--accent">{fact}</span>
                        ))}
                      </div>
                      <p class="dnd-description">{stay.description}</p>
                      <div class="dnd-chips" aria-label={`${stay.name} ďalšie údaje`}>
                        {secondaryFacts.map((fact) => (
                          <span class="dnd-chip dnd-chip--secondary">{fact}</span>
                        ))}
                      </div>
                      <span class="dnd-card-cta">Zobraziť detail</span>
                    </div>
                  </>
                );

                return (
                  <a class="dnd-card is-link" href={stay.href}>
                    {cardContent}
                  </a>
                );
              })}
            </div>
          </section>
        ))}
      </div>
    </div>
  </div>

  <section class="dnd-accommodations-closing" aria-labelledby="ubytovanie-closing-title">
    <div class="dnd-container">
      <div class="dnd-accommodations-closing__inner">
        <h2 id="ubytovanie-closing-title">Nie ste si istí, ktoré ubytovanie sa hodí najlepšie?</h2>
        <p>
          Napíšte nám, koľko hostí príde, kedy chcete cestovať a ktorá oblasť alebo vybavenie je pre vás dôležité.
          Pomôžeme vám zúžiť výber.
        </p>
        <div class="dnd-accommodations-closing__actions">
          <a class="dnd-accommodations-closing__cta" href={englishBookingHref} target="_blank" rel="noopener noreferrer">Overiť dostupnosť</a>
          <a class="dnd-accommodations-closing__cta dnd-accommodations-closing__cta--secondary" href="/sk/">
            Späť na úvod
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .dnd-accommodations-hero {
    position: relative;
    box-sizing: border-box;
    min-height: calc(600px + 118px);
    height: calc(84vh + 118px);
    padding-top: 118px;
    overflow: hidden;
    background: #171717;
  }

