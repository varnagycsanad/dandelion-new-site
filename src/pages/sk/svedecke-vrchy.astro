---
import CzechExperiencePage from "../../templates/CzechExperiencePage.astro";
import heroImage from "../../assets/experiences/tanuhegyek-drone-dji-20260512.jpg";
import supportImage from "../../assets/experiences/balaton-shore.jpg";
---

<CzechExperiencePage
  lang="sk"
  title="Svedecké vrchy a vyhliadky | Dandelion"
  description="Ľahké turistické nápady okolo Szent György-hegy, Badacsonyu, Csobáncu a Szigligetu pri domoch Dandelion."
  canonicalPath="/sk/svedecke-vrchy/"
  breadcrumbName="Svedecké vrchy"
  eyebrow="Príroda a výhľady"
  heading="Kopce, vyhliadky a tiché prechádzky okolo Balatonu."
  lead={[
    "Szent György-hegy, Badacsony, Csobánc, Gulács a Szigliget dávajú každému dňu inú náladu.",
    "Nemusí ísť o náročnú túru. Často stačí krátka cesta, výhľad a čas zostať chvíľu potichu."
  ]}
  heroImage={heroImage}
  heroAlt="Dronový pohľad na svedecké vrchy a Tapolcai-medence"
  supportImage={supportImage}
  supportAlt="Balaton ako kulisa výletu po svedeckých vrchoch"
  supportTitle="Vyberte kopec podľa energie dňa"
  supportText="Niektorý deň sa hodí Szent György-hegy, inokedy Szigliget s hradom alebo Badacsony s večernou atmosférou."
  highlights={["Szent György-hegy", "Badacsony a Szigliget", "krátke prechádzky aj dlhšie trasy", "západ slnka a výhľady"]}
  primaryLink={{ label: "Ubytovanie", href: "/sk/ubytovanie/" }}
  secondaryLink={{ label: "Zážitky", href: "/sk/zazitky/" }}
  sections={[
    {
      title: "Ktorý smer zvoliť",
      cards: [
        { title: "Szent György-hegy", body: "Najbližší a veľmi prírodný smer s vinicami, výhľadmi a pokojnejšími cestami." },
        { title: "Badacsony", body: "Silnejšia balatonská atmosféra, dobrá na výhľad, víno a večerný program." },
        { title: "Szigliget", body: "Hrad, prechádzka a voda v jednom dni. Dobre funguje aj s deťmi." }
      ]
    },
    {
      title: "Pre koho sa čo hodí",
      cards: [
        { title: "Rodiny", body: "Szigliget alebo kratšie trasy okolo Szent György-hegy sú jednoduchšia voľba." },
        { title: "Pár", body: "Západ slnka na kopci alebo večerný Badacsony dodá dňu mäkšiu atmosféru." },
        { title: "Pokoj v prírode", body: "Gulács alebo Csobánc môžu byť lepšie, ak chcete menej rušný smer." }
      ]
    }
  ]}
/>
