---
import CzechExperiencePage from "../../templates/CzechExperiencePage.astro";
import heroImage from "../../assets/experiences/balaton-shore.jpg";
import supportImage from "../../assets/experiences/szent-gyorgy-hegy-szolo.jpg";
---

<CzechExperiencePage
  lang="sk"
  title="Balaton pri domoch Dandelion | Pláže a letné programy"
  description="Pláže, prechádzky, Badacsony, Szigliget a ľahké vodné programy dostupné z domov Dandelion."
  canonicalPath="/sk/balaton/"
  breadcrumbName="Balaton"
  eyebrow="Dni pri vode"
  heading="Balaton ako ľahký letný program z pokojného domu."
  lead={[
    "Z domu Dandelion sa dá spojiť dopoludňajšie kúpanie, popoludňajšie víno na kopci a večerná prechádzka v Badacsonyi alebo Szigligete.",
    "Balaton tu nie je iba pláž. Je to voda, výhľady, jedlo, promenády a pomalé letné presuny."
  ]}
  heroImage={heroImage}
  heroAlt="Kamenistý breh Balatonu v letnom svetle"
  supportImage={supportImage}
  supportAlt="Vinice pri Balatone ako večerný program po dni pri vode"
  supportTitle="Ráno voda, večer kopec"
  supportText="Silnou stránkou regiónu je kombinácia: plážový deň nemusí byť oddelený od vína, výhľadu alebo krátkej prechádzky."
  highlights={["pláže v dosahu autom", "Badacsony a Szigliget", "kajak, kanoe alebo SUP podľa sezóny", "vhodné pre rodiny aj páry"]}
  primaryLink={{ label: "Ubytovanie", href: "/sk/ubytovanie/" }}
  secondaryLink={{ label: "Zážitky", href: "/sk/zazitky/" }}
  sections={[
    {
      title: "Plážové smery",
      cards: [
        { title: "Szigliget a Ábrahámhegy", body: "Pohodlné smery na pokojnejší rodinný plážový deň." },
        { title: "Badacsony", body: "Dobrý smer, ak chcete vodu spojiť s večerou, vínom alebo večernou prechádzkou." },
        { title: "Badacsonylábdihegy", body: "Praktický východiskový bod na kúpanie a ľahké vodné programy." }
      ]
    },
    {
      title: "Ako vyskladať deň",
      cards: [
        { title: "S deťmi", body: "Zvoľte pláž s jednoduchším prístupom a nechajte si čas na prestávky." },
        { title: "Romantický večer", body: "Badacsony alebo Szigliget dobre fungujú na večernú prechádzku a jedlo." },
        { title: "Aktívna voda", body: "Kajak, kanoe alebo SUP plánujte podľa aktuálnej ponuky a počasia." }
      ]
    }
  ]}
/>
