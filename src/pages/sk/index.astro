---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Hero from "../../sections/Hero.astro";
import PanoramaPoolHighlight from "../../sections/PanoramaPoolHighlight.astro";
import HomeReviews from "../../sections/HomeReviews.astro";
import HomeRegionGuide from "../../sections/HomeRegionGuide.astro";
import RegionStories from "../../sections/RegionStories.astro";
import Experiences from "../../sections/Experiences.astro";
import NewsletterSignup from "../../sections/NewsletterSignup.astro";
import GoogleRegionMap from "../../sections/GoogleRegionMap.astro";
import HomeGeoFaq from "../../sections/HomeGeoFaq.astro";
import bikingImage from "../../assets/home/experiences/dandelion-home-experience-bike-01-mobile-optimized.webp";
import wineTourImage from "../../assets/home/experiences/dandelion-home-experience-wine-gastro-01-optimized.webp";
import balatonImage from "../../assets/home/experiences/dandelion-home-experience-balaton-01.webp";
import mountainsImage from "../../assets/home/experiences/dandelion-home-experience-tanuhegyek-01.webp";
import kisapatiStoryImage from "../../assets/home/region-stories/dandelion-home-tanuhegyek-story-01.webp";
import balatonStoryImage from "../../assets/home/region-stories/dandelion-home-balaton-story-02.webp";
import kaliStoryImage from "../../assets/accommodations/koveskal/gallery/dandelion-koveskal-source-001.webp";
import { buildVideoObject } from "../../data/video-seo";
import { buildHomeGeoFaqStructuredData } from "../../data/home-geo-faq";

const skTitle = "Dandelion ubytovanie | Pokojné pobyty pri Balatone";
const skDescription =
  "Pokojné penzióny a apartmány v Balatonskej vrchovine, pri Szent György-hegy, Badacsonyi, Keszthelyi a v oblasti Káli.";
const englishBookingHref = "https://ibe.sabeeapp.com/v3/p/Dandelion-Vendégházak?p=3970b30e1042d58f&lang=En";

const homepageHeroVideo = "/videos/fooldal/hero/DND_Fooldal_hero_05-21.mp4?v=20260521";
const homepageHeroMobileVideo = "/videos/fooldal/hero/DND_Fooldal_hero_05-21-mobile-lite.mp4?v=20260606-mobile-lite";
const homepageHeroPoster = kisapatiStoryImage.src;
const homepageVideoStructuredData = buildVideoObject({
  id: "/sk/#homepage-hero-video",
  name: "Dandelion ubytovanie úvodné video",
  description: "Úvodné video ubytovania Dandelion v okolí Balatonu.",
  contentUrl: homepageHeroVideo,
  thumbnailUrl: homepageHeroPoster,
  uploadDate: "2026-05-21T00:00:00+02:00",
  inLanguage: "sk-SK"
});
const homepageStructuredData = [homepageVideoStructuredData, buildHomeGeoFaqStructuredData("sk")];

const slovakRegionStories = [
  {
    kicker: "Kisapáti - Szent György-hegy - Tapolcai-medence",
    title: "Medzi svedeckými vrchmi",
    description: "Vinice, tiché cesty a pomalé rána určujú túto časť Balatonskej vrchoviny.",
    meta: "Pokojná základňa pri Szent György-hegy.",
    ctaLabel: "Zobraziť ubytovanie pri vrchoch",
    mobileCtaLabel: "Pri vrchoch",
    ctaHref: "/sk/ubytovanie/#balaton-uplands",
    image: kisapatiStoryImage,
    imageAlt: "Kisapáti a svedecké vrchy v Balatonskej vrchovine"
  },
  {
    kicker: "Keszthely - Badacsonyörs - Balaton",
    title: "Blízko jazera",
    description: "Ľahké dni pri Balatone, prístavné mestá a letné večery s pokojným rytmom Dandelion.",
    meta: "Pre hostí, ktorí chcú mať Balaton nablízku.",
    ctaLabel: "Zobraziť ubytovanie pri Balatone",
    mobileCtaLabel: "Pri Balatone",
    ctaHref: "/sk/ubytovanie/#near-lake-balaton",
    image: balatonStoryImage,
    imageAlt: "Ubytovanie Dandelion v blízkosti Balatonu"
  },
  {
    kicker: "Köveskál - oblasť Káli",
    title: "Tichšia strana oblasti Káli",
    description: "Kamenné múry, dedinské ulice a jemnejšie tempo pre pokojnejšie dni.",
    meta: "Dobré na pomalé dni, vinárske cesty a prechádzky dedinou.",
    ctaLabel: "Ubytovanie v oblasti Káli",
    mobileCtaLabel: "Oblasť Káli",
    ctaHref: "/sk/ubytovanie/#kali-medence",
    image: kaliStoryImage,
    imageAlt: "Krajina oblasti Káli pri Köveskáli"
  }
];

const slovakExperiences = [
  {
    title: "BICYKLE",
    description: "Dedinské cesty, vinice a mierne kopce na ľahké výlety.",
    image: bikingImage,
    imageAlt: "Cyklotrasa v Balatonskej vrchovine",
    href: "/sk/zazitky/"
  },
  {
    title: "VÍNO A GASTRONÓMIA",
    description: "Pivnice, terasy a malé zastávky okolo vrchov.",
    image: wineTourImage,
    imageAlt: "Víno a gastronómia v Balatonskej vrchovine",
    href: "/sk/zazitky/"
  },
  {
    title: "BALATON",
    description: "Pláže, pobrežie a jednoduché letné programy nablízku.",
    image: balatonImage,
    imageAlt: "Badacsony a panoráma Balatonu",
    href: "/sk/zazitky/"
  },
  {
    title: "SVEDECKÉ VRCHY",
    description: "Vyhliadky a trasy okolo Szent György-hegy a Badacsonyu.",
    image: mountainsImage,
    imageAlt: "Svedecké vrchy v Balatonskej vrchovine",
    href: "/sk/zazitky/"
  }
];
---

<BaseLayout
  title={skTitle}
  description={skDescription}
  canonicalPath="/sk/"
  lang="sk"
  ogLocale="sk_SK"
  structuredData={homepageStructuredData}
>
  <Hero
    titleTopLines={["Pokojné", "ubytovanie"]}
    titleBottomLines={["pri", "Balatone"]}
    description="Prírodné penzióny a apartmány v Balatonskej vrchovine, pri Szent György-hegy a Badacsonyi."
    ctas={[
      { label: "Zobraziť ubytovanie", href: "/sk/ubytovanie/" },
      { label: "Overiť dostupnosť", href: englishBookingHref, target: "_blank", rel: "noopener noreferrer" }
    ]}
    videoDesktopSrc={homepageHeroVideo}
    videoMobileSrc={homepageHeroMobileVideo}
    posterSrc={homepageHeroPoster}
    posterAlt="Kisapáti a svedecké vrchy v Balatonskej vrchovine"
    videoFallbackText="Váš prehliadač nepodporuje prehrávanie videa na pozadí."
  />

  <PanoramaPoolHighlight lang="sk" />
  <HomeReviews lang="sk" />
  <HomeRegionGuide lang="sk" />

  <RegionStories
    kickerLabel="Ubytovanie"
    heading="Jedna nálada Dandelion, tri krajiny"
    lead="Vyberte si medzi svedeckými vrchmi, dňami pri Balatone a tichšími dedinami oblasti Káli."
    stickyBackgroundAlt="Východ slnka nad Szent György-hegy a Tapolcai-medence"
    stories={slovakRegionStories}
  />

  <Experiences
    sectionId="experiences"
    title="ZÁŽITKY"
    lead="Bicykle, víno, Balaton a prechádzky po vrchoch v ľahkom rytme regiónu."
    ctaLabel="NAPLÁNOVAŤ POBYT"
    ctaHref="/sk/zazitky/"
    mobileCtaLabel="VIAC"
    experiences={slovakExperiences}
  />

  <NewsletterSignup lang="sk" />
  <HomeGeoFaq lang="sk" />
  <GoogleRegionMap lang="sk" />
</BaseLayout>
