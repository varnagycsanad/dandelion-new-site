---
// [CHANGE 2026-06-06 00:00] Kisapáti medencés szállás landing page added for D1, D2 and Fügeház.
import BaseLayout from "../layouts/BaseLayout.astro";
import { d1PageData } from "../data/accommodation-pages/d1";
import { d2PageData } from "../data/accommodation-pages/d2";
import { fugehazPageData } from "../data/accommodation-pages/fugehaz";
import { panoramaPoolHero, panoramaPoolImages } from "../data/images/panorama-pool-images";
import { requireAccommodationLocalAssetPath } from "../data/images/astro-local-assets";
import { SITE_NAME, toAbsoluteUrl } from "../data/site-seo";

const bookingHref = "https://ibe.sabeeapp.com/v3/p/Dandelion-Vendégházak?p=3970b30e1042d58f&lang=Hu";
const pagePath = "/kisapati-medences-szallas/";
const heroImage = panoramaPoolImages.find((image) => image.usageHint === "hero") ?? panoramaPoolImages[0];
const teaserImages = panoramaPoolImages
  .filter((image) => image.usageHint === "teaser")
  .sort((a, b) => a.sortOrder - b.sortOrder)
  .slice(0, 3);

const stays = [
  {
    name: "Dandelion D1",
    href: "/dandelion-d1/",
    bookingHref: d1PageData.bookingLink,
    image: d1PageData.hero.mobileImagePath,
    imageAlt: d1PageData.hero.fallbackAlt,
    label: "akár 8 fő",
    title: "Tágas ház nagyobb családoknak és baráti társaságoknak",
    text:
      "A D1 akkor jó választás, ha több hálószobára, kényelmes közös terekre és nyári medencehasználatra is szükségetek van.",
    facts: ["3 hálószoba", "2 fürdőszoba", "Panorama Pool használat"]
  },
  {
    name: "Dandelion D2",
    href: "/dandelion-d2/",
    bookingHref: d2PageData.bookingLink,
    image: requireAccommodationLocalAssetPath(
      "d2",
      "card",
      "dandelion-d2-kisapati-card-01.webp",
      "kisapati pool landing D2 card image"
    ),
    imageAlt: "Dandelion D2 fedett terasza sárga székekkel és kertkapcsolattal Kisapátiban",
    label: "4-6 fő",
    title: "Családbarát vendégház nagy kerttel és fedett terasszal",
    text:
      "A D2 családoknak és kisebb társaságoknak kényelmes: nagy udvar, fedett terasz és szezonban Panorama Pool használat tartozik hozzá.",
    facts: ["nagy kert", "fedett terasz", "Panorama Pool használat"]
  },
  {
    name: "Dandelion Fügeház",
    href: "/fuge/",
    bookingHref: fugehazPageData.bookingLink,
    image: fugehazPageData.hero.mobileImagePath,
    imageAlt: fugehazPageData.hero.fallbackAlt,
    label: "4 fő, pótággyal bővíthető",
    title: "Panorámás, teraszos pihenés a tanúhegyek közelében",
    text:
      "A Fügeház csendesebb, teraszos pihenéshez illik. Nyáron a Panorama Pool ad hozzá egy kényelmes medencés lehetőséget.",
    facts: ["teraszos pihenés", "panoráma", "Panorama Pool használat"]
  }
];

const audienceItems = [
  {
    title: "Nagyobb családoknak vagy baráti társaságnak",
    answer: "A D1 a legerősebb választás, ha 6-8 főre, több hálóra és nagyobb közös terekre van szükségetek."
  },
  {
    title: "4-6 fős családos pihenéshez",
    answer: "A D2 a legkényelmesebb, ha fontos a nagy kert, a fedett terasz és a családbarát, nyugodt ritmus."
  },
  {
    title: "Csendesebb, panorámás kikapcsolódáshoz",
    answer: "A Fügeház akkor jó, ha intimebb házat, teraszos estét és tanúhegyes kilátást kerestek."
  }
];

const quickAnswerItems = [
  {
    question: "Hol érdemes megszállni Kisapátiban?",
    answer:
      "Kisapátiban a D1, a D2 és a Fügeház jó választás, ha a Szent György-hegy közelében, nyugodt környezetben és medencehasználattal keresnétek szállást."
  },
  {
    question: "Van medencés szállás Kisapátiban?",
    answer:
      "Igen. A Dandelion D1, D2 és Fügeház vendégei a szezonban használhatják a Panorama Pool medencét."
  },
  {
    question: "Melyik ház jó családoknak?",
    answer:
      "A D2 általában a legjobb első választás családoknak, a D1 pedig akkor jobb, ha nagyobb családdal vagy több generációval érkeztek."
  },
  {
    question: "Melyik ház a legjobb panorámához?",
    answer:
      "A Fügeház a legerősebb panorámás, teraszos hangulatban, de a D1 teraszáról is szép rálátás nyílik a környező tanúhegyekre."
  },
  {
    question: "Miért jó Kisapátiban megszállni?",
    answer:
      "Kisapáti jó bázis a Szent György-hegyhez, a Tapolcai-medencéhez, Badacsonyhoz és a balatoni programokhoz, miközben nyugodtabb, kevésbé zsúfolt környezetet ad."
  },
  {
    question: "Melyik házat válasszam Kisapátiban?",
    answer:
      "Ha sokan jöttök, D1. Ha családos, kertes pihenést kerestek, D2. Ha csendesebb, intimebb, panorámás házat szeretnétek, Fügeház."
  }
];

const comparisonRows = [
  {
    label: "Kinek a legjobb",
    d1: "nagyobb családoknak, baráti társaságoknak",
    d2: "családoknak, 4-6 fős pihenéshez",
    fugehaz: "pároknak, kisebb családoknak, nyugodtabb kikapcsolódáshoz"
  },
  {
    label: "Férőhely",
    d1: "akár 8 fő",
    d2: "4-6 fő",
    fugehaz: "4 fő, pótággyal akár 6 fő"
  },
  {
    label: "Fő hangulat",
    d1: "tágas, közösségi, panorámás",
    d2: "kertes, családias, kényelmes",
    fugehaz: "teraszos, intimebb, panorámás"
  },
  {
    label: "Erős pont",
    d1: "3 háló + 2 fürdő",
    d2: "nagy kert + fedett terasz",
    fugehaz: "panorámás teraszok + csendes ritmus"
  },
  {
    label: "Medencekapcsolat",
    d1: "Panorama Pool",
    d2: "Panorama Pool",
    fugehaz: "Panorama Pool"
  }
];

const reasonsToStayItems = [
  "A Szent György-hegy és a tanúhegyek programjai közel vannak.",
  "A Balaton, Badacsony és Tapolca rövid autóúttal elérhető.",
  "Nyugodtabb a ritmusa, mint a forgalmasabb balatoni településeknek.",
  "A D1, D2 és Fügeház között különböző utazástípusokra is van jó opció."
];

const faqItems = [
  {
    question: "Hol érdemes megszállni Kisapátiban?",
    answer:
      "Ha medencés kisapáti szállást kerestek, a Dandelion D1, D2 és Fügeház a három fő opció. A választásnál a létszám, a kertigény és a kívánt hangulat dönt leginkább."
  },
  {
    question: "Van medencés szállás Kisapátiban?",
    answer:
      "Igen. A D1, D2 és Fügeház vendégei a szezonban használhatják a Panorama Pool medencét Kisapátiban."
  },
  {
    question: "Melyik Dandelion házak kapcsolódnak a Panorama Poolhoz?",
    answer:
      "A Dandelion D1, a Dandelion D2 és a Dandelion Fügeház vendégei számára érhető el a Panorama Pool a szezonban."
  },
  {
    question: "Hol vannak ezek a medencés szállások?",
    answer:
      "A három ház Kisapátiban, a Szent György-hegy lábánál található, a Balaton-felvidék nyugodtabb részén."
  },
  {
    question: "Saját medencéje van a házaknak?",
    answer:
      "Nem, a házaknak nincs külön saját medencéjük. A D1, D2 és Fügeház vendégei a házak melletti dombon található medencét használhatják, ahonnan a tanúhegyek látszanak."
  },
  {
    question: "Mikortól használható a medence?",
    answer:
      "A medencét a D1, D2 és Fügeház vendégei a tervek szerint 2026. június 15. után használhatják."
  },
  {
    question: "Milyen mély a medence?",
    answer:
      "A medence körülbelül 130 cm mély, ezért gyerekekkel is kényelmesen használható, szülői felügyelet mellett."
  },
  {
    question: "Vannak gyerekjátékok a medencénél?",
    answer:
      "Igen, a medencénél vannak gyerekjátékok is, így gyerekekkel is könnyebb eltölteni ott az időt."
  },
  {
    question: "Melyik ház jó nagyobb társaságnak?",
    answer:
      "Nagyobb családnak vagy baráti társaságnak elsőként a D1-et érdemes megnézni, mert ez a legtágasabb a három ház közül."
  },
  {
    question: "Melyik ház jó családoknak?",
    answer:
      "Családoknak általában a D2 a legkényelmesebb első választás. Nagyobb családnál vagy több generáció együtt utazásánál a D1 is erős opció."
  },
  {
    question: "Melyik ház a legjobb panorámához?",
    answer:
      "A Fügeház a leginkább panorámás, teraszos hangulatú ház, míg a D1 is jó választás, ha a kilátás mellé több belső tér is fontos."
  },
  {
    question: "4 fős családnak melyik ház jó?",
    answer:
      "4 fős családnak a D1 és a D2 is jó választás. A D2 kényelmesebb, kertközelibb családi pihenéshez, a D1 akkor erős, ha több térre van szükségetek."
  }
];

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Főoldal",
        item: toAbsoluteUrl("/")
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Kisapáti medencés szállás",
        item: toAbsoluteUrl(pagePath)
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "@id": `${toAbsoluteUrl(pagePath)}#collection`,
    name: "Kisapáti medencés szállás Dandelion házakban",
    url: toAbsoluteUrl(pagePath),
    inLanguage: "hu-HU",
    description:
      "Dandelion D1, D2 és Fügeház Kisapátiban, Panorama Pool használattal a nyári pihenéshez.",
    isPartOf: {
      "@id": `${toAbsoluteUrl("/")}#website`
    },
    about: ["Kisapáti szállás", "medencés szállás", "Panorama Pool", "Szent György-hegy"],
    provider: {
      "@type": "LodgingBusiness",
      name: SITE_NAME,
      url: toAbsoluteUrl("/")
    },
    mainEntity: {
      "@type": "ItemList",
      itemListElement: stays.map((stay, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: stay.name,
        url: toAbsoluteUrl(stay.href)
      }))
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "@id": `${toAbsoluteUrl(pagePath)}#faq`,
    inLanguage: "hu-HU",
    mainEntity: faqItems.map((item) => ({
      "@type": "Question",
      name: item.question,
      acceptedAnswer: {
        "@type": "Answer",
        text: item.answer
      }
    }))
  }
];
---

<BaseLayout
  title="Kisapáti szállás medencével | D1, D2 és Fügeház | Dandelion"
  description="Kisapáti szállás medencével a Szent György-hegy közelében: hasonlítsd össze a D1, D2 és Fügeház házakat, és nézd meg, melyik jó családoknak, panorámához vagy nyári medencés pihenéshez."
  canonicalPath={pagePath}
  ogImage={panoramaPoolHero.desktop}
  ogImageAlt={heroImage.altHu}
  structuredData={structuredData}
  headerMode="transparent"
>
  <div class="pool-landing">
    <section class="pool-landing-hero">
      <picture>
        <source media="(max-width: 767px)" srcset={panoramaPoolHero.mobile} />
        <img
          class="pool-landing-hero__image"
          src={panoramaPoolHero.desktop}
          alt={heroImage.altHu}
          width="1920"
          height="1280"
          decoding="async"
          fetchpriority="high"
        />
      </picture>
      <div class="pool-landing-hero__overlay" aria-hidden="true"></div>
      <div class="pool-landing-hero__content">
        <div class="dnd-container pool-landing-hero__inner">
          <p class="pool-landing__eyebrow">Kisapáti - Szent György-hegy - Panorama Pool</p>
          <h1>Kisapáti szállás medencével, D1, D2 és Fügeház összehasonlítással</h1>
          <p>
            Medencés szállás Kisapátiban a Szent György-hegy közelében: itt gyorsan átlátjátok,
            melyik ház jó nagyobb társaságnak, melyik családoknak, és melyik a legjobb panorámás,
            csendes pihenéshez.
          </p>
          <div class="pool-landing-hero__actions">
            <a href="#hazak" class="pool-landing__button pool-landing__button--primary">Házak megnézése</a>
            <a href={bookingHref} class="pool-landing__button pool-landing__button--secondary" target="_blank" rel="noopener noreferrer">
              Foglalás / árak
            </a>
          </div>
        </div>
      </div>
    </section>

    <section class="pool-landing-intro">
      <div class="dnd-container pool-landing-intro__layout">
        <div>
          <p class="pool-landing__eyebrow">Mikor jó választás?</p>
          <h2>Ha kisapáti szállást kerestek, és a medence, a környék meg a háztípus is fontos.</h2>
        </div>
        <div class="pool-landing-intro__text">
          <p>
            Ez az oldal a Dandelion három kisapáti, Panorama Poolhoz kapcsolódó házát fogja össze.
            Nem külön privát medencékről van szó: a D1, D2 és Fügeház vendégei a közös Panorama Poolt
            használhatják a szezonban, a házak melletti dombon.
          </p>
          <p>
            A három ház három eltérő igényre válaszol: a D1 nagyobb társaságoknak jó, a D2
            családbarátabb, a Fügeház pedig panorámásabb és csendesebb. Ezért itt nem csak házakat,
            hanem döntési rövidítést is kaptok.
          </p>
        </div>
      </div>
    </section>

    <section class="pool-landing-audience" aria-labelledby="kinek-valo-cim">
      <div class="dnd-container">
        <div class="pool-landing-section-head">
          <p class="pool-landing__eyebrow">Kinek való?</p>
          <h2 id="kinek-valo-cim">Gyors döntés: melyik kisapáti ház milyen utazáshoz jó?</h2>
          <p>Ez az a blokk, amit 30 másodperc alatt át lehet futni, ha csak a lényeg érdekel.</p>
        </div>
        <div class="pool-landing-audience__grid">
          {audienceItems.map((item) => (
            <article>
              <h3>{item.title}</h3>
              <p>{item.answer}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="pool-landing-facts" aria-label="Kisapáti medencés szállás gyors áttekintő">
      <div class="dnd-container pool-landing-facts__grid">
        <article>
          <span>01</span>
          <h2>D1, D2 és Fügeház</h2>
          <p>Három külön ház, eltérő mérettel és hangulattal, közös nyári medencehasználati lehetőséggel.</p>
        </article>
        <article>
          <span>02</span>
          <h2>Panorama Pool</h2>
          <p>A házak melletti dombon található medence, ahonnan a tanúhegyek látszanak.</p>
        </article>
        <article>
          <span>03</span>
          <h2>Kisapáti bázis</h2>
          <p>Szent György-hegy, Tapolcai-medence, borászatok és balatoni programok rövid autóútra.</p>
        </article>
      </div>
    </section>

    <section class="pool-landing-answers" aria-labelledby="gyors-valaszok-cim">
      <div class="dnd-container">
        <div class="pool-landing-section-head">
          <p class="pool-landing__eyebrow">GEO válaszblokkok</p>
          <h2 id="gyors-valaszok-cim">Rövid válaszok a legfontosabb kisapáti szállás kérdésekre</h2>
          <p>Olyan egyértelmű válaszok, amikből Google AI, ChatGPT vagy Perplexity is könnyebben tud idézni.</p>
        </div>
        <div class="pool-landing-answers__grid">
          {quickAnswerItems.map((item) => (
            <article>
              <h3>{item.question}</h3>
              <p>{item.answer}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="hazak" class="pool-landing-stays">
      <div class="dnd-container">
        <div class="pool-landing-section-head">
          <p class="pool-landing__eyebrow">A három ház</p>
          <h2>Melyik Dandelion ház illik hozzátok?</h2>
          <p>Érdemes létszám és hangulat alapján választani: nagyobb társaság, családos pihenés vagy csendesebb teraszos napok.</p>
        </div>

        <div class="pool-landing-stays__grid">
          {stays.map((stay) => (
            <article class="pool-landing-stay-card">
              <a href={stay.href} class="pool-landing-stay-card__media" aria-label={`${stay.name} oldal megnyitása`}>
                <img src={stay.image} alt={stay.imageAlt} loading="lazy" decoding="async" width="1200" height="900" />
              </a>
              <div class="pool-landing-stay-card__body">
                <span>{stay.label}</span>
                <h3>{stay.name}</h3>
                <h4>{stay.title}</h4>
                <p>{stay.text}</p>
                <ul aria-label={`${stay.name} fő jellemzői`}>
                  {stay.facts.map((fact) => (
                    <li>{fact}</li>
                  ))}
                </ul>
                <div class="pool-landing-stay-card__actions">
                  <a href={stay.href}>Részletek</a>
                  <a href={stay.bookingHref} target="_blank" rel="noopener noreferrer">Foglalás</a>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="pool-landing-compare" aria-labelledby="haz-osszehasonlitas-cim">
      <div class="dnd-container">
        <div class="pool-landing-section-head">
          <p class="pool-landing__eyebrow">Melyik házat válasszam Kisapátiban?</p>
          <h2 id="haz-osszehasonlitas-cim">D1, D2 és Fügeház összehasonlítása egy helyen</h2>
          <p>Ha gyorsan szeretnétek dönteni, ez a táblázat mutatja meg a három ház közötti fő különbségeket.</p>
        </div>
        <div class="pool-landing-compare__table-wrap">
          <table class="pool-landing-compare__table">
            <thead>
              <tr>
                <th>Szempont</th>
                <th>D1</th>
                <th>D2</th>
                <th>Fügeház</th>
              </tr>
            </thead>
            <tbody>
              {comparisonRows.map((row) => (
                <tr>
                  <th>{row.label}</th>
                  <td>{row.d1}</td>
                  <td>{row.d2}</td>
                  <td>{row.fugehaz}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section class="pool-landing-pool">
      <div class="dnd-container pool-landing-pool__layout">
        <div class="pool-landing-pool__copy">
          <p class="pool-landing__eyebrow">Panorama Pool</p>
          <h2>Medencés nyári pihenés panorámával.</h2>
          <p>
            A Panorama Pool a házak melletti dombon helyezkedik el, és a D1, D2, valamint Fügeház
            vendégei számára érhető el a szezonban. A medencétől a tanúhegyek látszanak, a kilátás
            és a napozóterasz adja a nyári pihenés hangulatát.
          </p>
          <a class="pool-landing__text-link" href="/panorama-pool/">Panorama Pool oldal megnyitása</a>
        </div>
        <div class="pool-landing-pool__gallery" aria-label="Panorama Pool képek">
          {teaserImages.map((image) => (
            <figure>
              <picture>
                {image.mobileSrc && <source media="(max-width: 767px)" srcset={image.mobileSrc} />}
                <img src={image.src} alt={image.altHu} loading="lazy" decoding="async" width="1200" height="900" />
              </picture>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <section class="pool-landing-reasons" aria-labelledby="miert-jo-kisapatiban-cim">
      <div class="dnd-container pool-landing-reasons__layout">
        <div>
          <p class="pool-landing__eyebrow">Miért jó Kisapátiban megszállni?</p>
          <h2 id="miert-jo-kisapatiban-cim">Nyugodtabb balatoni bázis, erős kirándulós környékkel</h2>
        </div>
        <div class="pool-landing-reasons__grid">
          {reasonsToStayItems.map((item) => (
            <article>
              <p>{item}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="faq" class="pool-landing-faq">
      <div class="dnd-container pool-landing-faq__layout">
        <div class="pool-landing-faq__intro">
          <p class="pool-landing__eyebrow">Gyors válaszok</p>
          <h2>Gyakori kérdések a kisapáti medencés szállásokról</h2>
          <p>Rövid válaszok a D1, D2, Fügeház és Panorama Pool kapcsolatáról.</p>
        </div>
        <div class="pool-landing-faq__grid">
