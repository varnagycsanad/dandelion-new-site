---
import { fugehazDezsaGuide } from "../../../data/guides/fugehaz-dezsa";
import { fugehazPoolGuide } from "../../../data/guides/panorama-pool";
import GuideHouseIndexPage from "../../../templates/GuideHouseIndexPage.astro";

const title = "Fügeház vendégútmutató | Dandelion";
const description = "QR-kóddal megnyitható Fügeház vendégútmutató a helyszíni használati információkhoz.";
---

<GuideHouseIndexPage
  houseName="Fügeház"
  canonicalPath="/guide/fugehaz/"
  title={title}
  description={description}
  introHu="Válaszd ki, melyik helyszíni használati útmutatót szeretnéd megnyitni."
  introEn="Choose the on-site user guide you would like to open."
  introCs="Vyberte, kterého místního průvodce chcete otevřít."
  introDe="Wählen Sie den Guide aus, den Sie vor Ort öffnen möchten."
  items={[
    {
      guide: fugehazDezsaGuide,
      titleHu: "Dézsafürdő használati útmutató",
      titleEn: "Wood-Fired Hot Tub User Guide",
      titleCs: "Návod k používání dřevem vytápěné kádě",
      titleDe: "Guide für den holzbefeuerten Badezuber",
      descriptionHu: "Begyújtás, felfűtés, vízhőfok és vízforgató.",
      descriptionEn: "Lighting, heating, water temperature and circulation.",
      descriptionCs: "Zatopení, ohřev, teplota vody a cirkulace.",
      descriptionDe: "Anfeuern, Aufheizen, Wassertemperatur und Umwälzung."
    },
    {
      guide: fugehazPoolGuide,
      titleHu: "Medencehasználati útmutató",
      titleEn: "Pool User Guide",
      titleCs: "Návod k používání bazénu",
      titleDe: "Poolnutzungs-Guide",
      descriptionHu: "Biztonság, higiénia, gyermekfelügyelet és közös használat.",
      descriptionEn: "Safety, hygiene, child supervision and shared use.",
      descriptionCs: "Bezpečnost, hygiena, dohled nad dětmi a společné používání.",
      descriptionDe: "Sicherheit, Hygiene, Kinderaufsicht und gemeinsame Nutzung."
    }
  ]}
/>
