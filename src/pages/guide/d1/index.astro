---
import { d1AszfGuide } from "../../../data/guides/d1-aszf";
import { d1PoolGuide } from "../../../data/guides/panorama-pool";
import { requireAccommodationLocalAssetPath } from "../../../data/images/astro-local-assets";
import GuideHouseIndexPage from "../../../templates/GuideHouseIndexPage.astro";

// [CHANGE 2026-05-24 00:00] D1 QR guide index letrehozva medencehasznalati guide linkkel.
// [CHANGE 2026-06-22 21:20] D1 hasznalati es ASZF guide link hozzaadva a guide indexhez.
const d1GuideHeroSrc = requireAccommodationLocalAssetPath(
  "d1",
  "hero",
  "dandelion-d1-hero-desktop-01.webp",
  "D1 guide hero"
);
---

<GuideHouseIndexPage
  houseName="Dandelion D1"
  canonicalPath="/guide/d1/"
  title="Dandelion D1 vendégútmutató | Dandelion"
  description="QR-kóddal megnyitható Dandelion D1 vendégútmutató a helyszíni használati információkhoz."
  introHu="Válaszd ki, melyik helyszíni használati útmutatót szeretnéd megnyitni."
  introEn="Choose the on-site user guide you would like to open."
  introCs="Vyberte, kterého místního průvodce chcete otevřít."
  introDe="W\u00e4hlen Sie den Guide aus, den Sie vor Ort \u00f6ffnen m\u00f6chten."
  introSk="Vyber si, ktorý miestny návod chceš otvoriť."
  heroImageSrc={d1GuideHeroSrc}
  heroImageAlt="Dandelion D1 panorámás hero képe"
  items={[
    {
      guide: d1AszfGuide,
      titleHu: "ÁSZF és használati szabályok",
      titleEn: "Terms and House Rules",
      titleCs: "Obchodní podmínky a pravidla",
      titleDe: "AGB und Nutzungsregeln",
      titleSk: "Obchodné podmienky a pravidlá",
      descriptionHu: "Foglalás, fizetés, érkezés, házirend, kisállat és D1-et érintő használati feltételek.",
      descriptionEn: "Booking, payment, arrival, house rules, pets and D1 stay conditions.",
      descriptionCs: "Rezervace, platba, příjezd, pravidla domu, domácí mazlíčci a podmínky pobytu D1.",
      descriptionDe: "Buchung, Zahlung, Anreise, Hausregeln, Haustiere und Bedingungen für D1.",
      descriptionSk: "Rezervácia, platba, príchod, domové pravidlá, domáce zvieratá a podmienky pobytu pre D1."
    },
    {
      guide: d1PoolGuide,
      titleHu: "Medencehasználati útmutató",
      titleEn: "Pool User Guide",
      titleCs: "Návod k používání bazénu",
      titleDe: "Poolnutzungs-Guide",
      titleSk: "Návod na používanie bazéna",
      descriptionHu: "Biztonság, higiénia, gyermekfelügyelet és közös használat.",
      descriptionEn: "Safety, hygiene, child supervision and pool access.",
      descriptionCs: "Bezpečnost, hygiena, dohled nad dětmi a přístup k bazénu.",
      descriptionDe: "Sicherheit, Hygiene, Kinderaufsicht und Poolzugang.",
      descriptionSk: "Bezpečnosť, hygiena, dohľad nad deťmi a spoločné používanie bazéna."
    }
  ]}
/>
