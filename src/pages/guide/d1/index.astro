---
import {
  d1GuideEnabledLocales,
  d1GuideIndexGroups,
  d1GuideIndexItems,
  d1GuideQuickInfoItems
} from "../../../data/guides/d1-guide-registry";
import { requireAccommodationLocalAssetPath } from "../../../data/images/astro-local-assets";
import GuideHouseIndexPage from "../../../templates/GuideHouseIndexPage.astro";

// [CHANGE 2026-05-24 00:00] D1 QR guide index letrehozva medencehasznalati guide linkkel.
// [CHANGE 2026-06-22 21:20] D1 hasznalati es ASZF guide link hozzaadva a guide indexhez.
// [CHANGE 2026-06-22 22:40] D1 teljes vendegutmutato kezdooldal szerkezet es placeholder aloldalak elokeszitve.
const d1GuideHeroSrc = requireAccommodationLocalAssetPath(
  "d1",
  "hero",
  "dandelion-d1-hero-desktop-01.webp",
  "D1 guide hero"
);
---

<GuideHouseIndexPage
  houseName="Dandelion D1"
  canonicalPath="/guide/d1/"
  title="Dandelion D1 vendégútmutató | Dandelion"
  description="QR-kóddal megnyitható Dandelion D1 vendégútmutató a helyszíni használati információkhoz."
  introHu="Itt találod a D1 ház használatához szükséges legfontosabb információkat: Wi-Fi, érkezés, gépek, klíma, melegvíz, medence és házirend."
  introEn="Here you will find the most important D1 house-use information: Wi-Fi, arrival, appliances, AC, hot water, pool and house rules."
  introCs="Zde najdete nejdůležitější informace k používání domu D1: Wi-Fi, příjezd, spotřebiče, klimatizace, teplá voda, bazén a pravidla domu."
  introDe="Hier finden Sie die wichtigsten Informationen zur Nutzung des D1-Hauses: WLAN, Anreise, Geräte, Klima, Warmwasser, Pool und Hausregeln."
  introSk="Tu nájdeš najdôležitejšie informácie k používaniu domu D1: Wi‑Fi, príchod, spotrebiče, klíma, teplá voda, bazén a domové pravidlá."
  enabledLocales={d1GuideEnabledLocales}
  quickInfoTitleHu="Gyors infók a D1 házhoz"
  quickInfoTitleEn="Quick info for the D1 house"
  quickInfoTitleCs="Rychlé informace k domu D1"
  quickInfoTitleDe="Schnellinfos zum D1-Haus"
  quickInfoTitleSk="Rýchle informácie k domu D1"
  quickInfoItems={d1GuideQuickInfoItems}
  infoBlockTitleHu="Közlekedés a telken"
  infoBlockTitleEn="Getting around the property"
  infoBlockTitleCs="Pohyb po pozemku"
  infoBlockTitleDe="Orientierung auf dem Grundstück"
  infoBlockTitleSk="Pohyb po pozemku"
  infoBlockParagraphsHu={[
    "A telek az utcafronttól egészen a vele párhuzamosan futó, hegy alatti útig tart. A telken három ház található: a D1, a D2 és a Fügeház.",
    "A Panorama Pool a házak mellett, egy dombon található. A D1-ből úgy tudtok odajutni, hogy a házak között, vagyis a Fügeház és a D1 között kell felsétálni. A Fügeház után jobbra már látszani fog az út a medence felé.",
    "A telek hegy felőli végén indul az út a bazaltorgonákhoz, innen könnyen megközelíthető a kirándulóút."
  ]}
  infoBlockParagraphsEn={[
    "This area explains how to move around the property. Final EN copy can be refined later.",
    "The plot stretches from the street front to the road running along the hill. There are three houses on the property: D1, D2 and the Fig House.",
    "The pool is reached by walking uphill between D1 and the Fig House, and the hiking path to the basalt organs starts from the hill-side end of the property."
  ]}
  infoBlockParagraphsCs={[
    "Tento blok vysvětluje pohyb po pozemku. Finální český text lze doplnit později.",
    "Pozemek sahá od ulice až k cestě pod kopcem. Na pozemku jsou tři domy: D1, D2 a Fügeház.",
    "K bazénu se jde mezi D1 a Fügeházem do kopce a na konci pozemku směrem ke kopci začíná cesta k bazaltovým varhanům."
  ]}
  infoBlockParagraphsDe={[
    "Dieser Block erklärt die Orientierung auf dem Grundstück. Der endgültige deutsche Text kann später verfeinert werden.",
    "Das Grundstück reicht von der Straßenseite bis zur parallel verlaufenden Straße am Hang. Auf dem Grundstück stehen D1, D2 und das Feigenhaus.",
    "Zum Pool gelangt man bergauf zwischen D1 und dem Feigenhaus; am hangseitigen Ende des Grundstücks beginnt auch der Weg zu den Basaltorgeln."
  ]}
  infoBlockParagraphsSk={[
    "Tento blok vysvetľuje pohyb po pozemku. Finálny slovenský text sa môže doplniť neskôr.",
    "Pozemok siaha od ulice až po cestu pod kopcom. Na pozemku sú tri domy: D1, D2 a Fügeház.",
    "K bazénu sa ide hore medzi D1 a Fügeházom a na konci pozemku smerom ku kopcu začína cesta k bazaltovým organom."
  ]}
  heroImageSrc={d1GuideHeroSrc}
  heroImageAlt="Dandelion D1 panorámás hero képe"
  items={d1GuideIndexItems}
  itemGroups={d1GuideIndexGroups}
/>
