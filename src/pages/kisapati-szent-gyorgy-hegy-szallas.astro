---
import BaseLayout from "../layouts/BaseLayout.astro";
import { d1PageData } from "../data/accommodation-pages/d1";
import { d2PageData } from "../data/accommodation-pages/d2";
import { fugehazPageData } from "../data/accommodation-pages/fugehaz";
import { szololigetPageData } from "../data/accommodation-pages/szololiget";
import { zsalyaPageData } from "../data/accommodation-pages/zsalya";
import { vintagePageData } from "../data/accommodation-pages/vintage";
import { requireAccommodationLocalAssetPath } from "../data/images/astro-local-assets";
import { SITE_NAME, toAbsoluteUrl } from "../data/site-seo";

const pagePath = "/kisapati-szent-gyorgy-hegy-szallas/";
const bookingHref = "https://ibe.sabeeapp.com/v3/p/Dandelion-Vendeghazak?p=3970b30e1042d58f&lang=Hu";
const heroImage = {
  desktop: "/images/kisapati/hero/kisapati-szent-gyorgy-hegy-hero-desktop.webp",
  mobile: "/images/kisapati/hero/kisapati-szent-gyorgy-hegy-hero-mobile.webp",
  altHu: "Drónfotó a Szent György-hegyről és a környező balatoni-felvidéki tájról"
};

const bookingTrackingAttrs = {
  "data-dnd-property": "kisapati-collection",
  "data-dnd-campaign": "kisapati-szent-gyorgy-hegy",
  "data-dnd-placement": "campaign-landing"
};

const stays = [
  {
    name: "Dandelion D2",
    capacity: "4–6 fő",
    description: "Családbarát, galériás ház nagy udvarral és fedett terasszal, nyugodt balatoni-felvidéki pihenéshez.",
    facts: ["nagy kert + fedett terasz", "családbarát kialakítás", "ingyenes parkolás"],
    href: "/dandelion-d2/",
    bookingHref: d2PageData.bookingLink,
    image: requireAccommodationLocalAssetPath("d2", "gallery", "dandelion-d2-kisapati-gallery-09.webp", "D2 kampánykép"),
    imageAlt: "Dandelion D2 fedett terasza és kertje Kisapátiban",
    review: d2PageData.reviews.items[0]
  },
  {
    name: "Dandelion Fügeház",
    capacity: "4 fő, pótággyal bővíthető",
    description: "Teraszos, intimebb és panorámás ház pároknak vagy kisebb családoknak, a tanúhegyek közelében.",
    facts: ["2 franciaágy", "teraszos pihenés", "ingyenes parkolás"],
    href: "/fuge/",
    bookingHref: fugehazPageData.bookingLink,
    image: fugehazPageData.hero.mobileImagePath,
    imageAlt: fugehazPageData.hero.fallbackAlt,
    review: fugehazPageData.reviews.items[0]
  },
  {
    name: "Szőlőliget",
    capacity: "4 fő + 1 pótágy",
    description: "Különálló, kétszintes ház nagy terasszal, növényes kerttel és 180°-os tanúhegyi panorámával.",
    facts: ["nagy terasz", "180°-os panoráma", "ingyenes parkolás"],
    href: "/szololiget/",
    bookingHref: szololigetPageData.bookingLink,
    image: szololigetPageData.hero.mobileImagePath,
    imageAlt: szololigetPageData.hero.fallbackAlt,
    review: szololigetPageData.reviews.items[0]
  },
  {
    name: "Zsálya",
    capacity: "4 fő",
    description: "Csendes, különálló két szintes kis ház két franciaággyal, részben fedett terasszal és tanúhegyi kilátással.",
    facts: ["2 fürdőszoba", "részben fedett terasz", "ingyenes parkolás"],
    href: "/dandelion-zsalya/",
    bookingHref: zsalyaPageData.bookingLink,
    image: zsalyaPageData.hero.mobileImagePath,
    imageAlt: zsalyaPageData.hero.fallbackAlt,
    review: zsalyaPageData.reviews.items[0]
  },
  {
    name: "Dandelion Vintage",
    capacity: "4 fő",
    description: "Otthonos, vintage hangulatú ház saját udvarral, grillezési lehetőséggel és családbarát elrendezéssel.",
    facts: ["saját udvar", "grillezési lehetőség", "ingyenes parkolás"],
    href: "/dandelion-vintage/",
    bookingHref: vintagePageData.bookingLink,
    image: vintagePageData.hero.mobileImagePath,
    imageAlt: vintagePageData.hero.fallbackAlt,
    review: vintagePageData.reviews.items[0]
  },
  {
    name: "Dandelion D1",
    capacity: "akár 8 fő",
    description: "Tágas ház 3 hálószobával, 2 fürdőszobával és panorámás terasszal nagyobb családoknak vagy baráti társaságoknak.",
    facts: ["3 hálószoba + nappali", "panorámás terasz", "ingyenes parkolás"],
    href: "/dandelion-d1/",
    bookingHref: d1PageData.bookingLink,
    image: d1PageData.hero.mobileImagePath,
    imageAlt: d1PageData.hero.fallbackAlt,
    review: d1PageData.reviews.items[0]
  }
];

const faqItems = [
  {
    question: "Melyik a legjobb kisapáti szállás nagyobb társaságnak?",
    answer: "A Dandelion D1 akár 8 főre, 3 hálószobával és 2 fürdőszobával a legjobb első választás nagyobb családnak vagy baráti társaságnak."
  },
  {
    question: "Van medencés szállás Kisapátiban?",
    answer: "Igen, egyes Dandelion-házaknál szezonális Panorama Pool-használat érhető el. A kiválasztott ház aktuális szolgáltatásait a foglalás előtt ellenőrizd."
  },
  {
    question: "Mikor és hogyan látom az aktuális árat?",
    answer: "Az ár a kiválasztott időszak, a vendégek száma és a ház alapján változik. A Szabad időpontok ellenőrzése gomb a SabeeApp foglalómotorba visz, ahol a kiválasztott dátumhoz tartozó aktuális végösszeg látható."
  },
  {
    question: "Milyen feltételekkel lehet foglalni?",
    answer: "A foglalás véglegesítéséhez 30% előleg fizetendő. Legalább 30 nappal érkezés előtt díjmentesen lemondható, 30 napon belül az előleg nem visszatérítendő; no-show esetén a teljes összeg fizetendő."
  }
];

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Főoldal", item: toAbsoluteUrl("/") },
      { "@type": "ListItem", position: 2, name: "Kisapáti – Szent György-hegy szállás", item: toAbsoluteUrl(pagePath) }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "@id": `${toAbsoluteUrl(pagePath)}#collection`,
    url: toAbsoluteUrl(pagePath),
    name: "Kisapáti szállás a Szent György-hegyen",
    description: "Kisapáti szállás a Szent György-hegy közelében: hat különböző hangulatú Dandelion-ház közvetlen foglalással.",
    inLanguage: "hu-HU",
    provider: { "@type": "LodgingBusiness", name: SITE_NAME, url: toAbsoluteUrl("/") },
    mainEntity: {
      "@type": "ItemList",
      itemListElement: stays.map((stay, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: stay.name,
        url: toAbsoluteUrl(stay.href),
        image: toAbsoluteUrl(stay.image)
      }))
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "@id": `${toAbsoluteUrl(pagePath)}#faq`,
    inLanguage: "hu-HU",
    mainEntity: faqItems.map((item) => ({
      "@type": "Question",
      name: item.question,
      acceptedAnswer: { "@type": "Answer", text: item.answer }
    }))
  }
];
---

<BaseLayout
  title="Kisapáti szállás a Szent György-hegyen | Dandelion"
  description="Kisapáti szállás a Szent György-hegy közelében: válassz hat különböző Dandelion-ház közül, majd ellenőrizd az aktuális szabad időpontokat és árakat."
  canonicalPath={pagePath}
  ogImage={heroImage.desktop}
  ogImageAlt={heroImage.altHu}
  structuredData={structuredData}
  headerMode="transparent"
>
  <div class="kisapati-campaign">
    <section class="kisapati-campaign__hero">
      <picture>
        <source media="(max-width: 767px)" srcset={heroImage.mobile} />
        <img src={heroImage.desktop} alt={heroImage.altHu} width="1920" height="1080" fetchpriority="high" decoding="async" />
      </picture>
      <div class="dnd-container kisapati-campaign__hero-content">
        <p class="kisapati-campaign__eyebrow">Kisapáti · Szent György-hegy · Balaton-felvidék</p>
        <h1>Kisapáti szállás a Szent György-hegyen</h1>
        <p class="kisapati-campaign__hero-lead">Hat különböző hangulatú Dandelion-ház Kisapátiban és a Szent György-hegy környékén. Válaszd ki, melyik illik hozzátok, és nézd meg az aktuális árakat.</p>
        <div class="kisapati-campaign__hero-actions">
          <a class="kisapati-campaign__button kisapati-campaign__button--primary" href={bookingHref} target="_blank" rel="noopener noreferrer" {...bookingTrackingAttrs}>Szabad időpontok ellenőrzése</a>
          <a class="kisapati-campaign__button kisapati-campaign__button--ghost" href="#szallasok">Szállások és férőhelyek</a>
        </div>
        <p class="kisapati-campaign__hero-note">Közvetlen foglalás a Dandelion foglalómotorján · az aktuális végösszeg dátum és létszám szerint jelenik meg</p>
      </div>
    </section>

    <section class="kisapati-campaign__trust" aria-label="Kiemelt előnyök">
      <div class="dnd-container kisapati-campaign__trust-grid">
        <div><strong>6 ház</strong><span>különböző igényekre</span></div>
        <div><strong>4–8 fő</strong><span>választható férőhely</span></div>
        <div><strong>Szent György-hegy</strong><span>túrák és borászatok közelében</span></div>
        <div><strong>8% ár-előny</strong><span>jellemzően közvetlen foglalásnál</span></div>
      </div>
    </section>

    <section class="kisapati-campaign__section" id="szallasok">
      <div class="dnd-container">
        <div class="kisapati-campaign__section-heading">
          <p class="kisapati-campaign__eyebrow">Válassz férőhely és hangulat alapján</p>
          <h2>Kisapáti szállások egy helyen</h2>
          <p>Ha nagyobb társasággal érkeztek, a D1 ad több teret. Családos pihenéshez a D2 vagy a Vintage, intimebb, panorámás kikapcsolódáshoz a Fügeház, a Szőlőliget vagy a Zsálya lehet a jó irány.</p>
        </div>
        <div class="kisapati-campaign__stay-grid">
          {stays.map((stay) => (
            <article class="kisapati-campaign__stay-card">
              <a href={stay.href} class="kisapati-campaign__stay-image" aria-label={`${stay.name} részletei`}>
                <img src={stay.image} alt={stay.imageAlt} loading="lazy" decoding="async" width="1200" height="900" />
              </a>
              <div class="kisapati-campaign__stay-body">
                <p class="kisapati-campaign__stay-capacity">{stay.capacity}</p>
                <h3>{stay.name}</h3>
                <p>{stay.description}</p>
                <ul>{stay.facts.map((fact) => <li>{fact}</li>)}</ul>
                <div class="kisapati-campaign__card-actions">
                  <a href={stay.href}>Részletek</a>
                  <a href={stay.bookingHref} target="_blank" rel="noopener noreferrer" {...bookingTrackingAttrs}>Foglalás</a>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="kisapati-campaign__offer" aria-labelledby="arazas-cim">
      <div class="dnd-container kisapati-campaign__offer-grid">
        <div>
          <p class="kisapati-campaign__eyebrow">Árak és közvetlen foglalás</p>
          <h2 id="arazas-cim">Az aktuális ajánlatot a választott dátumra látod</h2>
          <p>Az ár a szállástól, az időszaktól és a vendégek számától függ. A foglalómotorban a kiválasztott időszakra vonatkozó aktuális szállásdíj és végösszeg jelenik meg; az IFA és az esetleges végtakarítás külön, a foglalás során feltüntetve látható.</p>
          <p class="kisapati-campaign__offer-highlight">Közvetlen foglalásnál jellemzően 8% ár-előnyt kínálunk a foglalási portálokhoz képest.</p>
          <a class="kisapati-campaign__button kisapati-campaign__button--dark" href={bookingHref} target="_blank" rel="noopener noreferrer" {...bookingTrackingAttrs}>Aktuális árak és szabad időpontok</a>
        </div>
        <div class="kisapati-campaign__offer-list">
          <div><strong>30%</strong><span>előleg a foglalás véglegesítéséhez</span></div>
          <div><strong>Bankkártya</strong><span>online SabeePay vagy banki átutalás</span></div>
          <div><strong>SZÉP-kártya</strong><span>egyes házaknál elérhető; a kiválasztott háznál ellenőrizhető</span></div>
          <div><strong>30 nap</strong><span>érkezés előtt díjmentes lemondási határidő</span></div>
        </div>
      </div>
    </section>

    <section class="kisapati-campaign__pool-note" aria-label="Medenceinformáció">
      <div class="dnd-container">
        <p><strong>Medence:</strong> egyes házaknál szezonális Panorama Pool-használat érhető el; a kiválasztott ház aktuális szolgáltatásait a foglalás előtt ellenőrizd.</p>
      </div>
    </section>

    <section class="kisapati-campaign__section" aria-labelledby="velemenyek-cim">
      <div class="dnd-container">
        <div class="kisapati-campaign__section-heading">
          <p class="kisapati-campaign__eyebrow">Vendégvélemények</p>
          <h2 id="velemenyek-cim">A házak hangulatát vendégeink ismerik a legjobban</h2>
        </div>
        <div class="kisapati-campaign__review-grid">
          {stays.map((stay) => (
            <figure>
              <blockquote>„{stay.review.quote}”</blockquote>
              <figcaption>{stay.review.meta} · {stay.name}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <section class="kisapati-campaign__area">
      <div class="dnd-container kisapati-campaign__area-grid">
        <div>
          <p class="kisapati-campaign__eyebrow">Környék</p>
          <h2>Szent György-hegy, Tapolcai-medence és Balaton-felvidék</h2>
        </div>
        <div>
          <p>Kisapáti jó kiindulópont a Szent György-hegyhez, a tanúhegyekhez, Badacsonyhoz, Szigligethez, Tapolcához és a környék borászataihoz. A balatoni programok rövid autóúttal elérhetők, miközben a falu nyugodtabb bázist ad.</p>
          <div class="kisapati-campaign__area-points"><span>túrák</span><span>borászatok</span><span>Balaton</span><span>panoráma</span></div>
        </div>
      </div>
    </section>

    <section class="kisapati-campaign__conditions" aria-labelledby="feltetelek-cim">
      <div class="dnd-container">
        <div class="kisapati-campaign__section-heading">
          <p class="kisapati-campaign__eyebrow">Jó tudni foglalás előtt</p>
          <h2 id="feltetelek-cim">Érkezés, parkolás, fizetés és lemondás</h2>
        </div>
        <div class="kisapati-campaign__conditions-grid">
          <article><h3>Érkezés és távozás</h3><p>Check-in: 15:00–19:00. Check-out: 10:00-ig. Késői érkezés előzetes jelzéssel lehetséges; a bejutás jellemzően self check-in és kulcsdoboz segítségével történik.</p></article>
          <article><h3>Parkolás</h3><p>A D1, D2 és Fügeház adatlapján ingyenes parkolás szerepel. A kiválasztott ház pontos parkolóhelyét és érkezési útmutatóját a foglalás után küldjük.</p></article>
          <article><h3>Fizetés</h3><p>A foglaláshoz 30% előleg fizetendő online bankkártyával a SabeePay rendszeren vagy banki átutalással. A fennmaradó összeg legkésőbb érkezéskor vagy a tartózkodás során rendezendő.</p></article>
          <article><h3>Lemondás</h3><p>Érkezés előtt legalább 30 nappal a lemondás díjmentes. 30 napon belül az előleg nem visszatérítendő; no-show vagy az érkezés napi lemondás esetén a teljes összeg fizetendő.</p></article>
        </div>
        <p class="kisapati-campaign__conditions-note">A teljes, aktuális feltételeket az <a href="/aszf/">ÁSZF</a> tartalmazza. A foglalási rendszerben mindig a kiválasztott házra és dátumra vonatkozó feltételek az irányadók.</p>
      </div>
    </section>

    <section class="kisapati-campaign__faq" aria-labelledby="faq-cim">
      <div class="dnd-container">
        <div class="kisapati-campaign__section-heading"><p class="kisapati-campaign__eyebrow">Gyakori kérdések</p><h2 id="faq-cim">Kisapáti szállás – gyors válaszok</h2></div>
        <div class="kisapati-campaign__faq-grid">
          {faqItems.map((item) => <details><summary>{item.question}</summary><p>{item.answer}</p></details>)}
        </div>
      </div>
    </section>

    <section class="kisapati-campaign__final-cta">
      <div class="dnd-container"><p class="kisapati-campaign__eyebrow">Következő lépés</p><h2>Nézd meg, melyik dátum és ház illik hozzátok</h2><a class="kisapati-campaign__button kisapati-campaign__button--primary" href={bookingHref} target="_blank" rel="noopener noreferrer" {...bookingTrackingAttrs}>Szabad időpontok ellenőrzése</a></div>
    </section>
  </div>
  <a class="kisapati-campaign__mobile-cta" href={bookingHref} target="_blank" rel="noopener noreferrer" {...bookingTrackingAttrs}>Foglalás / szabad időpontok</a>
</BaseLayout>

<style>
  .kisapati-campaign { color: #1f2b28; background: #fbfaf6; }
  .kisapati-campaign__hero { position: relative; min-height: min(760px, 86vh); display: grid; align-items: end; overflow: hidden; color: #fff; }
  .kisapati-campaign__hero picture, .kisapati-campaign__hero img { position: absolute; inset: 0; width: 100%; height: 100%; }
  .kisapati-campaign__hero img { object-fit: cover; }
  .kisapati-campaign__hero-content { position: relative; z-index: 1; padding-top: 180px; padding-bottom: 82px; }
  .kisapati-campaign__eyebrow { margin: 0 0 12px; color: #a85c3a; font-size: .76rem; font-weight: 800; letter-spacing: .15em; text-transform: uppercase; }
  .kisapati-campaign__hero .kisapati-campaign__eyebrow { color: #f3c7a8; }
  .kisapati-campaign h1, .kisapati-campaign h2, .kisapati-campaign h3 { font-family: Georgia, 'Times New Roman', serif; font-weight: 500; }
  .kisapati-campaign h1 { max-width: 720px; margin: 0; font-size: clamp(2.6rem, 6vw, 5.7rem); line-height: .98; letter-spacing: -.04em; }
  .kisapati-campaign__hero-lead { max-width: 650px; margin: 25px 0 0; font-size: clamp(1.05rem, 1.7vw, 1.3rem); line-height: 1.55; }
  .kisapati-campaign__hero-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 30px; }
  .kisapati-campaign__button { display: inline-flex; align-items: center; justify-content: center; min-height: 50px; padding: 0 22px; border-radius: 999px; font-weight: 800; text-decoration: none; transition: transform .2s ease, background .2s ease; }
  .kisapati-campaign__button:hover { transform: translateY(-2px); }
  .kisapati-campaign__button--primary { background: #e5a16f; color: #1f2b28; }
  .kisapati-campaign__button--ghost { border: 1px solid rgba(255,255,255,.7); color: #fff; }
  .kisapati-campaign__button--dark { background: #243d35; color: #fff; }
  .kisapati-campaign__hero-note { margin: 18px 0 0; font-size: .84rem; opacity: .86; }
  .kisapati-campaign__trust { background: #243d35; color: #fff; }
  .kisapati-campaign__trust-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0; }
  .kisapati-campaign__trust-grid div { padding: 22px 18px; border-right: 1px solid rgba(255,255,255,.16); }
  .kisapati-campaign__trust-grid div:last-child { border-right: 0; }
  .kisapati-campaign__trust strong, .kisapati-campaign__trust span { display: block; }
  .kisapati-campaign__trust strong { color: #f3c7a8; font-size: 1.1rem; }
  .kisapati-campaign__trust span { margin-top: 5px; font-size: .85rem; opacity: .78; }
  .kisapati-campaign__section, .kisapati-campaign__conditions, .kisapati-campaign__faq { padding: clamp(70px, 9vw, 125px) 0; }
  .kisapati-campaign__section-heading { max-width: 720px; margin-bottom: 38px; }
  .kisapati-campaign h2 { margin: 0; color: #243d35; font-size: clamp(2rem, 4vw, 3.7rem); line-height: 1.05; letter-spacing: -.025em; }
  .kisapati-campaign__section-heading > p:last-child, .kisapati-campaign__offer p, .kisapati-campaign__pool-grid p, .kisapati-campaign__area-grid p, .kisapati-campaign__conditions-note { max-width: 700px; margin: 18px 0 0; color: #53605a; line-height: 1.65; }
  .kisapati-campaign__stay-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; }
  .kisapati-campaign__stay-card { overflow: hidden; background: #fff; border: 1px solid #e8e4dc; border-radius: 18px; box-shadow: 0 14px 40px rgba(31,43,40,.07); }
  .kisapati-campaign__stay-image { display: block; aspect-ratio: 4 / 3; overflow: hidden; }
  .kisapati-campaign__stay-image img { width: 100%; height: 100%; object-fit: cover; transition: transform .4s ease; }
  .kisapati-campaign__stay-image:hover img { transform: scale(1.04); }
  .kisapati-campaign__stay-body { padding: 24px; }
