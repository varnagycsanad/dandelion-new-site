---
import BaseLayout from "../layouts/BaseLayout.astro";
import { homepageImageSlots } from "../data/homepage-image-slots";
import {
  readHomepageImageMapping,
  type HomepageImageMapping
} from "../lib/homepage-image-mapping";
import { fetchWordPressMedia } from "../lib/wp-media";

const requestedSlot = Astro.url.searchParams.get("slot");
const initialSlotKey =
  homepageImageSlots.find((slot) => slot.key === requestedSlot)?.key ||
  homepageImageSlots[0].key;

let mapping: HomepageImageMapping = await readHomepageImageMapping();
let mediaItems = [];
let mediaError = "";

try {
  mediaItems = await fetchWordPressMedia();
} catch (error) {
  mediaError =
    error instanceof Error ? error.message : "A WordPress média lekérése nem sikerült.";
}

const initialState = {
  slots: homepageImageSlots,
  mapping,
  mediaItems,
  initialSlotKey
};
---

<BaseLayout title="Képkezelő admin" description="Dandelion WP média és főoldali képhoztárendelések kezelése.">
  <section class="dnd-image-admin">
    <div class="dnd-container">
      <div class="dnd-image-admin__header">
        <div>
          <span class="dnd-image-admin__eyebrow">WP képkezelő</span>
          <h1 class="dnd-image-admin__title">Főoldali képhelyek hozzárendelése</h1>
          <p class="dnd-image-admin__lead">
            A képek továbbra is a WordPress médiatárból jönnek. Itt csak azt választod ki,
            hogy melyik főoldali hely melyik képet használja.
          </p>
        </div>

        <form id="dnd-image-admin-save-form" class="dnd-image-admin__save" method="post">
          <input id="dnd-image-admin-slot-input" type="hidden" value={initialSlotKey} />
          <input id="dnd-image-admin-mapping-input" type="hidden" value={JSON.stringify(mapping)} />
          <button class="dnd-btn dnd-btn--primary" type="submit">Mentés</button>
        </form>
      </div>

      <p id="dnd-image-admin-save-success" class="dnd-image-admin__notice dnd-image-admin__notice--success is-hidden">
        A kép-hozzárendelések elmentve.
      </p>
      <p id="dnd-image-admin-save-error" class="dnd-image-admin__notice dnd-image-admin__notice--error is-hidden">
        Hiba: A mentés nem sikerült.
      </p>
      {mediaError && <p class="dnd-image-admin__notice dnd-image-admin__notice--error">Hiba: {mediaError}</p>}

      <div class="dnd-image-admin__layout">
        <aside class="dnd-image-admin__sidebar">
          <div class="dnd-image-admin__panel">
            <h2>Képhelyek</h2>
            <div class="dnd-image-admin__slot-list">
              {homepageImageSlots.map((slot) => (
                <button
                  type="button"
                  class:list={[
                    "dnd-image-admin__slot-button",
                    slot.key === initialSlotKey && "is-active"
                  ]}
                  data-slot-key={slot.key}
                >
                  <span class="dnd-image-admin__slot-label">{slot.label}</span>
                  <span class="dnd-image-admin__slot-description">{slot.description}</span>
                  <span class="dnd-image-admin__slot-current">
                    {mapping[slot.key]?.title || "Nincs kép kiválasztva"}
                  </span>
                </button>
              ))}
            </div>
          </div>
        </aside>

        <div class="dnd-image-admin__content">
          <div class="dnd-image-admin__panel dnd-image-admin__panel--current">
            <div class="dnd-image-admin__current-head">
              <div>
                <p class="dnd-image-admin__panel-kicker">Aktuális slot</p>
                <h2 id="dnd-image-admin-current-slot-title">
                  {homepageImageSlots.find((slot) => slot.key === initialSlotKey)?.label}
                </h2>
                <p id="dnd-image-admin-current-slot-description" class="dnd-image-admin__panel-text">
                  {homepageImageSlots.find((slot) => slot.key === initialSlotKey)?.description}
                </p>
              </div>
              <button id="dnd-image-admin-clear-button" class="dnd-btn dnd-btn--secondary" type="button">
                Kijelölés törlése
              </button>
            </div>

            <div class="dnd-image-admin__current-card">
              <div id="dnd-image-admin-preview" class="dnd-image-admin__preview">
                {
                  mapping[initialSlotKey] ? (
                    <img
                      src={mapping[initialSlotKey]?.thumbnailUrl || mapping[initialSlotKey]?.sourceUrl}
                      alt={mapping[initialSlotKey]?.altText || mapping[initialSlotKey]?.title || ""}
                    />
                  ) : (
                    <div class="dnd-image-admin__preview-empty">Még nincs kép hozzárendelve ehhez a slothoz.</div>
                  )
                }
              </div>

              <div class="dnd-image-admin__current-meta">
                <p class="dnd-image-admin__panel-kicker">Kiválasztott kép</p>
                <h3 id="dnd-image-admin-current-image-title">
                  {mapping[initialSlotKey]?.title || "Nincs kiválasztott kép"}
                </h3>
                <p id="dnd-image-admin-current-image-alt" class="dnd-image-admin__panel-text">
                  {mapping[initialSlotKey]?.altText || "Nincs alt szöveg."}
                </p>
                <a
                  id="dnd-image-admin-current-image-link"
                  class:list={[
                    "dnd-image-admin__source-link",
                    !mapping[initialSlotKey]?.sourceUrl && "is-hidden"
                  ]}
                  href={mapping[initialSlotKey]?.sourceUrl || "#"}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Eredeti kép megnyitása
                </a>

                <div class="dnd-image-admin__sizes">
                  <p class="dnd-image-admin__panel-kicker">Elérhető méretek</p>
                  <div id="dnd-image-admin-sizes"></div>
                </div>
              </div>
            </div>
          </div>

          <div class="dnd-image-admin__panel">
            <div class="dnd-image-admin__media-head">
              <div>
                <h2>WordPress média</h2>
                <p class="dnd-image-admin__panel-text">
                  Betöltött képek száma: {mediaItems.length}
                </p>
              </div>
              <label class="dnd-image-admin__search">
                <span>Keresés</span>
                <input id="dnd-image-admin-search" type="search" placeholder="Kép címe vagy alt szöveg" />
              </label>
            </div>

            {!mediaError && (
              <div id="dnd-image-admin-grid" class="dnd-image-admin__media-grid">
                {mediaItems.map((item) => (
                  <button
                    type="button"
                    class="dnd-image-admin__media-card"
                    data-media-id={item.id}
                    data-title={item.title.toLowerCase()}
                    data-alt={item.altText.toLowerCase()}
                  >
                    <img
                      src={item.thumbnailUrl || item.sourceUrl}
                      alt={item.altText || item.title}
                      loading="lazy"
                    />
                    <span class="dnd-image-admin__media-copy">
                      <strong>{item.title}</strong>
                      <small>{item.altText || "Nincs alt szöveg"}</small>
                    </span>
                  </button>
                ))}
              </div>
            )}
          </div>
        </div>
      </div>
    </div>
  </section>

  <script id="dnd-image-admin-state" type="application/json" set:html={JSON.stringify(initialState)}></script>

  <script>
    const stateElement = document.getElementById("dnd-image-admin-state");

    if (stateElement) {
      const state = JSON.parse(stateElement.textContent || "{}");
      const slotButtons = Array.from(document.querySelectorAll("[data-slot-key]"));
      const mediaCards = Array.from(document.querySelectorAll("[data-media-id]"));
      const mappingInput = document.getElementById("dnd-image-admin-mapping-input");
      const slotInput = document.getElementById("dnd-image-admin-slot-input");
      const saveForm = document.getElementById("dnd-image-admin-save-form");
      const saveSuccess = document.getElementById("dnd-image-admin-save-success");
      const saveError = document.getElementById("dnd-image-admin-save-error");
      const searchInput = document.getElementById("dnd-image-admin-search");
      const clearButton = document.getElementById("dnd-image-admin-clear-button");
      const preview = document.getElementById("dnd-image-admin-preview");
      const currentSlotTitle = document.getElementById("dnd-image-admin-current-slot-title");
      const currentSlotDescription = document.getElementById("dnd-image-admin-current-slot-description");
      const currentImageTitle = document.getElementById("dnd-image-admin-current-image-title");
      const currentImageAlt = document.getElementById("dnd-image-admin-current-image-alt");
      const currentImageLink = document.getElementById("dnd-image-admin-current-image-link");
      const sizesContainer = document.getElementById("dnd-image-admin-sizes");
      const primarySizeNames = ["full", "large", "medium_large", "medium", "thumbnail"];


      let activeSlotKey = state.initialSlotKey;
      let mapping = state.mapping || {};

      function getSlotDefinition(slotKey) {
        return (state.slots || []).find((slot) => slot.key === slotKey);
      }

      function getMediaItem(mediaId) {
        return (state.mediaItems || []).find((item) => String(item.id) === String(mediaId));
      }

      function renderSizesTableRows(sizes) {
        return sizes
          .map((size) => {
            const dimensions =
              size.width && size.height ? `${size.width} × ${size.height}` : "Ismeretlen";

            return `
              <tr>
                <td>${size.name}</td>
                <td>${dimensions}</td>
                <td>${size.mimeType || "Nincs adat"}</td>
                <td><a href="${size.url}" target="_blank" rel="noopener noreferrer">Megnyitás</a></td>
              </tr>
            `;
          })
          .join("");
      }

      function renderSizes(selected) {
        if (!sizesContainer) {
          return;
        }

        const mediaItem = selected ? getMediaItem(selected.id) : null;
        const sizes = mediaItem?.sizes || [];
        const primarySizes = primarySizeNames
          .map((name) => sizes.find((size) => size.name === name))
          .filter(Boolean);
        const extraSizes = sizes.filter((size) => !primarySizeNames.includes(size.name));

        if (!sizes.length) {
          sizesContainer.innerHTML =
            '<p class="dnd-image-admin__sizes-empty">Ehhez a képhez nem érkezett size adat.</p>';
          return;
        }

        const primaryRows = renderSizesTableRows(primarySizes);
        const extraRows = renderSizesTableRows(extraSizes);
        const primaryBlock = primarySizes.length
          ? `
            <div class="dnd-image-admin__sizes-group">
              <div class="dnd-image-admin__sizes-table-wrap">
                <table class="dnd-image-admin__sizes-table">
                  <thead>
                    <tr>
                      <th>Size</th>
                      <th>Méret</th>
                      <th>MIME</th>
                      <th>URL</th>
                    </tr>
                  </thead>
                  <tbody>${primaryRows}</tbody>
                </table>
              </div>
            </div>
          `
          : '<p class="dnd-image-admin__sizes-empty">Ehhez a képhez a kiemelt alapméretek közül egyik sem érhető el.</p>';
        const extraBlock = extraSizes.length
          ? `
            <details class="dnd-image-admin__sizes-details">
              <summary>Összes további méret (${extraSizes.length})</summary>
              <div class="dnd-image-admin__sizes-table-wrap">
                <table class="dnd-image-admin__sizes-table">
                  <thead>
                    <tr>
                      <th>Size</th>
                      <th>Méret</th>
                      <th>MIME</th>
                      <th>URL</th>
                    </tr>
                  </thead>
                  <tbody>${extraRows}</tbody>
                </table>
              </div>
            </details>
          `
          : "";

        sizesContainer.innerHTML = `
          <div class="dnd-image-admin__sizes-summary">Összes változat: ${sizes.length}</div>
          ${primaryBlock}
          ${extraBlock}
        `;
      }

      function syncHiddenInputs() {
        if (mappingInput) {
          mappingInput.value = JSON.stringify(mapping);
        }

        if (slotInput) {
          slotInput.value = activeSlotKey;
        }
      }

      function renderSlotList() {
        slotButtons.forEach((button) => {
          const slotKey = button.dataset.slotKey;
          const currentText = button.querySelector(".dnd-image-admin__slot-current");
          const selected = mapping[slotKey];

          button.classList.toggle("is-active", slotKey === activeSlotKey);

          if (currentText) {
            currentText.textContent = selected?.title || "Nincs kép kiválasztva";
          }
        });
      }

      function renderMediaSelection() {
        mediaCards.forEach((card) => {
          const mediaId = Number(card.dataset.mediaId);
          const selected = mapping[activeSlotKey];
          card.classList.toggle("is-selected", selected?.id === mediaId);
        });
      }

      function renderPreview() {
        const slot = getSlotDefinition(activeSlotKey);
        const selected = mapping[activeSlotKey];

        if (currentSlotTitle) {
          currentSlotTitle.textContent = slot?.label || "";
        }

        if (currentSlotDescription) {
          currentSlotDescription.textContent = slot?.description || "";
        }

        if (!preview || !currentImageTitle || !currentImageAlt || !currentImageLink) {
          return;
        }

        if (!selected) {
          preview.innerHTML = '<div class="dnd-image-admin__preview-empty">Még nincs kép hozzárendelve ehhez a slothoz.</div>';
          currentImageTitle.textContent = "Nincs kiválasztott kép";
          currentImageAlt.textContent = "Nincs alt szöveg.";
          currentImageLink.classList.add("is-hidden");
          currentImageLink.setAttribute("href", "#");
          renderSizes(null);
          return;
        }

        preview.innerHTML = "";
        const image = document.createElement("img");
        image.src = selected.thumbnailUrl || selected.sourceUrl;
        image.alt = selected.altText || selected.title || "";
        preview.appendChild(image);

        currentImageTitle.textContent = selected.title;
        currentImageAlt.textContent = selected.altText || "Nincs alt szöveg.";
        currentImageLink.classList.remove("is-hidden");
        currentImageLink.setAttribute("href", selected.sourceUrl);
        renderSizes(selected);
      }

      function renderAll() {
        syncHiddenInputs();
        renderSlotList();
        renderMediaSelection();
        renderPreview();
      }

      function showSaveMessage(success, message) {
        if (saveSuccess) {
          saveSuccess.classList.toggle("is-hidden", !success);
        }

        if (saveError) {
          saveError.classList.toggle("is-hidden", success);
          if (!success) {
            saveError.textContent = `Hiba: ${message}`;
          }
        }
      }

      slotButtons.forEach((button) => {
        button.addEventListener("click", () => {
          activeSlotKey = button.dataset.slotKey || activeSlotKey;
          renderAll();
        });
      });

      mediaCards.forEach((card) => {
        card.addEventListener("click", () => {
          const item = getMediaItem(card.dataset.mediaId);
          if (!item) {
            return;
          }

          mapping[activeSlotKey] = {
            id: item.id,
            title: item.title,
            altText: item.altText,
            sourceUrl: item.sourceUrl,
            thumbnailUrl: item.thumbnailUrl
          };

          renderAll();
        });
      });

      if (clearButton) {
        clearButton.addEventListener("click", () => {
          mapping[activeSlotKey] = null;
          renderAll();
        });
      }

      if (searchInput) {
        searchInput.addEventListener("input", () => {
          const term = searchInput.value.trim().toLowerCase();

          mediaCards.forEach((card) => {
            const haystack = `${card.dataset.title || ""} ${card.dataset.alt || ""}`;
            card.hidden = term.length > 0 && !haystack.includes(term);
          });
        });
      }

      if (saveForm) {
        saveForm.addEventListener("submit", async (event) => {
          event.preventDefault();

          try {
            const response = await fetch("/api/image-admin/save", {
              method: "POST",
              headers: {
                "Content-Type": "application/json"
              },
              body: mappingInput?.value || "{}"
            });

            if (!response.ok) {
              const payload = await response.json().catch(() => null);
              throw new Error(payload?.message || "A mentés nem sikerült.");
            }

            showSaveMessage(true, "");
          } catch (error) {
            showSaveMessage(
              false,
              error instanceof Error ? error.message : "A mentés nem sikerült."
            );
          }
        });
      }

      renderAll();
    }
  </script>

  <style>
    .dnd-image-admin {
      padding: 44px 0 96px;
    }

    .dnd-image-admin__header {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: 24px;
      margin-bottom: 28px;
    }

    .dnd-image-admin__eyebrow {
      display: inline-block;
      margin-bottom: 14px;
      color: var(--dnd-accent);
      font-size: 0.76rem;
      font-weight: 600;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    .dnd-image-admin__title {
      margin: 0;
      font-size: clamp(2rem, 4vw, 3.2rem);
      line-height: 1.04;
    }

    .dnd-image-admin__lead,
    .dnd-image-admin__panel-text,
    .dnd-image-admin__slot-description,
    .dnd-image-admin__slot-current,
    .dnd-image-admin__media-copy small {
      margin: 0;
      color: rgba(0, 0, 0, 0.68);
      line-height: 1.65;
    }

    .dnd-image-admin__lead {
      max-width: 780px;
      margin-top: 12px;
    }

    .dnd-image-admin__layout {
      display: grid;
      gap: 24px;
    }

    .dnd-image-admin__panel {
      padding: 24px;
      border: 1px solid rgba(0, 0, 0, 0.08);
      border-radius: 26px;
      background: rgba(255, 255, 255, 0.9);
      box-shadow: 0 16px 36px rgba(0, 0, 0, 0.05);
    }

    .dnd-image-admin__panel h2,
    .dnd-image-admin__current-meta h3 {
      margin: 0 0 10px;
      font-size: 1.2rem;
    }

    .dnd-image-admin__slot-list {
      display: grid;
      gap: 12px;
      margin-top: 18px;
    }

    .dnd-image-admin__slot-button,
    .dnd-image-admin__media-card {
      width: 100%;
      border: 1px solid rgba(0, 0, 0, 0.08);
      background: #fff;
      cursor: pointer;
      text-align: left;
    }

    .dnd-image-admin__slot-button {
      padding: 16px 18px;
      border-radius: 18px;
      transition: border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
    }

    .dnd-image-admin__slot-button:hover,
    .dnd-image-admin__media-card:hover {
      transform: translateY(-1px);
      box-shadow: 0 10px 24px rgba(0, 0, 0, 0.06);
    }

    .dnd-image-admin__slot-button.is-active,
    .dnd-image-admin__media-card.is-selected {
      border-color: var(--dnd-accent);
      box-shadow: 0 0 0 2px rgba(217, 158, 43, 0.18);
    }

    .dnd-image-admin__slot-label,
    .dnd-image-admin__media-copy strong {
      display: block;
      margin-bottom: 6px;
      font-weight: 700;
    }

    .dnd-image-admin__slot-current {
      display: block;
      margin-top: 10px;
      font-size: 0.92rem;
    }

    .dnd-image-admin__current-head,
    .dnd-image-admin__media-head {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 16px;
      margin-bottom: 20px;
    }

    .dnd-image-admin__panel-kicker {
      margin: 0 0 8px;
      color: var(--dnd-accent);
      font-size: 0.76rem;
      font-weight: 600;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    .dnd-image-admin__current-card {
      display: grid;
      gap: 18px;
    }

    .dnd-image-admin__preview {
      overflow: hidden;
      border-radius: 22px;
      background: linear-gradient(135deg, #f1ecdf 0%, #fbf8f1 100%);
      min-height: 260px;
      border: 1px solid rgba(0, 0, 0, 0.08);
    }

    .dnd-image-admin__preview img {
      width: 100%;
      height: 100%;
      min-height: 260px;
      object-fit: cover;
    }

    .dnd-image-admin__preview-empty {
      display: grid;
      place-items: center;
      min-height: 260px;
      padding: 24px;
      text-align: center;
      color: rgba(0, 0, 0, 0.56);
    }

    .dnd-image-admin__source-link {
      display: inline-flex;
      margin-top: 12px;
      color: #000;
      font-weight: 600;
      text-decoration: underline;
      text-underline-offset: 3px;
    }

    .dnd-image-admin__source-link.is-hidden {
      display: none;
    }

    .dnd-image-admin__sizes {
      margin-top: 18px;
    }

    .dnd-image-admin__sizes-summary,
    .dnd-image-admin__sizes-empty {
      margin: 0 0 10px;
      color: rgba(0, 0, 0, 0.68);
      line-height: 1.6;
    }

    .dnd-image-admin__sizes-table-wrap {
      overflow-x: auto;
    }

    .dnd-image-admin__sizes-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.92rem;
    }

    .dnd-image-admin__sizes-table th,
    .dnd-image-admin__sizes-table td {
      padding: 10px 0;
      border-bottom: 1px solid rgba(0, 0, 0, 0.08);
      text-align: left;
      vertical-align: top;
    }

    .dnd-image-admin__sizes-table th {
      font-size: 0.82rem;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: rgba(0, 0, 0, 0.52);
    }

    .dnd-image-admin__sizes-table a {
      text-decoration: underline;
      text-underline-offset: 3px;
    }

    .dnd-image-admin__sizes-details {
      margin-top: 14px;
    }

    .dnd-image-admin__sizes-details summary {
      cursor: pointer;
      font-weight: 600;
      color: rgba(0, 0, 0, 0.78);
      list-style: none;
    }

    .dnd-image-admin__sizes-details summary::-webkit-details-marker {
      display: none;
    }

    .dnd-image-admin__sizes-details summary::before {
      content: "+";
      display: inline-block;
      margin-right: 8px;
      font-weight: 700;
    }

    .dnd-image-admin__sizes-details[open] summary::before {
      content: "−";
    }

    .dnd-image-admin__sizes-details .dnd-image-admin__sizes-table-wrap {
      margin-top: 10px;
    }

    .dnd-image-admin__search {
      display: grid;
      gap: 8px;
      min-width: min(100%, 280px);
      font-size: 0.92rem;
      font-weight: 600;
    }

    .dnd-image-admin__search input {
      min-height: 44px;
      padding: 0 14px;
      border: 1px solid rgba(0, 0, 0, 0.1);
      border-radius: 14px;
      font: inherit;
      background: #fff;
    }

    .dnd-image-admin__media-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
      gap: 16px;
    }

    .dnd-image-admin__media-card {
      overflow: hidden;
      padding: 0;
      border-radius: 20px;
    }

    .dnd-image-admin__media-card img {
      width: 100%;
      aspect-ratio: 4 / 3;
      object-fit: cover;
      background: #f2f2f2;
    }

    .dnd-image-admin__media-copy {
      display: block;
      padding: 14px;
    }

    .dnd-image-admin__notice {
      margin: 0 0 18px;
      padding: 14px 16px;
      border-radius: 16px;
      font-weight: 600;
    }

    .dnd-image-admin__notice--success {
      background: rgba(217, 158, 43, 0.12);
      color: #6b4a00;
    }

    .dnd-image-admin__notice--error {
      background: rgba(164, 31, 31, 0.1);
      color: #8a1616;
    }

    .dnd-image-admin__notice.is-hidden {
      display: none;
    }

    @media (min-width: 980px) {
      .dnd-image-admin__layout {
