---
import GermanExperiencePage from "../../templates/GermanExperiencePage.astro";
import wineImage from "../../assets/experiences/szent-gyorgy-hegy-szolo.jpg";
import balatonImage from "../../assets/experiences/balaton-shore.jpg";
---

<GermanExperiencePage
  title="Erlebnisse am Balaton | Dandelion Unterkünfte"
  description="Fahrradverleih, Weingüter, Balaton-Strandtage und Spaziergänge an den Zeugenbergen rund um die Dandelion Unterkünfte."
  canonicalPath="/de/erlebnisse/"
  breadcrumbName="Erlebnisse"
  eyebrow="Region und Programme"
  heading="Wählen Sie die Stimmung des Tages."
  lead={[
    "Die Dandelion Häuser liegen zwischen Balaton, Szent György-hegy und dem Balaton-Oberland. Manche Tage passen zum Radfahren, andere zu einer Weinterrasse, einem Strandnachmittag oder einem ruhigen Spaziergang.",
    "Diese Übersicht sammelt die wichtigsten Richtungen für deutschsprachige Gäste."
  ]}
  heroImage={wineImage}
  heroAlt="Weinberge am Szent György-hegy im Balaton-Oberland"
  supportImage={balatonImage}
  supportAlt="Balaton-Ufer im Sommerlicht"
  supportTitle="Erst die Stimmung, dann das Ziel."
  supportText="Von den Häusern aus lassen sich Balaton-Tage, Wein, Radwege und Zeugenberge gut kombinieren, ohne den Tag zu überladen."
  highlights={["Fahrradverleih und ruhige Nebenstrassen", "Weingüter rund um Szent György-hegy und Badacsony", "Balaton-Strandtage in kurzer Fahrt", "Zeugenberge, Aussichtspunkte und Sonnenuntergänge"]}
  primaryLink={{ label: "Unterkünfte ansehen", href: "/de/unterkuenfte/" }}
  secondaryLink={{ label: "Kontakt", href: "/de/kontakt/" }}
  sections={[
    {
      title: "Programme rund um Dandelion",
      cards: [
        { title: "Fahrradverleih", body: "Dorfstraßen, Weinberge und langsamere Routen durch das Balaton-Oberland.", href: "/de/fahrradverleih/", linkLabel: "Fahrradverleih" },
        { title: "Weingüter", body: "Keller, Terrassen und ruhige Abende rund um Szent György-hegy und Badacsony.", href: "/de/weingueter/", linkLabel: "Weingüter" },
        { title: "Balaton", body: "Strände, Uferwege und einfache Sommerprogramme in kurzer Fahrt.", href: "/de/balaton/", linkLabel: "Balaton" },
        { title: "Zeugenberge", body: "Aussichtspunkte, leichtere Wanderungen und Sonnenuntergänge an den vulkanischen Hügeln.", href: "/de/zeugenberge/", linkLabel: "Zeugenberge" },
        { title: "Panorama Pool", body: "Der gemeinsame Poolbereich für D1, D2 und Fügeház ab 15. Juni 2026.", href: "/de/panorama-pool/", linkLabel: "Panorama Pool" }
      ]
    }
  ]}
/>
