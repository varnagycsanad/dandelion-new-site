---
import GermanExperiencePage from "../../templates/GermanExperiencePage.astro";

const heroVideo = "/videos/elmenyek/kerekpar/balaton-felvideki-bicikli-tura.mp4?v=20260520-faststart";
const heroMobileVideo = "/videos/elmenyek/kerekpar/balaton-felvideki-bicikli-tura-mobile-lite.mp4?v=20260606-mobile-lite";
const desktopImage = "/images/bicikli/balaton-felvidek-bicikli-desktop.webp";
const mobileImage = "/images/bicikli/balaton-felvidek-bicikli-mobile.webp";
---

<GermanExperiencePage
  title="Fahrradverleih im Balaton-Oberland | Dandelion Unterkünfte"
  description="Fahrradverleih, Preise und Routenvorschläge für Dandelion Gäste rund um Szent György-hegy und den Balaton."
  canonicalPath="/de/fahrradverleih/"
  breadcrumbName="Fahrradverleih"
  eyebrow="Balaton-Oberland auf zwei Rädern"
  heading="Langsamer und freier durch die Landschaft."
  lead={[
    "Radfahren bringt die Umgebung näher: ruhige Dörfer, Weinbergstraßen, Aussichtspunkte und kleine Stopps, bei denen kein Tempo nötig ist.",
    "Sie können eine kurze Nachmittagsrunde oder einen ganzen Tag planen. E-Bikes sind besonders angenehm für hügeligere Abschnitte rund um Szent György-hegy."
  ]}
  heroImage={desktopImage}
  heroAlt="Radfahren im Balaton-Oberland zwischen Weinbergen und Zeugenbergen"
  heroVideoDesktopSrc={heroVideo}
  heroVideoMobileSrc={heroMobileVideo}
  heroPosterSrc={desktopImage}
  supportImage={mobileImage}
  supportAlt="Fahrradstimmung im Balaton-Oberland"
  supportTitle="Erst die Art des Tages wählen."
  supportText="Manche Routen sind kurz und panoramisch, andere führen Richtung Balaton, Weingüter oder Káli-Becken."
  highlights={["4 normale Erwachsenenräder", "2 E-Bikes", "1 Kinderfahrrad nach Absprache", "Abholung und Rückgabe nach vorheriger Abstimmung"]}
  primaryLink={{ label: "Unterkünfte ansehen", href: "/de/unterkuenfte/" }}
  secondaryLink={{ label: "Zurück zu Erlebnissen", href: "/de/erlebnisse/" }}
  sections={[
    {
      title: "Fahrradverleih, Preise und Bedingungen",
      intro: "Der Fahrradverleih ist für Dandelion Gäste nach vorheriger Absprache möglich. Die Anzahl der Räder ist begrenzt.",
      cards: [
        { title: "Normales Erwachsenenrad", body: "9 000 HUF pro Tag." },
        { title: "E-Bike", body: "12 000 HUF pro Tag." },
        { title: "Kinderfahrrad", body: "Nach vorheriger Absprache." },
        { title: "Wichtig", body: "Die Räder sind nicht für Royal Homes, Dandelion Köveskál oder Szépvölgyi Gäste verfügbar. Szőlőliget, Zsálya und Vintage Gäste holen die Räder an unserer zentralen Adresse ab." }
      ]
    },
    {
      title: "Routenideen",
      cards: [
        { title: "Kurze Runde in der Nähe", body: "Dörfer, Weinberge und Aussichtspunkte für eine leichtere Fahrt." },
        { title: "Szent György-hegy", body: "Schön, aber teilweise hügelig. Ein E-Bike macht die Route entspannter." },
        { title: "Richtung Badacsony und Balaton", body: "Gut, wenn Radfahren Teil eines Strand- oder Wein-Tages sein soll." },
        { title: "Káli-Becken", body: "Für längere, geplante Tage mit mehreren Stopps." }
      ]
    }
  ]}
/>
