---
import GermanExperiencePage from "../../templates/GermanExperiencePage.astro";
import { panoramaPoolImages } from "../../data/images/panorama-pool-images";
import heroImage from "../../assets/experiences/tanuhegyek-drone-dji-20260512.jpg";

const poolHero = panoramaPoolImages.find((image) => image.usageHint === "hero");
---

<GermanExperiencePage
  title="Dandelion Panorama Pool | Pool im Balaton-Oberland"
  description="Ab 15. Juni 2026 gehört der Panorama Pool für Gäste von D1, D2 und Fügeház zum Sommeraufenthalt in Kisapati."
  canonicalPath="/de/panorama-pool/"
  breadcrumbName="Panorama Pool"
  eyebrow="Sommererlebnis"
  heading="Panorama Pool am Szent György-hegy."
  lead={[
    "Der Panorama Pool ist für Gäste der nahe gelegenen Häuser gedacht: Dandelion D1, Dandelion D2 und Fügeház.",
    "Schwimmen, Aussicht und der ruhigere Rhythmus des Balaton-Oberlands werden ab 15. Juni 2026 Teil des Sommeraufenthalts."
  ]}
  heroImage={heroImage}
  heroAlt={poolHero?.altEn ?? "Panorama Pool im Balaton-Oberland"}
  highlights={["am Fuß des Szent György-hegy", "Blick auf Zeugenberge und Badacsony", "für Gäste von D1, D2 und Fügeház", "verfügbar ab 15. Juni 2026"]}
  primaryLink={{ label: "D1 ansehen", href: "/de/dandelion-d1/" }}
  secondaryLink={{ label: "D2 ansehen", href: "/de/dandelion-d2/" }}
  sections={[
    {
      title: "Pool in Kürze",
      cards: [
        { title: "Nicht separat buchbar", body: "Der Pool gehört zum Aufenthalt in D1, D2 und Fügeház, wenn die Saison läuft." },
        { title: "Gemeinsamer Bereich", body: "Der Panorama Pool ist ein gemeinsamer Poolbereich für die passenden Dandelion Häuser." },
        { title: "Sommer 2026", body: "Die Verfügbarkeit ist ab 15. Juni 2026 geplant." }
      ]
    },
    {
      title: "Unterkünfte mit Poolzugang",
      cards: [
        { title: "Dandelion D1", body: "Großes Ferienhaus für Familien und Freunde.", href: "/de/dandelion-d1/", linkLabel: "D1 öffnen" },
        { title: "Dandelion D2", body: "Familienfreundliches Haus mit Garten und Terrasse.", href: "/de/dandelion-d2/", linkLabel: "D2 öffnen" },
        { title: "Dandelion Fügeház", body: "Panoramahaus mit Terrasse und ruhiger Lage.", href: "/de/dandelion-fugehaz/", linkLabel: "Fügeház öffnen" }
      ]
    }
  ]}
/>
