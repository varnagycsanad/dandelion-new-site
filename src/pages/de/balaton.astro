---
import GermanExperiencePage from "../../templates/GermanExperiencePage.astro";
import heroImage from "../../assets/experiences/balaton-shore.jpg";
import supportImage from "../../assets/experiences/tanuhegyek-drone-dji-20260512.jpg";
---

<GermanExperiencePage
  title="Balaton Strände und Wasserprogramme | Dandelion Unterkünfte"
  description="Balaton Strände, Badacsony, Szigliget und leichte Wasserprogramme von den Dandelion Unterkünften aus."
  canonicalPath="/de/balaton/"
  breadcrumbName="Balaton"
  eyebrow="Leichte Tage am See"
  heading="Balaton Strände und Programme am Wasser."
  lead={[
    "Wenn ein Tag am Wasser gut passt, ist der Balaton ein einfacher Teil des Dandelion Aufenthalts: Strände, Stege, Spaziergänge, Abendessen am See und leichte Wasserprogramme.",
    "Ein Vormittag am Strand, ein Weinstopp am Hügel und ein Abendspaziergang in Badacsony oder Szigliget können gut in denselben Tag passen."
  ]}
  heroImage={heroImage}
  heroAlt="Klares Balaton-Ufer im Sommerlicht"
  supportImage={supportImage}
  supportAlt="Zeugenberge nahe Balaton-Programmen"
  supportTitle="Erst die Seestimmung wählen."
  supportText="Familienstrand, Spaziergang am Wasser, Abendessen in Badacsony oder ein ruhiger Nachmittag bei Szigliget: die Region gibt mehrere gute Richtungen."
  highlights={["Strände in kurzer Fahrt", "Badacsony, Szigliget und Ábrahámhegy", "Kajak, Kanu und SUP saisonal möglich", "einfache Programme für Familien, Paare und Sommerabende"]}
  primaryLink={{ label: "Unterkünfte ansehen", href: "/de/unterkuenfte/" }}
  secondaryLink={{ label: "Zurück zu Erlebnissen", href: "/de/erlebnisse/" }}
  sections={[
    {
      title: "Strände und Balaton-Orte",
      cards: [
        { title: "Szigliget Strand", body: "Eine gute Wahl für Familien, Schwimmen und klassische Sommertage." },
        { title: "Ábrahámhegy Strand", body: "Ruhiger und familienfreundlich, gut für einen einfachen Tag am Wasser." },
        { title: "Badacsony und Badacsonytomaj", body: "Gut, wenn Baden mit Weinterrassen, Abendessen oder Spaziergang verbunden werden soll." },
        { title: "Badacsonylabdihegy", body: "Praktisch, wenn Strandzeit und Wasserprogramme wie Kajak, Kanu oder SUP zusammenpassen sollen." }
      ]
    },
    {
      title: "Wasserprogramme",
      cards: [
        { title: "Kajak und Kanu", body: "Saisonal und anbieterabhängig; vom Wasser wird der Blick auf Badacsony, Szigliget und Szent György-hegy besonders schön." },
        { title: "SUP", body: "Bei ruhigem Wetter eine leichte Art, Zeit auf dem Wasser zu verbringen." },
        { title: "Bootsprogramme", body: "Saisonal, wetter- und anbieterabhängig. Verfügbarkeit und Regeln bitte aktuell prüfen." }
      ]
    }
  ]}
/>
