---
import GermanExperiencePage from "../../templates/GermanExperiencePage.astro";
import heroImage from "../../assets/experiences/balaton-shore.jpg";
import supportImage from "../../assets/experiences/tanuhegyek-drone-dji-20260512.jpg";
---

<GermanExperiencePage
  title="Balaton Straende und Wasserprogramme | Dandelion Unterkuenfte"
  description="Balaton Straende, Badacsony, Szigliget und leichte Wasserprogramme von den Dandelion Unterkuenften aus."
  canonicalPath="/de/balaton/"
  breadcrumbName="Balaton"
  eyebrow="Leichte Tage am See"
  heading="Balaton Straende und Programme am Wasser."
  lead={[
    "Wenn ein Tag am Wasser gut passt, ist der Balaton ein einfacher Teil des Dandelion Aufenthalts: Straende, Stege, Spaziergaenge, Abendessen am See und leichte Wasserprogramme.",
    "Ein Vormittag am Strand, ein Weinstopp am Huegel und ein Abendspaziergang in Badacsony oder Szigliget koennen gut in denselben Tag passen."
  ]}
  heroImage={heroImage}
  heroAlt="Klares Balaton-Ufer im Sommerlicht"
  supportImage={supportImage}
  supportAlt="Zeugenberge nahe Balaton-Programmen"
  supportTitle="Erst die Seestimmung waehlen."
  supportText="Familienstrand, Spaziergang am Wasser, Abendessen in Badacsony oder ein ruhiger Nachmittag bei Szigliget: die Region gibt mehrere gute Richtungen."
  highlights={["Straende in kurzer Fahrt", "Badacsony, Szigliget und Abrahamhegy", "Kajak, Kanu und SUP saisonal moeglich", "einfache Programme fuer Familien, Paare und Sommerabende"]}
  primaryLink={{ label: "Unterkuenfte ansehen", href: "/de/unterkuenfte/" }}
  secondaryLink={{ label: "Zurueck zu Erlebnissen", href: "/de/erlebnisse/" }}
  sections={[
    {
      title: "Straende und Balaton-Orte",
      cards: [
        { title: "Szigliget Strand", body: "Eine gute Wahl fuer Familien, Schwimmen und klassische Sommertage." },
        { title: "Abrahamhegy Strand", body: "Ruhiger und familienfreundlich, gut fuer einen einfachen Tag am Wasser." },
        { title: "Badacsony und Badacsonytomaj", body: "Gut, wenn Baden mit Weinterrassen, Abendessen oder Spaziergang verbunden werden soll." },
        { title: "Badacsonylabdihegy", body: "Praktisch, wenn Strandzeit und Wasserprogramme wie Kajak, Kanu oder SUP zusammenpassen sollen." }
      ]
    },
    {
      title: "Wasserprogramme",
      cards: [
        { title: "Kajak und Kanu", body: "Saisonal und anbieterabhaengig; vom Wasser wird der Blick auf Badacsony, Szigliget und Szent Gyorgy-hegy besonders schoen." },
        { title: "SUP", body: "Bei ruhigem Wetter eine leichte Art, Zeit auf dem Wasser zu verbringen." },
        { title: "Bootsprogramme", body: "Saisonal, wetter- und anbieterabhaengig. Verfuegbarkeit und Regeln bitte aktuell pruefen." }
      ]
    }
  ]}
/>
