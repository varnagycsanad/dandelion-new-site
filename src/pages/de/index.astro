---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Hero from "../../sections/Hero.astro";
import PanoramaPoolHighlight from "../../sections/PanoramaPoolHighlight.astro";
import HomeReviews from "../../sections/HomeReviews.astro";
import HomeRegionGuide from "../../sections/HomeRegionGuide.astro";
import RegionStories from "../../sections/RegionStories.astro";
import Experiences from "../../sections/Experiences.astro";
import NewsletterSignup from "../../sections/NewsletterSignup.astro";
import GoogleRegionMap from "../../sections/GoogleRegionMap.astro";
import HomeGeoFaq from "../../sections/HomeGeoFaq.astro";
import bikingImage from "../../assets/home/experiences/dandelion-home-experience-bike-01-mobile-optimized.webp";
import wineTourImage from "../../assets/home/experiences/dandelion-home-experience-wine-gastro-01-optimized.webp";
import balatonImage from "../../assets/home/experiences/dandelion-home-experience-balaton-01.webp";
import mountainsImage from "../../assets/home/experiences/dandelion-home-experience-tanuhegyek-01.webp";
import kisapatiStoryImage from "../../assets/home/region-stories/dandelion-home-tanuhegyek-story-01.webp";
import balatonStoryImage from "../../assets/home/region-stories/dandelion-home-balaton-story-02.webp";
import kaliStoryImage from "../../assets/accommodations/koveskal/gallery/dandelion-koveskal-source-001.webp";
import { buildVideoObject } from "../../data/video-seo";
import { buildHomeGeoFaqStructuredData } from "../../data/home-geo-faq";

const deTitle = "Dandelion Gästehäuser | Unterkünfte am Balaton";
const deDescription =
  "Gästehäuser rund um Szent György-hegy, Balaton und Káli-Becken, mit Terrassen, Ausblicken, Pooltagen und Direktbuchung.";
const englishBookingHref = "https://ibe.sabeeapp.com/v3/p/Dandelion-Vendégházak?p=3970b30e1042d58f&lang=En";

// [CHANGE 2026-05-29 00:00] German homepage hero video now has poster and VideoObject data for Google indexing.
const homepageHeroVideo = "/videos/fooldal/hero/DND_Fooldal_hero_05-21.mp4?v=20260521";
const homepageHeroMobileVideo = "/videos/fooldal/hero/DND_Fooldal_hero_05-21-mobile-lite.mp4?v=20260606-mobile-lite";
const homepageHeroPoster = kisapatiStoryImage.src;
const homepageVideoStructuredData = buildVideoObject({
  id: "/de/#homepage-hero-video",
  name: "Dandelion Gästehäuser Startseitenvideo",
  description: "Startseitenvideo der Dandelion Gästehäuser nahe dem Balaton.",
  contentUrl: homepageHeroVideo,
  thumbnailUrl: homepageHeroPoster,
  uploadDate: "2026-05-21T00:00:00+02:00",
  inLanguage: "de-DE"
});
const homepageStructuredData = [homepageVideoStructuredData, buildHomeGeoFaqStructuredData("de")];

const germanRegionStories = [
  {
    kicker: "Kisapáti - Szent György-hegy - Tapolca-Becken",
    title: "Zwischen den Zeugenbergen",
    description: "Weinreihen, ruhige Wege und langsame Morgen prägen diese Seite des Balaton-Oberlands.",
    meta: "Ein ruhiger Ausgangspunkt nahe Szent György-hegy.",
    ctaLabel: "Unterkünfte an den Hügeln ansehen",
    mobileCtaLabel: "Hügel-Unterkünfte",
    ctaHref: "/de/unterkuenfte/#zeugenberge",
    image: kisapatiStoryImage,
    imageAlt: "Kisapáti und Zeugenberge im Balaton-Oberland"
  },
  {
    kicker: "Keszthely - Badacsonyörs - Balaton",
    title: "Nah am See",
    description: "Leichte Balaton-Tage, Uferorte und Sommerabende. Keszthely und Badacsonyörs passen, wenn Sie nah am Ufer bleiben möchten.",
    meta: "Für Gäste, die den Balaton nahe haben möchten.",
    ctaLabel: "Unterkünfte am Balaton ansehen",
    mobileCtaLabel: "Balaton-Unterkünfte",
    ctaHref: "/de/unterkuenfte/#balaton-naehe",
    image: balatonStoryImage,
    imageAlt: "Dandelion Unterkunft nahe dem Balaton"
  },
  {
    kicker: "Köveskál - Káli-Becken",
    title: "Die ruhigere Káli-Seite",
    description: "Steinmauern, Dorfstraßen und offene Landschaft. Köveskál passt, wenn Sie die dörflichere Seite des Balaton-Oberlands suchen.",
    meta: "Gut für langsame Tage, Weinwege und Dorfspaziergänge.",
    ctaLabel: "Unterkunft im Káli-Becken ansehen",
    mobileCtaLabel: "Káli-Becken",
    ctaHref: "/de/unterkuenfte/#kali-becken",
    image: kaliStoryImage,
    imageAlt: "Káli-Becken Landschaft nahe Köveskál"
  }
];

const germanExperiences = [
  {
    title: "RADFAHREN",
    description: "Dorfstraßen, Weinberge und sanfte Hügel für leichte Touren.",
    image: bikingImage,
    imageAlt: "Radroute im Balaton-Oberland",
    href: "/de/fahrradverleih/"
  },
  {
    title: "WEIN UND GASTRONOMIE",
    description: "Keller, Terrassen und kleine Stopps rund um die Hügel.",
    image: wineTourImage,
    imageAlt: "Wein und Gastronomie im Balaton-Oberland",
    href: "/de/weingueter/"
  },
  {
    title: "BALATON",
    description: "Strände, Uferorte und einfache Sommerprogramme in der Nähe.",
    image: balatonImage,
    imageAlt: "Badacsony und Balaton Panorama",
    href: "/de/balaton/"
  },
  {
    title: "ZEUGENBERGE",
    description: "Aussichtspunkte und Wege rund um Szent György-hegy und Badacsony.",
    image: mountainsImage,
    imageAlt: "Zeugenberge im Balaton-Oberland",
    href: "/de/zeugenberge/"
  }
];

---

<BaseLayout
  title={deTitle}
  description={deDescription}
  canonicalPath="/de/"
  lang="de"
  ogLocale="de_DE"
  structuredData={homepageStructuredData}
>
  <Hero
    titleTopLines={["Ruhige", "Gästehäuser"]}
    titleBottomLines={["nahe", "dem Balaton"]}
    description="Unterkünfte rund um Szent György-hegy, Balaton und Káli-Becken. Terrassen, Ausblicke, Pooltage und Ruhe."
    ctas={[
      { label: "Unterkünfte ansehen", href: "/de/unterkuenfte/" },
      { label: "Verfügbarkeit prüfen", href: englishBookingHref, target: "_blank", rel: "noopener noreferrer" }
    ]}
    videoDesktopSrc={homepageHeroVideo}
    videoMobileSrc={homepageHeroMobileVideo}
    posterSrc={homepageHeroPoster}
    posterAlt="Kisapáti und die Zeugenberge im Balaton-Oberland"
    videoFallbackText="Ihr Browser unterstützt keine Hintergrundvideos."
  />

  <PanoramaPoolHighlight lang="de" />
  <HomeReviews lang="de" />

  <HomeRegionGuide lang="de" />

  <RegionStories
    kickerLabel="Unterkünfte"
    heading="Drei Landschaften, drei Arten anzukommen"
    lead="Wählen Sie zwischen Zeugenbergen, Balaton-Tagen und ruhigeren Dörfern des Káli-Beckens."
    stories={germanRegionStories}
  />

  <Experiences
    sectionId="experiences"
    title="ERLEBNISSE"
    lead="Radfahren, Wein, Balaton und Hügelwege, alles in kurzer Fahrt von den Häusern."
    ctaLabel="ERLEBNISSE PLANEN"
    ctaHref="/de/erlebnisse/"
    mobileCtaLabel="MEHR"
    experiences={germanExperiences}
  />

  <NewsletterSignup lang="de" />
  <HomeGeoFaq lang="de" />
  <GoogleRegionMap lang="de" />
</BaseLayout>
