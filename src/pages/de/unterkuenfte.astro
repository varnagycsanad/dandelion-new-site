---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { accommodations } from "../../data/accommodations";

const stayCopy: Record<string, { name: string; location: string; description: string; facts: string[] }> = {
  "dandelion-d2": {
    name: "Dandelion D2",
    location: "Kisapati / Balaton-Oberland",
    description: "Modernes, familienfreundliches Apartment für 4-6 Gäste mit großem Garten und ruhiger Umgebung.",
    facts: ["4-6 Gäste", "2 Schlafzimmer + Wohnbereich", "Garten", "Klimaanlage"]
  },
  fugehaz: {
    name: "Dandelion Fügeház",
    location: "Nahe Szent György-hegy",
    description: "Panoramahaus für 4-6 Gäste mit Terrassen und entspannter Aufteilung für Familien.",
    facts: ["4-6 Gäste", "2 Ebenen", "Panorama", "Hot Tub"]
  },
  "dandelion-d1": {
    name: "Dandelion D1",
    location: "Kisapati / Balaton-Oberland",
    description: "Großzügiges Gästehaus für 6-8 Gäste mit drei Schlafzimmern und Terrasse.",
    facts: ["6-8 Gäste", "3 Schlafzimmer", "2 Badezimmer", "Terrasse"]
  },
  "szololiget-vendeghaz": {
    name: "Dandelion Szőlőliget",
    location: "Kisapati / Szent György-hegy",
    description: "Freistehendes Haus für 2-4 Gäste mit Terrasse und ruhiger Hanglage.",
    facts: ["2-4 Gäste", "1 Schlafzimmer + Wohnbereich", "Terrasse", "Panorama"]
  },
  "zsalya-vendeghaz": {
    name: "Dandelion Zsálya",
    location: "Kisapati / Szent György-hegy",
    description: "Freistehendes Gästehaus für 4 Gäste mit überdachter Terrasse und ruhiger Umgebung.",
    facts: ["2-4 Gäste", "2 Schlafzimmer", "Überdachte Terrasse", "Klimaanlage"]
  },
  "vintage-vendeghaz": {
    name: "Dandelion Vintage",
    location: "Nemesgulács / Balaton-Oberland",
    description: "Gemütliches Gästehaus mit eigenem Hof und guter Lage für Ausflüge rund um den Balaton.",
    facts: ["Gästehaus", "2 Schlafzimmer", "Eigener Hof", "Nemesgulács"]
  },
  "royal-homes": {
    name: "Dandelion Royal Homes",
    location: "Keszthely / Balaton",
    description: "Apartment nahe am Wasser mit Terrasse und komfortabler Ausstattung.",
    facts: ["4-6 Gäste", "Direkt am Wasser", "2 Schlafzimmer + Wohnbereich", "Keszthely"]
  },
  "szepvolgyi-vendeghaz": {
    name: "Dandelion Szépvölgyi",
    location: "Badacsonyörs / Balaton",
    description: "Großes Ferienhaus für bis zu 8 Gäste mit Balaton-Panorama und viel Platz.",
    facts: ["8 Gäste", "4 Schlafzimmer", "Balaton-Panorama", "2 Badezimmer"]
  },
  "dandelion-koveskal": {
    name: "Dandelion Köveskál",
    location: "Köveskál / Káli-Becken",
    description: "Ruhiges Gästehaus im Káli-Becken, gut für langsame Tage und Ausflüge in die Umgebung.",
    facts: ["Gästehaus", "Káli-Becken", "Ruhiges Dorf", "Kontaktanfrage"]
  }
};

const detailHrefBySlug: Record<string, string> = {
  "dandelion-d1": "/de/dandelion-d1/",
  "dandelion-d2": "/de/dandelion-d2/",
  fugehaz: "/de/dandelion-fugehaz/",
  "zsalya-vendeghaz": "/de/dandelion-zsalya/",
  "szololiget-vendeghaz": "/de/szololiget/",
  "szepvolgyi-vendeghaz": "/de/szepvolgyi/",
  "royal-homes": "/de/royal/",
  "vintage-vendeghaz": "/de/dandelion-vintage/",
  "dandelion-koveskal": "/de/dandelion-koveskal/"
};
---

<BaseLayout
  title="Unterkünfte am Balaton | Dandelion Gästehäuser"
  description="Dandelion Unterkünfte im Balaton-Oberland, bei Badacsony, Keszthely und im Káli-Becken."
  canonicalPath="/de/unterkuenfte/"
  lang="de"
  ogLocale="de_DE"
>
  <section class="de-stays">
    <div class="dnd-container de-stays__inner">
      <div class="de-stays__hero">
        <span class="de-stays__eyebrow">Unterkünfte</span>
        <h1>Dandelion Hauser und Apartments rund um den Balaton.</h1>
        <p>
          Die deutschen Detailseiten sind vorbereitet. Diese Ubersicht hilft bei der ersten
          Orientierung und führt von jeder Unterkunft direkt zur passenden Seite.
        </p>
      </div>

      <div class="de-stays__grid">
        {accommodations.map((stay) => {
          const copy = stayCopy[stay.slug];
          return (
            <article class="de-stay-card" id={stay.slug}>
              <span class="de-stay-card__location">{copy.location}</span>
              <h2>{copy.name}</h2>
              <p>{copy.description}</p>
              <ul>
                {copy.facts.map((fact) => (
                  <li>{fact}</li>
                ))}
              </ul>
              <a href={detailHrefBySlug[stay.slug] ?? "/de/kontakt/"}>
                {detailHrefBySlug[stay.slug] ? "Details ansehen" : "Anfrage senden"}
              </a>
            </article>
          );
        })}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .de-stays {
    padding: 132px 0 88px;
    background: #fcfbf8;
  }

  .de-stays__inner {
    display: grid;
    gap: 34px;
  }

  .de-stays__hero {
    max-width: 860px;
  }

  .de-stays__eyebrow,
  .de-stay-card__location {
    display: inline-block;
    margin-bottom: 10px;
    color: #b67b20;
    font-size: var(--dnd-text-2xs);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .de-stays h1 {
    margin: 0;
    color: #261d16;
    font-family: var(--dnd-font-display);
    font-size: clamp(2.2rem, 4vw, 3.8rem);
    font-weight: 500;
    line-height: 1.05;
  }

  .de-stays__hero p,
  .de-stay-card p {
    color: rgba(38, 29, 22, 0.76);
    font-size: var(--dnd-text-body);
    line-height: 1.72;
  }

  .de-stays__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
  }

  .de-stay-card {
    display: grid;
    gap: 12px;
    padding: 22px;
    border: 1px solid rgba(88, 63, 38, 0.12);
    border-radius: 18px;
    background: #fff;
    box-shadow: 0 18px 48px rgba(48, 34, 20, 0.06);
  }

  .de-stay-card h2 {
    margin: 0;
    color: #261d16;
    font-family: var(--dnd-font-display);
    font-size: 1.8rem;
    font-weight: 500;
  }

  .de-stay-card ul {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .de-stay-card li {
    padding: 7px 10px;
    border-radius: 999px;
    background: #f7f2ea;
    color: rgba(38, 29, 22, 0.78);
    font-size: var(--dnd-text-xs);
    font-weight: 700;
  }

  .de-stay-card a {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 42px;
    padding: 0 18px;
    border-radius: 999px;
    background: #d99e2b;
    color: #1b140f;
    font-weight: 700;
    text-decoration: none;
  }

  @media (max-width: 980px) {
    .de-stays__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 680px) {
    .de-stays {
      padding: 108px 0 64px;
    }

    .de-stays__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
