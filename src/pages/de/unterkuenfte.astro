---
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { accommodationSections, accommodations } from "../../data/accommodations";
import { SITE_NAME, toAbsoluteUrl } from "../../data/site-seo";
import { readHomepageImageMapping } from "../../lib/homepage-image-mapping";

const imageMapping = await readHomepageImageMapping();
const englishBookingHref = "https://ibe.sabeeapp.com/v3/p/Dandelion-Vendégházak?p=3970b30e1042d58f&lang=En";
const accommodationsOgImage = "/images/pages/szallasok-hero-bg.webp";
const accommodationsOgImageAlt = "Dandelion Gästehäuser Unterkunftsauswahl im Balaton-Oberland";

const sectionCopy = {
  upland: {
    anchorId: "zeugenberge",
    eyebrow: "Szent György-hegy / Tapolca-Becken / Kisapáti / Nemesgulács",
    title: "Zwischen den Zeugenbergen",
    subtitle:
      "Wanderwege, Weingüter und unterschiedliche Haustypen in derselben Region. Eine gute Wahl, wenn Sie die klassische Seite des Balaton-Oberlands suchen.",
    audienceText: "Für Panorama, Weinberge, Ausflüge und mehrere Haustypen in einer Region."
  },
  shore: {
    anchorId: "balaton-naehe",
    eyebrow: "Keszthely / Badacsonyörs / Balaton-Nähe",
    title: "Leichte Tage am Balaton",
    subtitle:
      "Näher an Stränden, Uferorten und Sommerprogrammen. Eine gute Wahl, wenn Wasser, einfache Wege und bequeme Erreichbarkeit wichtig sind.",
    audienceText: "Für Strandtage, Balaton-Programme und praktische Wege."
  },
  kali: {
    anchorId: "kali-becken",
    eyebrow: "Köveskál / Káli-Becken / ruhige Auszeit",
    title: "Die ruhigere Seite des Káli-Beckens",
    subtitle:
      "Köveskál und das Káli-Becken stehen für eine ruhigere, dörfliche Atmosphäre. Gut, wenn Sie weniger Trubel und mehr Rückzug suchen.",
    audienceText: "Für langsamere Tage, Dorfstimmung, Wein und zurückgezogene Erholung."
  }
} as const;

const stayCopy: Record<string, { name: string; location: string; description: string; hoverText: string; chips: { label: string; type?: "default" | "accent" | "blue" | "green" | "purple" }[]; href: string }> = {
  "dandelion-d2": {
    name: "Dandelion D2",
    location: "Kisapáti / Balaton-Oberland",
    description: "Modernes, familienfreundliches Apartment für 4-6 Gäste mit großem Garten, Hot Tub und guter Lage für Ausflüge.",
    hoverText: "4-6 Gäste, Garten, Hot Tub und ruhige Tage.",
    href: "/de/dandelion-d2/",
    chips: [
      { label: "4-6 Gäste", type: "accent" },
      { label: "2 Schlafzimmer + Wohnbereich" },
      { label: "Hot Tub", type: "blue" },
      { label: "Klimaanlage", type: "blue" },
      { label: "Familienfreundlich", type: "purple" },
      { label: "Kamin" }
    ]
  },
  fugehaz: {
    name: "Dandelion Fügeház",
    location: "Nahe Szent György-hegy",
    description: "Panoramahaus für 4-6 Gäste mit Terrassen, Hot Tub und entspannter Aufteilung für Familien oder Freunde.",
    hoverText: "4-6 Gäste, Panorama, Terrassen und Hot Tub.",
    href: "/de/dandelion-fugehaz/",
    chips: [
      { label: "4-6 Gäste", type: "accent" },
      { label: "2 Ebenen" },
      { label: "Panorama", type: "green" },
      { label: "Hot Tub", type: "blue" },
      { label: "Klimaanlage", type: "blue" },
      { label: "Kamin" }
    ]
  },
  "dandelion-d1": {
    name: "Dandelion D1",
    location: "Kisapáti / Balaton-Oberland",
    description: "Großzügiges Ferienhaus für 6-8 Gäste mit drei Schlafzimmern, Terrasse, Garten und viel Platz für gemeinsame Tage.",
    hoverText: "6-8 Gäste, drei Schlafzimmer und viel Platz.",
    href: "/de/dandelion-d1/",
    chips: [
      { label: "6-8 Gäste", type: "accent" },
      { label: "3 Schlafzimmer" },
      { label: "Panorama-Terrasse", type: "green" },
      { label: "2 Badezimmer" },
      { label: "Klimaanlage", type: "blue" },
      { label: "Großer Garten", type: "green" }
    ]
  },
  "szololiget-vendeghaz": {
    name: "Dandelion Szőlőliget",
    location: "Kisapáti / Szent György-hegy",
    description: "Freistehendes Haus für 2-4 Gäste mit großer Terrasse, Weinberglage und ruhiger Aussicht.",
    hoverText: "2-4 Gäste, Terrasse und langsamer Weinberg-Rhythmus.",
    href: "/de/szololiget/",
    chips: [
      { label: "2-4 Gäste", type: "accent" },
      { label: "1 Schlafzimmer + Wohnbereich" },
      { label: "Terrasse", type: "green" },
      { label: "Panorama", type: "green" },
      { label: "Klimaanlage", type: "blue" },
      { label: "Ruhige Lage", type: "purple" }
    ]
  },
  "zsalya-vendeghaz": {
    name: "Dandelion Zsálya",
    location: "Kisapáti / Szent György-hegy",
    description: "Freistehendes Gästehaus für 2-4 Gäste mit überdachter Terrasse und naturnaher, ruhiger Umgebung.",
    hoverText: "2-4 Gäste, Überdachte Terrasse und ruhige Hanglage.",
    href: "/de/dandelion-zsalya/",
    chips: [
      { label: "2-4 Gäste", type: "accent" },
      { label: "2 Schlafzimmer" },
      { label: "Überdachte Terrasse", type: "green" },
      { label: "Klimaanlage", type: "blue" },
      { label: "Naturnah", type: "purple" }
    ]
  },
  "vintage-vendeghaz": {
    name: "Dandelion Vintage",
    location: "Nemesgulács / Balaton-Oberland",
    description: "Gemütliches Gästehaus mit eigenem Hof, zwei Schlafzimmern und guter Lage für Badacsony, Szigliget und Balaton-Tage.",
    hoverText: "Nemesgulács, eigener Hof und entspannte Dorfstimmung.",
    href: "/de/dandelion-vintage/",
    chips: [
      { label: "Gästehaus", type: "accent" },
      { label: "2 Schlafzimmer" },
      { label: "Eigener Hof", type: "green" },
      { label: "Klimaanlage", type: "blue" },
      { label: "Nemesgulács" },
      { label: "Vintage-Stimmung" }
    ]
  },
  "royal-homes": {
    name: "Dandelion Royal Homes",
    location: "Keszthely / Balaton",
    description: "Komfortables Apartment nahe am Wasser mit Terrasse und praktischer Lage für Keszthely, Strandtage und Stadtprogramme.",
    hoverText: "4-6 Gäste, Balaton-Nähe und Keszthely-Programme.",
    href: "/de/royal/",
    chips: [
      { label: "4-6 Gäste", type: "accent" },
      { label: "Nahe am Wasser", type: "blue" },
      { label: "2 Schlafzimmer + Wohnbereich" },
      { label: "Terrasse oder Balkon", type: "green" },
      { label: "Klimaanlage", type: "blue" },
      { label: "Keszthely" }
    ]
  },
  "szepvolgyi-vendeghaz": {
    name: "Dandelion Szépvölgyi",
    location: "Badacsonyörs / Balaton",
    description: "Großes Ferienhaus für bis zu 8 Gäste mit vier Schlafzimmern, Balaton-Panorama und viel Platz für Familien oder Freunde.",
    hoverText: "Bis 8 Gäste, vier Schlafzimmer und Balaton-Panorama.",
    href: "/de/szepvolgyi/",
    chips: [
      { label: "8 Gäste", type: "accent" },
      { label: "4 Schlafzimmer" },
      { label: "Balaton-Panorama", type: "green" },
      { label: "2 Badezimmer" },
      { label: "Klimaanlage", type: "blue" },
      { label: "Badacsonyörs" }
    ]
  },
  "dandelion-koveskal": {
    name: "Dandelion Köveskál",
    location: "Köveskál / Káli-Becken",
    description: "Ruhiges Gästehaus in Köveskál, gut für langsame Tage, regionale Gastronomie, Wein und kleine Ausflüge im Káli-Becken.",
    hoverText: "Köveskál, ruhige Dorfstimmung und Káli-Becken.",
    href: "/de/dandelion-koveskal/",
    chips: [
      { label: "Gästehaus", type: "accent" },
      { label: "Köveskál" },
      { label: "Káli-Becken", type: "green" },
      { label: "Naturnah", type: "green" },
      { label: "Ruhiges Dorf", type: "purple" },
      { label: "Wein und Gastronomie" }
    ]
  }
};

const sections = accommodationSections.map((section) => ({
  ...section,
  ...sectionCopy[section.key],
  stays: accommodations
    .filter((stay) => stay.section === section.key)
    .map((stay) => ({
      ...stay,
      ...stayCopy[stay.slug],
      image: imageMapping[stay.imageSlot]
    }))
}));

const accommodationsStructuredData = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "@id": `${toAbsoluteUrl("/de/unterkuenfte/")}#collection`,
  name: "Unterkünfte bei Dandelion Gästehäusern",
  url: toAbsoluteUrl("/de/unterkuenfte/"),
  inLanguage: "de-DE",
  description: "Regionale Unterkunftsauswahl der Dandelion Gästehäuser im Balaton-Oberland, am Balaton und im Káli-Becken.",
  isPartOf: {
    "@id": `${toAbsoluteUrl("/")}#website`
  },
  mainEntity: {
    "@type": "ItemList",
    itemListElement: sections.flatMap((section, sectionIndex) =>
      section.stays.map((stay, stayIndex) => ({
        "@type": "ListItem",
        position: sectionIndex * 10 + stayIndex + 1,
        url: toAbsoluteUrl(stay.href),
        name: stay.name
      }))
    )
  },
  about: ["Balaton-Oberland", "Zeugenberge", "Balaton", "Káli-Becken"],
  provider: {
    "@type": "LodgingBusiness",
    name: SITE_NAME,
    url: toAbsoluteUrl("/")
  }
};
---

<BaseLayout
  title="Unterkünfte am Balaton | Dandelion Gästehäuser"
  description="Wählen Sie zuerst die Region und finden Sie dann das passende Dandelion Gästehaus bei den Zeugenbergen, am Balaton oder im Káli-Becken."
  canonicalPath="/de/unterkuenfte/"
  lang="de"
  ogLocale="de_DE"
  ogImage={accommodationsOgImage}
  ogImageAlt={accommodationsOgImageAlt}
  structuredData={accommodationsStructuredData}
>
  <section class="dnd-accommodations-hero">
    <div class="dnd-accommodations-hero__content">
      <div class="dnd-container dnd-accommodations-hero__inner">
        <div class="dnd-accommodations-hero__text">
          <p class="dnd-accommodations-hero__eyebrow">Unterkünfte</p>
          <h1 class="dnd-accommodations-hero__title">
            <span>Erst die Region wählen,</span>
            <span>dann das Haus ansehen.</span>
          </h1>
          <p class="dnd-accommodations-hero__lead">
            Die Dandelion Unterkünfte liegen in drei unterschiedlichen Landschaften: zwischen den Zeugenbergen, nah am Balaton und im ruhigeren Káli-Becken.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="dnd-accommodations-picker" aria-labelledby="unterkuenfte-regionen-title">
    <div class="dnd-container">
      <div class="dnd-accommodations-picker__intro">
        <p class="dnd-accommodations-picker__eyebrow">Schnellauswahl</p>
        <h2 id="unterkuenfte-regionen-title">Welche Region passt zu Ihrer Reise?</h2>
        <p>
          Wählen Sie zuerst nach Landschaft und Tagesrhythmus: Zeugenberge, Balaton-Nähe oder die ruhigere Seite des Káli-Beckens.
        </p>
      </div>

      <div class="dnd-accommodations-picker__grid">
        {sections.map((section) => (
          <a class="dnd-region-picker-card" href={`#${section.anchorId}`}>
            <span class="dnd-region-picker-card__eyebrow">{section.eyebrow}</span>
            <strong class="dnd-region-picker-card__title">{section.title}</strong>
            <span class="dnd-region-picker-card__text">{section.audienceText}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <div id="unterkuenfte-liste" class="dnd-apts-anchor">
    <div id="dnd-apts-final" lang="de">
      <div class="dnd-wrap">
        {sections.map((section) => (
          <section id={section.anchorId} class="dnd-section dnd-region-block">
            <div class="dnd-region-block__header">
              <p class="dnd-eyebrow">{section.eyebrow}</p>
              <h2 class="dnd-h2">{section.title}</h2>
              <p class="dnd-sub">{section.subtitle}</p>
              <p class="dnd-region-block__audience">{section.audienceText}</p>
            </div>

            <div class={`dnd-grid ${section.gridClass}`}>
              {section.stays.map((stay) => {
                const primaryChips = stay.chips.slice(0, 3);
                const secondaryChips = stay.chips.slice(3, 6);
                const cardContent = (
                  <>
                    <div class="dnd-media">
                      {stay.image ? (
                        stay.image.astroSrc ? (
                          <Image src={stay.image.astroSrc} alt={stay.image.altText || stay.name} loading="lazy" />
                        ) : (
                          <img
                            src={stay.image.sourceUrl}
                            alt={stay.image.altText || stay.name}
                            width={stay.image.width || 1600}
                            height={stay.image.height || 1067}
                            loading="lazy"
                          />
                        )
                      ) : (
                        <div class="dnd-media-placeholder" aria-label={`${stay.name} Bild folgt`}>
                          <span>{stay.name}</span>
                          <small>Bild folgt</small>
                        </div>
                      )}
                      {stay.badge && <div class="dnd-badge">{stay.badge}</div>}
                      <div class="dnd-overlay"></div>
                      <p class="dnd-hover-text">{stay.hoverText}</p>
                    </div>
                    <div class="dnd-info">
                      <div class="dnd-title-row">
                        <h3 class="dnd-title">{stay.name}</h3>
                        <span class="dnd-location">{stay.location}</span>
                      </div>
                      <div class="dnd-card-highlights" aria-label={`${stay.name} Hauptmerkmale`}>
                        {primaryChips.map((chip) => (
                          <span class={`dnd-chip${chip.type && chip.type !== "default" ? ` dnd-chip--${chip.type}` : ""}`}>
                            {chip.label}
                          </span>
                        ))}
                      </div>
                      <p class="dnd-description">{stay.description}</p>
                      <div class="dnd-chips" aria-label={`${stay.name} weitere Merkmale`}>
                        {secondaryChips.map((chip) => (
                          <span class={`dnd-chip${chip.type && chip.type !== "default" ? ` dnd-chip--${chip.type}` : ""} dnd-chip--secondary`}>
                            {chip.label}
                          </span>
                        ))}
                      </div>
                      <span class="dnd-card-cta">Details ansehen</span>
                    </div>
                  </>
                );

                return (
                  <a class="dnd-card is-link" href={stay.href}>
                    {cardContent}
                  </a>
                );
              })}
            </div>
          </section>
        ))}
      </div>
    </div>
  </div>

  <section class="dnd-accommodations-closing" aria-labelledby="unterkuenfte-closing-title">
    <div class="dnd-container">
      <div class="dnd-accommodations-closing__inner">
        <h2 id="unterkuenfte-closing-title">Noch unsicher, welche Unterkunft passt?</h2>
        <p>
          Schreiben Sie uns kurz, mit wie vielen Gästen Sie reisen und welche Art von Aufenthalt Sie suchen. Wir helfen bei der Auswahl.
        </p>
        <div class="dnd-accommodations-closing__actions">
          <a class="dnd-accommodations-closing__cta" href={englishBookingHref} target="_blank" rel="noopener noreferrer">Verfügbarkeit prüfen</a>
          <a class="dnd-accommodations-closing__cta dnd-accommodations-closing__cta--secondary" href="/de/kontakt/">
            Hilfe bei der Auswahl
          </a>
        </div>
        <p class="dnd-accommodations-closing__note">
          Über die Kontaktseite können Sie uns auch direkt schreiben, wenn Sie eine kurze Abstimmung wünschen.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .dnd-accommodations-hero {
    position: relative;
    box-sizing: border-box;
    min-height: calc(600px + 118px);
    height: calc(84vh + 118px);
    padding-top: 118px;
    overflow: hidden;
    background-image: linear-gradient(180deg, rgba(15, 16, 15, 0.18), rgba(15, 16, 15, 0.32)),
      url("/images/pages/szallasok-hero-bg.webp");
    background-position: center 28%;
    background-size: cover;
  }

  .dnd-accommodations-hero__content {
    position: relative;
    z-index: 1;
    min-height: 100%;
    color: #fff;
  }

  .dnd-accommodations-hero__inner {
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    align-items: center;
    min-height: 100%;
    max-width: none;
    padding: clamp(168px, 24vh, 236px) clamp(48px, 7vw, 96px) 88px;
  }

  .dnd-accommodations-hero__text {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: min(100%, 1040px);
    text-align: center;
  }

  .dnd-accommodations-hero__eyebrow {
    margin: 0 0 12px;
    color: rgba(255, 250, 241, 0.88);
    font-size: var(--dnd-text-xs);
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .dnd-accommodations-hero__title {
    margin: 0;
    color: rgba(255, 255, 255, 0.94);
    font-size: clamp(30px, 2.35vw, 42px);
    line-height: 1.08;
    font-family: var(--dnd-font-display);
    font-weight: 400;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .dnd-accommodations-hero__title span {
    display: inline;
  }

  .dnd-accommodations-hero__lead {
    max-width: 40ch;
    margin: 18px auto 0;
    color: rgba(255, 255, 255, 0.84);
    font-size: var(--dnd-text-lead);
    line-height: 1.55;
  }

  .dnd-accommodations-picker {
    margin-top: 26px;
    position: relative;
    z-index: 2;
  }

  .dnd-accommodations-picker__intro {
    max-width: 700px;
    margin-bottom: 18px;
  }

  .dnd-accommodations-picker__eyebrow {
    margin: 0 0 10px;
    color: #b06200;
    font-size: var(--dnd-text-xs);
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .dnd-accommodations-picker__intro h2 {
    margin: 0;
    color: #1f2937;
    font-family: var(--dnd-font-display);
    font-size: clamp(1.55rem, 2.5vw, 2.2rem);
    font-weight: 400;
    line-height: 1.12;
  }

  .dnd-accommodations-picker__intro p:last-child {
    max-width: 58ch;
    margin: 12px 0 0;
    color: #5d554b;
    line-height: 1.6;
  }

  .dnd-accommodations-picker__grid {
    display: grid;
    gap: 14px;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .dnd-region-picker-card {
    display: grid;
    gap: 8px;
    min-height: 168px;
    padding: 18px;
    border: 1px solid rgba(217, 158, 43, 0.18);
    border-radius: 18px;
    background: rgba(255, 251, 245, 0.96);
    box-shadow: 0 10px 26px rgba(42, 31, 17, 0.06);
    transition: transform 0.22s ease, box-shadow 0.22s ease, border-color 0.22s ease;
  }

  .dnd-region-picker-card:hover,
  .dnd-region-picker-card:focus-visible {
    border-color: rgba(217, 158, 43, 0.4);
    box-shadow: 0 14px 30px rgba(42, 31, 17, 0.09);
    transform: translateY(-2px);
  }

  .dnd-region-picker-card__eyebrow {
    color: #8b6a33;
    font-size: var(--dnd-text-2xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 1.5;
    text-transform: uppercase;
  }

  .dnd-region-picker-card__title {
    color: #1f2937;
    font-size: var(--dnd-text-lead);
    line-height: 1.25;
  }

  .dnd-region-picker-card__text {
    color: #5b5348;
    font-size: var(--dnd-text-body);
    line-height: 1.5;
  }

  .dnd-apts-anchor {
    scroll-margin-top: 116px;
  }

  #dnd-apts-final {
    --accent: #f7941d;
    --text: #1f2937;
    --muted: #6b7280;
    --card: #ffffff;
    --c-gray-bg: #f3f4f6;
    --c-gray-txt: #374151;
    --c-accent-bg: rgba(247, 148, 29, 0.12);
    --c-accent-txt: #b06200;
    --c-blue-bg: #e0f2fe;
    --c-blue-txt: #0369a1;
    --c-green-bg: #dcfce7;
    --c-green-txt: #15803d;
    --c-purple-bg: #f3e8ff;
    --c-purple-txt: #6b21a8;
    --radius: 16px;
    --shadow: 0 8px 24px rgba(23, 18, 12, 0.06);
    --shadow2: 0 14px 34px rgba(23, 18, 12, 0.1);
    --max: 1320px;
    --pad: 16px;
    --gap: 18px;
    --card-h: 100%;
    --img-h: 300px;
    --title: 20px;
    --chipfs: 11px;
    display: block !important;
    width: 100% !important;
    clear: both !important;
    padding: 32px 0 48px;
    color: var(--text);
    box-sizing: border-box;
    font-family: var(--dnd-font-body);
  }

  #dnd-apts-final * {
    box-sizing: border-box;
  }

  #dnd-apts-final a {
    color: inherit;
    text-decoration: none;
  }

  #dnd-apts-final .dnd-wrap {
    display: block !important;
    width: 100% !important;
    max-width: var(--max);
    margin: 0 auto;
    padding: 0 var(--pad);
  }

  #dnd-apts-final .dnd-section {
    display: block !important;
    width: 100% !important;
    margin: 0 0 34px;
    scroll-margin-top: 120px;
  }

  #dnd-apts-final .dnd-eyebrow {
    margin: 0 0 8px;
    color: var(--accent);
    font-size: var(--dnd-text-2xs);
    font-weight: 650;
    letter-spacing: 0.12em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  #dnd-apts-final .dnd-h2 {
    margin: 0 0 6px;
    font-size: 29px;
    line-height: 1.15;
    font-weight: 700;
