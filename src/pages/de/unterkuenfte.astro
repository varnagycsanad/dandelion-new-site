---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { accommodations } from "../../data/accommodations";

const stayCopy: Record<string, { name: string; location: string; description: string; facts: string[] }> = {
  "dandelion-d2": {
    name: "Dandelion D2",
    location: "Kisapati / Balaton-Oberland",
    description: "Modernes, familienfreundliches Apartment fur 4-6 Gaste mit grossem Garten und ruhiger Umgebung.",
    facts: ["4-6 Gaste", "2 Schlafzimmer + Wohnbereich", "Garten", "Klimaanlage"]
  },
  fugehaz: {
    name: "Dandelion Fugehaz",
    location: "Nahe Szent Gyorgy-hegy",
    description: "Panoramahaus fur 4-6 Gaste mit Terrassen und entspannter Aufteilung fur Familien.",
    facts: ["4-6 Gaste", "2 Ebenen", "Panorama", "Hot Tub"]
  },
  "dandelion-d1": {
    name: "Dandelion D1",
    location: "Kisapati / Balaton-Oberland",
    description: "Grosszugiges Gastehaus fur 6-8 Gaste mit drei Schlafzimmern und Terrasse.",
    facts: ["6-8 Gaste", "3 Schlafzimmer", "2 Badezimmer", "Terrasse"]
  },
  "szololiget-vendeghaz": {
    name: "Dandelion Szololiget",
    location: "Kisapati / Szent Gyorgy-hegy",
    description: "Freistehendes Haus fur 2-4 Gaste mit Terrasse und ruhiger Hanglage.",
    facts: ["2-4 Gaste", "1 Schlafzimmer + Wohnbereich", "Terrasse", "Panorama"]
  },
  "zsalya-vendeghaz": {
    name: "Dandelion Zsalya",
    location: "Kisapati / Szent Gyorgy-hegy",
    description: "Freistehendes Gastehaus fur 4 Gaste mit uberdachter Terrasse und ruhiger Umgebung.",
    facts: ["2-4 Gaste", "2 Schlafzimmer", "Uberdachte Terrasse", "Klimaanlage"]
  },
  "vintage-vendeghaz": {
    name: "Dandelion Vintage",
    location: "Nemesgulacs / Balaton-Oberland",
    description: "Gemutliches Gastehaus mit eigenem Hof und guter Lage fur Ausfluge rund um den Balaton.",
    facts: ["Gastehaus", "2 Schlafzimmer", "Eigener Hof", "Nemesgulacs"]
  },
  "royal-homes": {
    name: "Dandelion Royal Homes",
    location: "Keszthely / Balaton",
    description: "Apartment nahe am Wasser mit Terrasse und komfortabler Ausstattung.",
    facts: ["4-6 Gaste", "Direkt am Wasser", "2 Schlafzimmer + Wohnbereich", "Keszthely"]
  },
  "szepvolgyi-vendeghaz": {
    name: "Dandelion Szepvolgyi",
    location: "Badacsonyors / Balaton",
    description: "Grosses Ferienhaus fur bis zu 8 Gaste mit Balaton-Panorama und viel Platz.",
    facts: ["8 Gaste", "4 Schlafzimmer", "Balaton-Panorama", "2 Badezimmer"]
  },
  "dandelion-koveskal": {
    name: "Dandelion Koveskal",
    location: "Koveskal / Kali-Becken",
    description: "Ruhiges Gastehaus im Kali-Becken, gut fur langsame Tage und Ausfluge in die Umgebung.",
    facts: ["Gastehaus", "Kali-Becken", "Ruhiges Dorf", "Kontaktanfrage"]
  }
};
---

<BaseLayout
  title="Unterkunfte am Balaton | Dandelion Gastehauser"
  description="Dandelion Unterkunfte im Balaton-Oberland, bei Badacsony, Keszthely und im Kali-Becken."
  canonicalPath="/de/unterkuenfte/"
  lang="de"
  ogLocale="de_DE"
>
  <section class="de-stays">
    <div class="dnd-container de-stays__inner">
      <div class="de-stays__hero">
        <span class="de-stays__eyebrow">Unterkunfte</span>
        <h1>Dandelion Hauser und Apartments rund um den Balaton.</h1>
        <p>
          Die Detailseiten werden auf Deutsch schrittweise vorbereitet. Diese Ubersicht hilft
          bei der ersten Orientierung und fuhrt fur Anfragen direkt zum Kontakt.
        </p>
      </div>

      <div class="de-stays__grid">
        {accommodations.map((stay) => {
          const copy = stayCopy[stay.slug];
          return (
            <article class="de-stay-card" id={stay.slug}>
              <span class="de-stay-card__location">{copy.location}</span>
              <h2>{copy.name}</h2>
              <p>{copy.description}</p>
              <ul>
                {copy.facts.map((fact) => (
                  <li>{fact}</li>
                ))}
              </ul>
              <a href="/de/kontakt/">Anfrage senden</a>
            </article>
          );
        })}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .de-stays {
    padding: 132px 0 88px;
    background: #fcfbf8;
  }

  .de-stays__inner {
    display: grid;
    gap: 34px;
  }

  .de-stays__hero {
    max-width: 860px;
  }

  .de-stays__eyebrow,
  .de-stay-card__location {
    display: inline-block;
    margin-bottom: 10px;
    color: #b67b20;
    font-size: var(--dnd-text-2xs);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .de-stays h1 {
    margin: 0;
    color: #261d16;
    font-family: var(--dnd-font-display);
    font-size: clamp(2.2rem, 4vw, 3.8rem);
    font-weight: 500;
    line-height: 1.05;
  }

  .de-stays__hero p,
  .de-stay-card p {
    color: rgba(38, 29, 22, 0.76);
    font-size: var(--dnd-text-body);
    line-height: 1.72;
  }

  .de-stays__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
  }

  .de-stay-card {
    display: grid;
    gap: 12px;
    padding: 22px;
    border: 1px solid rgba(88, 63, 38, 0.12);
    border-radius: 18px;
    background: #fff;
    box-shadow: 0 18px 48px rgba(48, 34, 20, 0.06);
  }

  .de-stay-card h2 {
    margin: 0;
    color: #261d16;
    font-family: var(--dnd-font-display);
    font-size: 1.8rem;
    font-weight: 500;
  }

  .de-stay-card ul {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .de-stay-card li {
    padding: 7px 10px;
    border-radius: 999px;
    background: #f7f2ea;
    color: rgba(38, 29, 22, 0.78);
    font-size: var(--dnd-text-xs);
    font-weight: 700;
  }

  .de-stay-card a {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 42px;
    padding: 0 18px;
    border-radius: 999px;
    background: #d99e2b;
    color: #1b140f;
    font-weight: 700;
    text-decoration: none;
  }

  @media (max-width: 980px) {
    .de-stays__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 680px) {
    .de-stays {
      padding: 108px 0 64px;
    }

    .de-stays__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
