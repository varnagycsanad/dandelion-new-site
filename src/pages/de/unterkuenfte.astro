---
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { accommodationSections, accommodations } from "../../data/accommodations";
import { SITE_NAME, toAbsoluteUrl } from "../../data/site-seo";
import { readHomepageImageMapping } from "../../lib/homepage-image-mapping";

const imageMapping = await readHomepageImageMapping();
const englishBookingHref = "https://ibe.sabeeapp.com/v3/p/Dandelion-Vendégházak?p=3970b30e1042d58f&lang=En";
const accommodationsOgImage = "/images/pages/szallasok-hero-bg.webp";
const accommodationsHeroVideo = "/videos/szallasok/202507%20V1.mp4?v=20260603-lite";
const accommodationsHeroMobileVideo = "/videos/szallasok/202507%20V1-mobile-lite.mp4?v=20260606-mobile-lite";
const accommodationsOgImageAlt = "Dandelion Gästehäuser Unterkunftsauswahl im Balaton-Oberland";
const accommodationsTransitionImage = "/images/pages/dandelion-panorama-pool-szallasvalaszto-desktop.webp";
const accommodationsTransitionMobileImage = "/images/pages/dandelion-panorama-pool-szallasvalaszto-mobile.webp";
const accommodationsTransitionImageAlt =
  "Dandelion Panorama Pool mit blauem Wasser, Liegen und Panorama im Balaton-Oberland";
const accommodationsTransitionImageTitle =
  "Panorama Pool mit Sonnenterrasse und Blick auf die Zeugenberge";

const sectionCopy = {
  upland: {
    anchorId: "zeugenberge",
    eyebrow: "Szent György-hegy / Tapolca-Becken / Kisapáti / Nemesgulács",
    title: "Zwischen den Zeugenbergen",
    subtitle:
      "Kisapáti, Nemesgulács und die Umgebung des Szent György-hegy passen gut, wenn Sie ein Haus am Hang, Panorama, Garten und gut erreichbare Ausflüge suchen.",
    audienceText: "Für Berge, Panorama, Familien und Reisen mit Freunden."
  },
  shore: {
    anchorId: "balaton-naehe",
    eyebrow: "Keszthely / Badacsonyörs / Balaton-Nähe",
    title: "Leichte Tage am Balaton",
    subtitle:
      "Keszthely und Badacsonyörs sind die richtige Richtung, wenn Balaton-Nähe, Strände und bequeme Programme am Wasser wichtiger sind als ein Rückzug am Hang.",
    audienceText: "Für Ufer, Strand und Balaton-Programme."
  },
  kali: {
    anchorId: "kali-becken",
    eyebrow: "Köveskál / Káli-Becken / ruhige Auszeit",
    title: "Die ruhigere Seite des Káli-Beckens",
    subtitle:
      "Köveskál ist die langsamere, ruhigere Wahl: Dorfumgebung, Spaziergänge im Káli-Becken, Weingüter und zurückhaltendere Erholung.",
    audienceText: "Für Ruhe, Dorfumgebung und Ausflüge im Káli-Becken."
  }
} as const;

const stayCopy: Record<string, { name: string; location: string; description: string; hoverText: string; chips: { label: string; type?: "default" | "accent" | "blue" | "green" | "purple" }[]; href: string }> = {
  "dandelion-d2": {
    name: "Dandelion D2",
    location: "Kisapáti / Balaton-Oberland",
    description: "Familienfreundliches Apartment in Kisapáti mit großem Garten, überdachter Terrasse, Kamin und Zugang zum Panorama Pool im Sommer.",
    hoverText: "4-6 Gäste, Garten, Terrasse und Panorama Pool.",
    href: "/de/dandelion-d2/",
    chips: [
      { label: "4-6 Gäste", type: "accent" },
      { label: "2 Schlafzimmer + Wohnbereich" },
      { label: "Panorama Pool", type: "blue" },
      { label: "Klimaanlage", type: "blue" },
      { label: "Familienfreundlich", type: "purple" },
      { label: "Kamin" }
    ]
  },
  fugehaz: {
    name: "Dandelion Fügeház",
    location: "Nahe Szent György-hegy",
    description: "Haus nahe am Berg mit Terrassen, Panorama und ruhigen Außenbereichen für kleinere Familien oder Freunde.",
    hoverText: "4-6 Gäste, Terrassen, Panorama und Panorama Pool.",
    href: "/de/dandelion-fugehaz/",
    chips: [
      { label: "4-6 Gäste", type: "accent" },
      { label: "2 Ebenen" },
      { label: "Panorama", type: "green" },
      { label: "Panorama Pool", type: "blue" },
      { label: "Klimaanlage", type: "blue" },
      { label: "Kamin" }
    ]
  },
  "dandelion-d1": {
    name: "Dandelion D1",
    location: "Kisapáti / Balaton-Oberland",
    description: "Großzügiges Gästehaus in Kisapáti für größere Familien oder Freunde, mit drei Schlafzimmern, zwei Bädern, Terrasse und Zugang zum Panorama Pool im Sommer.",
    hoverText: "6-8 Gäste, drei Schlafzimmer und viel Platz.",
    href: "/de/dandelion-d1/",
    chips: [
      { label: "6-8 Gäste", type: "accent" },
      { label: "3 Schlafzimmer" },
      { label: "Panorama Pool", type: "blue" },
      { label: "Panorama-Terrasse", type: "green" },
      { label: "2 Badezimmer" },
      { label: "Klimaanlage", type: "blue" },
      { label: "Großer Garten", type: "green" }
    ]
  },
  "szololiget-vendeghaz": {
    name: "Dandelion Szőlőliget",
    location: "Kisapáti / Szent György-hegy",
    description: "Freistehendes Haus mit großer Terrasse und Blick Richtung Csobánc, passend für ruhigere Tage am Hang.",
    hoverText: "2-4 Gäste, große Terrasse und offene Aussicht.",
    href: "/de/szololiget/",
    chips: [
      { label: "2-4 Gäste", type: "accent" },
      { label: "1 Schlafzimmer + Wohnbereich" },
      { label: "Terrasse", type: "green" },
      { label: "Panorama", type: "green" },
      { label: "Klimaanlage", type: "blue" },
      { label: "Ruhige Lage", type: "purple" }
    ]
  },
  "zsalya-vendeghaz": {
    name: "Dandelion Zsálya",
    location: "Kisapáti / Szent György-hegy",
    description: "Freistehendes Gästehaus in Kisapáti mit überdachter Terrasse und Blick auf die Zeugenberge, wenn Sie ein ruhigeres, privateres Haus suchen.",
    hoverText: "2-4 Gäste, Überdachte Terrasse und ruhige Hanglage.",
    href: "/de/dandelion-zsalya/",
    chips: [
      { label: "2-4 Gäste", type: "accent" },
      { label: "2 Schlafzimmer" },
      { label: "Überdachte Terrasse", type: "green" },
      { label: "Klimaanlage", type: "blue" },
      { label: "Naturnah", type: "purple" }
    ]
  },
  "vintage-vendeghaz": {
    name: "Dandelion Vintage",
    location: "Nemesgulács / Balaton-Oberland",
    description: "Gästehaus in Nemesgulács mit eigenem Hof und zwei Schlafzimmern, praktisch für Balaton-Programme und ruhigere Abende.",
    hoverText: "Nemesgulács, eigener Hof und ruhigere Abende.",
    href: "/de/dandelion-vintage/",
    chips: [
      { label: "Gästehaus", type: "accent" },
      { label: "2 Schlafzimmer" },
      { label: "Eigener Hof", type: "green" },
      { label: "Klimaanlage", type: "blue" },
      { label: "Nemesgulács" },
      { label: "Ruhige Abende" }
    ]
  },
  "royal-homes": {
    name: "Dandelion Royal Homes",
    location: "Keszthely / Balaton",
    description: "Modernes Apartment in Keszthely für 4-6 Gäste mit großer Terrasse, Dachterrassen-Jacuzzi und direkter Umgebung am Wasser.",
    hoverText: "4-6 Gäste, Balaton-Umgebung und Dachterrassen-Jacuzzi.",
    href: "/de/royal/",
    chips: [
      { label: "4-6 Gäste", type: "accent" },
      { label: "Direkt am Wasser", type: "blue" },
      { label: "2 Schlafzimmer + Wohnbereich" },
      { label: "Dachterrassen-Jacuzzi", type: "blue" },
      { label: "Klimaanlage", type: "blue" },
      { label: "Keszthely" }
    ]
  },
  "szepvolgyi-vendeghaz": {
    name: "Dandelion Szépvölgyi",
    location: "Badacsonyörs / Balaton",
    description: "Haus in Badacsonyörs für größere Gruppen, mit vier Schlafzimmern, Balaton-Panorama und Stränden wenige Autominuten entfernt.",
    hoverText: "Bis 8 Gäste, vier Schlafzimmer und Balaton-Panorama.",
    href: "/de/szepvolgyi/",
    chips: [
      { label: "8 Gäste", type: "accent" },
      { label: "4 Schlafzimmer" },
      { label: "Balaton-Panorama", type: "green" },
      { label: "2 Badezimmer" },
      { label: "Klimaanlage", type: "blue" },
      { label: "Badacsonyörs" }
    ]
  },
  "dandelion-koveskal": {
    name: "Dandelion Köveskál",
    location: "Köveskál / Káli-Becken",
    description: "Ruhiges Gästehaus in Köveskál, nah an den Dörfern, Spazierwegen und Weingütern des Káli-Beckens.",
    hoverText: "Köveskál, für ruhigere Tage im Káli-Becken.",
    href: "/de/dandelion-koveskal/",
    chips: [
      { label: "Gästehaus", type: "accent" },
      { label: "Köveskál" },
      { label: "Káli-Becken", type: "green" },
      { label: "Naturnah", type: "green" },
      { label: "Ruhiges Dorf", type: "purple" },
      { label: "Wein und Gastronomie" }
    ]
  }
};

const sections = accommodationSections.map((section) => ({
  ...section,
  ...sectionCopy[section.key],
  stays: accommodations
    .filter((stay) => stay.section === section.key)
    .map((stay) => ({
      ...stay,
      ...stayCopy[stay.slug],
      image: imageMapping[stay.imageSlot]
    }))
}));

const accommodationFaqItems = [
  {
    question: "Welche Dandelion Häuser haben Poolnutzung?",
    answer:
      "Dandelion D1, Dandelion D2 und Fügeház sind die wichtigsten Optionen mit Zugang zum Panorama Pool nahe dem Szent György-hegy.",
    href: "#zeugenberge"
  },
  {
    question: "Wo sollte man in Kisapáti übernachten?",
    answer:
      "In Kisapáti sind D1, D2, Zsálya und Szőlőliget die Hauptoptionen. D1 passt zu größeren Gruppen, D2 zu Familien, Zsálya und Szőlőliget eher zu ruhigerer Erholung am Hang.",
    href: "#zeugenberge"
  },
  {
    question: "Welche Dandelion Unterkunft passt für Familien?",
    answer:
      "Für Familien ist D2 meist der erste Blick wert. Für größere Familien ist D1 praktischer, kleinere Familien können Zsálya oder Szőlőliget vergleichen.",
    href: "#zeugenberge"
  },
  {
    question: "Welche Unterkunft liegt näher am Balaton?",
    answer:
      "Für Balaton-Nähe sind Royal Homes in Keszthely und Szépvölgyi in Badacsonyörs die stärksten Richtungen.",
    href: "#balaton-naehe"
  },
  {
    question: "Welche Häuser passen zum Szent György-hegy?",
    answer:
      "D1, D2, Fügeház, Zsálya und Szőlőliget passen gut für Aufenthalte am Szent György-hegy, Panorama und kurze Ausflüge zwischen den Zeugenbergen.",
    href: "#zeugenberge"
  },
  {
    question: "Welche Unterkunft ist ruhiger und zurückgezogener?",
    answer:
      "Für ruhigere Tage sind Köveskál, Szőlőliget und Zsálya gute Richtungen. Köveskál ist dörflicher, Szőlőliget und Zsálya liegen eher am Hang.",
    href: "#kali-becken"
  }
];

const accommodationsStructuredData = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "@id": `${toAbsoluteUrl("/de/unterkuenfte/")}#collection`,
  name: "Unterkünfte bei Dandelion Gästehäusern",
  url: toAbsoluteUrl("/de/unterkuenfte/"),
  inLanguage: "de-DE",
  description: "Regionale Unterkunftsauswahl der Dandelion Gästehäuser im Balaton-Oberland, am Balaton und im Káli-Becken.",
  isPartOf: {
    "@id": `${toAbsoluteUrl("/")}#website`
  },
  mainEntity: {
    "@type": "ItemList",
    itemListElement: sections.flatMap((section, sectionIndex) =>
      section.stays.map((stay, stayIndex) => ({
        "@type": "ListItem",
        position: sectionIndex * 10 + stayIndex + 1,
        url: toAbsoluteUrl(stay.href),
        name: stay.name
      }))
    )
  },
  about: ["Balaton-Oberland", "Zeugenberge", "Balaton", "Káli-Becken"],
  provider: {
    "@type": "LodgingBusiness",
    name: SITE_NAME,
    url: toAbsoluteUrl("/")
  }
};

const accommodationFaqStructuredData = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "@id": `${toAbsoluteUrl("/de/unterkuenfte/")}#faq`,
  inLanguage: "de-DE",
  mainEntity: accommodationFaqItems.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.answer
    }
  }))
};
---

<BaseLayout
  title="Unterkünfte am Balaton | Dandelion Gästehäuser"
  description="Wählen Sie zuerst die Region und finden Sie dann das passende Dandelion Gästehaus bei den Zeugenbergen, am Balaton oder im Káli-Becken."
  canonicalPath="/de/unterkuenfte/"
  lang="de"
  ogLocale="de_DE"
  ogImage={accommodationsOgImage}
  ogImageAlt={accommodationsOgImageAlt}
  structuredData={[accommodationsStructuredData, accommodationFaqStructuredData]}
>
  <section class="dnd-accommodations-hero">
    <video
      class="dnd-accommodations-hero__video"
      autoplay
      muted
      loop
      playsinline
      webkit-playsinline
      preload="auto"
      disablepictureinpicture
      disableremoteplayback
      aria-hidden="true"
    >
      <source src={accommodationsHeroMobileVideo} media="(max-width: 640px)" type="video/mp4" />
      <source src={accommodationsHeroVideo} type="video/mp4" />
      Ihr Browser unterstützt keine Hintergrundvideos.
    </video>
    <div class="dnd-accommodations-hero__content">
      <div class="dnd-container dnd-accommodations-hero__inner">
        <div class="dnd-accommodations-hero__text">
          <p class="dnd-accommodations-hero__eyebrow">Unterkünfte</p>
          <h1 class="dnd-accommodations-hero__title">
            <span>Unterkünfte nach Region</span>
            <span>und Bedarf</span>
          </h1>
          <p class="dnd-accommodations-hero__lead">
            Die Hänge von Kisapáti, der Balaton oder das ruhige Káli-Becken: hier sehen Sie, welches Dandelion Haus wofür passt.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="dnd-accommodations-picker" aria-labelledby="unterkuenfte-regionen-title">
    <div class="dnd-container">
      <div class="dnd-accommodations-picker__intro">
        <p class="dnd-accommodations-picker__eyebrow">Regionsauswahl</p>
        <h2 id="unterkuenfte-regionen-title">Wo möchten Sie übernachten?</h2>
        <p>
          Wenn Sie noch kein konkretes Haus suchen, beginnen Sie mit der Umgebung: Szent György-hegy,
          Balaton-Ufer oder Káli-Becken.
        </p>
      </div>

      <div class="dnd-accommodations-picker__grid">
        {sections.map((section, regionIndex) => (
          <a class={`dnd-region-picker-card dnd-region-picker-card--${regionIndex + 1}`} href={`#${section.anchorId}`}>
            <span class="dnd-region-picker-card__top">
              <span class="dnd-region-picker-card__eyebrow">{section.eyebrow}</span>
              <span class="dnd-region-picker-card__icon" aria-hidden="true"></span>
            </span>
            <strong class="dnd-region-picker-card__title">{section.title}</strong>
            <span class="dnd-region-picker-card__text">{section.audienceText}</span>
            <span class="dnd-region-picker-card__cta">Ansehen</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="dnd-accommodations-transition" aria-labelledby="unterkuenfte-pool-title">
    <div class="dnd-container">
      <div class="dnd-accommodations-transition__panel">
        <picture class="dnd-accommodations-transition__media">
          <source srcset={accommodationsTransitionMobileImage} media="(max-width: 640px)" />
          <img
            src={accommodationsTransitionImage}
            alt={accommodationsTransitionImageAlt}
            title={accommodationsTransitionImageTitle}
            loading="lazy"
            width="1600"
            height="560"
          />
        </picture>
        <div class="dnd-accommodations-transition__content">
          <p class="dnd-accommodations-transition__eyebrow">Panorama Pool</p>
          <h2 id="unterkuenfte-pool-title">Pooltage unterhalb des Szent György-hegy</h2>
        </div>
      </div>
    </div>
  </section>

  <section class="dnd-accommodations-qa" aria-labelledby="unterkuenfte-qa-title">
    <div class="dnd-container">
      <div class="dnd-accommodations-qa__layout">
        <div class="dnd-accommodations-qa__intro">
          <p class="dnd-accommodations-qa__eyebrow">Schnellauswahl</p>
          <h2 id="unterkuenfte-qa-title">Welche Dandelion Unterkunft passt zu Ihnen?</h2>
          <p>
            Wenn Sie nicht mit einem Hausnamen beginnen, starten Sie mit den häufigsten Fragen:
            Personenzahl, Region, Poolnutzung, Balaton-Nähe, Panorama oder ruhiger Rückzug.
          </p>
          <a class="dnd-accommodations-qa__summary-link" href="#unterkuenfte-liste">
            Zur Unterkunftsliste
          </a>
        </div>

        <div class="dnd-accommodations-qa__grid">
          {accommodationFaqItems.map((item) => (
            <article class="dnd-accommodations-qa__item">
              <h3>{item.question}</h3>
              <p>{item.answer}</p>
              <a href={item.href}>Passende Unterkünfte</a>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <div id="unterkuenfte-liste" class="dnd-apts-anchor">
    <div id="dnd-apts-final" lang="de">
      <div class="dnd-wrap">
        {sections.map((section) => (
          <section id={section.anchorId} class="dnd-section dnd-region-block">
            <div class="dnd-region-block__header">
              <p class="dnd-eyebrow">{section.eyebrow}</p>
              <h2 class="dnd-h2">{section.title}</h2>
              <p class="dnd-sub">{section.subtitle}</p>
              <p class="dnd-region-block__audience">{section.audienceText}</p>
            </div>

            <div class={`dnd-grid ${section.gridClass}`}>
              {section.stays.map((stay) => {
                const primaryChips = stay.chips.slice(0, 3);
                const secondaryChips = stay.chips.slice(3, 6);
                const cardContent = (
                  <>
                    <div class="dnd-media">
                      {stay.image ? (
                        stay.image.astroSrc ? (
                          <Image src={stay.image.astroSrc} alt={stay.image.altText || stay.name} loading="lazy" />
                        ) : (
                          <img
                            src={stay.image.sourceUrl}
                            alt={stay.image.altText || stay.name}
                            width={stay.image.width || 1600}
                            height={stay.image.height || 1067}
                            loading="lazy"
                          />
                        )
                      ) : (
                        <div class="dnd-media-placeholder" aria-label={`${stay.name} Bild folgt`}>
                          <span>{stay.name}</span>
                          <small>Bild folgt</small>
                        </div>
                      )}
                      {stay.badge && <div class="dnd-badge">{stay.badge}</div>}
                      <div class="dnd-overlay"></div>
                      <p class="dnd-hover-text">{stay.hoverText}</p>
                    </div>
                    <div class="dnd-info">
                      <div class="dnd-title-row">
                        <h3 class="dnd-title">{stay.name}</h3>
                        <span class="dnd-location">{stay.location}</span>
                      </div>
                      <div class="dnd-card-highlights" aria-label={`${stay.name} Hauptmerkmale`}>
                        {primaryChips.map((chip) => (
                          <span class={`dnd-chip${chip.type && chip.type !== "default" ? ` dnd-chip--${chip.type}` : ""}`}>
                            {chip.label}
                          </span>
                        ))}
                      </div>
                      <p class="dnd-description">{stay.description}</p>
                      <div class="dnd-chips" aria-label={`${stay.name} weitere Merkmale`}>
                        {secondaryChips.map((chip) => (
                          <span class={`dnd-chip${chip.type && chip.type !== "default" ? ` dnd-chip--${chip.type}` : ""} dnd-chip--secondary`}>
                            {chip.label}
                          </span>
                        ))}
                      </div>
                      <span class="dnd-card-cta">Details ansehen</span>
                    </div>
                  </>
                );

                return (
                  <a class="dnd-card is-link" href={stay.href}>
                    {cardContent}
                  </a>
                );
              })}
            </div>
          </section>
        ))}
      </div>
    </div>
  </div>

  <section class="dnd-accommodations-closing" aria-labelledby="unterkuenfte-closing-title">
    <div class="dnd-container">
      <div class="dnd-accommodations-closing__inner">
        <h2 id="unterkuenfte-closing-title">Noch unsicher, welche Unterkunft passt?</h2>
        <p>
          Schreiben Sie uns, mit wie vielen Personen Sie reisen, wann Sie kommen möchten und welche Umgebung oder Ausstattung wichtig ist. Wir helfen beim Eingrenzen.
        </p>
        <div class="dnd-accommodations-closing__actions">
          <a class="dnd-accommodations-closing__cta" href={englishBookingHref} target="_blank" rel="noopener noreferrer">Verfügbarkeit prüfen</a>
          <a class="dnd-accommodations-closing__cta dnd-accommodations-closing__cta--secondary" href="/de/kontakt/">
            Hilfe bei der Auswahl
          </a>
        </div>
        <p class="dnd-accommodations-closing__note">
          Über die Kontaktseite können Sie uns auch direkt schreiben, wenn Sie eine kurze Abstimmung wünschen.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .dnd-accommodations-hero {
    position: relative;
    box-sizing: border-box;
    min-height: calc(600px + 118px);
    height: calc(84vh + 118px);
    padding-top: 118px;
    overflow: hidden;
    background: #171717;
  }

  .dnd-accommodations-hero::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background: linear-gradient(180deg, rgba(15, 16, 15, 0.18), rgba(15, 16, 15, 0.32));
  }

  .dnd-accommodations-hero__video {
    position: absolute;
    inset: 0;
    z-index: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 50%;
  }

  .dnd-accommodations-hero__content {
    position: relative;
    z-index: 1;
    min-height: 100%;
    color: #fff;
  }

  .dnd-accommodations-hero__inner {
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    align-items: center;
    min-height: 100%;
