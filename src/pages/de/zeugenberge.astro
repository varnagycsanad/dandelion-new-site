---
import GermanExperiencePage from "../../templates/GermanExperiencePage.astro";
import heroImage from "../../assets/experiences/tanuhegyek-drone-dji-20260512.jpg";
import supportImage from "../../assets/experiences/szent-gyorgy-hegy-szolo.jpg";
---

<GermanExperiencePage
  title="Zeugenberge und Wandern im Balaton-Oberland | Dandelion Unterkünfte"
  description="Leichte Wanderideen rund um Szent György-hegy, Badacsony und die vulkanischen Zeugenberge nahe den Dandelion Unterkünften."
  canonicalPath="/de/zeugenberge/"
  breadcrumbName="Zeugenberge"
  eyebrow="Naturnahe Programme"
  heading="Zeugenberge, Aussichtspunkte und leichte Wege."
  lead={[
    "Eine Stärke des Balaton-Oberlands ist, wie schnell sich die Landschaft verändert: Weinberge, Wiesen, Waldwege und Aussichtspunkte können Teil des Tages werden.",
    "Szent György-hegy, Badacsony, Tóti-hegy, Csobánc, Gulács und Szigliget geben verschiedene Versionen desselben Gefühls: vulkanische Hügel, offene Blicke und ein langsamer Rhythmus."
  ]}
  heroImage={heroImage}
  heroAlt="Panorama über das Tapolca-Becken und die Zeugenberge"
  supportImage={supportImage}
  supportAlt="Weinberge am Szent György-hegy"
  supportTitle="Kein Wanderhandbuch, eher ein Einstieg in den Tag."
  supportText="Der beste Weg ist oft der, der zum eigenen Tempo passt: Weinbergspaziergang, Aussichtspunkt, Burgbesuch oder Sonnenuntergang."
  highlights={["vulkanische Zeugenberge und Aussichtspunkte", "kürzere Spaziergänge und längere Routen", "gut für Paare, Familien und Freunde", "besonders schön rund um Sonnenuntergang"]}
  primaryLink={{ label: "Unterkünfte ansehen", href: "/de/unterkuenfte/" }}
  secondaryLink={{ label: "Zurück zu Erlebnissen", href: "/de/erlebnisse/" }}
  sections={[
    {
      title: "Ausflugs- und Spazierideen",
      cards: [
        { title: "Szent György-hegy", body: "Weinberge, Basaltsäulen, ruhige Wege, Aussicht und echtes Balaton-Oberland-Gefühl." },
        { title: "Badacsony", body: "Klassischer Zeugenberg, gut kombinierbar mit Wein, Abendessen oder Balaton-Programm." },
        { title: "Tóti-hegy", body: "Kompakt und aussichtsreich, wenn der Tag nicht zu schwer werden soll." },
        { title: "Szigliget und Burg", body: "Einfach zu lieben: Burg, Aussicht, See, kleine Straßen und familienfreundliche Stimmung." },
        { title: "Csobánc", body: "Ruhiger und wilder, mit Burgruine und weitem Blick." },
        { title: "Gulács", body: "Naturnaher und weniger belebt, gut für ruhigere Wandertage." }
      ]
    },
    {
      title: "Wenn es kein großer Wandertag sein soll",
      cards: [
        { title: "Kurzer Weinbergspaziergang", body: "Ein kleiner Weg am Hügel reicht oft, um den Tagesrhythmus zu verändern." },
        { title: "Sonnenuntergang", body: "Ein Aussichtspunkt und weiches Licht können der ganze Plan sein." },
        { title: "Picknick oder Fotospaziergang", body: "Weinreihen, alte Keller, Silhouetten und wechselndes Licht machen die Gegend dankbar." }
      ]
    }
  ]}
/>
