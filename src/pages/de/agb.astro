---
import LegalDocumentPage from "../../templates/LegalDocumentPage.astro";

const sections = [
  {
    number: "1",
    title: "Buchung",
    paragraphs: [
      "Buchungen können über die Online-Buchungsmaschine der Website, per E-Mail, telefonisch oder über externe Vertriebskanäle erfolgen.",
      "Bei Buchungen über externe Kanäle gelten die Zahlungs- und Stornierungsbedingungen des jeweiligen Kanals."
    ]
  },
  {
    number: "2",
    title: "Preise und verpflichtende Gebühren",
    paragraphs: ["Die besten Unterkunftspreise sind in der Regel auf unserer eigenen Website verfügbar."],
    bullets: [
      "Kurtaxe: zahlbar gemäß der jeweils geltenden kommunalen Regelung. Die Höhe kann je nach Gemeinde, Unterkunft und Haus abweichen; massgeblich ist der im Buchungsprozess angezeigte Betrag.",
      "Endreinigung: der im Buchungsprozess angezeigte Betrag. Er kann je nach Unterkunft variieren."
    ]
  },
  {
    number: "3",
    title: "Nutzung des Székely Hot Tubs, falls verfügbar",
    paragraphs: [
      "Die Nutzung des Hot Tubs ist kostenpflichtig und nur bei Unterkünften möglich, bei denen dieser angeboten wird.",
      "Bitte melden Sie die Nutzung im Voraus bei der Buchung oder vor der Anreise an."
    ],
    bullets: [
      "Einmalige Heizgebühr: HUF 15 000",
      "Tägliche Nutzungsgebühr: HUF 7 500 pro Tag",
      "Beispiel für 2 Nächte: HUF 15 000 + 2 x HUF 7 500 = HUF 30 000"
    ]
  },
  {
    number: "4",
    title: "Regeln für die Nutzung des Panorama Pools",
    paragraphs: [
      "Bei Unterkünften mit Panorama Pool akzeptiert der Gast durch die Nutzung die jeweils gültigen Pool-Regeln.",
      "Die Pool-Regeln sind im Online-Gästeguide der jeweiligen Unterkunft verfügbar.",
      "Der Betreiber kann die Poolnutzung wegen Wetter, Wartung, Wasserbehandlung, technischer Störung, Sicherheitsgründen oder Regelverstößen einschränken oder vorübergehend aussetzen.",
      "Der Panorama-Poolbereich kann kameraüberwacht sein. Die Überwachung dient Eigentumsschutz, Unfallprävention, Sicherheit und Regeldurchsetzung, ersetzt aber keine Badeaufsicht oder Aufsichtspflicht von Erwachsenen.",
      "Gäste nutzen den Pool auf eigene Verantwortung. Kinder dürfen den Pool nur unter Aufsicht eines Erwachsenen nutzen."
    ],
    links: [
      { label: "Dandelion D1 Pool-Regeln", href: "/guide/d1/medence/" },
      { label: "Dandelion D2 Pool-Regeln", href: "/guide/d2/medence/" },
      { label: "Fügeház Pool-Regeln", href: "/guide/fugehaz/medence/" }
    ]
  },
  {
    number: "4/A",
    title: "Kameraüberwachung",
    paragraphs: [
      "Kameraüberwachung kann nur in bestimmten gemeinschaftlich genutzten Bereichen der Dandelion Unterkünfte erfolgen, insbesondere bei Eingängen, Höfen, Parkbereichen, Zugangswegen und beim Panorama Pool.",
      "Kameras sind nicht auf Wohnräume, Schlafzimmer, Badezimmer, Toiletten oder andere private Bereiche gerichtet.",
      "Detaillierte Datenschutzregeln zur Kameraüberwachung stehen in der Datenschutzerklärung."
    ],
    links: [{ label: "Datenschutzerklärung", href: "/de/datenschutz/" }]
  },
  {
    number: "5",
    title: "Zahlungsbedingungen",
    paragraphs: [
      "Zur Finalisierung der Buchung sind 30% des Buchungswerts als Anzahlung zu leisten.",
      "Die Anzahlung kann während des Buchungsprozesses entweder online per Bankkarte über das SabeePay-System oder per Banküberweisung bezahlt werden.",
      "Bei Online-Kartenzahlung wird die Anzahlung bei Finalisierung der Buchung belastet. Der Restbetrag ist gemäß der Zahlungsregelung des Unterkunftgebers spätestens bei Anreise oder während des Aufenthalts zu begleichen.",
      "Wenn Banküberweisung gewählt wird, bitten wir darum, die Anzahlung sofort nach der Buchung, spätestens jedoch innerhalb von 1 Werktag zu überweisen. Die Buchung gilt nach Eingang der Anzahlung als garantiert.",
      "Bitte geben Sie im Verwendungszweck den Buchungsnamen und das Anreisedatum an. Wenn die zahlende Person nicht der anreisende Gast ist, geben Sie bitte auch den Namen des anreisenden Gastes an.",
      "Bei OTA-Buchungen, zum Beispiel über Booking.com oder Airbnb, gelten immer die Zahlungs- und Stornierungsbedingungen des jeweiligen Vertriebskanals."
    ]
  },
  {
    number: "6",
    title: "Bankdaten",
    paragraphs: [
      "Wenn Banküberweisung gewählt wird, verwenden Sie bitte immer die zur gebuchten Unterkunft gehörenden Überweisungsdaten."
    ],
    groups: [
      {
        title: "Dandelion D1 / Dandelion D2 / Fügeház",
        lines: ["Begünstigte: Ilona Varnagy", "Revolut: @ilonai62b", "Kontonummer / IBAN: LT17 3250 0224 2786 2232", "SWIFT/BIC: REVOLT21"]
      },
      {
        title: "Dandelion Szőlőliget / Dandelion Zsálya / Dandelion Vintage / Dandelion Köveskál / Dandelion Royal Homes",
        lines: ["Begünstigte: Dandelion Vendégházak Kft.", "Kontonummer: 11748052-24862910", "IBAN: HU08117480522486291000000000", "SWIFT/BIC: OTPVHUHB"]
      }
    ],
    note: "Bitte geben Sie im Verwendungszweck den Buchungsnamen und das Anreisedatum an. Bei Buchungen für das Szépvölgyi Vendégház stehen die Überweisungsdaten in der Buchungsbestätigung."
  },
  {
    number: "7",
    title: "Stornierungsbedingungen",
    bullets: [
      "Kostenfreie Stornierung: bei einer Stornierung mindestens 30 Tage vor Anreise wird die gezahlte Anzahlung zurückerstattet.",
      "Stornierung innerhalb von 30 Tagen: die gezahlte Anzahlung von 30% ist nicht erstattbar.",
      "Bei Nichtanreise oder Stornierung am Anreisetag ist der vollständige Buchungsbetrag zahlbar."
    ],
    paragraphs: [
      "Eine Stornierung ist gültig, wenn sie vom Gast schriftlich per E-Mail mitgeteilt oder über das Buchungssystem beziehungsweise den Vertriebskanal offiziell storniert wird. Maßgeblich ist der Zeitpunkt des Eingangs der Stornierung.",
      "Wenn die Anzahlung zurückzuzahlen ist, überweisen wir sie spätestens innerhalb von 5 Werktagen auf das Konto zurück, von dem die Anzahlung eingegangen ist, oder auf ein anderes vom Gast schriftlich angegebenes Konto."
    ]
  },
  {
    number: "8",
    title: "Check-in, Check-out und Self Check-in",
    paragraphs: [
      "Die Anreise erfolgt in der Regel über Self Check-in mit Schlüsselkasten. Detaillierte Anreiseinformationen werden per E-Mail gesendet.",
      "Online Check-in ist Voraussetzung für die Nutzung der Unterkunft. Ohne die notwendigen Gastdaten kann der Zutrittscode nicht versendet werden."
    ]
  },
  {
    number: "9",
    title: "Anreise und Abreise",
    bullets: ["Check-in: 15:00-19:00", "Check-out: bis 10:00", "Späte Anreise ist nach vorheriger Mitteilung möglich."]
  },
  {
    number: "10",
    title: "Kaution",
    paragraphs: [
      "In der Regel verlangen wir keine Kaution. In Ausnahmefällen kann eine Kaution verlangt werden; der Gast wird darüber immer im Voraus informiert."
    ]
  },
  {
    number: "11",
    title: "Hausregeln, Rauchen und Haustiere",
    bullets: [
      "Möbel, Ausstattung und Einrichtungen sind sachgemäß zu nutzen.",
      "Rauchen: In allen Unterkünften ist Rauchen in Innenräumen verboten. Im Außenbereich ist Rauchen nur an dafür geeigneten Stellen erlaubt; Zigarettenstummel dürfen nicht weggeworfen werden. Rauchen im Innenbereich führt zu einer zusätzlichen Reinigungsgebühr.",
      "Haustiere sind nur in dafür vorgesehenen Unterkünften erlaubt. Derzeit sind Dandelion D1, Dandelion D2 und Fügeház haustierfreundlich. Bei Buchungen mit Haustier ist eine vorherige Abstimmung erforderlich."
    ]
  },
  {
    number: "12",
    title: "Gästezahl",
    paragraphs: ["Nur vorab angemeldete Gäste dürfen in der Unterkunft übernachten."]
  },
  {
    number: "13",
    title: "Reinigung",
    paragraphs: [
      "Eine separate Endreinigungsgebühr kann im Gesamtbetrag enthalten sein und wird im Buchungsprozess gesondert ausgewiesen.",
      "Bei außergewöhnlicher Verschmutzung oder Regelverstößen können zusätzliche Reinigungskosten berechnet werden."
    ]
  },
  {
    number: "14",
    title: "Schäden und Haftung",
    paragraphs: [
      "Bei Schäden muss der Gast den verursachten Schaden ersetzen.",
      "Bitte verwenden Sie Möbel, Ausstattung und Einrichtungen nur bestimmungsgemäß."
    ]
  },
  {
    number: "15",
    title: "Kontakt",
    paragraphs: ["Bei Fragen helfen wir gerne zu Buchung, Zahlung, Anreise oder Unterkunft."],
    contacts: [
      { label: "E-Mail", value: "hello@dandelionhouse.hu", href: "mailto:hello@dandelionhouse.hu" },
      { label: "Telefon", value: "+36 20 773 0807", href: "tel:+36207730807" }
    ]
  }
];
---

<LegalDocumentPage
  lang="de"
  title="Allgemeine Geschäftsbedingungen | Dandelion Unterkünfte"
  description="Buchungs- und Aufenthaltsbedingungen von Dandelion: Zahlung, Anzahlung, Stornierung, Check-in, Hausregeln und Kontakt."
  canonicalPath="/de/agb/"
  eyebrow="Rechtliche Informationen"
  heading="Allgemeine Geschäftsbedingungen"
  lead="Die Buchungs- und Aufenthaltsbedingungen der Dandelion Unterkünfte gelten wie unten beschrieben. Mit Absenden und Bestätigung einer Buchung akzeptiert der Gast diese Bedingungen."
  introBlocks={[
    { label: "Gültigkeit", lines: ["Gültig ab: 1. Februar 2026", "Geändert: 22. Juni 2026"] },
    {
      label: "Kontakt",
      lines: [],
      links: [
        { label: "hello@dandelionhouse.hu", href: "mailto:hello@dandelionhouse.hu" },
        { label: "+36 20 773 0807", href: "tel:+36207730807" }
      ]
    }
  ]}
  notice="Unsere besten Preise sind in der Regel in unserer eigenen Buchungsmaschine verfügbar. Bei OTA-Buchungen, zum Beispiel über Booking oder Airbnb, gelten immer die Zahlungs- und Stornierungsbedingungen des jeweiligen Kanals."
  tocLabel="Zum Abschnitt springen"
  tocPlaceholder="Abschnitt wählen"
  sections={sections}
/>
