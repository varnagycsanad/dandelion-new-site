    groups: [
      {
        title: "Dandelion D1 / D2 / Fugehaz",
        lines: ["Beguenstigte: Ilona Varnagy", "Revolut", "OTP HUF", "Kontonummer / IBAN", "OTP EUR", "Kontonummer / IBAN", "BIC / SWIFT"]
