---
import GermanExperiencePage from "../../templates/GermanExperiencePage.astro";
import heroImage from "../../assets/experiences/szent-gyorgy-hegy-szolo.jpg";
import supportImage from "../../assets/experiences/tanuhegyek-drone-dji-20260512.jpg";
---

<GermanExperiencePage
  title="Weingüter bei Badacsony | Dandelion Unterkünfte"
  description="Weingüter, Weinterrassen und entspannte Abendprogramme rund um Badacsony, Szent György-hegy und die Dandelion Unterkünfte."
  canonicalPath="/de/weingueter/"
  breadcrumbName="Weingüter"
  eyebrow="Wein und Panorama"
  heading="Weinberge, Terrassen und langsame Abende."
  lead={[
    "Rund um die Dandelion Häuser gehört Wein zur Landschaft. Szent György-hegy, Badacsony und die vulkanischen Hügel verbinden Weinberge, Kellerstraßen und Terrassen mit Aussicht.",
    "Am besten funktioniert die Region ohne Eile: ein kurzer Spaziergang, ein Glas Wein, Abendessen auf einer Terrasse oder eine Verkostung direkt beim Weingut."
  ]}
  heroImage={heroImage}
  heroAlt="Weinberge am Szent György-hegy"
  supportImage={supportImage}
  supportAlt="Vulkanische Zeugenberge rund um Badacsony"
  supportTitle="Mit der Aussicht beginnen."
  supportText="Ein ruhiger Keller am Hügel oder eine lebendigere Badacsony-Terrasse: beide Richtungen passen, wenn der Plan flexibel bleibt."
  highlights={["Keller am Szent György-hegy", "Badacsony Weinterrassen mit Balaton-Blick", "Sonnenuntergang, Wein und Abendessen", "gut für Paare, Freunde und ruhige Aufenthalte"]}
  primaryLink={{ label: "Unterkünfte ansehen", href: "/de/unterkuenfte/" }}
  secondaryLink={{ label: "Zurück zu Erlebnissen", href: "/de/erlebnisse/" }}
  sections={[
    {
      title: "Weingüter und Terrassen in der Nähe",
      cards: [
        { title: "Szent György-hegy", body: "Szászi Birtok, Gilvesy Winery, Nyári Pince und PAP Wines passen gut zu ruhigeren Wein-Tagen." },
        { title: "Badacsony", body: "Laposa Wine Terrace, Hableány Badacsony, Borbély Family Winery, Valibor Vinoteka und Folly Arboretum sind klassische Richtungen." },
        { title: "Vor dem Losfahren", body: "Öffnungszeiten, Verkostungen und Tischverfügbarkeit können saisonal wechseln. Aktuelle Details bitte direkt prüfen." }
      ]
    },
    {
      title: "Programmideen",
      cards: [
        { title: "Langsamer Nachmittag", body: "Ein Spaziergang, ein Glas Wein und Aussicht können schon reichen." },
        { title: "Badacsony-Abend", body: "Mehr Bewegung, Restaurants, Terrassen und klassisches Balaton-Sommergefühl." },
        { title: "Zwei oder drei gute Stopps", body: "Eine kleine, gut gewählt Route ist meist besser als eine lange Liste." }
      ]
    }
  ]}
/>
