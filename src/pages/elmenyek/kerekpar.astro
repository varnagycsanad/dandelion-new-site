---
import BaseLayout from "../../layouts/BaseLayout.astro";

const heroVideo = "/videos/elmenyek/kerekpar/balaton-felvideki-bicikli-tura.mp4";
const desktopImage = "/images/bicikli/balaton-felvidek-bicikli-desktop.webp";
const mobileImage = "/images/bicikli/balaton-felvidek-bicikli-mobile.webp";
const bikeOgImage = desktopImage;

const availableBikes = [
  "4 db normál felnőtt kerékpár",
  "2 db elektromos kerékpár",
  "1 db gyerek kerékpár"
];

const pricing = [
  "Normál felnőtt kerékpár: 9 000 Ft / nap",
  "Elektromos kerékpár: 12 000 Ft / nap",
  "Gyerek kerékpár: előzetes egyeztetés alapján"
];

const rentalNotes = [
  "A kerékpárok Royal Homes, Köveskál és Szépvölgyi Vendégház vendégei számára nem érhetők el.",
  "A Szőlőliget, Zsálya és Vintage Vendégház vendégei a bicikliket központi címünkön tudják átvenni, és használat után ugyanott tudják leadni.",
  "A kerékpárok átvétele és leadása előzetes egyeztetés szerint történik."
];

const routeIdeas = [
  {
    title: "Könnyed kör a közelben",
    body:
      "Rövid programhoz jó választás a közeli falvak, szőlőhegyek és kilátópontok felfedezése. Ez inkább hangulati tekerés: nem a teljesítményről szól, hanem a tájról, a megállókról és a nyugodt tempóról."
  },
  {
    title: "Szent György-hegy és tanúhegyek",
    body:
      "A Szent György-hegy környéke látványos, de helyenként emelkedős terep. Itt az elektromos bicikli különösen kényelmes választás lehet, ha a felfedezés a fő cél."
  },
  {
    title: "Badacsony és balatoni irány",
    body:
      "A Balaton felé indulva strandok, borászatok és panorámás szakaszok is útba eshetnek. Ez jó ritmus azoknak, akik a bringázást egy balatoni nappal kötik össze."
  },
  {
    title: "Káli-medence kirándulás",
    body:
      "A Káli-medence apró falvai, különleges hangulata és sok megállási pontja miatt hosszabb, előre tervezett bringás programhoz ideális."
  }
];

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Főoldal",
        item: "https://dandelionhouse.hu/"
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Élmények",
        item: "https://dandelionhouse.hu/elmenyek/"
      },
      {
        "@type": "ListItem",
        position: 3,
        name: "Kerékpár",
        item: "https://dandelionhouse.hu/elmenyek/kerekpar/"
      }
    ]
  }
];
---

<BaseLayout
  title="Balaton-felvidéki bicikli túra | Dandelion Vendégházak"
  description="Balaton-felvidéki bicikli túra szőlőhegyek, tanúhegyek és panorámás mellékutak között. Kerékpárbérlési árak és tudnivalók a Dandelion Vendégházak vendégeinek."
  canonicalPath="/elmenyek/kerekpar/"
  ogImage={bikeOgImage}
  ogImageAlt="Biciklik a Balaton-felvidéki szőlősorok mellett, panorámával a háttérben"
  structuredData={structuredData}
  headerMode="transparent"
>
  <section class="bike-page">
    <section class="bike-hero">
      <video
        class="bike-hero__video"
        src={heroVideo}
        autoplay
        muted
        loop
        playsinline
      >
        A böngésződ nem támogatja a háttérvideó lejátszását.
      </video>

      <div class="bike-hero__overlay"></div>

      <div class="bike-hero__content">
        <div class="dnd-container bike-hero__inner">
          <p class="bike-hero__line">Balaton-felvidéken biciklizni: nagyszerű!</p>
        </div>
      </div>
    </section>

    <div class="dnd-container bike-page__inner">
      <section class="bike-intro">
        <article class="bike-intro__copy">
          <span class="bike-page__eyebrow">Balaton-felvidék két keréken</span>
          <h2>Nem csak egy bringás kör, hanem egy külön ritmus</h2>
          <p>
            A Balaton-felvidék biciklivel egészen más élmény: lassabb, szabadabb, közelebb visz a
            tájhoz. A szállástól indulva könnyen elérhetők a csendes falvak, a szőlőhegyek, a
            kilátópontok és azok a megállók, ahol nem kell sietni tovább.
          </p>
          <p>
            Akár egy rövid délutáni tekerést tervezel, akár egész napos kirándulást, a környék
            sokféle tempót elbír. A dombosabb részekhez az elektromos bicikli különösen kényelmes,
            de egy nyugodt falunéző vagy balatoni körhöz a normál kerékpárok is jó választások.
          </p>
        </article>

        <div class="bike-intro__media">
          <img
            class="bike-intro__image bike-intro__image--desktop"
            src={desktopImage}
            alt="Biciklik a Balaton-felvidéki szőlősorok mellett, panorámával a háttérben"
            loading="lazy"
            width="1800"
            height="1350"
          />
          <img
            class="bike-intro__image bike-intro__image--mobile"
            src={mobileImage}
            alt="Álló formátumú biciklis hangulatkép a Balaton-felvidék szőlőhegyei között"
            loading="lazy"
            width="1200"
            height="1600"
          />
        </div>
      </section>

      <section class="bike-routes" aria-label="Bringás hangulat és útvonalak">
        <div class="bike-routes__intro">
          <span class="bike-page__eyebrow">Útvonal-hangulat</span>
          <h2>Innen már csak azt kell eldönteni, milyen napot szeretnél</h2>
          <p>
            Van, amikor egy rövid panorámás kör esik jól, máskor egy hosszabb, megállókkal teli
            balatoni vagy borvidéki út. Az oldal logikája most már innen visz tovább a gyakorlati
            részletekhez.
          </p>
        </div>

        <div class="bike-routes__grid">
          {routeIdeas.map((item) => (
            <article class="bike-route-card">
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="bike-page__accordions" aria-label="Kerékpáros részletek">
        <details class="bike-accordion" open>
          <summary>Kerékpárbérlés részletei, árak és feltételek</summary>
          <div class="bike-accordion__content">
            <p>
              Vendégeink számára előzetes egyeztetés alapján kerékpárbérlési lehetőséget
              biztosítunk. A biciklik korlátozott számban állnak rendelkezésre, ezért kérjük,
              időben jelezzétek, ha szeretnétek használni őket.
            </p>

            <div class="bike-grid">
              <article class="bike-info-card">
                <h3>Elérhető kerékpárok</h3>
                <ul>
                  {availableBikes.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </article>

              <article class="bike-info-card">
                <h3>Bérleti díjak</h3>
                <ul>
                  {pricing.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </article>
            </div>

            <article class="bike-info-card bike-info-card--notes">
              <h3>Fontos tudnivalók</h3>
              <ul>
                {rentalNotes.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </article>
          </div>
        </details>

        <details class="bike-accordion">
          <summary>Hosszabb bringás naphoz további ötletek</summary>
          <div class="bike-accordion__content">
            <p>
              Ha kijelölt, hosszabb útvonalat kerestek, érdemes a
              <a href="https://www.balatonbike365.hu/" target="_blank" rel="noopener noreferrer">
                BalatonBike365 ajánlásai
              </a>
              között is körülnézni, mert ott több balatoni és Balaton-felvidéki kerékpáros kör is
              található.
            </p>
          </div>
        </details>
      </section>

      <section class="bike-page__cta">
        <h2>Megvan a bringás terv, jöhet a szállás?</h2>
        <p>
          Nézd meg, melyik Dandelion ház illik legjobban a tervezett bringás naphoz, és onnan
          indítsd a környék felfedezését.
        </p>
        <div class="bike-page__cta-actions">
          <a href="/szallasok/" class="bike-page__cta-primary">Szállások megtekintése</a>
          <a href="/elmenyek/" class="bike-page__cta-secondary">Vissza az élményekhez</a>
        </div>
      </section>
    </div>
  </section>
</BaseLayout>

<style>
  .bike-page {
    padding-bottom: 88px;
    background:
      radial-gradient(circle at top left, rgba(215, 188, 127, 0.16), transparent 34%),
      linear-gradient(180deg, #fcfbf7 0%, #f6f0e7 100%);
  }

  .bike-page__inner {
    display: grid;
    gap: 28px;
    margin-top: 28px;
  }

  .bike-page__eyebrow {
    display: inline-block;
    color: #d99e2b;
    font-size: var(--dnd-text-2xs);
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .bike-hero {
    position: relative;
    min-height: 720px;
    height: 92vh;
    overflow: hidden;
    background: #161616;
  }

  .bike-hero__video,
  .bike-hero__overlay {
    position: absolute;
    inset: 0;
  }

  .bike-hero__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .bike-hero__overlay {
    background:
      linear-gradient(180deg, rgba(18, 14, 10, 0.02) 0%, rgba(18, 14, 10, 0.06) 55%, rgba(18, 14, 10, 0.22) 100%),
      linear-gradient(90deg, rgba(18, 14, 10, 0.03) 0%, rgba(18, 14, 10, 0.01) 100%);
  }

  .bike-hero__content {
    position: relative;
    z-index: 1;
    min-height: 100%;
    color: #fff;
  }

  .bike-hero__inner {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    min-height: 100%;
    padding: 140px clamp(20px, 4vw, 48px) 22px;
    max-width: none;
  }

  .bike-hero__line {
    margin: 0;
    color: #fff;
    font-family: var(--dnd-font-display);
    font-size: clamp(1.8rem, 3vw, 3.1rem);
    line-height: 1.05;
    font-weight: 500;
    text-align: center;
    text-shadow: 0 8px 24px rgba(0, 0, 0, 0.38);
  }

  .bike-intro__copy,
  .bike-routes__intro,
  .bike-page__cta {
    border: 1px solid rgba(88, 63, 38, 0.12);
    border-radius: 24px;
    background: rgba(255, 252, 246, 0.9);
    box-shadow: 0 20px 56px rgba(43, 28, 14, 0.07);
  }

  .bike-intro {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(320px, 1.05fr);
    gap: 24px;
    align-items: stretch;
  }

  .bike-intro__copy,
  .bike-routes__intro,
  .bike-page__cta {
    padding: 28px;
  }

  .bike-intro__copy,
  .bike-routes__intro {
    display: grid;
    gap: 14px;
  }

  .bike-intro__copy h2,
  .bike-routes__intro h2,
  .bike-route-card h3,
  .bike-accordion__content h3,
  .bike-page__cta h2,
  .bike-info-card h3 {
    margin: 0;
    font-family: var(--dnd-font-display);
    line-height: 1.08;
    font-weight: 500;
    color: #261d16;
  }

  .bike-intro__copy p,
  .bike-routes__intro p,
  .bike-route-card p,
  .bike-accordion__content p,
  .bike-accordion__content li,
  .bike-page__cta p {
    margin: 0;
    color: rgba(38, 29, 22, 0.76);
    font-size: var(--dnd-text-body);
    line-height: 1.72;
  }

  .bike-intro__media {
    position: relative;
    overflow: hidden;
    border-radius: 24px;
    min-height: 100%;
    box-shadow: 0 24px 64px rgba(43, 28, 14, 0.12);
  }

  .bike-intro__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .bike-intro__image--mobile {
    display: none;
  }

  .bike-routes {
    display: grid;
    gap: 18px;
  }

  .bike-routes__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .bike-route-card,
  .bike-info-card {
    display: grid;
    gap: 10px;
    padding: 20px;
    border-radius: 18px;
    background: #faf6ef;
    border: 1px solid rgba(88, 63, 38, 0.08);
  }

  .bike-page__accordions {
    display: grid;
    gap: 16px;
  }

  .bike-accordion {
    border: 1px solid rgba(88, 63, 38, 0.12);
    border-radius: 22px;
    background: rgba(255, 255, 255, 0.92);
    box-shadow: 0 18px 48px rgba(48, 34, 20, 0.05);
    overflow: hidden;
  }

  .bike-accordion summary {
    list-style: none;
    cursor: pointer;
    padding: 24px 28px;
    color: #261d16;
    font-family: var(--dnd-font-display);
    font-size: clamp(1.35rem, 2vw, 1.9rem);
    line-height: 1.15;
    position: relative;
  }

  .bike-accordion summary::-webkit-details-marker {
    display: none;
  }

  .bike-accordion summary::after {
    content: "+";
    position: absolute;
    right: 28px;
    top: 50%;
    transform: translateY(-50%);
    color: rgba(38, 29, 22, 0.7);
    font-size: 1.6rem;
    transition: transform 0.2s ease;
  }

  .bike-accordion[open] summary::after {
    transform: translateY(-50%) rotate(45deg);
  }

  .bike-accordion__content {
    display: grid;
    gap: 18px;
    padding: 0 28px 28px;
  }

  .bike-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .bike-info-card ul {
    margin: 0;
    padding-left: 18px;
    display: grid;
    gap: 8px;
  }

  .bike-info-card--notes {
    background: rgba(255, 252, 246, 0.92);
  }

  .bike-accordion a {
    color: #7b4f12;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
  }

  .bike-page__cta h2 {
    font-size: clamp(1.5rem, 2.3vw, 2.2rem);
    margin: 0 0 8px;
  }

  .bike-page__cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .bike-page__cta-primary,
  .bike-page__cta-secondary {
    min-height: 46px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0 18px;
    text-decoration: none;
    font-size: var(--dnd-text-xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    border: 1px solid rgba(65, 47, 30, 0.4);
    transition: all 0.2s ease;
  }

  .bike-page__cta-primary {
    background: #2b2016;
    color: #fff;
    border-color: #2b2016;
  }

  .bike-page__cta-secondary {
    background: #fff;
    color: #2b2016;
  }

  .bike-page__cta-primary:hover,
  .bike-page__cta-primary:focus-visible {
    background: #3a2a1d;
  }

  .bike-page__cta-secondary:hover,
  .bike-page__cta-secondary:focus-visible {
    background: #f7efe2;
  }

  @media (max-width: 1100px) {
    .bike-intro,
    .bike-routes__grid,
    .bike-grid {
      grid-template-columns: 1fr;
    }

    .bike-hero {
      min-height: 660px;
    }
  }

  @media (max-width: 767px) {
    .bike-page {
      padding-bottom: 64px;
    }

    .bike-page__inner {
      gap: 22px;
      margin-top: 22px;
    }

    .bike-hero {
      min-height: 520px;
      height: auto;
    }

    .bike-hero__inner {
      align-items: flex-end;
      justify-content: center;
      padding: 122px 16px 16px;
    }

    .bike-hero__line {
      font-size: clamp(1.25rem, 6vw, 1.8rem);
      line-height: 1.08;
    }

    .bike-intro__copy,
    .bike-routes__intro,
    .bike-page__cta {
      padding: 20px;
    }

    .bike-intro__copy,
    .bike-intro__media,
    .bike-routes__intro,
    .bike-route-card,
    .bike-accordion,
    .bike-page__cta {
      border-radius: 18px;
    }

    .bike-intro__media {
      min-height: 520px;
    }

    .bike-intro__image--desktop {
      display: none;
    }

    .bike-intro__image--mobile {
      display: block;
    }

    .bike-accordion summary,
    .bike-accordion__content {
      padding-left: 20px;
      padding-right: 20px;
    }

    .bike-accordion__content {
      padding-bottom: 20px;
    }

    .bike-accordion summary::after {
      right: 20px;
    }
  }
</style>
