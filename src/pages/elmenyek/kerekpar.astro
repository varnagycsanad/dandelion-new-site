---
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import heroImage from "../../assets/experiences/stock-bike.jpg";
import vineyardImage from "../../assets/experiences/szent-gyorgy-hegy-szolo.jpg";

const availableBikes = [
  "4 db normál felnőtt kerékpár",
  "2 db elektromos kerékpár",
  "1 db gyerek kerékpár"
];

const pricing = [
  "Normál felnőtt kerékpár: 9 000 Ft / nap",
  "Elektromos kerékpár: 12 000 Ft / nap",
  "Gyerek kerékpár: előzetes egyeztetés alapján"
];

const rentalNotes = [
  "A kerékpárok Royal Homes, Köveskál és Szépvölgyi Vendégház vendégei számára nem érhetők el.",
  "A Szőlőliget, Zsálya és Vintage Vendégház vendégei a bicikliket központi címünkön tudják átvenni, és használat után ugyanott tudják leadni.",
  "A kerékpárok átvétele és leadása előzetes egyeztetés szerint történik."
];

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Főoldal",
        item: "https://dandelionhouse.hu/"
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Élmények",
        item: "https://dandelionhouse.hu/elmenyek/"
      },
      {
        "@type": "ListItem",
        position: 3,
        name: "Kerékpár",
        item: "https://dandelionhouse.hu/elmenyek/kerekpar/"
      }
    ]
  }
];
---

<BaseLayout
  title="Bringás élmény a Balaton-felvidéken | Dandelion Vendégházak"
  description="Kerékpáros élmények, útvonalötletek, bérlési árak és feltételek a Balaton-felvidéken a Dandelion Vendégházak vendégeinek."
  canonicalPath="/elmenyek/kerekpar/"
  structuredData={structuredData}
>
  <section class="bike-page">
    <div class="dnd-container bike-page__inner">
      <section class="bike-page__hero">
        <div class="bike-page__hero-copy">
          <span class="bike-page__eyebrow">Bringás élmény</span>
          <h1>Fedezd fel a Balaton-felvidéket két keréken</h1>
          <p>
            A Balaton-felvidék biciklivel egészen más élmény: lassabb, szabadabb, közelebb visz a
            tájhoz. Csendes falvak, szőlőhegyek, tanúhegyek, kilátópontok, borászatok és balatoni
            panorámák várnak útközben.
          </p>
          <p>
            Akár egy rövid délutáni tekerésre indulnál, akár egy hosszabb balatoni bringatúrát
            tervezel, a környék rengeteg lehetőséget ad. A dombosabb részekhez az elektromos bicikli
            különösen kényelmes választás, de egy könnyed falunéző vagy balatoni körhöz a normál
            kerékpárok is jók lehetnek.
          </p>
          <p>
            Vendégeink számára korlátozott számban kerékpárok is elérhetők, így nem feltétlenül kell
            saját biciklit hozni az utazáshoz.
          </p>
          <div class="bike-page__hero-actions">
            <a href="/szallasok/" class="bike-page__cta-primary">Szállások megtekintése</a>
            <a
              href="https://ibe.sabeeapp.com/v3/p/Dandelion-Vendégházak?p=3970b30e1042d58f&lang=Hu"
              class="bike-page__cta-secondary"
              target="_blank"
              rel="noopener noreferrer"
            >
              Foglalás / Ár
            </a>
          </div>
        </div>

        <div class="bike-page__hero-media">
          <Image
            src={heroImage}
            alt="Hangulati bringás kép a Balaton-felvidéki kerékpáros élményhez"
            loading="eager"
          />
        </div>
      </section>

      <section class="bike-page__support">
        <article class="bike-page__support-card">
          <span class="bike-page__eyebrow">Hangulat</span>
          <h2>Ne árlista legyen az első benyomás</h2>
          <p>
            Ezen az oldalon először kedvet kap a vendég a bringás naphoz, és csak utána jönnek a
            gyakorlati részletek. Ez sokkal természetesebb, mint egy száraz bérlési blokk.
          </p>
        </article>

        <article class="bike-page__support-card">
          <Image
            src={vineyardImage}
            alt="Szent György-hegyi szőlősorok és panoráma"
            loading="lazy"
          />
        </article>
      </section>

      <section class="bike-page__accordions" aria-label="Kerékpáros részletek">
        <details class="bike-accordion" open>
          <summary>Kerékpáros útvonalötletek a környéken</summary>
          <div class="bike-accordion__content">
            <p>
              A pontos útvonalat mindig érdemes az aktuális időjáráshoz, erőnléthez és
              kerékpártípushoz igazítani, de a környéken több jó bringás irány is adja magát.
            </p>

            <div class="bike-route">
              <h3>Könnyed környékbeli tekerés</h3>
              <p>
                Rövidebb programhoz jó választás lehet a közeli falvak, szőlőhegyek és kilátópontok
                felfedezése. Ez inkább hangulati tekerés: nem a teljesítményről szól, hanem a tájról,
                a megállókról és a nyugodt tempóról.
              </p>
            </div>

            <div class="bike-route">
              <h3>Szent György-hegy és tanúhegyek környéke</h3>
              <p>
                A Szent György-hegy környéke látványos, de helyenként emelkedős terep. Itt az
                elektromos bicikli nagy előny lehet, főleg ha nem sporttúrát, hanem kényelmes
                felfedezést szeretnétek.
              </p>
            </div>

            <div class="bike-route">
              <h3>Badacsony és balatoni irány</h3>
              <p>
                A Balaton felé indulva hangulatos megállók, borászatok, strandok és panorámás részek
                is útba eshetnek. Ez jó választás lehet azoknak, akik a bringázást összekötnék egy
                balatoni programmal.
              </p>
            </div>

            <div class="bike-route">
              <h3>Káli-medence irány</h3>
              <p>
                A Káli-medence a Balaton-felvidék egyik legszebb része, apró falvakkal, különleges
                hangulattal és sok megállási lehetőséggel. Ez már inkább hosszabb kirándulás, ezért
                előzetes tervezést igényel.
              </p>
            </div>

            <div class="bike-route">
              <h3>Hosszabb balatoni túrák</h3>
              <p>
                Akik komolyabb útvonalat keresnek, azoknak érdemes a
                <a href="https://www.balatonbike365.hu/" target="_blank" rel="noopener noreferrer">
                  BalatonBike365 ajánlásai
                </a>
                között is körülnézni, mert ott több kijelölt balatoni és Balaton-felvidéki kerékpáros
                útvonal is található.
              </p>
            </div>
          </div>
        </details>

        <details class="bike-accordion">
          <summary>Kerékpárbérlés részletei, árak és feltételek</summary>
          <div class="bike-accordion__content">
            <p>
              Vendégeink számára előzetes egyeztetés alapján kerékpárbérlési lehetőséget biztosítunk.
              A biciklik korlátozott számban állnak rendelkezésre, ezért kérjük, időben jelezzétek,
              ha szeretnétek használni őket.
            </p>

            <div class="bike-grid">
              <article class="bike-info-card">
                <h3>Elérhető kerékpárok</h3>
                <ul>
                  {availableBikes.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </article>

              <article class="bike-info-card">
                <h3>Bérleti díjak</h3>
                <ul>
                  {pricing.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </article>
            </div>

            <article class="bike-info-card bike-info-card--notes">
              <h3>Fontos tudnivalók</h3>
              <ul>
                {rentalNotes.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </article>
          </div>
        </details>
      </section>

      <section class="bike-page__cta">
        <h2>Megvan a bringás terv, jöhet a szállás?</h2>
        <p>
          Nézd meg, melyik Dandelion ház illik legjobban a tervezett bringás naphoz, és onnan indítsd
          a környék felfedezését.
        </p>
        <div class="bike-page__cta-actions">
          <a href="/szallasok/" class="bike-page__cta-primary">Szállások megtekintése</a>
          <a href="/elmenyek/" class="bike-page__cta-secondary">Vissza az élményekhez</a>
        </div>
      </section>
    </div>
  </section>
</BaseLayout>

<style>
  .bike-page {
    padding: 124px 0 88px;
    background:
      radial-gradient(circle at top left, rgba(215, 188, 127, 0.14), transparent 32%),
      linear-gradient(180deg, #fcfbf7 0%, #f6efe5 100%);
  }

  .bike-page__inner {
    display: grid;
    gap: 30px;
  }

  .bike-page__eyebrow {
    display: inline-block;
    color: #a56d1f;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .bike-page__hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(320px, 0.9fr);
    gap: 28px;
    align-items: stretch;
  }

  .bike-page__hero-copy,
  .bike-page__support-card,
  .bike-page__cta {
    border: 1px solid rgba(88, 63, 38, 0.12);
    border-radius: 24px;
    background: rgba(255, 252, 246, 0.88);
    box-shadow: 0 20px 56px rgba(43, 28, 14, 0.07);
  }

  .bike-page__hero-copy {
    display: grid;
    gap: 14px;
    padding: 34px;
  }

  .bike-page__hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 4px;
  }

  .bike-page__hero-copy h1,
  .bike-page__support-card h2,
  .bike-accordion__content h3,
  .bike-page__cta h2,
  .bike-info-card h3 {
    margin: 0;
    color: #261d16;
    font-family: var(--dnd-font-display);
    line-height: 1.08;
    font-weight: 500;
  }

  .bike-page__hero-copy h1 {
    font-size: clamp(2.4rem, 4vw, 4.2rem);
    max-width: 11ch;
  }

  .bike-page p,
  .bike-accordion__content p,
  .bike-accordion__content li {
    margin: 0;
    color: rgba(38, 29, 22, 0.76);
    font-size: 1rem;
    line-height: 1.72;
  }

  .bike-page__hero-media,
  .bike-page__support-card :global(picture) {
    overflow: hidden;
    border-radius: 24px;
  }

  .bike-page__hero-media {
    box-shadow: 0 24px 64px rgba(43, 28, 14, 0.12);
  }

  .bike-page__hero-media :global(picture),
  .bike-page__hero-media :global(img),
  .bike-page__support-card :global(picture),
  .bike-page__support-card :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .bike-page__hero-media :global(img),
  .bike-page__support-card :global(img) {
    object-fit: cover;
  }

  .bike-page__support {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 0.8fr);
    gap: 24px;
  }

  .bike-page__support-card {
    padding: 28px;
    display: grid;
    gap: 12px;
  }

  .bike-page__support-card:last-child {
    padding: 0;
    overflow: hidden;
  }

  .bike-page__accordions {
    display: grid;
    gap: 16px;
  }

  .bike-accordion {
    border: 1px solid rgba(88, 63, 38, 0.12);
    border-radius: 22px;
    background: rgba(255, 255, 255, 0.92);
    box-shadow: 0 18px 48px rgba(48, 34, 20, 0.05);
    overflow: hidden;
  }

  .bike-accordion summary {
    list-style: none;
    cursor: pointer;
    padding: 24px 28px;
    color: #261d16;
    font-family: var(--dnd-font-display);
    font-size: clamp(1.35rem, 2vw, 1.9rem);
    line-height: 1.15;
    position: relative;
  }

  .bike-accordion summary::-webkit-details-marker {
    display: none;
  }

  .bike-accordion summary::after {
    content: "+";
    position: absolute;
    right: 28px;
    top: 50%;
    transform: translateY(-50%);
    color: rgba(38, 29, 22, 0.7);
    font-size: 1.6rem;
    transition: transform 0.2s ease;
  }

  .bike-accordion[open] summary::after {
    transform: translateY(-50%) rotate(45deg);
  }

  .bike-accordion__content {
    display: grid;
    gap: 18px;
    padding: 0 28px 28px;
  }

  .bike-route,
  .bike-info-card {
    display: grid;
    gap: 10px;
    padding: 20px;
    border-radius: 18px;
    background: #faf6ef;
    border: 1px solid rgba(88, 63, 38, 0.08);
  }

  .bike-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .bike-info-card ul {
    margin: 0;
    padding-left: 18px;
    display: grid;
    gap: 8px;
  }

  .bike-info-card--notes {
    background: rgba(255, 252, 246, 0.92);
  }

  .bike-accordion a {
    color: #7b4f12;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
  }

  .bike-page__cta {
    padding: 28px;
  }

  .bike-page__cta h2 {
    font-size: clamp(1.5rem, 2.3vw, 2.2rem);
  }

  .bike-page__cta-actions {
    margin-top: 18px;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .bike-page__cta-primary,
  .bike-page__cta-secondary {
    min-height: 46px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0 18px;
    text-decoration: none;
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    border: 1px solid rgba(65, 47, 30, 0.4);
    transition: all 0.2s ease;
  }

  .bike-page__cta-primary {
    background: #2b2016;
    color: #fff;
    border-color: #2b2016;
  }

  .bike-page__cta-secondary {
    background: #fff;
    color: #2b2016;
  }

  .bike-page__cta-primary:hover,
  .bike-page__cta-primary:focus-visible {
    background: #3a2a1d;
  }

  .bike-page__cta-secondary:hover,
  .bike-page__cta-secondary:focus-visible {
    background: #f7efe2;
  }

  @media (max-width: 1100px) {
    .bike-page__hero,
    .bike-page__support,
    .bike-grid {
      grid-template-columns: 1fr;
    }

    .bike-page__hero-copy h1 {
      max-width: 13ch;
    }
  }

  @media (max-width: 767px) {
    .bike-page {
      padding: 106px 0 64px;
    }

    .bike-page__inner {
      gap: 22px;
    }

    .bike-page__hero-copy,
    .bike-page__support-card,
    .bike-page__cta {
      padding: 20px;
    }

    .bike-page__hero-copy,
    .bike-page__hero-media,
    .bike-page__support-card,
    .bike-accordion,
    .bike-page__cta {
      border-radius: 18px;
    }

    .bike-accordion summary,
    .bike-accordion__content {
      padding-left: 20px;
      padding-right: 20px;
    }

    .bike-accordion__content {
      padding-bottom: 20px;
    }

    .bike-accordion summary::after {
      right: 20px;
    }

    .bike-page__hero-copy h1 {
      max-width: none;
      font-size: clamp(2.2rem, 10vw, 3.2rem);
    }
  }
</style>
