---
import CzechExperiencePage from "../../templates/CzechExperiencePage.astro";
import { panoramaPoolImages } from "../../data/images/panorama-pool-images";
import heroImage from "../../assets/experiences/tanuhegyek-drone-dji-20260512.jpg";

const poolHero = panoramaPoolImages.find((image) => image.usageHint === "hero");
---

<CzechExperiencePage
  title="Dandelion Panorama Pool | Panoramatický bazén u Balatonu"
  description="Od 15. června 2026 je Panorama Pool součástí letního pobytu pro hosty Dandelion D1, D2 a Fügeház v Kisapáti."
  canonicalPath="/cs/panorama-pool/"
  breadcrumbName="Panorama Pool"
  eyebrow="Letní zážitek"
  heading="Panorama Pool u Szent György-hegy."
  lead={[
    "Panorama Pool je určený pro hosty blízkých domů Dandelion D1, Dandelion D2 a Fügeház.",
    "Koupání, výhled a klidnější rytmus Balatonské vrchoviny se od 15. června 2026 stanou součástí letního pobytu."
  ]}
  heroImage={heroImage}
  heroAlt={poolHero?.altEn ?? "Panorama Pool v Balatonské vrchovině"}
  highlights={["u Szent György-hegy", "výhled na svědecké hory a Badacsony", "pro hosty D1, D2 a Fügeház", "dostupné od 15. června 2026"]}
  primaryLink={{ label: "Zobrazit D1", href: "/cs/dandelion-d1/" }}
  secondaryLink={{ label: "Zobrazit D2", href: "/cs/dandelion-d2/" }}
  sections={[
    {
      title: "Bazén stručně",
      cards: [
        { title: "Není samostatně rezervovatelný", body: "Bazén patří k pobytu v D1, D2 a Fügeház během bazénové sezony." },
        { title: "Prostor pro hosty", body: "Panorama Pool je prostor Panorama Pool pro vybrané domy Dandelion." },
        { title: "Léto 2026", body: "Dostupnost je plánovaná od 15. června 2026." }
      ]
    },
    {
      title: "Ubytování s přístupem k bazénu",
      cards: [
        { title: "Dandelion D1", body: "Velký dům pro rodiny a přátele.", href: "/cs/dandelion-d1/", linkLabel: "Otevřít D1" },
        { title: "Dandelion D2", body: "Rodinné ubytování se zahradou a terasou.", href: "/cs/dandelion-d2/", linkLabel: "Otevřít D2" },
        { title: "Dandelion Fügeház", body: "Panoramatický dům s terasou a klidnou polohou.", href: "/cs/dandelion-fugehaz/", linkLabel: "Otevřít Fügeház" }
      ]
    }
  ]}
/>
