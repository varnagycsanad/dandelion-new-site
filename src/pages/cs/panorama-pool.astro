---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PoolGalleryLightbox from "../../components/PoolGalleryLightbox.astro";
import Hero from "../../sections/Hero.astro";
import { panoramaPoolHero, panoramaPoolImages } from "../../data/images/panorama-pool-images";
import { d1CzechPageData } from "../../data/accommodation-pages/d1.cs";
import { d2CzechPageData } from "../../data/accommodation-pages/d2.cs";
import { fugehazCzechPageData } from "../../data/accommodation-pages/fugehaz.cs";
import { buildVideoObject } from "../../data/video-seo";

const baseHref = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const resolveHref = (path: string) => `${baseHref}${path.replace(/^\/+/, "")}`;
const poolLandingHref = resolveHref("/cs/ubytovani/");

const sortedImages = [...panoramaPoolImages].sort((a, b) => a.sortOrder - b.sortOrder);
const heroImage = sortedImages.find((image) => image.usageHint === "hero") ?? sortedImages[0];
const galleryImages = sortedImages;

const poolHeroVideos = {
  desktop: "/videos/medence/HERO/PC%20video/dandelion-panorama-pool-hero-desktop-20260610.mp4?v=20260610",
  mobile: "/videos/medence/HERO/Phone%20video/dandelion-panorama-pool-hero-mobile-20260610.mp4?v=20260610"
};
// [CHANGE 2026-05-29 00:00] Panorama Pool video exposes a thumbnail URL through VideoObject data.
const poolVideoStructuredData = buildVideoObject({
  id: "/cs/panorama-pool/#hero-video",
  name: "Dandelion Panorama Pool video",
  description: "Hero video představující Panorama Pool a výhledy v Balatonské vrchovině.",
  contentUrl: poolHeroVideos.desktop,
  thumbnailUrl: panoramaPoolHero.desktop,
  uploadDate: "2026-06-10T00:00:00+02:00",
  inLanguage: "cs-CZ"
});

const getStayImage = (key: "d1" | "d2" | "fugehaz") => {
  const pageDataMap = {
    d1: d1CzechPageData,
    d2: d2CzechPageData,
    fugehaz: fugehazCzechPageData
  } as const;
  const pageData = pageDataMap[key];
  const fallbackTitleMap = {
    d1: "Dandelion D1 hero",
    d2: "Dandelion D2 hero",
    fugehaz: "Fügeház hero"
  } as const;

  return {
    desktopSrc: pageData.hero.mobileImagePath,
    mobileSrc: pageData.hero.mobileImagePath,
    altEn: pageData.hero.fallbackAlt,
    titleEn: fallbackTitleMap[key]
  };
};

const stays = [
  {
    title: "Dandelion D1",
    href: resolveHref("/cs/dandelion-d1/"),
    image: getStayImage("d1"),
    description: "3 ložnice + obývací pokoj, až 8 hostů. Klimatizace, pergola, 2 koupelny."
  },
  {
    title: "Dandelion D2",
    href: resolveHref("/cs/dandelion-d2/"),
    image: getStayImage("d2"),
    description: "Pohodlné pro 4-6 hostů. Klimatizace, velká terasa a zahrada."
  },
  {
    title: "Fügeház",
    href: resolveHref("/cs/dandelion-fugehaz/"),
    image: getStayImage("fugehaz"),
    description: "Pohodlné pro 4 hosty, s přistýlkou až pro 6. Klimatizace, terasa směrem ke svědeckým horám."
  }
];

const poolGeoFaqItems = [
  {
    question: "Kdo může využívat Panorama Pool?",
    answer: "Bazén mohou využívat hosté Dandelion D1, Dandelion D2 a Fügeház."
  },
  {
    question: "Kde se bazén nachází?",
    answer: "V Kisapáti, u paty Szent György-hegy, na kopci vedle domů."
  },
  {
    question: "Jaký výhled je od bazénu?",
    answer: "Z okolí bazénu jsou vidět svědecké hory Balatonské vrchoviny."
  },
  {
    question: "Jak velký a hluboký je bazén?",
    answer: "Bazén má rozměr 8 x 4 metry, je hluboký přibližně 130 cm a má také zastřešení. Děti ho mohou používat jen pod dohledem dospělých."
  }
];

const poolTemperatureFallback = "Brzy";
const poolLiveWidgetSrc = import.meta.env.DEV
  ? "http://127.0.0.1:8091/api/pool-live-widget.php"
  : "/api/pool-live-widget.php";
---

<BaseLayout
  title="Dandelion Panorama Pool | Panoramatický bazén u Balatonu"
  description="Od 15. června 2026 je Panorama Pool k dispozici hostům D1, D2 a Fügeház v Kisapáti v Balatonské vrchovině."
  canonicalPath="/cs/panorama-pool/"
  lang="cs"
  ogLocale="cs_CZ"
  ogImage={panoramaPoolHero.desktop}
  ogImageAlt={heroImage.altCs}
  structuredData={poolVideoStructuredData}
>
  <section class="pool-page" data-page="panorama-pool" data-deploy-retry="english-html-alias">
    <Hero
      kicker="Panorama Pool"
      title="Panorama Pool na svahu Szent György-hegy"
      description="Od 15. června 2026 pro hosty D1, D2 a Fügeház."
      ctas={[{ label: "Zobrazit ubytování", href: "#pool-stays" }]}
      secondaryCtas={[{ label: "Zobrazit domy", href: "#pool-stays" }]}
      videoSrc=""
      videoDesktopSrc={poolHeroVideos.desktop}
      videoMobileSrc={poolHeroVideos.mobile}
      posterDesktopSrc={panoramaPoolHero.desktop}
      posterMobileSrc={panoramaPoolHero.mobile}
      posterAlt={heroImage.altCs}
    >
      <aside
        slot="aside"
        class="pool-temperature pool-temperature--hero"
        data-pool-temperature
        data-endpoint="/api/pool-temperature.json"
        aria-live="polite"
      >
        <span class="pool-temperature__label">Voda v bazénu</span>
        <p class="pool-temperature__value" data-pool-temperature-value>{poolTemperatureFallback}</p>
        <p class="pool-temperature__air" data-pool-air-temperature hidden></p>
        <p class="pool-temperature__updated" data-pool-temperature-updated hidden></p>
      </aside>
    </Hero>

    <section class="pool-section pool-section--live">
      <div class="dnd-container pool-shell">
        <div class="pool-live-panel" aria-live="polite">
          <div class="pool-section-heading pool-live-panel__heading">
            <span class="pool-eyebrow">Panorama Pool</span>
            <h2>Aktuální měření.</h2>
          </div>

          <iframe
            class="pool-live-frame"
            src={poolLiveWidgetSrc}
            title="Panorama Pool aktuální měření"
            loading="lazy"
            scrolling="no"
          ></iframe>
        </div>
      </div>
    </section>

    <section class="pool-section pool-section--intro pool-section--info">
      <div class="dnd-container pool-shell pool-info-layout">
        <div class="pool-intro">
          <span class="pool-eyebrow">Letní zážitek</span>
          <h2>Bazén pro hosty D1, D2 a Fügeház.</h2>
          <p>
            Panorama Pool je v letní sezoně k dispozici hostům D1, D2 a Fügeház. Bazén se nachází na kopci vedle domů, s výhledem na svědecké hory - přes den k osvěžení, večer ke klidnému zakončení dne.
          </p>
          <a class="pool-text-link pool-intro__cta" href={poolLandingHref}>Zobrazit domy s bazénem</a>
        </div>
        <aside class="pool-geo-faq" aria-labelledby="pool-geo-faq-title">
          <span class="pool-eyebrow">Časté otázky</span>
          <h2 id="pool-geo-faq-title">Co je dobré vědět o Panorama Pool.</h2>
          <div class="pool-geo-faq__list">
            {poolGeoFaqItems.map((item) => (
              <article class="pool-geo-faq__item">
                <h3>{item.question}</h3>
                <p>{item.answer}</p>
              </article>
            ))}
          </div>
        </aside>
      </div>
    </section>

    <section id="pool-stays" class="pool-section pool-section--stays">
      <div class="dnd-container pool-shell pool-section-shell">
        <div class="pool-stays">
          {stays.map((stay) => (
            <a href={stay.href} class="pool-stay-card">
              <figure class="pool-stay-card__media">
                <picture>
                  {stay.image.mobileSrc && <source media="(max-width: 767px)" srcset={stay.image.mobileSrc} />}
                  <img
                    src={stay.image.desktopSrc}
                    alt={stay.image.altEn}
                    title={stay.image.titleEn}
                    width="1600"
                    height="1200"
                    loading="lazy"
                    decoding="async"
                  />
                </picture>
              </figure>
              <div class="pool-stay-card__body">
                <h3>{stay.title}</h3>
                <p>{stay.description}</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <PoolGalleryLightbox images={galleryImages} locale="cs" ariaLabel="Galerie Panorama Pool" />

    <section class="pool-section pool-section--closing">
      <div class="dnd-container pool-shell">
        <div class="pool-closing">
          <span class="pool-eyebrow">Letní pobyt</span>
          <h2>Rezervujte letní pobyt s přístupem k bazénu.</h2>
          <p>Jako hosté D1, D2 nebo Fügeház můžete mít od 15. června 2026 Panorama Pool jako součást letních dnů.</p>
          <a href="#pool-stays" class="pool-button">Zobrazit ubytování</a>
        </div>
      </div>
    </section>
  </section>

  <script is:inline>
    (() => {
      const applyPoolHeaderState = () => {
        const header = document.querySelector("[data-dnd-header]");
        if (header) {
          header.classList.toggle("is-pool-visible", window.scrollY > 12);
        }
      };

      const refreshIntervalMs = 5 * 60 * 1000;

      const updatePoolTemperature = async () => {
        const widget = document.querySelector("[data-pool-temperature]");
        const valueNode = widget ? widget.querySelector("[data-pool-temperature-value]") : null;
        const airValueNode = widget ? widget.querySelector("[data-pool-air-temperature]") : null;
        const updatedNode = widget ? widget.querySelector("[data-pool-temperature-updated]") : null;
        const endpoint = widget ? widget.getAttribute("data-endpoint") || "/api/pool-temperature.json" : "/api/pool-temperature.json";
        const fallbackText = "Brzy";
        const buildEndpointUrl = () => {
          const url = new URL(endpoint, window.location.href);
          url.searchParams.set("refresh", Date.now().toString());
          return url.toString();
        };
        const formatMeasurement = (value, locale, options = {}) => {
          const numericValue = typeof value === "number" || typeof value === "string" ? Number(value) : Number.NaN;
          if (!Number.isFinite(numericValue)) return "";

          return numericValue.toLocaleString(locale, {
            minimumFractionDigits: 1,
            maximumFractionDigits: 1,
            ...options
          });
        };

        try {
          const response = await fetch(buildEndpointUrl(), {
            headers: { Accept: "application/json" },
            cache: "no-store"
          });

          if (!response.ok) {
            throw new Error("Pool temperature is unavailable.");
          }

          const data = await response.json();
          const rawTemperature = data.temperature;
          const temperature =
            typeof rawTemperature === "number" || typeof rawTemperature === "string" ? Number(rawTemperature) : Number.NaN;

          if (!Number.isFinite(temperature)) {
            throw new Error("Pool temperature is invalid.");
          }

          const unit = typeof data.unit === "string" && data.unit.trim() ? data.unit.trim() : "°C";
          const rawAirTemperature =
            data.airTemperature !== undefined && data.airTemperature !== null
              ? data.airTemperature
              : data.air_temperature !== undefined && data.air_temperature !== null
                ? data.air_temperature
                : data.outdoorTemperature;
          const airTemperature =
            typeof rawAirTemperature === "number" || typeof rawAirTemperature === "string"
              ? Number(rawAirTemperature)
              : Number.NaN;
          const airUnit = typeof data.airUnit === "string" && data.airUnit.trim() ? data.airUnit.trim() : unit;
          const formattedTemperature = formatMeasurement(temperature, "cs-CZ");
          const formattedAirTemperature = formatMeasurement(airTemperature, "cs-CZ");
          const updatedAt = typeof data.updatedAt === "string" ? new Date(data.updatedAt) : null;
          const hasValidUpdatedAt = Boolean(updatedAt && !Number.isNaN(updatedAt.getTime()));

          if (widget) {
            widget.classList.add("has-temperature");
          }
          if (valueNode) {
            valueNode.textContent = `${formattedTemperature} ${unit}`;
          }
          if (Number.isFinite(airTemperature)) {
            if (widget) {
              widget.classList.add("has-air-temperature");
            }
            if (airValueNode) {
              airValueNode.textContent = `Vzduch: ${formattedAirTemperature} ${airUnit}`;
              airValueNode.removeAttribute("hidden");
            }
          } else {
            if (widget) {
              widget.classList.remove("has-air-temperature");
            }
            if (airValueNode) {
              airValueNode.setAttribute("hidden", "");
            }
          }

          if (updatedNode) {
            if (hasValidUpdatedAt) {
              const updatedText = `Aktualizováno: ${updatedAt.toLocaleTimeString("cs-CZ", {
                hour: "2-digit",
                minute: "2-digit"
              })}`;
              updatedNode.textContent = updatedText;
              updatedNode.removeAttribute("hidden");
            } else {
              updatedNode.setAttribute("hidden", "");
            }
          }
        } catch {
          if (widget) {
            widget.classList.remove("has-temperature");
            widget.classList.remove("has-air-temperature");
          }
          if (valueNode) valueNode.textContent = fallbackText;
          if (airValueNode) {
            airValueNode.setAttribute("hidden", "");
          }
          if (updatedNode) {
            updatedNode.setAttribute("hidden", "");
          }
        }
      };

      if (document.readyState === "loading") {
        document.addEventListener(
          "DOMContentLoaded",
          () => {
            applyPoolHeaderState();
            updatePoolTemperature();
            window.setInterval(updatePoolTemperature, refreshIntervalMs);
            window.addEventListener("scroll", applyPoolHeaderState, { passive: true });
          },
          { once: true }
        );
      } else {
        applyPoolHeaderState();
        updatePoolTemperature();
        window.setInterval(updatePoolTemperature, refreshIntervalMs);
        window.addEventListener("scroll", applyPoolHeaderState, { passive: true });
      }
    })();
  </script>
</BaseLayout>

<style>
  :global(.dnd-header.is-pool-visible) {
    background: rgba(239, 228, 211, 0.94);
    border-bottom: 1px solid rgba(111, 87, 59, 0.1);
    box-shadow: 0 14px 34px rgba(79, 52, 29, 0.08);
    color: #2d241c;
    backdrop-filter: blur(12px);
  }

  :global(.dnd-header.is-pool-visible .dnd-logo img) {
    filter: none;
  }

  :global(.dnd-header.is-pool-visible .dnd-header__contact a) {
    border-color: rgba(94, 65, 39, 0.18);
    background: rgba(255, 252, 246, 0.22);
  }

  :global(.dnd-header.is-pool-visible .dnd-header__contact a:hover),
  :global(.dnd-header.is-pool-visible .dnd-header__contact a:focus-visible) {
    border-color: rgba(94, 65, 39, 0.36);
    background: rgba(255, 252, 246, 0.56);
  }

  :global(.dnd-header.is-pool-visible .dnd-nav) {
    border-top-color: rgba(94, 65, 39, 0.12);
  }

  :global(.dnd-header.is-pool-visible .dnd-header-cta) {
    border-color: rgba(94, 65, 39, 0.16);
    background: rgba(255, 252, 246, 0.46);
  }

  .pool-page {
    overflow-x: clip;
    background: #fdfbf7;
    color: #2e241b;
  }

  .pool-page :global(.dnd-hero) {
    min-height: 680px;
    height: 92vh;
  }

  .pool-page :global(.dnd-hero__inner) {
    display: grid;
    grid-template-columns: minmax(280px, 0.82fr) minmax(220px, 0.42fr);
    gap: clamp(28px, 6vw, 92px);
    align-items: end;
    justify-content: space-between;
    padding: 190px clamp(36px, 7vw, 104px) clamp(74px, 12vh, 128px);
  }

  .pool-page :global(.dnd-hero__text) {
    align-items: flex-start;
    width: min(100%, 620px);
    text-align: left;
    text-shadow: 0 2px 18px rgba(22, 17, 12, 0.28);
  }

  .pool-page :global(.dnd-hero__title) {
    max-width: 14ch;
    font-size: clamp(1.7rem, 2.35vw, 2.6rem);
    line-height: 1.16;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-weight: 400;
    text-wrap: balance;
    white-space: normal;
  }

  .pool-page :global(.dnd-hero__desc) {
    max-width: 36ch;
    margin-left: 0;
    text-align: left;
  }

  .pool-page :global(.dnd-hero__cta) {
    justify-content: flex-start;
  }

  .pool-page :global(.dnd-hero__aside) {
    display: flex;
    justify-content: flex-end;
    width: auto;
  }

  .pool-shell {
    max-width: 1120px;
  }

  .pool-section {
    padding: 72px 0;
  }

  .pool-section--intro {
    padding-top: 64px;
    padding-bottom: 48px;
  }

  .pool-section--info {
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.9), rgba(248, 245, 239, 0.72)),
      #fbf8f2;
  }

  .pool-section--closing {
    padding-top: 24px;
    padding-bottom: 88px;
  }

  .pool-section-shell {
    display: grid;
    gap: 24px;
  }

  .pool-eyebrow {
    display: inline-block;
    margin-bottom: 10px;
    color: #9c7a34;
    font-size: var(--dnd-text-2xs);
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .pool-intro {
    max-width: 790px;
  }

  .pool-info-layout {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(360px, 0.72fr);
    gap: 34px;
    align-items: start;
  }

  .pool-info-layout .pool-intro {
    align-self: start;
    max-width: none;
    padding: 26px 0 0;
  }

  .pool-intro h2,
  .pool-section-heading h2,
  .pool-closing h2 {
    margin: 0;
    color: #2a2017;
    font-family: var(--dnd-font-display);
    font-size: clamp(1.45rem, 2vw, 2.25rem);
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-wrap: balance;
  }

  .pool-intro p,
  .pool-section-heading p,
  .pool-stay-card p,
  .pool-closing p {
    margin: 0;
    color: rgba(46, 36, 27, 0.76);
    font-size: var(--dnd-text-body);
    line-height: 1.72;
  }

  .pool-intro p {
    max-width: 64ch;
    margin-top: 16px;
  }

  .pool-text-link.pool-intro__cta {
    justify-content: center;
    min-height: 44px;
    padding: 12px 18px;
    border: 1px solid rgba(139, 99, 24, 0.28);
    border-radius: 999px;
    background: #8b6318;
    color: #fffaf0;
    box-shadow: 0 12px 24px rgba(68, 44, 12, 0.16);
    text-decoration: none;
  }

  .pool-text-link.pool-intro__cta::after {
    color: currentColor;
  }

  .pool-section-heading {
    max-width: 720px;
  }

  .pool-section-heading p {
    margin-top: 12px;
  }

  .pool-text-link {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    margin-top: 16px;
    color: #8b6318;
    font-size: var(--dnd-text-xs);
    font-weight: 750;
    letter-spacing: 0.05em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .pool-text-link::after {
    content: "→";
    margin-left: 8px;
    font-size: var(--dnd-text-body);
    line-height: 1;
  }

  .pool-temperature {
    display: grid;
    gap: 8px;
    place-items: center;
    width: clamp(188px, 18vw, 270px);
    aspect-ratio: 1;
    padding: 26px;
    border: 1px solid rgba(126, 88, 34, 0.24);
    border-radius: 50%;
    background:
      radial-gradient(circle at 32% 24%, rgba(255, 255, 255, 0.98), rgba(250, 244, 234, 0.86) 48%, rgba(221, 194, 140, 0.78)),
      #f8efe0;
    box-shadow:
      0 22px 58px rgba(45, 30, 15, 0.18),
      inset 0 0 0 10px rgba(255, 255, 255, 0.26),
      inset 0 0 0 1px rgba(122, 86, 38, 0.18);
    text-align: center;
  }

  .pool-temperature__label {
    color: #9c7a34;
    font-size: var(--dnd-text-2xs);
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .pool-temperature__value {
    margin: 0;
    color: #2e241b;
    font-family: var(--dnd-font-display);
    font-size: clamp(1.1rem, 1.7vw, 1.48rem);
    font-weight: 400;
    line-height: 1.08;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    text-wrap: balance;
  }

  .pool-temperature.has-temperature .pool-temperature__value {
    font-size: clamp(2rem, 3.35vw, 3rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.02em;
  }

  .pool-temperature__updated {
    margin: 0;
    color: rgba(46, 36, 27, 0.66);
    font-size: var(--dnd-text-sm);
    line-height: 1.45;
  }

  .pool-temperature__air {
    margin: 0;
    color: rgba(46, 36, 27, 0.74);
    font-size: var(--dnd-text-sm);
    font-weight: 650;
    line-height: 1.3;
  }

  .pool-section--live {
    position: sticky;
    top: 119px;
    z-index: 38;
    margin-top: -1px;
    padding: 14px 0;
    background:
      radial-gradient(circle at 12% 0%, rgba(21, 117, 174, 0.34), transparent 32%),
      linear-gradient(135deg, #061626 0%, #082339 54%, #06121f 100%);
    border-top: 1px solid rgba(116, 194, 255, 0.18);
    border-bottom: 1px solid rgba(116, 194, 255, 0.2);
    box-shadow: 0 18px 40px rgba(4, 17, 30, 0.2);
  }

  .pool-live-panel,
  .pool-geo-faq {
    border: 1px solid rgba(90, 67, 41, 0.12);
    border-radius: 8px;
    background: #fff;
    box-shadow: 0 22px 52px rgba(64, 45, 27, 0.07);
  }

  .pool-live-panel {
    display: grid;
    grid-template-columns: 180px minmax(0, 1fr);
    gap: 14px;
    align-items: center;
    padding: 14px 16px;
    border-color: rgba(102, 181, 244, 0.24);
    background: rgba(4, 18, 32, 0.72);
    box-shadow: inset 0 0 0 1px rgba(137, 202, 255, 0.08), 0 14px 30px rgba(0, 7, 14, 0.22);
    backdrop-filter: blur(14px);
  }

  .pool-live-panel__heading {
    display: flex;
    min-height: 96px;
    max-width: 180px;
    flex-direction: column;
    justify-content: center;
  }

  .pool-live-panel .pool-eyebrow {
    margin-bottom: 8px;
    color: #53b8ff;
    line-height: 1;
  }

  .pool-live-panel__heading h2 {
    color: #f3fbff;
