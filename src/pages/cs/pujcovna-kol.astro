---
import CzechExperiencePage from "../../templates/CzechExperiencePage.astro";
import heroImage from "../../assets/experiences/tanuhegyek-drone-dji-20260512.jpg";
import supportImage from "../../assets/experiences/balaton-shore.jpg";
---

<CzechExperiencePage
  title="Půjčovna kol u Balatonu | Dandelion"
  description="Praktické tipy pro cyklistiku a půjčovnu kol pro hosty Dandelion v okolí Szent György-hegy a Balatonu."
  canonicalPath="/cs/pujcovna-kol/"
  breadcrumbName="Půjčovna kol"
  eyebrow="Aktivní den"
  heading="Kola pro pomalé objevování Balatonské vrchoviny."
  lead={[
    "Okolí domů Dandelion se dobře objevuje pomalu: přes vesnice, vinice, boční cesty a mírnější trasy.",
    "Kolo není jen sportovní program. Je to způsob, jak se dostat k výhledům, malým zastávkám a místům, kam autem člověk často jen projede."
  ]}
  heroImage={heroImage}
  heroAlt="Krajina Balatonské vrchoviny vhodná pro cyklistické výlety"
  supportImage={supportImage}
  supportAlt="Balaton jako cíl pomalého cyklistického dne"
  supportTitle="Vyberte si krátký okruh nebo celý den venku"
  supportText="Pro rodiny dávají smysl kratší trasy, pro aktivnější hosty celodenní plán směrem k Balatonu, Badacsonyi nebo vesnicím v okolí."
  highlights={["klidné boční cesty", "vinice a vesnice", "možnost kratšího i delšího plánu", "vhodné kombinovat s pláží nebo vínem"]}
  primaryLink={{ label: "Vybrat ubytování", href: "/cs/ubytovani/" }}
  secondaryLink={{ label: "Zpět na zážitky", href: "/cs/zazitky/" }}
  sections={[
    {
      title: "Jak plánovat cyklistický den",
      cards: [
        { title: "Kratší rodinný okruh", body: "Zvolte nenáročnou trasu přes vesnice a vinice, s časem na zastávky a návrat před horkem." },
        { title: "Balatonský směr", body: "Delší plán může spojit jízdu, pláž a večerní návrat přes vyhlídku nebo vinařství." },
        { title: "E-bike pro kopce", body: "V kopcovité krajině dává elektrokolo smysl, hlavně pokud chcete víc vidět a méně řešit převýšení." }
      ]
    },
    {
      title: "Dobré vědět",
      cards: [
        { title: "Ověřte dostupnost", body: "Dostupnost kol a konkrétní ceny je potřeba předem ověřit, protože se mohou měnit podle sezóny." },
        { title: "Voda a slunce", body: "V létě plánujte vodu, pokrývku hlavy a přestávky. V poledním horku je lepší zpomalit." },
        { title: "Bezpečný návrat", body: "Po vinařské zastávce je dobré mít plán návratu a nepodcenit večerní viditelnost." }
      ]
    }
  ]}
/>
