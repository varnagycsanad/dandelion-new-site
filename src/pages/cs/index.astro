---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Hero from "../../sections/Hero.astro";
import PanoramaPoolHighlight from "../../sections/PanoramaPoolHighlight.astro";
import HomeReviews from "../../sections/HomeReviews.astro";
import HomeRegionGuide from "../../sections/HomeRegionGuide.astro";
import RegionStories from "../../sections/RegionStories.astro";
import Experiences from "../../sections/Experiences.astro";
import NewsletterSignup from "../../sections/NewsletterSignup.astro";
import GoogleRegionMap from "../../sections/GoogleRegionMap.astro";
import bikingImage from "../../assets/home/experiences/dandelion-home-experience-bike-01-optimized.webp";
import wineTourImage from "../../assets/home/experiences/dandelion-home-experience-wine-gastro-01-optimized.webp";
import balatonImage from "../../assets/home/experiences/dandelion-home-experience-balaton-01.webp";
import mountainsImage from "../../assets/home/experiences/dandelion-home-experience-tanuhegyek-01.webp";
import kisapatiStoryImage from "../../assets/home/region-stories/dandelion-home-tanuhegyek-story-01.webp";
import balatonStoryImage from "../../assets/home/region-stories/dandelion-home-balaton-story-02.webp";
import kaliStoryImage from "../../assets/accommodations/koveskal/gallery/dandelion-koveskal-source-001.webp";
import galleryD2Image from "../../assets/accommodations/d2/gallery/dandelion-d2-source-002.webp";
import galleryFugehazImage from "../../assets/accommodations/fugehaz/gallery/dandelion-fugehaz-source-001.webp";
import galleryRoyalImage from "../../assets/accommodations/royal_homes/gallery/dandelion-royal-homes-source-001.webp";

const csTitle = "Dandelion ubytování | Klidné pobyty u Balatonu";
const csDescription =
  "Klidné penziony a apartmány v Balatonské vrchovině, u Szent György-hegy, Badacsonye, Keszthelye a v oblasti Káli.";
const englishBookingHref = "https://ibe.sabeeapp.com/v3/p/Dandelion-Vendégházak?p=3970b30e1042d58f&lang=En";

const czechRegionStories = [
  {
    kicker: "Kisapáti - Szent György-hegy - Tapolcai pánev",
    title: "Mezi svědeckými horami",
    description: "Vinice, tiché cesty a pomalá rána určují tuto část Balatonské vrchoviny.",
    meta: "Klidná základna poblíž Szent György-hegy.",
    ctaLabel: "Zobrazit ubytování u kopců",
    mobileCtaLabel: "Ubytování u kopců",
    ctaHref: "/cs/ubytovani/#balaton-uplands",
    image: kisapatiStoryImage,
    imageAlt: "Kisapáti a svědecké hory v Balatonské vrchovině"
  },
  {
    kicker: "Keszthely - Badacsonyors - Balaton",
    title: "Blízko jezeru",
    description: "Lehké dny u Balatonu, přístavní města a letní večery s klidným rytmem Dandelion.",
    meta: "Pro hosty, kteří chtějí mít Balaton poblíž.",
    ctaLabel: "Zobrazit ubytování u Balatonu",
    mobileCtaLabel: "Ubytování u Balatonu",
    ctaHref: "/cs/ubytovani/#near-lake-balaton",
    image: balatonStoryImage,
    imageAlt: "Ubytování Dandelion poblíž Balatonu"
  },
  {
    kicker: "Köveskál - oblast Káli",
    title: "Tišší strana oblasti Káli",
    description: "Kamenné zdi, vesnické ulice a jemnější tempo pro klidnější dny.",
    meta: "Dobré pro pomalé dny, vinařské cesty a procházky vesnicí.",
    ctaLabel: "Ubytování v oblasti Káli",
    mobileCtaLabel: "Oblast Káli",
    ctaHref: "/cs/ubytovani/#kali-medence",
    image: kaliStoryImage,
    imageAlt: "Krajina oblasti Káli poblíž Köveskálu"
  }
];

const czechExperiences = [
  {
    title: "KOLA",
    description: "Vesnické cesty, vinice a mírné kopce pro lehké vyjížďky.",
    image: bikingImage,
    imageAlt: "Cyklotrasa v Balatonské vrchovině",
    href: "/cs/pujcovna-kol/"
  },
  {
    title: "VINO A GASTRONOMIE",
    description: "Sklepy, terasy a malé zastávky kolem kopců.",
    image: wineTourImage,
    imageAlt: "Víno a gastronomie v Balatonské vrchovině",
    href: "/cs/vinarstvi/"
  },
  {
    title: "BALATON",
    description: "Pláže, pobřeží a jednoduché letní programy poblíž.",
    image: balatonImage,
    imageAlt: "Badacsony a panorama Balatonu",
    href: "/cs/balaton/"
  },
  {
    title: "SVĚDECKÉ HORY",
    description: "Vyhlídky a trasy kolem Szent György-hegy a Badacsonye.",
    image: mountainsImage,
    imageAlt: "Svědecké hory v Balatonské vrchovině",
    href: "/cs/svedecne-hory/"
  }
];

const galleryItems = [
  {
    image: galleryD2Image,
    alt: "Terasa Dandelion D2 s venkovním posezením",
    label: "Dandelion D2"
  },
  {
    image: galleryFugehazImage,
    alt: "Terasa Fügeház v klidném prostředí",
    label: "Fügeház"
  },
  {
    image: galleryRoyalImage,
    alt: "Apartmán Dandelion Royal Homes poblíž Balatonu",
    label: "Dandelion Royal Homes"
  }
];
---

<BaseLayout
  title={csTitle}
  description={csDescription}
  canonicalPath="/cs/"
  lang="cs"
  ogLocale="cs_CZ"
>
  <Hero
    titleTopLines={["Klidné", "ubytování"]}
    titleBottomLines={["poblíž", "Balatonu"]}
    description="Přírodní penziony a apartmány v Balatonské vrchovině, poblíž Szent György-hegy a Badacsonye."
    ctas={[
      { label: "Zobrazit ubytování", href: "/cs/ubytovani/" },
      { label: "Ověřit dostupnost", href: englishBookingHref, target: "_blank", rel: "noopener noreferrer" }
    ]}
    videoFallbackText="Váš prohlížeč nepodporuje přehrávání videa na pozadí."
  />

  <PanoramaPoolHighlight lang="cs" />
  <HomeReviews lang="cs" />

  <section class="cs-home-intro dnd-section" aria-labelledby="czech-home-intro-title">
    <div class="dnd-container cs-home-intro__inner">
      <span class="dnd-section-kicker">Dandelion ubytování</span>
      <h2 id="czech-home-intro-title">Klidná místa se zahradou, terasou a prostorem nadechnout se.</h2>
      <p>
        Dandelion je pro hosty, kteří chtějí mít Balaton poblíž, ale nechtějí spěch:
        rodinné domy, apartmány s venkovním prostorem a klidný venkovský rytmus kolem
        Balatonské vrchoviny.
      </p>
    </div>
  </section>

  <HomeRegionGuide lang="cs" />

  <RegionStories
    kickerLabel="Ubytování"
    heading="Jedna nálada Dandelion, tři krajiny"
    lead="Vyberte si mezi svědeckými horami, dny u Balatonu a tiššími vesnicemi oblasti Káli."
    stickyBackgroundAlt="Východ slunce nad Szent György-hegy a Tapolcai pánví"
    stories={czechRegionStories}
  />

  <Experiences
    sectionId="experiences"
    title="ZÁŽITKY"
    lead="Kola, víno, Balaton a procházky po kopcích v lehkém rytmu regionu."
    ctaLabel="NAPLANOVAT Z POBYTU"
    ctaHref="/cs/zazitky/"
    mobileCtaLabel="VÍCE"
    experiences={czechExperiences}
  />

  <NewsletterSignup lang="cs" />
  <GoogleRegionMap lang="cs" />

  <section id="gallery" class="cs-home-gallery dnd-section" aria-labelledby="czech-gallery-title">
    <div class="dnd-container">
      <div class="cs-home-gallery__head">
        <span class="dnd-section-kicker">Galerie</span>
        <h2 id="czech-gallery-title">První pohled na atmosféru Dandelion.</h2>
        <p>Terasy, zahrady a klidné interiéry ze světa Dandelion.</p>
      </div>
      <div class="cs-home-gallery__grid">
        {galleryItems.map((item) => (
          <figure class="cs-home-gallery__item">
            <img
              src={item.image.src}
              alt={item.alt}
              width={item.image.width}
              height={item.image.height}
              loading="lazy"
              decoding="async"
            />
            <figcaption>{item.label}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="cs-home-booking dnd-section" aria-labelledby="czech-booking-title">
    <div class="dnd-container cs-home-booking__inner">
      <div>
        <span class="dnd-section-kicker">Přímý kontakt</span>
        <h2 id="czech-booking-title">Zeptejte se přímo a vyberte v klidu.</h2>
        <p>
          Pomůžeme s výběrem vhodného domu, příjezdem, polohou, kapacitou a vším,
          co je před rezervací důležité.
        </p>
      </div>
      <a class="cs-home-booking__cta" href={englishBookingHref} target="_blank" rel="noopener noreferrer">Ověřit dostupnost</a>
    </div>
  </section>
</BaseLayout>

<style>
  .cs-home-intro {
    padding: 64px 0 34px;
    background: #fdfbf7;
  }

  .cs-home-intro__inner {
    max-width: 760px;
    text-align: center;
  }

  .cs-home-intro h2,
  .cs-home-gallery h2,
  .cs-home-booking h2 {
    margin: 10px 0 0;
    font-family: var(--dnd-font-display);
    font-size: clamp(1.65rem, 2.7vw, 2.45rem);
    font-weight: 400;
    line-height: 1.1;
    color: rgba(0, 0, 0, 0.86);
  }

  .cs-home-intro p,
  .cs-home-gallery p,
  .cs-home-booking p {
    margin: 16px auto 0;
    max-width: 64ch;
    color: rgba(0, 0, 0, 0.68);
    line-height: 1.72;
  }

  .cs-home-gallery {
    background: #fdfbf7;
  }

  .cs-home-gallery__head {
    max-width: 720px;
    margin-bottom: 24px;
  }

  .cs-home-gallery__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
  }

  .cs-home-gallery__item {
    position: relative;
    margin: 0;
    overflow: hidden;
    border-radius: 8px;
    background: #eee6da;
  }

  .cs-home-gallery__item img {
    width: 100%;
    height: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .cs-home-gallery__item figcaption {
    position: absolute;
    left: 12px;
    bottom: 12px;
    padding: 8px 10px;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.9);
    color: #261d16;
    font-size: var(--dnd-text-xs);
    font-weight: 700;
  }

  .cs-home-booking {
    background: #f6f0e7;
  }

  .cs-home-booking__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 28px;
    border: 1px solid rgba(88, 63, 38, 0.12);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.72);
  }

  .cs-home-booking__inner p {
    margin-left: 0;
  }

  .cs-home-booking__cta {
    display: inline-flex;
    min-height: 48px;
    align-items: center;
    justify-content: center;
    padding: 0 22px;
    border-radius: 8px;
    background: #d99e2b;
    color: #1f170f;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
  }

  @media (max-width: 820px) {
    .cs-home-gallery__grid {
      grid-template-columns: 1fr;
    }

    .cs-home-booking__inner {
      display: grid;
    }
  }
</style>
