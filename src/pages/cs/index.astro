---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Hero from "../../sections/Hero.astro";
import PanoramaPoolHighlight from "../../sections/PanoramaPoolHighlight.astro";
import AutumnCampaignOffers from "../../sections/AutumnCampaignOffers.astro";
import HomeReviews from "../../sections/HomeReviews.astro";
import HomeRegionGuide from "../../sections/HomeRegionGuide.astro";
import RegionStories from "../../sections/RegionStories.astro";
import Experiences from "../../sections/Experiences.astro";
import NewsletterSignup from "../../sections/NewsletterSignup.astro";
import NewsletterPopup from "../../sections/NewsletterPopup.astro";
import GoogleRegionMap from "../../sections/GoogleRegionMap.astro";
import HomeGeoFaq from "../../sections/HomeGeoFaq.astro";
import bikingImage from "../../assets/home/experiences/dandelion-home-experience-bike-01-mobile-optimized.webp";
import wineTourImage from "../../assets/home/experiences/dandelion-home-experience-wine-gastro-01-optimized.webp";
import balatonImage from "../../assets/home/experiences/dandelion-home-experience-balaton-01.webp";
import mountainsImage from "../../assets/home/experiences/dandelion-home-experience-tanuhegyek-01.webp";
import kisapatiStoryImage from "../../assets/home/region-stories/dandelion-home-tanuhegyek-story-01.webp";
import balatonStoryImage from "../../assets/home/region-stories/dandelion-home-balaton-story-02.webp";
import homeRegionOgImage from "../../assets/home/region-stories/szent-gyorgy-hegy-sunrise-sticky-bg-optimized.webp";
import kaliStoryImage from "../../assets/accommodations/koveskal/gallery/dandelion-koveskal-source-001.webp";
import { buildHomeGeoFaqStructuredData } from "../../data/home-geo-faq";

const csTitle = "Dandelion ubytování | Klidné pobyty u Balatonu";
const csDescription =
  "Ubytování kolem Szent György-hegy, Balatonu a oblasti Káli, s terasami, výhledy, bazénovými dny a přímou rezervací.";
const englishBookingHref = "https://ibe.sabeeapp.com/v3/p/Dandelion-Vendégházak?p=3970b30e1042d58f&lang=En";

const homepageHeroVideo = "/videos/fooldal/hero/dandelion-hajnali-kod-balaton-felvidek-hero-desktop.mp4";
const homepageHeroMobileVideo = "/videos/fooldal/hero/dandelion-hajnali-kod-balaton-felvidek-hero-mobile.mp4";
const homepageHeroPoster = "/images/home/hero/dandelion-hajnali-kod-balaton-felvidek-poster-desktop.webp";
const homepageHeroMobilePoster = "/images/home/hero/dandelion-hajnali-kod-balaton-felvidek-poster-mobile.webp";
const homepageHeroPosterAlt = "Panorama Balatonské vrchoviny se svědeckými horami, Badacsony a Balatonem";
const homepageStructuredData = [buildHomeGeoFaqStructuredData("cs")];

const czechRegionStories = [
  {
    kicker: "Kisapáti - Szent György-hegy - Tapolcai pánev",
    title: "Mezi svědeckými horami",
    description: "Vinice, tiché cesty a pomalá rána určují tuto část Balatonské vrchoviny.",
    meta: "Klidná základna poblíž Szent György-hegy.",
    ctaLabel: "Zobrazit ubytování u kopců",
    mobileCtaLabel: "Ubytování u kopců",
    ctaHref: "/cs/ubytovani/#balaton-uplands",
    image: kisapatiStoryImage,
    imageAlt: "Kisapáti a svědecké hory v Balatonské vrchovině"
  },
  {
    kicker: "Keszthely - Badacsonyörs - Balaton",
    title: "Blízko jezeru",
    description: "Lehké dny u Balatonu, přístavní města a letní večery. Keszthely a Badacsonyörs se hodí, pokud chcete zůstat blízko břehu.",
    meta: "Pro hosty, kteří chtějí mít Balaton poblíž.",
    ctaLabel: "Zobrazit ubytování u Balatonu",
    mobileCtaLabel: "Ubytování u Balatonu",
    ctaHref: "/cs/ubytovani/#near-lake-balaton",
    image: balatonStoryImage,
    imageAlt: "Ubytování Dandelion poblíž Balatonu"
  },
  {
    kicker: "Köveskál - oblast Káli",
    title: "Tišší strana oblasti Káli",
    description: "Kamenné zdi, vesnické ulice a otevřená krajina. Köveskál se hodí, pokud hledáte vesnickou stranu Balatonské vrchoviny.",
    meta: "Dobré pro pomalé dny, vinařské cesty a procházky vesnicí.",
    ctaLabel: "Ubytování v oblasti Káli",
    mobileCtaLabel: "Oblast Káli",
    ctaHref: "/cs/ubytovani/#kali-medence",
    image: kaliStoryImage,
    imageAlt: "Krajina oblasti Káli poblíž Köveskálu"
  }
];

const czechExperiences = [
  {
    title: "KOLA",
    description: "Vesnické cesty, vinice a mírné kopce pro lehké vyjížďky.",
    image: bikingImage,
    imageAlt: "Cyklotrasa v Balatonské vrchovině",
    href: "/cs/pujcovna-kol/"
  },
  {
    title: "VINO A GASTRONOMIE",
    description: "Sklepy, terasy a malé zastávky kolem kopců.",
    image: wineTourImage,
    imageAlt: "Víno a gastronomie v Balatonské vrchovině",
    href: "/cs/vinarstvi/"
  },
  {
    title: "BALATON",
    description: "Pláže, pobřeží a jednoduché letní programy poblíž.",
    image: balatonImage,
    imageAlt: "Badacsony a panorama Balatonu",
    href: "/cs/balaton/"
  },
  {
    title: "SVĚDECKÉ HORY",
    description: "Vyhlídky a trasy kolem Szent György-hegy a Badacsony.",
    image: mountainsImage,
    imageAlt: "Svědecké hory v Balatonské vrchovině",
    href: "/cs/svedecne-hory/"
  }
];

---

<BaseLayout
  title={csTitle}
  description={csDescription}
  canonicalPath="/cs/"
  lang="cs"
  ogLocale="cs_CZ"
  ogImage={homeRegionOgImage.src}
  ogImageAlt="Východ slunce nad Szent György-hegy a Tapolcai pánví"
  structuredData={homepageStructuredData}
>
  <Hero
    variant="homepage-offer"
    titleTopLines={["Podzim u Balatonu"]}
    titleBottomLines={["Sleva 5 % při přímé rezervaci"]}
    description="Kód 26osz5 platí pro pobyty od 1. září do 30. listopadu 2026."
    ctas={[
      { label: "Podzimní nabídka", href: "/cs/nabidky/podzim-ve-dvou/" },
      { label: "Ověřit dostupnost", href: englishBookingHref, target: "_blank", rel: "noopener noreferrer" }
    ]}
    videoDesktopSrc={homepageHeroVideo}
    videoMobileSrc={homepageHeroMobileVideo}
    posterDesktopSrc={homepageHeroPoster}
    posterMobileSrc={homepageHeroMobilePoster}
    posterAlt={homepageHeroPosterAlt}
    videoFallbackText="Váš prohlížeč nepodporuje přehrávání videa na pozadí."
    bookingBenefits={[
      "Nejlepší ceny získáte rezervací přímo na našem webu",
      "Okamžitá platba kartou",
      "Rychlý a přehledný rezervační proces",
      "Přímý kontakt s hostitelem",
      "Flexibilní vyřízení"
    ]}
    bookingBenefitsCopy={{
      ariaLabel: "Výhody přímé rezervace",
      kicker: "Přímá rezervace",
      title: "Přímá rezervace se vyplatí",
      lead: "Výhody přímé rezervace:",
      summary: "Nejlepší ceny a okamžitá platba kartou na našem webu.",
      badge: "Přímá rezervace se vyplatí!"
    }}
  />

  <AutumnCampaignOffers lang="cs" />
  <div class="homepage-feature-pair" data-feature-entry>
    <NewsletterSignup lang="cs" />
    <PanoramaPoolHighlight lang="cs" />
  </div>
  <NewsletterPopup lang="cs" />
  <HomeReviews lang="cs" />

  <HomeRegionGuide lang="cs" />

  <RegionStories
    kickerLabel="Ubytování"
    heading="Tři krajiny, tři způsoby pobytu"
    lead="Vyberte si mezi svědeckými horami, dny u Balatonu a tiššími vesnicemi oblasti Káli."
    stickyBackgroundAlt="Východ slunce nad Szent György-hegy a Tapolcai pánví"
    stories={czechRegionStories}
  />

  <Experiences
    sectionId="experiences"
    title="ZÁŽITKY"
    lead="Kola, víno, Balaton a procházky po kopcích, vše kousek od domů."
    ctaLabel="NAPLANOVAT Z POBYTU"
    ctaHref="/cs/zazitky/"
    mobileCtaLabel="VÍCE"
    experiences={czechExperiences}
  />

  <HomeGeoFaq lang="cs" />
  <GoogleRegionMap lang="cs" />
</BaseLayout>

<script is:inline>
  (() => {
    const pair = document.querySelector("[data-feature-entry]");
    if (!pair) return;
    const reveal = () => pair.classList.add("is-entry-visible");
    if (!("IntersectionObserver" in window)) { reveal(); return; }
    pair.classList.add("is-entry-ready");
    const observer = new IntersectionObserver((entries) => {
      if (!entries.some((entry) => entry.isIntersecting)) return;
      reveal();
      observer.disconnect();
    }, { threshold: 0.22 });
    observer.observe(pair);
  })();
</script>

<style>
  .homepage-feature-pair { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; max-width: 1440px; margin: 0 auto; padding: 0 24px; }
  .homepage-feature-pair > :global(.dnd-newsletter-signup), .homepage-feature-pair > :global(.pool-highlight) { min-width: 0; padding: 28px 0; }
  .homepage-feature-pair > :global(.pool-highlight) { transition-delay: 120ms; }
  .homepage-feature-pair :global(.dnd-container) { width: 100%; max-width: none; padding: 0; }
  .homepage-feature-pair.is-entry-ready > :global(.dnd-newsletter-signup), .homepage-feature-pair.is-entry-ready > :global(.pool-highlight) { opacity: 0; transition: opacity 780ms cubic-bezier(0.22, 1, 0.36, 1), transform 780ms cubic-bezier(0.22, 1, 0.36, 1); will-change: opacity, transform; }
  .homepage-feature-pair.is-entry-ready > :global(.dnd-newsletter-signup) { transform: translateX(-64px) scale(0.97); }
  .homepage-feature-pair.is-entry-ready > :global(.pool-highlight) { transform: translateX(64px) scale(0.97); }
  .homepage-feature-pair.is-entry-ready :global(.dnd-newsletter-signup__image), .homepage-feature-pair.is-entry-ready :global(.pool-highlight__image) { transform: scale(1.04); transition: transform 1120ms cubic-bezier(0.22, 1, 0.36, 1); will-change: transform; }
  .homepage-feature-pair.is-entry-visible > :global(.dnd-newsletter-signup), .homepage-feature-pair.is-entry-visible > :global(.pool-highlight) { opacity: 1; transform: translate3d(0, 0, 0) scale(1); }
  .homepage-feature-pair.is-entry-visible :global(.dnd-newsletter-signup__image), .homepage-feature-pair.is-entry-visible :global(.pool-highlight__image) { transform: scale(1); }
  @media (max-width: 900px) { .homepage-feature-pair { grid-template-columns: 1fr; gap: 0; } .homepage-feature-pair.is-entry-ready > :global(.dnd-newsletter-signup), .homepage-feature-pair.is-entry-ready > :global(.pool-highlight) { transform: translateY(36px) scale(0.98); transition-duration: 640ms; } .homepage-feature-pair.is-entry-ready > :global(.pool-highlight) { transition-delay: 100ms; } }
  @media (prefers-reduced-motion: reduce) { .homepage-feature-pair > :global(.dnd-newsletter-signup), .homepage-feature-pair > :global(.pool-highlight) { opacity: 1; transform: none; transition: none !important; } .homepage-feature-pair :global(.dnd-newsletter-signup__image), .homepage-feature-pair :global(.pool-highlight__image) { transform: none !important; transition: none !important; } }
</style>
