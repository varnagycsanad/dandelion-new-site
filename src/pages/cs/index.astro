---
import BaseLayout from "../../layouts/BaseLayout.astro";

const bookingContactHref = "/cs/kontakt/";
---

<BaseLayout
  title="Dandelion ubytovani | Klidne pobyty u Balatonu"
  description="Klidne penziony a apartmany v Balatonske vrchovine, u Szent Gyorgy-hegy, Badacsonye, Keszthelye a v oblasti Kali."
  canonicalPath="/cs/"
  lang="cs"
  ogLocale="cs_CZ"
>
  <section class="cs-home">
    <div class="dnd-container cs-home__inner">
      <div class="cs-home__copy">
        <span class="cs-home__eyebrow">Dandelion ubytovani</span>
        <h1>Klidna mista pro pomale dny kolem Balatonu.</h1>
        <p>
          Prirodni penziony a apartmany v Balatonske vrchovine, pobliz Szent Gyorgy-hegy,
          Badacsonye, Keszthelye a oblasti Kali.
        </p>
        <div class="cs-home__actions">
          <a class="cs-home__cta cs-home__cta--primary" href="/cs/ubytovani/">Zobrazit ubytovani</a>
          <a class="cs-home__cta" href={bookingContactHref}>Kontaktovat nas</a>
        </div>
      </div>

      <div class="cs-home__panel" aria-label="Strucny prehled Dandelion">
        <span>Primy kontakt</span>
        <strong>Pomuzeme vybrat dum, ktery se hodi k vasemu pobytu.</strong>
        <p>
          Ceska verze je pripravena jako samostatna hostovska cesta: ubytovani, zazitky,
          kontakt, SEO a jazykove prepinani maji vlastni ceske adresy.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .cs-home {
    padding: 132px 0 88px;
    background: linear-gradient(180deg, #f7f2ea 0%, #fcfbf8 100%);
  }

  .cs-home__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(280px, 0.8fr);
    gap: clamp(28px, 5vw, 64px);
    align-items: center;
  }

  .cs-home__copy {
    max-width: 780px;
  }

  .cs-home__eyebrow,
  .cs-home__panel span {
    display: inline-block;
    margin-bottom: 12px;
    color: #b67b20;
    font-size: var(--dnd-text-2xs);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .cs-home h1 {
    margin: 0;
    color: #261d16;
    font-family: var(--dnd-font-display);
    font-size: clamp(2.35rem, 5vw, 4.8rem);
    font-weight: 500;
    line-height: 1.03;
  }

  .cs-home p {
    color: rgba(38, 29, 22, 0.76);
    font-size: var(--dnd-text-body);
    line-height: 1.72;
  }

  .cs-home__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }

  .cs-home__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 46px;
    padding: 0 20px;
    border: 1px solid rgba(38, 29, 22, 0.16);
    border-radius: 999px;
    color: #261d16;
    font-weight: 700;
    text-decoration: none;
  }

  .cs-home__cta--primary {
    border-color: #d99e2b;
    background: #d99e2b;
    color: #1b140f;
  }

  .cs-home__panel {
    padding: 28px;
    border: 1px solid rgba(88, 63, 38, 0.12);
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.92);
    box-shadow: 0 18px 48px rgba(48, 34, 20, 0.06);
  }

  .cs-home__panel strong {
    display: block;
    color: #261d16;
    font-family: var(--dnd-font-display);
    font-size: 1.8rem;
    font-weight: 500;
    line-height: 1.16;
  }

  @media (max-width: 760px) {
    .cs-home {
      padding: 108px 0 64px;
    }

    .cs-home__inner {
      grid-template-columns: 1fr;
    }
  }
</style>
