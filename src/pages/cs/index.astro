---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Hero from "../../sections/Hero.astro";
import RegionStories from "../../sections/RegionStories.astro";
import Experiences from "../../sections/Experiences.astro";
import bikingImage from "../../assets/home/experiences/dandelion-home-experience-bike-01-optimized.webp";
import wineTourImage from "../../assets/home/experiences/dandelion-home-experience-wine-gastro-01-optimized.webp";
import balatonImage from "../../assets/home/experiences/dandelion-home-experience-balaton-01.webp";
import mountainsImage from "../../assets/home/experiences/dandelion-home-experience-tanuhegyek-01.webp";
import kisapatiStoryImage from "../../assets/home/region-stories/dandelion-home-tanuhegyek-story-01.webp";
import balatonStoryImage from "../../assets/home/region-stories/dandelion-home-balaton-story-02.webp";
import kaliStoryImage from "../../assets/accommodations/koveskal/gallery/dandelion-koveskal-source-001.webp";
import galleryD2Image from "../../assets/accommodations/d2/gallery/dandelion-d2-source-002.webp";
import galleryFugehazImage from "../../assets/accommodations/fugehaz/gallery/dandelion-fugehaz-source-001.webp";
import galleryRoyalImage from "../../assets/accommodations/royal_homes/gallery/dandelion-royal-homes-source-001.webp";

const csTitle = "Dandelion ubytovani | Klidne pobyty u Balatonu";
const csDescription =
  "Klidne penziony a apartmany v Balatonske vrchovine, u Szent Gyorgy-hegy, Badacsonye, Keszthelye a v oblasti Kali.";

const czechRegionStories = [
  {
    kicker: "Kisapati - Szent Gyorgy-hegy - Tapolcai panve",
    title: "Mezi svedecnymi horami",
    description: "Vinice, tiche cesty a pomala rana urcuji tuto cast Balatonske vrchoviny.",
    meta: "Klidna zakladna pobliz Szent Gyorgy-hegy.",
    ctaLabel: "Zobrazit ubytovani u kopcu",
    mobileCtaLabel: "Ubytovani u kopcu",
    ctaHref: "/cs/ubytovani/#balaton-uplands",
    image: kisapatiStoryImage,
    imageAlt: "Kisapati a svedecne hory v Balatonske vrchovine"
  },
  {
    kicker: "Keszthely - Badacsonyors - Balaton",
    title: "Blizko jezeru",
    description: "Lehke dny u Balatonu, pristavni mesta a letni vecery s klidnym rytmem Dandelion.",
    meta: "Pro hosty, kteri chteji mit Balaton pobliz.",
    ctaLabel: "Zobrazit ubytovani u Balatonu",
    mobileCtaLabel: "Ubytovani u Balatonu",
    ctaHref: "/cs/ubytovani/#near-lake-balaton",
    image: balatonStoryImage,
    imageAlt: "Ubytovani Dandelion pobliz Balatonu"
  },
  {
    kicker: "Koveskal - oblast Kali",
    title: "Tissi strana oblasti Kali",
    description: "Kamene zdi, vesnicke ulice a jemnejsi tempo pro klidnejsi dny.",
    meta: "Dobre pro pomale dny, vinarske cesty a prochazky vesnici.",
    ctaLabel: "Ubytovani v oblasti Kali",
    mobileCtaLabel: "Oblast Kali",
    ctaHref: "/cs/ubytovani/#kali-medence",
    image: kaliStoryImage,
    imageAlt: "Krajina oblasti Kali pobliz Koveskalu"
  }
];

const czechExperiences = [
  {
    title: "KOLA",
    description: "Vesnicke cesty, vinice a mirne kopce pro lehke vyjizdky.",
    image: bikingImage,
    imageAlt: "Cyklotrasa v Balatonske vrchovine",
    href: "/cs/pujcovna-kol/"
  },
  {
    title: "VINO A GASTRONOMIE",
    description: "Sklepy, terasy a male zastavky kolem kopcu.",
    image: wineTourImage,
    imageAlt: "Vino a gastronomie v Balatonske vrchovine",
    href: "/cs/vinarstvi/"
  },
  {
    title: "BALATON",
    description: "Plaze, pobrezi a jednoduche letni programy pobliz.",
    image: balatonImage,
    imageAlt: "Badacsony a panorama Balatonu",
    href: "/cs/balaton/"
  },
  {
    title: "SVEDECNE HORY",
    description: "Vyhlidky a trasy kolem Szent Gyorgy-hegy a Badacsonye.",
    image: mountainsImage,
    imageAlt: "Svedecne hory v Balatonske vrchovine",
    href: "/cs/svedecne-hory/"
  }
];

const galleryItems = [
  {
    image: galleryD2Image,
    alt: "Terasa Dandelion D2 s venkovnim posezenim",
    label: "Dandelion D2"
  },
  {
    image: galleryFugehazImage,
    alt: "Terasa Fugehaz v klidnem prostredi",
    label: "Fugehaz"
  },
  {
    image: galleryRoyalImage,
    alt: "Apartman Dandelion Royal Homes pobliz Balatonu",
    label: "Dandelion Royal Homes"
  }
];
---

<BaseLayout
  title={csTitle}
  description={csDescription}
  canonicalPath="/cs/"
  lang="cs"
  ogLocale="cs_CZ"
>
  <Hero
    titleTopLines={["Klidne", "ubytovani"]}
    titleBottomLines={["pobliz", "Balatonu"]}
    description="Prirodni penziony a apartmany v Balatonske vrchovine, pobliz Szent Gyorgy-hegy a Badacsonye."
    ctas={[
      { label: "Zobrazit ubytovani", href: "/cs/ubytovani/" },
      { label: "Kontaktovat nas", href: "/cs/kontakt/" }
    ]}
    videoFallbackText="Vas prohlizec nepodporuje prehravani videa na pozadi."
  />

  <section class="cs-home-intro dnd-section" aria-labelledby="czech-home-intro-title">
    <div class="dnd-container cs-home-intro__inner">
      <span class="dnd-section-kicker">Dandelion ubytovani</span>
      <h2 id="czech-home-intro-title">Klidna mista se zahradou, terasou a prostorem nadechnout se.</h2>
      <p>
        Dandelion je pro hosty, kteri chteji mit Balaton pobliz, ale nechteji spech:
        rodinne domy, apartmany s venkovnim prostorem a klidny venkovsky rytmus kolem
        Balatonske vrchoviny.
      </p>
    </div>
  </section>

  <RegionStories
    kickerLabel="Ubytovani"
    heading="Jedna nalada Dandelion, tri krajiny"
    lead="Vyberte si mezi svedecnymi horami, dny u Balatonu a tissimi vesnicemi oblasti Kali."
    stickyBackgroundAlt="Vychod slunce nad Szent Gyorgy-hegy a Tapolcai panvi"
    stories={czechRegionStories}
  />

  <Experiences
    sectionId="experiences"
    title="ZAZITKY"
    lead="Kola, vino, Balaton a prochazky po kopcich v lehkem rytmu regionu."
    ctaLabel="NAPLANOVAT Z POBYTU"
    ctaHref="/cs/zazitky/"
    mobileCtaLabel="VICE"
    experiences={czechExperiences}
  />

  <section id="gallery" class="cs-home-gallery dnd-section" aria-labelledby="czech-gallery-title">
    <div class="dnd-container">
      <div class="cs-home-gallery__head">
        <span class="dnd-section-kicker">Galerie</span>
        <h2 id="czech-gallery-title">Prvni pohled na atmosferu Dandelion.</h2>
        <p>Terasy, zahrady a klidne interiery ze sveta Dandelion.</p>
      </div>
      <div class="cs-home-gallery__grid">
        {galleryItems.map((item) => (
          <figure class="cs-home-gallery__item">
            <img
              src={item.image.src}
              alt={item.alt}
              width={item.image.width}
              height={item.image.height}
              loading="lazy"
              decoding="async"
            />
            <figcaption>{item.label}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="cs-home-booking dnd-section" aria-labelledby="czech-booking-title">
    <div class="dnd-container cs-home-booking__inner">
      <div>
        <span class="dnd-section-kicker">Primy kontakt</span>
        <h2 id="czech-booking-title">Zeptejte se primo a vyberte v klidu.</h2>
        <p>
          Pomuzeme s vyberem vhodneho domu, prijezdem, polohou, kapacitou a vsim,
          co je pred rezervaci dulezite.
        </p>
      </div>
      <a class="cs-home-booking__cta" href="/cs/kontakt/">Kontaktovat nas</a>
    </div>
  </section>
</BaseLayout>

<style>
  .cs-home-intro {
    padding: 64px 0 34px;
    background: #fdfbf7;
  }

  .cs-home-intro__inner {
    max-width: 760px;
    text-align: center;
  }

  .cs-home-intro h2,
  .cs-home-gallery h2,
  .cs-home-booking h2 {
    margin: 10px 0 0;
    font-family: var(--dnd-font-display);
    font-size: clamp(1.65rem, 2.7vw, 2.45rem);
    font-weight: 400;
    line-height: 1.1;
    color: rgba(0, 0, 0, 0.86);
  }

  .cs-home-intro p,
  .cs-home-gallery p,
  .cs-home-booking p {
    margin: 16px auto 0;
    max-width: 64ch;
    color: rgba(0, 0, 0, 0.68);
    line-height: 1.72;
  }

  .cs-home-gallery {
    background: #fdfbf7;
  }

  .cs-home-gallery__head {
    max-width: 720px;
    margin-bottom: 24px;
  }

  .cs-home-gallery__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
  }

  .cs-home-gallery__item {
    position: relative;
    margin: 0;
    overflow: hidden;
    border-radius: 8px;
    background: #eee6da;
  }

  .cs-home-gallery__item img {
    width: 100%;
    height: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .cs-home-gallery__item figcaption {
    position: absolute;
    left: 12px;
    bottom: 12px;
    padding: 8px 10px;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.9);
    color: #261d16;
    font-size: var(--dnd-text-xs);
    font-weight: 700;
  }

  .cs-home-booking {
    background: #f6f0e7;
  }

  .cs-home-booking__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 28px;
    border: 1px solid rgba(88, 63, 38, 0.12);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.72);
  }

  .cs-home-booking__inner p {
    margin-left: 0;
  }

  .cs-home-booking__cta {
    display: inline-flex;
    min-height: 48px;
    align-items: center;
    justify-content: center;
    padding: 0 22px;
    border-radius: 8px;
    background: #d99e2b;
    color: #1f170f;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
  }

  @media (max-width: 820px) {
    .cs-home-gallery__grid {
      grid-template-columns: 1fr;
    }

    .cs-home-booking__inner {
      display: grid;
    }
  }
</style>
