---
import CzechExperiencePage from "../../templates/CzechExperiencePage.astro";
import heroImage from "../../assets/experiences/szent-gyorgy-hegy-szolo.jpg";
import supportImage from "../../assets/experiences/tanuhegyek-drone-dji-20260512.jpg";
---

<CzechExperiencePage
  title="Vinařství a degustace u Badacsonye | Dandelion"
  description="Vinařské terasy, sklepy a pomalé večery kolem Szent György-hegy, Badacsonye a domů Dandelion."
  canonicalPath="/cs/vinarstvi/"
  breadcrumbName="Vinařství"
  eyebrow="Víno a panorama"
  heading="Vinice, terasy a pomalé večery u Badacsonye."
  lead={[
    "Kolem domů Dandelion je víno součástí krajiny. Szent György-hegy, Badacsony a okolní kopce spojují vinice, výhledy a klidné tempo.",
    "Nejlepší zážitek nevznikne ze spěchu. Stačí krátká procházka, jedna dobrá terasa, západ slunce a rozumný návrat."
  ]}
  heroImage={heroImage}
  heroAlt="Vinice na Szent György-hegy v Balatonské vrchovině"
  supportImage={supportImage}
  supportAlt="Svědecké hory a vinařská krajina kolem Badacsonye"
  supportTitle="Začněte výhledem a potom vyberte zastávku"
  supportText="Někdo hledá tichý sklep na kopci, někdo živější badacsonyskou terasu s večeří. Obě varianty do regionu patří."
  highlights={["vinice Szent György-hegy", "Badacsony a balatonské výhledy", "pomalé odpoledne", "vhodné pro páry i přátele"]}
  primaryLink={{ label: "Ubytování", href: "/cs/ubytovani/" }}
  secondaryLink={{ label: "Zážitky", href: "/cs/zazitky/" }}
  sections={[
    {
      title: "Kam za vinem",
      cards: [
        { title: "Szent György-hegy", body: "Klidnější vinařský směr s menšími cestami, vinicemi, výhledy a přírodní atmosférou." },
        { title: "Badacsony", body: "Více restaurací, teras a letního pohybu. Dobré pro večer s jídlem a výhledem na Balaton." },
        { title: "Folly a okolí", body: "Kombinace zahrady, výhledu, vinařství a lehčího programu pro klidnější den." }
      ]
    },
    {
      title: "Před odjezdem",
      cards: [
        { title: "Ověřte otevírací dobu", body: "Degustace, stoly a otevírací doby se mění podle sezóny." },
        { title: "Plánujte dopravu", body: "Po degustaci je potřeba mít odpovědný plán návratu." },
        { title: "Méně zastávek, lepší den", body: "Dvě dobře vybrané zastávky často fungují lépe než dlouhý seznam míst." }
      ]
    }
  ]}
/>
