---
import BaseLayout from "../../layouts/BaseLayout.astro";

const englishBookingHref = "https://ibe.sabeeapp.com/v3/p/Dandelion-Vendégházak?p=3970b30e1042d58f&lang=En";

const contactItems = [
  {
    label: "Telefon",
    value: "+36 20 773 0807",
    href: "tel:+36207730807",
    note: "Nejlepší pro rychlé dotazy k příjezdu, dostupnosti nebo při výběru mezi více domy.",
    cta: "Zavolat"
  },
  {
    label: "E-mail",
    value: "hello@dandelionhouse.hu",
    href: "mailto:hello@dandelionhouse.hu",
    note: "Hodí se, pokud chcete porovnat více domů nebo více možných termínů.",
    cta: "Napsat e-mail"
  },
  {
    label: "WhatsApp",
    value: "Napsat přímo",
    href: "https://wa.me/36207730807",
    note: "Dobrá volba pro krátké a rychlé zprávy, když potřebujete odpověď bez zdržení.",
    cta: "Otevřít WhatsApp"
  }
];

const reasonsToWrite = [
  "chcete se poradit před rezervací a nevíte, který dům je pro vás nejlepší",
  "cestujete se zvířetem a chcete vybrat vhodné ubytování",
  "hledáte ubytování s bazénem nebo s příjemným venkovním zázemím",
  "potřebujete si předem ujasnit příjezd, parkování nebo check-in",
  "rozhodujete se spíš podle atmosféry a regionu než jen podle termínu"
];

const planningSteps = [
  {
    title: "1. Napište, co hledáte",
    text: "Stačí krátce napsat, kolik vás přijede, jestli chcete být blíž Balatonu nebo spíš v klidnější krajině, a jestli je důležitý bazén nebo cestování se zvířetem."
  },
  {
    title: "2. Pomůžeme zúžit výběr",
    text: "Doporučíme, které domy nebo která oblast mohou být pro vás nejvhodnější, abyste nemuseli vše porovnávat sami."
  },
  {
    title: "3. Pak je rezervace jednodušší",
    text: "Když už je správná možnost jasnější, nasměrujeme vás k dalšímu kroku bez zbytečné nejistoty."
  }
];

const messageChecklist = [
  "kolik hostů přijede a na jaký termín",
  "zda hledáte spíš ubytování blízko Balatonu nebo klidnější kopcovitou oblast",
  "zda je důležitý bazén, zahrada, panorama nebo soukromý venkovní prostor",
  "zda cestujete se zvířetem",
  "zda už máte 2-3 favority a potřebujete pomoct s výběrem"
];

const regionGuides = [
  {
    title: "Ubytování blízko Balatonu",
    text: "Dobrá volba, pokud je pro vás důležitá blízkost pláže, vody a snadno plánovatelný pobyt u Balatonu.",
    href: "/cs/royal/",
    cta: "Možnosti u Balatonu"
  },
  {
    title: "Tapolcská pánev a Kisapáti",
    text: "Ideální, pokud hledáte klidnější prostředí, kopce, výhledy, vinařskou atmosféru a pomalejší odpočinek.",
    href: "/cs/kisapati-ubytovani-s-bazenem/",
    cta: "Kisapáti a okolí"
  },
  {
    title: "Oblast Káli-medence",
    text: "Vhodná pro ty, kdo mají rádi osobité vesnice, gastronomii a výraznější regionální atmosféru.",
    href: "/cs/dandelion-koveskal/",
    cta: "Možnost v Káli-medence"
  }
];

const quickFacts = [
  "Tahle stránka nemá být jen kontakt, ale i pomoc s rozhodnutím.",
  "Můžete napsat i před rezervací, i když ještě nemáte úplně jasno.",
  "Témata jako zvíře, bazén, příjezd nebo výběr domu se tu vyplatí řešit předem."
];

const faqs = [
  {
    question: "S jakými otázkami má smysl napsat?",
    answer:
      "Nejčastěji řešíme výběr správného domu, cestování se zvířetem, varianty s bazénem, příjezd, rozdíly mezi oblastmi a nejasnosti před rezervací."
  },
  {
    question: "Pomůžete, když nevíme, který dům vybrat?",
    answer:
      "Ano. Když napíšete, kolik vás přijede a co je pro vás nejdůležitější, pomůžeme zúžit nejlepší možnosti."
  },
  {
    question: "Můžeme se ptát ještě před rezervací?",
    answer:
      "Ano, a často je to nejlepší první krok. Krátká domluva může výrazně usnadnit konečné rozhodnutí."
  },
  {
    question: "Pomůžete i s dotazy ohledně zvířete?",
    answer:
      "Ano. Pokud cestujete se zvířetem, je dobré to předem probrat, aby zvolený dům opravdu dobře vyhovoval."
  },
  {
    question: "Když hledáme ubytování s bazénem, máme psát sem?",
    answer:
      "Ano. Můžeme pomoci lépe porovnat, která varianta je vhodnější, pokud je pro vás bazén, zahrada, soukromí nebo okolí důležité."
  },
  {
    question: "Jaká je nejrychlejší cesta k rezervaci?",
    answer:
      "Pokud už víte, které ubytování chcete, můžete rovnou zkontrolovat dostupnost. Pokud si ještě nejste jistí, napište nebo zavolejte nejdřív nám."
  }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.answer
    }
  }))
};
---

<BaseLayout
  title="Kontakt a rezervace | Dandelion ubytování"
  description="Kontakt a pomoc před rezervací u Dandelion: výběr domu, zvíře, bazén, příjezd, orientace podle regionu a přímé kontaktní možnosti."
  canonicalPath="/cs/kontakt/"
  lang="cs"
  ogLocale="cs_CZ"
  structuredData={faqSchema}
>
  <section class="info-page">
    <div class="dnd-container info-page__inner">
      <div class="info-page__hero">
        <span class="info-page__eyebrow">Kontakt</span>
        <h1>Nejen kontakt, ale i pomoc s výběrem správného ubytování.</h1>
        <p>
          Pokud nehledáte jen telefonní číslo, ale i pomoc s rozhodnutím, který dům a který region je pro vás
          vhodnější, jste tady správně.
        </p>
      </div>

      <div class="info-page__highlights" aria-label="Rychlé shrnutí kontaktní stránky">
        {quickFacts.map((fact) => (
          <div class="info-page__highlight">
            <span></span>
            <p>{fact}</p>
          </div>
        ))}
      </div>

      <div class="info-page__grid">
        {contactItems.map((item) => (
          <a class="info-card" href={item.href} target={item.href.startsWith("https://") ? "_blank" : undefined} rel={item.href.startsWith("https://") ? "noopener noreferrer" : undefined}>
            <span class="info-card__label">{item.label}</span>
            <strong>{item.value}</strong>
            <p>{item.note}</p>
            <span class="info-card__cta">{item.cta}</span>
          </a>
        ))}
      </div>

      <div class="info-page__content-grid">
        <section class="info-page__panel">
          <span class="info-page__section-label">Kdy se vyplatí napsat?</span>
          <h2>S čím vám tady umíme pomoct?</h2>
          <ul class="info-page__list">
            {reasonsToWrite.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </section>

        <section class="info-page__panel info-page__panel--accent">
          <span class="info-page__section-label">Před rezervací</span>
          <h2>Pomůžeme vybrat správné ubytování.</h2>
          <p>
            Pokud ještě není jasné, který dům je pro vás nejlepší, nemusíte procházet všechny možnosti sami.
            Napište pár základních informací a pomůžeme výběr zúžit.
          </p>
          <div class="info-page__steps">
            {planningSteps.map((step) => (
              <div class="info-page__step">
                <h3>{step.title}</h3>
                <p>{step.text}</p>
              </div>
            ))}
          </div>
        </section>
      </div>

      <section class="info-page__panel info-page__panel--soft">
        <span class="info-page__section-label">Pro rychlejší odpověď</span>
        <h2>Co je dobré napsat do zprávy?</h2>
        <p>
          Nemusíte psát dlouhý e-mail. Už pár konkrétních údajů stačí, abychom lépe doporučili vhodný dům nebo oblast.
        </p>
        <div class="info-page__checklist-wrap">
          <ul class="info-page__list">
            {messageChecklist.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
          <div class="info-page__message-example">
            <span class="info-page__message-kicker">Příklad</span>
            <p>
              „2 dospělí a 1 dítě na 3 noci. Hledáme klidnější prostředí, bazén by byl skvělý a ještě nevíme,
              jestli je pro nás lepší Kisapáti nebo ubytování blíž Balatonu.“
            </p>
          </div>
        </div>
      </section>

      <section class="info-page__region-block">
        <div class="info-page__region-head">
          <span class="info-page__section-label">Rozhodování podle oblasti</span>
          <h2>Který region se hodí pro jaký typ pobytu?</h2>
          <p>
            Pokud vaše rozhodnutí víc závisí na okolí než na jednom konkrétním domě, pomůžeme i s tím.
          </p>
        </div>

        <div class="info-page__region-grid">
          {regionGuides.map((region) => (
            <article class="info-page__region-card">
              <h3>{region.title}</h3>
              <p>{region.text}</p>
              <a class="info-page__region-link" href={region.href}>{region.cta}</a>
            </article>
          ))}
        </div>
      </section>

      <section class="info-page__booking">
        <div class="info-page__booking-copy">
          <span class="info-page__section-label">Rychlá cesta k rezervaci</span>
          <h2>Pokud už víte, co hledáte</h2>
          <p>
            Rezervační systém se otevře v angličtině. Pokud už máte vhodné ubytování vybrané, můžete tam rovnou
            zkontrolovat dostupnost. Pokud si ještě nejste jistí, napište nebo zavolejte nejdřív nám.
          </p>
        </div>

        <a
          class="info-page__cta"
          href={englishBookingHref}
          target="_blank"
          rel="noopener noreferrer"
        >
          Ověřit dostupnost
        </a>
      </section>

      <section class="info-page__faq">
        <div class="info-page__faq-head">
          <span class="info-page__section-label">Mini FAQ</span>
          <h2>Krátké odpovědi na časté otázky</h2>
        </div>

        <div class="info-page__faq-list">
          {faqs.map((item) => (
            <details class="info-page__faq-item">
              <summary>{item.question}</summary>
              <p>{item.answer}</p>
            </details>
          ))}
        </div>
      </section>

      <section class="info-page__closing">
        <div>
          <span class="info-page__section-label">Ještě váháte?</span>
          <h2>Napište i tehdy, když ještě nemáte hotové rozhodnutí.</h2>
          <p>
            Přesně k tomu tahle stránka slouží: ne jen ukázat kontakt, ale pomoct posunout se k lepší volbě.
            I když zatím víte jen to, že si chcete dobře odpočinout, můžeme začít od toho.
          </p>
        </div>
        <div class="info-page__closing-actions">
          <a class="info-page__cta info-page__cta--secondary" href="mailto:hello@dandelionhouse.hu">Poslat e-mail</a>
          <a class="info-page__cta" href="https://wa.me/36207730807" target="_blank" rel="noopener noreferrer">Napsat na WhatsApp</a>
        </div>
      </section>
    </div>
  </section>
</BaseLayout>

<style>
  .info-page {
    padding: 132px 0 88px;
    background:
      radial-gradient(circle at top left, rgba(217, 158, 43, 0.12), transparent 24%),
      linear-gradient(180deg, #f7f2ea 0%, #fcfbf8 100%);
  }

  .info-page__inner {
    display: grid;
    gap: 28px;
  }

  .info-page__hero {
    max-width: 860px;
  }

  .info-page__eyebrow,
  .info-page__section-label {
    display: inline-block;
    color: #b67b20;
    font-size: var(--dnd-text-2xs);
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .info-page__eyebrow {
    margin-bottom: 10px;
  }

  .info-page__section-label {
    margin-bottom: 12px;
  }

  .info-page h1,
  .info-page h2,
  .info-page h3 {
    margin: 0;
    color: #261d16;
  }

  .info-page h1 {
    font-family: var(--dnd-font-display);
    font-size: clamp(2.2rem, 4vw, 3.8rem);
    font-weight: 500;
    line-height: 1.05;
  }

  .info-page h2 {
    font-family: var(--dnd-font-display);
    font-size: clamp(1.6rem, 2.6vw, 2.3rem);
    font-weight: 500;
    line-height: 1.14;
  }

  .info-page h3 {
    font-size: 1.05rem;
    line-height: 1.4;
  }

  .info-page p,
  .info-page li {
    color: rgba(38, 29, 22, 0.76);
    font-size: var(--dnd-text-body);
    line-height: 1.72;
  }

  .info-page__hero p,
  .info-page__region-head p,
  .info-page__booking-copy p,
  .info-page__faq-item p,
  .info-page__panel > p,
  .info-page__closing p {
    margin: 14px 0 0;
  }

  .info-page__highlights {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  .info-page__highlight,
  .info-card,
  .info-page__panel,
  .info-page__region-card,
  .info-page__booking,
  .info-page__faq-item,
  .info-page__closing {
    border: 1px solid rgba(88, 63, 38, 0.12);
    border-radius: 22px;
    background: rgba(255, 255, 255, 0.92);
    box-shadow: 0 18px 48px rgba(48, 34, 20, 0.06);
  }

  .info-page__highlight {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 12px;
    padding: 18px 20px;
    align-items: start;
  }

  .info-page__highlight span {
    width: 10px;
    height: 10px;
    margin-top: 9px;
    border-radius: 999px;
    background: #d99e2b;
    box-shadow: 0 0 0 6px rgba(217, 158, 43, 0.14);
  }

  .info-page__highlight p {
    margin: 0;
  }

  .info-page__grid,
  .info-page__content-grid,
  .info-page__region-grid {
    display: grid;
    gap: 18px;
  }

  .info-page__grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .info-card {
    display: grid;
    gap: 10px;
    padding: 24px;
    color: #261d16;
    text-decoration: none;
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }

  .info-card:hover,
  .info-card:focus-visible {
    transform: translateY(-2px);
    box-shadow: 0 22px 54px rgba(48, 34, 20, 0.1);
  }

  .info-card__label {
    color: rgba(38, 29, 22, 0.56);
    font-size: var(--dnd-text-xs);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .info-card strong {
    font-size: var(--dnd-text-lead);
    line-height: 1.45;
  }

  .info-card p {
    margin: 0;
  }

  .info-card__cta {
    margin-top: 6px;
    color: #7f5517;
    font-size: var(--dnd-text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .info-page__content-grid {
    grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
  }

  .info-page__panel,
  .info-page__region-card,
  .info-page__booking {
    padding: 28px;
  }

  .info-page__panel--accent {
    background: linear-gradient(145deg, rgba(255, 249, 240, 0.96), rgba(246, 236, 216, 0.92));
  }

  .info-page__panel--soft {
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.96), rgba(249, 245, 237, 0.96));
  }

  .info-page__list {
    margin: 18px 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 14px;
  }

  .info-page__list li {
    position: relative;
    padding-left: 24px;
  }

  .info-page__list li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 11px;
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: #d99e2b;
  }

  .info-page__steps {
    display: grid;
    gap: 14px;
    margin-top: 22px;
  }

  .info-page__step {
    padding: 18px 18px 16px;
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.74);
    border: 1px solid rgba(88, 63, 38, 0.1);
  }

  .info-page__step p {
    margin: 8px 0 0;
  }

  .info-page__checklist-wrap {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 0.9fr);
    gap: 18px;
    margin-top: 22px;
    align-items: start;
  }

  .info-page__message-example {
    padding: 18px;
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.72);
    border: 1px solid rgba(88, 63, 38, 0.1);
  }

  .info-page__message-kicker {
    display: inline-block;
    margin-bottom: 10px;
    color: #7f5517;
    font-size: var(--dnd-text-xs);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .info-page__message-example p {
    margin: 0;
  }

  .info-page__region-block {
    display: grid;
    gap: 18px;
  }

  .info-page__region-head,
  .info-page__faq-head,
  .info-page__booking-copy {
    max-width: 760px;
  }

  .info-page__region-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .info-page__region-card p {
    margin: 10px 0 0;
  }

  .info-page__region-link {
    display: inline-flex;
    margin-top: 18px;
    color: #7f5517;
    font-size: var(--dnd-text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .info-page__booking {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    background: linear-gradient(135deg, #17120f, #2a2219);
  }

  .info-page__booking h2,
  .info-page__booking p,
  .info-page__booking .info-page__section-label {
    color: #fff;
  }

  .info-page__booking p {
    color: rgba(255, 255, 255, 0.78);
  }

  .info-page__cta {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0 22px;
    border-radius: 999px;
    background: #d99e2b;
    color: #1b140f;
    font-size: var(--dnd-text-md);
    font-weight: 700;
    text-decoration: none;
  }

  .info-page__cta--secondary {
    background: rgba(255, 255, 255, 0.96);
    color: #261d16;
  }

  .info-page__faq {
    display: grid;
    gap: 18px;
  }

  .info-page__faq-list {
    display: grid;
    gap: 14px;
  }

  .info-page__faq-item {
    padding: 0 24px;
  }

  .info-page__faq-item summary {
    padding: 20px 0;
    cursor: pointer;
    list-style: none;
    color: #261d16;
    font-size: 1.05rem;
    font-weight: 700;
    line-height: 1.45;
  }

  .info-page__faq-item summary::-webkit-details-marker {
    display: none;
  }

  .info-page__faq-item p {
    margin: 0 0 20px;
    padding-top: 2px;
  }

  .info-page__closing {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 22px;
    padding: 30px 32px;
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.96), rgba(246, 240, 228, 0.96));
  }

  .info-page__closing-actions {
    display: flex;
    flex: 0 0 auto;
    gap: 12px;
    align-items: center;
  }

  @media (max-width: 1100px) {
    .info-page__highlights,
    .info-page__region-grid,
    .info-page__grid,
    .info-page__content-grid,
    .info-page__checklist-wrap {
      grid-template-columns: 1fr;
    }

    .info-page__booking,
    .info-page__closing {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  @media (max-width: 767px) {
    .info-page {
      padding: 110px 0 64px;
    }

    .info-page__highlight,
    .info-card,
    .info-page__panel,
    .info-page__region-card,
    .info-page__booking,
    .info-page__faq-item,
    .info-page__closing {
      padding-left: 20px;
      padding-right: 20px;
      border-radius: 18px;
    }

    .info-page__panel,
