---
import CzechExperiencePage from "../../templates/CzechExperiencePage.astro";
import heroImage from "../../assets/experiences/tanuhegyek-drone-dji-20260512.jpg";
import supportImage from "../../assets/experiences/balaton-shore.jpg";
---

<CzechExperiencePage
  title="Svědecké hory a vyhlídky | Dandelion"
  description="Lehké turistické nápady kolem Szent György-hegy, Badacsonye, Csobánce a Szigligetu poblíž domů Dandelion."
  canonicalPath="/cs/svedecne-hory/"
  breadcrumbName="Svědecké hory"
  eyebrow="Příroda a výhledy"
  heading="Kopce, vyhlídky a tiché procházky kolem Balatonu."
  lead={[
    "Szent György-hegy, Badacsony, Csobánc, Gulács a Szigliget dávají každému dni jinou náladu.",
    "Nemusí jít o náročnou túru. Často stačí krátká cesta, výhled a čas zůstat chvíli ticho."
  ]}
  heroImage={heroImage}
  heroAlt="Dronový pohled na svědecké hory a Tapolcai-medence"
  supportImage={supportImage}
  supportAlt="Balaton jako kulisa výletu po svědeckých horách"
  supportTitle="Vyberte kopec podle energie dne"
  supportText="Některý den se hodí Szent György-hegy, jindy Szigliget s hradem nebo Badacsony s večerní atmosférou."
  highlights={["Szent György-hegy", "Badacsony a Szigliget", "krátké procházky i delší trasy", "západ slunce a výhledy"]}
  primaryLink={{ label: "Ubytování", href: "/cs/ubytovani/" }}
  secondaryLink={{ label: "Zážitky", href: "/cs/zazitky/" }}
  sections={[
    {
      title: "Který směr zvolit",
      cards: [
        { title: "Szent György-hegy", body: "Nejbližší a velmi přírodní směr s vinicemi, výhledy a klidnějšími cestami." },
        { title: "Badacsony", body: "Silnější balatonská atmosféra, dobrá pro výhled, víno a večerní program." },
        { title: "Szigliget", body: "Hrad, procházka a voda v jednom dni. Dobře funguje i s dětmi." }
      ]
    },
    {
      title: "Pro koho se co hodi",
      cards: [
        { title: "Rodiny", body: "Szigliget nebo kratší trasy kolem Szent György-hegy jsou jednodušší volba." },
        { title: "Pár", body: "Západ slunce na kopci nebo večerní Badacsony dodá dni měkčí atmosféru." },
        { title: "Klid v přírodě", body: "Gulács nebo Csobánc mohou být lepší, pokud chcete méně rušný směr." }
      ]
    }
  ]}
/>
