---
import CzechExperiencePage from "../../templates/CzechExperiencePage.astro";
import heroImage from "../../assets/experiences/balaton-shore.jpg";
import supportImage from "../../assets/experiences/szent-gyorgy-hegy-szolo.jpg";
---

<CzechExperiencePage
  title="Balaton poblíž domů Dandelion | Pláže a letní programy"
  description="Pláže, procházky, Badacsony, Szigliget a lehké vodní programy dostupné z domů Dandelion."
  canonicalPath="/cs/balaton/"
  breadcrumbName="Balaton"
  eyebrow="Dny u vody"
  heading="Balaton jako lehký letní program z klidného domu."
  lead={[
    "Z domu Dandelion se dá spojit dopolední koupání, odpolední víno na kopci a večerní procházka v Badacsony nebo Szigligetu.",
    "Balaton tady není jen pláž. Je to voda, výhledy, jídlo, promenády a pomalé letní přesuny."
  ]}
  heroImage={heroImage}
  heroAlt="Kamenitý břeh Balatonu v letním světle"
  supportImage={supportImage}
  supportAlt="Vinice u Balatonu jako večerní program po dni u vody"
  supportTitle="Ráno voda, večer kopec"
  supportText="Silná stránka regionu je kombinace: plážový den nemusí být oddělený od vína, výhledu nebo krátké procházky."
  highlights={["pláže v dosahu autem", "Badacsony a Szigliget", "kajak, kanoe nebo SUP podle sezóny", "vhodné pro rodiny i páry"]}
  primaryLink={{ label: "Ubytování", href: "/cs/ubytovani/" }}
  secondaryLink={{ label: "Zážitky", href: "/cs/zazitky/" }}
  sections={[
    {
      title: "Plážové směry",
      cards: [
        { title: "Szigliget a Ábrahámhegy", body: "Pohodlné směry pro klidnější rodinný plážový den." },
        { title: "Badacsony", body: "Dobrý směr, pokud chcete vodu spojit s večeří, vínem nebo večerní procházkou." },
        { title: "Badacsonylábdihegy", body: "Praktický výchozí bod pro koupání a lehké vodní programy." }
      ]
    },
    {
      title: "Jak den poskladat",
      cards: [
        { title: "S dětmi", body: "Zvolte pláž s jednodušším přístupem a nechte si čas na přestávky." },
        { title: "Romantický večer", body: "Badacsony nebo Szigliget dobře fungují na večerní procházku a jídlo." },
        { title: "Aktivní voda", body: "Kajak, kanoe nebo SUP plánujte podle aktuální nabídky a počasí." }
      ]
    }
  ]}
/>
