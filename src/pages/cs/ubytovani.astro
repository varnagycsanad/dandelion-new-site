---
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { accommodationSections, accommodations } from "../../data/accommodations";
import { SITE_NAME, toAbsoluteUrl } from "../../data/site-seo";
import { readHomepageImageMapping } from "../../lib/homepage-image-mapping";

type SectionKey = (typeof accommodationSections)[number]["key"];

interface CzechStayCopy {
  name: string;
  location: string;
  description: string;
  hoverText: string;
  facts: string[];
  imageAlt: string;
}

const title = "Ubytování v Balatonské vrchovině | Dandelion";
const description =
  "Vyberte si klidné penziony a apartmány u Szent György-hegy, Badacsonye, Kisapáti, Keszthelye a v Balatonské vrchovině.";
const accommodationsOgImage = "/images/pages/szallasok-hero-bg.webp";
const accommodationsOgImageAlt =
  "Výběr ubytování Dandelion v Balatonské vrchovině";

const imageMapping = await readHomepageImageMapping();
const baseHref = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const contactHref = `${baseHref}cs/kontakt/`;

const resolveStayHref = (href: string) =>
  href.startsWith("/") ? `${baseHref}${href.replace(/^\/+/, "")}` : href;
const resolveCzechStayHref = (slug: string, href: string) =>
  slug === "dandelion-d2"
    ? `${baseHref}cs/dandelion-d2/`
    : slug === "fugehaz"
      ? `${baseHref}cs/dandelion-fugehaz/`
      : slug === "dandelion-d1"
        ? `${baseHref}cs/dandelion-d1/`
        : slug === "zsalya-vendeghaz"
          ? `${baseHref}cs/dandelion-zsalya/`
          : slug === "szololiget-vendeghaz"
            ? `${baseHref}cs/szololiget/`
            : slug === "szepvolgyi-vendeghaz"
              ? `${baseHref}cs/szepvolgyi/`
              : slug === "royal-homes"
                ? `${baseHref}cs/royal/`
                : slug === "vintage-vendeghaz"
                  ? `${baseHref}cs/dandelion-vintage/`
                  : slug === "dandelion-koveskal"
                    ? `${baseHref}cs/dandelion-koveskal/`
                  : resolveStayHref(href);

const sectionCopy: Record<
  SectionKey,
  {
    eyebrow: string;
    title: string;
    subtitle: string;
    audienceText: string;
    anchorId: string;
  }
> = {
  upland: {
    eyebrow: "Szent György-hegy · Tapolcai-medence · Kisapáti · Nemesgulács",
    title: "Kolem svědeckých hor",
    subtitle:
      "Turistické trasy, vinařství a klidné vesnické cesty se tu potkávají v klasické atmosféře Balatonské vrchoviny.",
    audienceText: "Dobré pro výlety, panoramata a přírodní pobyty.",
    anchorId: "balaton-uplands"
  },
  shore: {
    eyebrow: "Keszthely · Badacsonyörs · Balaton",
    title: "Snadné dny u Balatonu",
    subtitle:
      "Blíž k plážím, přístavům a balatonským programům, přitom stále v klidné atmosféře Dandelion.",
    audienceText: "Dobré pro pláže, balatonské programy a snadný přístup.",
    anchorId: "near-lake-balaton"
  },
  kali: {
    eyebrow: "Köveskál · Káli-medence · klidná vesnice",
    title: "Tišší strana oblasti Káli",
    subtitle:
      "Pomalejší vesnický rytmus v jedné z nejatmosféričtějších částí Balatonské vrchoviny.",
    audienceText: "Dobré pro klidnější a zdrženlivější venkovský pobyt.",
    anchorId: "kali-medence"
  }
};

const stayCopy: Record<string, CzechStayCopy> = {
  "dandelion-d2": {
    name: "Dandelion D2",
    location: "Kisapáti / Balatonská vrchovina",
    description:
      "Moderní, rodinné ubytování pro 4-6 hostů s velkou zahradou, terasou a snadným přístupem k Szent György-hegy.",
    hoverText: "Pro 4-6 hostů, se zahradou, terasou a klidnou venkovskou atmosférou.",
    facts: ["4-6 hostů", "2 ložnice + obývací pokoj", "Zahrada", "Klimatizace", "Rodinné"],
    imageAlt: "Dandelion D2 venkovské ubytování u Szent György-hegy"
  },
  fugehaz: {
    name: "Dandelion Fügeház",
    location: "U Szent György-hegy",
    description:
      "Panoramatický penzion pro 4-6 hostů s terasami, výhledy a pohodlným rozvržením pro rodinný pobyt.",
    hoverText: "Pro 4-6 hostů, s terasami, výhledy a klidnou polohou.",
    facts: ["4-6 hostů", "2 podlaží", "Panorama", "Hot tub", "Klimatizace"],
    imageAlt: "Dandelion Fügeház penzion u Szent György-hegy"
  },
  "dandelion-d1": {
    name: "Dandelion D1",
    location: "Kisapáti / Balatonská vrchovina",
    description:
      "Prostorný penzion pro 6-8 hostů se třemi ložnicemi, zahradou a místem pro větší rodiny nebo přátele.",
    hoverText: "Pro 6-8 hostů, se třemi ložnicemi a zahradou.",
    facts: ["6-8 hostů", "3 ložnice + obývací pokoj", "Terasa", "2 koupelny", "Klimatizace"],
    imageAlt: "Dandelion D1 prostorný venkovský penzion v Kisapáti"
  },
  "szololiget-vendeghaz": {
    name: "Dandelion Szőlőliget",
    location: "Kisapáti / Szent György-hegy",
    description:
      "Samostatný dům pro 2-4 hosty s terasou, výhledem a klidnou polohou mezi vinicemi.",
    hoverText: "Pro 2-4 hosty, s velkou terasou a otevřeným výhledem.",
    facts: ["2-4 hosté", "1 ložnice + obývací pokoj", "Panorama", "Klidný svah", "Klimatizace"],
    imageAlt: "Dandelion Szőlőliget ubytování u Szent György-hegy"
  },
  "zsalya-vendeghaz": {
    name: "Dandelion Zsálya",
    location: "Szent György-hegy / Kisapáti",
    description:
      "Samostatný penzion pro 2-4 hosty s krytou terasou, výhledy a pokojnou venkovskou atmosférou.",
    hoverText: "Pro 2-4 hosty, s krytou terasou a panoramatem svědeckých hor.",
    facts: ["2-4 hosté", "2 ložnice", "Krytá terasa", "Panorama", "Klimatizace"],
    imageAlt: "Dandelion Zsálya s krytou terasou u Szent György-hegy"
  },
  "vintage-vendeghaz": {
    name: "Dandelion Vintage",
    location: "Nemesgulács / Balatonská vrchovina",
    description:
      "Útulný penzion v Nemesgulácsi se dvěma ložnicemi, vlastním dvorem a dobrou polohou pro balatonské programy.",
    hoverText: "V Nemesgulácsi, se dvěma ložnicemi a vlastním dvorem.",
    facts: ["Penzion", "2 ložnice", "Vlastní dvůr", "Klimatizace", "Vintage atmosféra"],
    imageAlt: "Dandelion Vintage venkovský penzion v Nemesgulácsi"
  },
  "royal-homes": {
    name: "Dandelion Royal Homes",
    location: "Keszthely / Balaton",
    description:
      "Pohodlný apartmán pro 4-6 hostů s balatonskou atmosférou, velkou terasou a praktickou polohou v Keszthelyi.",
    hoverText: "Pro 4-6 hostů, s velkou terasou a balatonskou polohou.",
    facts: ["4-6 hostů", "2 ložnice + obývací pokoj", "Balaton", "Velká terasa", "Keszthely"],
    imageAlt: "Dandelion Royal Homes apartmán u Balatonu v Keszthelyi"
  },
  "szepvolgyi-vendeghaz": {
    name: "Dandelion Szépvölgyi",
    location: "Badacsonyörs / Szépvölgyi út",
    description:
      "Prostorný dovolenkový dům pro 8 hostů se čtyřmi ložnicemi, výhledem na Balaton a polohou u Badacsonyörs.",
    hoverText: "Pro 8 hostů, se čtyřmi ložnicemi a výhledem na Balaton.",
    facts: ["8 hostů", "4 ložnice", "Balatonské panorama", "2 koupelny", "Velká zahrada"],
    imageAlt: "Dandelion Szépvölgyi prostorný dům v Badacsonyörs"
  },
  "dandelion-koveskal": {
    name: "Dandelion Köveskál",
    location: "Köveskál / Káli-medence",
    description:
      "Klidný penzion v Köveskálu, vhodný pro vesnické procházky, víno a pomalejší dny v oblasti Káli.",
    hoverText: "V Köveskálu, pro klidný a zdrženlivý venkovský pobyt.",
    facts: ["Penzion", "Köveskál", "Káli-medence", "Blízko přírody", "Klidná vesnice"],
    imageAlt: "Dandelion Köveskál klidný venkovský penzion v Káli-medence"
  }
};

const sections = accommodationSections.map((section) => ({
  ...sectionCopy[section.key],
  key: section.key,
  gridClass: section.gridClass,
  stays: accommodations
    .filter((stay) => stay.section === section.key && stayCopy[stay.slug])
    .map((stay) => ({
      ...stay,
      ...stayCopy[stay.slug],
      image: imageMapping[stay.imageSlot],
      href: resolveCzechStayHref(stay.slug, stay.url)
    }))
})).filter((section) => section.stays.length > 0);

const accommodationsStructuredData = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "@id": `${toAbsoluteUrl("/cs/ubytovani/")}#collection`,
  name: title,
  url: toAbsoluteUrl("/cs/ubytovani/"),
  inLanguage: "cs-CZ",
  description,
  isPartOf: {
    "@id": `${toAbsoluteUrl("/cs/")}#website`
  },
  mainEntity: {
    "@type": "ItemList",
    itemListElement: sections.flatMap((section, sectionIndex) =>
      section.stays.map((stay, stayIndex) => ({
        "@type": "ListItem",
        position: sectionIndex * 10 + stayIndex + 1,
        url: toAbsoluteUrl(stay.href),
        name: stay.name
      }))
    )
  },
  about: ["Balatonská vrchovina", "Szent György-hegy", "Balaton", "Káli-medence"],
  provider: {
    "@type": "LodgingBusiness",
    name: SITE_NAME,
    url: toAbsoluteUrl("/")
  }
};
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath="/cs/ubytovani/"
  lang="cs"
  ogLocale="cs_CZ"
  ogImage={accommodationsOgImage}
  ogImageAlt={accommodationsOgImageAlt}
  structuredData={accommodationsStructuredData}
>
  <section class="dnd-accommodations-hero">
    <div class="dnd-accommodations-hero__content">
      <div class="dnd-container dnd-accommodations-hero__inner">
        <div class="dnd-accommodations-hero__text">
          <p class="dnd-accommodations-hero__eyebrow">Ubytování</p>
          <h1 class="dnd-accommodations-hero__title">
            <span>Nejdřív vyberte oblast,</span>
            <span>potom najděte dům.</span>
          </h1>
          <p class="dnd-accommodations-hero__lead">
            Dandelion penziony a apartmány najdete v Balatonské vrchovině, u Szent György-hegy,
            Badacsonye, Kisapáti, Keszthelye a v oblasti Káli.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="dnd-accommodations-picker" aria-labelledby="accommodation-regions-title">
    <div class="dnd-container">
      <div class="dnd-accommodations-picker__intro">
        <p class="dnd-accommodations-picker__eyebrow">Rychlý výběr</p>
        <h2 id="accommodation-regions-title">Která část Balatonské vrchoviny vám sedí?</h2>
        <p>
          Začněte krajinou: svědecké hory a vinařské cesty, snadnější rytmus u Balatonu,
          nebo klidnější vesnický pobyt v oblasti Káli.
        </p>
      </div>

      <div class="dnd-accommodations-picker__grid">
        {sections.map((section) => (
          <a class="dnd-region-picker-card" href={`#${section.anchorId}`}>
            <span class="dnd-region-picker-card__eyebrow">{section.eyebrow}</span>
            <strong class="dnd-region-picker-card__title">{section.title}</strong>
            <span class="dnd-region-picker-card__text">{section.audienceText}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <div id="accommodations-list" class="dnd-apts-anchor">
    <div id="dnd-apts-final" lang="cs">
      <div class="dnd-wrap">
        {sections.map((section) => (
          <section id={section.anchorId} class="dnd-section dnd-region-block">
            <div class="dnd-region-block__header">
              <p class="dnd-eyebrow">{section.eyebrow}</p>
              <h2 class="dnd-h2">{section.title}</h2>
              <p class="dnd-sub">{section.subtitle}</p>
              <p class="dnd-region-block__audience">{section.audienceText}</p>
            </div>

            <div class={`dnd-grid ${section.gridClass}`}>
              {section.stays.map((stay) => {
                const primaryFacts = stay.facts.slice(0, 3);
                const secondaryFacts = stay.facts.slice(3, 6);
                const imageAlt = stay.imageAlt || `${stay.name} ubytování u ${stay.location}`;

                const cardContent = (
                  <>
                    <div class="dnd-media">
                      {stay.image ? (
                        stay.image.astroSrc ? (
                          <Image
                            src={stay.image.astroSrc}
                            alt={imageAlt}
                            loading="lazy"
                          />
                        ) : (
                          <img
                            src={stay.image.sourceUrl}
                            alt={imageAlt}
                            width={stay.image.width || 1600}
                            height={stay.image.height || 1067}
                            loading="lazy"
                          />
                        )
                      ) : (
                        <div class="dnd-media-placeholder" aria-label={`${stay.name} fotografie brzy`}>
                          <span>{stay.name}</span>
                          <small>Fotografie brzy</small>
                        </div>
                      )}
                      <div class="dnd-overlay"></div>
                      <p class="dnd-hover-text">{stay.hoverText}</p>
                    </div>
                    <div class="dnd-info">
                      <div class="dnd-title-row">
                        <h3 class="dnd-title">{stay.name}</h3>
                        <span class="dnd-location">{stay.location}</span>
                      </div>
                      <div class="dnd-card-highlights" aria-label={`${stay.name} hlavní údaje`}>
                        {primaryFacts.map((fact) => (
                          <span class="dnd-chip dnd-chip--accent">{fact}</span>
                        ))}
                      </div>
                      <p class="dnd-description">{stay.description}</p>
                      <div class="dnd-chips" aria-label={`${stay.name} další údaje`}>
                        {secondaryFacts.map((fact) => (
                          <span class="dnd-chip dnd-chip--secondary">{fact}</span>
                        ))}
                      </div>
                      <span class="dnd-card-cta">Zobrazit detail</span>
                    </div>
                  </>
                );

                return (
                  <a class="dnd-card is-link" href={stay.href}>
                    {cardContent}
                  </a>
                );
              })}
            </div>
          </section>
        ))}
      </div>
    </div>
  </div>

  <section class="dnd-accommodations-closing" aria-labelledby="accommodation-closing-title">
    <div class="dnd-container">
      <div class="dnd-accommodations-closing__inner">
        <h2 id="accommodation-closing-title">Nejste si jistí, které ubytování sedí nejlépe?</h2>
        <p>
          Napište nám, kolik hostů přijede a jaký rytmus pobytu hledáte.
          Pomůžeme vám zúžit výběr podle oblasti, velikosti domu a stylu odpočinku.
        </p>
        <div class="dnd-accommodations-closing__actions">
          <a class="dnd-accommodations-closing__cta" href={contactHref}>Poslat dotaz</a>
          <a class="dnd-accommodations-closing__cta dnd-accommodations-closing__cta--secondary" href="/cs/">
            Zpět na úvod
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .dnd-accommodations-hero {
    position: relative;
    box-sizing: border-box;
    min-height: calc(600px + 118px);
    height: calc(84vh + 118px);
    padding-top: 118px;
    overflow: hidden;
    background-image: linear-gradient(180deg, rgba(15, 16, 15, 0.18), rgba(15, 16, 15, 0.32)),
      url("/images/pages/szallasok-hero-bg.webp");
    background-position: center 28%;
    background-size: cover;
  }

  .dnd-accommodations-hero__content {
    position: relative;
    z-index: 1;
    min-height: 100%;
    color: #fff;
  }

  .dnd-accommodations-hero__inner {
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    align-items: center;
    min-height: 100%;
    max-width: none;
    padding: clamp(168px, 24vh, 236px) clamp(48px, 7vw, 96px) 88px;
  }

  .dnd-accommodations-hero__text {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: min(100%, 1040px);
    text-align: center;
  }

  .dnd-accommodations-hero__eyebrow {
    margin: 0 0 12px;
    color: rgba(255, 250, 241, 0.88);
    font-size: var(--dnd-text-xs);
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .dnd-accommodations-hero__title {
    margin: 0;
    color: rgba(255, 255, 255, 0.94);
    font-size: clamp(30px, 2.35vw, 42px);
    line-height: 1.08;
    font-family: var(--dnd-font-display);
    font-weight: 400;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .dnd-accommodations-hero__title span {
    display: inline;
  }

  .dnd-accommodations-hero__lead {
    max-width: 48ch;
    margin: 18px auto 0;
    color: rgba(255, 255, 255, 0.84);
    font-size: var(--dnd-text-lead);
    line-height: 1.55;
  }

  .dnd-accommodations-picker {
    margin-top: 26px;
    position: relative;
    z-index: 2;
  }

  .dnd-accommodations-picker__intro {
    max-width: 700px;
    margin-bottom: 18px;
  }

  .dnd-accommodations-picker__eyebrow {
    margin: 0 0 10px;
    color: #b06200;
    font-size: var(--dnd-text-xs);
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .dnd-accommodations-picker__intro h2 {
    margin: 0;
    color: #1f2937;
    font-family: var(--dnd-font-display);
    font-size: clamp(1.55rem, 2.5vw, 2.2rem);
    font-weight: 400;
    line-height: 1.12;
  }

  .dnd-accommodations-picker__intro p:last-child {
    max-width: 58ch;
    margin: 12px 0 0;
    color: #5d554b;
    line-height: 1.6;
  }

  .dnd-accommodations-picker__grid {
    display: grid;
    gap: 14px;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .dnd-region-picker-card {
    display: grid;
    gap: 8px;
    min-height: 168px;
    padding: 18px;
    border: 1px solid rgba(217, 158, 43, 0.18);
    border-radius: 18px;
    background: rgba(255, 251, 245, 0.96);
    box-shadow: 0 10px 26px rgba(42, 31, 17, 0.06);
    transition: transform 0.22s ease, box-shadow 0.22s ease, border-color 0.22s ease;
  }

  .dnd-region-picker-card:hover,
  .dnd-region-picker-card:focus-visible {
    border-color: rgba(217, 158, 43, 0.4);
    box-shadow: 0 14px 30px rgba(42, 31, 17, 0.09);
    transform: translateY(-2px);
  }

  .dnd-region-picker-card__eyebrow {
    color: #8b6a33;
    font-size: var(--dnd-text-2xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 1.5;
    text-transform: uppercase;
  }

  .dnd-region-picker-card__title {
    color: #1f2937;
    font-size: var(--dnd-text-lead);
    line-height: 1.25;
  }

  .dnd-region-picker-card__text {
    color: #5b5348;
    font-size: var(--dnd-text-body);
    line-height: 1.5;
  }

  .dnd-apts-anchor {
    scroll-margin-top: 116px;
  }

  #dnd-apts-final {
    --accent: #f7941d;
    --text: #1f2937;
    --muted: #6b7280;
    --card: #ffffff;
    --c-gray-bg: #f3f4f6;
    --c-gray-txt: #374151;
    --c-accent-bg: rgba(247, 148, 29, 0.12);
    --c-accent-txt: #b06200;
    --radius: 16px;
    --shadow: 0 8px 24px rgba(23, 18, 12, 0.06);
    --shadow2: 0 14px 34px rgba(23, 18, 12, 0.1);
    --max: 1320px;
    --pad: 16px;
    --gap: 18px;
    --img-h: 300px;
    --title: 20px;
    --chipfs: 11px;
    display: block !important;
    width: 100% !important;
    clear: both !important;
    padding: 32px 0 48px;
    color: var(--text);
    box-sizing: border-box;
    font-family: var(--dnd-font-body);
  }

  #dnd-apts-final * {
    box-sizing: border-box;
  }

  #dnd-apts-final a {
    color: inherit;
    text-decoration: none;
  }

  #dnd-apts-final .dnd-wrap {
    display: block !important;
    width: 100% !important;
    max-width: var(--max);
    margin: 0 auto;
    padding: 0 var(--pad);
  }

  #dnd-apts-final .dnd-section {
    display: block !important;
    width: 100% !important;
    margin: 0 0 34px;
    scroll-margin-top: 120px;
  }

  #dnd-apts-final .dnd-eyebrow {
    margin: 0 0 8px;
    color: var(--accent);
    font-size: var(--dnd-text-2xs);
    font-weight: 650;
    letter-spacing: 0.12em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  #dnd-apts-final .dnd-h2 {
    margin: 0 0 6px;
    font-size: 29px;
    line-height: 1.15;
    font-weight: 700;
    letter-spacing: var(--dnd-tracking-display-tight);
  }

  #dnd-apts-final .dnd-sub {
    max-width: 900px;
    margin: 0 0 8px;
    color: var(--muted);
