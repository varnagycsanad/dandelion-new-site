---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import { accommodationSections, accommodations } from "../data/accommodations";
import { SITE_NAME, toAbsoluteUrl } from "../data/site-seo";
import { readHomepageImageMapping } from "../lib/homepage-image-mapping";

const imageMapping = await readHomepageImageMapping();
const bookingLink = "https://ibe.sabeeapp.com/v3/p/Dandelion-Vendégházak?p=3970b30e1042d58f&lang=Hu";
const baseHref = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const contactHref = `${baseHref}kapcsolat/`;
const poolLandingHref = `${baseHref}kisapati-medences-szallas/`;
const accommodationsHeroVideo = "/videos/szallasok/202507%20V1.mp4?v=20260603-lite";
const accommodationsHeroMobileVideo = "/videos/szallasok/202507%20V1-mobile-lite.mp4?v=20260606-mobile-lite";
const accommodationsOgImage = "/images/pages/szallasok-hero-bg.webp";
const accommodationsOgImageAlt = "Dandelion Vendégházak szállásválasztó oldal a Balaton-felvidéken";
const accommodationsTransitionImage = "/images/pages/dandelion-panorama-pool-szallasvalaszto-desktop.webp?v=20260610-img1527-q64";
const accommodationsTransitionMobileImage = "/images/pages/dandelion-panorama-pool-szallasvalaszto-mobile.webp?v=20260610-img1527-q64";
const accommodationsTransitionImageAlt =
  "Dandelion Panorama Pool kék vízzel, napozóágyakkal és Balaton-felvidéki panorámával";
const accommodationsTransitionImageTitle =
  "Panorama Pool napozóterasszal és tanúhegyi panorámával";

const resolveStayHref = (href: string) =>
  href.startsWith("/") ? `${baseHref}${href.replace(/^\/+/, "")}` : href;

const sectionAnchorMap = {
  upland: "tanuhegyek",
  shore: "balaton-mellett",
  kali: "kali-medence"
} as const;

const sectionAudienceMap = {
  upland: "Hegyekhez, panorámához, családi és baráti pihenéshez.",
  shore: "Vízparthoz, strandhoz, balatoni programokhoz.",
  kali: "Csendhez, falusi környezethez, Káli-medencei kirándulásokhoz."
} as const;

const sections = accommodationSections.map((section) => ({
  ...section,
  anchorId: sectionAnchorMap[section.key],
  audienceText: sectionAudienceMap[section.key],
  stays: accommodations
    .filter((stay) => stay.section === section.key)
    .map((stay) => ({
      ...stay,
      image: imageMapping[stay.imageSlot],
      href: resolveStayHref(stay.url)
    }))
}));

const accommodationFaqItems = [
  {
    question: "Melyik házaknál van medencehasználat?",
    answer:
      "Medencéhez a Dandelion D1, Dandelion D2 és a Fügeház a fő opció. Ezeknél Panorama Pool használat szerepel, hegyoldali pihenés mellé.",
    href: poolLandingHref
  },
  {
    question: "Hol érdemes megszállni Kisapátiban?",
    answer:
      "Kisapátiban a D1, D2, Zsálya és Szőlőliget a fő választás. A D1 nagyobb társaságnak, a D2 családoknak, a Zsálya és Szőlőliget csendesebb pihenéshez jó.",
    href: "#tanuhegyek"
  },
  {
    question: "Melyik Dandelion ház jó családoknak?",
    answer:
      "Családoknak elsőként a D2-t érdemes nézni. Nagyobb családnak a D1 kényelmesebb, kisebb családnak a Zsálya vagy a Szőlőliget lehet nyugodtabb.",
    href: "#tanuhegyek"
  },
  {
    question: "Melyik szállást válasszam, ha közel szeretnék lenni a Balatonhoz?",
    answer:
      "Balaton-közeli pihenéshez a Royal Homes Keszthely és a Szépvölgyi Badacsonyörs a két legerősebb irány. Royal vízpartosabb, Szépvölgyi panorámásabb.",
    href: "#balaton-mellett"
  },
  {
    question: "Melyik Dandelion szállás jó Szent György-hegy környéki pihenéshez?",
    answer:
      "Szent György-hegy környékére a D1, D2, Fügeház, Zsálya és Szőlőliget illik legjobban: hegyoldal, panoráma és kirándulós alap.",
    href: "#tanuhegyek"
  },
  {
    question: "Melyik szállás jó vízparti vagy jakuzzis pihenéshez?",
    answer:
      "Ha vízparti hangulat vagy jakuzzi fontos, a Royal Homes Keszthely a legerősebb választás: modern apartman, nagy terasz, tetőteraszos jakuzzi.",
    href: "#balaton-mellett"
  },
  {
    question: "Melyik vendégház jó nagyobb baráti társaságnak?",
    answer:
      "Nagyobb baráti társaságnak a D1 és a Szépvölgyi a két fő választás. D1 Kisapátiban, Szépvölgyi Badacsonyörsön működik jól.",
    href: "#szallasok-lista"
  },
  {
    question: "Melyik Dandelion szállás csendesebb, elvonulósabb?",
    answer:
      "Csendesebb pihenéshez a Köveskál, a Szőlőliget és a Zsálya jó irány. Köveskál falusiasabb, Szőlőliget és Zsálya hegyoldali.",
    href: "#kali-medence"
  }
];

const accommodationsStructuredData = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "@id": `${toAbsoluteUrl("/szallasok/")}#collection`,
  name: "Szállások a Dandelion Vendégházaknál",
  url: toAbsoluteUrl("/szallasok/"),
  inLanguage: "hu-HU",
  description: "Régiók szerint rendezett szállásválasztó oldal a Dandelion Vendégházak teljes kínálatához.",
  isPartOf: {
    "@id": `${toAbsoluteUrl("/")}#website`
  },
  mainEntity: {
    "@type": "ItemList",
    itemListElement: sections.flatMap((section, sectionIndex) =>
      section.stays.map((stay, stayIndex) => ({
        "@type": "ListItem",
        position: sectionIndex * 10 + stayIndex + 1,
        url: toAbsoluteUrl(stay.url),
        name: stay.name
      }))
    )
  },
  about: [
    "Balaton-felvidék",
    "Tanúhegyek",
    "Balaton mellett",
    "Káli-medence"
  ],
  provider: {
    "@type": "LodgingBusiness",
    name: SITE_NAME,
    url: toAbsoluteUrl("/")
  }
};

const accommodationFaqStructuredData = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "@id": `${toAbsoluteUrl("/szallasok/")}#faq`,
  inLanguage: "hu-HU",
  mainEntity: accommodationFaqItems.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.answer
    }
  }))
};
---

<BaseLayout
  title="Szállások a Balaton-felvidéken | Dandelion Vendégházak"
  description="Válassz régiót és találd meg a hozzád illő vendégházat a Tanúhegyeknél, a Balaton mellett vagy a Káli-medencében a Dandelion Vendégházaknál."
  canonicalPath="/szallasok/"
  ogImage={accommodationsOgImage}
  ogImageAlt={accommodationsOgImageAlt}
  structuredData={[accommodationsStructuredData, accommodationFaqStructuredData]}
>
  <section class="dnd-accommodations-hero">
    <video
      class="dnd-accommodations-hero__video"
      autoplay
      muted
      loop
      playsinline
      webkit-playsinline
      preload="metadata"
      poster={accommodationsOgImage}
      disablepictureinpicture
      disableremoteplayback
      aria-hidden="true"
    >
      <source src={accommodationsHeroMobileVideo} media="(max-width: 640px)" type="video/mp4" />
      <source src={accommodationsHeroVideo} type="video/mp4" />
      A böngésződ nem támogatja a háttérvideó lejátszását.
    </video>
    <div class="dnd-accommodations-hero__content">
      <div class="dnd-container dnd-accommodations-hero__inner">
        <div class="dnd-accommodations-hero__text">
          <p class="dnd-accommodations-hero__eyebrow">Szállások</p>
          <h1 class="dnd-accommodations-hero__title">
            <span>Szállások térség</span>
            <span>és igény szerint</span>
          </h1>
          <p class="dnd-accommodations-hero__lead">
            Kisapáti hegyoldalai, balatoni vízpart vagy Káli-medencei csend: itt egyben látod, melyik Dandelion ház
            mire való.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="dnd-accommodations-picker" aria-labelledby="szallasok-regiok-cim">
    <div class="dnd-container">
      <div class="dnd-accommodations-picker__intro">
        <p class="dnd-accommodations-picker__eyebrow">Térségválasztó</p>
        <h2 id="szallasok-regiok-cim">Merre szeretnétek megszállni?</h2>
        <p>
          Ha még nem konkrét házat kerestek, induljatok a környékből: Szent György-hegy, Balaton-part vagy
          Káli-medence.
        </p>
      </div>

      <div class="dnd-accommodations-picker__grid">
        {sections.map((section, regionIndex) => (
          <a class={`dnd-region-picker-card dnd-region-picker-card--${regionIndex + 1}`} href={`#${section.anchorId}`}>
            <span class="dnd-region-picker-card__top">
              <span class="dnd-region-picker-card__eyebrow">{section.eyebrow}</span>
              <span class="dnd-region-picker-card__icon" aria-hidden="true"></span>
            </span>
            <strong class="dnd-region-picker-card__title">{section.title}</strong>
            <span class="dnd-region-picker-card__text">{section.audienceText}</span>
            <span class="dnd-region-picker-card__cta">Megnézem</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="dnd-accommodations-transition" aria-labelledby="szallasok-hangulat-cim">
    <div class="dnd-container">
      <div class="dnd-accommodations-transition__panel">
        <picture class="dnd-accommodations-transition__media">
          <source srcset={accommodationsTransitionMobileImage} media="(max-width: 640px)" />
          <img
            src={accommodationsTransitionImage}
            alt={accommodationsTransitionImageAlt}
            title={accommodationsTransitionImageTitle}
            loading="lazy"
            width="1600"
            height="560"
          />
        </picture>
        <div class="dnd-accommodations-transition__content">
          <p class="dnd-accommodations-transition__eyebrow">Panorama Pool</p>
          <h2 id="szallasok-hangulat-cim">Medencés pihenés a Szent György-hegy lábánál</h2>
          <a class="dnd-accommodations-transition__link" href={poolLandingHref}>
            D1, D2 és Fügeház medencehasználattal
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="dnd-accommodations-qa" aria-labelledby="szallasok-qa-cim">
    <div class="dnd-container">
      <div class="dnd-accommodations-qa__layout">
        <div class="dnd-accommodations-qa__intro">
          <p class="dnd-accommodations-qa__eyebrow">Gyors választó</p>
          <h2 id="szallasok-qa-cim">Melyik Dandelion szállás illik hozzátok?</h2>
          <p>
            Ha nem konkrét háznevet kerestek, induljatok a leggyakoribb vendégkérdésekből: hányan jöttök,
            melyik környék fontos, és inkább panoráma, Balaton-közelség vagy csendesebb elvonulás kell.
          </p>
          <a class="dnd-accommodations-qa__summary-link" href="#szallasok-lista">
            Ugrás a szálláslistára
          </a>
        </div>

        <div class="dnd-accommodations-qa__grid">
          {accommodationFaqItems.map((item) => (
            <article class="dnd-accommodations-qa__item">
              <h3>{item.question}</h3>
              <p>{item.answer}</p>
              <a href={item.href}>Kapcsolódó szállások</a>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <div id="szallasok-lista" class="dnd-apts-anchor">
    <div id="dnd-apts-final" lang="hu">
      <div class="dnd-wrap">
        {sections.map((section) => (
          <section id={section.anchorId} class="dnd-section dnd-region-block">
            <div class="dnd-region-block__header">
              <p class="dnd-eyebrow">{section.eyebrow}</p>
              <h2 class="dnd-h2">{section.title}</h2>
              <p class="dnd-sub">{section.subtitle}</p>
              <p class="dnd-region-block__audience">{section.audienceText}</p>
            </div>

            <div class={`dnd-grid ${section.gridClass}`}>
              {section.stays.map((stay) => {
                const primaryChips = stay.chips.slice(0, 3);
                const secondaryChips = stay.chips.slice(3, 6);
                const cardContent = (
                  <>
                    <div class="dnd-media">
                      {stay.image ? (
                        stay.image.astroSrc ? (
                          <Image
                            src={stay.image.astroSrc}
                            alt={stay.image.altText || stay.name}
                            loading="lazy"
                          />
                        ) : (
                          <img
                            src={stay.image.sourceUrl}
                            alt={stay.image.altText || stay.name}
                            width={stay.image.width || 1600}
                            height={stay.image.height || 1067}
                            loading="lazy"
                          />
                        )
                      ) : (
                        <div class="dnd-media-placeholder" aria-label={`${stay.name} kép hamarosan`}>
                          <span>{stay.name}</span>
                          <small>Kép hamarosan</small>
                        </div>
                      )}
                      {stay.badge && <div class="dnd-badge">{stay.badge}</div>}
                      <div class="dnd-overlay"></div>
                      <p class="dnd-hover-text">{stay.hoverText}</p>
                    </div>
                    <div class="dnd-info">
                      <div class="dnd-title-row">
                        <h3 class="dnd-title">{stay.name}</h3>
                        <span class="dnd-location">{stay.location}</span>
                      </div>
                      <div class="dnd-card-highlights" aria-label={`${stay.name} fő jellemzői`}>
                        {primaryChips.map((chip) => (
                          <span
                            class={`dnd-chip${chip.type && chip.type !== "default" ? ` dnd-chip--${chip.type}` : ""}`}
                          >
                            {chip.label}
                          </span>
                        ))}
                      </div>
                      <p class="dnd-description">{stay.description}</p>
                      <div class="dnd-chips" aria-label={`${stay.name} további jellemzői`}>
                        {secondaryChips.map((chip) => (
                          <span
                            class={`dnd-chip${chip.type && chip.type !== "default" ? ` dnd-chip--${chip.type}` : ""} dnd-chip--secondary`}
                          >
                            {chip.label}
                          </span>
                        ))}
                      </div>
                      <span class="dnd-card-cta">Részletek megtekintése</span>
                    </div>
                  </>
                );

                return stay.url ? (
                  <a class="dnd-card is-link" href={stay.href}>
                    {cardContent}
                  </a>
                ) : (
                  <div class="dnd-card is-disabled">
                    {cardContent}
                  </div>
                );
              })}
            </div>
          </section>
        ))}
      </div>
    </div>
  </div>

  <section class="dnd-accommodations-closing" aria-labelledby="szallasok-zaro-cim">
    <div class="dnd-container">
      <div class="dnd-accommodations-closing__inner">
        <h2 id="szallasok-zaro-cim">Nem biztos, melyik ház illik hozzátok?</h2>
        <p>
          Írd meg, hányan jöttök, mikor utaznátok, és melyik környék vagy felszereltség fontos nektek. Segítünk
          leszűkíteni a választást.
        </p>
        <div class="dnd-accommodations-closing__actions">
          <button class="dnd-accommodations-closing__cta" type="button" onclick="OpenBE()">
            Szabad időpontok megtekintése
          </button>
          <a class="dnd-accommodations-closing__cta dnd-accommodations-closing__cta--secondary" href={contactHref}>
            Segítséget kérek a választáshoz
          </a>
        </div>
        <p class="dnd-accommodations-closing__note">
          A kapcsolat oldalon üzenetben is tudsz kérdezni, ha gyors egyeztetésre van szükséged.
        </p>
      </div>
    </div>
  </section>

  <script define:vars={{ bookingLink }}>
    if (typeof window.OpenBE !== "function") {
      window.OpenBE = () => {
        window.open(bookingLink, "_blank", "noopener,noreferrer");
      };
    }
  </script>
</BaseLayout>

<style>
  .dnd-accommodations-hero {
    position: relative;
    box-sizing: border-box;
    min-height: calc(600px + 118px);
    height: calc(84vh + 118px);
    padding-top: 118px;
    overflow: hidden;
    background: #171717;
  }

  .dnd-accommodations-hero::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background: linear-gradient(180deg, rgba(15, 16, 15, 0.18), rgba(15, 16, 15, 0.32));
  }

  .dnd-accommodations-hero__video {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 50%;
  }

  .dnd-accommodations-hero__content {
    position: relative;
    z-index: 1;
    min-height: 100%;
    color: #fff;
  }

  .dnd-accommodations-hero__inner {
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    align-items: center;
    min-height: 100%;
    max-width: none;
    padding: clamp(168px, 24vh, 236px) clamp(48px, 7vw, 96px) 88px;
  }

  .dnd-accommodations-hero__text {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: min(100%, 1040px);
    text-align: center;
  }

  .dnd-accommodations-hero__eyebrow {
    margin: 0 0 12px;
    color: rgba(255, 250, 241, 0.88);
    font-size: var(--dnd-text-xs);
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .dnd-accommodations-hero__title {
    margin: 0;
    color: rgba(255, 255, 255, 0.94);
    font-size: clamp(30px, 2.35vw, 42px);
    line-height: 1.08;
    font-family: var(--dnd-font-display);
    font-weight: 400;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .dnd-accommodations-hero__title span {
    display: inline;
  }

  .dnd-accommodations-hero__lead {
    max-width: 40ch;
    margin: 18px auto 0;
    color: rgba(255, 255, 255, 0.84);
    font-size: var(--dnd-text-lead);
    line-height: 1.55;
  }

  .dnd-accommodations-picker {
    margin-top: 26px;
    position: relative;
    z-index: 2;
  }

  .dnd-accommodations-picker__intro {
    max-width: 700px;
    margin: 0 auto 18px;
    text-align: center;
  }

  .dnd-accommodations-picker__eyebrow {
    margin: 0 0 10px;
    color: #b06200;
    font-size: var(--dnd-text-xs);
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .dnd-accommodations-picker__intro h2 {
    margin: 0;
    color: #1f2937;
    font-family: var(--dnd-font-display);
    font-size: clamp(1.55rem, 2.5vw, 2.2rem);
    font-weight: 400;
    line-height: 1.12;
  }

  .dnd-accommodations-picker__intro p:last-child {
    max-width: 58ch;
    margin: 12px auto 0;
    color: #5d554b;
    line-height: 1.6;
  }

  .dnd-accommodations-picker__grid {
    display: grid;
    gap: 14px;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .dnd-region-picker-card {
    position: relative;
    isolation: isolate;
    display: grid;
    overflow: hidden;
    gap: 10px;
    min-height: 184px;
    align-content: start;
    padding: 20px;
    border: 1px solid rgba(217, 158, 43, 0.18);
    border-radius: 18px;
    background: linear-gradient(180deg, rgba(255, 253, 249, 0.98), rgba(255, 248, 237, 0.94));
    box-shadow: 0 12px 30px rgba(42, 31, 17, 0.07);
    --region-accent: #b06200;
    --region-accent-soft: rgba(176, 98, 0, 0.12);
    transition: transform 0.22s ease, box-shadow 0.22s ease, border-color 0.22s ease, background 0.22s ease;
  }

  .dnd-region-picker-card::before {
    content: "";
    position: absolute;
    z-index: -1;
    inset: 0 0 auto;
    height: 4px;
    background: var(--region-accent);
  }

  .dnd-region-picker-card--1 {
    --region-accent: #9a6a20;
    --region-accent-soft: rgba(154, 106, 32, 0.13);
  }

  .dnd-region-picker-card--2 {
    --region-accent: #247a83;
    --region-accent-soft: rgba(36, 122, 131, 0.13);
  }

  .dnd-region-picker-card--3 {
    --region-accent: #637b3f;
    --region-accent-soft: rgba(99, 123, 63, 0.14);
  }

  .dnd-region-picker-card:hover,
  .dnd-region-picker-card:focus-visible {
    border-color: color-mix(in srgb, var(--region-accent) 38%, transparent);
    background: linear-gradient(180deg, rgba(255, 253, 249, 1), var(--region-accent-soft));
    box-shadow: 0 18px 38px rgba(42, 31, 17, 0.11);
    transform: translateY(-2px);
  }

  .dnd-region-picker-card__top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 14px;
  }

  .dnd-region-picker-card__eyebrow {
    color: color-mix(in srgb, var(--region-accent) 78%, #473520);
    font-size: var(--dnd-text-2xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 1.5;
    text-transform: uppercase;
  }

  .dnd-region-picker-card__icon {
    display: grid;
    width: 38px;
    height: 38px;
    flex: 0 0 auto;
    place-items: center;
    border: 1px solid color-mix(in srgb, var(--region-accent) 24%, transparent);
    border-radius: 999px;
    background: var(--region-accent-soft);
    color: var(--region-accent);
    font-family: var(--dnd-font-display);
    font-size: 1.2rem;
    line-height: 1;
  }

  .dnd-region-picker-card--1 .dnd-region-picker-card__icon::before {
    content: "△";
