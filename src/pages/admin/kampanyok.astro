---
import BaseLayout from "../../layouts/BaseLayout.astro";

const newsletterApiUrl = import.meta.env.PUBLIC_NEWSLETTER_API_URL ?? "";
const pageTitle = "Hírlevél kampányok";
const pageDescription =
  "Saját newsletter kampányok létrehozása, tesztelése és SMTP-n keresztüli kiküldése a Dandelion rendszerben.";
---

<BaseLayout title={pageTitle} description={pageDescription} hideHeader={true} hideFooter={true} noindex={true}>
  <section class="newsletter-campaigns" data-newsletter-campaigns data-api-base={newsletterApiUrl} data-admin-route="/admin/kampanyok">
    <div class="newsletter-campaigns__orb newsletter-campaigns__orb--amber"></div>
    <div class="newsletter-campaigns__orb newsletter-campaigns__orb--green"></div>

    <div class="newsletter-campaigns__shell" hidden>
      <header class="newsletter-campaigns__hero">
        <div class="newsletter-campaigns__hero-copy">
          <p class="newsletter-campaigns__eyebrow">Dandelion newsletter</p>
          <h1>{pageTitle}</h1>
          <p class="newsletter-campaigns__lead">
            Itt készülnek a hírlevelek: tárgy, rövid szöveg, HTML tartalom, tesztküldés és éles SMTP kiküldés.
            Ez az admin a saját service-re épül, így nincs szolgáltató lock-in.
          </p>
        </div>

        <div class="newsletter-campaigns__hero-actions">
          <a class="newsletter-campaigns__button newsletter-campaigns__button--ghost" href="/admin/">Admin home</a>
          <a class="newsletter-campaigns__button newsletter-campaigns__button--ghost" href="/admin/hirlevel/">Lista</a>
          <button class="newsletter-campaigns__button newsletter-campaigns__button--ghost" type="button" data-load-campaigns>
            Frissítés
          </button>
          <button class="newsletter-campaigns__button newsletter-campaigns__button--ghost" type="button" data-new-campaign>
            Új draft
          </button>
          <button class="newsletter-campaigns__button newsletter-campaigns__button--primary" type="button" data-save-campaign>
            Mentés draftként
          </button>
        </div>
      </header>

      <div class="newsletter-campaigns__statusbar">
        <div class="newsletter-campaigns__status" data-status>Betöltés...</div>
        <div class="newsletter-campaigns__hint">API: <span data-api-label>{newsletterApiUrl || "—"}</span></div>
      </div>

      <section class="newsletter-campaigns__stats" aria-label="Kampány statisztikák">
        <article class="newsletter-campaigns__stat">
          <span class="newsletter-campaigns__stat-label">Kampányok</span>
          <strong data-stat-campaigns>0</strong>
        </article>
        <article class="newsletter-campaigns__stat">
          <span class="newsletter-campaigns__stat-label">Piszkozatok</span>
          <strong data-stat-drafts>0</strong>
        </article>
        <article class="newsletter-campaigns__stat">
          <span class="newsletter-campaigns__stat-label">Kiküldve</span>
          <strong data-stat-sent>0</strong>
        </article>
        <article class="newsletter-campaigns__stat">
          <span class="newsletter-campaigns__stat-label">Aktív feliratkozók</span>
          <strong data-stat-recipient-count>0</strong>
        </article>
      </section>

      <section class="newsletter-campaigns__workspace">
        <div class="newsletter-campaigns__editor">
          <div class="newsletter-campaigns__panel-head">
            <div>
              <p class="newsletter-campaigns__panel-kicker">Kampány szerkesztő</p>
              <h2 data-editor-title>Új kampány</h2>
            </div>
            <p class="newsletter-campaigns__panel-note">
              A HTML mezőből készül a végső e-mail. A szöveges változat opcionális, de ajánlott, mert jobb kézbesítést és fallbacket ad.
            </p>
          </div>

          <form class="newsletter-campaigns__form" data-campaign-form>
            <input type="hidden" name="campaignId" value="" data-campaign-id />

            <label class="newsletter-campaigns__field newsletter-campaigns__field--full">
              <span>Tárgy</span>
              <input name="subject" type="text" maxlength="160" required placeholder="Például: Dandelion nyári ajánlatok" data-campaign-subject />
            </label>

            <label class="newsletter-campaigns__field newsletter-campaigns__field--full">
              <span>Text fallback</span>
              <textarea
                name="text"
                rows="6"
                placeholder="Rövid plain text összefoglaló, amit a kliens text e-mailként megkap."
                data-campaign-text
              ></textarea>
            </label>

            <label class="newsletter-campaigns__field newsletter-campaigns__field--full">
              <span>HTML tartalom</span>
              <textarea
                name="html"
                rows="12"
                required
                placeholder="<p>Ide jön a kampány HTML tartalma.</p>"
                data-campaign-html
              ></textarea>
            </label>

            <label class="newsletter-campaigns__field">
              <span>Célcsoport / szegmens</span>
              <input name="audienceLabel" type="text" placeholder="Például: HU / aktív / nyár" data-campaign-audience-label />
            </label>

            <label class="newsletter-campaigns__field">
              <span>Teszt címzett</span>
              <input name="testTo" type="email" placeholder="cvarnagy@gmail.com" data-test-to />
            </label>

            <label class="newsletter-campaigns__field newsletter-campaigns__field--full">
              <span>Szegmens tagok</span>
              <textarea
                name="audience"
                rows="4"
                placeholder="Opcióként soronként e-mail címeket vagy tageket írhatsz be. Most csak metaadatként mentjük."
                data-campaign-audience
              ></textarea>
            </label>

            <div class="newsletter-campaigns__actions">
              <button class="newsletter-campaigns__button newsletter-campaigns__button--ghost" type="button" data-send-test>
                Tesztküldés SMTP-vel
              </button>
              <button class="newsletter-campaigns__button newsletter-campaigns__button--primary" type="submit">
                Draft mentése
              </button>
              <button class="newsletter-campaigns__button newsletter-campaigns__button--strong" type="button" data-send-campaign>
                Éles küldés
              </button>
            </div>
          </form>
        </div>

        <div class="newsletter-campaigns__preview">
          <div class="newsletter-campaigns__panel-head">
            <div>
              <p class="newsletter-campaigns__panel-kicker">Előnézet</p>
              <h2>Live preview</h2>
            </div>
            <p class="newsletter-campaigns__panel-note">
              A preview a szerkesztő tartalmát mutatja meg, így a tényleges küldés előtt ellenőrizhető a törzs.
            </p>
          </div>

          <article class="newsletter-campaigns__preview-card">
            <p class="newsletter-campaigns__preview-kicker">Tárgy</p>
            <h3 data-preview-subject>Új kampány</h3>
            <div class="newsletter-campaigns__preview-body" data-preview-body>
              <p>A kampány szövege itt jelenik meg.</p>
            </div>
          </article>

          <article class="newsletter-campaigns__preview-card newsletter-campaigns__preview-card--alt">
            <p class="newsletter-campaigns__preview-kicker">Tesztküldés</p>
            <p class="newsletter-campaigns__panel-note">
              A teszt levél a megadott címre megy ki, az éles küldés pedig az aktív feliratkozókra.
            </p>
          </article>
        </div>
      </section>

      <section class="newsletter-campaigns__panel">
        <div class="newsletter-campaigns__panel-head">
          <div>
            <p class="newsletter-campaigns__panel-kicker">Kampány lista</p>
            <h2>Mentett draftok és kiküldött levelek</h2>
          </div>
          <p class="newsletter-campaigns__panel-note">
            A lista a service aktuális kampányait mutatja. Egy kattintással be lehet tölteni a szerkesztőbe, illetve lehet küldeni vagy másolni a publikus URL-t.
          </p>
        </div>

        <div class="newsletter-campaigns__table-wrap">
          <table class="newsletter-campaigns__table">
            <thead>
              <tr>
                <th>Tárgy</th>
                <th>Státusz</th>
                <th>Audience</th>
                <th>Létrehozva</th>
                <th>Kiküldve</th>
                <th></th>
              </tr>
            </thead>
            <tbody data-campaign-rows>
              <tr>
                <td colspan="6" class="newsletter-campaigns__empty">A kampánylista betöltése folyamatban...</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  (() => {
    const root = document.querySelector("[data-newsletter-campaigns]");
    if (!(root instanceof HTMLElement)) {
      return;
    }

    const apiBase = root.dataset.apiBase?.trim() || "";
    const statusNode = root.querySelector("[data-status]");
    const apiLabel = root.querySelector("[data-api-label]");
    const campaignRows = root.querySelector("[data-campaign-rows]");
    const form = root.querySelector("[data-campaign-form]");
    const editorTitle = root.querySelector("[data-editor-title]");
    const campaignIdInput = root.querySelector("[data-campaign-id]");
    const subjectInput = root.querySelector("[data-campaign-subject]");
    const textInput = root.querySelector("[data-campaign-text]");
    const htmlInput = root.querySelector("[data-campaign-html]");
    const audienceInput = root.querySelector("[data-campaign-audience]");
    const audienceLabelInput = root.querySelector("[data-campaign-audience-label]");
    const testToInput = root.querySelector("[data-test-to]");
    const previewSubject = root.querySelector("[data-preview-subject]");
    const previewBody = root.querySelector("[data-preview-body]");
    const statCampaigns = root.querySelector("[data-stat-campaigns]");
    const statDrafts = root.querySelector("[data-stat-drafts]");
    const statSent = root.querySelector("[data-stat-sent]");
    const statRecipientCount = root.querySelector("[data-stat-recipient-count]");
    const loadButton = root.querySelector("[data-load-campaigns]");
    const newButton = root.querySelector("[data-new-campaign]");
    const saveButton = root.querySelector("[data-save-campaign]");
    const sendButton = root.querySelector("[data-send-campaign]");
    const testButton = root.querySelector("[data-send-test]");
    const authStorageKey = "dandelion-newsletter-admin-password";

    let campaigns = [];
    let activeSubscribers = 0;
    let adminPassword = sessionStorage.getItem(authStorageKey) ?? "";

    if (!adminPassword) {
      window.location.replace("/admin/");
      return;
    }

    const shell = root.querySelector(".newsletter-campaigns__shell");
    if (shell instanceof HTMLElement) {
      shell.hidden = false;
    }

    const escapeHtml = (value) =>
      String(value ?? "")
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;")
        .replaceAll("'", "&#39;");

    const formatDate = (value) => {
      if (!value) return "—";
      const date = new Date(value);
      if (Number.isNaN(date.getTime())) return String(value);
      return new Intl.DateTimeFormat("hu-HU", {
        dateStyle: "medium",
        timeStyle: "short",
      }).format(date);
    };

    const setStatus = (message, tone = "info") => {
      if (!(statusNode instanceof HTMLElement)) return;
      statusNode.textContent = message;
      statusNode.dataset.tone = tone;
    };

    const adminHeaders = (extra = {}) => {
      const headers = {
        ...extra,
      };

      if (adminPassword) {
        headers["X-Newsletter-Admin-Password"] = adminPassword;
      }

      return headers;
    };

    const adminFetch = (url, options = {}) =>
      fetch(url, {
        ...options,
        headers: adminHeaders(options.headers || {}),
      });

    const syncPreview = () => {
      const subject = subjectInput instanceof HTMLInputElement ? subjectInput.value.trim() : "";
      const html = htmlInput instanceof HTMLTextAreaElement ? htmlInput.value.trim() : "";
      if (previewSubject instanceof HTMLElement) {
        previewSubject.textContent = subject || "Új kampány";
      }
      if (previewBody instanceof HTMLElement) {
        previewBody.innerHTML = html || "<p>A kampány szövege itt jelenik meg.</p>";
      }
    };

    const clearForm = () => {
      if (campaignIdInput instanceof HTMLInputElement) campaignIdInput.value = "";
      if (subjectInput instanceof HTMLInputElement) subjectInput.value = "";
      if (textInput instanceof HTMLTextAreaElement) textInput.value = "";
      if (htmlInput instanceof HTMLTextAreaElement) htmlInput.value = "";
      if (audienceInput instanceof HTMLTextAreaElement) audienceInput.value = "";
      if (audienceLabelInput instanceof HTMLInputElement) audienceLabelInput.value = "";
      if (testToInput instanceof HTMLInputElement) testToInput.value = "";
      if (editorTitle instanceof HTMLElement) editorTitle.textContent = "Új kampány";
      syncPreview();
    };

    const normalizeAudience = () => {
      const raw = audienceInput instanceof HTMLTextAreaElement ? audienceInput.value : "";
      return String(raw)
        .split(/\r?\n/)
        .map((item) => item.trim())
        .filter(Boolean);
    };

    const loadSubscribersCount = async () => {
      if (!apiBase) {
        return;
      }

      try {
        const response = await adminFetch(`${apiBase.replace(/\/$/, "")}/subscribers`, {
          headers: { Accept: "application/json" },
        });
        const result = await response.json();
        if (response.status === 401) {
          return;
        }
        if (!response.ok || !result?.ok) {
          throw new Error(result?.message || "load_failed");
        }
        const active = Array.isArray(result.subscribers)
          ? result.subscribers.filter((subscriber) => subscriber.status === "active").length
          : 0;
        activeSubscribers = active;
        if (statRecipientCount instanceof HTMLElement) {
          statRecipientCount.textContent = String(activeSubscribers);
        }
      } catch (error) {
        console.error("[newsletter-campaigns] subscriber count", error);
      }
    };

    const renderCampaignRows = () => {
      if (!(campaignRows instanceof HTMLElement)) return;

      const total = campaigns.length;
      const drafts = campaigns.filter((campaign) => campaign.status === "draft").length;
      const sent = campaigns.filter((campaign) => campaign.status === "sent").length;

      if (statCampaigns instanceof HTMLElement) statCampaigns.textContent = String(total);
      if (statDrafts instanceof HTMLElement) statDrafts.textContent = String(drafts);
      if (statSent instanceof HTMLElement) statSent.textContent = String(sent);
      if (statRecipientCount instanceof HTMLElement) statRecipientCount.textContent = String(activeSubscribers);

      if (!campaigns.length) {
        campaignRows.innerHTML = `
          <tr>
            <td colspan="6" class="newsletter-campaigns__empty">Még nincs mentett kampány.</td>
          </tr>
        `;
        return;
      }

      campaignRows.innerHTML = campaigns
        .map((campaign) => {
          const audienceCount = Array.isArray(campaign.audience) ? campaign.audience.length : 0;
          return `
            <tr>
              <td>
                <strong>${escapeHtml(campaign.subject || "Névtelen kampány")}</strong>
              </td>
              <td><span class="newsletter-campaigns__badge is-${escapeHtml(campaign.status || "draft")}">${escapeHtml(campaign.status || "draft")}</span></td>
              <td>${audienceCount ? `${audienceCount} elem` : "Összes aktív"}</td>
              <td>${escapeHtml(formatDate(campaign.createdAt))}</td>
              <td>${campaign.sentAt ? escapeHtml(formatDate(campaign.sentAt)) : "—"}</td>
              <td class="newsletter-campaigns__row-actions">
                <button type="button" class="newsletter-campaigns__inline-button" data-load-campaign="${escapeHtml(campaign.id)}">Betöltés</button>
                <button type="button" class="newsletter-campaigns__inline-button" data-send-campaign-id="${escapeHtml(campaign.id)}">Küldés</button>
              </td>
            </tr>
          `;
        })
        .join("");

      campaignRows.querySelectorAll("[data-load-campaign]").forEach((button) => {
        button.addEventListener("click", () => {
          const campaignId = button.getAttribute("data-load-campaign");
          const campaign = campaigns.find((item) => item.id === campaignId);
          if (!campaign) return;

          if (campaignIdInput instanceof HTMLInputElement) campaignIdInput.value = campaign.id;
          if (subjectInput instanceof HTMLInputElement) subjectInput.value = campaign.subject || "";
          if (textInput instanceof HTMLTextAreaElement) textInput.value = campaign.text || "";
          if (htmlInput instanceof HTMLTextAreaElement) htmlInput.value = campaign.html || "";
          if (audienceInput instanceof HTMLTextAreaElement) audienceInput.value = Array.isArray(campaign.audience) ? campaign.audience.join("\n") : "";
          if (editorTitle instanceof HTMLElement) editorTitle.textContent = `Kampány betöltve: ${campaign.subject || "Névtelen"}`;
          syncPreview();
          setStatus(`Kampány betöltve: ${campaign.subject || "Névtelen kampány"}.`, "success");
        });
      });

      campaignRows.querySelectorAll("[data-send-campaign-id]").forEach((button) => {
        button.addEventListener("click", async () => {
          const campaignId = button.getAttribute("data-send-campaign-id");
          if (!campaignId || !apiBase) return;
          await sendCampaign(campaignId);
        });
      });
    };

    const loadCampaigns = async () => {
      if (!apiBase) {
        if (apiLabel instanceof HTMLElement) apiLabel.textContent = "—";
        return;
      }

      setStatus("Kampányok betöltése...", "info");
      try {
        const response = await adminFetch(`${apiBase.replace(/\/$/, "")}/campaigns`, {
          headers: { Accept: "application/json" },
        });
        const result = await response.json();
        if (response.status === 401) {
          adminPassword = "";
          sessionStorage.removeItem(authStorageKey);
          window.location.replace("/admin/");
          return;
        }
        if (!response.ok || !result?.ok) {
          throw new Error(result?.message || "campaigns_load_failed");
        }

        campaigns = Array.isArray(result.campaigns) ? result.campaigns : [];
        await loadSubscribersCount();
        renderCampaignRows();
        setStatus(`Betöltve: ${campaigns.length} kampány.`, "success");
      } catch (error) {
        console.error("[newsletter-campaigns]", error);
        setStatus("Nem sikerült betölteni a kampányokat.", "error");
      }
    };

    const saveCampaign = async () => {
      if (!apiBase) {
        setStatus("A funkció jelenleg nem érhető el.", "error");
        return;
      }

      const subject = subjectInput instanceof HTMLInputElement ? subjectInput.value.trim() : "";
      const html = htmlInput instanceof HTMLTextAreaElement ? htmlInput.value.trim() : "";
      const text = textInput instanceof HTMLTextAreaElement ? textInput.value.trim() : "";
      const audience = normalizeAudience();
      const audienceLabel = audienceLabelInput instanceof HTMLInputElement ? audienceLabelInput.value.trim() : "";
      const payload = {
        subject,
        html,
        text,
        audience: audienceLabel ? [audienceLabel, ...audience] : audience,
      };

      if (!subject || !html) {
        setStatus("A tárgy és a HTML tartalom kötelező.", "warning");
        return;
      }

      setStatus("Draft mentése folyamatban...", "info");

      try {
        const response = await adminFetch(`${apiBase.replace(/\/$/, "")}/campaigns`, {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            Accept: "application/json",
          },
          body: JSON.stringify(payload),
        });
        const result = await response.json();
        if (response.status === 401) {
          adminPassword = "";
          sessionStorage.removeItem(authStorageKey);
          window.location.replace("/admin/");
          return;
        }
        if (!response.ok || !result?.ok) {
          throw new Error(result?.message || "save_failed");
        }

        const savedCampaign = result.campaign;
        campaigns = [savedCampaign, ...campaigns.filter((item) => item.id !== savedCampaign.id)];
        if (campaignIdInput instanceof HTMLInputElement) campaignIdInput.value = savedCampaign.id;
        if (editorTitle instanceof HTMLElement) editorTitle.textContent = `Draft mentve: ${savedCampaign.subject}`;
        renderCampaignRows();
        setStatus(`Draft mentve: ${savedCampaign.subject}`, "success");
      } catch (error) {
        console.error("[newsletter-campaigns]", error);
        setStatus("Nem sikerült menteni a draftot.", "error");
      }
    };

    const sendCampaign = async (campaignId) => {
      if (!apiBase) {
        setStatus("A funkció jelenleg nem érhető el.", "error");
        return;
      }

      setStatus("Kiküldés előkészítése...", "info");

      try {
        const response = await adminFetch(`${apiBase.replace(/\/$/, "")}/campaigns/${campaignId}/send`, {
          method: "POST",
          headers: { Accept: "application/json" },
        });
        const result = await response.json();
        if (response.status === 401) {
          adminPassword = "";
          sessionStorage.removeItem(authStorageKey);
          window.location.replace("/admin/");
          return;
        }
        if (!response.ok || !result?.ok) {
          throw new Error(result?.message || "send_failed");
        }

        await loadCampaigns();
        setStatus(
          `Kiküldve: ${result.sentCount ?? 0} sikeres, ${result.failedCount ?? 0} hibás címzett.`,
          result.failedCount ? "warning" : "success"
        );
      } catch (error) {
        console.error("[newsletter-campaigns]", error);
        setStatus("Nem sikerült kiküldeni a kampányt.", "error");
      }
    };

    const sendTest = async () => {
      if (!apiBase) {
        setStatus("A funkció jelenleg nem érhető el.", "error");
        return;
      }

      const to = testToInput instanceof HTMLInputElement && testToInput.value.trim() ? testToInput.value.trim() : "cvarnagy@gmail.com";
      const subject = subjectInput instanceof HTMLInputElement && subjectInput.value.trim() ? `${subjectInput.value.trim()} [TEST]` : "Dandelion kampány teszt";
      const text = textInput instanceof HTMLTextAreaElement && textInput.value.trim() ? textInput.value.trim() : "Ez egy tesztlevél a kampányszerkesztőből.";

      setStatus(`Tesztküldés: ${to}`, "info");

      try {
        const response = await adminFetch(`${apiBase.replace(/\/$/, "")}/smtp/test`, {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            Accept: "application/json",
          },
          body: JSON.stringify({ to, subject, text }),
        });
        const result = await response.json();
        if (response.status === 401) {
          adminPassword = "";
          sessionStorage.removeItem(authStorageKey);
          window.location.replace("/admin/");
          return;
        }
        if (!response.ok || !result?.ok) {
          throw new Error(result?.message || "smtp_test_failed");
        }
        setStatus(`Teszt levél elküldve: ${to}`, "success");
      } catch (error) {
        console.error("[newsletter-campaigns]", error);
        setStatus("A tesztküldés nem sikerült.", "error");
      }
    };

    subjectInput?.addEventListener("input", syncPreview);
    textInput?.addEventListener("input", syncPreview);
    htmlInput?.addEventListener("input", syncPreview);

    form?.addEventListener("submit", async (event) => {
      event.preventDefault();
      await saveCampaign();
    });

    loadButton?.addEventListener("click", loadCampaigns);
    newButton?.addEventListener("click", clearForm);
    saveButton?.addEventListener("click", saveCampaign);
    sendButton?.addEventListener("click", async () => {
      const campaignId = campaignIdInput instanceof HTMLInputElement ? campaignIdInput.value.trim() : "";
      if (!campaignId) {
        setStatus("Előbb mentsd el a draftot, vagy tölts be egy meglévő kampányt.", "warning");
        return;
      }
      await sendCampaign(campaignId);
    });
    testButton?.addEventListener("click", sendTest);

    syncPreview();
    loadCampaigns();
  })();
</script>

<style>
  .newsletter-campaigns {
    position: relative;
    min-height: 100vh;
    overflow: hidden;
    padding: 34px 18px 56px;
    background:
      radial-gradient(circle at top left, rgba(217, 183, 103, 0.18), transparent 25%),
      radial-gradient(circle at 82% 10%, rgba(110, 146, 108, 0.15), transparent 24%),
      linear-gradient(180deg, #f8f2e7 0%, #f3ede0 100%);
    color: #2b241c;
  }

  .newsletter-campaigns__orb {
    position: absolute;
    border-radius: 999px;
    filter: blur(18px);
    opacity: 0.54;
    pointer-events: none;
  }

  .newsletter-campaigns__orb--amber {
    top: 28px;
    right: -120px;
    width: 320px;
    height: 320px;
    background: rgba(223, 170, 74, 0.22);
  }

  .newsletter-campaigns__orb--green {
    left: -90px;
    bottom: 110px;
    width: 260px;
    height: 260px;
    background: rgba(110, 149, 113, 0.18);
  }

  .newsletter-campaigns__shell {
    position: relative;
    z-index: 1;
    width: min(1420px, calc(100vw - 36px));
