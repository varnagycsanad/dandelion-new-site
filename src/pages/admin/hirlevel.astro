---
import BaseLayout from "../../layouts/BaseLayout.astro";

const newsletterApiUrl =
  import.meta.env.PUBLIC_NEWSLETTER_API_URL ??
  import.meta.env.NEWSLETTER_PUBLIC_BASE_URL ??
  Astro.url.origin;
const pageTitle = "Feliratkozók kezelése";
const pageDescription =
  "Feliratkozók listája, keresés, státuszszűrés, CSV import és export a Dandelion adminon belül.";
---

<BaseLayout title={pageTitle} description={pageDescription} hideHeader={true} hideFooter={true} noindex={true}>
  <section class="newsletter-admin" data-newsletter-admin data-api-base={newsletterApiUrl} data-admin-route="/admin/hirlevel">
    <div class="newsletter-admin__backdrop newsletter-admin__backdrop--gold"></div>
    <div class="newsletter-admin__backdrop newsletter-admin__backdrop--sage"></div>

    <div class="newsletter-admin__shell" hidden>
      <header class="newsletter-admin__hero">
        <div class="newsletter-admin__hero-copy">
          <p class="newsletter-admin__eyebrow">Newsletter admin</p>
          <h1>{pageTitle}</h1>
          <p class="newsletter-admin__lead">
            Itt látod az aktív feliratkozókat, a leiratkozott címeket, a forrásokat és az utolsó frissítés idejét.
            Ez az első, könnyen használható admin nézet a saját, szolgáltató-független hírlevélhez.
          </p>
        </div>

        <div class="newsletter-admin__hero-actions">
          <a class="newsletter-admin__button newsletter-admin__button--ghost" href="/admin/newsletter/">Newsletter</a>
          <a class="newsletter-admin__button newsletter-admin__button--ghost" href="/admin/">Admin home</a>
          <button class="newsletter-admin__button newsletter-admin__button--ghost" type="button" data-open-import>
            CSV import
          </button>
          <button class="newsletter-admin__button newsletter-admin__button--ghost" type="button" data-refresh>
            Frissítés
          </button>
          <button class="newsletter-admin__button newsletter-admin__button--ghost" type="button" data-export>
            CSV export
          </button>
          <button class="newsletter-admin__button newsletter-admin__button--primary" type="button" data-copy-all>
            E-mail címek másolása
          </button>
        </div>
      </header>

      <div class="newsletter-admin__statusbar">
        <div class="newsletter-admin__status" data-status>
          Betöltés...
        </div>
        <div class="newsletter-admin__hint">
          API: <span data-api-label>{newsletterApiUrl || "—"}</span>
        </div>
      </div>

      <section class="newsletter-admin__stats" aria-label="Feliratkozó statisztikák">
        <article class="newsletter-admin__stat">
          <span class="newsletter-admin__stat-label">Összes</span>
          <strong data-stat-total>0</strong>
        </article>
        <article class="newsletter-admin__stat">
          <span class="newsletter-admin__stat-label">Aktív</span>
          <strong data-stat-active>0</strong>
        </article>
        <article class="newsletter-admin__stat">
          <span class="newsletter-admin__stat-label">Leiratkozott</span>
          <strong data-stat-unsubscribed>0</strong>
        </article>
        <article class="newsletter-admin__stat">
          <span class="newsletter-admin__stat-label">Források</span>
          <strong data-stat-sources>0</strong>
        </article>
      </section>

      <section class="newsletter-admin__tools" aria-label="Szűrés és keresés">
        <label class="newsletter-admin__field">
          <span>Keresés</span>
          <input type="search" placeholder="Név, e-mail, forrás, nyelv" data-search />
        </label>

        <label class="newsletter-admin__field">
          <span>Státusz</span>
          <select data-filter-status>
            <option value="all">Összes</option>
            <option value="active">Aktív</option>
            <option value="pending">Pending</option>
            <option value="unsubscribed">Leiratkozott</option>
          </select>
        </label>

        <label class="newsletter-admin__field">
          <span>Nyelv</span>
          <select data-filter-lang>
            <option value="all">Összes</option>
            <option value="hu">HU</option>
            <option value="en">EN</option>
            <option value="de">DE</option>
            <option value="cs">CS</option>
            <option value="sk">SK</option>
          </select>
        </label>

        <label class="newsletter-admin__field">
          <span>Forrás</span>
          <select data-filter-source>
            <option value="all">Összes</option>
          </select>
        </label>
      </section>

      <section class="newsletter-admin__import-panel is-hidden" aria-label="CSV import" data-import-panel>
        <div class="newsletter-admin__panel-head">
          <div>
            <p class="newsletter-admin__panel-kicker">Feliratkozó import</p>
            <h2>Lista és CSV import</h2>
          </div>
          <p class="newsletter-admin__panel-note">
            A fájl első sora lehet fejléc. Támogatott oszlopok: email, name, lang, source, status.
          </p>
        </div>

        <form class="newsletter-admin__import-form" data-import-form>
          <label class="newsletter-admin__field newsletter-admin__field--full">
            <span>CSV fájl</span>
            <input type="file" accept=".csv,text/csv" data-import-file />
          </label>

          <label class="newsletter-admin__field newsletter-admin__field--full">
            <span>Példa formátum</span>
            <textarea rows="5" readonly>email,name,lang,source,status
pelda@example.com,Példa Név,hu,landing,active</textarea>
          </label>

          <div class="newsletter-admin__actions">
            <button class="newsletter-admin__button newsletter-admin__button--primary" type="submit">
              Importálás
            </button>
            <button class="newsletter-admin__button newsletter-admin__button--ghost" type="button" data-close-import>
              Mégse
            </button>
          </div>
        </form>
      </section>

      <section class="newsletter-admin__panel">
        <div class="newsletter-admin__panel-head">
          <div>
            <p class="newsletter-admin__panel-kicker">Feliratkozók</p>
            <h2>Feliratkozók listája</h2>
          </div>
          <p class="newsletter-admin__panel-note">
            A lista a saját newsletter service-ből töltődik be, ezért ez az admin akkor is használható, ha nincs külső platform.
          </p>
        </div>

        <div class="newsletter-admin__table-wrap">
          <table class="newsletter-admin__table">
            <thead>
              <tr>
                <th>Név</th>
                <th>E-mail</th>
                <th>Státusz</th>
                <th>Nyelv</th>
                <th>Forrás</th>
                <th>Feliratkozás</th>
                <th>Leiratkozás</th>
                <th></th>
              </tr>
            </thead>
            <tbody data-subscriber-rows>
              <tr>
                <td colspan="8" class="newsletter-admin__empty">
                  A lista még töltés alatt van.
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>
    </div>
  </section>
</BaseLayout>

<script>
  import {
    buildAdminHeaders,
    clearStoredAdminAuth,
    getStoredAdminPassword,
    getStoredAdminSessionToken,
  } from "../../scripts/newsletterAdminAuth";

  (() => {
    const root = document.querySelector("[data-newsletter-admin]");
    if (!(root instanceof HTMLElement)) {
      return;
    }

    const apiBase = root.dataset.apiBase?.trim() || "";
    const statusNode = root.querySelector("[data-status]");
    const rowsNode = root.querySelector("[data-subscriber-rows]");
    const searchInput = root.querySelector("[data-search]");
    const statusFilter = root.querySelector("[data-filter-status]");
    const langFilter = root.querySelector("[data-filter-lang]");
    const sourceFilter = root.querySelector("[data-filter-source]");
    const refreshButton = root.querySelector("[data-refresh]");
    const exportButton = root.querySelector("[data-export]");
    const copyAllButton = root.querySelector("[data-copy-all]");
    const openImportButton = root.querySelector("[data-open-import]");
    const importPanel = root.querySelector("[data-import-panel]");
    const importForm = root.querySelector("[data-import-form]");
    const importFileInput = root.querySelector("[data-import-file]");
    const closeImportButton = root.querySelector("[data-close-import]");
    const statTotal = root.querySelector("[data-stat-total]");
    const statActive = root.querySelector("[data-stat-active]");
    const statUnsubscribed = root.querySelector("[data-stat-unsubscribed]");
    const statSources = root.querySelector("[data-stat-sources]");
    const apiLabel = root.querySelector("[data-api-label]");
    let subscribers = [];
    let filteredSubscribers = [];
    let sourceValues = [];
    let adminPassword = getStoredAdminSessionToken() || getStoredAdminPassword();

    if (!adminPassword) {
      window.location.replace("/admin/");
      return;
    }

    const shell = root.querySelector(".newsletter-admin__shell");
    if (shell instanceof HTMLElement) {
      shell.hidden = false;
    }

    const formatDate = (value) => {
      if (!value) return "—";
      const date = new Date(value);
      if (Number.isNaN(date.getTime())) return String(value);
      return new Intl.DateTimeFormat("hu-HU", {
        dateStyle: "medium",
        timeStyle: "short",
      }).format(date);
    };

    const escapeHtml = (value) =>
      String(value ?? "")
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;")
        .replaceAll("'", "&#39;");

    const normalize = (value) =>
      String(value ?? "")
        .toLowerCase()
        .normalize("NFD")
        .replace(/[\u0300-\u036f]/g, "");

    const setStatus = (message, tone = "info") => {
      if (!(statusNode instanceof HTMLElement)) return;
      statusNode.textContent = message;
      statusNode.dataset.tone = tone;
    };

    const adminHeaders = (extra = {}) => {
      return buildAdminHeaders(extra);
    };

    const adminFetch = (url, options = {}) =>
      fetch(url, {
        ...options,
        headers: adminHeaders(options.headers || {}),
      });

    const openImport = () => {
      if (importPanel instanceof HTMLElement) {
        importPanel.classList.remove("is-hidden");
      }
    };

    const closeImport = () => {
      if (importPanel instanceof HTMLElement) {
        importPanel.classList.add("is-hidden");
      }
      if (importForm instanceof HTMLFormElement) {
        importForm.reset();
      }
    };

    const parseCsvText = (text) => {
      const rows = [];
      const input = String(text ?? "").replace(/\r\n/g, "\n").replace(/\r/g, "\n");
      let current = "";
      let row = [];
      let inQuotes = false;

      for (let i = 0; i < input.length; i += 1) {
        const char = input[i];
        const next = input[i + 1];

        if (char === '"') {
          if (inQuotes && next === '"') {
            current += '"';
            i += 1;
          } else {
            inQuotes = !inQuotes;
          }
          continue;
        }

        if (char === "," && !inQuotes) {
          row.push(current);
          current = "";
          continue;
        }

        if (char === "\n" && !inQuotes) {
          row.push(current);
          if (row.some((cell) => String(cell).trim() !== "")) {
            rows.push(row);
          }
          row = [];
          current = "";
          continue;
        }

        current += char;
      }

      row.push(current);
      if (row.some((cell) => String(cell).trim() !== "")) {
        rows.push(row);
      }

      return rows;
    };

    const normalizeHeader = (value) =>
      normalize(value)
        .replace(/[^a-z0-9]+/g, "")
        .trim();

    const parseImportRows = (csvText) => {
      const parsed = parseCsvText(csvText);
      if (!parsed.length) {
        return [];
      }

      const headerCandidates = parsed[0].map((cell) => normalizeHeader(cell));
      const hasHeader = headerCandidates.some((value) => ["email", "name", "lang", "source", "status", "staus"].includes(value));
      const startIndex = hasHeader ? 1 : 0;
      const headerMap = hasHeader ? headerCandidates : [];

      return parsed
        .slice(startIndex)
        .map((row) => {
          if (!row.length) return null;
          const record = {};

          if (hasHeader) {
            row.forEach((cell, index) => {
              const key = headerMap[index] || `col${index}`;
              record[key] = cell;
            });
          } else {
            record.email = row[0];
            record.name = row[1] ?? "";
            record.lang = row[2] ?? "hu";
            record.source = row[3] ?? "csv-import";
            record.status = row[4] ?? "active";
          }

          const email = String(record.email ?? record.e_mail ?? record["e-mail"] ?? "").trim();
          if (!email) return null;

          return {
            email,
            name: String(record.name ?? record.nev ?? record.fullname ?? "").trim(),
            lang: String(record.lang ?? record.language ?? "hu").trim(),
            source: String(record.source ?? record.forras ?? "csv-import").trim(),
            status: String(record.status ?? "active").trim().toLowerCase(),
          };
        })
        .filter(Boolean);
    };

    const getFilterValue = (node) => (node instanceof HTMLInputElement || node instanceof HTMLSelectElement ? node.value : "all");

    const updateStats = () => {
      const counts = subscribers.reduce(
        (acc, subscriber) => {
          acc.total += 1;
          acc[subscriber.status] = (acc[subscriber.status] ?? 0) + 1;
          acc.sources.add(subscriber.source || "ismeretlen");
          return acc;
        },
        { total: 0, active: 0, unsubscribed: 0, pending: 0, sources: new Set() }
      );

      if (statTotal) statTotal.textContent = String(counts.total);
      if (statActive) statActive.textContent = String(counts.active);
      if (statUnsubscribed) statUnsubscribed.textContent = String(counts.unsubscribed);
      if (statSources) statSources.textContent = String(counts.sources.size);

      sourceValues = Array.from(counts.sources).sort((a, b) => a.localeCompare(b, "hu"));
      if (sourceFilter instanceof HTMLSelectElement) {
        const current = sourceFilter.value;
        const options = ["<option value=\"all\">Összes</option>"]
          .concat(sourceValues.map((source) => `<option value="${escapeHtml(source)}">${escapeHtml(source)}</option>`))
          .join("");
        sourceFilter.innerHTML = options;
        if (sourceValues.includes(current)) {
          sourceFilter.value = current;
        }
      }
    };

    const render = () => {
      const query = normalize(searchInput instanceof HTMLInputElement ? searchInput.value : "");
      const statusValue = getFilterValue(statusFilter);
      const langValue = getFilterValue(langFilter);
      const sourceValue = getFilterValue(sourceFilter);

      filteredSubscribers = subscribers.filter((subscriber) => {
        const haystack = normalize(
          [subscriber.name, subscriber.email, subscriber.source, subscriber.lang, subscriber.status].filter(Boolean).join(" ")
        );

        const matchesQuery = !query || haystack.includes(query);
        const matchesStatus = statusValue === "all" || subscriber.status === statusValue;
        const matchesLang = langValue === "all" || normalize(subscriber.lang) === normalize(langValue);
        const matchesSource = sourceValue === "all" || subscriber.source === sourceValue;
        return matchesQuery && matchesStatus && matchesLang && matchesSource;
      });

      if (!(rowsNode instanceof HTMLElement)) return;

      if (!filteredSubscribers.length) {
        rowsNode.innerHTML = `
          <tr>
            <td colspan="8" class="newsletter-admin__empty">
              Nincs a szűrőknek megfelelő feliratkozó.
            </td>
          </tr>
        `;
        return;
      }

      rowsNode.innerHTML = filteredSubscribers
        .map((subscriber) => {
          const statusClass = `is-${subscriber.status || "unknown"}`;
          const displayName = subscriber.name || "Névtelen";
          const unsubUrl = subscriber.unsubscribeToken ? `${apiBase.replace(/\/$/, "")}/unsubscribe/${subscriber.unsubscribeToken}` : "—";
          return `
            <tr>
              <td>
                <strong>${escapeHtml(displayName)}</strong>
              </td>
              <td>
                <a href="mailto:${escapeHtml(subscriber.email)}">${escapeHtml(subscriber.email)}</a>
              </td>
              <td><span class="newsletter-admin__badge ${statusClass}">${escapeHtml(subscriber.status || "unknown")}</span></td>
              <td>${escapeHtml(subscriber.lang || "—")}</td>
              <td>${escapeHtml(subscriber.source || "—")}</td>
              <td>${escapeHtml(formatDate(subscriber.createdAt))}</td>
              <td>${subscriber.unsubscribeToken ? `<a href="${escapeHtml(unsubUrl)}" target="_blank" rel="noreferrer">Link</a>` : "—"}</td>
              <td>
                <button type="button" class="newsletter-admin__inline-button" data-copy-email="${escapeHtml(subscriber.email)}">
                  Másolás
                </button>
              </td>
            </tr>
          `;
        })
        .join("");

      rowsNode.querySelectorAll("[data-copy-email]").forEach((button) => {
        button.addEventListener("click", async () => {
          const email = button.getAttribute("data-copy-email") || "";
          try {
            await navigator.clipboard.writeText(email);
            setStatus(`Kimásolva: ${email}`, "success");
          } catch {
            setStatus("Nem sikerült a vágólapra másolni.", "error");
          }
        });
      });
    };

    const loadSubscribers = async () => {
      if (!apiBase) {
        if (apiLabel instanceof HTMLElement) {
          apiLabel.textContent = "—";
        }
        return;
      }

      setStatus("Feliratkozók betöltése...", "info");

      try {
        const response = await adminFetch(`${apiBase.replace(/\/$/, "")}/subscribers`, {
          headers: { Accept: "application/json" },
        });

        if (response.status === 401) {
          adminPassword = "";
          clearStoredAdminAuth();
          window.location.replace("/admin/");
          return;
        }

        const result = await response.json();

        if (!response.ok || !result?.ok) {
          throw new Error(result?.message || "load_failed");
        }

        subscribers = Array.isArray(result.subscribers) ? result.subscribers : [];
        updateStats();
        render();
        setStatus(`Betöltve: ${subscribers.length} feliratkozó.`, "success");
      } catch (error) {
        console.error("[newsletter-admin]", error);
        setStatus("Nem sikerült betölteni a listát a newsletter service-ből.", "error");
      }
    };

    const exportCsv = () => {
      const rows = filteredSubscribers.length ? filteredSubscribers : subscribers;
      const columns = ["name", "email", "status", "lang", "source", "createdAt", "updatedAt", "unsubscribeToken"];
      const csv = [
        columns.join(","),
        ...rows.map((subscriber) =>
          columns
            .map((column) => {
              const value = String(subscriber[column] ?? "");
              return `"${value.replaceAll('"', '""')}"`;
            })
            .join(",")
        ),
      ].join("\n");

      const blob = new Blob([csv], { type: "text/csv;charset=utf-8" });
      const url = URL.createObjectURL(blob);
      const anchor = document.createElement("a");
      anchor.href = url;
      anchor.download = `dandelion-newsletter-${new Date().toISOString().slice(0, 10)}.csv`;
      document.body.appendChild(anchor);
      anchor.click();
      anchor.remove();
      URL.revokeObjectURL(url);
      setStatus("CSV export kész.", "success");
    };

    const copyAllEmails = async () => {
      const rows = filteredSubscribers.length ? filteredSubscribers : subscribers;
      const emails = rows.map((subscriber) => subscriber.email).filter(Boolean).join(", ");
      if (!emails) {
        setStatus("Nincs másolható e-mail cím.", "warning");
        return;
      }

      try {
        await navigator.clipboard.writeText(emails);
        setStatus("Az e-mail címek a vágólapra kerültek.", "success");
      } catch {
        setStatus("Nem sikerült a vágólapra másolni.", "error");
      }
    };

    const importCsvFile = async () => {
      if (!apiBase) {
        setStatus("Az import jelenleg nem érhető el.", "error");
        return;
      }

      const file = importFileInput instanceof HTMLInputElement ? importFileInput.files?.[0] : null;
      if (!file) {
        setStatus("Válassz egy CSV fájlt.", "warning");
        return;
      }

      const csvText = await file.text();
      const rows = parseImportRows(csvText);

      if (!rows.length) {
        setStatus("Nem találtam importálható sort a CSV-ben.", "warning");
        return;
      }

      setStatus(`Importálás folyamatban: ${rows.length} sor.`, "info");

      try {
        const response = await adminFetch(`${apiBase.replace(/\/$/, "")}/subscribers/import`, {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            Accept: "application/json",
          },
          body: JSON.stringify({ rows }),
        });

        if (response.status === 401) {
          adminPassword = "";
          clearStoredAdminAuth();
          window.location.replace("/admin/");
          return;
        }

        const result = await response.json();

        if (!response.ok || !result?.ok) {
          throw new Error(result?.message || "import_failed");
        }

        setStatus(result?.message || "CSV import kész.", "success");
        closeImport();
        await loadSubscribers();
      } catch (error) {
        console.error("[newsletter-admin-import]", error);
        setStatus("A CSV import nem sikerült.", "error");
      }
    };

    searchInput?.addEventListener("input", render);
    statusFilter?.addEventListener("change", render);
    langFilter?.addEventListener("change", render);
    sourceFilter?.addEventListener("change", render);
    refreshButton?.addEventListener("click", loadSubscribers);
    exportButton?.addEventListener("click", exportCsv);
    copyAllButton?.addEventListener("click", copyAllEmails);
    openImportButton?.addEventListener("click", openImport);
    closeImportButton?.addEventListener("click", closeImport);
    importForm?.addEventListener("submit", async (event) => {
      event.preventDefault();
      await importCsvFile();
    });

    loadSubscribers();
  })();
</script>

<style>
  .newsletter-admin {
    position: relative;
    min-height: 100vh;
    overflow: hidden;
    padding: 34px 18px 56px;
    background:
      radial-gradient(circle at top left, rgba(214, 171, 90, 0.18), transparent 26%),
      radial-gradient(circle at 85% 8%, rgba(104, 137, 108, 0.14), transparent 22%),
      linear-gradient(180deg, #f8f2e6 0%, #f4efe4 100%);
    color: #2b241c;
  }

  .newsletter-admin__backdrop {
    position: absolute;
    inset: auto;
    border-radius: 999px;
    filter: blur(18px);
    opacity: 0.55;
    pointer-events: none;
  }

  .newsletter-admin__backdrop--gold {
    top: 32px;
    right: -120px;
    width: 320px;
    height: 320px;
    background: rgba(224, 176, 74, 0.25);
  }

  .newsletter-admin__backdrop--sage {
    left: -80px;
    bottom: 120px;
    width: 260px;
    height: 260px;
    background: rgba(126, 155, 122, 0.2);
  }

  .newsletter-admin__shell {
    position: relative;
    z-index: 1;
    width: min(1360px, calc(100vw - 36px));
    margin: 0 auto;
    display: grid;
    gap: 20px;
  }

  .newsletter-admin.is-locked .newsletter-admin__shell {
    filter: blur(5px);
    pointer-events: none;
    user-select: none;
  }

  .newsletter-admin__auth {
    position: fixed;
    inset: 0;
    z-index: 20;
    display: grid;
    place-items: center;
    padding: 24px;
    background: rgba(30, 23, 16, 0.45);
    backdrop-filter: blur(8px);
  }

  .newsletter-admin__auth[hidden] {
    display: none;
  }

  .newsletter-admin__auth-card {
    width: min(520px, 100%);
    padding: 26px;
    border-radius: 28px;
    background: rgba(255, 252, 247, 0.96);
    box-shadow: 0 30px 80px rgba(30, 23, 16, 0.28);
    display: grid;
    gap: 14px;
  }

  .newsletter-admin__auth-card h2 {
    margin: 0;
    font-family: var(--dnd-font-display);
    font-size: clamp(1.7rem, 2.4vw, 2.4rem);
  }

  .newsletter-admin__auth-form {
    display: grid;
    gap: 16px;
  }

  .newsletter-admin__import-form {
    display: grid;
    gap: 16px;
  }

  .newsletter-admin__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: flex-start;
  }

