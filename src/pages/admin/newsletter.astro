---
import BaseLayout from "../../layouts/BaseLayout.astro";
import NewsletterSidebar from "../../components/admin/NewsletterSidebar.astro";

const newsletterApiUrl =
  import.meta.env.PUBLIC_NEWSLETTER_API_URL ??
  import.meta.env.NEWSLETTER_PUBLIC_BASE_URL ??
  "/newsletter-api";
const pageTitle = "Newsletter";
const pageDescription = "Központi newsletter admin hub a feliratkozókhoz és a kampányokhoz.";
---

<BaseLayout title={pageTitle} description={pageDescription} hideHeader={true} hideFooter={true} noindex={true}>
  <section class="admin-newsletter" data-admin-newsletter data-api-base={newsletterApiUrl}>
    <div class="admin-newsletter__backdrop admin-newsletter__backdrop--gold"></div>
    <div class="admin-newsletter__backdrop admin-newsletter__backdrop--sage"></div>

    <div class="admin-newsletter__gate" data-gate>
      <div class="admin-newsletter__gate-card">
        <p class="admin-newsletter__eyebrow">Newsletter hub</p>
        <h1>{pageTitle}</h1>
        <p class="admin-newsletter__lead">
          Ez a központi belépési pont a hírlevél modulokhoz. Itt látszik először, ha a külön newsletter service nincs elindítva.
        </p>

        <div class="admin-newsletter__diagnostics" aria-label="Ellenőrzési állapot">
          <div class="admin-newsletter__connection-flag" data-connection-flag aria-live="polite">
            Ellenőrzés indul...
          </div>
          <div class="admin-newsletter__diagnostic-row">
            <div class="admin-newsletter__diagnostic">
              <span>API</span>
              <strong data-diagnostic-step="health">Várakozás</strong>
            </div>
            <div class="admin-newsletter__diagnostic">
              <span>Admin</span>
              <strong data-diagnostic-step="auth">Várakozás</strong>
            </div>
            <div class="admin-newsletter__diagnostic">
              <span>Lista</span>
              <strong data-diagnostic-step="data">Várakozás</strong>
            </div>
          </div>
        </div>

        <div class="admin-newsletter__gate-actions">
          <a class="admin-newsletter__button admin-newsletter__button--ghost" href="/admin/">Vissza az adminhoz</a>
          <button class="admin-newsletter__button" type="button" data-check-connection>
            Újraellenőrzés
          </button>
        </div>

        <p class="admin-newsletter__gate-status" data-gate-status aria-live="polite">
          A kapcsolódás még nincs ellenőrizve.
        </p>
      </div>
    </div>

    <div class="admin-newsletter__shell">
      <NewsletterSidebar activeSection="dashboard" />
      <div class="admin-newsletter__content">
      <header class="admin-newsletter__hero">
        <div class="admin-newsletter__hero-copy">
          <p class="admin-newsletter__eyebrow">Dandelion admin</p>
          <h1>{pageTitle}</h1>
          <p class="admin-newsletter__lead">
            Itt találod a newsletter modulokat. Később ide új admin blokkok is érkezhetnek.
          </p>
        </div>

        <div class="admin-newsletter__hero-actions">
          <a class="admin-newsletter__button admin-newsletter__button--ghost" href="/admin/">Admin home</a>
        </div>
      </header>

      <section class="admin-newsletter__grid" aria-label="Newsletter blokkok">
        <a class="admin-newsletter__card" href="/admin/hirlevel/">
          <span class="admin-newsletter__card-label">Feliratkozók</span>
          <strong>Lista és CSV import</strong>
          <p>keresés, export, gyors másolás és importálás</p>
        </a>

        <a class="admin-newsletter__card" href="/admin/kampanyok/">
          <span class="admin-newsletter__card-label">Kampányok</span>
          <strong>Draft, teszt és küldés</strong>
          <p>kampány létrehozás, SMTP teszt és éles kiküldés</p>
        </a>

        <div class="admin-newsletter__card admin-newsletter__card--muted">
          <span class="admin-newsletter__card-label">Jövőbeli modulok</span>
          <strong>Hely más admin blokkoknak</strong>
          <p>ide később új, nem newsletter funkciók is bekerülhetnek</p>
        </div>
      </section>
      </div>
    </div>
  </section>
</BaseLayout>

<script type="module">
  import {
    buildAdminFetch,
    clearStoredAdminAuth,
    getStoredAdminPassword,
    getStoredAdminSessionToken,
    isLocalAdminSessionToken,
  } from "../../scripts/newsletterAdminAuth";

  (() => {
    const root = document.querySelector("[data-admin-newsletter]");
    if (!(root instanceof HTMLElement)) return;

    const apiBase = root.dataset.apiBase?.trim() || "";
    const gate = root.querySelector("[data-gate]");
    const gateStatus = root.querySelector("[data-gate-status]");
    const connectionFlag = root.querySelector("[data-connection-flag]");
    const diagnosticSteps = {
      health: root.querySelector('[data-diagnostic-step="health"]'),
      auth: root.querySelector('[data-diagnostic-step="auth"]'),
      data: root.querySelector('[data-diagnostic-step="data"]'),
    };
    const checkConnectionButton = root.querySelector("[data-check-connection]");
    const shell = root.querySelector(".admin-newsletter__shell");
    const adminPassword = getStoredAdminSessionToken() || getStoredAdminPassword();
    const localAdminMode = isLocalAdminSessionToken(adminPassword);
    const setDiagnosticStep = (step, label, tone = "neutral") => {
      const node = diagnosticSteps[step];
      if (!(node instanceof HTMLElement)) return;
      node.textContent = label;
      node.dataset.tone = tone;
    };
    const showGate = (message, tone = "info") => {
      if (gate instanceof HTMLElement) {
        gate.hidden = false;
      }
      if (gateStatus instanceof HTMLElement) {
        gateStatus.textContent = message;
        gateStatus.dataset.tone = tone;
      }
      if (connectionFlag instanceof HTMLElement) {
        connectionFlag.textContent =
          tone === "success"
            ? "A newsletter service fut."
            : tone === "warning"
              ? "A newsletter service most nem látszik."
              : tone === "error"
                ? "A newsletter service nem érhető el."
                : "Ellenőrzés indul...";
        connectionFlag.dataset.tone = tone;
      }
    };

    const checkConnection = async () => {
      setDiagnosticStep("health", "Ellenőrzés...", "info");
      setDiagnosticStep("auth", "Várakozás", "neutral");
      setDiagnosticStep("data", "Várakozás", "neutral");

      if (!apiBase) {
        setDiagnosticStep("health", "Nincs cím", "error");
        showGate("A newsletter service címe nincs beállítva. Ellenőrizd a PUBLIC_NEWSLETTER_API_URL vagy NEWSLETTER_PUBLIC_BASE_URL értékét.", "warning");
        return false;
      }

      try {
        const response = await fetch(`${apiBase.replace(/\/$/, "")}/health`, {
          headers: { Accept: "application/json" },
        });
        const result = await response.json().catch(() => ({}));

        if (!response.ok || !result?.ok) {
          throw new Error(result?.message || "health_failed");
        }

        setDiagnosticStep("health", "Rendben", "success");
        setDiagnosticStep("auth", adminPassword ? "Mentett jelszó van" : "Nincs mentett belépés", adminPassword ? "warning" : "neutral");
        setDiagnosticStep("data", typeof result?.counts?.subscribers === "number" ? `${result.counts.subscribers} cím` : "Elérhető", "success");
        showGate(`A newsletter service elérhető: ${result?.service ?? "rendben"}.`, "success");
        return true;
      } catch {
        setDiagnosticStep("health", "Nem elérhető", "error");
        setDiagnosticStep("auth", "Nem ellenőrizhető", "error");
        setDiagnosticStep("data", "Nem ellenőrizhető", "error");
        showGate("A newsletter service most nem érhető el. Valószínűleg külön el kell indítani a newsletter-service processzt.", "error");
        return false;
      }
    };

    const validateStoredAuth = async () => {
      const connectionOk = await checkConnection();

      if (localAdminMode && connectionOk) {
        showGate("A newsletter service elérhető, az admin használható.", "success");
        return;
      }

      if (!adminPassword) {
        showGate("Lépj be az /admin/ oldalon, aztán ide visszatérve látni fogod a modulokat is.", "warning");
        return;
      }

      try {
        const response = await buildAdminFetch(apiBase, "/admin/auth", {
          method: "POST",
          headers: { Accept: "application/json" },
          body: "{}",
        });
        const result = await response.json().catch(() => ({}));

        if (!response.ok || !result?.ok) {
          throw new Error(result?.message || "auth_failed");
        }

        setDiagnosticStep("auth", "Belépve", "success");
        showGate("Belépés rendben, a modulok használhatók.", "success");
      } catch {
        if (localAdminMode && connectionOk) {
          setDiagnosticStep("auth", "Helyi mód", "warning");
          showGate("Helyi admin mód aktív, a newsletter service most nem érhető el.", "warning");
          return;
        }

        setDiagnosticStep("auth", "Sikertelen", "error");
        clearStoredAdminAuth();
        showGate("Az admin belépés vagy a newsletter service nincs kész. Nyisd meg az /admin/ oldalt, majd onnan jelentkezz be.", "warning");
      }
    };

    checkConnectionButton?.addEventListener("click", async () => {
      await checkConnection();
    });

    validateStoredAuth();
  })();
</script>

<style>
  .admin-newsletter {
    position: relative;
    min-height: 100vh;
    padding: 36px 18px 56px;
    isolation: isolate;
    background:
      radial-gradient(circle at top left, rgba(212, 173, 89, 0.18), transparent 25%),
      radial-gradient(circle at 85% 10%, rgba(104, 137, 108, 0.14), transparent 24%),
    linear-gradient(180deg, #f8f2e6 0%, #f4efdf 100%);
  }

  .admin-newsletter__gate {
    position: relative;
    z-index: 5;
    width: min(1120px, 100%);
    margin: 0 auto 18px;
    display: grid;
    place-items: center;
    pointer-events: auto;
  }

  .admin-newsletter__gate[hidden] {
    display: none;
  }

  .admin-newsletter__gate-card {
    width: min(760px, 100%);
    padding: 28px;
    border-radius: 28px;
    border: 1px solid rgba(92, 67, 37, 0.12);
    background: rgba(255, 252, 247, 0.92);
    box-shadow: 0 16px 40px rgba(79, 60, 34, 0.08);
    display: grid;
    gap: 14px;
    pointer-events: auto;
  }

  .admin-newsletter__diagnostics {
    display: grid;
    gap: 10px;
  }

  .admin-newsletter__connection-flag {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    min-height: 34px;
    padding: 0 12px;
    border-radius: 999px;
    border: 1px solid rgba(92, 67, 37, 0.12);
    background: rgba(255, 252, 247, 0.96);
    color: #5b4a39;
    font-size: 0.92rem;
    font-weight: 700;
    line-height: 1;
  }

  .admin-newsletter__diagnostic-row {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
  }

  .admin-newsletter__diagnostic {
    display: grid;
    gap: 6px;
    padding: 12px 14px;
    border-radius: 18px;
    border: 1px solid rgba(92, 67, 37, 0.1);
    background: rgba(255, 255, 255, 0.76);
  }

  .admin-newsletter__diagnostic span {
    color: rgba(102, 78, 42, 0.78);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .admin-newsletter__diagnostic strong {
    font-size: 0.98rem;
    line-height: 1.35;
  }

  .admin-newsletter__diagnostic strong[data-tone="success"] {
    color: #1d6b37;
  }

  .admin-newsletter__diagnostic strong[data-tone="warning"] {
    color: #8a5a00;
  }

  .admin-newsletter__diagnostic strong[data-tone="error"] {
    color: #9b2c2c;
  }

  .admin-newsletter__diagnostic strong[data-tone="info"] {
    color: #5b4a39;
  }

  .admin-newsletter__connection-flag[data-tone="success"] {
    border-color: rgba(57, 123, 73, 0.18);
    background: rgba(231, 247, 232, 0.96);
    color: #1d6b37;
  }

  .admin-newsletter__connection-flag[data-tone="warning"] {
    border-color: rgba(201, 156, 59, 0.2);
    background: rgba(255, 245, 224, 0.96);
    color: #8a5a00;
  }

  .admin-newsletter__connection-flag[data-tone="error"] {
    border-color: rgba(196, 94, 94, 0.2);
    background: rgba(255, 236, 236, 0.96);
    color: #9b2c2c;
  }

  .admin-newsletter__backdrop {
    position: absolute;
    border-radius: 999px;
    filter: blur(18px);
    opacity: 0.5;
    pointer-events: none;
  }

  .admin-newsletter__backdrop--gold {
    top: 20px;
    right: -120px;
    width: 280px;
    height: 280px;
    background: rgba(203, 166, 93, 0.35);
  }

  .admin-newsletter__backdrop--sage {
    top: 220px;
    left: -100px;
    width: 240px;
    height: 240px;
    background: rgba(126, 150, 116, 0.24);
  }

  .admin-newsletter__shell {
    position: relative;
    z-index: 1;
    width: min(1440px, calc(100vw - 36px));
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(260px, 300px) minmax(0, 1fr);
    gap: 22px;
    align-items: start;
  }

  .admin-newsletter__content {
    display: grid;
    gap: 20px;
    min-width: 0;
  }

  .admin-newsletter__hero {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 26px;
  }

  .admin-newsletter__eyebrow {
    margin: 0 0 10px;
    color: #a57d37;
    font-size: 0.92rem;
    font-weight: 800;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .admin-newsletter h1 {
    margin: 0;
    font-family: var(--dnd-font-display);
    font-size: clamp(2.8rem, 5vw, 5rem);
    line-height: 0.98;
    color: #241c16;
  }

  .admin-newsletter__lead {
    max-width: 760px;
    margin: 18px 0 0;
    color: #5b4a39;
    font-size: 1.08rem;
    line-height: 1.7;
  }

  .admin-newsletter__gate-status {
    margin: 0;
    padding: 12px 14px;
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.82);
    color: #4c3d2e;
    border: 1px solid rgba(92, 67, 37, 0.1);
    line-height: 1.5;
  }

  .admin-newsletter__gate-status[data-tone="success"] {
    color: #1d6b37;
    border-color: rgba(57, 123, 73, 0.18);
    background: rgba(231, 247, 232, 0.94);
  }

  .admin-newsletter__gate-status[data-tone="warning"] {
    color: #8a5a00;
    border-color: rgba(201, 156, 59, 0.2);
    background: rgba(255, 245, 224, 0.96);
  }

  .admin-newsletter__gate-status[data-tone="error"] {
    color: #9b2c2c;
    border-color: rgba(196, 94, 94, 0.2);
    background: rgba(255, 236, 236, 0.96);
  }

  .admin-newsletter__gate-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    pointer-events: auto;
  }

  .admin-newsletter__hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 10px;
  }

  .admin-newsletter__button,
  .admin-newsletter__card {
    border-radius: 24px;
  }

  .admin-newsletter__button {
    min-height: 46px;
    padding: 0 18px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    color: #fff9ef;
    background: linear-gradient(135deg, #272218 0%, #6c5130 100%);
    box-shadow: 0 18px 28px rgba(63, 47, 26, 0.2);
    font-weight: 700;
    cursor: pointer;
    pointer-events: auto;
    position: relative;
    z-index: 6;
  }

  .admin-newsletter__button--ghost {
    background: rgba(255, 252, 247, 0.9);
    color: #3f3124;
    box-shadow: inset 0 0 0 1px rgba(92, 67, 37, 0.1);
  }

  .admin-newsletter__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
  }

  .admin-newsletter__card {
    display: grid;
    gap: 10px;
    padding: 24px;
    background: rgba(255, 252, 247, 0.92);
    color: #2b241c;
    text-decoration: none;
    box-shadow:
      inset 0 0 0 1px rgba(92, 67, 37, 0.08),
      0 16px 40px rgba(79, 60, 34, 0.08);
    transition:
      transform 160ms ease,
      box-shadow 160ms ease;
  }

  .admin-newsletter__card:hover {
    transform: translateY(-2px);
    box-shadow:
      inset 0 0 0 1px rgba(92, 67, 37, 0.12),
      0 20px 44px rgba(79, 60, 34, 0.1);
  }

  .admin-newsletter__card--muted {
    opacity: 0.82;
  }

  .admin-newsletter__card-label {
    color: rgba(122, 95, 52, 0.86);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .admin-newsletter__card strong {
    font-family: var(--dnd-font-display);
    font-size: 1.8rem;
  }

  .admin-newsletter__card p {
    margin: 0;
    color: rgba(69, 55, 38, 0.82);
    line-height: 1.6;
  }

  @media (max-width: 980px) {
    .admin-newsletter__shell {
      grid-template-columns: 1fr;
    }

    .admin-newsletter__hero,
    .admin-newsletter__grid {
      grid-template-columns: 1fr;
      display: grid;
    }

    .admin-newsletter__hero {
      align-items: start;
    }

    .admin-newsletter__hero-actions {
      justify-content: flex-start;
    }
  }

  @media (max-width: 780px) {
    .admin-newsletter {
      padding: 20px 12px 28px;
    }

    .admin-newsletter__shell {
      width: min(100%, 100vw - 24px);
    }

    .admin-newsletter__grid {
      grid-template-columns: 1fr;
    }

    .admin-newsletter__diagnostic-row {
      grid-template-columns: 1fr;
    }
  }
</style>
