---
import BaseLayout from "../../layouts/BaseLayout.astro";
import NewsletterSidebar from "../../components/admin/NewsletterSidebar.astro";

const newsletterApiUrl =
  import.meta.env.PUBLIC_NEWSLETTER_API_URL ??
  import.meta.env.NEWSLETTER_PUBLIC_BASE_URL ??
  "/newsletter-api";
const pageTitle = "Áttekintés";
const pageDescription = "Hírlevél admin dashboard a feliratkozók, listák, csoportok és kampányok gyors áttekintéséhez.";
---

<BaseLayout title={pageTitle} description={pageDescription} hideHeader={true} hideFooter={true} noindex={true}>
  <section class="admin-newsletter" data-admin-newsletter data-api-base={newsletterApiUrl}>
    <div class="admin-newsletter__backdrop admin-newsletter__backdrop--gold"></div>
    <div class="admin-newsletter__backdrop admin-newsletter__backdrop--sage"></div>

    <div class="admin-newsletter__gate" data-gate>
      <div class="admin-newsletter__gate-card">
        <div class="admin-newsletter__gate-head">
          <div>
            <p class="admin-newsletter__eyebrow">Newsletter hub</p>
            <strong class="admin-newsletter__gate-title">Kapcsolat és belépés</strong>
          </div>
          <div class="admin-newsletter__connection-flag" data-connection-flag aria-live="polite">
            Ellenőrzés indul...
          </div>
        </div>

        <div class="admin-newsletter__diagnostics" aria-label="Ellenőrzési állapot">
          <div class="admin-newsletter__diagnostic-row">
            <div class="admin-newsletter__diagnostic">
              <span>API</span>
              <strong data-diagnostic-step="health">Várakozás</strong>
            </div>
            <div class="admin-newsletter__diagnostic">
              <span>Admin</span>
              <strong data-diagnostic-step="auth">Várakozás</strong>
            </div>
            <div class="admin-newsletter__diagnostic">
              <span>Adat</span>
              <strong data-diagnostic-step="data">Várakozás</strong>
            </div>
          </div>
        </div>

        <div class="admin-newsletter__gate-actions">
          <button class="admin-newsletter__button admin-newsletter__button--ghost" type="button" data-check-connection>
            Újraellenőrzés
          </button>
          <a class="admin-newsletter__button" href="/admin/">Vissza az adminhoz</a>
        </div>

        <p class="admin-newsletter__gate-status" data-gate-status aria-live="polite">
          A kapcsolódás még nincs ellenőrizve.
        </p>
      </div>
    </div>

    <div class="admin-newsletter__shell">
      <NewsletterSidebar activeSection="dashboard" />

      <div class="admin-newsletter__content">
        <header class="admin-newsletter__header">
          <div class="admin-newsletter__header-copy">
            <p class="admin-newsletter__eyebrow">Dandelion admin</p>
            <h1>{pageTitle}</h1>
            <p class="admin-newsletter__lead">
              Itt látod a hírlevél rendszer alapadatait. A dashboard a feliratkozók számát, a listák megoszlását,
              a csoportokat és a kampányokat mutatja, hogy azonnal tudd, mi működik.
            </p>
          </div>

          <div class="admin-newsletter__header-actions">
            <a class="admin-newsletter__button admin-newsletter__button--ghost" href="/admin/hirlevel/">
              Feliratkozók
            </a>
            <a class="admin-newsletter__button admin-newsletter__button--ghost" href="/admin/kampanyok/">
              Kampányok
            </a>
            <button class="admin-newsletter__button" type="button" data-refresh-dashboard>
              Adatok frissítése
            </button>
          </div>
        </header>

        <section class="admin-newsletter__summary" aria-label="Fő statisztikák">
          <article class="admin-newsletter__metric">
            <span>Összes feliratkozó</span>
            <strong data-dashboard-stat="subscribers">—</strong>
            <p>Az összes betöltött cím a service-ből.</p>
          </article>

          <article class="admin-newsletter__metric">
            <span>Aktív címek</span>
            <strong data-dashboard-stat="active">—</strong>
            <p>Kiknek lehet most levelet küldeni.</p>
          </article>

          <article class="admin-newsletter__metric">
            <span>Függőben</span>
            <strong data-dashboard-stat="pending">—</strong>
            <p>Folyamatban lévő feliratkozások.</p>
          </article>

          <article class="admin-newsletter__metric">
            <span>Leiratkozott</span>
            <strong data-dashboard-stat="unsubscribed">—</strong>
            <p>Jelenleg kizárt címek.</p>
          </article>

          <article class="admin-newsletter__metric">
            <span>Listák</span>
            <strong data-dashboard-stat="lists">—</strong>
            <p>Hírlevél, korábbi vendégek és egyéb listák.</p>
          </article>

          <article class="admin-newsletter__metric">
            <span>Csoportok</span>
            <strong data-dashboard-stat="groups">—</strong>
            <p>Későbbi kampánycélzásokhoz.</p>
          </article>

          <article class="admin-newsletter__metric">
            <span>Kampányok</span>
            <strong data-dashboard-stat="campaigns">—</strong>
            <p>Összes nyilvántartott kampány.</p>
          </article>

          <article class="admin-newsletter__metric">
            <span>Küldések</span>
            <strong data-dashboard-stat="deliveries">—</strong>
            <p>Naplózott levelezési események.</p>
          </article>
        </section>

        <section class="admin-newsletter__panel">
          <div class="admin-newsletter__panel-head">
            <div>
              <p class="admin-newsletter__eyebrow">Listák</p>
              <h2>Lista bontás</h2>
            </div>
            <p class="admin-newsletter__panel-note">
              Itt látszik, hogy a különböző listákon hány aktív, függőben lévő vagy leiratkozott cím van.
            </p>
          </div>

          <div class="admin-newsletter__list-grid" data-list-grid aria-live="polite"></div>
        </section>

        <section class="admin-newsletter__panel admin-newsletter__panel--compact">
          <div class="admin-newsletter__panel-head">
            <div>
              <p class="admin-newsletter__eyebrow">Gyors műveletek</p>
              <h2>Mit érdemes innen csinálni?</h2>
            </div>
          </div>

          <div class="admin-newsletter__action-grid">
            <a class="admin-newsletter__action-card" href="/admin/hirlevel/">
              <strong>Feliratkozók kezelése</strong>
              <span>Keresés, szűrés, import és manuális felvitel.</span>
            </a>
            <a class="admin-newsletter__action-card" href="/admin/kampanyok/">
              <strong>Kampányok indítása</strong>
              <span>Draft, teszt, célcsoport és éles kiküldés.</span>
            </a>
          </div>
        </section>
      </div>
    </div>
  </section>
</BaseLayout>

<script type="module">
  import {
    buildAdminFetch,
    clearStoredAdminAuth,
    getStoredAdminPassword,
    getStoredAdminSessionToken,
    isLocalAdminSessionToken,
  } from "../../scripts/newsletterAdminAuth";

  (() => {
    const root = document.querySelector("[data-admin-newsletter]");
    if (!(root instanceof HTMLElement)) return;

    const apiBase = root.dataset.apiBase?.trim() || "";
    const gate = root.querySelector("[data-gate]");
    const gateStatus = root.querySelector("[data-gate-status]");
    const connectionFlag = root.querySelector("[data-connection-flag]");
    const diagnosticSteps = {
      health: root.querySelector('[data-diagnostic-step="health"]'),
      auth: root.querySelector('[data-diagnostic-step="auth"]'),
      data: root.querySelector('[data-diagnostic-step="data"]'),
    };
    const checkConnectionButton = root.querySelector("[data-check-connection]");
    const refreshButton = root.querySelector("[data-refresh-dashboard]");
    const statNodes = {
      subscribers: root.querySelector('[data-dashboard-stat="subscribers"]'),
      active: root.querySelector('[data-dashboard-stat="active"]'),
      pending: root.querySelector('[data-dashboard-stat="pending"]'),
      unsubscribed: root.querySelector('[data-dashboard-stat="unsubscribed"]'),
      lists: root.querySelector('[data-dashboard-stat="lists"]'),
      groups: root.querySelector('[data-dashboard-stat="groups"]'),
      campaigns: root.querySelector('[data-dashboard-stat="campaigns"]'),
      deliveries: root.querySelector('[data-dashboard-stat="deliveries"]'),
    };
    const listGrid = root.querySelector("[data-list-grid]");
    const adminPassword = getStoredAdminSessionToken() || getStoredAdminPassword();
    const localAdminMode = isLocalAdminSessionToken(adminPassword);

    const setDiagnosticStep = (step, label, tone = "neutral") => {
      const node = diagnosticSteps[step];
      if (!(node instanceof HTMLElement)) return;
      node.textContent = label;
      node.dataset.tone = tone;
    };

    const setStat = (key, value) => {
      const node = statNodes[key];
      if (!(node instanceof HTMLElement)) return;
      node.textContent = value;
    };

    const showGate = (message, tone = "info") => {
      if (gate instanceof HTMLElement) {
        gate.hidden = false;
      }
      if (gateStatus instanceof HTMLElement) {
        gateStatus.textContent = message;
        gateStatus.dataset.tone = tone;
      }
      if (connectionFlag instanceof HTMLElement) {
        connectionFlag.textContent =
          tone === "success"
            ? "A service fut."
            : tone === "warning"
              ? "Ellenőrzés kell."
              : tone === "error"
                ? "Nincs kapcsolat."
                : "Ellenőrzés indul...";
        connectionFlag.dataset.tone = tone;
      }
    };

    const hideGate = () => {
      if (gate instanceof HTMLElement) {
        gate.hidden = true;
      }
    };

    const renderListCards = (lists) => {
      if (!(listGrid instanceof HTMLElement)) return;

      const items = Array.isArray(lists) ? lists : [];
      if (!items.length) {
        listGrid.innerHTML = `
          <div class="admin-newsletter__empty-state">
            <strong>Nincs listaadat</strong>
            <p>A service még nem adott vissza listabontást.</p>
          </div>
        `;
        return;
      }

      listGrid.innerHTML = items
        .map((item) => {
          const total = Number(item.total ?? 0);
          const active = Number(item.active ?? 0);
          const pending = Number(item.pending ?? 0);
          const unsubscribed = Number(item.unsubscribed ?? 0);
          const name = String(item.name ?? item.key ?? "Ismeretlen lista");
          const description = String(item.description ?? "").trim();

          return `
            <article class="admin-newsletter__list-card">
              <div class="admin-newsletter__list-card-head">
                <div>
                  <p class="admin-newsletter__list-key">${String(item.key ?? "").replaceAll("-", " ")}</p>
                  <h3>${name}</h3>
                </div>
                <strong>${total}</strong>
              </div>
              ${description ? `<p class="admin-newsletter__list-description">${description}</p>` : ""}
              <div class="admin-newsletter__list-stats">
                <span><strong>${active}</strong> aktív</span>
                <span><strong>${pending}</strong> függőben</span>
                <span><strong>${unsubscribed}</strong> leiratkozott</span>
              </div>
            </article>
          `;
        })
        .join("");
    };

    const fetchDashboardData = async () => {
      if (!apiBase) {
        setDiagnosticStep("health", "Nincs cím", "error");
        setDiagnosticStep("auth", "Nem ellenőrizhető", "error");
        setDiagnosticStep("data", "Nem ellenőrizhető", "error");
        showGate(
          "A newsletter service címe nincs beállítva. Ellenőrizd a PUBLIC_NEWSLETTER_API_URL vagy NEWSLETTER_PUBLIC_BASE_URL értékét.",
          "warning"
        );
        return;
      }

      try {
        const [healthResponse, listsResponse] = await Promise.all([
          buildAdminFetch(apiBase, "/health", { headers: { Accept: "application/json" } }),
          buildAdminFetch(apiBase, "/lists", { headers: { Accept: "application/json" } }),
        ]);
        const [healthResult, listsResult] = await Promise.all([
          healthResponse.json().catch(() => ({})),
          listsResponse.json().catch(() => ({})),
        ]);

        if (!healthResponse.ok || !healthResult?.ok) {
          throw new Error(healthResult?.message || "health_failed");
        }

        if (!listsResponse.ok || !listsResult?.ok) {
          throw new Error(listsResult?.message || "lists_failed");
        }

        const counts = healthResult.counts ?? {};
        const lists = Array.isArray(listsResult.lists) ? listsResult.lists : [];
        const activeTotal = lists.reduce((sum, item) => sum + Number(item?.active ?? 0), 0);
        const pendingTotal = lists.reduce((sum, item) => sum + Number(item?.pending ?? 0), 0);
        const unsubscribedTotal = lists.reduce((sum, item) => sum + Number(item?.unsubscribed ?? 0), 0);
        const subscriberTotal = Number(counts.subscribers ?? 0);

        setStat("subscribers", subscriberTotal.toLocaleString("hu-HU"));
        setStat("active", activeTotal.toLocaleString("hu-HU"));
        setStat("pending", pendingTotal.toLocaleString("hu-HU"));
        setStat("unsubscribed", unsubscribedTotal.toLocaleString("hu-HU"));
        setStat("lists", Number(counts.lists ?? lists.length).toLocaleString("hu-HU"));
        setStat("groups", Number(counts.groups ?? 0).toLocaleString("hu-HU"));
        setStat("campaigns", Number(counts.campaigns ?? 0).toLocaleString("hu-HU"));
        setStat("deliveries", Number(counts.deliveries ?? 0).toLocaleString("hu-HU"));

        setDiagnosticStep("data", `${subscriberTotal.toLocaleString("hu-HU")} cím`, "success");
        showGate(`A service elérhető, ${subscriberTotal.toLocaleString("hu-HU")} cím betöltve.`, "success");
        renderListCards(lists);
        hideGate();
      } catch {
        setDiagnosticStep("data", "Nem elérhető", "error");
        showGate("A hírlevél szolgáltatás nem érhető el. A dashboard csak akkor tud teljes adatot mutatni, ha a newsletter-service fut.", "error");
      }
    };

    const validateStoredAuth = async () => {
      setDiagnosticStep("health", "Ellenőrzés...", "info");
      setDiagnosticStep("auth", "Várakozás", "neutral");
      setDiagnosticStep("data", "Várakozás", "neutral");

      try {
        const response = await fetch(`${apiBase.replace(/\/$/, "")}/health`, {
          headers: { Accept: "application/json" },
        });
        const result = await response.json().catch(() => ({}));

        if (!response.ok || !result?.ok) {
          throw new Error(result?.message || "health_failed");
        }

        setDiagnosticStep("health", "Rendben", "success");
        setDiagnosticStep("auth", adminPassword ? "Mentett belépés" : "Nincs mentett belépés", adminPassword ? "warning" : "neutral");
      } catch {
        setDiagnosticStep("health", "Nem elérhető", "error");
        setDiagnosticStep("auth", "Nem ellenőrizhető", "error");
        setDiagnosticStep("data", "Nem ellenőrizhető", "error");
        showGate("A newsletter service most nem érhető el. Valószínűleg külön el kell indítani a newsletter-service processzt.", "error");
        return;
      }

      if (!adminPassword) {
        showGate("Lépj be az /admin/ oldalon, majd ide visszatérve megjelennek a dashboard adatok.", "warning");
        return;
      }

      try {
        const response = await buildAdminFetch(apiBase, "/admin/auth", {
          method: "POST",
          headers: { Accept: "application/json" },
          body: "{}",
        });
        const result = await response.json().catch(() => ({}));

        if (!response.ok || !result?.ok) {
          throw new Error(result?.message || "auth_failed");
        }

        setDiagnosticStep("auth", "Belépve", "success");
        await fetchDashboardData();
      } catch {
        if (localAdminMode) {
          setDiagnosticStep("auth", "Helyi mód", "warning");
          await fetchDashboardData();
          return;
        }

        setDiagnosticStep("auth", "Sikertelen", "error");
        clearStoredAdminAuth();
        showGate("Az admin belépés vagy a newsletter service nincs kész. Nyisd meg az /admin/ oldalt, majd onnan jelentkezz be.", "warning");
      }
    };

    checkConnectionButton?.addEventListener("click", async () => {
      await validateStoredAuth();
    });

    refreshButton?.addEventListener("click", async () => {
      await validateStoredAuth();
    });

    validateStoredAuth();
  })();
</script>

<style>
  .admin-newsletter {
    position: relative;
    min-height: 100vh;
    padding: 28px 0 52px;
    isolation: isolate;
    background:
      radial-gradient(circle at top left, rgba(212, 173, 89, 0.16), transparent 25%),
      radial-gradient(circle at 85% 10%, rgba(104, 137, 108, 0.12), transparent 24%),
      linear-gradient(180deg, #f8f2e6 0%, #f4efdf 100%);
  }

  .admin-newsletter__backdrop {
    position: absolute;
    border-radius: 999px;
    filter: blur(18px);
    opacity: 0.5;
    pointer-events: none;
  }

  .admin-newsletter__backdrop--gold {
    top: 20px;
    right: -120px;
    width: 280px;
    height: 280px;
    background: rgba(203, 166, 93, 0.35);
  }

  .admin-newsletter__backdrop--sage {
    top: 220px;
    left: -100px;
    width: 240px;
    height: 240px;
    background: rgba(126, 150, 116, 0.24);
  }

  .admin-newsletter__gate {
    position: relative;
    z-index: 5;
    width: min(1120px, calc(100% - 32px));
    margin: 0 auto 18px;
  }

  .admin-newsletter__gate[hidden] {
    display: none;
  }

  .admin-newsletter__gate-card {
    width: 100%;
    padding: 18px 22px;
    border-radius: 22px;
    border: 1px solid rgba(92, 67, 37, 0.12);
    background: rgba(255, 252, 247, 0.9);
    box-shadow: 0 10px 26px rgba(79, 60, 34, 0.08);
    display: grid;
    gap: 14px;
  }

  .admin-newsletter__gate-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .admin-newsletter__gate-title {
    display: block;
    margin-top: 2px;
    color: #241c16;
    font-size: 1rem;
    font-weight: 600;
  }

  .admin-newsletter__eyebrow {
    margin: 0;
    color: #a57d37;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .admin-newsletter__connection-flag {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    min-height: 32px;
    padding: 0 12px;
    border-radius: 999px;
    border: 1px solid rgba(92, 67, 37, 0.12);
    background: rgba(255, 252, 247, 0.96);
    color: #5b4a39;
    font-size: 0.88rem;
    font-weight: 600;
    line-height: 1;
  }

  .admin-newsletter__connection-flag[data-tone="success"] {
    border-color: rgba(57, 123, 73, 0.18);
    background: rgba(231, 247, 232, 0.96);
    color: #1d6b37;
  }

  .admin-newsletter__connection-flag[data-tone="warning"] {
    border-color: rgba(201, 156, 59, 0.2);
    background: rgba(255, 245, 224, 0.96);
    color: #8a5a00;
  }

  .admin-newsletter__connection-flag[data-tone="error"] {
    border-color: rgba(196, 94, 94, 0.2);
    background: rgba(255, 236, 236, 0.96);
    color: #9b2c2c;
  }

  .admin-newsletter__diagnostics {
    display: grid;
    gap: 10px;
  }

  .admin-newsletter__diagnostic-row {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
  }

  .admin-newsletter__diagnostic {
    display: grid;
    gap: 6px;
    padding: 12px 14px;
    border-radius: 16px;
    border: 1px solid rgba(92, 67, 37, 0.1);
    background: rgba(255, 255, 255, 0.76);
  }

  .admin-newsletter__diagnostic span {
    color: rgba(102, 78, 42, 0.78);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .admin-newsletter__diagnostic strong {
    font-size: 0.94rem;
    line-height: 1.35;
    font-weight: 600;
  }

  .admin-newsletter__diagnostic strong[data-tone="success"] {
    color: #1d6b37;
  }

  .admin-newsletter__diagnostic strong[data-tone="warning"] {
    color: #8a5a00;
  }

  .admin-newsletter__diagnostic strong[data-tone="error"] {
    color: #9b2c2c;
  }

  .admin-newsletter__diagnostic strong[data-tone="info"] {
    color: #5b4a39;
  }

  .admin-newsletter__gate-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .admin-newsletter__gate-status {
    margin: 0;
    padding: 11px 14px;
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.82);
    color: #4c3d2e;
    border: 1px solid rgba(92, 67, 37, 0.1);
    line-height: 1.5;
    font-size: 0.95rem;
  }

  .admin-newsletter__gate-status[data-tone="success"] {
    color: #1d6b37;
    border-color: rgba(57, 123, 73, 0.18);
    background: rgba(231, 247, 232, 0.94);
  }

  .admin-newsletter__gate-status[data-tone="warning"] {
    color: #8a5a00;
    border-color: rgba(201, 156, 59, 0.2);
    background: rgba(255, 245, 224, 0.96);
  }

  .admin-newsletter__gate-status[data-tone="error"] {
    color: #9b2c2c;
    border-color: rgba(196, 94, 94, 0.2);
    background: rgba(255, 236, 236, 0.96);
  }

  .admin-newsletter__shell {
    position: relative;
    z-index: 1;
    width: 100%;
    margin: 0;
    padding-right: 18px;
    box-sizing: border-box;
    display: grid;
    grid-template-columns: minmax(260px, 300px) minmax(0, 1fr);
    gap: 22px;
    align-items: start;
  }

  .admin-newsletter__content {
    min-width: 0;
    display: grid;
    gap: 18px;
  }

  .admin-newsletter__header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 22px;
  }

  .admin-newsletter__header-copy h1 {
    margin: 8px 0 0;
    font-family: var(--dnd-font-display);
    font-size: clamp(2.2rem, 4vw, 3.7rem);
    line-height: 1;
    color: #241c16;
    font-weight: 600;
  }

  .admin-newsletter__lead {
    max-width: 820px;
    margin: 14px 0 0;
    color: #5b4a39;
    font-size: 1rem;
    line-height: 1.6;
  }

  .admin-newsletter__header-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 10px;
    flex-shrink: 0;
  }

  .admin-newsletter__button {
    min-height: 42px;
    padding: 0 16px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    color: #fff9ef;
    background: linear-gradient(135deg, #272218 0%, #6c5130 100%);
    box-shadow: 0 14px 22px rgba(63, 47, 26, 0.16);
    font-size: 0.96rem;
    font-weight: 600;
    border-radius: 18px;
    cursor: pointer;
  }

  .admin-newsletter__button--ghost {
    background: rgba(255, 252, 247, 0.9);
    color: #3f3124;
    box-shadow: inset 0 0 0 1px rgba(92, 67, 37, 0.1);
  }

  .admin-newsletter__summary {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 14px;
  }

  .admin-newsletter__metric {
    display: grid;
    gap: 10px;
    padding: 18px;
    border-radius: 22px;
    background: rgba(255, 252, 247, 0.92);
