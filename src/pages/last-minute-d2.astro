---
// [CHANGE 2026-07-11 00:00] D2 last minute landing page added with expiry-safe CTA flow and tracking-ready booking links.
import BaseLayout from "../layouts/BaseLayout.astro";
import { d2LastMinuteOffer } from "../data/last-minute/d2-last-minute";
import { toAbsoluteUrl } from "../data/site-seo";

const offer = d2LastMinuteOffer;
const pagePath = offer.canonicalPath;
const bookingHref = offer.bookingUrl;
const fallbackHref = offer.fallbackUrl;
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Főoldal",
        item: toAbsoluteUrl("/")
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "D2 last minute",
        item: toAbsoluteUrl(pagePath)
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${toAbsoluteUrl(pagePath)}#webpage`,
    url: toAbsoluteUrl(pagePath),
    name: offer.seo.title,
    description: offer.seo.description,
    inLanguage: "hu-HU",
    isPartOf: {
      "@id": `${toAbsoluteUrl("/")}#website`
    }
  }
];

const bookingTrackingAttrs = {
  "data-dnd-property": offer.tracking.property,
  "data-dnd-campaign": offer.tracking.campaign
};
---

<BaseLayout
  title={offer.seo.title}
  description={offer.seo.description}
  canonicalPath={pagePath}
  ogImage={offer.ogImage}
  ogImageAlt={offer.heroImage.alt}
  noindex={true}
  structuredData={structuredData}
  headerMode="transparent"
>
  <div class="d2-last-minute" data-last-minute-root data-offer-valid-until={offer.validUntilIso}>
    <section class="d2-last-minute__hero">
      <picture>
        <source media="(max-width: 767px)" srcset={offer.heroImage.mobile} />
        <img
          class="d2-last-minute__hero-image"
          src={offer.heroImage.desktop}
          alt={offer.heroImage.alt}
          width="1920"
          height="1280"
          decoding="async"
          fetchpriority="high"
        />
      </picture>
      <div class="d2-last-minute__hero-overlay" aria-hidden="true"></div>
      <div class="d2-last-minute__hero-content">
        <div class="dnd-container d2-last-minute__hero-inner">
          <p class="d2-last-minute__eyebrow">{offer.hero.eyebrow}</p>
          <h1>{offer.hero.title}</h1>
          <div class="d2-last-minute__hero-meta">
            <span>{offer.discountLabel}</span>
            <span>legalább {offer.minimumNights} éjszakára</span>
            <span>{offer.validUntilLabel}-ig</span>
          </div>
          <p class="d2-last-minute__lead">{offer.hero.lead}</p>
          <div class="d2-last-minute__hero-card">
            <p class="d2-last-minute__hero-card-label">Promóciós kód</p>
            <strong>{offer.promoCode}</strong>
            <p>{offer.hero.validityLabel}</p>
          </div>
          <div class="d2-last-minute__actions">
            <a
              href={bookingHref}
              class="d2-last-minute__button d2-last-minute__button--primary"
              target="_blank"
              rel="noopener noreferrer"
              data-dnd-placement="hero"
              {...bookingTrackingAttrs}
            >
              {offer.ctaLabels.hero}
            </a>
            <a href="#ajanlat" class="d2-last-minute__button d2-last-minute__button--ghost">
              Részletek
            </a>
          </div>
        </div>
      </div>
    </section>

    <section class="d2-last-minute__section d2-last-minute__section--pool-intro">
      <div class="dnd-container d2-last-minute__pool-intro-grid">
        <div class="d2-last-minute__section-head">
          <p class="d2-last-minute__eyebrow">Panorama Pool</p>
          <h2>Medencés élmény, amit rögtön látni kell</h2>
          <p>
            A D2 last minute ajánlatnál a Panorama Pool élmény fontos része a nyári hangulatnak,
            ezért ezt most közvetlenül a nyitó szakasz után is megmutatjuk.
          </p>
        </div>
        <figure class="d2-last-minute__pool-intro-image">
          <img
            src={offer.poolImage.src}
            alt={offer.poolImage.alt}
            loading="eager"
            decoding="async"
            width="1200"
            height="900"
          />
        </figure>
      </div>
    </section>

    <section id="ajanlat" class="d2-last-minute__section d2-last-minute__section--offer">
      <div class="dnd-container d2-last-minute__offer-grid">
        <div class="d2-last-minute__section-head">
          <p class="d2-last-minute__eyebrow">Ajánlat röviden</p>
          <h2>{offer.offerDetails.headline}</h2>
          <p>
            {offer.discountLabel} jár, ha legalább {offer.minimumNights} éjszakára foglalsz a Dandelion
            D2-be, és a foglalásnál használod a <strong>{offer.promoCode}</strong> kódot.
          </p>
        </div>
        <article class="d2-last-minute__offer-card">
          <ul>
            {offer.offerDetails.items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
          <p class="d2-last-minute__note">{offer.offerDetails.note}</p>
          <a
            href={bookingHref}
            class="d2-last-minute__button d2-last-minute__button--secondary"
            target="_blank"
            rel="noopener noreferrer"
            data-dnd-placement="offer"
            {...bookingTrackingAttrs}
          >
            {offer.ctaLabels.offer}
          </a>
          <figure class="d2-last-minute__offer-pool-image">
            <img
              src={offer.poolImage.src}
              alt={offer.poolImage.alt}
              loading="lazy"
              decoding="async"
              width="1200"
              height="900"
            />
          </figure>
        </article>
      </div>
    </section>

    <section class="d2-last-minute__section">
      <div class="dnd-container d2-last-minute__intro-grid">
        <div class="d2-last-minute__section-head">
          <p class="d2-last-minute__eyebrow">Miért jó választás a D2?</p>
          <h2>Nyugodt kisapáti bázis panorámával és Panorama Pool élménnyel</h2>
          <p>
            A Dandelion D2 akkor jó választás, ha a Balaton-felvidéken keresel csendes, kényelmes
            házat fedett terasszal, saját kerttel és olyan ritmussal, ahol a pihenés tényleg
            nyugodt marad.
          </p>
        </div>
        <div class="d2-last-minute__highlights">
          {offer.stayHighlights.map((item) => (
            <article>
              <p>{item}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="d2-last-minute__section d2-last-minute__section--gallery">
      <div class="dnd-container">
        <div class="d2-last-minute__section-head">
          <p class="d2-last-minute__eyebrow">Hangulat</p>
          <h2>Fedett terasz, nagy kert, világos terek</h2>
          <p>
            A D2 hangulata akkor működik igazán jól, ha egyszerre fontos a nyugodt esti pihenés, a
            családias kültéri tér és az, hogy a napközbeni programok után legyen hova visszaérni.
          </p>
        </div>
        <div class="d2-last-minute__gallery">
          {offer.teaserImages.map((image) => (
            <figure>
              <img src={image.src} alt={image.alt} loading="lazy" decoding="async" width="1200" height="900" />
            </figure>
          ))}
        </div>
      </div>
    </section>

    <section class="d2-last-minute__section">
      <div class="dnd-container d2-last-minute__ideas-grid">
        <div class="d2-last-minute__section-head">
          <p class="d2-last-minute__eyebrow">4 éjszaka, ami jól kitölthető</p>
          <h2>Mire jó ez a néhány nap a Balaton-felvidéken?</h2>
          <p>
            Nem hosszú útiterv kell hozzá, csak jó bázis. A D2-ből strand, kirándulás, borozás és
            medencés pihenés is könnyen belefér.
          </p>
        </div>
        <div class="d2-last-minute__ideas">
          {offer.ideas.map((item) => (
            <article>
              <p>{item}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="d2-last-minute__section d2-last-minute__section--closing">
      <div class="dnd-container d2-last-minute__closing-card">
        <p class="d2-last-minute__eyebrow">Foglalás</p>
        <h2>Ha a D2 illik hozzátok, most érdemes ránézni az elérhető időpontokra</h2>
        <p>
          A foglalási felületen a végleges ár és elérhetőség látható. A <strong>{offer.promoCode}</strong>{" "}
          kód {offer.validUntilLabel}-ig használható a {offer.minimumNights} éjszakás foglalásokhoz.
        </p>
        <div class="d2-last-minute__actions">
          <a
            href={bookingHref}
            class="d2-last-minute__button d2-last-minute__button--primary"
            target="_blank"
            rel="noopener noreferrer"
            data-dnd-placement="footer"
            {...bookingTrackingAttrs}
          >
            {offer.ctaLabels.footer}
          </a>
          <a href={fallbackHref} class="d2-last-minute__button d2-last-minute__button--ghost-dark">
            D2 normál oldal
          </a>
        </div>
      </div>
    </section>

    <section class="d2-last-minute__expired" data-offer-expired hidden>
      <div class="dnd-container d2-last-minute__expired-card">
        <p class="d2-last-minute__eyebrow">Az ajánlat lezárult</p>
        <h2>Ez a D2 last minute ajánlat már nem elérhető</h2>
        <p>
          A promóció lezárult, de a Dandelion D2 normál elérhetőségeit és aktuális foglalási
          lehetőségeit továbbra is meg tudod nézni.
        </p>
        <div class="d2-last-minute__actions">
          <a href={fallbackHref} class="d2-last-minute__button d2-last-minute__button--primary">
            D2 oldal megnyitása
          </a>
          <a href={bookingHref} class="d2-last-minute__button d2-last-minute__button--ghost-dark" target="_blank" rel="noopener noreferrer">
            Foglalási felület
          </a>
        </div>
      </div>
    </section>

    <div class="d2-last-minute__sticky" data-offer-sticky>
      <a
        href={bookingHref}
        class="d2-last-minute__sticky-button"
        target="_blank"
        rel="noopener noreferrer"
        data-dnd-placement="sticky"
        {...bookingTrackingAttrs}
      >
        <span>{offer.ctaLabels.sticky}</span>
        <small>{offer.discountLabel} · {offer.promoCode}</small>
      </a>
    </div>
  </div>

  <script define:vars={{ validUntilIso: offer.validUntilIso }}>
    (() => {
      const root = document.querySelector("[data-last-minute-root]");
      if (!(root instanceof HTMLElement)) {
        return;
      }

      const expiryDate = new Date(validUntilIso);
      if (Number.isNaN(expiryDate.getTime())) {
        return;
      }

      const isExpired = Date.now() > expiryDate.getTime();
      root.classList.toggle("is-expired", isExpired);

      const expiredBlock = root.querySelector("[data-offer-expired]");
      const stickyBlock = root.querySelector("[data-offer-sticky]");
      const sections = root.querySelectorAll(
        ".d2-last-minute__hero, .d2-last-minute__section"
      );

      if (expiredBlock instanceof HTMLElement) {
        expiredBlock.hidden = !isExpired;
      }

      sections.forEach((section) => {
        if (section instanceof HTMLElement) {
          section.hidden = isExpired;
        }
      });

      if (stickyBlock instanceof HTMLElement) {
        stickyBlock.hidden = isExpired;
      }
    })();
  </script>
</BaseLayout>

<style>
  .d2-last-minute {
    background: #fdfbf7;
    color: #1f2937;
  }

  .d2-last-minute__hero {
    position: relative;
    min-height: 720px;
    height: 92vh;
    overflow: hidden;
    background: #1a130d;
  }

  .d2-last-minute__hero-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .d2-last-minute__hero-overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(14, 10, 7, 0.24), rgba(14, 10, 7, 0.08) 62%, rgba(14, 10, 7, 0.04)),
      linear-gradient(180deg, rgba(14, 10, 7, 0.06), rgba(14, 10, 7, 0.32));
  }

  .d2-last-minute__hero-content {
    position: relative;
    z-index: 1;
    display: flex;
    min-height: 100%;
    align-items: center;
    color: #fffaf1;
  }

  .d2-last-minute__hero-inner {
    max-width: 1120px;
    padding-top: 134px;
  }

  .d2-last-minute__eyebrow {
    margin: 0 0 14px;
    color: #d99e2b;
    font-size: var(--dnd-text-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    line-height: 1.35;
    text-transform: uppercase;
  }

  .d2-last-minute__hero h1,
  .d2-last-minute__section-head h2,
  .d2-last-minute__closing-card h2,
  .d2-last-minute__expired-card h2 {
    margin: 0;
    font-family: var(--dnd-font-display);
    font-weight: 500;
    letter-spacing: 0;
  }

  .d2-last-minute__hero h1 {
    max-width: 11ch;
    font-size: clamp(3rem, 6vw, 5.2rem);
    line-height: 0.98;
  }

  .d2-last-minute__hero-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 22px;
  }

  .d2-last-minute__hero-meta span,
  .d2-last-minute__offer-card li {
    display: inline-flex;
    align-items: center;
    min-height: 38px;
    padding: 0 14px;
    border-radius: 999px;
    background: rgba(255, 250, 241, 0.14);
    color: #fff8ef;
    font-size: var(--dnd-text-xs);
    font-weight: 700;
    line-height: 1.2;
  }

  .d2-last-minute__lead,
  .d2-last-minute__section-head p,
  .d2-last-minute__note,
  .d2-last-minute__closing-card p,
  .d2-last-minute__expired-card p {
    margin: 0;
    font-size: var(--dnd-text-body);
    line-height: 1.7;
  }

  .d2-last-minute__lead {
    max-width: 700px;
    margin-top: 22px;
    color: rgba(255, 250, 241, 0.92);
    font-size: var(--dnd-text-lead);
  }

  .d2-last-minute__hero-card {
    max-width: 360px;
    margin-top: 28px;
    padding: 18px 20px;
    border: 1px solid rgba(255, 250, 241, 0.18);
    border-radius: 8px;
    background: rgba(255, 250, 241, 0.1);
    backdrop-filter: blur(10px);
  }

  .d2-last-minute__hero-card-label {
    margin: 0;
    color: rgba(255, 248, 239, 0.78);
    font-size: var(--dnd-text-2xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .d2-last-minute__hero-card strong {
    display: block;
    margin-top: 10px;
    color: #fffaf1;
    font-size: 1.8rem;
    line-height: 1.1;
  }

  .d2-last-minute__hero-card p:last-child {
    margin-top: 10px;
    color: rgba(255, 248, 239, 0.86);
    font-size: var(--dnd-text-sm);
    line-height: 1.5;
  }

  .d2-last-minute__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }

  .d2-last-minute__button,
  .d2-last-minute__sticky-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 50px;
    padding: 0 20px;
    border: 1px solid transparent;
    border-radius: 8px;
    font-size: var(--dnd-text-sm);
    font-weight: 700;
    line-height: 1.25;
    text-align: center;
  }

  .d2-last-minute__button--primary,
  .d2-last-minute__sticky-button {
    background: #d99e2b;
    color: #18120b;
  }

  .d2-last-minute__button--secondary {
    background: #1f2937;
    color: #fffaf1;
  }

  .d2-last-minute__button--ghost {
    border-color: rgba(255, 250, 241, 0.5);
    background: rgba(255, 250, 241, 0.1);
    color: #fffaf1;
  }

  .d2-last-minute__button--ghost-dark {
    border-color: rgba(61, 52, 40, 0.18);
    background: transparent;
    color: #3d3428;
  }

  .d2-last-minute__section {
    padding: 84px 0;
  }

  .d2-last-minute__section--offer,
  .d2-last-minute__section--gallery {
    background: #f7f2e7;
  }

  .d2-last-minute__section--pool-intro {
    padding-top: 56px;
    padding-bottom: 32px;
    background: linear-gradient(180deg, #fdfbf7, #f7f2e7);
  }

  .d2-last-minute__offer-grid,
  .d2-last-minute__intro-grid,
  .d2-last-minute__ideas-grid {
    display: grid;
    grid-template-columns: minmax(260px, 0.84fr) minmax(0, 1.16fr);
    gap: clamp(28px, 5vw, 64px);
    align-items: start;
  }

  .d2-last-minute__pool-intro-grid {
    display: grid;
    grid-template-columns: minmax(260px, 0.82fr) minmax(0, 1.18fr);
    gap: clamp(22px, 4vw, 44px);
    align-items: center;
  }

  .d2-last-minute__section-head h2,
  .d2-last-minute__closing-card h2,
  .d2-last-minute__expired-card h2 {
    color: #1f2937;
    font-size: clamp(1.95rem, 3vw, 3rem);
    line-height: 1.08;
  }

  .d2-last-minute__section-head p {
    margin-top: 16px;
    color: #4b5563;
  }

  .d2-last-minute__offer-card,
  .d2-last-minute__closing-card,
  .d2-last-minute__expired-card {
    padding: clamp(24px, 4vw, 34px);
    border: 1px solid rgba(121, 93, 48, 0.12);
    border-radius: 8px;
    background: #fffefb;
    box-shadow: 0 14px 30px rgba(80, 57, 31, 0.06);
  }

  .d2-last-minute__offer-card ul {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .d2-last-minute__offer-card li {
    min-height: 42px;
    background: rgba(36, 122, 131, 0.1);
    color: #1f5f65;
  }

  .d2-last-minute__note {
    margin-top: 18px;
    color: #4b5563;
  }

  .d2-last-minute__offer-card .d2-last-minute__button {
    margin-top: 22px;
  }

  .d2-last-minute__offer-pool-image {
    margin: 18px 0 0;
    min-height: 220px;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: 8px;
    background: #e9e0d2;
  }

  .d2-last-minute__offer-pool-image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .d2-last-minute__pool-intro-image {
    margin: 0;
    min-height: 280px;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: 8px;
    background: #e9e0d2;
    box-shadow: 0 14px 30px rgba(80, 57, 31, 0.08);
  }

  .d2-last-minute__pool-intro-image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .d2-last-minute__highlights,
  .d2-last-minute__ideas {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  .d2-last-minute__highlights article,
  .d2-last-minute__ideas article {
    padding: 18px;
    border: 1px solid rgba(121, 93, 48, 0.12);
    border-radius: 8px;
    background: #fffefb;
  }

  .d2-last-minute__highlights p,
  .d2-last-minute__ideas p {
    margin: 0;
    color: #3d3428;
    font-size: var(--dnd-text-md);
    font-weight: 600;
    line-height: 1.55;
  }

  .d2-last-minute__gallery {
    display: grid;
    grid-template-columns: 1.2fr 1fr 1fr;
    gap: 12px;
  }

  .d2-last-minute__gallery figure {
    min-height: 260px;
    margin: 0;
    overflow: hidden;
    border-radius: 8px;
    background: #e9e0d2;
  }

  .d2-last-minute__gallery figure:first-child {
    min-height: 420px;
  }

  .d2-last-minute__gallery img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .d2-last-minute__section--closing {
    padding-top: 24px;
  }

  .d2-last-minute__closing-card {
    background: linear-gradient(135deg, #1d1711, #3a2b1e);
  }

  .d2-last-minute__closing-card h2,
  .d2-last-minute__closing-card p {
    color: #fffaf1;
  }

  .d2-last-minute__closing-card p {
    margin-top: 16px;
    color: rgba(255, 250, 241, 0.84);
  }

  .d2-last-minute__expired {
    padding: 96px 0;
  }

  .d2-last-minute__expired-card {
    max-width: 860px;
    margin: 0 auto;
    text-align: center;
  }

  .d2-last-minute__expired-card p {
    margin-top: 16px;
    color: #4b5563;
  }

  .d2-last-minute__expired-card .d2-last-minute__actions {
    justify-content: center;
  }

  .d2-last-minute__sticky {
    position: sticky;
    bottom: 0;
    z-index: 30;
    display: none;
    padding: 10px 14px calc(10px + env(safe-area-inset-bottom, 0px));
    background: linear-gradient(180deg, rgba(253, 251, 247, 0), rgba(253, 251, 247, 0.94) 30%, #fdfbf7);
  }

  .d2-last-minute__sticky-button {
    display: grid;
    width: 100%;
    gap: 3px;
    padding-top: 10px;
    padding-bottom: 10px;
  }

  .d2-last-minute__sticky-button small {
    font-size: var(--dnd-text-2xs);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .d2-last-minute.is-expired .d2-last-minute__sticky {
