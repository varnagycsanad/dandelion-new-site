---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import bikingImage from "../assets/experiences/stock-bike.jpg";
import wineImage from "../assets/experiences/szent-gyorgy-hegy-szolo.jpg";
import balatonImage from "../assets/experiences/balaton-shore.jpg";
import mountainsImage from "../assets/experiences/tanuhegyek-drone-dji-20260512.jpg";

const heroVideo = "/videos/elmenyek/hero/elmenyek-hero.mp4";

const quickFacts = [
  "bringás körök és mellékutak",
  "Szent György-hegyi borhangulat",
  "közeli balatoni strandok",
  "tanúhegyes naplementék"
];

const experiences = [
  {
    eyebrow: "Aktív kikapcsolódás",
    title: "Bicikli",
    description: "Laza falukörök, panorámás szakaszok és szabadabb tempójú bringás napok.",
    highlights: ["rövid vagy egész napos program", "normál és e-bike opció"],
    image: bikingImage,
    imageAlt: "Kerékpár természetközeli környezetben",
    href: "/elmenyek/kerekpar/",
    ctaLabel: "Bringás részletek"
  },
  {
    eyebrow: "Bor és panoráma",
    title: "Szent György-hegy és Badacsony",
    description: "Pincék, borteraszok és lassú délutánok, ahol a kilátás is a program része.",
    highlights: ["hegyi pincék", "naplementés borozás"],
    image: wineImage,
    imageAlt: "Szőlősorok a Szent György-hegy környékén",
    href: "/elmenyek/bor-es-panorama/",
    ctaLabel: "Boros részletek"
  },
  {
    eyebrow: "Vízparti napok",
    title: "Balaton",
    description: "Strandok, vízi programok és balatoni esti séták könnyen elérhető közelségben.",
    highlights: ["közeli strandok", "kajak, kenu, SUP"],
    image: balatonImage,
    imageAlt: "Köves balatoni partszakasz nyári fényben",
    href: "/elmenyek/balaton/",
    ctaLabel: "Balatoni részletek"
  },
  {
    eyebrow: "Természetközeli program",
    title: "Tanúhegyek",
    description: "Rövid séták, kilátópontok és csendes túrák a Balaton-felvidék legszebb ritmusában.",
    highlights: ["panorámás kilátók", "naplementés útvonalak"],
    image: mountainsImage,
    imageAlt: "Drónkép a tanúhegyekről és a Tapolcai-medencéről",
    href: "/elmenyek/tanuhegyek/",
    ctaLabel: "Túraötletek"
  }
];

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Főoldal",
        item: "https://dandelionhouse.hu/"
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Élmények",
        item: "https://dandelionhouse.hu/elmenyek/"
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: "Élmények a Balaton-felvidéken",
    itemListElement: experiences.map((item, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: item.title,
      description: item.description,
      url: `https://dandelionhouse.hu${item.href}`
    }))
  }
];
---

<BaseLayout
  title="Élmények | Dandelion Vendégházak"
  description="Kerékpározás, boros megállók, balatoni programok és tanúhegyes kirándulások a Dandelion Vendégházak környékén."
  canonicalPath="/elmenyek/"
  structuredData={structuredData}
>
  <section class="experiences-page">
    <section class="experiences-hero">
      <video
        class="experiences-hero__video"
        src={heroVideo}
        autoplay
        muted
        loop
        playsinline
      >
        A böngésződ nem támogatja a háttérvideó lejátszását.
      </video>

      <div class="experiences-hero__overlay"></div>

      <div class="experiences-hero__content">
        <div class="dnd-container experiences-hero__inner">
          <div class="experiences-hero__headline">
            <span class="experiences-page__eyebrow">Környék és programok</span>
            <h1>Élmények a Balaton-felvidék ritmusára hangolva.</h1>
          </div>
        </div>
      </div>
    </section>

    <div class="dnd-container experiences-page__inner">
      <section class="experiences-page__intro">
        <p class="experiences-page__lead">
          Bringás napok, boros megállók, balatoni kitérők és tanúhegyes séták: válassz témát, és
          nézd meg a részleteket a saját aloldalán.
        </p>

        <div class="experiences-page__facts" aria-label="Élmény gyorsáttekintő">
          {quickFacts.map((fact) => (
            <span>{fact}</span>
          ))}
        </div>
      </section>

      <section class="experiences-page__grid" aria-label="Kiemelt élmények">
        {experiences.map((item) => (
          <article class="experience-card">
            <div class="experience-card__media">
              <Image src={item.image} alt={item.imageAlt} loading="lazy" />
            </div>

            <div class="experience-card__body">
              <span class="experience-card__eyebrow">{item.eyebrow}</span>
              <h2>{item.title}</h2>
              <p>{item.description}</p>

              <ul class="experience-card__highlights" aria-label={`${item.title} fő pontjai`}>
                {item.highlights.map((highlight) => (
                  <li>{highlight}</li>
                ))}
              </ul>

              <a class="experience-card__cta" href={item.href}>{item.ctaLabel}</a>
            </div>
          </article>
        ))}
      </section>

      <section class="experiences-page__cta-panel">
        <h2>Megvan a hangulat, jöhet a szállás?</h2>
        <p>
          Nézd meg a Dandelion házakat régiónként, és válaszd azt a helyet, ahonnan a saját
          pihenési ritmusod indul a legtermészetesebben.
        </p>
        <div class="experiences-page__cta-actions">
          <a href="/szallasok/" class="experiences-page__cta-primary">Szállások megtekintése</a>
          <a
            href="https://ibe.sabeeapp.com/v3/p/Dandelion-Vendégházak?p=3970b30e1042d58f&lang=Hu"
            class="experiences-page__cta-secondary"
            target="_blank"
            rel="noopener noreferrer"
          >
            Foglalás / Ár
          </a>
        </div>
      </section>
    </div>
  </section>
</BaseLayout>

<style>
  .experiences-page {
    padding-bottom: 88px;
    background:
      radial-gradient(circle at top left, rgba(215, 188, 127, 0.16), transparent 34%),
      linear-gradient(180deg, #fcfbf7 0%, #f6f0e7 100%);
  }

  .experiences-page__inner {
    display: grid;
    gap: 26px;
    margin-top: 28px;
  }

  .experiences-hero {
    position: relative;
    min-height: 600px;
    height: 78vh;
    overflow: hidden;
    background: #171717;
  }

  .experiences-hero__video,
  .experiences-hero__overlay {
    position: absolute;
    inset: 0;
  }

  .experiences-hero__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .experiences-hero__overlay {
    background:
      linear-gradient(90deg, rgba(16, 14, 12, 0.46) 0%, rgba(16, 14, 12, 0.18) 46%, rgba(16, 14, 12, 0.28) 100%),
      rgba(8, 7, 6, 0.12);
  }

  .experiences-hero__content {
    position: relative;
    z-index: 2;
    min-height: 100%;
    color: #fff;
  }

  .experiences-hero__inner {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: center;
    min-height: 100%;
    max-width: none;
    padding: clamp(280px, 40vh, 420px) clamp(48px, 7vw, 96px) 96px;
  }

  .experiences-hero__headline {
    display: grid;
    justify-items: center;
    gap: 14px;
    width: min(100%, 1040px);
    text-align: center;
  }

  .experiences-page__eyebrow,
  .experience-card__eyebrow {
    display: inline-block;
    color: #a56d1f;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .experiences-hero .experiences-page__eyebrow {
    color: rgba(255, 244, 223, 0.88);
  }

  .experiences-page h1,
  .experiences-page__cta-panel h2,
  .experience-card h2 {
    margin: 0;
    color: #261d16;
    font-family: "Playfair Display", Georgia, "Times New Roman", serif;
    font-weight: 500;
    line-height: 1.08;
  }

  .experiences-hero h1 {
    max-width: none;
    font-size: clamp(30px, 2.35vw, 42px);
    line-height: 1.08;
    font-weight: 400;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    white-space: nowrap;
    color: rgba(255, 255, 255, 0.92);
  }

  .experiences-page__intro,
  .experiences-page__cta-panel {
    display: grid;
    gap: 14px;
    padding: 28px;
    border: 1px solid rgba(88, 63, 38, 0.12);
    border-radius: 24px;
    background: rgba(255, 252, 246, 0.84);
    box-shadow: 0 20px 56px rgba(43, 28, 14, 0.07);
  }

  .experiences-page__lead,
  .experience-card p,
  .experiences-page__cta-panel p {
    margin: 0;
    color: rgba(38, 29, 22, 0.76);
    font-size: 1rem;
    line-height: 1.68;
  }

  .experiences-page__facts {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .experiences-page__facts span,
  .experience-card__highlights li {
    padding: 8px 11px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.9);
    border: 1px solid rgba(88, 63, 38, 0.12);
    color: rgba(38, 29, 22, 0.86);
    font-size: 0.85rem;
  }

  .experiences-page__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 18px;
    align-items: stretch;
  }

  .experience-card {
    display: grid;
    grid-template-rows: auto 1fr;
    border: 1px solid rgba(88, 63, 38, 0.12);
    border-radius: 24px;
    background: rgba(255, 255, 255, 0.92);
    overflow: hidden;
    box-shadow: 0 20px 56px rgba(43, 28, 14, 0.07);
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease,
      border-color 0.2s ease;
  }

  .experience-card:hover,
  .experience-card:focus-within {
    transform: translateY(-3px);
    box-shadow: 0 28px 64px rgba(43, 28, 14, 0.12);
    border-color: rgba(88, 63, 38, 0.22);
  }

  .experience-card__media {
    overflow: hidden;
  }

  .experience-card__media :global(picture),
  .experience-card__media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .experience-card__media :global(img) {
    aspect-ratio: 1 / 0.88;
    object-fit: cover;
  }

  .experience-card__body {
    display: grid;
    grid-template-rows: auto auto auto auto 1fr auto;
    gap: 10px;
    padding: 18px;
  }

  .experience-card h2 {
    font-size: clamp(1.06rem, 1.42vw, 1.34rem);
  }

  .experience-card p {
    font-size: 0.94rem;
    line-height: 1.54;
  }

  .experience-card__highlights {
    margin: 2px 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-self: start;
  }

  .experience-card__cta,
  .experiences-page__cta-primary,
  .experiences-page__cta-secondary {
    min-height: 46px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0 18px;
    text-decoration: none;
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    border: 1px solid rgba(65, 47, 30, 0.4);
    transition: all 0.2s ease;
  }

  .experience-card__cta {
    margin-top: 2px;
    width: 100%;
    justify-self: stretch;
    align-self: end;
    background: #2b2016;
    color: #fff;
    border-color: #2b2016;
  }

  .experience-card__cta:focus-visible {
    outline: 2px solid rgba(165, 109, 31, 0.3);
    outline-offset: 2px;
  }

  .experiences-page__cta-panel h2 {
    font-size: clamp(1.5rem, 2.3vw, 2.2rem);
  }

  .experiences-page__cta-actions {
    margin-top: 4px;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .experiences-page__cta-primary {
    background: #fff;
    color: #2b2016;
  }

  .experiences-page__cta-secondary {
    background: #2b2016;
    color: #fff;
    border-color: #2b2016;
  }

  .experiences-page__cta-primary:hover,
  .experiences-page__cta-primary:focus-visible {
    background: #f7efe2;
  }

  .experiences-page__cta-secondary:hover,
  .experiences-page__cta-secondary:focus-visible,
  .experience-card:hover .experience-card__cta,
  .experience-card:focus-within .experience-card__cta {
    background: #3a2a1d;
  }

  @media (max-width: 1100px) {
    .experiences-page__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 767px) {
    .experiences-page {
      padding-bottom: 64px;
    }

    .experiences-page__inner {
      gap: 20px;
      margin-top: 20px;
    }

    .experiences-hero {
      min-height: 500px;
      height: auto;
    }

    .experiences-hero__content {
      min-height: 500px;
    }

    .experiences-hero__inner {
      justify-content: flex-start;
      min-height: 500px;
      padding: 0;
    }

    .experiences-hero__headline {
      justify-items: start;
      margin-top: 280px;
      margin-bottom: 40px;
      width: 100%;
      max-width: 360px;
      text-align: left;
      gap: 12px;
    }

    .experiences-hero h1 {
      white-space: normal;
      font-size: clamp(1.5rem, 6.8vw, 2rem);
      line-height: 1.02;
      letter-spacing: 0.02em;
      text-transform: none;
    }

    .experiences-page__intro,
    .experiences-page__cta-panel,
    .experience-card__body {
      padding: 16px;
    }

    .experiences-page__intro,
    .experiences-page__cta-panel,
    .experience-card {
      border-radius: 18px;
    }

    .experiences-page__lead {
      font-size: 0.92rem;
      line-height: 1.56;
    }

    .experiences-page__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }

    .experience-card__media :global(img) {
      aspect-ratio: 1 / 1;
    }

    .experience-card__body {
      grid-template-rows: auto auto auto 1fr auto;
      gap: 9px;
    }

    .experience-card h2 {
      font-size: 1rem;
    }

    .experience-card p {
      font-size: 0.82rem;
      line-height: 1.42;
    }

    .experience-card__highlights {
      display: none;
    }

    .experience-card__cta {
      min-height: 40px;
      padding-inline: 12px;
      font-size: 0.62rem;
      letter-spacing: 0.08em;
    }
  }
</style>
