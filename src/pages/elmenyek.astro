---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import heroImage from "../assets/experiences/tanuhegyek-drone-dji-20260512.jpg";
import bikingImage from "../assets/experiences/stock-bike.jpg";
import wineImage from "../assets/experiences/szent-gyorgy-hegy-szolo.jpg";
import balatonImage from "../assets/experiences/balaton-shore.jpg";
import mountainsImage from "../assets/experiences/tanuhegyek-drone-dji-20260512.jpg";

const quickFacts = [
  "bringás körök és mellékutak",
  "Szent György-hegyi pincék",
  "balatoni strandok rövid úttal",
  "tanúhegyes naplementék"
];

const experiences = [
  {
    eyebrow: "Aktív kikapcsolódás",
    title: "Bicikli",
    description:
      "A Balaton-felvidék biciklivel lassabb, szabadabb és sokkal közelebbi élmény: falvak, szőlőhegyek, balatoni kitérők és panorámás szakaszok kapcsolódnak össze benne.",
    details:
      "Külön oldalon mutatjuk meg a bringás hangulatot, az útvonalötleteket és a bérlési feltételeket is.",
    highlights: [
      "rövid délutáni tekerés vagy egész napos program",
      "normál és elektromos biciklihez is jó régió",
      "bérlési részletek egy helyen"
    ],
    image: bikingImage,
    imageAlt: "Kerékpár természetes, letisztult környezetben",
    href: "/elmenyek/kerekpar/",
    ctaLabel: "Bringás oldal megnyitása"
  },
  {
    eyebrow: "Bor és panoráma",
    title: "Szent György-hegyi szőlők és badacsonyi borhangulat",
    description:
      "A Dandelion vendégházak környéke nem rohanós borkóstolós hely: itt a borhoz hozzátartozik a hegy, a kilátás, a szőlősorok és az a lassú balatoni-felvidéki hangulat, ami miatt szívesen maradna még az ember.",
    details:
      "A Szent György-hegy, Badacsony és a környező tanúhegyek kisebb pincéket, borteraszokat, családi borászatokat és szép megállókat adnak egy nyugodtabb boros programhoz.",
    highlights: [
      "Szent György-hegyi pincék és szőlősorok",
      "badacsonyi borteraszok és balatoni panoráma",
      "naplementés borozás, pároknak és baráti programnak is jó"
    ],
    image: wineImage,
    imageAlt: "Szőlősorok a Szent György-hegy környékén",
    href: "/elmenyek/bor-es-panorama/",
    ctaLabel: "Boros oldal megnyitása"
  },
  {
    eyebrow: "Vízparti könnyedség",
    title: "Balaton, strandok és vízi programok",
    description:
      "Ha vízparti napra vágytok, a Balaton könnyen elérhető: strandok, mólók, balatoni séták, naplementés vacsorák és vízi programok is jól beilleszthetők egy nyugodt, hegyvidéki pihenésbe.",
    details:
      "Délelőtt strandolás, délután egy pohár bor a hegyen, este séta Badacsonyban vagy Szigligeten - pont ez a környék nagy előnye: nem kell választani a Balaton és a Balaton-felvidék között.",
    highlights: [
      "közeli strandok rövid autóúttal",
      "Badacsony, Szigliget és Ábrahámhegy könnyen elérhető",
      "kajak, kenu, SUP és vízi programok szezonban",
      "családos naphoz, páros programhoz és esti sétához is jó"
    ],
    image: balatonImage,
    imageAlt: "Köves balatoni partszakasz tiszta vízzel és nyári fénnyel",
    accordions: [
      {
        title: "Közeli strandok és balatoni megállók",
        intro:
          "A környéken több jó strand is van, attól függően, hogy nyugodtabb családi strandot, klasszikus balatoni hangulatot vagy esti vízparti sétát kerestek.",
        sections: [
          {
            title: "Szigligeti strand",
            body:
              "Jó választás családos strandnaphoz, balatoni fürdéshez és klasszikus nyári programhoz. A nagyobb zöldfelület, a kényelmesebb kialakítás és a strandközeli egyszerű balatoni vendéglátás miatt is szerethető megálló."
          },
          {
            title: "Ábrahámhegyi strand",
            body:
              "Nyugodtabb, családbarát balatoni strandhangulat. A homokosabb, gyerekbarátabb részek és a kényelmesebb kialakítás miatt főleg családos naphoz jó irány."
          },
          {
            title: "Badacsony és Badacsonytomaj strandjai",
            body:
              "Aki a strandolást borozással, vacsorával vagy esti sétával kötné össze, annak Badacsony jó irány. Itt erősebb a klasszikus balatoni feeling: móló, hajóállomás, borteraszok, éttermek és esti nyüzsgés."
          },
          {
            title: "Badacsonylábdihegyi Herczeg Ferenc strand",
            body:
              "Kifejezetten jó kiindulópont lehet akkor is, ha a strandolást vízi programmal kötnétek össze. A helyi ajánlók alapján innen kajakos, kenus vagy SUP-os irányok is adhatják magukat."
          }
        ]
      },
      {
        title: "Kajak, kenu, SUP és csónakázás",
        intro:
          "A Balaton nem csak strandolásra jó. Ha aktívabb programot szeretnétek, a környéken szezonban kajak, kenu, SUP és egyes helyeken csónakos vízi programok is elérhetők.",
        sections: [
          {
            title: "Kajak és kenu Badacsonylábdihegyen",
            body:
              "A Badacsony környéki vízi programok egyik jó iránya Badacsonylábdihegy. A vízről Badacsony, Szigliget, a Szent György-hegy és a tanúhegyek látványa külön élmény, ezért ez több mint egyszerű eszközbérlés."
          },
          {
            title: "SUP és könnyed vízi élmény",
            body:
              "Nyugodt időben a SUP jó választás lehet azoknak, akik nem komoly túrára mennének, csak szeretnének kicsit kint lenni a vízen. Ezt inkább szélcsendes, biztonságos időben érdemes tervezni."
          },
          {
            title: "Csónakos program Badacsony környékén",
            body:
              "A motoros csónakos lehetőségeket nem érdemes fix szolgáltatásként ígérni. Inkább előzetes egyeztetéssel elérhető vízi programként kezeljük, mert szezonhoz, szolgáltatóhoz és feltételekhez kötött."
          }
        ],
        note:
          "A vízi programok szezon-, időjárás- és szolgáltatófüggők. Indulás előtt mindig érdemes ellenőrizni az aktuális nyitvatartást, árakat és bérlési feltételeket."
      },
      {
        title: "Melyik balatoni programot válasszátok?",
        sections: [
          {
            title: "Családos strandnaphoz",
            body:
              "Szigliget vagy Ábrahámhegy jó választás. Mindkettő kényelmesebb, családbarátabb irány."
          },
          {
            title: "Nyugodtabb, homokosabb gyerekes strandhoz",
            body:
              "Ábrahámhegyet emelnénk ki, főleg a gyerekbarátabb partszakasz és a kényelmesebb strandhangulat miatt."
          },
          {
            title: "Esti sétához, vacsorához, borozáshoz",
            body:
              "Badacsony a legerősebb. Itt nem csak strandolni lehet, hanem mólózni, vacsorázni, borteraszra ülni és csak nézelődni is."
          },
          {
            title: "Kajakhoz, kenuhoz, SUP-hoz",
            body:
              "Badacsonylábdihegy legyen a fő ajánlás. Itt jobban kapcsolódik össze a strandolás és a vízi program."
          }
        ]
      }
    ]
  },
  {
    eyebrow: "Természetközeli program",
    title: "Tanúhegyek, kilátások és csendes kirándulások",
    description:
      "A Balaton-felvidék egyik legnagyobb ajándéka, hogy pár perc alatt a szállástól már hegyek, szőlők, rétek, erdei utak és kilátópontok között lehettek.",
    details:
      "A Szent György-hegy, Badacsony, Gulács, Csobánc és Szigliget környéke tele van olyan helyekkel, ahol a természet, a panoráma és a balatoni-felvidéki hangulat egyszerre van jelen.",
    highlights: [
      "tanúhegyek és panorámás kilátópontok",
      "rövidebb séták és hosszabb túrák is elérhetők",
      "családos, páros és baráti programnak is jó",
      "naplementéhez különösen hangulatos"
    ],
    image: mountainsImage,
    imageAlt: "Drónkép a tanúhegyekről és a Tapolcai-medencéről",
    href: "/elmenyek/tanuhegyek/",
    ctaLabel: "Tanúhegyes oldal megnyitása"
  }
];

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Főoldal",
        item: "https://dandelionhouse.hu/"
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Élmények",
        item: "https://dandelionhouse.hu/elmenyek/"
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: "Élmények a Balaton-felvidéken",
    itemListElement: experiences.map((item, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: item.title,
      description: item.description
    }))
  }
];
---

<BaseLayout
  title="Élmények | Dandelion Vendégházak"
  description="Kerékpározás, Szent György-hegyi borélmények, balatoni programok és tanúhegyes kirándulások a Dandelion Vendégházak környékén."
  canonicalPath="/elmenyek/"
  structuredData={structuredData}
>
  <section class="experiences-page">
    <div class="dnd-container experiences-page__inner">
      <section class="experiences-hero">
        <div class="experiences-hero__media">
          <Image
            src={heroImage}
            alt="Panoráma a Tapolcai-medencére és a tanúhegyekre naplementében"
            loading="eager"
          />
        </div>

        <div class="experiences-hero__content">
          <span class="experiences-page__eyebrow">Környék és programok</span>
          <h1>Élmények a Balaton-felvidék ritmusára hangolva.</h1>
          <p class="experiences-hero__lead">
            A Dandelion környékén nem egyetlen kötelező program vár, hanem többféle jó ritmus:
            bringás napok, szőlőhegyi délutánok, balatoni kitérők és tanúhegyes túrák. Ez az oldal
            áttekintést ad, a részletesebb témák pedig külön aloldalakat kaphatnak.
          </p>

          <div class="experiences-hero__facts" aria-label="Élmény gyorsáttekintő">
            {quickFacts.map((fact) => (
              <span>{fact}</span>
            ))}
          </div>
        </div>
      </section>

      <section class="experiences-page__grid" aria-label="Kiemelt élmények">
        {experiences.map((item) => (
          <article
            class="experience-card"
            data-experience-card={item.href ? "with-link" : "static"}
          >
            <div class="experience-card__media">
              <Image src={item.image} alt={item.imageAlt} loading="lazy" />
            </div>

            <div class="experience-card__body">
              <span class="experience-card__eyebrow">{item.eyebrow}</span>
              <h2>{item.title}</h2>
              <p>{item.description}</p>
              <p class="experience-card__details">{item.details}</p>

              <ul class="experience-card__highlights">
                {item.highlights.map((highlight) => (
                  <li>{highlight}</li>
                ))}
              </ul>

              {item.accordions && (
                <div class="experience-card__accordions">
                  {item.accordions.map((accordion, index) => (
                    <details class="experience-card__accordion" open={index === 0}>
                      <summary>{accordion.title}</summary>
                      <div class="experience-card__accordion-content">
                        {accordion.intro && <p>{accordion.intro}</p>}

                        {accordion.sections.map((section) => (
                          <div class="experience-card__accordion-section">
                            <h3>{section.title}</h3>
                            <p>{section.body}</p>
                          </div>
                        ))}

                        {accordion.note && (
                          <p class="experience-card__accordion-note">{accordion.note}</p>
                        )}
                      </div>
                    </details>
                  ))}
                </div>
              )}

              {item.href && <a class="experience-card__cta" href={item.href}>{item.ctaLabel}</a>}
            </div>
          </article>
        ))}
      </section>

      <section class="experiences-page__cta-panel">
        <h2>Megvan a hangulat, jöhet a szállás?</h2>
        <p>
          Nézd meg a Dandelion házakat régiónként, és válaszd azt a helyet, ahonnan a saját pihenési
          ritmusod indul a legtermészetesebben.
        </p>
        <div class="experiences-page__cta-actions">
          <a href="/szallasok/" class="experiences-page__cta-primary">Szállások megtekintése</a>
          <a
            href="https://ibe.sabeeapp.com/v3/p/Dandelion-Vendégházak?p=3970b30e1042d58f&lang=Hu"
            class="experiences-page__cta-secondary"
            target="_blank"
            rel="noopener noreferrer"
          >
            Foglalás / Ár
          </a>
        </div>
      </section>
    </div>
  </section>
</BaseLayout>

<style>
  .experiences-page {
    padding: 124px 0 88px;
    background:
      radial-gradient(circle at top left, rgba(215, 188, 127, 0.16), transparent 34%),
      linear-gradient(180deg, #fcfbf7 0%, #f6f0e7 100%);
  }

  .experiences-page__inner {
    display: grid;
    gap: 36px;
  }

  .experiences-page__eyebrow,
  .experience-card__eyebrow {
    display: inline-block;
    color: #a56d1f;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .experiences-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(320px, 0.9fr);
    gap: 28px;
    align-items: stretch;
  }

  .experiences-hero__media,
  .experience-card__media {
    overflow: hidden;
    border-radius: 24px;
    box-shadow: 0 24px 64px rgba(43, 28, 14, 0.12);
  }

  .experiences-hero__media :global(picture),
  .experiences-hero__media :global(img),
  .experience-card__media :global(picture),
  .experience-card__media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .experiences-hero__media :global(img) {
    min-height: 100%;
    object-fit: cover;
  }

  .experiences-hero__content {
    display: grid;
    align-content: center;
    gap: 14px;
    padding: 34px;
    border: 1px solid rgba(88, 63, 38, 0.12);
    border-radius: 24px;
    background: rgba(255, 252, 246, 0.82);
    backdrop-filter: blur(6px);
  }

  .experiences-page h1,
  .experiences-page__cta-panel h2,
  .experience-card h2 {
    margin: 0;
    color: #261d16;
    font-family: "Playfair Display", Georgia, "Times New Roman", serif;
    font-weight: 500;
    line-height: 1.08;
  }

  .experiences-page h1 {
    font-size: clamp(2.5rem, 4.4vw, 4.4rem);
    max-width: 11ch;
  }

  .experiences-hero__lead,
  .experience-card p,
  .experiences-page__cta-panel p {
    margin: 0;
    color: rgba(38, 29, 22, 0.76);
    font-size: 1rem;
    line-height: 1.72;
  }

  .experiences-hero__facts {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 8px;
  }

  .experiences-hero__facts span {
    padding: 10px 14px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.88);
    border: 1px solid rgba(88, 63, 38, 0.12);
    color: rgba(38, 29, 22, 0.86);
    font-size: 0.9rem;
  }

  .experiences-page__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
  }

  .experience-card {
    display: grid;
    grid-template-rows: auto 1fr;
    border: 1px solid rgba(88, 63, 38, 0.12);
    border-radius: 24px;
    background: rgba(255, 255, 255, 0.9);
    overflow: hidden;
    box-shadow: 0 20px 56px rgba(43, 28, 14, 0.07);
  }

  .experience-card__media {
    border-radius: 0;
    box-shadow: none;
  }

  .experience-card__media :global(img) {
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }

  .experience-card__body {
    display: grid;
    gap: 12px;
    padding: 24px;
  }

  .experience-card h2 {
    font-size: clamp(1.55rem, 2vw, 2rem);
  }

  .experience-card__details {
    color: rgba(38, 29, 22, 0.64) !important;
  }

  .experience-card__highlights {
    margin: 4px 0 0;
    padding-left: 18px;
    color: rgba(38, 29, 22, 0.82);
    display: grid;
    gap: 8px;
    line-height: 1.55;
  }

  .experience-card__accordions {
    display: grid;
    gap: 12px;
    margin-top: 4px;
  }

  .experience-card__accordion {
    border: 1px solid rgba(88, 63, 38, 0.12);
    border-radius: 18px;
    background: rgba(252, 248, 241, 0.82);
    overflow: hidden;
  }

  .experience-card__accordion summary {
    cursor: pointer;
    list-style: none;
    padding: 16px 18px;
    color: #261d16;
    font-size: 0.98rem;
    font-weight: 600;
    line-height: 1.45;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .experience-card__accordion summary::-webkit-details-marker {
    display: none;
  }

  .experience-card__accordion summary::after {
    content: "+";
    flex-shrink: 0;
    color: #a56d1f;
    font-size: 1.2rem;
    line-height: 1;
  }

  .experience-card__accordion[open] summary::after {
    content: "-";
  }

  .experience-card__accordion-content {
    display: grid;
    gap: 16px;
    padding: 0 18px 18px;
  }

  .experience-card__accordion-content p {
    margin: 0;
  }

  .experience-card__accordion-section {
    display: grid;
    gap: 6px;
  }

  .experience-card__accordion-section h3 {
    margin: 0;
    color: #261d16;
    font-size: 1.02rem;
    font-weight: 600;
    line-height: 1.35;
  }

  .experience-card__accordion-note {
    padding-top: 2px;
    color: rgba(38, 29, 22, 0.66) !important;
    font-size: 0.95rem;
  }

  .experience-card__cta,
  .experiences-page__cta-primary,
  .experiences-page__cta-secondary {
    min-height: 46px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0 18px;
    text-decoration: none;
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    border: 1px solid rgba(65, 47, 30, 0.4);
    transition: all 0.2s ease;
  }

  .experience-card__cta {
    margin-top: 10px;
    justify-self: start;
    background: #2b2016;
    color: #fff;
    border-color: #2b2016;
  }

  .experience-card__cta:hover,
  .experience-card__cta:focus-visible,
  .experiences-page__cta-secondary:hover,
  .experiences-page__cta-secondary:focus-visible {
    background: #3a2a1d;
  }

  .experiences-page__cta-panel {
    border: 1px solid rgba(88, 63, 38, 0.14);
    border-radius: 24px;
    background: linear-gradient(135deg, rgba(248, 242, 231, 0.92), rgba(255, 252, 246, 0.96));
    box-shadow: 0 18px 48px rgba(48, 34, 20, 0.05);
    padding: 28px;
  }

  .experiences-page__cta-panel h2 {
    font-size: clamp(1.5rem, 2.3vw, 2.2rem);
  }

  .experiences-page__cta-actions {
    margin-top: 18px;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .experiences-page__cta-primary {
    background: #fff;
    color: #2b2016;
  }

  .experiences-page__cta-secondary {
    background: #2b2016;
    color: #fff;
    border-color: #2b2016;
  }

  .experiences-page__cta-primary:hover,
  .experiences-page__cta-primary:focus-visible {
    background: #f7efe2;
  }

  @media (max-width: 1100px) {
    .experiences-hero,
    .experiences-page__grid {
      grid-template-columns: 1fr;
    }

    .experiences-page h1 {
      max-width: 13ch;
    }
  }

  @media (max-width: 767px) {
    .experiences-page {
      padding: 106px 0 64px;
    }

    .experiences-page__inner {
      gap: 24px;
    }

    .experiences-hero__content,
    .experience-card__body,
    .experiences-page__cta-panel {
      padding: 20px;
    }

    .experiences-hero__media,
    .experience-card,
    .experiences-page__cta-panel {
      border-radius: 18px;
    }

    .experiences-page h1 {
      max-width: none;
      font-size: clamp(2.2rem, 10vw, 3.2rem);
    }
  }
</style>
