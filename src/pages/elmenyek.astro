---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import bikingImage from "../assets/accommodations/szepvolgyi/gallery/dandelion-szepvolgyi-source-001.webp";
import wineTourImage from "../assets/accommodations/szololiget/gallery/dandelion-szololiget-source-001.webp";
import balatonImage from "../assets/accommodations/royal_homes/gallery/dandelion-royal-homes-source-001.webp";
import mountainsImage from "../assets/accommodations/d2/gallery/dandelion-d2-source-005.webp";

const experiences = [
  {
    title: "Bicikli",
    description:
      "Kijelölt túraútvonalak, csendes mellékutak és balatoni panorámák várnak a Tapolcai-medence és a Káli-medence környékén.",
    details: "Fél napos és egész napos körök, tavasztól őszig ideális.",
    image: bikingImage,
    imageAlt: "Kerékpáros túra a Balaton-felvidéken"
  },
  {
    title: "Bortúra",
    description:
      "Helyi pincészetek, kóstolók és lassú esték segítenek ráhangolódni a környék boros világára.",
    details: "Kis pincészetek és panorámás teraszok, pároknak különösen jó program.",
    image: wineTourImage,
    imageAlt: "Borospohár és palack helyi kóstoló hangulatban"
  },
  {
    title: "Balaton",
    description:
      "Strand, naplemente, vízparti séták és könnyű nyári programok néhány perces autóútra a szállásoktól.",
    details: "Reggeli mólóséta, napközben strand, este naplemente.",
    image: balatonImage,
    imageAlt: "Balatoni vízpart nyári fényekkel"
  },
  {
    title: "Tanúhegyek",
    description:
      "Túraútvonalak, kilátók és csendes erdei ösvények teszik teljessé a természetközeli kikapcsolódást.",
    details: "Rövidebb családi utak és komolyabb emelkedők is elérhetők.",
    image: mountainsImage,
    imageAlt: "Tanúhegyek a Balaton-felvidéken"
  }
];

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Főoldal",
        item: "https://dandelionhouse.hu/"
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Élmények",
        item: "https://dandelionhouse.hu/elmenyek/"
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: "Élmények a Balaton-felvidéken",
    itemListElement: experiences.map((item, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: item.title,
      description: item.description
    }))
  }
];
---

<BaseLayout
  title="Élmények | Dandelion Vendégházak"
  description="Kerékpározás, bortúrák, balatoni programok és tanúhegyes kirándulások a Dandelion Vendégházak környékén."
  canonicalPath="/elmenyek/"
  structuredData={structuredData}
>
  <section class="experiences-page">
    <div class="dnd-container experiences-page__inner">
      <div class="experiences-page__hero">
        <span class="experiences-page__eyebrow">Környék és programok</span>
        <h1>Élmények a Balaton-felvidék ritmusára hangolva.</h1>
        <p>
          A Dandelion szállások környéke nem egyetlen programról szól, hanem arról, hogy minden nap
          másféle tempót választhatsz: túra, bor, vízpart vagy egyszerűen egy hosszú, csendes séta.
        </p>
      </div>

      <div class="experiences-page__grid">
        {experiences.map((item) => (
          <article class="experience-card">
            <Image src={item.image} alt={item.imageAlt} loading="lazy" />
            <div class="experience-card__body">
              <h2>{item.title}</h2>
              <p>{item.description}</p>
              <p class="experience-card__details">{item.details}</p>
            </div>
          </article>
        ))}
      </div>

      <div class="experiences-page__cta-panel">
        <h2>Megvan a program, jöhet a szállás?</h2>
        <p>
          Nézd meg a Dandelion házakat régiónként, és válaszd azt a helyszínt, ami a te pihenési ritmusodhoz illik.
        </p>
        <div class="experiences-page__cta-actions">
          <a href="/szallasok/" class="experiences-page__cta-primary">Szállások megtekintése</a>
          <a
            href="https://ibe.sabeeapp.com/v3/p/Dandelion-Vendeghazak?p=3970b30e1042d58f"
            class="experiences-page__cta-secondary"
            target="_blank"
            rel="noopener noreferrer"
          >
            Foglalás / Árak
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .experiences-page {
    padding: 132px 0 88px;
    background: #fbfaf7;
  }

  .experiences-page__inner {
    display: grid;
    gap: 32px;
  }

  .experiences-page__hero {
    max-width: 780px;
  }

  .experiences-page__eyebrow {
    display: inline-block;
    margin-bottom: 10px;
    color: #b67b20;
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .experiences-page h1 {
    margin: 0;
    color: #261d16;
    font-family: "Playfair Display", Georgia, "Times New Roman", serif;
    font-size: clamp(2.2rem, 4vw, 3.8rem);
    font-weight: 500;
    line-height: 1.05;
  }

  .experiences-page__hero p,
  .experience-card p {
    margin: 14px 0 0;
    color: rgba(38, 29, 22, 0.76);
    font-size: 1rem;
    line-height: 1.72;
  }

  .experiences-page__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 22px;
  }

  .experience-card {
    overflow: hidden;
    border: 1px solid rgba(88, 63, 38, 0.12);
    border-radius: 20px;
    background: #fff;
    box-shadow: 0 18px 48px rgba(48, 34, 20, 0.06);
  }

  .experience-card :is(img, picture) {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }

  .experience-card__body {
    padding: 22px;
  }

  .experience-card h2 {
    margin: 0;
    color: #261d16;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 1.4rem;
    font-weight: 400;
    line-height: 1.2;
  }

  .experience-card__details {
    margin-top: 8px !important;
    font-size: 0.94rem !important;
    color: rgba(38, 29, 22, 0.66) !important;
  }

  .experiences-page__cta-panel {
    border: 1px solid rgba(88, 63, 38, 0.14);
    border-radius: 20px;
    background: linear-gradient(120deg, #f8f2e7 0%, #fdfbf7 100%);
    padding: 28px;
    box-shadow: 0 18px 48px rgba(48, 34, 20, 0.05);
  }

  .experiences-page__cta-panel h2 {
    margin: 0;
    color: #261d16;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(1.4rem, 2.2vw, 2rem);
    line-height: 1.2;
    font-weight: 400;
  }

  .experiences-page__cta-panel p {
    margin: 12px 0 0;
    color: rgba(38, 29, 22, 0.78);
    max-width: 64ch;
    line-height: 1.65;
  }

  .experiences-page__cta-actions {
    margin-top: 18px;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .experiences-page__cta-primary,
  .experiences-page__cta-secondary {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0 18px;
    text-decoration: none;
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    border: 1px solid rgba(65, 47, 30, 0.4);
    transition: all 0.2s ease;
  }

  .experiences-page__cta-primary {
    background: #fff;
    color: #2b2016;
  }

  .experiences-page__cta-secondary {
    background: #2b2016;
    color: #fff;
    border-color: #2b2016;
  }

  .experiences-page__cta-primary:hover,
  .experiences-page__cta-primary:focus-visible {
    background: #f7efe2;
  }

  .experiences-page__cta-secondary:hover,
  .experiences-page__cta-secondary:focus-visible {
    background: #3a2a1d;
  }

  @media (max-width: 900px) {
    .experiences-page__grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 767px) {
    .experiences-page {
      padding: 110px 0 64px;
    }

    .experience-card {
      border-radius: 16px;
    }

    .experience-card__body {
      padding: 18px;
    }

    .experiences-page__cta-panel {
      padding: 20px;
      border-radius: 16px;
    }
  }
</style>
