---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../sections/Hero.astro";
import { panoramaPoolHero, panoramaPoolImages } from "../data/images/panorama-pool-images";
import { d1PageData } from "../data/accommodation-pages/d1";
import { d2PageData } from "../data/accommodation-pages/d2";
import { fugehazPageData } from "../data/accommodation-pages/fugehaz";
import { buildVideoObject } from "../data/video-seo";

const baseHref = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const resolveHref = (path: string) => `${baseHref}${path.replace(/^\/+/, "")}`;
const poolLandingHref = resolveHref("/kisapati-medences-szallas/");

const sortedImages = [...panoramaPoolImages].sort((a, b) => a.sortOrder - b.sortOrder);
const heroImage = sortedImages.find((image) => image.usageHint === "hero") ?? sortedImages[0];
const galleryImages = sortedImages;

const poolHeroVideos = {
  desktop: "/videos/medence/HERO/PC%20video/Medence_video_Hero_PC.mp4?v=20260521",
  mobile: "/videos/medence/HERO/Phone%20video/Medence_Hero_Phone_05-21-mobile-lite.mp4?v=20260606-mobile-lite"
};
// [CHANGE 2026-05-29 00:00] Panorama Pool video exposes a thumbnail URL through VideoObject data.
const poolVideoStructuredData = buildVideoObject({
  id: "/panorama-pool/#hero-video",
  name: "Dandelion Panorama Pool videó",
  description: "Panorama Pool hero videó a Dandelion medence és a balatoni-felvidéki kilátás bemutatásához.",
  contentUrl: poolHeroVideos.desktop,
  thumbnailUrl: panoramaPoolHero.desktop,
  uploadDate: "2026-05-21T00:00:00+02:00",
  inLanguage: "hu-HU"
});

const getStayImage = (key: "d1" | "d2" | "fugehaz") => {
  const pageDataMap = {
    d1: d1PageData,
    d2: d2PageData,
    fugehaz: fugehazPageData
  } as const;
  const pageData = pageDataMap[key];
  const fallbackTitleMap = {
    d1: "Dandelion D1 hero",
    d2: "Dandelion D2 hero",
    fugehaz: "Fügeház hero"
  } as const;

  return {
    desktopSrc: pageData.hero.mobileImagePath,
    mobileSrc: pageData.hero.mobileImagePath,
    altHu: pageData.hero.fallbackAlt,
    titleHu: fallbackTitleMap[key]
  };
};

const stays = [
  {
    title: "Dandelion D1",
    href: resolveHref("/dandelion-d1/"),
    image: getStayImage("d1"),
    description: "Panorámás domboldali pihenés a Szent György-hegy közelében, nyári medencehasználattal."
  },
  {
    title: "Dandelion D2",
    href: resolveHref("/dandelion-d2/"),
    image: getStayImage("d2"),
    description: "Kisapáti nyugalom, tágas kert és a Panorama Pool élménye 2026 nyarától."
  },
  {
    title: "Fügeház",
    href: resolveHref("/fuge/"),
    image: getStayImage("fugehaz"),
    description: "Családias, lassú nyári napokhoz, terasszal, panorámával és medencehasználattal."
  }
];

const poolGeoFaqItems = [
  {
    question: "Kik használhatják a Panorama Poolt?",
    answer: "A medencét a Dandelion D1, Dandelion D2 és a Fügeház vendégei használhatják."
  },
  {
    question: "Hol található a medence?",
    answer: "Kisapátiban, a Szent György-hegy lábánál, a házak melletti dombon."
  },
  {
    question: "Milyen kilátás nyílik a medencétől?",
    answer: "A medence környékéről a Balaton-felvidék tanúhegyei látszanak."
  },
  {
    question: "Milyen mély a medence?",
    answer: "A medence körülbelül 130 cm mély, ezért gyerekek csak felnőtt felügyelettel használhatják."
  }
];

const poolTemperatureFallback = "Hamarosan";
---

<BaseLayout
  title="Dandelion Panorama Pool | Panorámás medence a Balaton-felvidéken"
  description="2026. június 15-től panorámás domboldali medence várja a Dandelion D1, D2 és Fügeház vendégeit Kisapátiban, a Balaton-felvidéken."
  canonicalPath="/panorama-pool/"
  ogImage={panoramaPoolHero.desktop}
  ogImageAlt={heroImage.altHu}
  structuredData={poolVideoStructuredData}
>
  <section class="pool-page" data-page="panorama-pool" data-deploy-retry="english-html-alias">
    <Hero
      kicker="Panorama Pool"
      title="Panorámás medence a Szent György-hegy oldalában"
      description="2026. június 15-től a D1, D2 és Fügeház vendégei használhatják."
      ctas={[{ label: "Szállások megtekintése", href: "#pool-stays" }]}
      secondaryCtas={[{ label: "Megnézem a házakat", href: "#pool-stays" }]}
      videoSrc=""
      videoDesktopSrc={poolHeroVideos.desktop}
      videoMobileSrc={poolHeroVideos.mobile}
      posterDesktopSrc={panoramaPoolHero.desktop}
      posterMobileSrc={panoramaPoolHero.mobile}
      posterAlt={heroImage.altHu}
    >
      <aside
        slot="aside"
        class="pool-temperature pool-temperature--hero"
        data-pool-temperature
        data-endpoint="/api/pool-temperature.json"
        aria-live="polite"
      >
        <span class="pool-temperature__label">Medencevíz</span>
        <p class="pool-temperature__value" data-pool-temperature-value>{poolTemperatureFallback}</p>
        <p class="pool-temperature__air" data-pool-air-temperature hidden></p>
        <p class="pool-temperature__updated" data-pool-temperature-updated hidden></p>
      </aside>
    </Hero>

    <section class="pool-section pool-section--intro">
      <div class="dnd-container pool-shell pool-intro">
        <span class="pool-eyebrow">Nyári élmény</span>
        <h2>Nem külön extra, hanem a D1, D2 és Fügeház nyári hangulatának része.</h2>
        <p>
          A Panorama Pool a közeli házak vendégeinek készül: egy csendes, domboldali medence, ahol a fürdés,
          a kilátás és a balatoni-felvidéki ritmus természetesen kapcsolódik a szálláson töltött napokhoz.
        </p>
        <a class="pool-text-link" href={poolLandingHref}>Kisapáti medencés szállások áttekintése</a>
      </div>
    </section>

    <section class="pool-section pool-section--live">
      <div class="dnd-container pool-shell pool-live-shell">
        <div class="pool-live-panel" aria-live="polite">
          <div class="pool-section-heading pool-live-panel__heading">
            <span class="pool-eyebrow">Aktuális adatok</span>
            <h2>Panorama Pool élő állapot.</h2>
            <p>A medence és a domboldali pihenőtér aktuális adatai Home Assistant mérés alapján.</p>
          </div>

          <iframe
            class="pool-live-frame"
            src="/api/pool-live-widget.php"
            title="Panorama Pool aktuális mérések"
            loading="lazy"
          ></iframe>
        </div>

        <aside class="pool-geo-faq" aria-labelledby="pool-geo-faq-title">
          <span class="pool-eyebrow">Gyakori kérdések</span>
          <h2 id="pool-geo-faq-title">Amit a Panorama Poolról érdemes tudni.</h2>
          <div class="pool-geo-faq__list">
            {poolGeoFaqItems.map((item) => (
              <article class="pool-geo-faq__item">
                <h3>{item.question}</h3>
                <p>{item.answer}</p>
              </article>
            ))}
          </div>
        </aside>
      </div>
    </section>

    <section id="pool-stays" class="pool-section">
      <div class="dnd-container pool-shell pool-section-shell">
        <div class="pool-section-heading">
          <span class="pool-eyebrow">Elérhető szállások</span>
          <h2>A Panorama Pool ezekhez a házakhoz kapcsolódik.</h2>
          <p>
            A D1, D2 és Fügeház medencehasználatáról, családos kérdéseiről és a medence alapadatairól
            külön összefoglaló oldalt is készítettünk.
          </p>
          <a class="pool-text-link" href={poolLandingHref}>D1, D2 és Fügeház medencehasználattal</a>
        </div>
        <div class="pool-stays">
          {stays.map((stay) => (
            <article class="pool-stay-card">
              <figure class="pool-stay-card__media">
                <picture>
                  {stay.image.mobileSrc && <source media="(max-width: 767px)" srcset={stay.image.mobileSrc} />}
                  <img
                    src={stay.image.desktopSrc}
                    alt={stay.image.altHu}
                    title={stay.image.titleHu}
                    width="1600"
                    height="1200"
                    loading="lazy"
                    decoding="async"
                  />
                </picture>
              </figure>
              <div class="pool-stay-card__body">
                <h3>{stay.title}</h3>
                <p>{stay.description}</p>
                <a href={stay.href}>Oldal megnyitása</a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="pool-section">
      <div class="dnd-container pool-shell pool-section-shell">
        <div class="pool-gallery" aria-label="Panorama Pool galéria">
          {galleryImages.map((image, index) => (
            <article class="pool-gallery-card">
              <figure class="pool-gallery-card__media">
                <picture>
                  {image.mobileSrc && <source media="(max-width: 767px)" srcset={image.mobileSrc} />}
                  <img
                    src={image.src}
                    alt={image.altHu}
                    title={image.titleHu}
                    width="1800"
                    height="1350"
                    loading={index < 2 ? "eager" : "lazy"}
                    decoding="async"
                  />
                </picture>
              </figure>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="pool-section pool-section--closing">
      <div class="dnd-container pool-shell">
        <div class="pool-closing">
          <span class="pool-eyebrow">Nyári pihenés</span>
          <h2>Foglalj nyári pihenést medencehasználattal.</h2>
          <p>D1, D2 és Fügeház vendégeként 2026. június 15-től a Panorama Pool is a nyári napok része lehet.</p>
          <a href="#pool-stays" class="pool-button">Szállások megtekintése</a>
        </div>
      </div>
    </section>
  </section>

  <script is:inline>
    (() => {
      const applyPoolHeaderState = () => {
        const header = document.querySelector("[data-dnd-header]");
        if (header) {
          header.classList.toggle("is-pool-visible", window.scrollY > 12);
        }
      };

      const refreshIntervalMs = 5 * 60 * 1000;

      const updatePoolTemperature = async () => {
        const widget = document.querySelector("[data-pool-temperature]");
        const valueNode = widget ? widget.querySelector("[data-pool-temperature-value]") : null;
        const airValueNode = widget ? widget.querySelector("[data-pool-air-temperature]") : null;
        const updatedNode = widget ? widget.querySelector("[data-pool-temperature-updated]") : null;
        const endpoint = widget ? widget.getAttribute("data-endpoint") || "/api/pool-temperature.json" : "/api/pool-temperature.json";
        const fallbackText = "Hamarosan";
        const buildEndpointUrl = () => {
          const url = new URL(endpoint, window.location.href);
          url.searchParams.set("refresh", Date.now().toString());
          return url.toString();
        };
        const formatMeasurement = (value, locale, options = {}) => {
          const numericValue = typeof value === "number" || typeof value === "string" ? Number(value) : Number.NaN;
          if (!Number.isFinite(numericValue)) return "";

          return numericValue.toLocaleString(locale, {
            minimumFractionDigits: 1,
            maximumFractionDigits: 1,
            ...options
          });
        };

        try {
          const response = await fetch(buildEndpointUrl(), {
            headers: { Accept: "application/json" },
            cache: "no-store"
          });

          if (!response.ok) {
            throw new Error("Pool temperature is unavailable.");
          }

          const data = await response.json();
          const rawTemperature = data.temperature;
          const temperature =
            typeof rawTemperature === "number" || typeof rawTemperature === "string" ? Number(rawTemperature) : Number.NaN;

          if (!Number.isFinite(temperature)) {
            throw new Error("Pool temperature is invalid.");
          }

          const unit = typeof data.unit === "string" && data.unit.trim() ? data.unit.trim() : "°C";
          const rawAirTemperature =
            data.airTemperature !== undefined && data.airTemperature !== null
              ? data.airTemperature
              : data.air_temperature !== undefined && data.air_temperature !== null
                ? data.air_temperature
                : data.outdoorTemperature;
          const airTemperature =
            typeof rawAirTemperature === "number" || typeof rawAirTemperature === "string"
              ? Number(rawAirTemperature)
              : Number.NaN;
          const airUnit = typeof data.airUnit === "string" && data.airUnit.trim() ? data.airUnit.trim() : unit;
          const formattedTemperature = formatMeasurement(temperature, "hu-HU");
          const formattedAirTemperature = formatMeasurement(airTemperature, "hu-HU");
          const updatedAt = typeof data.updatedAt === "string" ? new Date(data.updatedAt) : null;
          const hasValidUpdatedAt = Boolean(updatedAt && !Number.isNaN(updatedAt.getTime()));

          if (widget) {
            widget.classList.add("has-temperature");
          }
          if (valueNode) {
            valueNode.textContent = `${formattedTemperature} ${unit}`;
          }
          if (Number.isFinite(airTemperature)) {
            if (widget) {
              widget.classList.add("has-air-temperature");
            }
            if (airValueNode) {
              airValueNode.textContent = `Levegő: ${formattedAirTemperature} ${airUnit}`;
              airValueNode.removeAttribute("hidden");
            }
          } else {
            if (widget) {
              widget.classList.remove("has-air-temperature");
            }
            if (airValueNode) {
              airValueNode.setAttribute("hidden", "");
            }
          }

          if (updatedNode) {
            if (hasValidUpdatedAt) {
              const updatedText = `Frissítve: ${updatedAt.toLocaleTimeString("hu-HU", {
                hour: "2-digit",
                minute: "2-digit"
              })}`;
              updatedNode.textContent = updatedText;
              updatedNode.removeAttribute("hidden");
            } else {
              updatedNode.setAttribute("hidden", "");
            }
          }
        } catch {
          if (widget) {
            widget.classList.remove("has-temperature");
            widget.classList.remove("has-air-temperature");
          }
          if (valueNode) valueNode.textContent = fallbackText;
          if (airValueNode) {
            airValueNode.setAttribute("hidden", "");
          }
          if (updatedNode) {
            updatedNode.setAttribute("hidden", "");
          }
        }
      };

      if (document.readyState === "loading") {
        document.addEventListener(
          "DOMContentLoaded",
          () => {
            applyPoolHeaderState();
            updatePoolTemperature();
            window.setInterval(updatePoolTemperature, refreshIntervalMs);
            window.addEventListener("scroll", applyPoolHeaderState, { passive: true });
          },
          { once: true }
        );
      } else {
        applyPoolHeaderState();
        updatePoolTemperature();
        window.setInterval(updatePoolTemperature, refreshIntervalMs);
        window.addEventListener("scroll", applyPoolHeaderState, { passive: true });
      }
    })();
  </script>
</BaseLayout>

<style>
  :global(.dnd-header.is-pool-visible) {
    background: rgba(239, 228, 211, 0.94);
    border-bottom: 1px solid rgba(111, 87, 59, 0.1);
    box-shadow: 0 14px 34px rgba(79, 52, 29, 0.08);
    color: #2d241c;
    backdrop-filter: blur(12px);
  }

  :global(.dnd-header.is-pool-visible .dnd-logo img) {
    filter: none;
  }

  :global(.dnd-header.is-pool-visible .dnd-header__contact a) {
    border-color: rgba(94, 65, 39, 0.18);
    background: rgba(255, 252, 246, 0.22);
  }

  :global(.dnd-header.is-pool-visible .dnd-header__contact a:hover),
  :global(.dnd-header.is-pool-visible .dnd-header__contact a:focus-visible) {
    border-color: rgba(94, 65, 39, 0.36);
    background: rgba(255, 252, 246, 0.56);
  }

  :global(.dnd-header.is-pool-visible .dnd-nav) {
    border-top-color: rgba(94, 65, 39, 0.12);
  }

  :global(.dnd-header.is-pool-visible .dnd-header-cta) {
    border-color: rgba(94, 65, 39, 0.16);
    background: rgba(255, 252, 246, 0.46);
  }

  .pool-page {
    overflow-x: clip;
    background: #fdfbf7;
    color: #2e241b;
  }

  .pool-page :global(.dnd-hero) {
    min-height: 680px;
    height: 92vh;
  }

  .pool-page :global(.dnd-hero__inner) {
    display: grid;
    grid-template-columns: minmax(280px, 0.82fr) minmax(220px, 0.42fr);
    gap: clamp(28px, 6vw, 92px);
    align-items: end;
    justify-content: space-between;
    padding: 190px clamp(36px, 7vw, 104px) clamp(74px, 12vh, 128px);
  }

  .pool-page :global(.dnd-hero__text) {
    align-items: flex-start;
    width: min(100%, 620px);
    text-align: left;
    text-shadow: 0 2px 18px rgba(22, 17, 12, 0.28);
  }

  .pool-page :global(.dnd-hero__title) {
    max-width: 14ch;
    font-size: clamp(1.7rem, 2.35vw, 2.6rem);
    line-height: 1.16;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-weight: 400;
    text-wrap: balance;
    white-space: normal;
  }

  .pool-page :global(.dnd-hero__desc) {
    max-width: 36ch;
    margin-left: 0;
    text-align: left;
  }

  .pool-page :global(.dnd-hero__cta) {
    justify-content: flex-start;
  }

  .pool-page :global(.dnd-hero__aside) {
    display: flex;
    justify-content: flex-end;
    width: auto;
  }

  .pool-shell {
    max-width: 1120px;
  }

  .pool-section {
    padding: 72px 0;
  }

  .pool-section--intro {
    padding-top: 64px;
    padding-bottom: 48px;
  }

  .pool-section--closing {
    padding-top: 24px;
    padding-bottom: 88px;
  }

  .pool-section-shell {
    display: grid;
    gap: 24px;
  }

  .pool-eyebrow {
    display: inline-block;
    margin-bottom: 10px;
    color: #9c7a34;
    font-size: var(--dnd-text-2xs);
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .pool-intro {
    max-width: 790px;
  }

  .pool-intro h2,
  .pool-section-heading h2,
  .pool-closing h2 {
    margin: 0;
    color: #2a2017;
    font-family: var(--dnd-font-display);
    font-size: clamp(1.45rem, 2vw, 2.25rem);
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-wrap: balance;
  }

  .pool-intro p,
  .pool-section-heading p,
  .pool-stay-card p,
  .pool-closing p {
    margin: 0;
    color: rgba(46, 36, 27, 0.76);
    font-size: var(--dnd-text-body);
    line-height: 1.72;
  }

  .pool-intro p {
    max-width: 64ch;
    margin-top: 16px;
  }

  .pool-section-heading {
    max-width: 720px;
  }

  .pool-section-heading p {
    margin-top: 12px;
  }

  .pool-text-link {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    margin-top: 16px;
    color: #8b6318;
    font-size: var(--dnd-text-xs);
    font-weight: 750;
    letter-spacing: 0.05em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .pool-text-link::after {
    content: "→";
    margin-left: 8px;
    font-size: var(--dnd-text-body);
    line-height: 1;
  }

  .pool-temperature {
    display: grid;
    gap: 8px;
    place-items: center;
    width: clamp(188px, 18vw, 270px);
    aspect-ratio: 1;
    padding: 26px;
    border: 1px solid rgba(126, 88, 34, 0.24);
    border-radius: 50%;
    background:
      radial-gradient(circle at 32% 24%, rgba(255, 255, 255, 0.98), rgba(250, 244, 234, 0.86) 48%, rgba(221, 194, 140, 0.78)),
      #f8efe0;
    box-shadow:
      0 22px 58px rgba(45, 30, 15, 0.18),
      inset 0 0 0 10px rgba(255, 255, 255, 0.26),
      inset 0 0 0 1px rgba(122, 86, 38, 0.18);
    text-align: center;
  }

  .pool-temperature__label {
    color: #9c7a34;
    font-size: var(--dnd-text-2xs);
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .pool-temperature__value {
    margin: 0;
    color: #2e241b;
    font-family: var(--dnd-font-display);
    font-size: clamp(1.1rem, 1.7vw, 1.48rem);
    font-weight: 400;
    line-height: 1.08;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    text-wrap: balance;
  }

  .pool-temperature.has-temperature .pool-temperature__value {
    font-size: clamp(2rem, 3.35vw, 3rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.02em;
  }

  .pool-temperature__updated {
    margin: 0;
    color: rgba(46, 36, 27, 0.66);
    font-size: var(--dnd-text-sm);
    line-height: 1.45;
  }

  .pool-temperature__air {
    margin: 0;
    color: rgba(46, 36, 27, 0.74);
    font-size: var(--dnd-text-sm);
    font-weight: 650;
    line-height: 1.3;
  }

  .pool-section--live {
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.82), rgba(248, 245, 239, 0.96)),
      #f8f5ef;
  }

  .pool-live-shell {
    display: grid;
    grid-template-columns: minmax(0, 1.28fr) minmax(360px, 0.72fr);
    gap: 28px;
    align-items: start;
  }

  .pool-live-panel,
  .pool-geo-faq {
    border: 1px solid rgba(90, 67, 41, 0.12);
    border-radius: 8px;
    background: #fff;
    box-shadow: 0 22px 52px rgba(64, 45, 27, 0.07);
  }

  .pool-live-panel {
    padding: 28px;
  }

  .pool-live-panel__heading {
    max-width: 680px;
  }

  .pool-live-frame {
    display: block;
    width: 100%;
    height: 218px;
    margin-top: 24px;
    border: 0;
    background: transparent;
  }

  .pool-geo-faq {
    display: grid;
    align-content: start;
    gap: 16px;
    padding: 28px;
  }

  .pool-geo-faq h2 {
    margin: 0;
    color: #241b14;
    font-family: var(--dnd-font-display);
    font-size: clamp(1.5rem, 2.25vw, 2.1rem);
    font-weight: 400;
    line-height: 1.12;
  }

  .pool-geo-faq__list {
    display: grid;
    gap: 12px;
    margin-top: 6px;
  }

  .pool-geo-faq__item {
    padding-top: 14px;
    border-top: 1px solid rgba(90, 67, 41, 0.12);
  }

  .pool-geo-faq__item h3 {
    margin: 0;
