---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../sections/Hero.astro";
import { panoramaPoolImages } from "../data/images/panorama-pool-images";

const baseHref = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const resolveHref = (path: string) => `${baseHref}${path.replace(/^\/+/, "")}`;

const sortedImages = [...panoramaPoolImages].sort((a, b) => a.sortOrder - b.sortOrder);
const heroImage = sortedImages.find((image) => image.usageHint === "hero") ?? sortedImages[0];
const galleryImages = sortedImages.slice(0, 6);
const mainImageCaptionId = "panorama-pool-main-image-caption";

const poolHeroVideos = {
  desktop: "",
  mobile: ""
};

const stays = [
  {
    title: "Dandelion D1",
    href: resolveHref("/dandelion-d1/"),
    description: "Panorámás domboldali pihenés a Szent György-hegy közelében, nyári medencehasználattal."
  },
  {
    title: "Dandelion D2",
    href: resolveHref("/dandelion-d2/"),
    description: "Kisapáti nyugalom, tágas kert és a közös Panorama Pool élménye 2026 nyarától."
  },
  {
    title: "Fügeház",
    href: resolveHref("/fuge/"),
    description: "Családias, lassú nyári napokhoz, terasszal, panorámával és medencehasználattal."
  }
];

const poolFacts = [
  "panorámás domboldali elhelyezkedés",
  "sóbontós vízkezelés",
  "fedhető kialakítás",
  "D1, D2 és Fügeház vendégeinek",
  "2026. június 1-től"
];
---

<BaseLayout
  title="Dandelion Panorama Pool | Panorámás medence a Balaton-felvidéken"
  description="2026. június 1-től panorámás domboldali medence várja a Dandelion D1, D2 és Fügeház vendégeit Kisapátiban, a Balaton-felvidéken."
  canonicalPath="/panorama-pool/"
  ogImage={heroImage.src}
  ogImageAlt={heroImage.altHu}
>
  <section class="pool-page">
    <Hero
      kicker="Panorama Pool"
      title="Panorámás medence a Szent György-hegy oldalában"
      description="2026. június 1-től a D1, D2 és Fügeház vendégei használhatják."
      ctas={[{ label: "Szállások megtekintése", href: "#pool-stays" }]}
      secondaryCtas={[{ label: "Megnézem a házakat", href: "#pool-stays" }]}
      videoSrc=""
      videoDesktopSrc={poolHeroVideos.desktop}
      videoMobileSrc={poolHeroVideos.mobile}
      posterSrc={heroImage.src}
      posterAlt={heroImage.altHu}
      overlay
    />

    <section class="pool-section pool-section--intro">
      <div class="dnd-container pool-shell pool-intro">
        <span class="pool-eyebrow">Nyári élmény</span>
        <h2>Nem külön extra, hanem a D1, D2 és Fügeház nyári hangulatának része.</h2>
        <p>
          A Panorama Pool a közeli házak vendégeinek készül: egy csendes, domboldali medence, ahol a fürdés,
          a kilátás és a balatoni-felvidéki ritmus természetesen kapcsolódik a szálláson töltött napokhoz.
        </p>
      </div>
    </section>

    <section class="pool-section">
      <div class="dnd-container pool-shell pool-section-shell">
        <div class="pool-section-heading">
          <span class="pool-eyebrow">Alapadatok</span>
          <h2>A medence röviden.</h2>
        </div>

        <ul class="pool-facts" aria-label="Panorama Pool alapadatok">
          {poolFacts.map((fact) => (
            <li>{fact}</li>
          ))}
        </ul>
      </div>
    </section>

    <section id="pool-stays" class="pool-section">
      <div class="dnd-container pool-shell pool-section-shell">
        <div class="pool-section-heading">
          <span class="pool-eyebrow">Elérhető szállások</span>
          <h2>A Panorama Pool ezekhez a házakhoz kapcsolódik.</h2>
        </div>

        <div class="pool-stays">
          {stays.map((stay) => (
            <article class="pool-stay-card">
              <h3>{stay.title}</h3>
              <p>{stay.description}</p>
              <a href={stay.href}>Oldal megnyitása</a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="pool-section">
      <div class="dnd-container pool-shell pool-section-shell">
        <div class="pool-section-heading">
          <span class="pool-eyebrow">Galéria</span>
          <h2>Pillanatok a készülő medencetérből.</h2>
          <p>
            A hero után csak egy rövid válogatás marad: a meglévő medenceképek mutatják a panorámát,
            a fedhető kialakítást és a domboldali környezetet.
          </p>
        </div>

        <div class="pool-gallery" data-pool-gallery>
          <figure class="pool-gallery__main">
            <img
              id="pool-gallery-main-image"
              src={heroImage.src}
              alt={heroImage.altHu}
              title={heroImage.titleHu}
              width="1800"
              height="1350"
              loading="lazy"
              decoding="async"
              data-default-src={heroImage.src}
              data-default-alt={heroImage.altHu}
              data-default-title={heroImage.titleHu}
            />
            <figcaption>
              <span id={mainImageCaptionId}>{heroImage.captionHu}</span>
            </figcaption>
          </figure>

          <div class="pool-gallery__thumbs" role="list" aria-label="Panorama Pool képek">
            {galleryImages.map((image, index) => (
              <button
                type="button"
                class={`pool-thumb${image.id === heroImage.id ? " is-active" : ""}`}
                aria-pressed={image.id === heroImage.id ? "true" : "false"}
                aria-label={image.titleHu}
                data-gallery-thumb
                data-src={image.src}
                data-alt={image.altHu}
                data-title={image.titleHu}
                data-caption={image.captionHu}
              >
                <img
                  src={image.thumb}
                  alt={image.altHu}
                  title={image.titleHu}
                  width="600"
                  height="450"
                  loading={index < 2 ? "eager" : "lazy"}
                  decoding="async"
                />
              </button>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="pool-section pool-section--closing">
      <div class="dnd-container pool-shell">
        <div class="pool-closing">
          <span class="pool-eyebrow">Nyári pihenés</span>
          <h2>Foglalj nyári pihenést medencehasználattal.</h2>
          <p>D1, D2 és Fügeház vendégeként 2026. június 1-től a Panorama Pool is a nyári napok része lehet.</p>
          <a href="#pool-stays" class="pool-button">Szállások megtekintése</a>
        </div>
      </div>
    </section>
  </section>

  <script define:vars={{ mainImageCaptionId }}>
    (() => {
      const gallery = document.querySelector("[data-pool-gallery]");
      if (!gallery) return;

      const mainImage = gallery.querySelector("#pool-gallery-main-image");
      const captionNode = document.getElementById(mainImageCaptionId);
      const thumbs = Array.from(gallery.querySelectorAll("[data-gallery-thumb]"));

      if (!mainImage || !captionNode || thumbs.length === 0) return;

      thumbs.forEach((thumb) => {
        thumb.addEventListener("click", () => {
          const src = thumb.getAttribute("data-src") || mainImage.getAttribute("data-default-src") || "";
          const alt = thumb.getAttribute("data-alt") || mainImage.getAttribute("data-default-alt") || "";
          const title = thumb.getAttribute("data-title") || "";
          const caption = thumb.getAttribute("data-caption") || "";

          mainImage.setAttribute("src", src);
          mainImage.setAttribute("alt", alt);
          mainImage.setAttribute("title", title);
          captionNode.textContent = caption;

          thumbs.forEach((item) => {
            item.classList.remove("is-active");
            item.setAttribute("aria-pressed", "false");
          });

          thumb.classList.add("is-active");
          thumb.setAttribute("aria-pressed", "true");
        });
      });
    })();
  </script>

  <script>
    (() => {
      const applyPoolHeaderState = () => {
        const header = document.querySelector("[data-dnd-header]");
        if (header) {
          header.classList.add("is-pool-visible");
        }
      };

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", applyPoolHeaderState, { once: true });
      } else {
        applyPoolHeaderState();
      }
    })();
  </script>
</BaseLayout>

<style>
  :global(.dnd-header.is-pool-visible) {
    background: rgba(239, 228, 211, 0.94);
    border-bottom: 1px solid rgba(111, 87, 59, 0.1);
    box-shadow: 0 14px 34px rgba(79, 52, 29, 0.08);
    color: #2d241c;
    backdrop-filter: blur(12px);
  }

  :global(.dnd-header.is-pool-visible .dnd-logo img) {
    filter: none;
  }

  :global(.dnd-header.is-pool-visible .dnd-header__contact a) {
    border-color: rgba(94, 65, 39, 0.18);
    background: rgba(255, 252, 246, 0.22);
  }

  :global(.dnd-header.is-pool-visible .dnd-header__contact a:hover),
  :global(.dnd-header.is-pool-visible .dnd-header__contact a:focus-visible) {
    border-color: rgba(94, 65, 39, 0.36);
    background: rgba(255, 252, 246, 0.56);
  }

  :global(.dnd-header.is-pool-visible .dnd-nav) {
    border-top-color: rgba(94, 65, 39, 0.12);
  }

  :global(.dnd-header.is-pool-visible .dnd-header-cta) {
    border-color: rgba(94, 65, 39, 0.16);
    background: rgba(255, 252, 246, 0.46);
  }

  .pool-page {
    overflow-x: clip;
    background: #fdfbf7;
    color: #2e241b;
  }

  .pool-page :global(.dnd-hero) {
    min-height: 680px;
    height: 92vh;
  }

  .pool-page :global(.dnd-hero__inner) {
    justify-content: flex-end;
    padding-top: 180px;
    padding-bottom: clamp(90px, 15vh, 150px);
  }

  .pool-page :global(.dnd-hero__text) {
    width: min(100%, 860px);
  }

  .pool-page :global(.dnd-hero__title) {
    max-width: 18ch;
    font-size: clamp(2.75rem, 5.4vw, 5.9rem);
    line-height: 0.98;
    letter-spacing: 0.02em;
    text-transform: none;
    text-wrap: balance;
    white-space: normal;
  }

  .pool-page :global(.dnd-hero__desc) {
    max-width: 44ch;
  }

  .pool-shell {
    max-width: 1120px;
  }

  .pool-section {
    padding: 72px 0;
  }

  .pool-section--intro {
    padding-top: 64px;
    padding-bottom: 48px;
  }

  .pool-section--closing {
    padding-top: 24px;
    padding-bottom: 88px;
  }

  .pool-section-shell {
    display: grid;
    gap: 24px;
  }

  .pool-eyebrow {
    display: inline-block;
    margin-bottom: 10px;
    color: #9c7a34;
    font-size: var(--dnd-text-2xs);
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .pool-intro {
    max-width: 790px;
  }

  .pool-intro h2,
  .pool-section-heading h2,
  .pool-closing h2 {
    margin: 0;
    color: #2a2017;
    font-family: var(--dnd-font-display);
    font-size: clamp(2rem, 3.2vw, 3.55rem);
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: var(--dnd-tracking-display-tight);
    text-wrap: balance;
  }

  .pool-intro p,
  .pool-section-heading p,
  .pool-stay-card p,
  .pool-closing p {
    margin: 0;
    color: rgba(46, 36, 27, 0.76);
    font-size: var(--dnd-text-body);
    line-height: 1.72;
  }

  .pool-intro p {
    max-width: 64ch;
    margin-top: 16px;
  }

  .pool-section-heading {
    max-width: 720px;
  }

  .pool-section-heading p {
    margin-top: 12px;
  }

  .pool-facts {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pool-facts li,
  .pool-stay-card,
  .pool-closing {
    border: 1px solid rgba(90, 67, 41, 0.12);
    border-radius: 8px;
    background: #fff;
    box-shadow: 0 18px 44px rgba(64, 45, 27, 0.06);
  }

  .pool-facts li {
    display: flex;
    min-height: 118px;
    align-items: flex-end;
    padding: 18px;
    color: #443527;
    font-weight: 600;
    line-height: 1.35;
  }

  .pool-stays {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }

  .pool-stay-card {
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: 12px;
    min-height: 212px;
    padding: 22px 20px;
  }

  .pool-stay-card h3 {
    margin: 0;
    color: #241b14;
    font-size: 1.2rem;
    font-weight: 600;
    line-height: 1.2;
  }

  .pool-stay-card a {
    color: #8b6318;
    font-size: var(--dnd-text-body);
    font-weight: 600;
    text-decoration: none;
  }

  .pool-gallery {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(220px, 0.75fr);
    gap: 16px;
    align-items: stretch;
  }

  .pool-gallery__main {
    overflow: hidden;
    border: 1px solid rgba(90, 67, 41, 0.12);
    border-radius: 8px;
    background: #fbf7ef;
  }

  .pool-gallery__main img {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }

  .pool-gallery__main figcaption {
    padding: 12px 14px 14px;
    color: rgba(46, 36, 27, 0.68);
    font-size: var(--dnd-text-sm);
    line-height: 1.5;
  }

  .pool-gallery__thumbs {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
  }

  .pool-thumb {
    overflow: hidden;
    min-width: 0;
    padding: 0;
    border: 1px solid rgba(90, 67, 41, 0.12);
    border-radius: 8px;
    background: #fff;
    box-shadow: 0 12px 28px rgba(64, 45, 27, 0.04);
    cursor: pointer;
    transition: border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
  }

  .pool-thumb:hover,
  .pool-thumb.is-active {
    border-color: rgba(217, 158, 43, 0.45);
    box-shadow: 0 18px 34px rgba(64, 45, 27, 0.08);
    transform: translateY(-1px);
  }

  .pool-thumb img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .pool-closing {
    display: grid;
    gap: 14px;
    justify-items: center;
    padding: 28px 24px 32px;
    text-align: center;
  }

  .pool-button {
    display: inline-flex;
    min-height: 46px;
    margin-top: 4px;
    padding: 0 22px;
    border-radius: 8px;
    align-items: center;
    justify-content: center;
    background: #d99e2b;
    color: #1f170f;
    font-size: var(--dnd-text-body);
    font-weight: 600;
    text-decoration: none;
    transition: background 0.2s ease, transform 0.2s ease;
  }

  .pool-button:hover {
    background: #cb901f;
    transform: translateY(-1px);
  }

  @media (max-width: 980px) {
    .pool-facts,
    .pool-stays,
    .pool-gallery {
      grid-template-columns: 1fr;
    }

    .pool-facts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 767px) {
    .pool-page :global(.dnd-hero) {
      min-height: max(660px, 92svh);
      height: auto;
    }

    .pool-page :global(.dnd-hero__content),
    .pool-page :global(.dnd-hero__inner) {
      min-height: max(660px, 92svh);
    }

    .pool-page :global(.dnd-hero__inner) {
      padding: 0 18px 44px;
    }

    .pool-page :global(.dnd-hero__text) {
      max-width: 350px;
    }

    .pool-page :global(.dnd-hero__title) {
      max-width: 12ch;
      font-size: clamp(2.3rem, 11vw, 3.55rem);
      line-height: 0.98;
    }

    .pool-page :global(.dnd-hero__desc) {
      max-width: 28ch;
      color: rgba(255, 255, 255, 0.84);
    }

    .pool-page :global(.dnd-hero__cta .dnd-btn) {
      width: auto;
      min-width: 0;
    }

    .pool-section {
      padding: 52px 0;
    }

    .pool-section--intro {
      padding-top: 46px;
    }

    .pool-section--closing {
      padding-top: 14px;
      padding-bottom: 72px;
    }

    .pool-intro h2,
    .pool-section-heading h2,
    .pool-closing h2 {
      font-size: clamp(1.85rem, 8vw, 2.5rem);
    }

    .pool-facts {
      grid-template-columns: 1fr;
    }

    .pool-facts li {
      min-height: 74px;
      padding: 16px;
    }

    .pool-gallery__thumbs {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .pool-gallery__main img {
      aspect-ratio: 4 / 3;
    }

    .pool-stay-card,
    .pool-closing {
      padding: 20px;
    }
  }
</style>
