---
import BaseLayout from "../layouts/BaseLayout.astro";
import { panoramaPoolImages } from "../data/images/panorama-pool-images";

const baseHref = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const resolveHref = (path: string) => `${baseHref}${path.replace(/^\/+/, "")}`;

const sortedImages = [...panoramaPoolImages].sort((a, b) => a.sortOrder - b.sortOrder);
const heroImage = sortedImages.find((image) => image.usageHint === "hero") ?? sortedImages[0];
const galleryImages = sortedImages;
const mainImageTitleId = "panorama-pool-main-image-title";
const mainImageCaptionId = "panorama-pool-main-image-caption";

const stays = [
  {
    title: "Dandelion D1",
    href: resolveHref("/dandelion-d1/"),
    description: "Ha egy nyugodt, panorámás nyári pihenést keresel, innen a medence is a nap része lesz."
  },
  {
    title: "Dandelion D2",
    href: resolveHref("/dandelion-d2/"),
    description: "Kisapáti hangulata és a domboldali medence együtt adják meg ennek a háznak a nyári ritmusát."
  },
  {
    title: "Fügeház",
    href: resolveHref("/fuge/"),
    description: "Lassabb napokhoz, csendes estékhez és balatoni-felvidéki nyárhoz a Panorama Pool is hozzátartozik majd."
  }
];
---

<BaseLayout
  title="Dandelion Panorama Pool – panorámás medence a Balaton-felvidéken"
  description="Június 1-től új panorámás domboldali medence várja a Dandelion D1, D2 és Fügeház vendégeit Kisapátiban, a Balaton-felvidéken."
  canonicalPath="/panorama-pool/"
  ogImage={heroImage.src}
  ogImageAlt={heroImage.altHu}
>
  <section class="pool-page">
    <section class="pool-section pool-section--hero">
      <div class="dnd-container pool-shell pool-hero">
        <div class="pool-hero__content">
          <span class="pool-eyebrow">Panorama Pool</span>
          <h1>Dandelion Panorama Pool</h1>
          <p class="pool-hero__lead">Új panorámás medence a Balaton-felvidék tanúhegyei között.</p>
          <p class="pool-hero__text">
            Június 1-től a D1, D2 és Fügeház vendégei használhatják új domboldali medencénket Kisapátiban.
          </p>
          <a href="#pool-stays" class="pool-button">Szállások megtekintése</a>
        </div>

        <figure class="pool-hero__media">
          <img
            src={heroImage.src}
            alt={heroImage.altHu}
            title={heroImage.titleHu}
            width="1800"
            height="1350"
            loading="eager"
            decoding="async"
          />
          <figcaption>{heroImage.captionHu}</figcaption>
        </figure>
      </div>
    </section>

    <section class="pool-section">
      <div class="dnd-container pool-shell pool-section-shell">
        <div class="pool-section-heading">
          <span class="pool-eyebrow">Bemutató</span>
          <h2>Medence a tanúhegyek között.</h2>
        </div>

        <div class="pool-intro">
          <div class="pool-intro__copy">
            <p>
              A Dandelion Panorama Pool egy új, domboldali medence Kisapátiban, a Balaton-felvidék szívében.
            </p>
            <p>
              Napközben a tanúhegyek látványa, este pedig a csendes nyári hangulat teszi különlegessé ezt a helyet.
            </p>
            <p>
              A medence sóbontós vízkezeléssel működik, fedhető kialakítású, és a D1, D2 valamint a Fügeház
              vendégei számára lesz elérhető 2026 nyarától.
            </p>
          </div>

          <div class="pool-feature-panel">
            <p class="pool-feature-panel__title">Amit szeretni fogsz benne</p>
            <ul class="pool-feature-list" aria-label="Panorama Pool jellemzők">
              <li>panorámás domboldali elhelyezkedés</li>
              <li>tanúhegyek látványa</li>
              <li>sóbontós vízkezelés</li>
              <li>fedhető kialakítás</li>
              <li>nyugodt, természetközeli környezet</li>
              <li>esti hangulatvilágítás</li>
              <li>nyári pihenés a Balaton-felvidéken</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <section id="pool-stays" class="pool-section">
      <div class="dnd-container pool-shell pool-section-shell">
        <div class="pool-section-heading">
          <span class="pool-eyebrow">Elérhető szállások</span>
          <h2>A medence ezekhez a házakhoz érhető el.</h2>
        </div>

        <div class="pool-stays">
          {stays.map((stay) => (
            <article class="pool-stay-card">
              <h3>{stay.title}</h3>
              <p>{stay.description}</p>
              <a href={stay.href}>Oldal megnyitása</a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="pool-section">
      <div class="dnd-container pool-shell pool-section-shell">
        <div class="pool-section-heading">
          <span class="pool-eyebrow">Galéria</span>
          <h2>Így készül a Dandelion Panorama Pool.</h2>
          <p>
            A medence környezete még készül, de már most látszik az a panorámás, nyugodt hangulat, amit nyártól a
            vendégeink is átélhetnek majd.
          </p>
        </div>

        <div class="pool-gallery" data-pool-gallery>
          <figure class="pool-gallery__main">
            <img
              id="pool-gallery-main-image"
              src={heroImage.src}
              alt={heroImage.altHu}
              title={heroImage.titleHu}
              width="1800"
              height="1350"
              loading="eager"
              decoding="async"
              data-default-src={heroImage.src}
              data-default-alt={heroImage.altHu}
              data-default-title={heroImage.titleHu}
            />
            <figcaption>
              <span id={mainImageCaptionId}>{heroImage.captionHu}</span>
            </figcaption>
          </figure>

          <div class="pool-gallery__thumbs" role="list" aria-label="Panorama Pool képek">
            {galleryImages.map((image, index) => (
              <button
                type="button"
                class={`pool-thumb${image.id === heroImage.id ? " is-active" : ""}`}
                aria-pressed={image.id === heroImage.id ? "true" : "false"}
                aria-label={image.titleHu}
                data-gallery-thumb
                data-src={image.src}
                data-alt={image.altHu}
                data-title={image.titleHu}
                data-caption={image.captionHu}
              >
                <img
                  src={image.thumb}
                  alt={image.altHu}
                  title={image.titleHu}
                  width="600"
                  height="450"
                  loading={index < 4 ? "eager" : "lazy"}
                  decoding="async"
                />
              </button>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="pool-section">
      <div class="dnd-container pool-shell pool-section-shell">
        <div class="pool-soon-card">
          <span class="pool-eyebrow">Coming soon</span>
          <h2>Még készül körülötte minden, de már most jó ránézni.</h2>
          <p>
            A környezet még készül, ezért most inkább egy első betekintést látsz abba, milyen lesz itt a nyári hangulat.
          </p>
          <p>
            A nyitás dátuma <strong>2026. június 1.</strong>, további fotók és videók pedig hamarosan érkeznek.
          </p>
        </div>
      </div>
    </section>

    <section class="pool-section pool-section--closing">
      <div class="dnd-container pool-shell">
        <div class="pool-closing">
          <h2>Foglalj nyári pihenést medencehasználattal</h2>
          <a href="#pool-stays" class="pool-button">Szállások megtekintése</a>
        </div>
      </div>
    </section>
  </section>

  <script define:vars={{ mainImageTitleId, mainImageCaptionId }}>
    (() => {
      const gallery = document.querySelector("[data-pool-gallery]");
      if (!gallery) return;

      const mainImage = gallery.querySelector("#pool-gallery-main-image");
      const titleNode = document.getElementById(mainImageTitleId);
      const captionNode = document.getElementById(mainImageCaptionId);
      const thumbs = Array.from(gallery.querySelectorAll("[data-gallery-thumb]"));

      if (!mainImage || !captionNode || thumbs.length === 0) return;

      thumbs.forEach((thumb) => {
        thumb.addEventListener("click", () => {
          const src = thumb.getAttribute("data-src") || mainImage.getAttribute("data-default-src") || "";
          const alt = thumb.getAttribute("data-alt") || mainImage.getAttribute("data-default-alt") || "";
          const title = thumb.getAttribute("data-title") || "";
          const caption = thumb.getAttribute("data-caption") || "";

          mainImage.setAttribute("src", src);
          mainImage.setAttribute("alt", alt);
          mainImage.setAttribute("title", title);
          if (titleNode) titleNode.textContent = title;
          captionNode.textContent = caption;

          thumbs.forEach((item) => {
            item.classList.remove("is-active");
            item.setAttribute("aria-pressed", "false");
          });

          thumb.classList.add("is-active");
          thumb.setAttribute("aria-pressed", "true");
        });
      });
    })();
  </script>

  <script>
    (() => {
      const applyPoolHeaderState = () => {
        const header = document.querySelector("[data-dnd-header]");
        if (header) {
          header.classList.add("is-pool-visible");
        }
      };

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", applyPoolHeaderState, { once: true });
      } else {
        applyPoolHeaderState();
      }
    })();
  </script>
</BaseLayout>

<style>
  :global(.dnd-header.is-pool-visible) {
    background: rgba(239, 228, 211, 0.94);
    border-bottom: 1px solid rgba(111, 87, 59, 0.1);
    box-shadow: 0 14px 34px rgba(79, 52, 29, 0.08);
    color: #2d241c;
    backdrop-filter: blur(12px);
  }

  :global(.dnd-header.is-pool-visible .dnd-logo img) {
    filter: none;
  }

  :global(.dnd-header.is-pool-visible .dnd-header__contact a) {
    border-color: rgba(94, 65, 39, 0.18);
    background: rgba(255, 252, 246, 0.22);
  }

  :global(.dnd-header.is-pool-visible .dnd-header__contact a:hover),
  :global(.dnd-header.is-pool-visible .dnd-header__contact a:focus-visible) {
    border-color: rgba(94, 65, 39, 0.36);
    background: rgba(255, 252, 246, 0.56);
  }

  :global(.dnd-header.is-pool-visible .dnd-nav) {
    border-top-color: rgba(94, 65, 39, 0.12);
  }

  :global(.dnd-header.is-pool-visible .dnd-header-cta) {
    border-color: rgba(94, 65, 39, 0.16);
    background: rgba(255, 252, 246, 0.46);
  }

  .pool-page {
    background: #fdfbf7;
    color: #2e241b;
  }

  .pool-shell {
    max-width: 1224px;
  }

  .pool-section {
    padding: 84px 0;
  }

  .pool-section--hero {
    padding: 120px 0 78px;
  }

  .pool-section--closing {
    padding-top: 28px;
    padding-bottom: 88px;
  }

  .pool-section-shell {
    display: grid;
    gap: 24px;
  }

  .pool-eyebrow {
    display: inline-block;
    margin-bottom: 10px;
    color: #d99e2b;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .pool-section-heading {
    max-width: 720px;
  }

  .pool-section-heading h2,
  .pool-soon-card h2,
  .pool-closing h2 {
    margin: 0;
    color: #2a2017;
    font-family: var(--dnd-font-display);
    font-size: clamp(2.1rem, 3.5vw, 4rem);
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .pool-section-heading p,
  .pool-intro__copy p,
  .pool-stay-card p,
  .pool-soon-card p {
    margin: 0;
    color: rgba(46, 36, 27, 0.76);
    font-size: 1rem;
    line-height: 1.72;
  }

  .pool-hero {
    display: grid;
    grid-template-columns: minmax(320px, 0.9fr) minmax(460px, 1.1fr);
    min-height: min(74vh, 720px);
    gap: 40px;
    align-items: center;
  }

  .pool-hero__content {
    max-width: 500px;
    padding: 12px 0;
  }

  .pool-hero h1 {
    margin: 0;
    color: #241b14;
    font-family: var(--dnd-font-display);
    font-size: clamp(3.2rem, 5vw, 5.6rem);
    font-weight: 600;
    line-height: 0.94;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }

  .pool-hero__lead {
    margin: 20px 0 0;
    color: #4e4030;
    font-size: clamp(1.02rem, 1.35vw, 1.22rem);
    line-height: 1.6;
  }

  .pool-hero__text {
    max-width: 38ch;
    margin: 12px 0 0;
    color: rgba(46, 36, 27, 0.76);
    font-size: 1rem;
    line-height: 1.68;
  }

  .pool-button {
    display: inline-flex;
    min-height: 48px;
    margin-top: 24px;
    padding: 0 22px;
    border-radius: 8px;
    align-items: center;
    justify-content: center;
    background: #d99e2b;
    color: #1f170f;
    font-size: 0.98rem;
    font-weight: 600;
    text-decoration: none;
    transition: background 0.2s ease, transform 0.2s ease;
  }

  .pool-button:hover {
    background: #cb901f;
    transform: translateY(-1px);
  }

  .pool-hero__media,
  .pool-gallery__main,
  .pool-soon-card,
  .pool-stay-card,
  .pool-closing {
    overflow: hidden;
    border: 1px solid rgba(90, 67, 41, 0.12);
    border-radius: 8px;
    background: #fff;
    box-shadow: 0 18px 44px rgba(64, 45, 27, 0.06);
  }

  .pool-hero__media {
    align-self: stretch;
  }

  .pool-hero__media img,
  .pool-gallery__main img {
    display: block;
    width: 100%;
    object-fit: cover;
  }

  .pool-hero__media img {
    height: 100%;
    min-height: 560px;
  }

  .pool-gallery__main img {
    aspect-ratio: 16 / 10;
  }

  .pool-hero__media figcaption,
  .pool-gallery__main figcaption {
    padding: 14px 16px 16px;
    color: rgba(46, 36, 27, 0.68);
    font-size: 0.92rem;
    line-height: 1.55;
  }

  .pool-intro {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(320px, 0.85fr);
    gap: 28px;
    align-items: start;
  }

  .pool-intro__copy {
    display: grid;
    gap: 16px;
  }

  .pool-feature-panel {
    display: grid;
    gap: 14px;
    padding: 22px 22px 24px;
    border: 1px solid rgba(90, 67, 41, 0.12);
    border-radius: 8px;
    background: #fffaf0;
  }

  .pool-feature-panel__title {
    margin: 0;
    color: #2a2017;
    font-size: 0.98rem;
    font-weight: 600;
    line-height: 1.4;
  }

  .pool-feature-list {
    display: grid;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pool-feature-list li {
    position: relative;
    padding-left: 18px;
    color: #443527;
    line-height: 1.55;
  }

  .pool-feature-list li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.72em;
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: #d99e2b;
    transform: translateY(-50%);
  }

  .pool-stays {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }

  .pool-stay-card {
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: 12px;
    min-height: 212px;
    padding: 22px 20px;
  }

  .pool-stay-card h3 {
    margin: 0;
    color: #241b14;
    font-size: 1.2rem;
    font-weight: 600;
    line-height: 1.2;
  }

  .pool-stay-card a {
    color: #9b6d12;
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: none;
  }

  .pool-gallery {
    display: grid;
    gap: 16px;
  }

  .pool-gallery__main {
    background: #fbf7ef;
  }

  .pool-gallery__thumbs {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 10px;
  }

  .pool-thumb {
    overflow: hidden;
    padding: 0;
    border: 1px solid rgba(90, 67, 41, 0.12);
    border-radius: 8px;
    background: #fff;
    box-shadow: 0 12px 28px rgba(64, 45, 27, 0.04);
    cursor: pointer;
    transition: border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
  }

  .pool-thumb:hover,
  .pool-thumb.is-active {
    border-color: rgba(217, 158, 43, 0.45);
    box-shadow: 0 18px 34px rgba(64, 45, 27, 0.08);
    transform: translateY(-1px);
  }

  .pool-thumb img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .pool-thumb__meta {
    display: none;
  }

  .pool-soon-card {
    display: grid;
    gap: 14px;
    max-width: 820px;
    padding: 24px 24px 26px;
  }

  .pool-closing {
    display: grid;
    gap: 16px;
    justify-items: center;
    padding: 26px 24px 30px;
    text-align: center;
  }

  @media (max-width: 1080px) {
    .pool-section {
      padding: 72px 0;
    }

    .pool-section--hero {
      padding: 112px 0 70px;
    }

    .pool-hero,
    .pool-intro {
      grid-template-columns: 1fr;
    }

    .pool-hero {
      min-height: auto;
      gap: 28px;
    }

    .pool-hero__content {
      max-width: 100%;
    }

    .pool-hero__media img {
      min-height: 0;
      max-height: 620px;
    }
  }

  @media (max-width: 900px) {
    .pool-stays {
      grid-template-columns: 1fr;
    }

    .pool-gallery__thumbs {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 767px) {
    .pool-section {
      padding: 56px 0;
    }

    .pool-section--hero {
      padding: 104px 0 54px;
    }

    .pool-section--closing {
      padding-top: 16px;
      padding-bottom: 72px;
    }

    .pool-section-shell {
      gap: 18px;
    }

    .pool-section-heading h2,
    .pool-soon-card h2,
    .pool-closing h2 {
      font-size: clamp(1.9rem, 8vw, 2.6rem);
    }

    .pool-hero {
      gap: 24px;
    }

    .pool-hero h1 {
      font-size: clamp(2.6rem, 12vw, 3.7rem);
      line-height: 0.98;
    }

    .pool-hero__lead {
      font-size: 1rem;
    }

    .pool-hero__media img {
      aspect-ratio: 4 / 4.4;
      max-height: none;
    }

    .pool-gallery__thumbs {
      grid-template-columns: 1fr 1fr;
      gap: 10px;
    }

    .pool-stay-card,
    .pool-soon-card,
    .pool-closing {
      padding: 20px;
    }
  }
</style>
