---
import BaseLayout from "../layouts/BaseLayout.astro";

// [CHANGE 2026-05-12 00:00] A rövid impresszum placeholder teljes, tagolt impresszum tartalomra cserélve.

const sections = [
  {
    title: "A weboldal üzemeltetője",
    items: [
      ["Cégnév", "Dandelion Vendégházak Kft."],
      ["Székhely", "8284 Kisapáti, Kossuth utca 78/5."],
      ["Cégjegyzékszám", "19-09-523814"],
      ["Adószám", "24646345-1-19"],
      ["Képviselő", "Várnagy Ilona"]
    ]
  },
  {
    title: "Kapcsolat",
    items: [
      ["E-mail", "hello@dandelionhouse.hu", "mailto:hello@dandelionhouse.hu"],
      ["Telefon", "+36 20 773 0807", "tel:+36207730807"],
      ["Weboldal", "dandelionhouse.hu", "https://dandelionhouse.hu/"]
    ]
  },
  {
    title: "Tárhelyszolgáltató",
    items: [
      ["Szolgáltató neve", "DotRoll Kft."],
      ["Székhely", "1148 Budapest, Fogarasi út 3-5."],
      ["Telefon", "+36 1 432 3232", "tel:+3614323232"],
      ["E-mail", "support@dotroll.com", "mailto:support@dotroll.com"],
      ["Weboldal", "dotroll.com", "https://dotroll.com/"]
    ]
  }
];
---

<BaseLayout
  title="Impresszum | Dandelion Vendégházak"
  description="A dandelionhouse.hu weboldal üzemeltetői, kapcsolati és tárhelyszolgáltatói adatai."
  canonicalPath="/impresszum/"
>
  <section class="legal-page">
    <div class="dnd-container legal-page__inner">
      <span class="legal-page__eyebrow">Jogi információ</span>
      <h1>Impresszum</h1>
      <p class="legal-page__lead">
        A dandelionhouse.hu weboldal üzemeltetői, kapcsolati és tárhelyszolgáltatói adatai.
      </p>

      <div class="legal-page__sections">
        {sections.map((section) => (
          <article class="legal-page__card">
            <h2>{section.title}</h2>
            <dl class="legal-page__details">
              {section.items.map(([label, value, href]) => (
                <div class="legal-page__detail-row">
                  <dt>{label}</dt>
                  <dd>
                    {href ? <a href={href}>{value}</a> : value}
                  </dd>
                </div>
              ))}
            </dl>
          </article>
        ))}

        <article class="legal-page__card">
          <h2>A weboldal célja</h2>
          <p>
            A dandelionhouse.hu weboldal a Dandelion Vendégházak szálláshelyeinek bemutatására,
            közvetlen foglalási lehetőség biztosítására, valamint vendégtájékoztatásra szolgál.
          </p>
        </article>

        <article class="legal-page__card">
          <h2>Szerzői jog</h2>
          <p>
            A weboldalon található szövegek, képek, videók, grafikai elemek és egyéb tartalmak
            szerzői jogi védelem alatt állnak.
          </p>
          <p>
            Ezek felhasználása, másolása vagy közzététele kizárólag az üzemeltető előzetes írásos
            engedélyével lehetséges.
          </p>
        </article>

        <article class="legal-page__card">
          <h2>Felelősség</h2>
          <p>
            Az üzemeltető törekszik arra, hogy a weboldalon szereplő információk pontosak és
            naprakészek legyenek.
          </p>
          <p>
            A szálláshelyek árai, elérhetőségei és foglalási feltételei minden esetben a foglalási
            folyamatban, illetve a visszaigazolásban rögzítettek szerint érvényesek.
          </p>
        </article>

        <article class="legal-page__card">
          <h2>Kapcsolódó dokumentumok</h2>
          <ul class="legal-page__links">
            <li>
              ÁSZF – Általános Szerződési Feltételek:
              <a href="/aszf/"> dandelionhouse.hu/aszf/</a>
            </li>
            <li>
              Adatkezelési tájékoztató:
              <a href="/adatkezelesi-tajekoztato/"> dandelionhouse.hu/adatkezelesi-tajekoztato/</a>
            </li>
          </ul>
        </article>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .legal-page {
    padding: 132px 0 88px;
    background: #fdfbf7;
  }

  .legal-page__inner {
    display: grid;
    gap: 24px;
    max-width: 920px;
  }

  .legal-page__eyebrow {
    color: #d99e2b;
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .legal-page h1,
  .legal-page h2 {
    margin: 0;
    color: #261d16;
  }

  .legal-page h1 {
    font-family: var(--dnd-font-display);
    font-size: clamp(2rem, 3.6vw, 3.3rem);
    font-weight: 500;
    line-height: 1.08;
  }

  .legal-page h2 {
    font-family: var(--dnd-font-display);
    font-size: clamp(1.35rem, 2vw, 1.8rem);
    font-weight: 500;
    line-height: 1.15;
  }

  .legal-page p,
  .legal-page li,
  .legal-page dt,
  .legal-page dd,
  .legal-page a {
    font-family: var(--dnd-font-body);
  }

  .legal-page p,
  .legal-page li,
  .legal-page dt,
  .legal-page dd {
    margin: 0;
    color: rgba(38, 29, 22, 0.78);
    font-size: 1rem;
    line-height: 1.72;
  }

  .legal-page a {
    color: #8f6217;
    text-decoration: none;
  }

  .legal-page a:hover {
    color: #d99e2b;
  }

  .legal-page__lead {
    max-width: 860px;
    font-size: 1.04rem;
  }

  .legal-page__sections {
    display: grid;
    gap: 18px;
  }

  .legal-page__card {
    display: grid;
    gap: 14px;
    padding: 24px;
    border: 1px solid rgba(88, 63, 38, 0.12);
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.9);
  }

  .legal-page__details {
    display: grid;
    gap: 10px;
    margin: 0;
  }

  .legal-page__detail-row {
    display: grid;
    grid-template-columns: minmax(180px, 220px) minmax(0, 1fr);
    gap: 12px;
  }

  .legal-page__detail-row dt {
    color: rgba(38, 29, 22, 0.56);
    font-weight: 600;
  }

  .legal-page__detail-row dd {
    margin: 0;
    font-weight: 500;
  }

  .legal-page__links {
    display: grid;
    gap: 10px;
    margin: 0;
    padding-left: 1.2rem;
  }

  @media (max-width: 767px) {
    .legal-page {
      padding: 110px 0 64px;
    }

    .legal-page__inner {
      gap: 20px;
    }

    .legal-page__card {
      padding: 20px;
    }

    .legal-page__detail-row {
      grid-template-columns: 1fr;
      gap: 4px;
    }
  }
</style>
