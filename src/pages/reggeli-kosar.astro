"3 000 HUF/osoba/deň", childPrice: "2 000 HUF/osoba/deň", exampleEyebrow: "Príklad", exampleTitle: "2 dospelí + 1 dieťa", age: "6–13 rokov", adults: "2 dospelí", adultsCalculation: "2 × 3 000 HUF = 6 000 HUF/deň", oneChild: "1 dieťa", childCalculation: "2 000 HUF/deň", total: "Spolu", totalPrice: "8 000 HUF/deň", minimumTotal: "Pri minimálne 2 dňoch: spolu 16 000 HUF.", staysEyebrow: "Vyberte si ubytovanie", staysTitle: "Len pre hostí D2 a Fügeház.", d2Link: "Podrobnosti o Dandelion D2", fugeLink: "Podrobnosti o Fügeház", noteAria: "Dohoda vopred", note: "Chcete sa informovať alebo objednať? Napíšte nám pre podrobnosti.", contact: "Dopyt a objednávka", contactHref: "/sk/kontakt/", faqEyebrow: "Pomôžeme s plánovaním", faqTitle: "Časté otázky o raňajkovom košíku Dandelion", faqItems: [["V ktorom ubytovaní Dandelion si možno objednať raňajkový košík?", "Raňajkový košík je k dispozícii hosťom ubytovaným v D2 a Fügeház."], ["Koľko raňajkový košík stojí?", "Pre dospelých stojí 3 500 HUF/osoba/deň pre dve osoby a od troch osôb 3 000 HUF/osoba/deň. Deti vo veku 6–13 rokov platia 2 000 HUF/osoba/deň, deti vo veku 0–5 rokov raňajkujú zdarma."], ["Koľko stoja raňajky pre 2 dospelých a 1 dieťa?", "Dvaja dospelí platia 3 000 HUF/osoba/deň a dieťa vo veku 6–13 rokov 2 000 HUF/deň, spolu teda 8 000 HUF/deň."], ["Platí minimálna objednávka?", "Áno, minimálna objednávka je pre 2 osoby a na 2 dni."], ["Čo znamená raňajkový košík pre 2 osoby na 2 dni?", "Obsahuje dve raňajky pre dve osoby; pre dve osoby je minimálna celková cena 14 000 HUF."], ["Kedy raňajkový košík dostaneme?", "Doručíme ho ráno po príchode medzi 8. a 9. hodinou."], ["Čo raňajkový košík Dandelion obsahuje?", "Obsahuje mäsové výrobky, mliečne výrobky, vajcia, čerstvé ovocie a zeleninu, pečivo, chlieb z pece a čaj. Podrobný obsah je uvedený v zozname košíka."], ["Možno objednať raňajky aj pre deti?", "Áno. Deti vo veku 6–13 rokov platia 2 000 HUF/osoba/deň, deti 0–5 rokov raňajkujú zdarma."], ["Poskytujete dojčenskú alebo detskú stravu?", "Nie, samostatnú dojčenskú ani detskú stravu neposkytujeme."], ["Možno raňajkový košík objednať pri potravinovej alergii?", "Áno, alergiu alebo špeciálnu stravovaciu požiadavku nám však oznámte vopred, aby sme mohli možnosti dohodnúť."]]
  }
} as const;

const content = breakfastCopy[lang];
const breakfastItems = content.items;
const faqItems = content.faqItems.map(([question, answer]) => ({ question, answer }));
const servedBreakfastText = lang === "cs"
  ? "Doručíme ho do ubytování ráno po příjezdu mezi 8. a 9. hodinou."
  : lang === "sk"
    ? "Doručíme ho do ubytovania ráno po príchode medzi 8. a 9. hodinou."
    : `${content.deliveryWindow}, ${content.servedText}`;
const introTitle = lang === "sk" ? "Raňajky hneď prvé ráno priamo v ubytovaní." : content.introTitle;

const pageUrl = `https://dandelionhouse.hu${canonicalPath}`;
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: content.home, item: `https://dandelionhouse.hu${lang === "hu" ? "/" : `/${lang}/`}` },
      { "@type": "ListItem", position: 2, name: content.name, item: pageUrl }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: content.serviceName,
    serviceType: content.serviceType,
    areaServed: content.areaServed,
    description: content.serviceDescription
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqItems.map(({ question, answer }) => ({
      "@type": "Question",
      name: question,
      acceptedAnswer: {
        "@type": "Answer",
        text: answer
      }
    }))
  }
];
---

<BaseLayout
  title={content.title}
  description={content.description}
  canonicalPath={canonicalPath}
  lang={lang}
  structuredData={structuredData}
  headerMode="solid"
>
  <div class="breakfast-page">
    <section class="breakfast-hero" aria-labelledby="breakfast-title">
      <div class="dnd-container breakfast-hero__inner">
        <div class="breakfast-hero__copy">
          <span class="breakfast-eyebrow">{content.heroEyebrow}</span>
          <h1 id="breakfast-title">{content.heroTitle}</h1>
          <p>{content.heroText}</p>
          <div class="breakfast-hero__actions">
            <a class="breakfast-button breakfast-button--primary" href="#arazas">{content.pricingCta}</a>
            <a class="breakfast-button breakfast-button--secondary" href="#tartalom">{content.contentsCta}</a>
          </div>
        </div>
        <div class="breakfast-hero__media" aria-label={content.heroAria}>
          <Image src={breakfastBasketImage} alt={content.heroAlt} widths={[640, 960, 1280, 1600]} sizes="(max-width: 900px) 100vw, 55vw" loading="eager" />
        </div>
      </div>
    </section>

    <div class="dnd-container breakfast-page__content">
      <section class="breakfast-intro breakfast-panel" aria-labelledby="intro-title">
        <div>
          <span class="breakfast-eyebrow">{content.introEyebrow}</span>
          <h2 id="intro-title">{introTitle}</h2>
        </div>
        <p>
          {content.introText}
        </p>
      </section>

      <section class="breakfast-grid" id="tartalom" aria-labelledby="contents-title">
        <div class="breakfast-panel breakfast-list-panel">
          <span class="breakfast-eyebrow">{content.contentsEyebrow}</span>
          <h2 id="contents-title">{content.contentsTitle}</h2>
          <ul>
            {breakfastItems.map((item) => <li>{item}</li>)}
          </ul>
        </div>
        <div class="breakfast-card breakfast-card--image">
          <Image src={servedBreakfastImage} alt={content.servedAlt} widths={[480, 800, 1200, 1400]} sizes="(max-width: 900px) 100vw, 42vw" loading="lazy" />
          <p>{servedBreakfastText}</p>
        </div>
      </section>

      <section class="breakfast-panel breakfast-pricing" id="arazas" aria-labelledby="pricing-title">
        <div class="breakfast-pricing__heading">
          <span class="breakfast-eyebrow">{content.pricingEyebrow}</span>
          <h2 id="pricing-title">{content.pricingTitle}</h2>
          <p>{content.minimum}</p>
        </div>
        <div class="breakfast-price-list">
          <article class="breakfast-price-row breakfast-reveal" data-reveal="price">
            <div>
              <strong>{content.freeChild}</strong>
              <small>{content.freeChildNote}</small>
            </div>
            <span>{content.free}</span>
          </article>
          <article class="breakfast-price-row breakfast-reveal" data-reveal="price">
            <strong>{content.child}</strong>
            <span>{content.childPrice}</span>
          </article>
          <article class="breakfast-price-row breakfast-price-row--adult breakfast-reveal" data-reveal="price">
            <strong>{content.adult}</strong>
            <div class="breakfast-price-row__adult-rates">
              <span><small>{content.forTwo}</small>{content.adultPriceTwo}</span>
              <span><small>{content.fromThree}</small>{content.adultPriceThree}</span>
            </div>
          </article>
        </div>
        <div class="breakfast-decision breakfast-reveal" data-reveal="example">
          <span class="breakfast-decision__eyebrow">{content.exampleEyebrow}</span>
          <strong>{content.exampleTitle} <small>({content.age})</small></strong>
          <div class="breakfast-decision__calculation">
            <span><b>{content.adults}</b><em>{content.adultsCalculation}</em></span>
            <span><b>{content.oneChild}</b><em>{content.childCalculation}</em></span>
          </div>
          <div class="breakfast-decision__total">
            <span>{content.total}</span>
            <strong>{content.totalPrice}</strong>
            <small>{content.minimumTotal}</small>
          </div>
        </div>
      </section>

      <section class="breakfast-panel breakfast-stays" aria-labelledby="stays-title">
        <div>
          <span class="breakfast-eyebrow">{content.staysEyebrow}</span>
          <h2 id="stays-title">{content.staysTitle}</h2>
        </div>
        <div class="breakfast-stays__links">
          <a href={lang === "hu" ? "/dandelion-d2/" : `/${lang}/dandelion-d2/`}>{content.d2Link} <span aria-hidden="true">→</span></a>
          <a href={lang === "hu" ? "/fuge/" : `/${lang}/dandelion-fugehaz/`}>{content.fugeLink} <span aria-hidden="true">→</span></a>
        </div>
      </section>

      <section class="breakfast-note" aria-label={content.noteAria}>
        <p>{content.note}</p>
        <a href={content.contactHref}>{content.contact}</a>
      </section>

      <section class="breakfast-panel breakfast-faq" aria-labelledby="faq-title">
        <span class="breakfast-eyebrow">{content.faqEyebrow}</span>
        <h2 id="faq-title">{content.faqTitle}</h2>
        <div class="breakfast-faq__list">
          {faqItems.map((item) => (
            <details>
              <summary>{item.question}</summary>
              <p>{item.answer}</p>
            </details>
          ))}
        </div>
      </section>
    </div>
  </div>
</BaseLayout>

<script>
  const breakfastPage = document.querySelector(".breakfast-page");

  if (breakfastPage && "IntersectionObserver" in window) {
    breakfastPage.classList.add("breakfast-page--js");

    const revealObserver = new IntersectionObserver(
      (entries, observer) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add("is-visible");
          observer.unobserve(entry.target);
        });
      },
      { threshold: 0.18, rootMargin: "0px 0px -8%" }
    );

    breakfastPage.querySelectorAll("[data-reveal]").forEach((element, index) => {
      element.style.setProperty("--reveal-delay", `${index * 90}ms`);
      revealObserver.observe(element);
    });
  }
</script>

<style>
  .breakfast-page { background: linear-gradient(180deg, #fbf8f1 0%, #f3eadb 100%); color: #2d241c; padding-bottom: 88px; }
  .breakfast-hero { padding: clamp(148px, 12vw, 180px) 0 42px; }
  .breakfast-hero__inner { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: clamp(28px, 5vw, 80px); align-items: center; }
  .breakfast-hero__copy { display: grid; gap: 18px; }
  .breakfast-eyebrow { color: #a56d1f; font-size: var(--dnd-text-2xs); font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; }
  .breakfast-page h1, .breakfast-page h2 { margin: 0; font-family: var(--dnd-font-display); font-weight: 500; line-height: 1.08; }
  .breakfast-page h1 { max-width: 15ch; font-size: clamp(2.35rem, 4vw, 3.85rem); letter-spacing: -0.025em; }
  .breakfast-page h2 { font-size: clamp(1.65rem, 2.7vw, 2.35rem); }
  .breakfast-hero p, .breakfast-panel p, .breakfast-note p { margin: 0; font-size: var(--dnd-text-body); line-height: 1.7; }
  .breakfast-hero__copy > p { max-width: 48ch; color: rgba(45, 36, 28, 0.76); }
  .breakfast-hero__media { overflow: hidden; border-radius: 14px; box-shadow: 0 18px 42px rgba(56, 37, 20, 0.13); }
  .breakfast-hero__media :global(img), .breakfast-card--image :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; }
  .breakfast-hero__media :global(img) { aspect-ratio: 1.28 / 1; }
  .breakfast-hero__actions, .breakfast-stays__links { display: flex; flex-wrap: wrap; gap: 12px; }
  .breakfast-button, .breakfast-stays a, .breakfast-note a { display: inline-flex; align-items: center; justify-content: center; min-height: 42px; padding: 0 14px; border: 1px solid rgba(56, 41, 29, 0.55); text-decoration: none; font-size: var(--dnd-text-xs); font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; }
  .breakfast-button--primary { border-color: #38291d; background: #38291d; color: #fff; }
  .breakfast-button--secondary { color: #38291d; }
  .breakfast-page__content { display: grid; gap: 22px; }
  .breakfast-panel { padding: clamp(22px, 4vw, 42px) 0; border: 0; border-radius: 0; background: transparent; box-shadow: none; }
  .breakfast-intro { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 0.8fr); gap: 30px; align-items: end; padding: 28px 0; border-top: 1px solid rgba(88, 63, 38, 0.18); border-bottom: 1px solid rgba(88, 63, 38, 0.18); }
  .breakfast-intro > div, .breakfast-pricing__heading { display: grid; gap: 12px; }
  .breakfast-intro p { color: rgba(45, 36, 28, 0.74); }
  .breakfast-grid { display: grid; grid-template-columns: minmax(0, 1.08fr) minmax(260px, 0.72fr); gap: clamp(28px, 5vw, 68px); align-items: center; }
  .breakfast-list-panel { display: grid; gap: 14px; }
  .breakfast-list-panel ul { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 11px 24px; margin: 6px 0 0; padding: 0; list-style: none; }
  .breakfast-list-panel li { position: relative; padding-left: 20px; font-size: var(--dnd-text-body); line-height: 1.45; }
  .breakfast-list-panel li::before { content: ""; position: absolute; left: 0; top: 0.58em; width: 7px; height: 7px; border-radius: 50%; background: #d99e2b; }
  .breakfast-card--image { overflow: hidden; min-height: 100%; border-radius: 14px; background: #38291d; color: #fff; }
  .breakfast-card--image :global(img) { min-height: 250px; aspect-ratio: 1 / 0.8; }
  .breakfast-card--image p { padding: 17px 20px 20px; font-size: var(--dnd-text-sm); }
  .breakfast-pricing { display: grid; gap: 22px; padding: clamp(26px, 4vw, 44px) clamp(18px, 4vw, 46px); background: #efe4d3; }
  .breakfast-price-list { border-top: 1px solid rgba(88, 63, 38, 0.28); }
  .breakfast-price-row { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 24px; align-items: center; min-height: 76px; padding: 14px 0; border-bottom: 1px solid rgba(88, 63, 38, 0.2); }
  .breakfast-price-row > strong, .breakfast-price-row > div:first-child strong { font-family: var(--dnd-font-display); font-size: clamp(1.2rem, 2vw, 1.55rem); font-weight: 500; line-height: 1.12; }
  .breakfast-price-row > div:first-child { display: grid; gap: 5px; }
  .breakfast-price-row span { color: #8d5f1e; font-size: 1.05rem; font-weight: 700; line-height: 1.4; text-align: right; }
  .breakfast-price-row small { display: block; max-width: 44ch; color: rgba(45, 36, 28, 0.72); font-size: var(--dnd-text-sm); font-weight: 400; line-height: 1.4; }
  .breakfast-price-row__adult-rates { display: flex; gap: 22px; }
  .breakfast-price-row__adult-rates span { display: grid; gap: 2px; text-align: right; }
  .breakfast-price-row__adult-rates small { color: rgba(45, 36, 28, 0.68); font-size: var(--dnd-text-2xs); text-transform: uppercase; }
  .breakfast-decision { display: grid; gap: 10px; padding: 22px 0 0; border-top: 1px solid rgba(88, 63, 38, 0.24); font-size: var(--dnd-text-body); line-height: 1.55; }
  .breakfast-decision__eyebrow { color: #a56d1f; font-size: var(--dnd-text-2xs); font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; }
  .breakfast-decision > strong { font-family: var(--dnd-font-display); font-size: clamp(1.3rem, 2.2vw, 1.75rem); font-weight: 500; }
  .breakfast-decision > strong small { font-family: var(--dnd-font-body); font-size: var(--dnd-text-sm); font-weight: 600; }
  .breakfast-decision__calculation { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
  .breakfast-decision__calculation > span { display: grid; gap: 3px; padding: 12px 14px; border-left: 2px solid rgba(217, 158, 43, 0.8); background: rgba(255, 255, 255, 0.34); }
  .breakfast-decision__calculation b { font-size: var(--dnd-text-sm); }
  .breakfast-decision__calculation em { font-style: normal; font-size: var(--dnd-text-sm); }
  .breakfast-decision__total { display: grid; grid-template-columns: auto auto 1fr; gap: 12px; align-items: baseline; padding-top: 5px; border-top: 1px solid rgba(88, 63, 38, 0.14); }
  .breakfast-decision__total span { font-weight: 700; }
  .breakfast-decision__total strong { color: #8d5f1e; font-size: 1.25rem; }
  .breakfast-decision__total small { justify-self: end; font-size: var(--dnd-text-sm); }
  .breakfast-page--js .breakfast-reveal { opacity: 0; transform: translateY(16px); transition: opacity 0.55s ease, transform 0.55s ease; transition-delay: var(--reveal-delay, 0ms); }
  .breakfast-page--js .breakfast-reveal.is-visible { opacity: 1; transform: translateY(0); }
  @media (prefers-reduced-motion: reduce) { .breakfast-page--js .breakfast-reveal { opacity: 1; transform: none; transition: none; } }
  .breakfast-example { color: rgba(45, 36, 28, 0.74); }
  .breakfast-stays { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 26px; align-items: center; }
  .breakfast-stays__links { justify-content: flex-end; }
  .breakfast-stays a { gap: 12px; color: #38291d; }
  .breakfast-stays a span { font-size: 1.2rem; }
  .breakfast-note { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px; padding: 0 8px; }
  .breakfast-note a { min-height: 40px; color: #38291d; }
  .breakfast-faq { display: grid; gap: 18px; }
  .breakfast-faq__list { display: grid; gap: 10px; }
  .breakfast-faq details { border-top: 1px solid rgba(88, 63, 38, 0.16); }
  .breakfast-faq details:last-child { border-bottom: 1px solid rgba(88, 63, 38, 0.16); }
  .breakfast-faq summary { cursor: pointer; padding: 17px 34px 17px 0; list-style: none; font-size: var(--dnd-text-body); font-weight: 700; line-height: 1.45; position: relative; }
  .breakfast-faq summary::-webkit-details-marker { display: none; }
  .breakfast-faq summary::after { content: "+"; position: absolute; top: 14px; right: 4px; color: #a56d1f; font-size: 1.5rem; font-weight: 400; }
  .breakfast-faq details[open] summary::after { content: "–"; }
  .breakfast-faq details p { max-width: 72ch; padding: 0 34px 19px 0; color: rgba(45, 36, 28, 0.76); }
  @media (max-width: 900px) { .breakfast-hero__inner, .breakfast-intro, .breakfast-grid, .breakfast-stays { grid-template-columns: 1fr; } .breakfast-stays__links { justify-content: flex-start; } }
  @media (max-width: 700px) { .breakfast-price-row__adult-rates { gap: 12px; } .breakfast-price-row__adult-rates span { font-size: var(--dnd-text-sm); } }
  @media (max-width: 560px) { .breakfast-page { padding-bottom: 62px; } .breakfast-hero { padding: 92px 0 28px; } .breakfast-page h1 { max-width: 15ch; font-size: clamp(2.2rem, 10vw, 3rem); } .breakfast-hero__media { border-radius: 12px; } .breakfast-panel { padding: 20px 0; } .breakfast-list-panel ul { grid-template-columns: 1fr; } .breakfast-list-panel li { font-size: var(--dnd-text-sm); } .breakfast-price-row { grid-template-columns: 1fr auto; gap: 12px; min-height: 70px; } .breakfast-price-row__adult-rates { grid-column: 1 / -1; justify-content: space-between; padding-top: 6px; } .breakfast-price-row__adult-rates span { text-align: left; } .breakfast-decision__calculation, .breakfast-decision__total { grid-template-columns: 1fr; } .breakfast-decision__total small { justify-self: start; } .breakfast-button, .breakfast-stays a { width: 100%; } }
</style>
