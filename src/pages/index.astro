---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../sections/Hero.astro";
import Why from "../sections/Why.astro";
import RegionStories from "../sections/RegionStories.astro";
import Experiences from "../sections/Experiences.astro";
import GoogleRegionMap from "../sections/GoogleRegionMap.astro";
import LocationSection from "../sections/LocationSection.astro";
import DirectBookingSection from "../sections/DirectBookingSection.astro";
import ClosingCta from "../sections/ClosingCta.astro";

const baseHref = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const homepageHeroDesktopImage = `${baseHref}images/homepage-hero-desktop.webp`;
const homepageHeroMobileImage = `${baseHref}images/homepage-hero-mobile.webp`;
---

<BaseLayout>
  <Fragment slot="head">
    <link
      rel="preload"
      as="image"
      href={homepageHeroMobileImage}
      type="image/webp"
      media="(max-width: 767px)"
      fetchpriority="high"
    />
    <link
      rel="preload"
      as="image"
      href={homepageHeroDesktopImage}
      type="image/webp"
      media="(min-width: 768px)"
      fetchpriority="high"
    />
  </Fragment>
  <Hero desktopImage={homepageHeroDesktopImage} mobileImage={homepageHeroMobileImage} />
  <RegionStories />
  <Experiences />
  <GoogleRegionMap />
  <Why />
  <LocationSection />
  <DirectBookingSection />
  <ClosingCta />
</BaseLayout>
