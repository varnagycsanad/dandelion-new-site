---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../sections/Hero.astro";
import RegionStories from "../sections/RegionStories.astro";
import Experiences from "../sections/Experiences.astro";
import GoogleRegionMap from "../sections/GoogleRegionMap.astro";
import NewsletterSignup from "../sections/NewsletterSignup.astro";
import homeRegionOgImage from "../assets/home/region-stories/szent-gyorgy-hegy-sunrise-sticky-bg.webp";
import { toAbsoluteUrl } from "../data/site-seo";

const baseHref = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;

const d2Reviews = [
  {
    source: "Google",
    logoSrc: `${baseHref}images/brand/google-logo-compact.png`,
    logoAlt: "Google értékelés",
    quote: "„Idilli környezet, kedves házigazdák, sok hely a gyerekeknek és nyugodt, szerethető hangulat.”",
    meta: "Vanessa L. · Google · 5/5"
  },
  {
    source: "Google",
    logoSrc: `${baseHref}images/brand/google-logo-compact.png`,
    logoAlt: "Google értékelés",
    quote: "„A ház minden igényt kielégít, és jó szívvel ajánlom annak, aki pár napra elvonulna.”",
    meta: "Ildikó Barna · Google · 5/5"
  },
  {
    source: "Google",
    logoSrc: `${baseHref}images/brand/google-logo-compact.png`,
    logoAlt: "Google értékelés",
    quote: "„Szép, rendezett hely, csendes környezet és gördülékeny érkezés. Kifejezetten jó pihenéshez.”",
    meta: "Eszter K. · Google · 5/5"
  },
  {
    source: "Booking.com",
    logoSrc: `${baseHref}images/brand/booking-logo.svg`,
    logoAlt: "Booking.com értékelés",
    quote: "„Abszolút pozitív élmény, gyors válaszokkal és nagyon segítőkész házigazdákkal.”",
    meta: "Bernadett · Booking.com · 10/10"
  },
  {
    source: "Booking.com",
    logoSrc: `${baseHref}images/brand/booking-logo.svg`,
    logoAlt: "Booking.com értékelés",
    quote: "„Tökéletes pihentető napokhoz: csendes hely, barátságos házigazdák és kényelmes szállás.”",
    meta: "Angelika · Booking.com · 9,0/10"
  }
] as const;

const d2MobileGoogleReviews = d2Reviews.filter((review) => review.source === "Google").slice(0, 2);
const d2MobileBookingReviews = d2Reviews.filter((review) => review.source === "Booking.com").slice(0, 2);
const homepageOgImageAlt = "Napfelkelte a Szent Gyorgy-hegyrol a Tapolcai-medencere nezve";
const homepageStructuredData = [
  {
    "@context": "https://schema.org",
    "@type": "ImageObject",
    "@id": `${toAbsoluteUrl("/")}#homepage-region-image`,
    contentUrl: toAbsoluteUrl(homeRegionOgImage.src),
    url: toAbsoluteUrl(homeRegionOgImage.src),
    name: "Szent Gyorgy-hegy napfelkelte panorama",
    description: homepageOgImageAlt,
    caption: homepageOgImageAlt,
    inLanguage: "hu-HU"
  }
];
---

<BaseLayout
  title="Dandelion Vendégházak | Szállás a Balaton-felvidéken"
  description="Természetközeli vendégházak a Balaton-felvidéken és a Balaton közelében, közvetlen foglalással, nyugodt környezetben és egyedi pihenési élménnyel."
  ogImage={homeRegionOgImage.src}
  ogImageAlt={homepageOgImageAlt}
  structuredData={homepageStructuredData}
>
  <Hero />
  <section class="d2-reviews dnd-section" aria-labelledby="homepage-reviews-title">
    <div class="dnd-container">
      <div class="d2-reviews__shell">
        <div class="d2-reviews__heading">
          <span class="dnd-section-kicker">Vendégértékelések</span>
          <h2 id="homepage-reviews-title" class="d2-reviews__title">Vendégeink szerint</h2>
          <p class="d2-reviews__intro">Valódi vendégértékelések Google és Booking.com forrásból</p>
        </div>

        <div class="d2-reviews__grid">
          {d2Reviews.map((review) => (
            <article class="d2-review-card">
              <div class="d2-review-card__top">
                <img
                  src={review.logoSrc}
                  alt={review.logoAlt}
                  width={review.source === "Google" ? 82 : 96}
                  height={24}
                  class:list={["d2-review-card__logo", review.source === "Google" ? "is-google" : "is-booking"]}
                  loading="lazy"
                  decoding="async"
                />
                <span class="d2-review-card__stars" aria-hidden="true">★★★★★</span>
              </div>
              <blockquote class="d2-review-card__quote">{review.quote}</blockquote>
              <p class="d2-review-card__meta">{review.meta}</p>
            </article>
          ))}
        </div>

        <div class="d2-reviews__mobile">
          <section class="d2-reviews__mobile-group" aria-label="Kiemelt Google értékelés">
            <div class="d2-reviews__mobile-head">
              <img
                src={`${baseHref}images/brand/google-logo-compact.png`}
                alt="Google értékelés"
                width={82}
                height={24}
                class="d2-reviews__mobile-logo is-google"
                loading="lazy"
                decoding="async"
              />
            </div>
            <article class="d2-review-card d2-review-card--mobile">
              <div class="d2-review-card__top d2-review-card__top--mobile">
                <span class="d2-review-card__stars" aria-hidden="true">★★★★★</span>
              </div>
              <blockquote class="d2-review-card__quote">{d2MobileGoogleReviews[0]?.quote}</blockquote>
              <p class="d2-review-card__meta">{d2MobileGoogleReviews[0]?.meta}</p>
            </article>
          </section>

          <details class="d2-reviews__more">
            <summary>További vélemények</summary>

            <section class="d2-reviews__mobile-group" aria-label="További Google értékelések">
              <div class="d2-reviews__mobile-head">
                <img
                  src={`${baseHref}images/brand/google-logo-compact.png`}
                  alt="Google értékelés"
                  width={82}
                  height={24}
                  class="d2-reviews__mobile-logo is-google"
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <div class="d2-reviews__mobile-list">
                {d2MobileGoogleReviews.slice(1).map((review) => (
                  <article class="d2-review-card d2-review-card--mobile">
                    <div class="d2-review-card__top d2-review-card__top--mobile">
                      <span class="d2-review-card__stars" aria-hidden="true">★★★★★</span>
                    </div>
                    <blockquote class="d2-review-card__quote">{review.quote}</blockquote>
                    <p class="d2-review-card__meta">{review.meta}</p>
                  </article>
                ))}
              </div>
            </section>

            <section class="d2-reviews__mobile-group" aria-label="Booking.com értékelések">
              <div class="d2-reviews__mobile-head">
                <img
                  src={`${baseHref}images/brand/booking-logo.svg`}
                  alt="Booking.com értékelés"
                  width={96}
                  height={24}
                  class="d2-reviews__mobile-logo is-booking"
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <div class="d2-reviews__mobile-list">
                {d2MobileBookingReviews.map((review) => (
                  <article class="d2-review-card d2-review-card--mobile">
                    <div class="d2-review-card__top d2-review-card__top--mobile">
                      <span class="d2-review-card__stars" aria-hidden="true">★★★★★</span>
                    </div>
                    <blockquote class="d2-review-card__quote">{review.quote}</blockquote>
                    <p class="d2-review-card__meta">{review.meta}</p>
                  </article>
                ))}
              </div>
            </section>
          </details>
        </div>
      </div>
    </div>
  </section>
  <RegionStories />
  <Experiences />
  <NewsletterSignup />
  <GoogleRegionMap />
</BaseLayout>

<style>
  .d2-reviews {
    padding-top: 18px;
    padding-bottom: 20px;
  }

  .d2-reviews__shell {
    padding: 20px 22px 22px;
    border: 1px solid rgba(91, 70, 42, 0.1);
    border-radius: 8px;
    background: linear-gradient(180deg, rgba(253, 251, 247, 0.96), rgba(247, 242, 231, 0.88));
  }

  .d2-reviews__heading {
    max-width: 680px;
    margin-bottom: 16px;
  }

  .d2-reviews__title {
    margin: 0;
    font-family: "Playfair Display", Georgia, "Times New Roman", serif;
    font-size: clamp(1.65rem, 2.7vw, 2.3rem);
    line-height: 1.08;
    font-weight: 500;
  }

  .d2-reviews__intro {
    margin: 8px 0 0;
    color: rgba(0, 0, 0, 0.64);
    font-size: 0.9rem;
    line-height: 1.52;
    opacity: 0.75;
  }

  .d2-reviews__grid {
    display: grid;
    gap: 14px;
    grid-template-columns: repeat(5, 1fr);
    max-width: 1100px;
    margin: 0 auto;
  }

  .d2-reviews__mobile {
    display: none;
  }

  .d2-review-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 6px;
    min-width: 0;
    padding: 12px 12px 10px;
    border: 1px solid rgba(0, 0, 0, 0.06);
    border-radius: 8px;
    background: #ffffff;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .d2-review-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.06);
  }

  .d2-review-card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }

  .d2-review-card__logo {
    display: block;
    width: auto;
    max-width: 100%;
    height: 18px;
    object-fit: contain;
    object-position: left center;
  }

  .d2-review-card__stars {
    color: rgba(217, 158, 43, 0.85);
    font-size: 12px;
    letter-spacing: 0.08em;
    white-space: nowrap;
  }

  .d2-review-card__quote {
    margin: 0 0 6px;
    color: rgba(0, 0, 0, 0.78);
    font-size: 13px;
    line-height: 1.45;
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .d2-review-card__meta {
    margin: 0;
    color: rgba(0, 0, 0, 0.7);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.03em;
    line-height: 1.35;
  }

  .d2-reviews__mobile-group {
    display: grid;
    gap: 10px;
  }

  .d2-reviews__mobile-head {
    display: flex;
    align-items: center;
  }

  .d2-reviews__mobile-logo {
    display: block;
    height: auto;
    object-fit: contain;
  }

  .d2-reviews__mobile-logo.is-google {
    width: 58px;
  }

  .d2-reviews__mobile-logo.is-booking {
    width: 72px;
  }

  .d2-reviews__mobile-list {
    display: grid;
    gap: 8px;
  }

  .d2-reviews__more {
    display: grid;
    gap: 10px;
  }

  .d2-reviews__more summary {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    cursor: pointer;
    color: #d99e2b;
    font-size: 14px;
    font-weight: 600;
    line-height: 1.4;
    list-style: none;
  }

  .d2-reviews__more summary::-webkit-details-marker {
    display: none;
  }

  .d2-reviews__more summary::after {
    content: "▾";
    font-size: 12px;
    transition: transform 0.2s ease;
  }

  .d2-reviews__more[open] summary {
    margin-bottom: 10px;
  }

  .d2-reviews__more[open] summary::after {
    transform: rotate(180deg);
  }

  .d2-review-card--mobile {
    gap: 5px;
    padding: 0;
  }

  .d2-review-card__top--mobile {
    justify-content: flex-start;
  }

  @media (max-width: 768px) {
    .d2-reviews__grid {
      display: none;
    }

    .d2-reviews__mobile {
      display: grid;
      gap: 12px;
    }

    .d2-reviews__more {
      gap: 12px;
    }

    .d2-reviews__more[open] summary {
      margin-bottom: 10px;
    }

    .d2-reviews__more .d2-reviews__mobile-group + .d2-reviews__mobile-group {
      margin-top: 24px;
    }

    .d2-review-card--mobile {
      border: 0;
      border-radius: 0;
      background: none;
      box-shadow: none;
      padding: 0;
      min-height: 0;
    }

    .d2-reviews__mobile-list {
      gap: 12px;
    }

    .d2-review-card__top--mobile {
      gap: 6px;
    }

    .d2-review-card--mobile .d2-review-card__quote {
      margin-bottom: 2px;
      font-size: 13px;
      line-height: 1.35;
    }

    .d2-review-card--mobile .d2-review-card__meta {
      letter-spacing: 0;
      font-size: 12px;
      line-height: 1.3;
    }

    .d2-reviews__shell {
      padding: 22px 18px 18px;
    }

    .d2-reviews__heading {
      margin-bottom: 12px;
    }

    .d2-reviews__title {
      font-size: clamp(1.45rem, 7vw, 1.9rem);
      line-height: 1.08;
    }

    .d2-reviews__intro {
      margin-top: 6px;
      font-size: 0.84rem;
      line-height: 1.45;
    }

    .d2-reviews__mobile-group {
      display: grid;
      gap: 8px;
    }

    .d2-reviews__mobile-head {
      margin-bottom: 2px;
    }

    .d2-reviews__mobile-logo.is-google {
      width: 52px;
    }

    .d2-reviews__mobile-logo.is-booking {
      width: 64px;
    }

    .d2-review-card--mobile .d2-review-card__stars {
      font-size: 11px;
    }

    .d2-review-card--mobile + .d2-review-card--mobile {
      margin-top: 8px;
    }
  }
</style>
