---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../sections/Hero.astro";
import PanoramaPoolHighlight from "../sections/PanoramaPoolHighlight.astro";
import RegionStories from "../sections/RegionStories.astro";
import Experiences from "../sections/Experiences.astro";
import GoogleRegionMap from "../sections/GoogleRegionMap.astro";
import NewsletterSignup from "../sections/NewsletterSignup.astro";
import homeRegionOgImage from "../assets/home/region-stories/szent-gyorgy-hegy-sunrise-sticky-bg.webp";
import { toAbsoluteUrl } from "../data/site-seo";
import { buildVideoObject } from "../data/video-seo";

const baseHref = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const googleLogoSrc = `${baseHref}images/brand/google-logo-compact-optimized-v2.png`;
const googleReviewsHref =
  "https://www.google.com/search?kgmid=/g/11hz165_7h&hl=hu-HU&q=Dandelion+Vend%C3%A9gh%C3%A1zak&ludocid=15014288750502118884#lrd=0x476907f1d1cff15f:0xd05d7811c8d285e4,1,,,";

const d2Reviews = [
  {
    source: "Google",
    logoSrc: googleLogoSrc,
    logoAlt: "Google értékelés",
    quote: "„Idilli környezet, kedves házigazdák, sok hely a gyerekeknek és nyugodt, szerethető hangulat.”",
    meta: "Vanessa L. · Google · 5/5"
  },
  {
    source: "Google",
    logoSrc: googleLogoSrc,
    logoAlt: "Google értékelés",
    quote: "„A ház minden igényt kielégít, és jó szívvel ajánlom annak, aki pár napra elvonulna.”",
    meta: "Ildikó Barna · Google · 5/5"
  },
  {
    source: "Google",
    logoSrc: googleLogoSrc,
    logoAlt: "Google értékelés",
    quote: "„Szép, rendezett hely, csendes környezet és gördülékeny érkezés. Kifejezetten jó pihenéshez.”",
    meta: "Eszter K. · Google · 5/5"
  },
  {
    source: "Booking.com",
    logoSrc: `${baseHref}images/brand/booking-logo.svg`,
    logoAlt: "Booking.com értékelés",
    quote: "„Abszolút pozitív élmény, gyors válaszokkal és nagyon segítőkész házigazdákkal.”",
    meta: "Bernadett · Booking.com · 10/10"
  },
  {
    source: "Booking.com",
    logoSrc: `${baseHref}images/brand/booking-logo.svg`,
    logoAlt: "Booking.com értékelés",
    quote: "„Tökéletes pihentető napokhoz: csendes hely, barátságos házigazdák és kényelmes szállás.”",
    meta: "Angelika · Booking.com · 9,0/10"
  }
] as const;

const d2MobileGoogleReviews = d2Reviews.filter((review) => review.source === "Google").slice(0, 2);
const d2MobileBookingReviews = d2Reviews.filter((review) => review.source === "Booking.com").slice(0, 2);
const d2VisibleReviews = d2Reviews;
const d2MobileVisibleReviews = d2Reviews.slice(0, 2);
const d2HiddenReviews = d2Reviews.slice(2);
const homepageOgImageAlt = "Napfelkelte a Szent György-hegyről a Tapolcai-medencére nézve";
// [CHANGE 2026-05-29 00:00] Homepage hero video now has poster and VideoObject data for Google indexing.
const homepageHeroVideo = "/videos/fooldal/hero/DND_Fooldal_hero_05-21.mp4?v=20260521";
const homepageHeroMobileVideo = "/videos/fooldal/hero/DND_Fooldal_hero_05-21-mobile-lite.mp4?v=20260606-mobile-lite";
const homepageHeroPoster = homeRegionOgImage.src;
const homepageStructuredData = [
  {
    "@context": "https://schema.org",
    "@type": "ImageObject",
    "@id": `${toAbsoluteUrl("/")}#homepage-region-image`,
    contentUrl: toAbsoluteUrl(homeRegionOgImage.src),
    url: toAbsoluteUrl(homeRegionOgImage.src),
    name: "Szent György-hegy napfelkelte panoráma",
    description: homepageOgImageAlt,
    caption: homepageOgImageAlt,
    inLanguage: "hu-HU"
  },
  buildVideoObject({
    id: "/#homepage-hero-video",
    name: "Dandelion Vendégházak főoldali hangulatvideó",
    description: "Főoldali Dandelion hangulatvideó a Balaton-felvidéki vendégházak bemutatásához.",
    contentUrl: homepageHeroVideo,
    thumbnailUrl: homepageHeroPoster,
    uploadDate: "2026-05-21T00:00:00+02:00",
    inLanguage: "hu-HU"
  })
];
---

<BaseLayout
  title="Dandelion Vendégházak | Szállás a Balaton-felvidéken"
  description="Természetközeli vendégházak a Balaton-felvidéken és a Balaton közelében, közvetlen foglalással, nyugodt környezetben és egyedi pihenési élménnyel."
  ogImage={homeRegionOgImage.src}
  ogImageAlt={homepageOgImageAlt}
  structuredData={homepageStructuredData}
>
  <Hero
    videoDesktopSrc={homepageHeroVideo}
    videoMobileSrc={homepageHeroMobileVideo}
    posterSrc={homepageHeroPoster}
    posterAlt={homepageOgImageAlt}
  />
  <PanoramaPoolHighlight />
  <section class="d2-reviews dnd-section" aria-labelledby="homepage-reviews-title">
    <div class="dnd-container">
      <div class="d2-reviews__shell">
        <div class="d2-reviews__heading">
          <span class="dnd-section-kicker">Vendégértékelések</span>
          <h2 id="homepage-reviews-title" class="d2-reviews__title">Vendégeink szerint</h2>
          <p class="d2-reviews__intro">Valódi vendégértékelések Google és Booking.com forrásból</p>
        </div>

        <div class="d2-reviews__grid">
          {d2VisibleReviews.map((review) => (
            <article class="d2-review-card">
              <div class="d2-review-card__top">
                {review.source === "Booking.com" ? (
                  <span class="d2-review-card__booking-wordmark" aria-label={review.logoAlt}>Booking</span>
                ) : (
                  <img
                    src={review.logoSrc}
                    alt={review.logoAlt}
                    width={82}
                    height={24}
                    class:list={["d2-review-card__logo", "is-google"]}
                    loading="lazy"
                    decoding="async"
                  />
                )}
                <span class="d2-review-card__stars" aria-hidden="true">★★★★★</span>
              </div>
              <blockquote class="d2-review-card__quote">{review.quote}</blockquote>
              <p class="d2-review-card__meta">{review.meta}</p>
            </article>
          ))}
        </div>

        <div class="d2-reviews__mobile-grid" aria-label="Vendégértékelések mobil rács">
          {d2MobileVisibleReviews.map((review) => (
            <article class="d2-review-card d2-review-card--mobile-grid">
              <div class="d2-review-card__top d2-review-card__top--mobile-grid">
                {review.source === "Booking.com" ? (
                  <span class="d2-review-card__booking-wordmark" aria-label={review.logoAlt}>Booking</span>
                ) : (
                  <img
                    src={review.logoSrc}
                    alt={review.logoAlt}
                    width={82}
                    height={24}
                    class:list={["d2-review-card__logo", "is-google"]}
                    loading="lazy"
                    decoding="async"
                  />
                )}
                <span class="d2-review-card__stars" aria-hidden="true">★★★★★</span>
              </div>
              <blockquote class="d2-review-card__quote">{review.quote}</blockquote>
              <p class="d2-review-card__meta">{review.meta}</p>
            </article>
          ))}
        </div>

        <details class="d2-reviews__more d2-reviews__more--cards">
          <summary>További vélemények</summary>
          <div
            class="d2-reviews__grid d2-reviews__grid--more"
            style="display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; width: 100%;"
          >
            {d2HiddenReviews.map((review) => (
              <article class="d2-review-card d2-review-card--mobile-grid">
                <div class="d2-review-card__top d2-review-card__top--mobile-grid">
                  {review.source === "Booking.com" ? (
                    <span class="d2-review-card__booking-wordmark" aria-label={review.logoAlt}>Booking</span>
                  ) : (
                    <img
                      src={review.logoSrc}
                      alt={review.logoAlt}
                      width={82}
                      height={24}
                      class:list={["d2-review-card__logo", "is-google"]}
                      loading="lazy"
                      decoding="async"
                    />
                  )}
                  <span
                    class:list={[
                      "d2-review-card__stars",
                      "d2-review-card__stars--mobile-grid",
                      review.source === "Booking.com" && "d2-review-card__stars--mobile-booking"
                    ]}
                    aria-hidden="true"
                  >
                    ★★★★★
                  </span>
                </div>
                <blockquote class="d2-review-card__quote">{review.quote}</blockquote>
                <p class="d2-review-card__meta">{review.meta}</p>
              </article>
            ))}
          </div>
        </details>

        <a class="d2-reviews__google-link" href={googleReviewsHref} target="_blank" rel="noopener noreferrer">
          Google értékelések
        </a>

        <div class="d2-reviews__mobile d2-reviews__mobile--legacy">
          <section class="d2-reviews__mobile-group" aria-label="Kiemelt Google értékelés">
            <div class="d2-reviews__mobile-head">
              <img
                src={googleLogoSrc}
                alt="Google értékelés"
                width={82}
                height={24}
                class="d2-reviews__mobile-logo is-google"
                loading="lazy"
                decoding="async"
              />
            </div>
            <article class="d2-review-card d2-review-card--mobile">
              <div class="d2-review-card__top d2-review-card__top--mobile">
                <span class="d2-review-card__stars" aria-hidden="true">★★★★★</span>
              </div>
              <blockquote class="d2-review-card__quote">{d2MobileGoogleReviews[0]?.quote}</blockquote>
              <p class="d2-review-card__meta">{d2MobileGoogleReviews[0]?.meta}</p>
            </article>
          </section>

          <details class="d2-reviews__more">
            <summary>További vélemények</summary>

            <section class="d2-reviews__mobile-group" aria-label="További Google értékelések">
              <div class="d2-reviews__mobile-head">
                <img
                  src={googleLogoSrc}
                  alt="Google értékelés"
                  width={82}
                  height={24}
                  class="d2-reviews__mobile-logo is-google"
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <div class="d2-reviews__mobile-list">
                {d2MobileGoogleReviews.slice(1).map((review) => (
                  <article class="d2-review-card d2-review-card--mobile">
                    <div class="d2-review-card__top d2-review-card__top--mobile">
                      <span class="d2-review-card__stars" aria-hidden="true">★★★★★</span>
                    </div>
                    <blockquote class="d2-review-card__quote">{review.quote}</blockquote>
                    <p class="d2-review-card__meta">{review.meta}</p>
                  </article>
                ))}
              </div>
            </section>

            <section class="d2-reviews__mobile-group" aria-label="Booking.com értékelések">
              <div class="d2-reviews__mobile-head">
                <img
                  src={`${baseHref}images/brand/booking-logo.svg`}
                  alt="Booking.com értékelés"
                  width={96}
                  height={24}
                  class="d2-reviews__mobile-logo is-booking"
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <div class="d2-reviews__mobile-list">
                {d2MobileBookingReviews.map((review) => (
                  <article class="d2-review-card d2-review-card--mobile">
                    <div class="d2-review-card__top d2-review-card__top--mobile">
                      <span class="d2-review-card__stars" aria-hidden="true">★★★★★</span>
                    </div>
                    <blockquote class="d2-review-card__quote">{review.quote}</blockquote>
                    <p class="d2-review-card__meta">{review.meta}</p>
                  </article>
                ))}
              </div>
            </section>
          </details>
        </div>
      </div>
    </div>
  </section>
  <section class="d2-region-guide dnd-section" aria-labelledby="homepage-region-guide-title">
    <div class="dnd-container d2-region-guide__container">
      <span class="d2-region-guide__kicker">SZÁLLÁSOK TÉRSÉGEK SZERINT</span>
      <p id="homepage-region-guide-title" class="d2-region-guide__text">
        A szállásokat terület szerint rendeztük. Lent külön blokkban találod a Tapolcai-medence, a
        Balaton melletti és a Káli-medencei házakat.
      </p>
    </div>
  </section>
  <RegionStories />
  <Experiences />
  <NewsletterSignup />
  <GoogleRegionMap />
</BaseLayout>

<style>
  .d2-reviews {
    padding-top: 18px;
    padding-bottom: 20px;
  }

  .d2-region-guide {
    padding: 10px 0 18px;
  }

  .d2-region-guide__container {
    display: grid;
    gap: 8px;
    justify-items: center;
    text-align: center;
  }

  .d2-region-guide__kicker {
    color: #9c7a34;
    font-size: var(--dnd-text-sm);
    font-weight: 700;
    font-family: var(--dnd-font-display);
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .d2-region-guide__kicker::after {
    content: "";
    display: block;
    width: 64px;
    height: 1px;
    margin: 10px auto 0;
    background: rgba(156, 122, 52, 0.32);
  }

  .d2-region-guide__text {
    margin: 0;
    max-width: 520px;
    color: rgba(0, 0, 0, 0.72);
    font-size: var(--dnd-text-xs);
    font-weight: 400;
    line-height: 1.5;
  }

  .d2-reviews__shell {
    padding: 20px 22px 22px;
    border: 1px solid rgba(91, 70, 42, 0.1);
    border-radius: 8px;
    background: linear-gradient(180deg, rgba(253, 251, 247, 0.96), rgba(247, 242, 231, 0.88));
  }

  .d2-reviews__heading {
    max-width: 680px;
    margin: 0 auto 16px;
    text-align: center;
  }

  .d2-reviews__title {
    margin: 0;
    font-family: var(--dnd-font-display);
    font-size: clamp(1.65rem, 2.7vw, 2.3rem);
    line-height: 1.08;
    font-weight: 500;
  }

  .d2-reviews__intro {
    margin: 8px 0 0;
    color: rgba(0, 0, 0, 0.64);
    font-size: var(--dnd-text-md);
    line-height: 1.52;
    opacity: 0.75;
  }

  .d2-reviews__grid {
    display: grid;
    gap: 14px;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    max-width: 100%;
    margin: 0 auto;
  }

  .d2-reviews__grid--more {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    max-width: 900px;
    margin-top: 12px;
  }

  .d2-reviews__mobile {
    display: none;
  }

  .d2-reviews__mobile-grid {
    display: none;
  }

  .d2-review-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 6px;
    min-width: 0;
    padding: 12px 12px 10px;
    border: 1px solid rgba(0, 0, 0, 0.06);
    border-radius: 8px;
    background: #ffffff;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .d2-review-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.06);
  }

  .d2-review-card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }

  .d2-review-card__logo {
    display: block;
    width: auto;
    max-width: 100%;
    height: 18px;
    object-fit: contain;
    object-position: left center;
  }

  .d2-review-card__booking-wordmark {
    min-width: 0;
    color: #003b95;
    font-size: var(--dnd-text-sm);
    font-weight: 800;
    line-height: 1;
    white-space: nowrap;
  }

  .d2-review-card__stars {
    color: rgba(217, 158, 43, 0.85);
    font-size: var(--dnd-text-2xs);
    letter-spacing: 0.08em;
    white-space: nowrap;
  }

  .d2-review-card__quote {
    margin: 0 0 6px;
    color: rgba(0, 0, 0, 0.78);
    font-size: var(--dnd-text-xs);
    line-height: 1.45;
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .d2-review-card__meta {
    margin: 0;
    color: rgba(0, 0, 0, 0.7);
    font-size: var(--dnd-text-2xs);
    font-weight: 600;
    letter-spacing: 0.03em;
    line-height: 1.35;
  }

  .d2-reviews__mobile-group {
    display: grid;
    gap: 10px;
  }

  .d2-reviews__mobile-head {
    display: flex;
    align-items: center;
  }

  .d2-reviews__mobile-logo {
    display: block;
    height: auto;
    object-fit: contain;
  }

  .d2-reviews__mobile-logo.is-google {
    width: 58px;
  }

  .d2-reviews__mobile-logo.is-booking {
    width: 72px;
  }

  .d2-reviews__mobile-list {
    display: grid;
    gap: 8px;
  }

  .d2-reviews__more {
    display: none;
    gap: 10px;
  }

  .d2-reviews__more--cards {
    margin-top: 14px;
    justify-items: center;
  }

  .d2-reviews__more summary {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    cursor: pointer;
    color: #d99e2b;
    font-size: var(--dnd-text-sm);
    font-weight: 600;
    line-height: 1.4;
    list-style: none;
  }

  .d2-reviews__more--cards summary {
    min-height: 42px;
    padding: 0 16px;
    border: 1px solid rgba(217, 158, 43, 0.28);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.72);
  }

  .d2-reviews__google-link {
    display: block;
    width: fit-content;
    margin: 8px auto 0;
    color: rgba(26, 115, 232, 0.88);
    font-size: var(--dnd-text-xs);
    font-weight: 500;
    line-height: 1.35;
    text-align: center;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  .d2-reviews__google-link:hover {
    color: #1a73e8;
  }

  .d2-reviews__more summary::-webkit-details-marker {
    display: none;
  }

  .d2-reviews__more summary::after {
    content: "▾";
    font-size: var(--dnd-text-2xs);
    transition: transform 0.2s ease;
  }

  .d2-reviews__more[open] summary {
    margin-bottom: 10px;
  }

  .d2-reviews__more[open] summary::after {
    transform: rotate(180deg);
  }

  .d2-review-card--mobile {
    gap: 5px;
    padding: 0;
  }

  .d2-review-card__top--mobile {
    justify-content: flex-start;
  }

  .d2-review-card--mobile-grid {
    gap: 8px;
  }

  .d2-review-card__top--mobile-grid {
    align-items: flex-start;
  }

  .d2-review-card__logo-crop {
    display: inline-flex;
    overflow: hidden;
    flex: 0 0 auto;
  }

  .d2-review-card__logo--mobile-booking {
    width: auto;
    max-width: none;
    height: 18px;
  }

  .d2-review-card__logo-crop--mobile-booking {
    width: 68px;
    padding-right: 10px;
  }

  @media (max-width: 768px) {
    .d2-reviews__grid {
      display: none;
    }

    .d2-reviews__more--cards {
      display: grid;
      margin-top: 12px;
      justify-items: stretch;
    }

    .d2-reviews__more--cards summary {
      justify-self: center;
    }

    .d2-reviews__more--cards .d2-reviews__grid--more {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 10px;
      width: 100%;
      max-width: none;
      margin-top: 10px;
    }

    .d2-reviews__mobile-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 10px;
    }

    .d2-reviews__mobile--legacy {
      display: none;
    }

    .d2-reviews__more {
      gap: 12px;
    }

    .d2-reviews__more[open] summary {
      margin-bottom: 10px;
    }

    .d2-reviews__more .d2-reviews__mobile-group + .d2-reviews__mobile-group {
      margin-top: 24px;
    }

    .d2-review-card--mobile {
      border: 0;
      border-radius: 0;
      background: none;
      box-shadow: none;
      padding: 0;
      min-height: 0;
    }

    .d2-review-card--mobile-grid {
      min-height: 168px;
      padding: 12px 10px 10px 10px;
    }

    .d2-reviews__mobile-list {
      gap: 12px;
    }

    .d2-review-card__top--mobile {
      gap: 6px;
    }

    .d2-review-card__top--mobile-grid {
      gap: 6px;
      justify-content: flex-start;
    }

    .d2-review-card__logo-crop--mobile-booking {
      width: 68px;
      padding-right: 10px;
    }

    .d2-review-card--mobile .d2-review-card__quote {
      margin-bottom: 2px;
      font-size: var(--dnd-text-xs);
      line-height: 1.35;
    }

    .d2-review-card--mobile-grid .d2-review-card__quote {
      margin-bottom: 2px;
      font-size: var(--dnd-text-2xs);
      line-height: 1.35;
      -webkit-line-clamp: 4;
    }

    .d2-review-card--mobile .d2-review-card__meta {
      letter-spacing: 0;
      font-size: var(--dnd-text-2xs);
      line-height: 1.3;
    }

    .d2-review-card--mobile-grid .d2-review-card__meta {
      letter-spacing: 0;
      font-size: var(--dnd-text-2xs);
      line-height: 1.3;
    }

    .d2-reviews__shell {
      padding: 22px 18px 18px;
    }

    .d2-region-guide {
      padding: 6px 0 14px;
    }

    .d2-region-guide__container {
      gap: 6px;
    }

    .d2-region-guide__kicker {
      font-size: var(--dnd-text-xs);
      letter-spacing: 0.16em;
    }

    .d2-region-guide__kicker::after {
      width: 56px;
      margin-top: 8px;
    }

    .d2-region-guide__text {
      max-width: 320px;
      font-size: var(--dnd-text-2xs);
      line-height: 1.4;
    }

    .d2-reviews__heading {
