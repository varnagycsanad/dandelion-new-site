---
import BaseLayout from "../layouts/BaseLayout.astro";

const contactItems = [
  {
    label: "Telefon",
    value: "+36 20 773 0807",
    href: "tel:+36207730807"
  },
  {
    label: "E-mail",
    value: "hello@dandelionhouse.hu",
    href: "mailto:hello@dandelionhouse.hu"
  },
  {
    label: "WhatsApp",
    value: "Írj közvetlenül",
    href: "https://wa.me/36207730807"
  }
];
---

<BaseLayout
  title="Kapcsolat | Dandelion Vendégházak"
  description="Kapcsolatfelvétel a Dandelion Vendégházakkal: telefon, e-mail, WhatsApp és közvetlen foglalási elérhetőség."
  canonicalPath="/kapcsolat/"
>
  <section class="info-page">
    <div class="dnd-container info-page__inner">
      <div class="info-page__hero">
        <span class="info-page__eyebrow">Kapcsolat</span>
        <h1>Segítünk megtalálni a hozzád illő szállást.</h1>
        <p>
          Ha kérdésed van a szállásokkal, a foglalással vagy az elérhető időpontokkal kapcsolatban,
          itt tudsz a leggyorsabban elérni minket.
        </p>
      </div>

      <div class="info-page__grid">
        {contactItems.map((item) => (
          <a class="info-card" href={item.href} target={item.href.startsWith("https://") ? "_blank" : undefined} rel={item.href.startsWith("https://") ? "noopener noreferrer" : undefined}>
            <span class="info-card__label">{item.label}</span>
            <strong>{item.value}</strong>
          </a>
        ))}
      </div>

      <div class="info-page__note">
        <h2>Foglalás</h2>
        <p>
          Az online foglalás a hivatalos foglalási felületen történik. Ha előbb egyeztetnél, írj vagy hívj
          minket, és segítünk a megfelelő ház kiválasztásában.
        </p>
        <a
          class="info-page__cta"
          href="https://ibe.sabeeapp.com/v3/p/Dandelion-Vendégházak?p=3970b30e1042d58f&lang=Hu"
          target="_blank"
          rel="noopener noreferrer"
        >
          Elérhetőség ellenőrzése
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .info-page {
    padding: 132px 0 88px;
    background: linear-gradient(180deg, #f7f2ea 0%, #fcfbf8 100%);
  }

  .info-page__inner {
    display: grid;
    gap: 28px;
  }

  .info-page__hero {
    max-width: 760px;
  }

  .info-page__eyebrow {
    display: inline-block;
    margin-bottom: 10px;
    color: #b67b20;
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .info-page h1 {
    margin: 0;
    color: #261d16;
    font-family: "Playfair Display", Georgia, "Times New Roman", serif;
    font-size: clamp(2.2rem, 4vw, 3.8rem);
    font-weight: 500;
    line-height: 1.05;
  }

  .info-page__hero p,
  .info-page__note p {
    margin: 14px 0 0;
    color: rgba(38, 29, 22, 0.76);
    font-size: 1rem;
    line-height: 1.72;
  }

  .info-page__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
  }

  .info-card,
  .info-page__note {
    padding: 24px;
    border: 1px solid rgba(88, 63, 38, 0.12);
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.92);
    box-shadow: 0 18px 48px rgba(48, 34, 20, 0.06);
  }

  .info-card {
    display: grid;
    gap: 8px;
    color: #261d16;
    text-decoration: none;
  }

  .info-card__label {
    color: rgba(38, 29, 22, 0.56);
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .info-card strong {
    font-size: 1.05rem;
    line-height: 1.5;
  }

  .info-page__note {
    max-width: 760px;
  }

  .info-page__note h2 {
    margin: 0;
    color: #261d16;
    font-size: 1.2rem;
    line-height: 1.3;
  }

  .info-page__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 46px;
    margin-top: 22px;
    padding: 0 22px;
    border-radius: 999px;
    background: #d99e2b;
    color: #1b140f;
    font-size: 0.88rem;
    font-weight: 700;
    text-decoration: none;
  }

  @media (max-width: 900px) {
    .info-page__grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 767px) {
    .info-page {
      padding: 110px 0 64px;
    }

    .info-card,
    .info-page__note {
      padding: 20px;
      border-radius: 16px;
    }
  }
</style>
