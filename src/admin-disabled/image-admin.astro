      function getApartmentImageRoleState(apartmentKey, mediaId) {
        if (!apartmentKey || !mediaId) {
          return {
            role: "none",
            sortOrder: ""
          };
        }

        const config = apartmentImageAssignments[apartmentKey];

        if (!config) {
          return {
            role: "none",
            sortOrder: ""
          };
        }

        if (config.hero?.desktop === mediaId) {
          return {
            role: "hero-desktop",
            sortOrder: ""
          };
        }

        if (config.hero?.mobile === mediaId) {
          return {
            role: "hero-mobile",
            sortOrder: ""
          };
        }

        const galleryItem = (config.gallery || []).find((item) => Number(item.id) === Number(mediaId));

        if (galleryItem) {
          return {
            role: "gallery",
            sortOrder: String(galleryItem.sortOrder ?? 0)
          };
        }

        return {
          role: "none",
          sortOrder: ""
        };
      }

      function getApartmentGalleryIdsFromAssignments(apartmentKey) {
        return Object.entries(apartmentAssignments)
          .filter(([, assignedApartmentKey]) => assignedApartmentKey === apartmentKey)
          .map(([mediaId]) => Number(mediaId))
          .filter((mediaId) => Number.isInteger(mediaId) && mediaId > 0);
      }

      function getApartmentGalleryOrderedIds(apartmentKey) {
        if (!apartmentKey || apartmentKey === "all") {
          return [];
        }

        const draftIds = apartmentGalleryOrderDrafts[apartmentKey];

        if (Array.isArray(draftIds)) {
          return draftIds;
        }

        const legacyIds = getApartmentGalleryIdsFromAssignments(apartmentKey);
        const config = ensureApartmentImageConfig(apartmentKey);
        const galleryIds = (config.gallery || []).map((item) => Number(item.id));
        const sortOrderById = new Map(
          (config.gallery || []).map((item) => [Number(item.id), Number(item.sortOrder)])
        );
        const combinedIds = [...legacyIds];

        galleryIds.forEach((mediaId) => {
          if (!combinedIds.includes(mediaId)) {
            combinedIds.push(mediaId);
          }
        });

        const originalIndexById = new Map(
          combinedIds.map((mediaId, index) => [mediaId, index])
        );

        return combinedIds.sort((leftId, rightId) => {
          const leftSortOrder = sortOrderById.get(leftId);
          const rightSortOrder = sortOrderById.get(rightId);
          const leftHasSortOrder = Number.isFinite(leftSortOrder);
          const rightHasSortOrder = Number.isFinite(rightSortOrder);

          if (leftHasSortOrder && rightHasSortOrder && leftSortOrder !== rightSortOrder) {
            return leftSortOrder - rightSortOrder;
          }

          if (leftHasSortOrder !== rightHasSortOrder) {
            return leftHasSortOrder ? -1 : 1;
          }

          return (originalIndexById.get(leftId) || 0) - (originalIndexById.get(rightId) || 0);
        });
      }

      function resetApartmentGalleryOrderDraft(apartmentKey) {
        if (!apartmentKey || apartmentKey === "all") {
          return;
        }

        delete apartmentGalleryOrderDrafts[apartmentKey];
      }

      function setApartmentGalleryOrderDraft(apartmentKey, orderedIds) {
        if (!apartmentKey || apartmentKey === "all") {
          return;
        }

        apartmentGalleryOrderDrafts[apartmentKey] = orderedIds
          .map((id) => Number(id))
          .filter((id) => Number.isInteger(id) && id > 0);
      }

      function getApartmentGalleryOrderedIdsFromDom() {
        if (!galleryOrderList) {
