---
import BaseLayout from "../layouts/BaseLayout.astro";
import { homepageImageSlots } from "../data/homepage-image-slots";
import {
  readHomepageImageMapping,
  type HomepageImageMapping
} from "../lib/homepage-image-mapping";
import {
  apartmentOptions,
  readMediaApartmentAssignments
} from "../lib/media-apartment-assignments";
import { readApartmentImageAssignments } from "../lib/apartment-image-assignments";
import {
  readMediaSeoFields,
  themeRoomOptions
} from "../lib/media-seo-fields";
import { fetchWordPressMedia } from "../lib/wp-media";

const baseHref = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const requestedSlot = Astro.url.searchParams.get("slot");
const initialSlotKey =
  homepageImageSlots.find((slot) => slot.key === requestedSlot)?.key ||
  homepageImageSlots[0].key;

let mapping: HomepageImageMapping = await readHomepageImageMapping();
const apartmentAssignments = await readMediaApartmentAssignments();
const apartmentImageAssignments = await readApartmentImageAssignments();
const mediaSeoFields = await readMediaSeoFields();
let mediaItems = [];
let mediaError = "";
let mediaWarning = "";

try {
  const mediaResult = await fetchWordPressMedia();
  mediaItems = mediaResult.items;
  mediaError = mediaResult.error;
  mediaWarning = mediaResult.warning;
} catch (error) {
  mediaError =
    error instanceof Error ? error.message : "A WordPress média lekérése nem sikerült.";
}

const initialState = {
  slots: homepageImageSlots,
  mapping,
  apartmentOptions,
  apartmentAssignments,
  apartmentImageAssignments,
  themeRoomOptions,
  mediaSeoFields,
  mediaItems,
  initialSlotKey,
  initialApartmentFilter: "all",
  initialQuickFilters: {
    missingAlt: false,
    unassignedApartment: false
  }
};
const initialSelectedMedia =
  mediaItems.find((item) => item.id === mapping[initialSlotKey]?.id) || null;
---

<BaseLayout hideHeader={true} hideFooter={true} title="Képkezelő admin" description="Dandelion WP média és főoldali képhoztárendelések kezelése.">
  <section class="dnd-image-admin">
    <div class="dnd-container">
      <div class="dnd-image-admin__header">
        <div>
          <span class="dnd-image-admin__eyebrow">WP képkezelő</span>
          <h1 class="dnd-image-admin__title">Dandelion Image Admin</h1>
          <p class="dnd-image-admin__lead">
            A képek továbbra is a WordPress médiatárból jönnek. A főoldali és lakásoldali
            kezelést itt külön nézetben éred el.
          </p>
        </div>

        <form id="dnd-image-admin-save-form" class="dnd-image-admin__save" method="post" data-admin-tab="homepage">
          <input id="dnd-image-admin-slot-input" type="hidden" value={initialSlotKey} />
          <input id="dnd-image-admin-mapping-input" type="hidden" value={JSON.stringify(mapping)} />
          <button class="dnd-btn dnd-btn--primary" type="submit">Mentés</button>
        </form>
      </div>

      <div class="dnd-image-admin__tabs" role="tablist" aria-label="Image admin nézetek">
        <button
          type="button"
          class="dnd-image-admin__tab is-active"
          data-admin-tab-button="homepage"
        >
          Főoldal képek
        </button>
        <button
          type="button"
          class="dnd-image-admin__tab"
          data-admin-tab-button="apartments"
        >
          Lakásoldalak képei
        </button>
      </div>

      <p id="dnd-image-admin-save-success" class="dnd-image-admin__notice dnd-image-admin__notice--success is-hidden">
        A kép-hozzárendelések elmentve.
      </p>
      <p id="dnd-image-admin-save-error" class="dnd-image-admin__notice dnd-image-admin__notice--error is-hidden">
        Hiba: A mentés nem sikerült.
      </p>
      <p id="dnd-image-admin-meta-success" class="dnd-image-admin__notice dnd-image-admin__notice--success is-hidden">
        A kép meta adatai elmentve.
      </p>
      <p id="dnd-image-admin-meta-error" class="dnd-image-admin__notice dnd-image-admin__notice--error is-hidden">
        Hiba: A meta mentése nem sikerült.
      </p>
      <p id="dnd-image-admin-apartment-success" class="dnd-image-admin__notice dnd-image-admin__notice--success is-hidden">
        A lakás hozzárendelése elmentve.
      </p>
      <p id="dnd-image-admin-apartment-error" class="dnd-image-admin__notice dnd-image-admin__notice--error is-hidden">
        Hiba: A lakás hozzárendelése nem sikerült.
      </p>
      <p id="dnd-image-admin-bulk-success" class="dnd-image-admin__notice dnd-image-admin__notice--success is-hidden">
        A kiválasztott képek lakás-hozzárendelése elmentve.
      </p>
      <p id="dnd-image-admin-bulk-error" class="dnd-image-admin__notice dnd-image-admin__notice--error is-hidden">
        Hiba: A tömeges lakás-hozzárendelés nem sikerült.
      </p>
      <p id="dnd-image-admin-bulk-seo-success" class="dnd-image-admin__notice dnd-image-admin__notice--success is-hidden">
        A kijelölt képek SEO javaslatai elkészültek.
      </p>
      <p id="dnd-image-admin-bulk-seo-error" class="dnd-image-admin__notice dnd-image-admin__notice--error is-hidden">
        Hiba: A tömeges SEO javaslat nem sikerült.
      </p>
      <p id="dnd-image-admin-seo-success" class="dnd-image-admin__notice dnd-image-admin__notice--success is-hidden">
        A kép SEO mezőit elmentettük.
      </p>
      <p id="dnd-image-admin-seo-error" class="dnd-image-admin__notice dnd-image-admin__notice--error is-hidden">
        Hiba: A kép SEO mezőinek mentése nem sikerült.
      </p>
      {mediaWarning && <p class="dnd-image-admin__notice dnd-image-admin__notice--warning">{mediaWarning}</p>}
      {mediaError && <p class="dnd-image-admin__notice dnd-image-admin__notice--error">Hiba: {mediaError}</p>}

      <div class="dnd-image-admin__layout">
        <aside class="dnd-image-admin__sidebar">
          <div class="dnd-image-admin__panel" data-admin-tab="apartments">
            <h2>Új kép beemelése a képrendszerbe</h2>
            <form id="dnd-image-admin-intake-form" class="dnd-image-admin__intake-form">
              <label class="dnd-image-admin__field">
                <span>WP media ID</span>
                <input id="dnd-image-admin-intake-wp-id" type="number" min="1" inputmode="numeric" />
              </label>
              <label class="dnd-image-admin__field">
                <span>Apartman kulcs</span>
                <select id="dnd-image-admin-intake-apartment">
                  {apartmentOptions
                    .filter((option) => option.key !== "all")
                    .map((option) => (
                      <option value={option.key} selected={option.key === "d2"}>
                        {option.key}
                      </option>
                    ))}
                </select>
              </label>
              <label class="dnd-image-admin__field">
                <span>Role</span>
                <select id="dnd-image-admin-intake-role">
                  <option value="gallery" selected>gallery</option>
                  <option value="hero_desktop">hero_desktop</option>
                  <option value="hero_mobile">hero_mobile</option>
                  <option value="card">card</option>
                  <option value="thumbnail">thumbnail</option>
                </select>
              </label>
              <label class="dnd-image-admin__field">
                <span>Theme</span>
                <input id="dnd-image-admin-intake-theme" type="text" />
              </label>
              <label class="dnd-image-admin__field">
                <span>Room</span>
                <input id="dnd-image-admin-intake-room" type="text" />
              </label>
              <label class="dnd-image-admin__field">
                <span>Sort order</span>
                <input id="dnd-image-admin-intake-sort-order" type="number" min="0" inputmode="numeric" />
              </label>
              <div class="dnd-image-admin__intake-actions">
                <button
                  id="dnd-image-admin-intake-use-selected"
                  class="dnd-btn dnd-btn--secondary"
                  type="button"
                >
                  Kiválasztott kép használata
                </button>
                <button
                  id="dnd-image-admin-intake-preview"
                  class="dnd-btn dnd-btn--secondary"
                  type="button"
                >
                  Előnézet
                </button>
                <button
                  id="dnd-image-admin-intake-submit"
                  class="dnd-btn dnd-btn--primary"
                  type="button"
                >
                  Beemelés source inventoryba
                </button>
              </div>
              <p id="dnd-image-admin-intake-status" class="dnd-image-admin__panel-text">
                Add meg a WP media ID-t és az alap mezőket, majd kérj előnézetet vagy valós intake-et.
              </p>
              <pre id="dnd-image-admin-intake-output" class="dnd-image-admin__intake-output">Még nincs válasz.</pre>
            </form>
          </div>

          <div class="dnd-image-admin__panel" data-admin-tab="apartments">
            <h2>Feldolgozásra váró képek</h2>
            <form id="dnd-image-admin-source-list-form" class="dnd-image-admin__intake-form">
              <div class="dnd-image-admin__source-summary">
                <div class="dnd-image-admin__source-summary-head">
                  <h3 class="dnd-image-admin__source-summary-title">Képfeldolgozási állapot</h3>
                  <p class="dnd-image-admin__panel-text">Az aktuális apartman candidate-jeinek rövid összesítése.</p>
                </div>
                <div id="dnd-image-admin-source-summary-grid" class="dnd-image-admin__source-summary-grid">
                  <div class="dnd-image-admin__source-summary-empty">Nincs betöltött állapot.</div>
                </div>
              </div>
              <label class="dnd-image-admin__field">
                <span>Apartman kulcs</span>
                <select id="dnd-image-admin-source-list-apartment">
                  {apartmentOptions
                    .filter((option) => option.key !== "all")
                    .map((option) => (
                      <option value={option.key} selected={option.key === "d2"}>
                        {option.key}
                      </option>
                    ))}
                </select>
              </label>
              <div class="dnd-image-admin__intake-actions">
                <button
                  id="dnd-image-admin-source-list-refresh"
                  class="dnd-btn dnd-btn--secondary"
                  type="button"
                >
                  Lista frissítése
                </button>
              </div>
              <p id="dnd-image-admin-source-list-status" class="dnd-image-admin__panel-text">
                Itt a source inventory source_found és selected elemei ellenőrizhetők.
              </p>
              <pre id="dnd-image-admin-source-list-output" class="dnd-image-admin__intake-output">Még nincs lista betöltve.</pre>
              <div id="dnd-image-admin-source-list" class="dnd-image-admin__source-list"></div>
            </form>
          </div>

          <div class="dnd-image-admin__panel" data-admin-tab="apartments">
            <h2>Lakás</h2>
            <label class="dnd-image-admin__field dnd-image-admin__apartment-select-field">
              <span>Lakás</span>
              <select id="dnd-image-admin-apartment-filter-select">
                {apartmentOptions.map((option) => (
                  <option value={option.key} selected={option.key === "all"}>
                    {option.label}
                  </option>
                ))}
              </select>
            </label>
          </div>

          <div class="dnd-image-admin__panel" data-admin-tab="homepage">
            <h2>Képhelyek</h2>
            <div class="dnd-image-admin__slot-list">
              {homepageImageSlots.map((slot) => (
                <button
                  type="button"
                  class:list={[
                    "dnd-image-admin__slot-button",
                    slot.key === initialSlotKey && "is-active"
                  ]}
                  data-slot-key={slot.key}
                >
                  <span class="dnd-image-admin__slot-label">{slot.label}</span>
                  <span class="dnd-image-admin__slot-description">{slot.description}</span>
                  <span class="dnd-image-admin__slot-current">
                    {mapping[slot.key]?.title || "Nincs kép kiválasztva"}
                  </span>
                </button>
              ))}
            </div>
          </div>
        </aside>

        <div class="dnd-image-admin__content">
          <div class="dnd-image-admin__panel dnd-image-admin__panel--current">
            <div class="dnd-image-admin__current-head" data-admin-tab="homepage">
              <div>
                <p class="dnd-image-admin__panel-kicker">Aktuális slot</p>
                <h2 id="dnd-image-admin-current-slot-title">
                  {homepageImageSlots.find((slot) => slot.key === initialSlotKey)?.label}
                </h2>
                <p id="dnd-image-admin-current-slot-description" class="dnd-image-admin__panel-text">
                  {homepageImageSlots.find((slot) => slot.key === initialSlotKey)?.description}
                </p>
              </div>
              <button id="dnd-image-admin-clear-button" class="dnd-btn dnd-btn--secondary" type="button">
                Kijelölés törlése
              </button>
            </div>

            <div class="dnd-image-admin__current-head" data-admin-tab="apartments">
              <div>
                <p class="dnd-image-admin__panel-kicker">Aktív lakás</p>
                <h2 id="dnd-image-admin-current-apartment-title">Válassz lakást</h2>
                <p id="dnd-image-admin-current-apartment-description" class="dnd-image-admin__panel-text">
                  Itt a kiválasztott lakás hero képeit és galériasorrendjét kezeled.
                </p>
              </div>
            </div>

            <div
              id="dnd-image-admin-gallery-order-panel"
              class="dnd-image-admin__gallery-order is-hidden"
              data-admin-tab="apartments"
            >
              <div class="dnd-image-admin__gallery-order-head">
                <div>
                  <h3 class="dnd-image-admin__gallery-order-title">Lakásoldali galéria sorrend</h3>
                  <p class="dnd-image-admin__gallery-order-text">
                    Húzd át a képeket a kívánt sorrendbe.
                  </p>
                </div>
                <button
                  id="dnd-image-admin-gallery-order-save"
                  class="dnd-btn dnd-btn--secondary dnd-image-admin__meta-submit"
                  type="button"
                >
                  Galéria sorrend mentése
                </button>
              </div>
              <div id="dnd-image-admin-gallery-order-list" class="dnd-image-admin__gallery-order-list"></div>
            </div>

            <div class="dnd-image-admin__current-card">
              <div class="dnd-image-admin__preview-column" data-admin-tab="homepage">
                <div id="dnd-image-admin-preview" class="dnd-image-admin__preview">
                {
                  mapping[initialSlotKey] ? (
                    <img
                      src={mapping[initialSlotKey]?.thumbnailUrl || mapping[initialSlotKey]?.sourceUrl}
                      alt={mapping[initialSlotKey]?.altText || mapping[initialSlotKey]?.title || ""}
                    />
                  ) : (
                    <div class="dnd-image-admin__preview-empty">
                      <strong>Nincs kiválasztott kép</strong>
                      <span>Válassz egy képet a médiatárból, és itt fog megjelenni az előnézet.</span>
                    </div>
                  )
                }
                </div>

                <details class="dnd-image-admin__sizes" open={false}>
                  <summary>Elérhető méretek</summary>
                  <div id="dnd-image-admin-sizes"></div>
                </details>
              </div>

              <div id="dnd-image-admin-current-meta" class="dnd-image-admin__current-meta">
                <div class="dnd-image-admin__apartment-hero-grid" data-admin-tab="apartments">
                  <article class="dnd-image-admin__apartment-hero-card">
                    <span class="dnd-image-admin__panel-kicker">Hero desktop</span>
                    <div id="dnd-image-admin-apartment-hero-desktop-preview" class="dnd-image-admin__apartment-hero-preview">
                      <div class="dnd-image-admin__apartment-hero-empty">Nincs kép</div>
                    </div>
                    <strong id="dnd-image-admin-apartment-hero-desktop-title">Nincs beállítva</strong>
                    <span id="dnd-image-admin-apartment-hero-desktop-meta" class="dnd-image-admin__panel-text">-</span>
                  </article>
                  <article class="dnd-image-admin__apartment-hero-card">
                    <span class="dnd-image-admin__panel-kicker">Hero mobile</span>
                    <div id="dnd-image-admin-apartment-hero-mobile-preview" class="dnd-image-admin__apartment-hero-preview">
                      <div class="dnd-image-admin__apartment-hero-empty">Nincs kép</div>
                    </div>
                    <strong id="dnd-image-admin-apartment-hero-mobile-title">Nincs beállítva</strong>
                    <span id="dnd-image-admin-apartment-hero-mobile-meta" class="dnd-image-admin__panel-text">-</span>
                  </article>
                </div>
                <div data-admin-tab="homepage">
                  <p class="dnd-image-admin__panel-kicker">Kiválasztott kép</p>
                  <h3 id="dnd-image-admin-current-image-title">
                    {mapping[initialSlotKey]?.title || "Nincs kiválasztott kép"}
                  </h3>
                  <p id="dnd-image-admin-current-image-alt" class="dnd-image-admin__panel-text">
                    {mapping[initialSlotKey]?.altText || "Nincs alt szöveg."}
                  </p>
                  <p id="dnd-image-admin-current-image-media-id" class="dnd-image-admin__panel-text">
                    WP media ID: {initialSelectedMedia?.id || "-"}
                  </p>
                  <button
                    id="dnd-image-admin-current-image-use-for-intake"
                    class:list={[
                      "dnd-btn",
                      "dnd-btn--secondary",
                      !initialSelectedMedia && "is-hidden"
                    ]}
                    type="button"
                  >
                    Kiválasztott kép használata beemeléshez
                  </button>
                  <a
                    id="dnd-image-admin-current-image-link"
                    class:list={[
                      "dnd-image-admin__source-link",
                      !mapping[initialSlotKey]?.sourceUrl && "is-hidden"
                    ]}
                    href={mapping[initialSlotKey]?.sourceUrl || "#"}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    Eredeti kép megnyitása
                  </a>

                  <details class="dnd-image-admin__meta-editor" open>
                  <summary>Cím / Meta adatok</summary>
                  <form id="dnd-image-admin-meta-form" class="dnd-image-admin__meta-form">
                    <label class="dnd-image-admin__field">
                      <span>Fájlnév</span>
                      <input
                        id="dnd-image-admin-meta-filename"
                        type="text"
                        value={initialSelectedMedia?.filename || ""}
                        readonly
                      />
                    </label>
                    <label class="dnd-image-admin__field">
                      <span>Alt szöveg</span>
                      <input
                        id="dnd-image-admin-meta-alt"
                        type="text"
                        value={initialSelectedMedia?.altText || ""}
                        disabled={!initialSelectedMedia}
                      />
                    </label>
                    <label class="dnd-image-admin__field">
                      <span>Cím</span>
                      <input
                        id="dnd-image-admin-meta-title"
                        type="text"
                        value={initialSelectedMedia?.title || ""}
                        disabled={!initialSelectedMedia}
                      />
                    </label>
                    <label class="dnd-image-admin__field">
                      <span>Leírás</span>
                      <textarea
                        id="dnd-image-admin-meta-description"
                        rows="3"
                        disabled={!initialSelectedMedia}
                      >{initialSelectedMedia?.description || ""}</textarea>
                    </label>
                    <div class="dnd-image-admin__seo-fields">
                      <label class="dnd-image-admin__field">
                        <span>Téma / helyiség</span>
                        <select
                          id="dnd-image-admin-seo-theme-room"
                          disabled={!initialSelectedMedia}
                        >
                          {themeRoomOptions.map((option) => (
                            <option
                              value={option.key}
                              selected={mediaSeoFields[String(initialSelectedMedia?.id || "")]?.themeRoom === option.key}
                            >
                              {option.label}
                            </option>
                          ))}
                        </select>
                      </label>
                      <label class="dnd-image-admin__field">
                        <span>Fókusz / részlet</span>
                        <input
                          id="dnd-image-admin-seo-feature-focus"
                          type="text"
                          value={mediaSeoFields[String(initialSelectedMedia?.id || "")]?.featureFocus || ""}
                          disabled={!initialSelectedMedia}
                        />
                      </label>
                      <div class="dnd-image-admin__seo-actions">
                        <button
                          id="dnd-image-admin-suggest-alt"
                          class="dnd-btn dnd-btn--secondary dnd-image-admin__meta-submit"
                          type="button"
                          disabled={!initialSelectedMedia}
                        >
                          ALT javaslat
                        </button>
                        <button
                          id="dnd-image-admin-suggest-title"
                          class="dnd-btn dnd-btn--secondary dnd-image-admin__meta-submit"
                          type="button"
                          disabled={!initialSelectedMedia}
                        >
                          Title javaslat
                        </button>
                        <button
                          id="dnd-image-admin-seo-submit"
                          class="dnd-btn dnd-btn--secondary dnd-image-admin__meta-submit"
                          type="button"
                          disabled={!initialSelectedMedia}
                        >
                          SEO mezők mentése
                        </button>
                      </div>
                    </div>
                    <label class="dnd-image-admin__field" hidden>
                      <span>Hozzárendelt lakás</span>
                      <select
                        id="dnd-image-admin-apartment-select"
                        disabled={!initialSelectedMedia}
                      >
                        <option value="">Nincs hozzárendelve</option>
                        {apartmentOptions
                          .filter((option) => option.key !== "all")
                          .map((option) => (
                            <option
                              value={option.key}
                              selected={apartmentAssignments[String(initialSelectedMedia?.id || "")] === option.key}
                            >
                              {option.label}
                            </option>
                        ))}
                      </select>
                    </label>
                    <div class="dnd-image-admin__apartment-image-fields" hidden>
                      <label class="dnd-image-admin__field">
                        <span>Lakásoldali szerep</span>
                        <select
                          id="dnd-image-admin-apartment-role"
                          disabled={!initialSelectedMedia}
                        >
                          <option value="none">none</option>
                          <option value="hero-desktop">hero-desktop</option>
                          <option value="hero-mobile">hero-mobile</option>
                          <option value="gallery">gallery</option>
                        </select>
                      </label>
                      <label class="dnd-image-admin__field" hidden>
                        <span>Kézi galéria sortOrder (másodlagos)</span>
                        <input
                          id="dnd-image-admin-apartment-sort-order"
                          type="number"
                          inputmode="numeric"
                          min="0"
                          step="1"
                          placeholder="0"
                          disabled={!initialSelectedMedia}
                        />
                      </label>
                    </div>
                    <button
                      id="dnd-image-admin-apartment-submit"
                      class="dnd-btn dnd-btn--secondary dnd-image-admin__meta-submit"
                      type="button"
                      hidden
                      disabled={!initialSelectedMedia}
                    >
                      Lakás-kép beállítás mentése
                    </button>
                    <button
                      id="dnd-image-admin-meta-submit"
                      class="dnd-btn dnd-btn--secondary dnd-image-admin__meta-submit"
                      type="submit"
                      data-admin-tab="homepage"
                      disabled={!initialSelectedMedia}
                    >
                      Meta adatok mentése
                    </button>
                  </form>
                </details>
                </div>

              </div>
            </div>
          </div>

          <div class="dnd-image-admin__panel">
            <div class="dnd-image-admin__media-head">
              <div>
                <h2 id="dnd-image-admin-media-panel-title">WordPress média</h2>
                <p id="dnd-image-admin-media-panel-description" class="dnd-image-admin__panel-text">
                  Betöltött képek száma: {mediaItems.length}
                </p>
              </div>
              <div class="dnd-image-admin__media-tools">
                <div class="dnd-image-admin__quick-filters">
                  <button
                    id="dnd-image-admin-filter-missing-alt"
                    class="dnd-image-admin__quick-filter"
                    type="button"
                  >
