        return Array.from(galleryOrderList.querySelectorAll("[data-gallery-order-item]"))
          .map((item) => Number(item.getAttribute("data-media-id")))
          .filter((id) => Number.isInteger(id) && id > 0);
      }

      function getMediaCardRoleBadgeState(apartmentKey, mediaId) {
        if (!apartmentKey || apartmentKey === "all" || !mediaId) {
          return null;
        }

        const roleState = getApartmentImageRoleState(apartmentKey, mediaId);

        if (roleState.role === "hero-desktop") {
          return {
            text: "HERO D",
            tone: "hero"
          };
        }

        if (roleState.role === "hero-mobile") {
          return {
            text: "HERO M",
            tone: "hero"
          };
        }

        if (roleState.role === "gallery") {
          return {
            text: `G #${roleState.sortOrder || "0"}`,
            tone: "gallery"
          };
        }

        return null;
      }

