      function toLowerTrimmedWords(value) {
        return String(value || "")
          .trim()
          .toLowerCase()
          .replace(/\s+/g, " ");
      }

      function toSentenceCase(value) {
        const normalized = String(value || "").trim();

        if (!normalized) {
          return "";
        }

        return normalized.charAt(0).toUpperCase() + normalized.slice(1);
      }

      function getFeaturePhrase(value) {
        const normalized = toLowerTrimmedWords(value);
        const phrases = {
          kandallo: "kandallóval",
          "nagy ablak": "nagy ablakokkal",
          panoramas: "panorámás",
          zuhanyzo: "zuhanyzóval",
          "fa gerenda": "fa gerendával",
          "reggeli feny": "reggeli fényben"
        };

        return phrases[normalized] || normalized;
      }

      function buildApartmentPlaceSuffix(apartmentLabel) {
        if (!apartmentLabel) {
          return "";
        }

        if (apartmentLabel === "D1" || apartmentLabel === "D2") {
          return `a Dandelion ${apartmentLabel} apartmanban`;
        }

        if (apartmentLabel === "Royal Homes") {
          return "a Royal Homes szálláson";
        }

        return `a ${apartmentLabel}ban`;
      }

      function buildApartmentBySuffix(apartmentLabel) {
        if (!apartmentLabel) {
          return "";
        }

        if (apartmentLabel === "D1" || apartmentLabel === "D2") {
          return `a Dandelion ${apartmentLabel} apartmannál`;
        }

        if (apartmentLabel === "Royal Homes") {
          return "a Royal Homes szállásnál";
        }

        return `a ${apartmentLabel}nál`;
      }

      function buildAltSuggestionForValues(apartmentKey, themeRoomKey, featureFocusValue) {
        const apartmentLabel = getApartmentLabel(apartmentKey);
        const themeRoomLabel = getThemeRoomLabel(themeRoomKey);
        const featureValue = getFeaturePhrase(featureFocusValue);
        const apartmentSuffix = buildApartmentPlaceSuffix(apartmentLabel);
        const apartmentBySuffix = buildApartmentBySuffix(apartmentLabel);

        if (!apartmentLabel || !themeRoomLabel || !apartmentSuffix) {
          return "";
        }

        const specialTemplates = {
          terasz: featureValue
            ? `${toSentenceCase(featureValue)} terasz ${apartmentBySuffix}`
            : `Terasz ${apartmentBySuffix}`,
          nappali: featureValue
            ? `Nappali ${featureValue} ${apartmentSuffix}`
            : `Nappali ${apartmentSuffix}`,
          halo: featureValue
            ? `Hálószoba ${featureValue} ${apartmentSuffix}`
            : `Hálószoba ${apartmentSuffix}`,
          furdo: featureValue
            ? `Fürdőszoba ${featureValue} ${apartmentSuffix}`
            : `Fürdőszoba ${apartmentSuffix}`,
          panorama: featureValue
            ? `${toSentenceCase(featureValue)} panoráma ${apartmentBySuffix}`
            : `Panoráma ${apartmentBySuffix}`,
          kulso: featureValue
            ? `Külső nézet ${featureValue} ${apartmentBySuffix}`
            : `Külső nézet ${apartmentBySuffix}`,
          kornyek: featureValue
            ? `${toSentenceCase(featureValue)} környék ${apartmentBySuffix}`
            : `Környék ${apartmentBySuffix}`
        };

        if (specialTemplates[themeRoomKey]) {
          return specialTemplates[themeRoomKey];
        }

        if (featureValue) {
          return `${toSentenceCase(themeRoomLabel)} ${featureValue} ${apartmentSuffix}`;
        }

        return `${toSentenceCase(themeRoomLabel)} ${apartmentSuffix}`;
      }

      function buildAltSuggestion() {
        return buildAltSuggestionForValues(
          apartmentSelect?.value || getSelectedApartmentAssignment(),
          seoThemeRoom?.value || "",
          seoFeatureFocus?.value || ""
        );
      }

      function buildTitleSuggestionForValues(apartmentKey, themeRoomKey, featureFocusValue) {
        const apartmentLabel = getApartmentLabel(apartmentKey);
        const themeRoomLabel = getThemeRoomLabel(themeRoomKey);
        const featureValue = toSentenceCase(getFeaturePhrase(featureFocusValue));

        if (!apartmentLabel || !themeRoomLabel) {
          return "";
        }

        return featureValue
          ? `${apartmentLabel} | ${themeRoomLabel} | ${featureValue}`
          : `${apartmentLabel} | ${themeRoomLabel}`;
      }

      function buildTitleSuggestion() {
        return buildTitleSuggestionForValues(
          apartmentSelect?.value || getSelectedApartmentAssignment(),
          seoThemeRoom?.value || "",
          seoFeatureFocus?.value || ""
        );
      }

      function renderExtraSizeListItems(sizes) {
        return sizes
          .map((size) => {
            const dimensions =
              size.width && size.height ? `${size.width} × ${size.height}` : "Ismeretlen";

            return `
              <li class="dnd-image-admin__size-list-item">
                <div class="dnd-image-admin__size-list-copy">
                  <strong>${size.name}</strong>
                  <span>${dimensions}</span>
                </div>
                <a href="${size.url}" target="_blank" rel="noopener noreferrer">Megnyitás</a>
              </li>
            `;
          })
          .join("");
      }

      function getPrimarySizeLabel(sizeName) {
        const labels = {
          full: "Eredeti",
          large: "Desktop",
          medium_large: "Tablet",
          medium: "Kártya",
          thumbnail: "Mini"
        };

        return labels[sizeName] || sizeName;
      }

      function renderPrimarySizeCards(sizes) {
        return sizes
          .map((size) => {
            const dimensions =
              size.width && size.height ? `${size.width} × ${size.height}` : "Ismeretlen";

            return `
              <article class="dnd-image-admin__size-card">
                <div class="dnd-image-admin__size-card-head">
                  <strong>${size.name}</strong>
                  <span>${getPrimarySizeLabel(size.name)}</span>
                </div>
                <p class="dnd-image-admin__size-card-meta">${dimensions}</p>
                <a href="${size.url}" target="_blank" rel="noopener noreferrer">Megnyitás</a>
              </article>
            `;
          })
          .join("");
      }

      function renderSizes(selected) {
        if (!sizesContainer) {
          return;
        }

        const mediaItem = selected ? getMediaItem(selected.id) : null;
        const sizes = mediaItem?.sizes || [];
        const primarySizes = primarySizeNames
          .map((name) => sizes.find((size) => size.name === name))
          .filter(Boolean);
        const extraSizes = sizes.filter((size) => !primarySizeNames.includes(size.name));

        if (!sizes.length) {
          sizesContainer.innerHTML =
            '<p class="dnd-image-admin__sizes-empty">Ehhez a képhez nem érkezett méretinformáció.</p>';
          return;
        }

        const primaryRows = renderPrimarySizeCards(primarySizes);
        const extraRows = renderExtraSizeListItems(extraSizes);
        const primaryBlock = primarySizes.length
          ? `
            <div class="dnd-image-admin__sizes-group">
              <div class="dnd-image-admin__size-cards">
                ${primaryRows}
              </div>
            </div>
          `
          : '<p class="dnd-image-admin__sizes-empty">A kiemelt alapméretek közül egyik sem érhető el ehhez a képhez.</p>';
        const extraBlock = extraSizes.length
          ? `
            <details class="dnd-image-admin__sizes-details">
              <summary>Összes további méret (${extraSizes.length})</summary>
              <ul class="dnd-image-admin__size-list">
                ${extraRows}
              </ul>
            </details>
          `
          : "";

        sizesContainer.innerHTML = `
          <div class="dnd-image-admin__sizes-summary">Összes változat: ${sizes.length}</div>
          ${primaryBlock}
          ${extraBlock}
        `;
      }

      function syncHiddenInputs() {
        if (mappingInput) {
          mappingInput.value = JSON.stringify(mapping);
        }

        if (slotInput) {
          slotInput.value = activeSlotKey;
        }
      }

      function renderSlotList() {
        slotButtons.forEach((button) => {
          const slotKey = button.dataset.slotKey;
          const currentText = button.querySelector(".dnd-image-admin__slot-current");
          const selected = mapping[slotKey];

          button.classList.toggle("is-active", slotKey === activeSlotKey);

          if (currentText) {
            currentText.textContent = selected?.title || "Nincs kép kiválasztva";
          }
        });
      }

      function renderApartmentFilter() {
        if (apartmentFilterSelect) {
          apartmentFilterSelect.value = activeApartmentFilter;
        }
      }

      function renderAdminTabs() {
        if (imageAdminRoot) {
          imageAdminRoot.setAttribute("data-active-admin-tab", activeAdminTab);
        }

        adminTabButtons.forEach((button) => {
          button.classList.toggle("is-active", button.dataset.adminTabButton === activeAdminTab);
        });

        adminTabSections.forEach((section) => {
          section.hidden = section.getAttribute("data-admin-tab") !== activeAdminTab;
        });

        if (mediaPanelTitle) {
          mediaPanelTitle.textContent =
            activeAdminTab === "homepage" ? "WordPress média" : "Lakáshoz rendelt képek";
        }

        if (mediaPanelDescription) {
          mediaPanelDescription.textContent =
            activeAdminTab === "homepage"
              ? `Betöltött képek száma: ${state.mediaItems?.length || 0}`
              : activeApartmentFilter && activeApartmentFilter !== "all"
                ? `${getApartmentLabel(activeApartmentFilter)} képei és szerepei.`
                : "Válassz lakást a lakásoldali képek kezeléséhez.";
        }
      }

      function renderApartmentHeroSummary() {
        const apartmentKey = activeApartmentFilter;
        const config =
          apartmentKey && apartmentKey !== "all" ? ensureApartmentImageConfig(apartmentKey) : null;
        const desktopMedia = config?.hero?.desktop ? getMediaItem(config.hero.desktop) : null;
        const mobileMedia = config?.hero?.mobile ? getMediaItem(config.hero.mobile) : null;

        if (currentApartmentTitle) {
          currentApartmentTitle.textContent =
            apartmentKey && apartmentKey !== "all" ? getApartmentLabel(apartmentKey) : "Válassz lakást";
        }

        if (currentApartmentDescription) {
          currentApartmentDescription.textContent =
            apartmentKey && apartmentKey !== "all"
              ? "Itt a kiválasztott lakás hero képeit és galériasorrendjét kezeled."
              : "A lakásos nézethez először válassz egy lakást a bal oldali listából.";
        }

        if (apartmentHeroDesktopTitle) {
          apartmentHeroDesktopTitle.textContent = desktopMedia?.title || "Nincs beállítva";
        }

        if (apartmentHeroDesktopPreview) {
          apartmentHeroDesktopPreview.innerHTML = desktopMedia?.thumbnailUrl || desktopMedia?.sourceUrl
            ? `<img src="${desktopMedia.thumbnailUrl || desktopMedia.sourceUrl}" alt="${desktopMedia.altText || desktopMedia.title || ""}" />`
            : '<div class="dnd-image-admin__apartment-hero-empty">Nincs kép</div>';
        }

        if (apartmentHeroDesktopMeta) {
          apartmentHeroDesktopMeta.textContent =
            config?.hero?.desktop ? `ID: ${config.hero.desktop}` : "Adj a kiválasztott képnek hero-desktop szerepet.";
        }

        if (apartmentHeroMobileTitle) {
          apartmentHeroMobileTitle.textContent = mobileMedia?.title || "Nincs beállítva";
        }

        if (apartmentHeroMobilePreview) {
          apartmentHeroMobilePreview.innerHTML = mobileMedia?.thumbnailUrl || mobileMedia?.sourceUrl
            ? `<img src="${mobileMedia.thumbnailUrl || mobileMedia.sourceUrl}" alt="${mobileMedia.altText || mobileMedia.title || ""}" />`
            : '<div class="dnd-image-admin__apartment-hero-empty">Nincs kép</div>';
        }

        if (apartmentHeroMobileMeta) {
          apartmentHeroMobileMeta.textContent =
            config?.hero?.mobile ? `ID: ${config.hero.mobile}` : "Adj a kiválasztott képnek hero-mobile szerepet.";
        }
      }

      function renderQuickFilters() {
        if (quickFilterMissingAlt) {
          quickFilterMissingAlt.classList.toggle("is-active", Boolean(quickFilters.missingAlt));
        }

        if (quickFilterUnassignedApartment) {
          quickFilterUnassignedApartment.classList.toggle(
            "is-active",
            Boolean(quickFilters.unassignedApartment)
          );
        }
      }

      function renderBulkSelection() {
        const selectedIds = new Set(selectedBulkMediaIds.map((id) => String(id)));

        mediaCards.forEach((card) => {
          const isSelected = selectedIds.has(String(card.dataset.mediaId));
          card.dataset.bulkSelected = isSelected ? "true" : "false";
          card.classList.toggle("is-bulk-selected", isSelected);
        });

        mediaBulkToggleButtons.forEach((button) => {
          const isSelected = selectedIds.has(String(button.dataset.bulkToggle));
          button.classList.toggle("is-active", isSelected);
          button.setAttribute("aria-pressed", isSelected ? "true" : "false");
          button.textContent = isSelected ? "Kijelölve" : "Kijelölés";
        });

        if (bulkCount) {
          bulkCount.textContent = `${selectedBulkMediaIds.length} kép kijelölve`;
        }

        updateBulkSubmitState();
      }

      function renderMediaGridVisibility() {
        const searchTerm = searchInput?.value.trim().toLowerCase() || "";

        mediaCards.forEach((card) => {
          const haystack = `${card.dataset.title || ""} ${card.dataset.alt || ""}`;
          const apartmentKey = card.dataset.apartment || "";
          const matchesSearch = searchTerm.length === 0 || haystack.includes(searchTerm);
          const matchesApartment =
            activeAdminTab === "homepage" ||
            activeApartmentFilter === "all" ||
            apartmentKey === activeApartmentFilter;
          const matchesMissingAlt =
            !quickFilters.missingAlt || card.dataset.hasAlt !== "true";
          const matchesUnassignedApartment =
            !quickFilters.unassignedApartment || !apartmentKey;

          card.hidden =
            !matchesSearch ||
            !matchesApartment ||
            !matchesMissingAlt ||
            !matchesUnassignedApartment;
        });
      }

      function updateApartmentAssignmentState(mediaId, apartmentKey) {
        const previousApartmentKey = apartmentAssignments[String(mediaId)] || null;

        if (apartmentKey) {
          apartmentAssignments[String(mediaId)] = apartmentKey;
        } else {
          delete apartmentAssignments[String(mediaId)];
        }

        resetApartmentGalleryOrderDraft(previousApartmentKey);
        resetApartmentGalleryOrderDraft(apartmentKey);

        const mediaCard = mediaCards.find(
          (card) => Number(card.dataset.mediaId) === Number(mediaId)
        );

        if (mediaCard) {
          mediaCard.dataset.apartment = apartmentKey || "";
        }
      }

      function ensureApartmentImageConfig(apartmentKey) {
        if (!apartmentImageAssignments[apartmentKey]) {
          apartmentImageAssignments[apartmentKey] = {
            hero: {
              desktop: null,
              mobile: null
            },
            gallery: []
          };
        }

        return apartmentImageAssignments[apartmentKey];
      }

      function updateApartmentImageAssignmentState(mediaId, apartmentKey, role, sortOrder) {
        if (!apartmentKey) {
          return;
        }

        const config = ensureApartmentImageConfig(apartmentKey);

        if (config.hero?.desktop === mediaId) {
          config.hero.desktop = null;
        }

        if (config.hero?.mobile === mediaId) {
          config.hero.mobile = null;
        }

        config.gallery = (config.gallery || []).filter((item) => Number(item.id) !== Number(mediaId));

        if (role === "hero-desktop") {
          config.hero.desktop = mediaId;
        } else if (role === "hero-mobile") {
          config.hero.mobile = mediaId;
        } else if (role === "gallery") {
          config.gallery = [
            ...config.gallery,
            {
              id: mediaId,
              sortOrder: Number.isFinite(sortOrder) ? sortOrder : 0
            }
          ].sort((a, b) => a.sortOrder - b.sortOrder);
        }

        resetApartmentGalleryOrderDraft(apartmentKey);
      }

      function setApartmentGalleryOrderState(apartmentKey, orderedIds) {
        if (!apartmentKey || apartmentKey === "all") {
          return;
        }

        const config = ensureApartmentImageConfig(apartmentKey);

        config.gallery = orderedIds.map((mediaId, index) => ({
          id: mediaId,
          sortOrder: (index + 1) * 10
        }));

        resetApartmentGalleryOrderDraft(apartmentKey);
      }

      function updateApartmentAssignmentsState(mediaIds, apartmentKey) {
        mediaIds.forEach((mediaId) => {
          updateApartmentAssignmentState(mediaId, apartmentKey);
        });

        const selectedMediaItem = getSelectedMediaForEditor();

        if (
          apartmentSelect &&
          selectedMediaItem &&
          mediaIds.some((mediaId) => Number(mediaId) === Number(selectedMediaItem.id))
        ) {
          apartmentSelect.value = apartmentKey || "";
        }
      }

      function renderMediaSelection() {
        mediaCards.forEach((card) => {
          const mediaId = Number(card.dataset.mediaId);
          const selected = mapping[activeSlotKey];
          card.classList.toggle("is-selected", selected?.id === mediaId);
        });
      }

      function renderMediaRoleBadges() {
        mediaCards.forEach((card) => {
          const mediaId = Number(card.dataset.mediaId);
          const badge = card.querySelector("[data-role-badge]");
          const badgeState =
            activeAdminTab === "apartments"
              ? getMediaCardRoleBadgeState(activeApartmentFilter, mediaId)
              : null;

          if (!badge) {
            return;
          }

          if (!badgeState) {
            badge.textContent = "";
            badge.classList.add("is-hidden");
            badge.classList.remove("is-hero", "is-gallery");
            return;
          }

          badge.textContent = badgeState.text;
          badge.classList.remove("is-hidden");
          badge.classList.toggle("is-hero", badgeState.tone === "hero");
          badge.classList.toggle("is-gallery", badgeState.tone === "gallery");
        });

        mediaHeroButtons.forEach((button) => {
          const mediaId = Number(button.getAttribute("data-hero-media-id"));
          const variant = button.getAttribute("data-hero-variant");
          const config =
            activeAdminTab === "apartments" && activeApartmentFilter !== "all"
              ? ensureApartmentImageConfig(activeApartmentFilter)
              : null;
          const isActive =
            variant === "desktop"
              ? Number(config?.hero?.desktop) === mediaId
              : Number(config?.hero?.mobile) === mediaId;

          button.classList.toggle("is-active", isActive);
          button.disabled = activeAdminTab !== "apartments" || !activeApartmentFilter || activeApartmentFilter === "all";
        });
      }

      function renderApartmentGalleryOrder() {
        if (!galleryOrderPanel || !galleryOrderList || !galleryOrderSave) {
          return;
        }

        if (!activeApartmentFilter || activeApartmentFilter === "all") {
          galleryOrderPanel.classList.add("is-hidden");
          galleryOrderList.innerHTML = "";
          galleryOrderSave.disabled = true;
          return;
        }

        galleryOrderPanel.classList.remove("is-hidden");
        const orderedIds = getApartmentGalleryOrderedIds(activeApartmentFilter);

        if (!orderedIds.length) {
          galleryOrderList.innerHTML = `
            <div class="dnd-image-admin__gallery-order-empty">
              Ehhez a lakáshoz még nincs legacy vagy galéria-listás kép.
            </div>
          `;
          galleryOrderSave.disabled = isGalleryOrderSaving;
          return;
        }

        galleryOrderList.innerHTML = orderedIds
          .map((mediaId, index) => {
            const mediaItem = getMediaItem(mediaId);
            const imageUrl = mediaItem?.thumbnailUrl || mediaItem?.sourceUrl || "";

            return `
              <article
                class="dnd-image-admin__gallery-order-item"
                data-gallery-order-item="${mediaId}"
                data-media-id="${mediaId}"
                draggable="true"
              >
                <div class="dnd-image-admin__gallery-order-media">
                  <span class="dnd-image-admin__gallery-order-index">${index + 1}</span>
                  ${
                    imageUrl
                      ? `<img src="${imageUrl}" alt="${mediaItem?.altText || `Media #${mediaId}`}" />`
                      : '<div class="dnd-image-admin__gallery-order-placeholder">Nincs kep</div>'
                  }
                </div>
                <div class="dnd-image-admin__gallery-order-copy">
                  <span>ID: ${mediaId}</span>
                </div>
              </article>
            `;
          })
          .join("");

        galleryOrderSave.disabled = isGalleryOrderSaving;
      }

      function renderPreview() {
        const slot = getSlotDefinition(activeSlotKey);
        const selected = mapping[activeSlotKey];
        const selectedMediaItem = getSelectedMediaForEditor();

        if (currentSlotTitle) {
          currentSlotTitle.textContent = slot?.label || "";
        }

        if (currentSlotDescription) {
          currentSlotDescription.textContent = slot?.description || "";
        }

        if (!preview || !currentImageTitle || !currentImageAlt || !currentImageLink || !currentMeta) {
          return;
        }

        if (!selected) {
          preview.innerHTML = `
            <div class="dnd-image-admin__preview-empty">
              <strong>Nincs kiválasztott kép</strong>
              <span>Válassz egy képet a médiatárból, és itt fog megjelenni az előnézet.</span>
            </div>
          `;
          currentMeta.classList.add("is-empty");
          currentImageTitle.textContent = "Nincs kiválasztott kép";
          currentImageAlt.textContent = "Ha kiválasztasz egy képet, itt látod majd az alt szöveget és a fő méreteket.";
          if (currentImageMediaId) {
            currentImageMediaId.textContent = "WP media ID: -";
          }
          if (currentImageUseForIntakeButton) {
            currentImageUseForIntakeButton.classList.add("is-hidden");
          }
          currentImageLink.classList.add("is-hidden");
          currentImageLink.setAttribute("href", "#");
          renderMetaEditor(null);
          renderSizes(null);
          return;
        }

        preview.innerHTML = "";
        const image = document.createElement("img");
        image.src = selected.thumbnailUrl || selected.sourceUrl;
        image.alt = selected.altText || selected.title || "";
        preview.appendChild(image);

        currentMeta.classList.remove("is-empty");
        currentImageTitle.textContent = selectedMediaItem?.title || selected.title;
        currentImageAlt.textContent =
          selectedMediaItem?.altText || selected.altText || "Nincs alt szöveg.";
        if (currentImageMediaId) {
          currentImageMediaId.textContent = `WP media ID: ${selectedMediaItem?.id || "-"}`;
        }
        if (currentImageUseForIntakeButton) {
          currentImageUseForIntakeButton.classList.remove("is-hidden");
        }
        currentImageLink.classList.remove("is-hidden");
        currentImageLink.setAttribute("href", selected.sourceUrl);
        renderMetaEditor(selectedMediaItem);
        renderSizes(selected);
      }

      function renderAll() {
        syncHiddenInputs();
        updateIntakeUiState();
        if (metaSuccess) {
          metaSuccess.classList.add("is-hidden");
        }
        if (metaError) {
          metaError.classList.add("is-hidden");
        }
        if (apartmentSuccess) {
          apartmentSuccess.classList.add("is-hidden");
        }
        if (apartmentError) {
          apartmentError.classList.add("is-hidden");
        }
        if (bulkSuccess) {
          bulkSuccess.classList.add("is-hidden");
        }
        if (bulkError) {
          bulkError.classList.add("is-hidden");
        }
        if (bulkSeoSuccess) {
          bulkSeoSuccess.classList.add("is-hidden");
        }
        if (bulkSeoError) {
          bulkSeoError.classList.add("is-hidden");
        }
        if (seoSuccess) {
          seoSuccess.classList.add("is-hidden");
        }
        if (seoError) {
          seoError.classList.add("is-hidden");
        }
        renderAdminTabs();
        renderApartmentHeroSummary();
        renderApartmentFilter();
        renderQuickFilters();
        renderBulkSelection();
        renderSlotList();
        renderMediaSelection();
        renderMediaRoleBadges();
        renderApartmentGalleryOrder();
        renderMediaGridVisibility();
        renderPreview();
      }

      function showSaveMessage(success, message) {
        if (saveSuccess) {
          saveSuccess.classList.toggle("is-hidden", !success);
        }

        if (saveError) {
          saveError.classList.toggle("is-hidden", success);
          if (!success) {
            saveError.textContent = `Hiba: ${message}`;
          }
        }
      }

      slotButtons.forEach((button) => {
        button.addEventListener("click", () => {
          activeSlotKey = button.dataset.slotKey || activeSlotKey;
          renderAll();
        });
      });

      adminTabButtons.forEach((button) => {
        button.addEventListener("click", () => {
          activeAdminTab = button.dataset.adminTabButton || "homepage";
          renderAll();
        });
      });

      if (apartmentFilterSelect) {
        apartmentFilterSelect.addEventListener("change", () => {
          activeApartmentFilter = apartmentFilterSelect.value || "all";
          renderApartmentFilter();
          renderMediaRoleBadges();
          renderApartmentGalleryOrder();
          renderMediaGridVisibility();
        });
      }

      if (quickFilterMissingAlt) {
        quickFilterMissingAlt.addEventListener("click", () => {
          quickFilters.missingAlt = !quickFilters.missingAlt;
          renderQuickFilters();
          renderMediaGridVisibility();
        });
      }

      if (quickFilterUnassignedApartment) {
        quickFilterUnassignedApartment.addEventListener("click", () => {
          quickFilters.unassignedApartment = !quickFilters.unassignedApartment;
          renderQuickFilters();
          renderMediaGridVisibility();
        });
      }

      mediaOpenButtons.forEach((button) => {
        button.addEventListener("click", () => {
          const item = getMediaItem(button.dataset.openMedia);
          if (!item) {
            return;
          }

          mapping[activeSlotKey] = {
            id: item.id,
            title: item.title,
            altText: item.altText,
            sourceUrl: item.sourceUrl,
            thumbnailUrl: item.thumbnailUrl
          };

          renderAll();
        });
      });

      mediaBulkToggleButtons.forEach((button) => {
        button.addEventListener("click", () => {
          const mediaId = Number(button.dataset.bulkToggle);

          if (!mediaId) {
            return;
          }

          if (selectedBulkMediaIds.includes(mediaId)) {
            selectedBulkMediaIds = selectedBulkMediaIds.filter((id) => id !== mediaId);
          } else {
            selectedBulkMediaIds = [...selectedBulkMediaIds, mediaId];
          }

          if (bulkSuccess) {
            bulkSuccess.classList.add("is-hidden");
          }

          if (bulkError) {
            bulkError.classList.add("is-hidden");
          }

          if (bulkSeoSuccess) {
            bulkSeoSuccess.classList.add("is-hidden");
          }

          if (bulkSeoError) {
            bulkSeoError.classList.add("is-hidden");
          }

          renderBulkSelection();
          renderMediaGridVisibility();
        });
      });

      if (clearButton) {
        clearButton.addEventListener("click", () => {
          mapping[activeSlotKey] = null;
          renderAll();
        });
      }

      if (searchInput) {
        searchInput.addEventListener("input", () => {
          renderMediaGridVisibility();
        });
      }

      [metaAlt, metaTitle, metaDescription].forEach((field) => {
        if (!field) {
          return;
        }

        field.addEventListener("input", () => {
          if (metaSuccess) {
            metaSuccess.classList.add("is-hidden");
          }

          if (metaError) {
            metaError.classList.add("is-hidden");
          }

          updateMetaSubmitState(Boolean(getSelectedMediaForEditor()));
        });
      });

      [seoThemeRoom, seoFeatureFocus].forEach((field) => {
        if (!field) {
          return;
        }

        field.addEventListener("input", () => {
          if (seoSuccess) {
            seoSuccess.classList.add("is-hidden");
          }

          if (seoError) {
            seoError.classList.add("is-hidden");
          }

          updateSeoSubmitState(Boolean(getSelectedMediaForEditor()));
        });

        field.addEventListener("change", () => {
          if (seoSuccess) {
            seoSuccess.classList.add("is-hidden");
          }

          if (seoError) {
            seoError.classList.add("is-hidden");
          }

          updateSeoSubmitState(Boolean(getSelectedMediaForEditor()));
        });
      });

      if (apartmentSelect) {
        apartmentSelect.addEventListener("change", () => {
          if (apartmentSuccess) {
            apartmentSuccess.classList.add("is-hidden");
          }

          if (apartmentError) {
            apartmentError.classList.add("is-hidden");
          }

          renderMetaEditor(getSelectedMediaForEditor());
          updateApartmentSubmitState(Boolean(getSelectedMediaForEditor()));
        });
      }

      if (apartmentRoleSelect) {
        apartmentRoleSelect.addEventListener("change", () => {
          if (apartmentSuccess) {
            apartmentSuccess.classList.add("is-hidden");
          }

          if (apartmentError) {
            apartmentError.classList.add("is-hidden");
          }

          if (apartmentSortOrderInput) {
            const isGallery = apartmentRoleSelect.value === "gallery";
            apartmentSortOrderInput.disabled =
              !getSelectedMediaForEditor() || !apartmentSelect?.value || !isGallery;

            if (!isGallery) {
              apartmentSortOrderInput.value = "";
            }
          }
        });
      }

      if (apartmentSortOrderInput) {
        apartmentSortOrderInput.addEventListener("input", () => {
          if (apartmentSuccess) {
            apartmentSuccess.classList.add("is-hidden");
          }

          if (apartmentError) {
            apartmentError.classList.add("is-hidden");
          }
        });
      }

      if (bulkApartmentSelect) {
        bulkApartmentSelect.addEventListener("change", () => {
          if (bulkSuccess) {
            bulkSuccess.classList.add("is-hidden");
          }

          if (bulkError) {
            bulkError.classList.add("is-hidden");
          }

          if (bulkSeoSuccess) {
            bulkSeoSuccess.classList.add("is-hidden");
          }

          if (bulkSeoError) {
            bulkSeoError.classList.add("is-hidden");
          }

          updateBulkSubmitState();
        });
      }

      async function runBulkSeoSuggestion(kind) {
        const selectedIds = [...selectedBulkMediaIds];

        if (selectedIds.length === 0) {
          showBulkSeoMessage(false, "Előbb jelölj ki legalább egy képet.");
          return;
        }

        let updatedCount = 0;
        let skippedCount = 0;

        try {
          isBulkSeoSaving = true;
          updateBulkSubmitState();

          for (const mediaId of selectedIds) {
            const mediaItem = getMediaItem(mediaId);
            const seoFields = getSeoFieldsForMediaId(mediaId);
            const apartmentKey = apartmentAssignments[String(mediaId)] || "";
            const nextThemeRoom = seoFields.themeRoom || "";
            const nextFeatureFocus = seoFields.featureFocus || "";
            const currentAlt =
              mediaMetaOverrides[mediaId]?.altText ||
              mediaItem?.altText ||
              seoFields.altText ||
              "";
            const currentTitle =
              mediaMetaOverrides[mediaId]?.title ||
              mediaItem?.title ||
              seoFields.title ||
              "";

            if (!apartmentKey || !nextThemeRoom) {
              skippedCount += 1;
              continue;
            }

            const nextAltText =
              kind === "alt" && !currentAlt.trim()
                ? buildAltSuggestionForValues(apartmentKey, nextThemeRoom, nextFeatureFocus)
                : seoFields.altText || "";
            const nextTitle =
              kind === "title" && !currentTitle.trim()
                ? buildTitleSuggestionForValues(apartmentKey, nextThemeRoom, nextFeatureFocus)
                : seoFields.title || "";

            if (
              (kind === "alt" && !nextAltText) ||
              (kind === "title" && !nextTitle) ||
              (kind === "alt" && currentAlt.trim()) ||
              (kind === "title" && currentTitle.trim())
            ) {
              skippedCount += 1;
              continue;
            }

            const response = await fetch(apiUrl("save-seo-fields"), {
              method: "POST",
              headers: {
                "Content-Type": "application/json"
              },
              body: JSON.stringify({
                id: mediaId,
                themeRoom: nextThemeRoom,
                featureFocus: nextFeatureFocus,
                altText: kind === "alt" ? nextAltText : seoFields.altText || "",
                title: kind === "title" ? nextTitle : seoFields.title || ""
              })
            });

            if (!response.ok) {
              const payload = await response.json().catch(() => null);
              throw new Error(payload?.message || "A tömeges SEO javaslat mentése nem sikerült.");
            }

            const payload = await response.json();
            updateSeoFieldsState(payload?.id, {
              themeRoom: payload?.themeRoom || "",
              featureFocus: payload?.featureFocus || "",
              altText: payload?.altText || "",
              title: payload?.title || ""
            });

            updatedCount += 1;
          }

          renderMediaGridVisibility();
          renderPreview();

          const subject = kind === "alt" ? "ALT javaslat" : "Title javaslat";
          showBulkSeoMessage(
            true,
            `${subject}: ${updatedCount} képnél készült javaslat${skippedCount ? `, ${skippedCount} kép kimaradt.` : "."}`
          );
        } catch (error) {
          showBulkSeoMessage(
            false,
            error instanceof Error ? error.message : "A tömeges SEO javaslat mentése nem sikerült."
          );
        } finally {
          isBulkSeoSaving = false;
          updateBulkSubmitState();
        }
      }

      if (saveForm) {
        saveForm.addEventListener("submit", async (event) => {
          event.preventDefault();

          try {
            const response = await fetch(apiUrl("save"), {
              method: "POST",
              headers: {
                "Content-Type": "application/json"
              },
              body: mappingInput?.value || "{}"
            });

            if (!response.ok) {
              const payload = await response.json().catch(() => null);
              throw new Error(payload?.message || "A mentés nem sikerült.");
            }

            showSaveMessage(true, "");
          } catch (error) {
            showSaveMessage(
              false,
              error instanceof Error ? error.message : "A mentés nem sikerült."
            );
          }
        });
      }

      if (intakeForm) {
        intakeForm.addEventListener("submit", (event) => {
          event.preventDefault();
        });
      }

      if (sourceListForm) {
        sourceListForm.addEventListener("submit", (event) => {
          event.preventDefault();
        });
      }

      if (intakePreviewButton) {
        intakePreviewButton.addEventListener("click", async () => {
          await runIntakeRequest(true);
        });
      }

      if (intakeUseSelectedButton) {
        intakeUseSelectedButton.addEventListener("click", () => {
          useSelectedMediaForIntake();
        });
      }

      if (currentImageUseForIntakeButton) {
        currentImageUseForIntakeButton.addEventListener("click", () => {
          useSelectedMediaForIntake();
        });
      }

      if (intakeSubmitButton) {
        intakeSubmitButton.addEventListener("click", async () => {
          await runIntakeRequest(false);
        });
      }

      if (sourceListRefreshButton) {
        sourceListRefreshButton.addEventListener("click", async () => {
          await loadSourceCandidates();
        });
      }

      if (metaForm) {
        metaForm.addEventListener("submit", async (event) => {
          event.preventDefault();

          const selectedMediaItem = getSelectedMediaForEditor();

          if (!selectedMediaItem || !metaAlt || !metaTitle || !metaDescription) {
            showMetaMessage(false, "Nincs kiválasztott kép a meta adatok mentéséhez.");
            return;
          }

          try {
            isMetaSaving = true;
            updateMetaSubmitState(true);

            const response = await fetch(apiUrl("update-media"), {
              method: "POST",
              headers: {
                "Content-Type": "application/json"
              },
              body: JSON.stringify({
                id: selectedMediaItem.id,
                altText: metaAlt.value,
                title: metaTitle.value,
                description: metaDescription.value
              })
            });

            if (!response.ok) {
              const payload = await response.json().catch(() => null);
              throw new Error(payload?.message || "A meta mentése nem sikerült.");
            }

            const payload = await response.json();
            const nextMedia = payload?.media;

            if (!nextMedia?.id) {
              throw new Error("A WordPress nem adott vissza frissített média adatot.");
            }

            updateSelectedMediaState(nextMedia);
            currentImageTitle.textContent = nextMedia.title || "Nincs kiválasztott kép";
            currentImageAlt.textContent = nextMedia.altText || "Nincs alt szöveg.";
            renderAll();
            showMetaMessage(true, "");
          } catch (error) {
            showMetaMessage(
              false,
              error instanceof Error ? error.message : "A meta mentése nem sikerült."
            );
          } finally {
            isMetaSaving = false;
            updateMetaSubmitState(Boolean(getSelectedMediaForEditor()));
          }
        });
      }

      if (suggestAlt) {
        suggestAlt.addEventListener("click", () => {
          if (!metaAlt) {
            return;
          }

          const suggestion = buildAltSuggestion();

          if (!suggestion) {
            showSeoMessage(false, "Az ALT javaslathoz előbb adj meg lakást és témát vagy helyiséget.");
            return;
          }

          metaAlt.value = suggestion;
          updateMetaSubmitState(Boolean(getSelectedMediaForEditor()));
          if (seoSuccess) {
            seoSuccess.classList.add("is-hidden");
          }
          if (seoError) {
            seoError.classList.add("is-hidden");
          }
        });
      }

      if (suggestTitle) {
        suggestTitle.addEventListener("click", () => {
          if (!metaTitle) {
            return;
          }

          const suggestion = buildTitleSuggestion();

          if (!suggestion) {
            showSeoMessage(false, "A title javaslathoz előbb adj meg lakást és témát vagy helyiséget.");
            return;
          }

          metaTitle.value = suggestion;
          updateMetaSubmitState(Boolean(getSelectedMediaForEditor()));
          if (seoSuccess) {
            seoSuccess.classList.add("is-hidden");
          }
          if (seoError) {
            seoError.classList.add("is-hidden");
          }
        });
      }

      if (seoSubmit) {
        seoSubmit.addEventListener("click", async () => {
          const selectedMediaItem = getSelectedMediaForEditor();

          if (!selectedMediaItem || !seoThemeRoom || !seoFeatureFocus) {
            showSeoMessage(false, "Nincs kiválasztott kép a SEO mezők mentéséhez.");
            return;
          }

          try {
            isSeoSaving = true;
            updateSeoSubmitState(true);

            const response = await fetch(apiUrl("save-seo-fields"), {
              method: "POST",
              headers: {
                "Content-Type": "application/json"
              },
              body: JSON.stringify({
                id: selectedMediaItem.id,
                themeRoom: seoThemeRoom.value || "",
                featureFocus: seoFeatureFocus.value || ""
              })
            });

            if (!response.ok) {
              const payload = await response.json().catch(() => null);
              throw new Error(payload?.message || "A SEO mezők mentése nem sikerült.");
            }

            const payload = await response.json();
            updateSeoFieldsState(payload?.id, {
              themeRoom: payload?.themeRoom || "",
              featureFocus: payload?.featureFocus || ""
            });
            showSeoMessage(true, "");
          } catch (error) {
            showSeoMessage(
              false,
              error instanceof Error ? error.message : "A SEO mezők mentése nem sikerült."
            );
          } finally {
            isSeoSaving = false;
            updateSeoSubmitState(Boolean(getSelectedMediaForEditor()));
          }
        });
      }

      if (apartmentSubmit) {
        apartmentSubmit.addEventListener("click", async () => {
          const selectedMediaItem = getSelectedMediaForEditor();

          if (!selectedMediaItem || !apartmentSelect) {
            showApartmentMessage(false, "Nincs kiválasztott kép a lakás hozzárendeléshez.");
            return;
          }

          try {
            isApartmentSaving = true;
            updateApartmentSubmitState(true);

            const response = await fetch(apiUrl("save-apartment"), {
              method: "POST",
              headers: {
                "Content-Type": "application/json"
              },
              body: JSON.stringify({
                id: selectedMediaItem.id,
                apartmentKey: apartmentSelect.value || null,
                role: apartmentRoleSelect?.value || "none",
                sortOrder: apartmentSortOrderInput?.value || ""
              })
            });

            if (!response.ok) {
              const payload = await response.json().catch(() => null);
              throw new Error(payload?.message || "A lakás hozzárendelése nem sikerült.");
            }

            const payload = await response.json();

            updateApartmentAssignmentState(payload?.id, payload?.apartmentKey || null);
            if (payload?.apartmentKey) {
              updateApartmentImageAssignmentState(
                payload.id,
                payload.apartmentKey,
                payload.role || "none",
                typeof payload.sortOrder === "number" ? payload.sortOrder : 0
              );
            }
            renderApartmentFilter();
            renderMediaRoleBadges();
            renderApartmentGalleryOrder();
            renderMediaGridVisibility();
            renderMetaEditor(getSelectedMediaForEditor());
            showApartmentMessage(true, "");
          } catch (error) {
            showApartmentMessage(
              false,
              error instanceof Error ? error.message : "A lakás hozzárendelése nem sikerült."
            );
          } finally {
            isApartmentSaving = false;
            updateApartmentSubmitState(Boolean(getSelectedMediaForEditor()));
          }
        });
      }

      if (galleryOrderList) {
        let draggedGalleryMediaId = null;

        galleryOrderList.addEventListener("dragstart", (event) => {
          const item = event.target instanceof HTMLElement ? event.target.closest("[data-gallery-order-item]") : null;

          if (!item || activeApartmentFilter === "all") {
            return;
          }

          draggedGalleryMediaId = Number(item.getAttribute("data-media-id"));
          item.classList.add("is-dragging");

          if (event.dataTransfer) {
            event.dataTransfer.effectAllowed = "move";
            event.dataTransfer.setData("text/plain", String(draggedGalleryMediaId));
          }
        });

        galleryOrderList.addEventListener("dragover", (event) => {
          const item = event.target instanceof HTMLElement ? event.target.closest("[data-gallery-order-item]") : null;

          if (!item || draggedGalleryMediaId == null) {
            return;
          }

          event.preventDefault();
          if (event.dataTransfer) {
            event.dataTransfer.dropEffect = "move";
          }
        });

        galleryOrderList.addEventListener("drop", (event) => {
          const item = event.target instanceof HTMLElement ? event.target.closest("[data-gallery-order-item]") : null;
          const targetMediaId = Number(item?.getAttribute("data-media-id"));

          if (!item || draggedGalleryMediaId == null || !Number.isInteger(targetMediaId)) {
            return;
          }

          event.preventDefault();

          const orderedIds = [...getApartmentGalleryOrderedIds(activeApartmentFilter)];
          const fromIndex = orderedIds.findIndex((id) => Number(id) === draggedGalleryMediaId);
          const toIndex = orderedIds.findIndex((id) => Number(id) === targetMediaId);

          if (fromIndex < 0 || toIndex < 0 || fromIndex === toIndex) {
            return;
          }

          const [movedId] = orderedIds.splice(fromIndex, 1);
          orderedIds.splice(toIndex, 0, movedId);
          setApartmentGalleryOrderDraft(activeApartmentFilter, orderedIds);
          renderApartmentGalleryOrder();
        });

        galleryOrderList.addEventListener("dragend", () => {
          draggedGalleryMediaId = null;
          galleryOrderList
            .querySelectorAll(".dnd-image-admin__gallery-order-item.is-dragging")
            .forEach((item) => item.classList.remove("is-dragging"));
        });
      }

      if (galleryOrderSave) {
        galleryOrderSave.addEventListener("click", async () => {
          if (!activeApartmentFilter || activeApartmentFilter === "all") {
            showApartmentMessage(false, "Valassz lakast a galeria sorrend mentesehez.");
            return;
          }

          try {
            isGalleryOrderSaving = true;
            renderApartmentGalleryOrder();
            const orderedIds = getApartmentGalleryOrderedIdsFromDom().length
              ? getApartmentGalleryOrderedIdsFromDom()
              : getApartmentGalleryOrderedIds(activeApartmentFilter);
            const bridgeConfig = getImageAdminBridgeConfig();
            const savePayload = JSON.stringify({
              apartmentKey: activeApartmentFilter,
              galleryIds: orderedIds
            });
            let saveUrl = apiUrl("save-apartment");
            let response;

            if (bridgeConfig) {
              saveUrl = `${bridgeConfig.restRoot.replace(/\/+$/, "")}/${bridgeConfig.endpoint.replace(/^\/+/, "")}`;
              response = await fetch(saveUrl, {
                method: "POST",
                credentials: "same-origin",
                headers: {
                  "Content-Type": "application/json",
                  "X-WP-Nonce": bridgeConfig.nonce
                },
                body: savePayload
              });
            } else {
              response = await fetch(saveUrl, {
                method: "POST",
                credentials: "same-origin",
                headers: {
                  "Content-Type": "application/json"
                },
                body: savePayload
              });
            }

            const responsePayload = await parseResponsePayload(response);

            if (!response.ok) {
              const errorDetails = summarizeResponsePayload(responsePayload.json || responsePayload.text);
              throw new Error(
                `Mentés sikertelen (${response.status}): ${
                  responsePayload.json?.message || responsePayload.text || response.statusText || "Ismeretlen hiba"
                }${errorDetails ? ` | ${errorDetails}` : ""}`
              );
            }

            const payload = responsePayload.json;
            setApartmentGalleryOrderState(
              payload?.apartmentKey || activeApartmentFilter,
              bridgeConfig
                ? orderedIds
                : (payload?.gallery || []).map((item) => Number(item.id)).filter((id) => Number.isInteger(id) && id > 0)
            );
            renderMediaRoleBadges();
            renderApartmentGalleryOrder();
            renderMetaEditor(getSelectedMediaForEditor());
            showApartmentMessage(
              true,
              `Mentve: ${summarizeResponsePayload(payload || responsePayload.text || { url: saveUrl }) || "OK"}`
            );
          } catch (error) {
            showApartmentMessage(
              false,
              error instanceof Error ? error.message : "Mentés sikertelen"
            );
          } finally {
            isGalleryOrderSaving = false;
            renderApartmentGalleryOrder();
          }
        });
      }

      if (mediaHeroButtons.length) {
        mediaHeroButtons.forEach((button) => {
          button.addEventListener("click", async (event) => {
            event.stopPropagation();

            if (!activeApartmentFilter || activeApartmentFilter === "all") {
              showApartmentMessage(false, "Valassz lakast a hero kep beallitasahoz.");
              return;
            }

            const variant = button.getAttribute("data-hero-variant");
            const mediaId = Number(button.getAttribute("data-hero-media-id"));

            if (!variant || !Number.isInteger(mediaId) || mediaId <= 0) {
              showApartmentMessage(false, "A hero kep beallitasa nem sikerult.");
              return;
            }

            try {
              const bridgeConfig = getImageAdminBridgeConfig();
              let response;

              if (bridgeConfig) {
                response = await fetch(
                  `${bridgeConfig.restRoot.replace(/\/+$/, "")}/apartment-hero-image`,
                  {
                    method: "POST",
                    credentials: "same-origin",
                    headers: {
                      "Content-Type": "application/json",
                      "X-WP-Nonce": bridgeConfig.nonce
                    },
                    body: JSON.stringify({
                      apartmentKey: activeApartmentFilter,
                      variant,
                      mediaId
                    })
                  }
                );
              } else {
                response = await fetch(apiUrl("save-apartment"), {
                  method: "POST",
                  headers: {
                    "Content-Type": "application/json"
                  },
                  body: JSON.stringify({
                    id: mediaId,
                    apartmentKey: activeApartmentFilter,
                    role: variant === "desktop" ? "hero-desktop" : "hero-mobile",
                    sortOrder: ""
                  })
                });
              }

              const payload = await parseResponsePayload(response);

              if (!response.ok) {
                throw new Error(
                  payload.json?.message || payload.text || `Hero mentés sikertelen (${response.status})`
                );
              }

              updateApartmentImageAssignmentState(
                mediaId,
                activeApartmentFilter,
                variant === "desktop" ? "hero-desktop" : "hero-mobile",
                ""
              );
              renderApartmentHeroSummary();
              renderMediaRoleBadges();
              showApartmentMessage(true, "Hero kép mentve.");
            } catch (error) {
              showApartmentMessage(
                false,
                error instanceof Error ? error.message : "Hero mentés sikertelen"
              );
            }
          });
        });
      }

      if (bulkClear) {
        bulkClear.addEventListener("click", () => {
          selectedBulkMediaIds = [];

          if (bulkSuccess) {
            bulkSuccess.classList.add("is-hidden");
          }

          if (bulkError) {
            bulkError.classList.add("is-hidden");
          }

          if (bulkSeoSuccess) {
            bulkSeoSuccess.classList.add("is-hidden");
          }

          if (bulkSeoError) {
            bulkSeoError.classList.add("is-hidden");
          }

          renderBulkSelection();
          renderMediaGridVisibility();
        });
      }

      if (bulkSuggestAlt) {
        bulkSuggestAlt.addEventListener("click", async () => {
          await runBulkSeoSuggestion("alt");
        });
      }

      if (bulkSuggestTitle) {
        bulkSuggestTitle.addEventListener("click", async () => {
          await runBulkSeoSuggestion("title");
        });
      }

      if (bulkSubmit) {
        bulkSubmit.addEventListener("click", async () => {
          if (!bulkApartmentSelect || !bulkApartmentSelect.value || selectedBulkMediaIds.length === 0) {
            showBulkMessage(false, "Válassz lakást és legalább egy képet a tömeges mentéshez.");
            return;
          }

          try {
            isBulkSaving = true;
            updateBulkSubmitState();

            const response = await fetch(apiUrl("save-apartments"), {
              method: "POST",
              headers: {
                "Content-Type": "application/json"
              },
              body: JSON.stringify({
                ids: selectedBulkMediaIds,
                apartmentKey: bulkApartmentSelect.value
              })
            });

            if (!response.ok) {
              const payload = await response.json().catch(() => null);
              throw new Error(payload?.message || "A tömeges lakás-hozzárendelés nem sikerült.");
            }

            const payload = await response.json();
            updateApartmentAssignmentsState(payload?.ids || [], payload?.apartmentKey || null);
            selectedBulkMediaIds = [];
            renderBulkSelection();
            renderMediaRoleBadges();
            renderApartmentGalleryOrder();
            renderMediaGridVisibility();
            showBulkMessage(true, "A kijelölt képek lakás-hozzárendelése elmentve.");
          } catch (error) {
            showBulkMessage(
              false,
              error instanceof Error ? error.message : "A tömeges lakás-hozzárendelés nem sikerült."
            );
          } finally {
            isBulkSaving = false;
            updateBulkSubmitState();
          }
        });
      }

      renderAll();
      renderSourceCandidates();
      loadSourceCandidates();
    }
  </script>

