---
import BaseLayout from "../layouts/BaseLayout.astro";
import { homepageImageSlots } from "../data/homepage-image-slots";
import {
  readHomepageImageMapping,
  type HomepageImageMapping
} from "../lib/homepage-image-mapping";
import {
  apartmentOptions,
  readMediaApartmentAssignments
} from "../lib/media-apartment-assignments";
import {
  readMediaSeoFields,
  themeRoomOptions
} from "../lib/media-seo-fields";
import { fetchWordPressMedia } from "../lib/wp-media";

const requestedSlot = Astro.url.searchParams.get("slot");
const initialSlotKey =
  homepageImageSlots.find((slot) => slot.key === requestedSlot)?.key ||
  homepageImageSlots[0].key;

let mapping: HomepageImageMapping = await readHomepageImageMapping();
const apartmentAssignments = await readMediaApartmentAssignments();
const mediaSeoFields = await readMediaSeoFields();
let mediaItems = [];
let mediaError = "";
let mediaWarning = "";

try {
  const mediaResult = await fetchWordPressMedia();
  mediaItems = mediaResult.items;
  mediaError = mediaResult.error;
  mediaWarning = mediaResult.warning;
} catch (error) {
  mediaError =
    error instanceof Error ? error.message : "A WordPress média lekérése nem sikerült.";
}

const initialState = {
  slots: homepageImageSlots,
  mapping,
  apartmentOptions,
  apartmentAssignments,
  themeRoomOptions,
  mediaSeoFields,
  mediaItems,
  initialSlotKey,
  initialApartmentFilter: "all",
  initialQuickFilters: {
    missingAlt: false,
    unassignedApartment: false
  }
};
const initialSelectedMedia =
  mediaItems.find((item) => item.id === mapping[initialSlotKey]?.id) || null;
---

<BaseLayout title="Képkezelő admin" description="Dandelion WP média és főoldali képhoztárendelések kezelése.">
  <section class="dnd-image-admin">
    <div class="dnd-container">
      <div class="dnd-image-admin__header">
        <div>
          <span class="dnd-image-admin__eyebrow">WP képkezelő</span>
          <h1 class="dnd-image-admin__title">Főoldali képhelyek hozzárendelése</h1>
          <p class="dnd-image-admin__lead">
            A képek továbbra is a WordPress médiatárból jönnek. Itt csak azt választod ki,
            hogy melyik főoldali hely melyik képet használja.
          </p>
        </div>

        <form id="dnd-image-admin-save-form" class="dnd-image-admin__save" method="post">
          <input id="dnd-image-admin-slot-input" type="hidden" value={initialSlotKey} />
          <input id="dnd-image-admin-mapping-input" type="hidden" value={JSON.stringify(mapping)} />
          <button class="dnd-btn dnd-btn--primary" type="submit">Mentés</button>
        </form>
      </div>

      <p id="dnd-image-admin-save-success" class="dnd-image-admin__notice dnd-image-admin__notice--success is-hidden">
        A kép-hozzárendelések elmentve.
      </p>
      <p id="dnd-image-admin-save-error" class="dnd-image-admin__notice dnd-image-admin__notice--error is-hidden">
        Hiba: A mentés nem sikerült.
      </p>
      <p id="dnd-image-admin-meta-success" class="dnd-image-admin__notice dnd-image-admin__notice--success is-hidden">
        A kép meta adatai elmentve.
      </p>
      <p id="dnd-image-admin-meta-error" class="dnd-image-admin__notice dnd-image-admin__notice--error is-hidden">
        Hiba: A meta mentése nem sikerült.
      </p>
      <p id="dnd-image-admin-apartment-success" class="dnd-image-admin__notice dnd-image-admin__notice--success is-hidden">
        A lakás hozzárendelése elmentve.
      </p>
      <p id="dnd-image-admin-apartment-error" class="dnd-image-admin__notice dnd-image-admin__notice--error is-hidden">
        Hiba: A lakás hozzárendelése nem sikerült.
      </p>
      <p id="dnd-image-admin-bulk-success" class="dnd-image-admin__notice dnd-image-admin__notice--success is-hidden">
        A kiválasztott képek lakás-hozzárendelése elmentve.
      </p>
      <p id="dnd-image-admin-bulk-error" class="dnd-image-admin__notice dnd-image-admin__notice--error is-hidden">
        Hiba: A tömeges lakás-hozzárendelés nem sikerült.
      </p>
      <p id="dnd-image-admin-bulk-seo-success" class="dnd-image-admin__notice dnd-image-admin__notice--success is-hidden">
        A kijelölt képek SEO javaslatai elkészültek.
      </p>
      <p id="dnd-image-admin-bulk-seo-error" class="dnd-image-admin__notice dnd-image-admin__notice--error is-hidden">
        Hiba: A tömeges SEO javaslat nem sikerült.
      </p>
      <p id="dnd-image-admin-seo-success" class="dnd-image-admin__notice dnd-image-admin__notice--success is-hidden">
        A kép SEO mezőit elmentettük.
      </p>
      <p id="dnd-image-admin-seo-error" class="dnd-image-admin__notice dnd-image-admin__notice--error is-hidden">
        Hiba: A kép SEO mezőinek mentése nem sikerült.
      </p>
      {mediaWarning && <p class="dnd-image-admin__notice dnd-image-admin__notice--warning">{mediaWarning}</p>}
      {mediaError && <p class="dnd-image-admin__notice dnd-image-admin__notice--error">Hiba: {mediaError}</p>}

      <div class="dnd-image-admin__layout">
        <aside class="dnd-image-admin__sidebar">
          <div class="dnd-image-admin__panel">
            <h2>Lakás szűrő</h2>
            <div class="dnd-image-admin__filter-list">
              {apartmentOptions.map((option) => (
                <button
                  type="button"
                  class:list={[
                    "dnd-image-admin__filter-button",
                    option.key === "all" && "is-active"
                  ]}
                  data-apartment-filter={option.key}
                >
                  {option.label}
                </button>
              ))}
            </div>
          </div>

          <div class="dnd-image-admin__panel">
            <h2>Képhelyek</h2>
            <div class="dnd-image-admin__slot-list">
              {homepageImageSlots.map((slot) => (
                <button
                  type="button"
                  class:list={[
                    "dnd-image-admin__slot-button",
                    slot.key === initialSlotKey && "is-active"
                  ]}
                  data-slot-key={slot.key}
                >
                  <span class="dnd-image-admin__slot-label">{slot.label}</span>
                  <span class="dnd-image-admin__slot-description">{slot.description}</span>
                  <span class="dnd-image-admin__slot-current">
                    {mapping[slot.key]?.title || "Nincs kép kiválasztva"}
                  </span>
                </button>
              ))}
            </div>
          </div>
        </aside>

        <div class="dnd-image-admin__content">
          <div class="dnd-image-admin__panel dnd-image-admin__panel--current">
            <div class="dnd-image-admin__current-head">
              <div>
                <p class="dnd-image-admin__panel-kicker">Aktuális slot</p>
                <h2 id="dnd-image-admin-current-slot-title">
                  {homepageImageSlots.find((slot) => slot.key === initialSlotKey)?.label}
                </h2>
                <p id="dnd-image-admin-current-slot-description" class="dnd-image-admin__panel-text">
                  {homepageImageSlots.find((slot) => slot.key === initialSlotKey)?.description}
                </p>
              </div>
              <button id="dnd-image-admin-clear-button" class="dnd-btn dnd-btn--secondary" type="button">
                Kijelölés törlése
              </button>
            </div>

            <div class="dnd-image-admin__current-card">
              <div class="dnd-image-admin__preview-column">
                <div id="dnd-image-admin-preview" class="dnd-image-admin__preview">
                {
                  mapping[initialSlotKey] ? (
                    <img
                      src={mapping[initialSlotKey]?.thumbnailUrl || mapping[initialSlotKey]?.sourceUrl}
                      alt={mapping[initialSlotKey]?.altText || mapping[initialSlotKey]?.title || ""}
                    />
                  ) : (
                    <div class="dnd-image-admin__preview-empty">
                      <strong>Nincs kiválasztott kép</strong>
                      <span>Válassz egy képet a médiatárból, és itt fog megjelenni az előnézet.</span>
                    </div>
                  )
                }
                </div>

                <details class="dnd-image-admin__sizes" open={false}>
                  <summary>Elérhető méretek</summary>
                  <div id="dnd-image-admin-sizes"></div>
                </details>
              </div>

              <div id="dnd-image-admin-current-meta" class="dnd-image-admin__current-meta">
                <p class="dnd-image-admin__panel-kicker">Kiválasztott kép</p>
                <h3 id="dnd-image-admin-current-image-title">
                  {mapping[initialSlotKey]?.title || "Nincs kiválasztott kép"}
                </h3>
                <p id="dnd-image-admin-current-image-alt" class="dnd-image-admin__panel-text">
                  {mapping[initialSlotKey]?.altText || "Nincs alt szöveg."}
                </p>
                <a
                  id="dnd-image-admin-current-image-link"
                  class:list={[
                    "dnd-image-admin__source-link",
                    !mapping[initialSlotKey]?.sourceUrl && "is-hidden"
                  ]}
                  href={mapping[initialSlotKey]?.sourceUrl || "#"}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Eredeti kép megnyitása
                </a>

                <details class="dnd-image-admin__meta-editor" open>
                  <summary>Cím / Meta adatok</summary>
                  <form id="dnd-image-admin-meta-form" class="dnd-image-admin__meta-form">
                    <label class="dnd-image-admin__field">
                      <span>Fájlnév</span>
                      <input
                        id="dnd-image-admin-meta-filename"
                        type="text"
                        value={initialSelectedMedia?.filename || ""}
                        readonly
                      />
                    </label>
                    <label class="dnd-image-admin__field">
                      <span>Alt szöveg</span>
                      <input
                        id="dnd-image-admin-meta-alt"
                        type="text"
                        value={initialSelectedMedia?.altText || ""}
                        disabled={!initialSelectedMedia}
                      />
                    </label>
                    <label class="dnd-image-admin__field">
                      <span>Cím</span>
                      <input
                        id="dnd-image-admin-meta-title"
                        type="text"
                        value={initialSelectedMedia?.title || ""}
                        disabled={!initialSelectedMedia}
                      />
                    </label>
                    <label class="dnd-image-admin__field">
                      <span>Leírás</span>
                      <textarea
                        id="dnd-image-admin-meta-description"
                        rows="3"
                        disabled={!initialSelectedMedia}
                      >{initialSelectedMedia?.description || ""}</textarea>
                    </label>
                    <div class="dnd-image-admin__seo-fields">
                      <label class="dnd-image-admin__field">
                        <span>Téma / helyiség</span>
                        <select
                          id="dnd-image-admin-seo-theme-room"
                          disabled={!initialSelectedMedia}
                        >
                          {themeRoomOptions.map((option) => (
                            <option
                              value={option.key}
                              selected={mediaSeoFields[String(initialSelectedMedia?.id || "")]?.themeRoom === option.key}
                            >
                              {option.label}
                            </option>
                          ))}
                        </select>
                      </label>
                      <label class="dnd-image-admin__field">
                        <span>Fókusz / részlet</span>
                        <input
                          id="dnd-image-admin-seo-feature-focus"
                          type="text"
                          value={mediaSeoFields[String(initialSelectedMedia?.id || "")]?.featureFocus || ""}
                          disabled={!initialSelectedMedia}
                        />
                      </label>
                      <div class="dnd-image-admin__seo-actions">
                        <button
                          id="dnd-image-admin-suggest-alt"
                          class="dnd-btn dnd-btn--secondary dnd-image-admin__meta-submit"
                          type="button"
                          disabled={!initialSelectedMedia}
                        >
                          ALT javaslat
                        </button>
                        <button
                          id="dnd-image-admin-suggest-title"
                          class="dnd-btn dnd-btn--secondary dnd-image-admin__meta-submit"
                          type="button"
                          disabled={!initialSelectedMedia}
                        >
                          Title javaslat
                        </button>
                        <button
                          id="dnd-image-admin-seo-submit"
                          class="dnd-btn dnd-btn--secondary dnd-image-admin__meta-submit"
                          type="button"
                          disabled={!initialSelectedMedia}
                        >
                          SEO mezők mentése
                        </button>
                      </div>
                    </div>
                    <label class="dnd-image-admin__field">
                      <span>Hozzárendelt lakás</span>
                      <select
                        id="dnd-image-admin-apartment-select"
                        disabled={!initialSelectedMedia}
                      >
                        <option value="">Nincs hozzárendelve</option>
                        {apartmentOptions
                          .filter((option) => option.key !== "all")
                          .map((option) => (
                            <option
                              value={option.key}
                              selected={apartmentAssignments[String(initialSelectedMedia?.id || "")] === option.key}
                            >
                              {option.label}
                            </option>
                          ))}
                      </select>
                    </label>
                    <button
                      id="dnd-image-admin-apartment-submit"
                      class="dnd-btn dnd-btn--secondary dnd-image-admin__meta-submit"
                      type="button"
                      disabled={!initialSelectedMedia}
                    >
                      Lakás-hozzárendelés mentése
                    </button>
                    <button
                      id="dnd-image-admin-meta-submit"
                      class="dnd-btn dnd-btn--secondary dnd-image-admin__meta-submit"
                      type="submit"
                      disabled={!initialSelectedMedia}
                    >
                      Meta adatok mentése
                    </button>
                  </form>
                </details>

              </div>
            </div>
          </div>

          <div class="dnd-image-admin__panel">
            <div class="dnd-image-admin__media-head">
              <div>
                <h2>WordPress média</h2>
                <p class="dnd-image-admin__panel-text">
                  Betöltött képek száma: {mediaItems.length}
                </p>
              </div>
              <div class="dnd-image-admin__media-tools">
                <div class="dnd-image-admin__quick-filters">
                  <button
                    id="dnd-image-admin-filter-missing-alt"
                    class="dnd-image-admin__quick-filter"
                    type="button"
                  >
                    Hiányzó ALT
                  </button>
                  <button
                    id="dnd-image-admin-filter-unassigned-apartment"
                    class="dnd-image-admin__quick-filter"
                    type="button"
                  >
                    Nincs lakáshoz rendelve
                  </button>
                </div>
                <label class="dnd-image-admin__search">
                  <span>Keresés</span>
                  <input id="dnd-image-admin-search" type="search" placeholder="Kép címe vagy alt szöveg" />
                </label>
              </div>
            </div>

            <div class="dnd-image-admin__bulk-bar">
              <div class="dnd-image-admin__bulk-copy">
                <strong id="dnd-image-admin-bulk-count">0 kép kijelölve</strong>
                <span>Jelölj ki több képet, majd add meg a cél lakást.</span>
              </div>
              <div class="dnd-image-admin__bulk-actions">
                <select id="dnd-image-admin-bulk-apartment-select">
                  <option value="">Válassz lakást</option>
                  {apartmentOptions
                    .filter((option) => option.key !== "all")
                    .map((option) => (
                      <option value={option.key}>{option.label}</option>
                    ))}
                </select>
                <button
                  id="dnd-image-admin-bulk-suggest-alt"
                  class="dnd-btn dnd-btn--secondary dnd-image-admin__bulk-button"
                  type="button"
                  disabled
                >
                  Bulk ALT javaslat
                </button>
                <button
                  id="dnd-image-admin-bulk-suggest-title"
                  class="dnd-btn dnd-btn--secondary dnd-image-admin__bulk-button"
                  type="button"
                  disabled
                >
                  Bulk Title javaslat
                </button>
                <button
                  id="dnd-image-admin-bulk-submit"
                  class="dnd-btn dnd-btn--secondary dnd-image-admin__bulk-button"
                  type="button"
                  disabled
                >
                  Bulk lakás-hozzárendelés
                </button>
                <button
                  id="dnd-image-admin-bulk-clear"
                  class="dnd-btn dnd-btn--secondary dnd-image-admin__bulk-button"
                  type="button"
                  disabled
                >
                  Összes kijelölés törlése
                </button>
              </div>
            </div>

            {!mediaError && (
              <div id="dnd-image-admin-grid" class="dnd-image-admin__media-grid">
                {mediaItems.map((item) => (
                  <article
                    class="dnd-image-admin__media-card"
                    data-media-id={item.id}
                    data-title={(mediaSeoFields[String(item.id)]?.title || item.title).toLowerCase()}
                    data-alt={(mediaSeoFields[String(item.id)]?.altText || item.altText).toLowerCase()}
                    data-apartment={apartmentAssignments[String(item.id)] || ""}
                    data-has-alt={(mediaSeoFields[String(item.id)]?.altText || item.altText).trim() ? "true" : "false"}
                    data-bulk-selected="false"
                  >
                    <button
                      type="button"
                      class="dnd-image-admin__media-bulk-toggle"
                      data-bulk-toggle={item.id}
                      aria-pressed="false"
                    >
                      Kijelölés
                    </button>
                    <button
                      type="button"
                      class="dnd-image-admin__media-open"
                      data-open-media={item.id}
                    >
                    <img
                      src={item.thumbnailUrl || item.sourceUrl}
                      alt={item.altText || item.title}
                      loading="lazy"
                    />
                    <span class="dnd-image-admin__media-copy">
                      <strong>{mediaSeoFields[String(item.id)]?.title || item.title}</strong>
                      <small>{mediaSeoFields[String(item.id)]?.altText || item.altText || "Nincs alt szöveg"}</small>
                    </span>
                    </button>
                  </article>
                ))}
              </div>
            )}
          </div>
        </div>
      </div>
    </div>
  </section>

  <script id="dnd-image-admin-state" type="application/json" set:html={JSON.stringify(initialState)}></script>

  <script>
    const stateElement = document.getElementById("dnd-image-admin-state");

    if (stateElement) {
      const state = JSON.parse(stateElement.textContent || "{}");
      const slotButtons = Array.from(document.querySelectorAll("[data-slot-key]"));
      const apartmentFilterButtons = Array.from(document.querySelectorAll("[data-apartment-filter]"));
      const mediaCards = Array.from(document.querySelectorAll("[data-media-id]"));
      const mediaOpenButtons = Array.from(document.querySelectorAll("[data-open-media]"));
      const mediaBulkToggleButtons = Array.from(document.querySelectorAll("[data-bulk-toggle]"));
      const mappingInput = document.getElementById("dnd-image-admin-mapping-input");
      const slotInput = document.getElementById("dnd-image-admin-slot-input");
      const saveForm = document.getElementById("dnd-image-admin-save-form");
      const saveSuccess = document.getElementById("dnd-image-admin-save-success");
      const saveError = document.getElementById("dnd-image-admin-save-error");
      const searchInput = document.getElementById("dnd-image-admin-search");
      const clearButton = document.getElementById("dnd-image-admin-clear-button");
      const preview = document.getElementById("dnd-image-admin-preview");
      const currentSlotTitle = document.getElementById("dnd-image-admin-current-slot-title");
      const currentSlotDescription = document.getElementById("dnd-image-admin-current-slot-description");
      const currentImageTitle = document.getElementById("dnd-image-admin-current-image-title");
      const currentImageAlt = document.getElementById("dnd-image-admin-current-image-alt");
      const currentImageLink = document.getElementById("dnd-image-admin-current-image-link");
      const currentMeta = document.getElementById("dnd-image-admin-current-meta");
      const sizesContainer = document.getElementById("dnd-image-admin-sizes");
      const metaForm = document.getElementById("dnd-image-admin-meta-form");
      const metaSuccess = document.getElementById("dnd-image-admin-meta-success");
      const metaError = document.getElementById("dnd-image-admin-meta-error");
      const metaFilename = document.getElementById("dnd-image-admin-meta-filename");
      const metaAlt = document.getElementById("dnd-image-admin-meta-alt");
      const metaTitle = document.getElementById("dnd-image-admin-meta-title");
      const metaDescription = document.getElementById("dnd-image-admin-meta-description");
      const seoSuccess = document.getElementById("dnd-image-admin-seo-success");
      const seoError = document.getElementById("dnd-image-admin-seo-error");
      const seoThemeRoom = document.getElementById("dnd-image-admin-seo-theme-room");
      const seoFeatureFocus = document.getElementById("dnd-image-admin-seo-feature-focus");
      const seoSubmit = document.getElementById("dnd-image-admin-seo-submit");
      const suggestAlt = document.getElementById("dnd-image-admin-suggest-alt");
      const suggestTitle = document.getElementById("dnd-image-admin-suggest-title");
      const apartmentSuccess = document.getElementById("dnd-image-admin-apartment-success");
      const apartmentError = document.getElementById("dnd-image-admin-apartment-error");
      const apartmentSelect = document.getElementById("dnd-image-admin-apartment-select");
      const apartmentSubmit = document.getElementById("dnd-image-admin-apartment-submit");
      const bulkSuccess = document.getElementById("dnd-image-admin-bulk-success");
      const bulkError = document.getElementById("dnd-image-admin-bulk-error");
      const bulkCount = document.getElementById("dnd-image-admin-bulk-count");
      const bulkApartmentSelect = document.getElementById("dnd-image-admin-bulk-apartment-select");
      const bulkSuggestAlt = document.getElementById("dnd-image-admin-bulk-suggest-alt");
      const bulkSuggestTitle = document.getElementById("dnd-image-admin-bulk-suggest-title");
      const bulkSubmit = document.getElementById("dnd-image-admin-bulk-submit");
      const bulkClear = document.getElementById("dnd-image-admin-bulk-clear");
      const bulkSeoSuccess = document.getElementById("dnd-image-admin-bulk-seo-success");
      const bulkSeoError = document.getElementById("dnd-image-admin-bulk-seo-error");
      const quickFilterMissingAlt = document.getElementById("dnd-image-admin-filter-missing-alt");
      const quickFilterUnassignedApartment = document.getElementById("dnd-image-admin-filter-unassigned-apartment");
      const metaSubmit = document.getElementById("dnd-image-admin-meta-submit");
      const primarySizeNames = ["full", "large", "medium_large", "medium", "thumbnail"];


      let activeSlotKey = state.initialSlotKey;
      let activeApartmentFilter = state.initialApartmentFilter || "all";
      let mapping = state.mapping || {};
      let apartmentAssignments = state.apartmentAssignments || {};
      let isMetaSaving = false;
      let isApartmentSaving = false;
      let isBulkSaving = false;
      let isBulkSeoSaving = false;
      let isSeoSaving = false;
      let selectedBulkMediaIds = [];
      let mediaMetaOverrides = {};
      let mediaSeoFields = state.mediaSeoFields || {};
      let quickFilters = state.initialQuickFilters || {
        missingAlt: false,
        unassignedApartment: false
      };

      function getSlotDefinition(slotKey) {
        return (state.slots || []).find((slot) => slot.key === slotKey);
      }

      function getMediaItem(mediaId) {
        return (state.mediaItems || []).find((item) => String(item.id) === String(mediaId));
      }

      function getSelectedMediaItem() {
        const selected = mapping[activeSlotKey];
        return selected ? getMediaItem(selected.id) : null;
      }

      function getSelectedMediaForEditor() {
        const selectedMediaItem = getSelectedMediaItem();
        const selected = mapping[activeSlotKey];
        const override = selected ? mediaMetaOverrides[selected.id] : null;
        const seoFields = selected ? mediaSeoFields[String(selected.id)] : null;

        if (selectedMediaItem) {
          return {
            ...selectedMediaItem,
            title:
              override?.title ||
              selectedMediaItem.title ||
              seoFields?.title ||
              "",
            altText:
              override?.altText ||
              selectedMediaItem.altText ||
              seoFields?.altText ||
              "",
            description: override?.description || selectedMediaItem.description || ""
          };
        }

        if (!selected) {
          return null;
        }

        if (override) {
          return {
            id: selected.id,
            filename: override.filename || "",
            title: override.title || selected.title || "",
            altText: override.altText || selected.altText || "",
            description: override.description || "",
            sourceUrl: selected.sourceUrl || "",
            thumbnailUrl: selected.thumbnailUrl || "",
            sizes: []
          };
        }

        return {
          id: selected.id,
          filename: "",
          title: seoFields?.title || selected.title || "",
          altText: seoFields?.altText || selected.altText || "",
          description: "",
          sourceUrl: selected.sourceUrl || "",
          thumbnailUrl: selected.thumbnailUrl || "",
          sizes: []
        };
      }

      function getSelectedApartmentAssignment() {
        const mediaItem = getSelectedMediaForEditor();

        if (!mediaItem) {
          return "";
        }

        return apartmentAssignments[String(mediaItem.id)] || "";
      }

      function getSelectedSeoFields() {
        const mediaItem = getSelectedMediaForEditor();

        if (!mediaItem) {
          return {
            themeRoom: "",
            featureFocus: "",
            altText: "",
            title: ""
          };
        }

        return (
          mediaSeoFields[String(mediaItem.id)] || {
            themeRoom: "",
            featureFocus: "",
            altText: "",
            title: ""
          }
        );
      }

      function showMetaMessage(success, message) {
        if (metaSuccess) {
          metaSuccess.classList.toggle("is-hidden", !success);
        }

        if (metaError) {
          metaError.classList.toggle("is-hidden", success);
          if (!success) {
            metaError.textContent = `Hiba: ${message}`;
          }
        }
      }

      function showApartmentMessage(success, message) {
        if (apartmentSuccess) {
          apartmentSuccess.classList.toggle("is-hidden", !success);
        }

        if (apartmentError) {
          apartmentError.classList.toggle("is-hidden", success);
          if (!success) {
            apartmentError.textContent = `Hiba: ${message}`;
          }
        }
      }

      function showBulkMessage(success, message) {
        if (bulkSuccess) {
          bulkSuccess.classList.toggle("is-hidden", !success);
          if (success) {
            bulkSuccess.textContent = message;
          }
        }

        if (bulkError) {
          bulkError.classList.toggle("is-hidden", success);
          if (!success) {
            bulkError.textContent = `Hiba: ${message}`;
          }
        }
      }

      function showBulkSeoMessage(success, message) {
        if (bulkSeoSuccess) {
          bulkSeoSuccess.classList.toggle("is-hidden", !success);
          if (success) {
            bulkSeoSuccess.textContent = message;
          }
        }

        if (bulkSeoError) {
          bulkSeoError.classList.toggle("is-hidden", success);
          if (!success) {
            bulkSeoError.textContent = `Hiba: ${message}`;
          }
        }
      }

      function showSeoMessage(success, message) {
        if (seoSuccess) {
          seoSuccess.classList.toggle("is-hidden", !success);
        }

        if (seoError) {
          seoError.classList.toggle("is-hidden", success);
          if (!success) {
            seoError.textContent = `Hiba: ${message}`;
          }
        }
      }

      function updateApartmentSubmitState(hasMedia) {
        if (apartmentSubmit) {
          apartmentSubmit.disabled = !hasMedia || isApartmentSaving;
        }
      }

      function updateBulkSubmitState() {
        const hasSelection = selectedBulkMediaIds.length > 0;
        const hasApartment = Boolean(bulkApartmentSelect?.value);

        if (bulkSubmit) {
          bulkSubmit.disabled = !hasSelection || !hasApartment || isBulkSaving || isBulkSeoSaving;
        }

        if (bulkClear) {
          bulkClear.disabled = !hasSelection || isBulkSaving || isBulkSeoSaving;
        }

        if (bulkSuggestAlt) {
          bulkSuggestAlt.disabled = !hasSelection || isBulkSeoSaving;
        }

        if (bulkSuggestTitle) {
          bulkSuggestTitle.disabled = !hasSelection || isBulkSeoSaving;
        }
      }

      function updateSeoSubmitState(hasMedia) {
        if (seoSubmit) {
          seoSubmit.disabled = !hasMedia || isSeoSaving;
        }

        if (suggestAlt) {
          suggestAlt.disabled = !hasMedia;
        }

        if (suggestTitle) {
          suggestTitle.disabled = !hasMedia;
        }
      }

      function updateMetaSubmitState(hasMedia) {
        if (metaSubmit) {
          metaSubmit.disabled = !hasMedia || isMetaSaving;
        }
      }

      function renderMetaEditor(mediaItem) {
        const hasMedia = Boolean(mediaItem);
        const seoFields = getSelectedSeoFields();

        if (metaFilename) {
          metaFilename.value = mediaItem?.filename || "";
        }

        if (metaAlt) {
          metaAlt.value = mediaItem?.altText || "";
          metaAlt.disabled = !hasMedia;
        }

        if (metaTitle) {
          metaTitle.value = mediaItem?.title || "";
          metaTitle.disabled = !hasMedia;
        }

        if (metaDescription) {
          metaDescription.value = mediaItem?.description || "";
          metaDescription.disabled = !hasMedia;
        }

        if (seoThemeRoom) {
          seoThemeRoom.value = seoFields.themeRoom || "";
          seoThemeRoom.disabled = !hasMedia;
        }

        if (seoFeatureFocus) {
          seoFeatureFocus.value = seoFields.featureFocus || "";
          seoFeatureFocus.disabled = !hasMedia;
        }

        if (apartmentSelect) {
          apartmentSelect.value = hasMedia ? getSelectedApartmentAssignment() : "";
          apartmentSelect.disabled = !hasMedia;
        }

        updateMetaSubmitState(hasMedia);
        updateApartmentSubmitState(hasMedia);
        updateSeoSubmitState(hasMedia);
      }

      function updateSelectedMediaState(nextMedia) {
        const selected = mapping[activeSlotKey];

        mediaMetaOverrides[nextMedia.id] = {
          filename: nextMedia.filename,
          title: nextMedia.title,
          altText: nextMedia.altText,
          description: nextMedia.description
        };

        if (!selected || selected.id !== nextMedia.id) {
          return;
        }

        const mediaIndex = (state.mediaItems || []).findIndex((item) => item.id === nextMedia.id);

        if (mediaIndex >= 0) {
          state.mediaItems[mediaIndex] = {
            ...state.mediaItems[mediaIndex],
            filename: nextMedia.filename,
            title: nextMedia.title,
            altText: nextMedia.altText,
            description: nextMedia.description
          };
        }

        const mediaCard = mediaCards.find(
          (card) => Number(card.dataset.mediaId) === nextMedia.id
        );

        if (mediaCard) {
          mediaCard.dataset.title = (nextMedia.title || "").toLowerCase();
          mediaCard.dataset.alt = (nextMedia.altText || "").toLowerCase();

          const image = mediaCard.querySelector("img");
          const title = mediaCard.querySelector("strong");
          const alt = mediaCard.querySelector("small");

          if (image) {
            image.alt = nextMedia.altText || nextMedia.title || "";
          }

          if (title) {
            title.textContent = nextMedia.title || "Nincs kiválasztott kép";
          }

          if (alt) {
            alt.textContent = nextMedia.altText || "Nincs alt szöveg";
          }

          mediaCard.dataset.hasAlt = nextMedia.altText?.trim() ? "true" : "false";
        }

        mapping[activeSlotKey] = {
          ...selected,
          title: nextMedia.title,
          altText: nextMedia.altText
        };

        if (mediaSeoFields[String(nextMedia.id)]) {
          mediaSeoFields[String(nextMedia.id)] = {
            ...mediaSeoFields[String(nextMedia.id)],
            altText: nextMedia.altText || "",
            title: nextMedia.title || ""
          };
        }
      }

      function updateSeoFieldsState(mediaId, nextFields) {
        if (nextFields.themeRoom || nextFields.featureFocus || nextFields.altText || nextFields.title) {
          mediaSeoFields[String(mediaId)] = {
            themeRoom: nextFields.themeRoom || "",
            featureFocus: nextFields.featureFocus || "",
            altText: nextFields.altText || "",
            title: nextFields.title || ""
          };
        } else {
          delete mediaSeoFields[String(mediaId)];
        }

        const mediaCard = mediaCards.find(
          (card) => Number(card.dataset.mediaId) === Number(mediaId)
        );
        const mediaItem = getMediaItem(mediaId);
        const effectiveAlt =
          nextFields.altText || mediaItem?.altText || "";

        if (mediaCard) {
          mediaCard.dataset.title = (nextFields.title || mediaItem?.title || "").toLowerCase();
          mediaCard.dataset.alt = effectiveAlt.toLowerCase();
          mediaCard.dataset.hasAlt = effectiveAlt.trim() ? "true" : "false";

          const title = mediaCard.querySelector("strong");
          const alt = mediaCard.querySelector("small");
          if (title) {
            title.textContent = nextFields.title || mediaItem?.title || "";
          }
          if (alt) {
            alt.textContent = effectiveAlt || "Nincs alt szöveg";
          }
        }
      }

      function getApartmentLabel(apartmentKey) {
        const labels = {
          d1: "D1",
          d2: "D2",
          fugehaz: "Fügeház",
          zsalya: "Zsálya Vendégház",
          szololiget: "Szőlőliget Vendégház",
          szepvolgyi: "Szépvölgyi Vendégház",
          royal_homes: "Royal Homes",
          vintage: "Vintage Vendégház"
        };

        return labels[apartmentKey] || "";
      }

      function getThemeRoomLabel(themeRoomKey) {
        const themeRoomOption = (state.themeRoomOptions || []).find(
          (option) => option.key === themeRoomKey
        );

        return themeRoomOption?.label || "";
      }

      function getSeoFieldsForMediaId(mediaId) {
        return (
          mediaSeoFields[String(mediaId)] || {
            themeRoom: "",
            featureFocus: "",
            altText: "",
            title: ""
          }
        );
      }

      function toLowerTrimmedWords(value) {
        return String(value || "")
          .trim()
          .toLowerCase()
          .replace(/\s+/g, " ");
      }

      function toSentenceCase(value) {
        const normalized = String(value || "").trim();

        if (!normalized) {
          return "";
        }

        return normalized.charAt(0).toUpperCase() + normalized.slice(1);
      }

      function getFeaturePhrase(value) {
        const normalized = toLowerTrimmedWords(value);
        const phrases = {
          kandallo: "kandallóval",
          "nagy ablak": "nagy ablakokkal",
          panoramas: "panorámás",
          zuhanyzo: "zuhanyzóval",
          "fa gerenda": "fa gerendával",
          "reggeli feny": "reggeli fényben"
        };

        return phrases[normalized] || normalized;
      }

      function buildApartmentPlaceSuffix(apartmentLabel) {
        if (!apartmentLabel) {
          return "";
        }

        if (apartmentLabel === "D1" || apartmentLabel === "D2") {
          return `a Dandelion ${apartmentLabel} apartmanban`;
        }

        if (apartmentLabel === "Royal Homes") {
          return "a Royal Homes szálláson";
        }

        return `a ${apartmentLabel}ban`;
      }

      function buildApartmentBySuffix(apartmentLabel) {
        if (!apartmentLabel) {
          return "";
        }

        if (apartmentLabel === "D1" || apartmentLabel === "D2") {
          return `a Dandelion ${apartmentLabel} apartmannál`;
        }

        if (apartmentLabel === "Royal Homes") {
          return "a Royal Homes szállásnál";
        }

        return `a ${apartmentLabel}nál`;
      }

      function buildAltSuggestionForValues(apartmentKey, themeRoomKey, featureFocusValue) {
        const apartmentLabel = getApartmentLabel(apartmentKey);
        const themeRoomLabel = getThemeRoomLabel(themeRoomKey);
        const featureValue = getFeaturePhrase(featureFocusValue);
        const apartmentSuffix = buildApartmentPlaceSuffix(apartmentLabel);
        const apartmentBySuffix = buildApartmentBySuffix(apartmentLabel);

        if (!apartmentLabel || !themeRoomLabel || !apartmentSuffix) {
          return "";
        }

        const specialTemplates = {
          terasz: featureValue
            ? `${toSentenceCase(featureValue)} terasz ${apartmentBySuffix}`
            : `Terasz ${apartmentBySuffix}`,
          nappali: featureValue
            ? `Nappali ${featureValue} ${apartmentSuffix}`
            : `Nappali ${apartmentSuffix}`,
          halo: featureValue
            ? `Hálószoba ${featureValue} ${apartmentSuffix}`
            : `Hálószoba ${apartmentSuffix}`,
          furdo: featureValue
            ? `Fürdőszoba ${featureValue} ${apartmentSuffix}`
            : `Fürdőszoba ${apartmentSuffix}`,
          panorama: featureValue
            ? `${toSentenceCase(featureValue)} panoráma ${apartmentBySuffix}`
            : `Panoráma ${apartmentBySuffix}`,
          kulso: featureValue
            ? `Külső nézet ${featureValue} ${apartmentBySuffix}`
            : `Külső nézet ${apartmentBySuffix}`,
          kornyek: featureValue
            ? `${toSentenceCase(featureValue)} környék ${apartmentBySuffix}`
            : `Környék ${apartmentBySuffix}`
        };

        if (specialTemplates[themeRoomKey]) {
          return specialTemplates[themeRoomKey];
        }

        if (featureValue) {
          return `${toSentenceCase(themeRoomLabel)} ${featureValue} ${apartmentSuffix}`;
        }

        return `${toSentenceCase(themeRoomLabel)} ${apartmentSuffix}`;
      }

      function buildAltSuggestion() {
        return buildAltSuggestionForValues(
          apartmentSelect?.value || getSelectedApartmentAssignment(),
          seoThemeRoom?.value || "",
          seoFeatureFocus?.value || ""
        );
      }

      function buildTitleSuggestionForValues(apartmentKey, themeRoomKey, featureFocusValue) {
        const apartmentLabel = getApartmentLabel(apartmentKey);
        const themeRoomLabel = getThemeRoomLabel(themeRoomKey);
        const featureValue = toSentenceCase(getFeaturePhrase(featureFocusValue));

        if (!apartmentLabel || !themeRoomLabel) {
          return "";
        }

        return featureValue
          ? `${apartmentLabel} | ${themeRoomLabel} | ${featureValue}`
          : `${apartmentLabel} | ${themeRoomLabel}`;
      }

      function buildTitleSuggestion() {
        return buildTitleSuggestionForValues(
          apartmentSelect?.value || getSelectedApartmentAssignment(),
          seoThemeRoom?.value || "",
          seoFeatureFocus?.value || ""
        );
      }

      function renderExtraSizeListItems(sizes) {
        return sizes
          .map((size) => {
            const dimensions =
              size.width && size.height ? `${size.width} × ${size.height}` : "Ismeretlen";

            return `
              <li class="dnd-image-admin__size-list-item">
                <div class="dnd-image-admin__size-list-copy">
                  <strong>${size.name}</strong>
                  <span>${dimensions}</span>
                </div>
                <a href="${size.url}" target="_blank" rel="noopener noreferrer">Megnyitás</a>
              </li>
            `;
          })
          .join("");
      }

      function getPrimarySizeLabel(sizeName) {
        const labels = {
          full: "Eredeti",
          large: "Desktop",
          medium_large: "Tablet",
          medium: "Kártya",
          thumbnail: "Mini"
        };

        return labels[sizeName] || sizeName;
      }

      function renderPrimarySizeCards(sizes) {
        return sizes
          .map((size) => {
            const dimensions =
              size.width && size.height ? `${size.width} × ${size.height}` : "Ismeretlen";

            return `
              <article class="dnd-image-admin__size-card">
                <div class="dnd-image-admin__size-card-head">
                  <strong>${size.name}</strong>
                  <span>${getPrimarySizeLabel(size.name)}</span>
                </div>
                <p class="dnd-image-admin__size-card-meta">${dimensions}</p>
                <a href="${size.url}" target="_blank" rel="noopener noreferrer">Megnyitás</a>
              </article>
            `;
          })
          .join("");
      }

      function renderSizes(selected) {
        if (!sizesContainer) {
          return;
        }

        const mediaItem = selected ? getMediaItem(selected.id) : null;
        const sizes = mediaItem?.sizes || [];
        const primarySizes = primarySizeNames
          .map((name) => sizes.find((size) => size.name === name))
          .filter(Boolean);
        const extraSizes = sizes.filter((size) => !primarySizeNames.includes(size.name));

        if (!sizes.length) {
          sizesContainer.innerHTML =
            '<p class="dnd-image-admin__sizes-empty">Ehhez a képhez nem érkezett méretinformáció.</p>';
          return;
        }

        const primaryRows = renderPrimarySizeCards(primarySizes);
        const extraRows = renderExtraSizeListItems(extraSizes);
        const primaryBlock = primarySizes.length
          ? `
            <div class="dnd-image-admin__sizes-group">
              <div class="dnd-image-admin__size-cards">
                ${primaryRows}
              </div>
            </div>
          `
          : '<p class="dnd-image-admin__sizes-empty">A kiemelt alapméretek közül egyik sem érhető el ehhez a képhez.</p>';
        const extraBlock = extraSizes.length
          ? `
            <details class="dnd-image-admin__sizes-details">
              <summary>Összes további méret (${extraSizes.length})</summary>
              <ul class="dnd-image-admin__size-list">
                ${extraRows}
              </ul>
            </details>
          `
          : "";

        sizesContainer.innerHTML = `
          <div class="dnd-image-admin__sizes-summary">Összes változat: ${sizes.length}</div>
          ${primaryBlock}
          ${extraBlock}
        `;
      }

      function syncHiddenInputs() {
        if (mappingInput) {
          mappingInput.value = JSON.stringify(mapping);
        }

        if (slotInput) {
          slotInput.value = activeSlotKey;
        }
      }

      function renderSlotList() {
        slotButtons.forEach((button) => {
          const slotKey = button.dataset.slotKey;
          const currentText = button.querySelector(".dnd-image-admin__slot-current");
          const selected = mapping[slotKey];

          button.classList.toggle("is-active", slotKey === activeSlotKey);

          if (currentText) {
            currentText.textContent = selected?.title || "Nincs kép kiválasztva";
          }
        });
      }

      function renderApartmentFilter() {
        apartmentFilterButtons.forEach((button) => {
          button.classList.toggle("is-active", button.dataset.apartmentFilter === activeApartmentFilter);
        });
      }

      function renderQuickFilters() {
        if (quickFilterMissingAlt) {
          quickFilterMissingAlt.classList.toggle("is-active", Boolean(quickFilters.missingAlt));
        }

        if (quickFilterUnassignedApartment) {
          quickFilterUnassignedApartment.classList.toggle(
            "is-active",
            Boolean(quickFilters.unassignedApartment)
          );
        }
      }

      function renderBulkSelection() {
        const selectedIds = new Set(selectedBulkMediaIds.map((id) => String(id)));

        mediaCards.forEach((card) => {
          const isSelected = selectedIds.has(String(card.dataset.mediaId));
          card.dataset.bulkSelected = isSelected ? "true" : "false";
          card.classList.toggle("is-bulk-selected", isSelected);
        });

        mediaBulkToggleButtons.forEach((button) => {
          const isSelected = selectedIds.has(String(button.dataset.bulkToggle));
          button.classList.toggle("is-active", isSelected);
          button.setAttribute("aria-pressed", isSelected ? "true" : "false");
          button.textContent = isSelected ? "Kijelölve" : "Kijelölés";
        });

        if (bulkCount) {
          bulkCount.textContent = `${selectedBulkMediaIds.length} kép kijelölve`;
        }

        updateBulkSubmitState();
      }

      function renderMediaGridVisibility() {
        const searchTerm = searchInput?.value.trim().toLowerCase() || "";

        mediaCards.forEach((card) => {
          const haystack = `${card.dataset.title || ""} ${card.dataset.alt || ""}`;
          const apartmentKey = card.dataset.apartment || "";
          const matchesSearch = searchTerm.length === 0 || haystack.includes(searchTerm);
          const matchesApartment =
            activeApartmentFilter === "all" || apartmentKey === activeApartmentFilter;
          const matchesMissingAlt =
            !quickFilters.missingAlt || card.dataset.hasAlt !== "true";
          const matchesUnassignedApartment =
            !quickFilters.unassignedApartment || !apartmentKey;

          card.hidden =
            !matchesSearch ||
            !matchesApartment ||
            !matchesMissingAlt ||
            !matchesUnassignedApartment;
        });
      }

      function updateApartmentAssignmentState(mediaId, apartmentKey) {
        if (apartmentKey) {
          apartmentAssignments[String(mediaId)] = apartmentKey;
        } else {
          delete apartmentAssignments[String(mediaId)];
        }

        const mediaCard = mediaCards.find(
          (card) => Number(card.dataset.mediaId) === Number(mediaId)
        );

        if (mediaCard) {
          mediaCard.dataset.apartment = apartmentKey || "";
        }
      }

      function updateApartmentAssignmentsState(mediaIds, apartmentKey) {
        mediaIds.forEach((mediaId) => {
          updateApartmentAssignmentState(mediaId, apartmentKey);
        });

        const selectedMediaItem = getSelectedMediaForEditor();

        if (
          apartmentSelect &&
          selectedMediaItem &&
          mediaIds.some((mediaId) => Number(mediaId) === Number(selectedMediaItem.id))
        ) {
          apartmentSelect.value = apartmentKey || "";
        }
      }

      function renderMediaSelection() {
        mediaCards.forEach((card) => {
          const mediaId = Number(card.dataset.mediaId);
          const selected = mapping[activeSlotKey];
          card.classList.toggle("is-selected", selected?.id === mediaId);
        });
      }

      function renderPreview() {
        const slot = getSlotDefinition(activeSlotKey);
        const selected = mapping[activeSlotKey];
        const selectedMediaItem = getSelectedMediaForEditor();

        if (currentSlotTitle) {
          currentSlotTitle.textContent = slot?.label || "";
        }

        if (currentSlotDescription) {
          currentSlotDescription.textContent = slot?.description || "";
        }

        if (!preview || !currentImageTitle || !currentImageAlt || !currentImageLink || !currentMeta) {
          return;
        }

        if (!selected) {
          preview.innerHTML = `
            <div class="dnd-image-admin__preview-empty">
              <strong>Nincs kiválasztott kép</strong>
              <span>Válassz egy képet a médiatárból, és itt fog megjelenni az előnézet.</span>
            </div>
          `;
          currentMeta.classList.add("is-empty");
          currentImageTitle.textContent = "Nincs kiválasztott kép";
          currentImageAlt.textContent = "Ha kiválasztasz egy képet, itt látod majd az alt szöveget és a fő méreteket.";
          currentImageLink.classList.add("is-hidden");
          currentImageLink.setAttribute("href", "#");
          renderMetaEditor(null);
          renderSizes(null);
          return;
        }

        preview.innerHTML = "";
        const image = document.createElement("img");
        image.src = selected.thumbnailUrl || selected.sourceUrl;
        image.alt = selected.altText || selected.title || "";
        preview.appendChild(image);

        currentMeta.classList.remove("is-empty");
        currentImageTitle.textContent = selectedMediaItem?.title || selected.title;
        currentImageAlt.textContent =
          selectedMediaItem?.altText || selected.altText || "Nincs alt szöveg.";
        currentImageLink.classList.remove("is-hidden");
        currentImageLink.setAttribute("href", selected.sourceUrl);
        renderMetaEditor(selectedMediaItem);
        renderSizes(selected);
      }

      function renderAll() {
        syncHiddenInputs();
        if (metaSuccess) {
          metaSuccess.classList.add("is-hidden");
        }
        if (metaError) {
          metaError.classList.add("is-hidden");
        }
        if (apartmentSuccess) {
          apartmentSuccess.classList.add("is-hidden");
        }
        if (apartmentError) {
          apartmentError.classList.add("is-hidden");
        }
        if (bulkSuccess) {
          bulkSuccess.classList.add("is-hidden");
        }
        if (bulkError) {
          bulkError.classList.add("is-hidden");
        }
        if (bulkSeoSuccess) {
          bulkSeoSuccess.classList.add("is-hidden");
        }
        if (bulkSeoError) {
          bulkSeoError.classList.add("is-hidden");
        }
        if (seoSuccess) {
          seoSuccess.classList.add("is-hidden");
        }
        if (seoError) {
          seoError.classList.add("is-hidden");
        }
        renderApartmentFilter();
        renderQuickFilters();
        renderBulkSelection();
        renderSlotList();
        renderMediaSelection();
        renderMediaGridVisibility();
        renderPreview();
      }

      function showSaveMessage(success, message) {
        if (saveSuccess) {
          saveSuccess.classList.toggle("is-hidden", !success);
        }

        if (saveError) {
          saveError.classList.toggle("is-hidden", success);
          if (!success) {
            saveError.textContent = `Hiba: ${message}`;
          }
        }
      }

      slotButtons.forEach((button) => {
        button.addEventListener("click", () => {
          activeSlotKey = button.dataset.slotKey || activeSlotKey;
          renderAll();
        });
      });

      apartmentFilterButtons.forEach((button) => {
        button.addEventListener("click", () => {
          activeApartmentFilter = button.dataset.apartmentFilter || "all";
          renderApartmentFilter();
          renderMediaGridVisibility();
        });
      });

      if (quickFilterMissingAlt) {
        quickFilterMissingAlt.addEventListener("click", () => {
          quickFilters.missingAlt = !quickFilters.missingAlt;
          renderQuickFilters();
          renderMediaGridVisibility();
        });
      }

      if (quickFilterUnassignedApartment) {
        quickFilterUnassignedApartment.addEventListener("click", () => {
          quickFilters.unassignedApartment = !quickFilters.unassignedApartment;
          renderQuickFilters();
          renderMediaGridVisibility();
        });
      }

      mediaOpenButtons.forEach((button) => {
        button.addEventListener("click", () => {
          const item = getMediaItem(button.dataset.openMedia);
          if (!item) {
            return;
          }

          mapping[activeSlotKey] = {
            id: item.id,
            title: item.title,
            altText: item.altText,
            sourceUrl: item.sourceUrl,
            thumbnailUrl: item.thumbnailUrl
          };

          renderAll();
        });
      });

      mediaBulkToggleButtons.forEach((button) => {
        button.addEventListener("click", () => {
          const mediaId = Number(button.dataset.bulkToggle);

          if (!mediaId) {
            return;
          }

          if (selectedBulkMediaIds.includes(mediaId)) {
            selectedBulkMediaIds = selectedBulkMediaIds.filter((id) => id !== mediaId);
          } else {
            selectedBulkMediaIds = [...selectedBulkMediaIds, mediaId];
          }

          if (bulkSuccess) {
            bulkSuccess.classList.add("is-hidden");
          }

          if (bulkError) {
            bulkError.classList.add("is-hidden");
          }

          if (bulkSeoSuccess) {
            bulkSeoSuccess.classList.add("is-hidden");
          }

          if (bulkSeoError) {
            bulkSeoError.classList.add("is-hidden");
          }

          renderBulkSelection();
          renderMediaGridVisibility();
        });
      });

      if (clearButton) {
        clearButton.addEventListener("click", () => {
          mapping[activeSlotKey] = null;
          renderAll();
        });
      }

      if (searchInput) {
        searchInput.addEventListener("input", () => {
          renderMediaGridVisibility();
        });
      }

      [metaAlt, metaTitle, metaDescription].forEach((field) => {
        if (!field) {
          return;
        }

        field.addEventListener("input", () => {
          if (metaSuccess) {
            metaSuccess.classList.add("is-hidden");
          }

          if (metaError) {
            metaError.classList.add("is-hidden");
          }

          updateMetaSubmitState(Boolean(getSelectedMediaForEditor()));
        });
      });

      [seoThemeRoom, seoFeatureFocus].forEach((field) => {
        if (!field) {
          return;
        }

        field.addEventListener("input", () => {
          if (seoSuccess) {
            seoSuccess.classList.add("is-hidden");
          }

          if (seoError) {
            seoError.classList.add("is-hidden");
          }

          updateSeoSubmitState(Boolean(getSelectedMediaForEditor()));
        });

        field.addEventListener("change", () => {
          if (seoSuccess) {
            seoSuccess.classList.add("is-hidden");
          }

          if (seoError) {
            seoError.classList.add("is-hidden");
          }

          updateSeoSubmitState(Boolean(getSelectedMediaForEditor()));
        });
      });

      if (apartmentSelect) {
        apartmentSelect.addEventListener("change", () => {
          if (apartmentSuccess) {
            apartmentSuccess.classList.add("is-hidden");
          }

          if (apartmentError) {
            apartmentError.classList.add("is-hidden");
          }

          updateApartmentSubmitState(Boolean(getSelectedMediaForEditor()));
        });
      }

      if (bulkApartmentSelect) {
        bulkApartmentSelect.addEventListener("change", () => {
          if (bulkSuccess) {
            bulkSuccess.classList.add("is-hidden");
          }

          if (bulkError) {
            bulkError.classList.add("is-hidden");
          }

          if (bulkSeoSuccess) {
            bulkSeoSuccess.classList.add("is-hidden");
          }

          if (bulkSeoError) {
            bulkSeoError.classList.add("is-hidden");
          }

          updateBulkSubmitState();
        });
      }

      async function runBulkSeoSuggestion(kind) {
        const selectedIds = [...selectedBulkMediaIds];

        if (selectedIds.length === 0) {
          showBulkSeoMessage(false, "Előbb jelölj ki legalább egy képet.");
          return;
        }

        let updatedCount = 0;
        let skippedCount = 0;

        try {
          isBulkSeoSaving = true;
          updateBulkSubmitState();

          for (const mediaId of selectedIds) {
            const mediaItem = getMediaItem(mediaId);
            const seoFields = getSeoFieldsForMediaId(mediaId);
            const apartmentKey = apartmentAssignments[String(mediaId)] || "";
            const nextThemeRoom = seoFields.themeRoom || "";
            const nextFeatureFocus = seoFields.featureFocus || "";
            const currentAlt =
              mediaMetaOverrides[mediaId]?.altText ||
              mediaItem?.altText ||
              seoFields.altText ||
              "";
            const currentTitle =
              mediaMetaOverrides[mediaId]?.title ||
              mediaItem?.title ||
              seoFields.title ||
              "";

            if (!apartmentKey || !nextThemeRoom) {
              skippedCount += 1;
              continue;
            }

            const nextAltText =
              kind === "alt" && !currentAlt.trim()
                ? buildAltSuggestionForValues(apartmentKey, nextThemeRoom, nextFeatureFocus)
                : seoFields.altText || "";
            const nextTitle =
              kind === "title" && !currentTitle.trim()
                ? buildTitleSuggestionForValues(apartmentKey, nextThemeRoom, nextFeatureFocus)
                : seoFields.title || "";

            if (
              (kind === "alt" && !nextAltText) ||
              (kind === "title" && !nextTitle) ||
              (kind === "alt" && currentAlt.trim()) ||
              (kind === "title" && currentTitle.trim())
            ) {
              skippedCount += 1;
              continue;
            }

            const response = await fetch("/api/image-admin/save-seo-fields", {
              method: "POST",
              headers: {
                "Content-Type": "application/json"
              },
              body: JSON.stringify({
                id: mediaId,
                themeRoom: nextThemeRoom,
                featureFocus: nextFeatureFocus,
                altText: kind === "alt" ? nextAltText : seoFields.altText || "",
                title: kind === "title" ? nextTitle : seoFields.title || ""
              })
            });

            if (!response.ok) {
              const payload = await response.json().catch(() => null);
              throw new Error(payload?.message || "A tömeges SEO javaslat mentése nem sikerült.");
            }

            const payload = await response.json();
            updateSeoFieldsState(payload?.id, {
              themeRoom: payload?.themeRoom || "",
              featureFocus: payload?.featureFocus || "",
              altText: payload?.altText || "",
              title: payload?.title || ""
            });

            updatedCount += 1;
          }

          renderMediaGridVisibility();
          renderPreview();

          const subject = kind === "alt" ? "ALT javaslat" : "Title javaslat";
          showBulkSeoMessage(
            true,
            `${subject}: ${updatedCount} képnél készült javaslat${skippedCount ? `, ${skippedCount} kép kimaradt.` : "."}`
          );
        } catch (error) {
          showBulkSeoMessage(
            false,
            error instanceof Error ? error.message : "A tömeges SEO javaslat mentése nem sikerült."
          );
        } finally {
          isBulkSeoSaving = false;
          updateBulkSubmitState();
        }
      }

      if (saveForm) {
        saveForm.addEventListener("submit", async (event) => {
          event.preventDefault();

          try {
            const response = await fetch("/api/image-admin/save", {
              method: "POST",
              headers: {
                "Content-Type": "application/json"
              },
              body: mappingInput?.value || "{}"
            });

            if (!response.ok) {
              const payload = await response.json().catch(() => null);
              throw new Error(payload?.message || "A mentés nem sikerült.");
            }

            showSaveMessage(true, "");
          } catch (error) {
            showSaveMessage(
              false,
              error instanceof Error ? error.message : "A mentés nem sikerült."
            );
          }
        });
      }

      if (metaForm) {
        metaForm.addEventListener("submit", async (event) => {
          event.preventDefault();

          const selectedMediaItem = getSelectedMediaForEditor();

          if (!selectedMediaItem || !metaAlt || !metaTitle || !metaDescription) {
            showMetaMessage(false, "Nincs kiválasztott kép a meta adatok mentéséhez.");
            return;
          }

          try {
            isMetaSaving = true;
            updateMetaSubmitState(true);

            const response = await fetch("/api/image-admin/update-media", {
              method: "POST",
              headers: {
                "Content-Type": "application/json"
              },
              body: JSON.stringify({
                id: selectedMediaItem.id,
                altText: metaAlt.value,
                title: metaTitle.value,
                description: metaDescription.value
              })
            });

            if (!response.ok) {
              const payload = await response.json().catch(() => null);
              throw new Error(payload?.message || "A meta mentése nem sikerült.");
            }

            const payload = await response.json();
            const nextMedia = payload?.media;

            if (!nextMedia?.id) {
              throw new Error("A WordPress nem adott vissza frissített média adatot.");
            }

            updateSelectedMediaState(nextMedia);
            currentImageTitle.textContent = nextMedia.title || "Nincs kiválasztott kép";
            currentImageAlt.textContent = nextMedia.altText || "Nincs alt szöveg.";
            renderAll();
            showMetaMessage(true, "");
          } catch (error) {
            showMetaMessage(
              false,
              error instanceof Error ? error.message : "A meta mentése nem sikerült."
            );
          } finally {
            isMetaSaving = false;
            updateMetaSubmitState(Boolean(getSelectedMediaForEditor()));
          }
        });
      }

      if (suggestAlt) {
        suggestAlt.addEventListener("click", () => {
          if (!metaAlt) {
            return;
          }

          const suggestion = buildAltSuggestion();

          if (!suggestion) {
            showSeoMessage(false, "Az ALT javaslathoz előbb adj meg lakást és témát vagy helyiséget.");
            return;
          }

          metaAlt.value = suggestion;
          updateMetaSubmitState(Boolean(getSelectedMediaForEditor()));
          if (seoSuccess) {
            seoSuccess.classList.add("is-hidden");
          }
          if (seoError) {
            seoError.classList.add("is-hidden");
          }
        });
      }

      if (suggestTitle) {
        suggestTitle.addEventListener("click", () => {
          if (!metaTitle) {
            return;
          }

          const suggestion = buildTitleSuggestion();

          if (!suggestion) {
            showSeoMessage(false, "A title javaslathoz előbb adj meg lakást és témát vagy helyiséget.");
            return;
          }

          metaTitle.value = suggestion;
          updateMetaSubmitState(Boolean(getSelectedMediaForEditor()));
          if (seoSuccess) {
            seoSuccess.classList.add("is-hidden");
          }
          if (seoError) {
            seoError.classList.add("is-hidden");
          }
        });
      }

      if (seoSubmit) {
        seoSubmit.addEventListener("click", async () => {
          const selectedMediaItem = getSelectedMediaForEditor();

          if (!selectedMediaItem || !seoThemeRoom || !seoFeatureFocus) {
            showSeoMessage(false, "Nincs kiválasztott kép a SEO mezők mentéséhez.");
            return;
          }

          try {
            isSeoSaving = true;
            updateSeoSubmitState(true);

            const response = await fetch("/api/image-admin/save-seo-fields", {
              method: "POST",
              headers: {
                "Content-Type": "application/json"
              },
              body: JSON.stringify({
                id: selectedMediaItem.id,
                themeRoom: seoThemeRoom.value || "",
                featureFocus: seoFeatureFocus.value || ""
              })
            });

            if (!response.ok) {
              const payload = await response.json().catch(() => null);
              throw new Error(payload?.message || "A SEO mezők mentése nem sikerült.");
            }

            const payload = await response.json();
            updateSeoFieldsState(payload?.id, {
              themeRoom: payload?.themeRoom || "",
              featureFocus: payload?.featureFocus || ""
            });
            showSeoMessage(true, "");
          } catch (error) {
            showSeoMessage(
              false,
              error instanceof Error ? error.message : "A SEO mezők mentése nem sikerült."
            );
          } finally {
            isSeoSaving = false;
            updateSeoSubmitState(Boolean(getSelectedMediaForEditor()));
          }
        });
      }

      if (apartmentSubmit) {
        apartmentSubmit.addEventListener("click", async () => {
          const selectedMediaItem = getSelectedMediaForEditor();

          if (!selectedMediaItem || !apartmentSelect) {
            showApartmentMessage(false, "Nincs kiválasztott kép a lakás hozzárendeléshez.");
            return;
          }

          try {
            isApartmentSaving = true;
            updateApartmentSubmitState(true);

            const response = await fetch("/api/image-admin/save-apartment", {
              method: "POST",
              headers: {
                "Content-Type": "application/json"
              },
              body: JSON.stringify({
                id: selectedMediaItem.id,
                apartmentKey: apartmentSelect.value || null
              })
            });

            if (!response.ok) {
              const payload = await response.json().catch(() => null);
              throw new Error(payload?.message || "A lakás hozzárendelése nem sikerült.");
            }

            const payload = await response.json();

            updateApartmentAssignmentState(payload?.id, payload?.apartmentKey || null);
            renderApartmentFilter();
            renderMediaGridVisibility();
            showApartmentMessage(true, "");
          } catch (error) {
            showApartmentMessage(
              false,
              error instanceof Error ? error.message : "A lakás hozzárendelése nem sikerült."
            );
          } finally {
            isApartmentSaving = false;
            updateApartmentSubmitState(Boolean(getSelectedMediaForEditor()));
          }
        });
      }

      if (bulkClear) {
        bulkClear.addEventListener("click", () => {
          selectedBulkMediaIds = [];

          if (bulkSuccess) {
            bulkSuccess.classList.add("is-hidden");
          }

          if (bulkError) {
            bulkError.classList.add("is-hidden");
          }

          if (bulkSeoSuccess) {
            bulkSeoSuccess.classList.add("is-hidden");
          }

          if (bulkSeoError) {
            bulkSeoError.classList.add("is-hidden");
          }

          renderBulkSelection();
          renderMediaGridVisibility();
        });
      }

      if (bulkSuggestAlt) {
        bulkSuggestAlt.addEventListener("click", async () => {
          await runBulkSeoSuggestion("alt");
        });
      }

      if (bulkSuggestTitle) {
        bulkSuggestTitle.addEventListener("click", async () => {
          await runBulkSeoSuggestion("title");
        });
      }

      if (bulkSubmit) {
        bulkSubmit.addEventListener("click", async () => {
          if (!bulkApartmentSelect || !bulkApartmentSelect.value || selectedBulkMediaIds.length === 0) {
            showBulkMessage(false, "Válassz lakást és legalább egy képet a tömeges mentéshez.");
            return;
          }

          try {
            isBulkSaving = true;
            updateBulkSubmitState();

            const response = await fetch("/api/image-admin/save-apartments", {
              method: "POST",
              headers: {
                "Content-Type": "application/json"
              },
              body: JSON.stringify({
                ids: selectedBulkMediaIds,
                apartmentKey: bulkApartmentSelect.value
              })
            });

            if (!response.ok) {
              const payload = await response.json().catch(() => null);
              throw new Error(payload?.message || "A tömeges lakás-hozzárendelés nem sikerült.");
            }

            const payload = await response.json();
            updateApartmentAssignmentsState(payload?.ids || [], payload?.apartmentKey || null);
            selectedBulkMediaIds = [];
            renderBulkSelection();
            renderMediaGridVisibility();
            showBulkMessage(true, "A kijelölt képek lakás-hozzárendelése elmentve.");
          } catch (error) {
            showBulkMessage(
              false,
              error instanceof Error ? error.message : "A tömeges lakás-hozzárendelés nem sikerült."
            );
          } finally {
            isBulkSaving = false;
            updateBulkSubmitState();
          }
        });
      }

      renderAll();
    }
  </script>

