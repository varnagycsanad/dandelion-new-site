        if (seoSubmit) {
          seoSubmit.disabled = !hasMedia || isSeoSaving;
        }

        if (suggestAlt) {
          suggestAlt.disabled = !hasMedia;
        }

        if (suggestTitle) {
          suggestTitle.disabled = !hasMedia;
        }
      }

      function updateMetaSubmitState(hasMedia) {
        if (metaSubmit) {
          metaSubmit.disabled = !hasMedia || isMetaSaving;
        }
