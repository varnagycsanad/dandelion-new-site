      const quickFilterUnassignedApartment = document.getElementById("dnd-image-admin-filter-unassigned-apartment");
      const metaSubmit = document.getElementById("dnd-image-admin-meta-submit");
      const primarySizeNames = ["full", "large", "medium_large", "medium", "thumbnail"];


      let activeAdminTab = "homepage";
      let activeSlotKey = state.initialSlotKey;
      let activeApartmentFilter = state.initialApartmentFilter || "all";
      let mapping = state.mapping || {};
      let apartmentAssignments = state.apartmentAssignments || {};
      let apartmentImageAssignments = state.apartmentImageAssignments || {};
      let isMetaSaving = false;
      let isApartmentSaving = false;
      let isGalleryOrderSaving = false;
      let isBulkSaving = false;
      let isBulkSeoSaving = false;
      let isSeoSaving = false;
      let selectedBulkMediaIds = [];
      let apartmentGalleryOrderDrafts = {};
      let mediaMetaOverrides = {};
      let mediaSeoFields = state.mediaSeoFields || {};
      let isIntakeSubmitting = false;
      let isSourceListLoading = false;
      let isSourceProcessSubmitting = false;
      let isSourcePublishSubmitting = false;
      let isSourceSelectSubmitting = false;
      let sourceCandidates = [];
      let quickFilters = state.initialQuickFilters || {
        missingAlt: false,
        unassignedApartment: false
      };
      const referrerOrigin = (() => {
        try {
          return document.referrer ? new URL(document.referrer).origin : "";
        } catch {
          return "";
        }
      })();

      function getImageAdminBridgeConfig() {
        const config = window.dndImageAdminConfig;

        if (
          config &&
          typeof config.restRoot === "string" &&
          typeof config.nonce === "string" &&
          typeof config.endpoint === "string"
        ) {
          return config;
        }

        return null;
      }

      function getAllowedBridgeOrigins() {
        return new Set([window.location.origin, referrerOrigin].filter(Boolean));
      }

      async function parseResponsePayload(response) {
        const responseText = await response.text();

        if (!responseText) {
          return { text: "", json: null };
        }

        try {
          return {
            text: responseText,
            json: JSON.parse(responseText)
          };
        } catch {
          return {
            text: responseText,
            json: null
          };
        }
      }

      // [CHANGE 2026-04-25 12:06] Show a short serialized REST response in save diagnostics.
      function summarizeResponsePayload(payload) {
        if (payload == null) {
          return "";
        }

        try {
          const serialized = typeof payload === "string" ? payload : JSON.stringify(payload);
          return serialized.length > 240 ? `${serialized.slice(0, 237)}...` : serialized;
        } catch {
          return String(payload);
        }
      }

      function updateIntakeUiState() {
        if (currentImageUseForIntakeButton) {
          currentImageUseForIntakeButton.disabled = isIntakeSubmitting || !getSelectedMediaForEditor();
        }

        if (intakeUseSelectedButton) {
          intakeUseSelectedButton.disabled = isIntakeSubmitting || !getSelectedMediaForEditor();
        }

        if (intakePreviewButton) {
          intakePreviewButton.disabled = isIntakeSubmitting;
        }

        if (intakeSubmitButton) {
          intakeSubmitButton.disabled = isIntakeSubmitting;
        }
      }

      function setIntakeResult(ok, statusMessage, outputText) {
        if (intakeStatus) {
          intakeStatus.textContent = statusMessage;
          intakeStatus.style.color = ok ? "#6b4a00" : "#8a1616";
        }

        if (intakeOutput) {
          intakeOutput.textContent = outputText || "Nincs válasz.";
          intakeOutput.dataset.state = ok ? "success" : "error";
        }
      }

      function buildThemeSuggestion(mediaItem) {
        if (!mediaItem) {
          return "";
        }

        const candidates = [
          mediaItem.title,
          mediaItem.filename ? String(mediaItem.filename).replace(/\.[a-z0-9]+$/i, "") : "",
        ];

        for (const candidate of candidates) {
          const suggestion = slugifyThemeCandidate(candidate);
          if (suggestion) {
            return suggestion;
          }
        }

        return "";
      }

      function slugifyThemeCandidate(value) {
        const normalized = String(value ?? "")
          .normalize("NFD")
          .replace(/[\u0300-\u036f]/g, "")
          .toLowerCase()
          .replace(/[^a-z0-9]+/g, "-")
          .replace(/^-+|-+$/g, "")
          .replace(/-{2,}/g, "-");

        if (!/[a-z]/.test(normalized) || normalized.length < 3) {
          return "";
        }

        return normalized;
      }

      function useSelectedMediaForIntake() {
        const mediaItem = getSelectedMediaForEditor();

        if (!mediaItem || !intakeWpIdInput) {
          setIntakeResult(false, "Intake hiba", "Előbb válassz ki egy képet.");
          return;
        }

        intakeWpIdInput.value = String(mediaItem.id || "");

        if (intakeThemeInput) {
          intakeThemeInput.value = buildThemeSuggestion(mediaItem);
        }

        setIntakeResult(true, "Source candidate előkészítve", "A kiválasztott kép adatai bekerültek az intake mezőkbe.");
      }

      function updateSourceListUiState() {
        if (sourceListRefreshButton) {
          sourceListRefreshButton.disabled =
            isSourceListLoading || isSourceSelectSubmitting || isSourceProcessSubmitting || isSourcePublishSubmitting;
        }

        if (sourceListApartmentSelect) {
          sourceListApartmentSelect.disabled =
            isSourceListLoading || isSourceSelectSubmitting || isSourceProcessSubmitting || isSourcePublishSubmitting;
        }

        if (!sourceListContainer) {
          return;
        }

        sourceListContainer
          .querySelectorAll("[data-source-select-button], [data-source-process-button], [data-source-publish-button]")
          .forEach((button) => {
            button.disabled =
              isSourceListLoading || isSourceSelectSubmitting || isSourceProcessSubmitting || isSourcePublishSubmitting;
          });
      }

      function setSourceListResult(ok, statusMessage, outputText) {
        if (sourceListStatus) {
          sourceListStatus.textContent = statusMessage;
          sourceListStatus.style.color = ok ? "#6b4a00" : "#8a1616";
        }

        if (sourceListOutput) {
          sourceListOutput.textContent = outputText || "Nincs válasz.";
          sourceListOutput.dataset.state = ok ? "success" : "error";
        }
      }

      function escapeHtml(value) {
        return String(value ?? "")
          .replace(/&/g, "&amp;")
          .replace(/</g, "&lt;")
          .replace(/>/g, "&gt;")
          .replace(/"/g, "&quot;")
          .replace(/'/g, "&#39;");
      }

      function computeSourceSummary(candidates) {
        const list = Array.isArray(candidates) ? candidates : [];

        return {
          total: list.length,
          sourceFound: list.filter((candidate) => candidate.status === "source_found").length,
          selected: list.filter((candidate) => candidate.status === "selected").length,
          selectedUnprocessed: list.filter(
            (candidate) => candidate.status === "selected" && candidate.processed === false,
          ).length,
          processedUnpublished: list.filter(
            (candidate) => candidate.processed === true && candidate.published === false,
          ).length,
          published: list.filter((candidate) => candidate.published === true).length,
        };
      }

      function renderSourceSummary() {
        if (!sourceSummaryGrid) {
          return;
        }

        if (!Array.isArray(sourceCandidates) || sourceCandidates.length === 0) {
          sourceSummaryGrid.innerHTML =
            '<div class="dnd-image-admin__source-summary-empty">Nincs betöltött állapot.</div>';
          return;
        }

        const summary = computeSourceSummary(sourceCandidates);
        const cards = [
          ["Összes candidate", summary.total],
          ["source_found", summary.sourceFound],
          ["selected", summary.selected],
          ["selected, de WebP még nincs kész", summary.selectedUnprocessed],
          ["processed, de nincs published", summary.processedUnpublished],
          ["published", summary.published],
        ];

        sourceSummaryGrid.innerHTML = cards
          .map(
            ([label, value]) => `
              <article class="dnd-image-admin__source-summary-card">
                <span>${escapeHtml(label)}</span>
                <strong>${escapeHtml(value)}</strong>
              </article>
            `,
          )
          .join("");
      }

      function renderSourceCandidates() {
        if (!sourceListContainer) {
          return;
        }

        renderSourceSummary();

        if (!Array.isArray(sourceCandidates) || sourceCandidates.length === 0) {
          sourceListContainer.innerHTML =
            '<div class="dnd-image-admin__source-empty">Nincs source candidate a kiválasztott apartmanhoz.</div>';
          updateSourceListUiState();
          return;
        }

        sourceListContainer.innerHTML = sourceCandidates
          .map((candidate) => {
            const wpId = candidate.wpId ? `<div><strong>WP ID:</strong> ${escapeHtml(candidate.wpId)}</div>` : "";
            const theme = candidate.theme ? `<div><strong>Theme:</strong> ${escapeHtml(candidate.theme)}</div>` : "";
            const room = candidate.room ? `<div><strong>Room:</strong> ${escapeHtml(candidate.room)}</div>` : "";
            const sortOrder =
              candidate.sortOrder != null
                ? `<div><strong>Sort:</strong> ${escapeHtml(candidate.sortOrder)}</div>`
                : "";
            const originalUrl = candidate.originalUrl
              ? `<div class="dnd-image-admin__source-path"><strong>Source:</strong> ${escapeHtml(candidate.originalUrl)}</div>`
              : "";
            const galleryTarget = candidate.galleryTargetPath
              ? `<div class="dnd-image-admin__source-path"><strong>Gallery:</strong> ${escapeHtml(candidate.galleryTargetPath)}${candidate.galleryExists ? " <em>(megvan)</em>" : " <em>(hiányzik)</em>"}</div>`
              : "";
            const thumbTarget = candidate.thumbTargetPath
              ? `<div class="dnd-image-admin__source-path"><strong>Thumb:</strong> ${escapeHtml(candidate.thumbTargetPath)}${candidate.thumbExists ? " <em>(megvan)</em>" : " <em>(hiányzik)</em>"}</div>`
              : "";
            const registryEntry = candidate.registryId
              ? `<div class="dnd-image-admin__source-path"><strong>Registry:</strong> ${escapeHtml(candidate.registryId)}</div>`
              : "";
            const registrySrc = candidate.registrySrc
              ? `<div class="dnd-image-admin__source-path"><strong>Registry src:</strong> ${escapeHtml(candidate.registrySrc)}</div>`
              : "";
            const registryThumb = candidate.registryThumb
              ? `<div class="dnd-image-admin__source-path"><strong>Registry thumb:</strong> ${escapeHtml(candidate.registryThumb)}</div>`
              : "";
            const canProcess = candidate.status === "selected" && Boolean(candidate.galleryTargetPath) && Boolean(candidate.thumbTargetPath);

            let actionMarkup = `<span class="dnd-image-admin__source-state">Státusz: ${escapeHtml(candidate.status)}</span>`;

            if (candidate.status === "source_found") {
              actionMarkup = `
                <button
                  type="button"
                  class="dnd-btn dnd-btn--secondary dnd-image-admin__source-action"
                  data-source-select-button="${escapeHtml(candidate.id)}"
                >
                  Jóváhagyás feldolgozásra
                </button>
              `;
            } else if (canProcess && candidate.processed && candidate.published) {
              actionMarkup = `
                <span class="dnd-image-admin__source-state is-approved">
                  Már publikálva
                </span>
              `;
            } else if (canProcess && candidate.processed && !candidate.published) {
              actionMarkup = `
                <button
                  type="button"
                  class="dnd-btn dnd-btn--secondary dnd-image-admin__source-action"
                  data-source-publish-button="${escapeHtml(candidate.id)}"
                >
                  Publikálás galériába
                </button>
              `;
            } else if (canProcess && !candidate.processed) {
              actionMarkup = `
                <button
                  type="button"
                  class="dnd-btn dnd-btn--secondary dnd-image-admin__source-action"
                  data-source-process-button="${escapeHtml(candidate.id)}"
                >
                  WebP gyártás
                </button>
              `;
            } else if (candidate.status === "selected" && candidate.processed) {
              actionMarkup = `
                <span class="dnd-image-admin__source-state is-approved">
                  WebP már elkészült
                </span>
              `;
            }

            return `
              <article class="dnd-image-admin__source-card">
                <div class="dnd-image-admin__source-card-head">
                  <strong>${escapeHtml(candidate.id)}</strong>
                  <span class="dnd-image-admin__source-badge">${escapeHtml(candidate.role || "-")}</span>
                </div>
                <div class="dnd-image-admin__source-meta">
                  <div><strong>Státusz:</strong> ${escapeHtml(candidate.status)}</div>
                  ${wpId}
                  ${theme}
                  ${room}
                  ${sortOrder}
                </div>
                ${originalUrl}
                ${galleryTarget}
                ${thumbTarget}
                ${registryEntry}
                ${registrySrc}
                ${registryThumb}
                <div class="dnd-image-admin__source-actions">
                  ${actionMarkup}
                </div>
              </article>
            `;
          })
          .join("");

        sourceListContainer
          .querySelectorAll("[data-source-select-button]")
          .forEach((button) => {
            button.addEventListener("click", async () => {
              const sourceId = button.getAttribute("data-source-select-button");
              if (!sourceId || !sourceListApartmentSelect) {
                return;
              }

              await runSourceSelectRequest(sourceListApartmentSelect.value, sourceId);
            });
          });

        sourceListContainer
          .querySelectorAll("[data-source-process-button]")
          .forEach((button) => {
