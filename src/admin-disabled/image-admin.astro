      async function loadSourceCandidates() {
        if (!sourceListApartmentSelect) {
          return;
        }

        try {
          isSourceListLoading = true;
          updateSourceListUiState();
          setSourceListResult(true, "Candidate lista betöltése folyamatban...", "");

          const apartment = sourceListApartmentSelect.value || "";
          const response = await fetch(
            `${apiUrl("list-sources")}?apartment=${encodeURIComponent(apartment)}`,
          );
          const payload = await response.json().catch(() => null);

          if (!response.ok || !payload?.ok) {
            sourceCandidates = [];
            renderSourceCandidates();
            setSourceListResult(false, "Candidate lista hiba", payload?.error || "A source lista betöltése nem sikerült.");
            return;
          }

          sourceCandidates = Array.isArray(payload.candidates) ? payload.candidates : [];
          renderSourceCandidates();
          setSourceListResult(
            true,
            `Candidate lista betöltve (${sourceCandidates.length} elem)`,
            JSON.stringify(payload, null, 2),
          );
        } catch (error) {
          sourceCandidates = [];
          renderSourceCandidates();
          setSourceListResult(
            false,
            "Candidate lista hiba",
            error instanceof Error ? error.message : "A source lista betöltése nem sikerült.",
          );
        } finally {
          isSourceListLoading = false;
          updateSourceListUiState();
        }
      }

