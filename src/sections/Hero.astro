---
const bookingLink =
  "https://ibe.sabeeapp.com/v3/p/Dandelion-Vendeghazak?p=3970b30e1042d58f";
const heroVideo =
  "https://dandelionhouse.hu/wp-content/uploads/2025/08/202507-V1.mp4";
const heroPoster = "";
---

<!-- [CHANGE 2026-04-17 20:24] Hero redesigned toward visual-first layout -->
<section class="dnd-hero">
  <div class="dnd-container dnd-hero__grid">
    <div class="dnd-hero__content">
      <span class="dnd-eyebrow">Balaton-felvidék • közvetlen foglalás</span>
      <h1 class="dnd-title">Lassulj le a Balaton-felvidéken</h1>
      <p class="dnd-lead">
        Természetközeli, prémium vendégházak közvetlen foglalással.
      </p>

      <div class="dnd-hero__actions">
        <a href={bookingLink} class="dnd-btn dnd-btn--primary" target="_blank" rel="noopener noreferrer">
          Foglalás
        </a>
        <a href="/szallasok" class="dnd-btn dnd-btn--secondary">Szállások</a>
      </div>
    </div>

    <div class="dnd-hero__visual">
      <div class="dnd-hero__media-shell">
        <video
          class="dnd-hero__video"
          src={heroVideo}
          poster={heroPoster}
          autoplay
          muted
          loop
          playsinline
        >
          A böngésződ nem támogatja a háttérvideó lejátszását.
        </video>
        <div class="dnd-hero__video-overlay"></div>
      </div>
    </div>
  </div>
</section>

<style>
  .dnd-hero {
    padding: 28px 0 34px;
  }

  .dnd-hero__grid {
    gap: 22px;
    align-items: center;
  }

  .dnd-hero__content {
    max-width: 420px;
  }

  .dnd-title {
    max-width: 7ch;
    font-size: clamp(2.8rem, 4.6vw, 4rem);
    line-height: 0.98;
  }

  .dnd-lead {
    max-width: 32ch;
    margin-top: 16px;
    font-size: 1rem;
    line-height: 1.65;
  }

  .dnd-hero__actions {
    margin-top: 22px;
  }

  .dnd-hero__media-shell {
    min-height: 520px;
    border-radius: 34px;
  }

  @media (min-width: 960px) {
    .dnd-hero__grid {
      grid-template-columns: minmax(320px, 0.68fr) minmax(0, 1.32fr);
      gap: 28px;
    }
  }

  @media (max-width: 959px) {
    .dnd-hero {
      padding-top: 24px;
    }

    .dnd-hero__media-shell {
      min-height: 400px;
    }
  }

  @media (max-width: 767px) {
    .dnd-hero {
      padding: 18px 0 28px;
    }

    .dnd-hero__content {
      max-width: none;
    }

    .dnd-title {
      max-width: 9ch;
      font-size: 2.45rem;
    }

    .dnd-lead {
      margin-top: 12px;
    }

    .dnd-hero__media-shell {
      min-height: 300px;
    }
  }
</style>
