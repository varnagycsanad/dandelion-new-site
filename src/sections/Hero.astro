---
const bookingLink =
  "https://ibe.sabeeapp.com/v3/p/Dandelion-Vendeghazak?p=3970b30e1042d58f";
const heroVideo =
  "https://dandelionhouse.hu/wp-content/uploads/2025/08/202507-V1.mp4";
const heroPoster = "";
---

<section class="dnd-hero">
  <div class="dnd-container dnd-hero__grid">
    <div class="dnd-hero__content">
      <span class="dnd-eyebrow">Balaton-felvidék • közvetlen foglalás</span>
      <h1 class="dnd-title">
        Nyugodt, designérzékeny vendégházak a Balaton-felvidék legszebb ritmusában.
      </h1>
      <p class="dnd-lead">
        A Dandelion Vendégházak modern, természetközeli szállásai azoknak készültek,
        akik prémium környezetben szeretnének lelassulni, feltöltődni és közvetlenül foglalni.
      </p>

      <div class="dnd-hero__actions">
        <a href={bookingLink} class="dnd-btn dnd-btn--primary" target="_blank" rel="noopener noreferrer">
          Foglalás
        </a>
        <a href="/szallasok" class="dnd-btn dnd-btn--secondary">Szállások</a>
      </div>

      <div class="dnd-hero__metrics">
        <article class="dnd-hero__metric">
          <strong>8</strong>
          <span>különleges ház</span>
        </article>
        <article class="dnd-hero__metric">
          <strong>100%</strong>
          <span>közvetlen foglalási út</span>
        </article>
        <article class="dnd-hero__metric">
          <strong>Balaton</strong>
          <span>természet, design, nyugalom</span>
        </article>
      </div>
    </div>

    <div class="dnd-hero__visual">
      <div class="dnd-hero__media-shell">
        <video
          class="dnd-hero__video"
          src={heroVideo}
          poster={heroPoster}
          autoplay
          muted
          loop
          playsinline
        >
          A böngésződ nem támogatja a háttérvideó lejátszását.
        </video>
        <div class="dnd-hero__video-overlay"></div>
        <div class="dnd-hero__floating-card">
          <span class="dnd-hero__floating-label">Hero film</span>
          <strong>Hangulat, fények és helyszínélmény ugyanabban a prémium nyitóképben.</strong>
        </div>
      </div>
    </div>
  </div>
</section>
