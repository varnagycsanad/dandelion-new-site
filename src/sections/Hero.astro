---
// [CHANGE 2026-05-20 00:00] Hero copy and CTAs can now be localized while preserving the original video layout.
// [CHANGE 2026-05-21 00:00] The homepage hero accepts optional responsive video sources and poster fallback for landing pages.
// [CHANGE 2026-05-29 00:00] Responsive hero videos now expose their poster fallback for video indexing.
// [CHANGE 2026-06-06 00:00] Mobile hero videos can defer their source to keep the poster as the initial mobile paint.
// [CHANGE 2026-06-11 00:00] Hungarian homepage hero description made more concrete and less generic.
// [CHANGE 2026-07-15 00:00] Responsive hero video prefers the lighter mobile poster for the initial mobile paint.
// [CHANGE 2026-08-02 11:00] Restore the compact circular booking badge on the homepage mobile hero.
// [CHANGE 2026-08-02 11:30] Make the mobile booking badge draggable and remember its position.
interface HeroCta {
  label: string;
  href: string;
  target?: string;
  rel?: string;
}

interface Props {
  kicker?: string;
  title?: string;
  titleTopLines?: string[];
  titleBottomLines?: string[];
  description?: string;
  ctas?: HeroCta[];
  secondaryCtas?: HeroCta[];
  videoSrc?: string;
  videoDesktopSrc?: string;
  videoMobileSrc?: string;
  posterSrc?: string;
  posterDesktopSrc?: string;
  posterMobileSrc?: string;
  posterAlt?: string;
  overlay?: boolean;
  deferMobileVideo?: boolean;
  videoFallbackText?: string;
  bookingBenefits?: string[];
  bookingBenefitsCopy?: {
    ariaLabel: string;
    kicker: string;
    title: string;
    lead: string;
    summary: string;
    badge: string;
  };
}

const {
  kicker,
  title,
  titleTopLines = ["Reggel", "hegyekkel."],
  titleBottomLines = ["Este", "csillagokkal."],
  description = "Vendégházak a Szent György-hegy, a Balaton és a Káli-medence körül. Terasz, panoráma, medence és csend.",
  ctas = [{ label: "Szállásaink", href: "#stays" }],
  secondaryCtas = [],
  videoSrc,
  videoDesktopSrc,
  videoMobileSrc,
  posterSrc,
  posterDesktopSrc,
  posterMobileSrc,
  posterAlt = "",
  overlay = false,
  deferMobileVideo = true,
  videoFallbackText = "A böngésződ nem támogatja a háttérvideó lejátszását.",
  bookingBenefits = [],
  bookingBenefitsCopy = {
    ariaLabel: "Közvetlen foglalás előnyei",
    kicker: "Közvetlen foglalás",
    title: "Megéri itt foglalni",
    lead: "A közvetlen foglalás előnyei:",
    summary: "Legjobb árak és azonnali bankkártyás fizetés a honlapon.",
    badge: "Megéri nálunk foglalni!"
  }
} = Astro.props;

const heroVideo = videoSrc ?? "/videos/fooldal/hero/DND_Fooldal_hero_05-21.mp4?v=20260521";
const hasResponsiveVideo = Boolean(videoDesktopSrc || videoMobileSrc);
const hasVideo = Boolean(heroVideo || hasResponsiveVideo);
const fallbackPoster = posterSrc ?? posterMobileSrc ?? posterDesktopSrc;
const shouldDeferMobileVideo = Boolean(deferMobileVideo && videoMobileSrc);
---

<!-- [CHANGE 2026-04-17 08:50] Update hero CTA, placement, and typography without redesign -->
<section class:list={["dnd-hero", overlay && "dnd-hero--overlay", bookingBenefits.length > 0 && "dnd-hero--with-booking-benefits"]}>
  {hasVideo ? (
    <video
      class="dnd-hero__video"
      src={hasResponsiveVideo ? undefined : heroVideo}
      poster={fallbackPoster}
      autoplay
      muted
      loop
      playsinline
      webkit-playsinline
      preload={shouldDeferMobileVideo ? "metadata" : "auto"}
      disablepictureinpicture
      disableremoteplayback
      data-dnd-mobile-deferred={shouldDeferMobileVideo ? "true" : undefined}
      data-dnd-mobile-src={shouldDeferMobileVideo ? videoMobileSrc : undefined}
      data-dnd-mobile-poster={shouldDeferMobileVideo && posterMobileSrc ? posterMobileSrc : undefined}
    >
      {videoMobileSrc && !shouldDeferMobileVideo && <source media="(max-width: 767px)" src={videoMobileSrc} type="video/mp4" />}
      {videoDesktopSrc && <source media="(min-width: 768px)" src={videoDesktopSrc} type="video/mp4" />}
      {videoFallbackText}
    </video>
  ) : fallbackPoster && (
    posterDesktopSrc || posterMobileSrc ? (
      <picture class="dnd-hero__video">
        {posterMobileSrc && <source media="(max-width: 767px)" srcset={posterMobileSrc} />}
        {posterDesktopSrc && <source media="(min-width: 768px)" srcset={posterDesktopSrc} />}
        <img src={fallbackPoster} alt={posterAlt} loading="eager" decoding="async" />
      </picture>
    ) : (
      <img class="dnd-hero__video" src={fallbackPoster} alt={posterAlt} loading="eager" decoding="async" />
    )
  )}

  <div class="dnd-hero__content">
    <div class="dnd-container dnd-hero__inner">
      <div class="dnd-hero__text">
        {kicker && <span class="dnd-hero__kicker">{kicker}</span>}
        <h1 class:list={["dnd-hero__title", !title && "dnd-hero__title--split"]}>
          {title ? (
            title
          ) : (
            <>
              <span class="dnd-hero__title-block dnd-hero__title-block--top">
                {titleTopLines.map((line, index) => (
                  <span class="dnd-hero__title-line">{line}{index < titleTopLines.length - 1 ? " " : ""}</span>
                ))}
              </span>
              <span class="dnd-hero__divider" aria-hidden="true">
                <span class="dnd-hero__divider-line"></span>
                <span class="dnd-hero__divider-circle"></span>
                <span class="dnd-hero__divider-line"></span>
              </span>
              <span class="dnd-hero__title-block dnd-hero__title-block--bottom">
                {titleBottomLines.map((line, index) => (
                  <span class="dnd-hero__title-line">{line}{index < titleBottomLines.length - 1 ? " " : ""}</span>
                ))}
              </span>
            </>
          )}
        </h1>
        <p class="dnd-hero__desc">{description}</p>

        <div class="dnd-hero__cta">
          {ctas.map((cta) => (
            <a href={cta.href} class="dnd-btn dnd-btn--primary" target={cta.target} rel={cta.rel}>{cta.label}</a>
          ))}
          {secondaryCtas.map((cta) => (
            <a href={cta.href} class="dnd-btn dnd-btn--secondary" target={cta.target} rel={cta.rel}>{cta.label}</a>
          ))}
        </div>
      </div>
      {Astro.slots.has("aside") && (
        <div class="dnd-hero__aside">
          <slot name="aside" />
        </div>
      )}
    </div>
  </div>

  {bookingBenefits.length > 0 && (
    <aside class="dnd-hero__booking-benefits" aria-label={bookingBenefitsCopy.ariaLabel}>
      <span class="dnd-hero__booking-benefits-kicker">{bookingBenefitsCopy.kicker}</span>
      <h2>{bookingBenefitsCopy.title}</h2>
      <p class="dnd-hero__booking-benefits-lead">{bookingBenefitsCopy.lead}</p>
      <p class="dnd-hero__booking-benefits-summary">{bookingBenefitsCopy.summary}</p>
      <ul>
        {bookingBenefits.map((benefit) => <li>{benefit}</li>)}
      </ul>
    </aside>
  )}
  <span class:list={["dnd-hero__booking-badge", bookingBenefits.length > 0 && "dnd-hero__booking-badge--mobile-only"]}>{bookingBenefitsCopy.badge}</span>
</section>

<script is:inline>
  (() => {
    const setup = () => {
      const mobileQuery = window.matchMedia("(max-width: 767px)");
      const badge = document.querySelector(".dnd-hero__booking-badge--mobile-only");

      if (!mobileQuery.matches || !(badge instanceof HTMLElement)) {
        return;
      }

      const storageKey = "dnd-home-booking-badge-position-v1";
      const viewportPadding = 12;
      let dragState = null;

      const clampPosition = (left, top) => ({
        left: Math.min(Math.max(left, viewportPadding), Math.max(viewportPadding, window.innerWidth - badge.offsetWidth - viewportPadding)),
        top: Math.min(Math.max(top, viewportPadding), Math.max(viewportPadding, window.innerHeight - badge.offsetHeight - viewportPadding))
      });

      const applyPosition = (left, top) => {
        const position = clampPosition(left, top);
        badge.style.left = `${position.left}px`;
        badge.style.top = `${position.top}px`;
        badge.style.right = "auto";
        badge.style.bottom = "auto";
      };

      const savePosition = () => {
        try {
          const rect = badge.getBoundingClientRect();
          localStorage.setItem(storageKey, JSON.stringify({ left: rect.left, top: rect.top }));
        } catch {
          // The badge remains draggable if storage is unavailable.
        }
      };

      try {
        const saved = JSON.parse(localStorage.getItem(storageKey) || "null");

        if (saved && Number.isFinite(saved.left) && Number.isFinite(saved.top)) {
          applyPosition(saved.left, saved.top);
        }
      } catch {
        // Use the default right-bottom position when storage is unavailable or invalid.
      }

      const finishDrag = (event) => {
        if (!dragState || event.pointerId !== dragState.pointerId) {
          return;
        }

        if (badge.hasPointerCapture?.(event.pointerId)) {
          badge.releasePointerCapture(event.pointerId);
        }

        if (dragState.moved) {
          savePosition();
        }

        dragState = null;
        badge.classList.remove("is-dragging");
      };

      badge.addEventListener("pointerdown", (event) => {
        if (event.pointerType === "mouse" && event.button !== 0) {
          return;
        }

        const rect = badge.getBoundingClientRect();
        dragState = {
          pointerId: event.pointerId,
          offsetX: event.clientX - rect.left,
          offsetY: event.clientY - rect.top,
          moved: false
        };
        badge.setPointerCapture?.(event.pointerId);
        badge.classList.add("is-dragging");
        event.preventDefault();
      });

      badge.addEventListener("pointermove", (event) => {
        if (!dragState || event.pointerId !== dragState.pointerId) {
          return;
        }

        applyPosition(event.clientX - dragState.offsetX, event.clientY - dragState.offsetY);
        dragState.moved = true;
        event.preventDefault();
      });

      badge.addEventListener("pointerup", finishDrag);
      badge.addEventListener("pointercancel", finishDrag);

      window.addEventListener("resize", () => {
        if (badge.style.left && badge.style.top) {
          applyPosition(Number.parseFloat(badge.style.left), Number.parseFloat(badge.style.top));
          savePosition();
        }
      });
    };

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", setup, { once: true });
    } else {
      setup();
    }
  })();
</script>

{shouldDeferMobileVideo && (
  <script is:inline>
    (() => {
      const mobileQuery = window.matchMedia("(max-width: 767px)");

      if (!mobileQuery.matches) {
        return;
      }

      const videos = document.querySelectorAll("video[data-dnd-mobile-deferred='true'][data-dnd-mobile-src]");

      videos.forEach((video) => {
        if (video instanceof HTMLVideoElement && video.dataset.dndMobilePoster) {
          video.poster = video.dataset.dndMobilePoster;
        }
      });

      const attachMobileSource = (video) => {
        if (!(video instanceof HTMLVideoElement) || video.dataset.dndMobileLoaded === "true") {
          return;
        }

        const src = video.dataset.dndMobileSrc;

        if (!src) {
          return;
        }

        const source = document.createElement("source");
        source.media = "(max-width: 767px)";
        source.src = src;
        source.type = "video/mp4";
        video.insertBefore(source, video.firstChild);
        video.dataset.dndMobileLoaded = "true";
        video.preload = "metadata";
        video.load();

        const playback = video.play();

        if (playback && typeof playback.catch === "function") {
          playback.catch(() => {});
        }
      };

      const loadAll = () => {
        videos.forEach((video) => attachMobileSource(video));
      };

      const scheduleLoad = () => {
        window.setTimeout(loadAll, 7000);
      };

      window.addEventListener("scroll", loadAll, { once: true, passive: true });
      window.addEventListener("pointerdown", loadAll, { once: true, passive: true });
      window.addEventListener("keydown", loadAll, { once: true });

      if (document.readyState === "complete") {
        scheduleLoad();
      } else {
        window.addEventListener("load", scheduleLoad, { once: true });
      }
    })();
  </script>
)}

<style>
  .dnd-hero {
    position: relative;
    min-height: 600px;
    height: 86vh;
    overflow: hidden;
    background: #171717;
  }

  .dnd-hero__video {
    position: absolute;
    inset: 0;
  }

  .dnd-hero__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .dnd-hero__video img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .dnd-hero--overlay::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background:
      linear-gradient(180deg, rgba(0, 0, 0, 0.34), rgba(0, 0, 0, 0.18) 42%, rgba(0, 0, 0, 0.48)),
      linear-gradient(90deg, rgba(0, 0, 0, 0.24), rgba(0, 0, 0, 0.04) 52%, rgba(0, 0, 0, 0.28));
  }

  .dnd-hero__content {
    position: relative;
    z-index: 2;
    min-height: 100%;
    color: #fff;
  }

  .dnd-hero__booking-badge {
    position: fixed;
    right: clamp(24px, 5vw, 84px);
    bottom: clamp(24px, 5vh, 58px);
    z-index: 45;
    display: grid;
    place-items: center;
    width: clamp(132px, 12vw, 168px);
    aspect-ratio: 1;
    padding: 20px;
    border: 1px solid rgba(244, 218, 157, 0.92);
    border-radius: 50%;
    background:
      radial-gradient(circle at 35% 28%, rgba(255, 242, 192, 0.22), transparent 34%),
      linear-gradient(145deg, #d3a84d 0%, #ae7d2d 52%, #8d611f 100%);
    color: #fff8e9;
    font-family: var(--dnd-font-display);
    font-size: clamp(0.95rem, 1.15vw, 1.18rem);
    font-weight: 400;
    line-height: 1.16;
    letter-spacing: 0.015em;
    text-align: center;
    text-wrap: balance;
    box-shadow: 0 14px 32px rgba(16, 13, 8, 0.3), inset 0 0 0 1px rgba(72, 46, 11, 0.3);
  }

  .dnd-hero__booking-badge--mobile-only {
    display: none;
    touch-action: none;
    user-select: none;
  }

  .dnd-hero__booking-badge::before {
    content: "";
    position: absolute;
    inset: 8px;
    border: 1px solid rgba(255, 242, 192, 0.62);
    border-radius: 50%;
    pointer-events: none;
  }

  .dnd-hero__booking-benefits {
    position: absolute;
    right: clamp(24px, 6vw, 88px);
    bottom: clamp(28px, 5vh, 56px);
    z-index: 3;
    width: min(348px, calc(100% - 32px));
    padding: 24px 26px 22px;
    overflow: hidden;
    border: 1px solid rgba(255, 247, 216, 0.72);
    border-radius: 20px;
    background:
      linear-gradient(135deg, rgba(255, 247, 215, 0.96) 0%, rgba(244, 210, 119, 0.97) 58%, rgba(211, 161, 55, 0.96) 100%);
    color: #2d241c;
    box-shadow: 0 18px 44px rgba(16, 13, 8, 0.28), inset 0 1px 0 rgba(255, 255, 255, 0.34);
    backdrop-filter: blur(8px);
  }

  .dnd-hero__booking-benefits::before {
    content: "";
    position: absolute;
    inset: 0 auto 0 0;
    width: 4px;
    background: rgba(112, 75, 18, 0.64);
  }

  .dnd-hero__booking-benefits-kicker {
    display: block;
    margin-bottom: 10px;
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(45, 36, 28, 0.68);
  }

  .dnd-hero__booking-benefits h2 {
    margin: 0;
    font-family: var(--dnd-font-display);
    font-size: clamp(1.55rem, 2vw, 2.05rem);
    font-weight: 400;
    line-height: 0.98;
    letter-spacing: 0.02em;
  }

  .dnd-hero__booking-benefits-lead {
    margin: 10px 0 12px;
    font-size: 0.8rem;
    line-height: 1.45;
  }

  .dnd-hero__booking-benefits-summary {
    display: none;
  }

  .dnd-hero__booking-benefits ul {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .dnd-hero__booking-benefits li {
    position: relative;
    padding: 8px 0 8px 18px;
    border-top: 1px solid rgba(45, 36, 28, 0.16);
    font-size: 0.8rem;
    line-height: 1.35;
  }

  .dnd-hero__booking-benefits li::before {
    content: "✦";
    position: absolute;
    left: 0;
    top: 8px;
    color: rgba(109, 72, 18, 0.82);
  }

  .dnd-hero__inner {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: flex-end;
    min-height: 100%;
    max-width: none;
    padding: 148px clamp(8vw, 10vw, 12vw) clamp(20vh, 24vh, 30vh) 40px;
  }

  .dnd-hero__text {
    width: min(100%, 540px);
    text-align: left;
  }

  .dnd-hero__aside {
    position: relative;
    z-index: 2;
  }

  .dnd-hero__kicker {
    display: inline-block;
    margin: 0 0 14px;
    color: rgba(255, 250, 241, 0.78);
    font-size: var(--dnd-text-xs);
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .dnd-hero__title {
    margin: 0;
    max-width: 10.5ch;
    font-size: clamp(56px, 4.4vw, 64px);
    line-height: 1.02;
    font-family: var(--dnd-font-display);
    font-weight: 400;
    letter-spacing: var(--dnd-tracking-display-tight);
    text-wrap: balance;
    color: rgba(255, 255, 255, 0.92);
  }

  .dnd-hero__divider {
    display: none;
  }

  .dnd-hero__desc {
    margin: 14px 0 0;
    max-width: 34ch;
    font-size: var(--dnd-text-body);
    line-height: 1.72;
    font-weight: 400;
    color: rgba(255, 255, 255, 0.68);
  }

  .dnd-hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }

  .dnd-hero__cta .dnd-btn {
    min-height: 42px;
    padding: 0 24px;
    border-color: rgba(255, 250, 241, 0.88);
    border-width: 1px;
    border-radius: 8px;
    background: transparent;
    color: rgba(255, 250, 241, 0.96);
    box-shadow: none;
  }

  .dnd-hero__cta .dnd-btn:hover,
  .dnd-hero__cta .dnd-btn:focus-visible {
    background: rgba(255, 250, 241, 0.08);
    border-color: rgba(255, 250, 241, 1);
  }

  .dnd-hero__cta .dnd-btn--secondary {
    background: rgba(255, 250, 241, 0.08);
    color: rgba(255, 250, 241, 0.92);
  }

  @media (min-width: 768px) {
    .dnd-hero {
      padding: 0;
    }

    .dnd-hero__inner {
      align-items: center;
      justify-content: flex-start;
      padding: clamp(280px, 40vh, 420px) clamp(48px, 7vw, 96px) 96px;
    }

    .dnd-hero__text {
      display: flex;
      flex-direction: column;
      align-items: center;
      width: min(100%, 1040px);
      text-align: center;
    }

    .dnd-hero__aside {
      width: min(100%, 360px);
    }

    .dnd-hero__title {
      max-width: none;
      font-size: clamp(30px, 2.35vw, 42px);
      line-height: 1.08;
      font-weight: 400;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      text-wrap: initial;
    }

    .dnd-hero__title-block,
    .dnd-hero__title-line {
      display: inline;
    }

    .dnd-hero__title--split {
      white-space: nowrap;
    }

    .dnd-hero__divider {
      display: grid;
      grid-template-columns: minmax(120px, 1fr) 14px minmax(120px, 1fr);
      align-items: center;
      gap: 24px;
      width: min(100%, 430px);
      margin: 26px auto 22px;
      color: rgba(255, 250, 241, 0.72);
    }

    .dnd-hero__divider-line {
      height: 1px;
      background: currentColor;
    }

    .dnd-hero__divider-circle {
      width: 14px;
      height: 14px;
      border: 2px solid currentColor;
      border-radius: 50%;
    }

    .dnd-hero__desc {
      margin: 0 auto;
      max-width: 40ch;
      font-size: var(--dnd-text-lead);
      line-height: 1.55;
      font-weight: 400;
      text-align: center;
      color: rgba(255, 255, 255, 0.82);
    }

    .dnd-hero__cta {
      justify-content: center;
      margin-top: 24px;
    }
  }

  @media (max-width: 767px) {
    .dnd-hero {
      min-height: max(560px, 88svh);
      height: auto;
    }

    .dnd-hero__content {
      min-height: max(560px, 88svh);
    }

    .dnd-hero__inner {
      align-items: flex-start;
      justify-content: flex-end;
      max-width: none;
      min-height: max(560px, 88svh);
      padding: 0 16px 34px;
    }

    .dnd-hero__text {
      width: 100%;
      max-width: 332px;
    }

    .dnd-hero__kicker {
      margin-bottom: 12px;
      font-size: var(--dnd-text-2xs);
      letter-spacing: 0.16em;
    }

    .dnd-hero__title {
      display: grid;
      gap: 12px;
      max-width: 22ch;
      font-size: clamp(1.38rem, 6.8vw, 1.72rem);
      line-height: 1.04;
      letter-spacing: 0;
      text-wrap: initial;
    }

    .dnd-hero__title-block {
      display: grid;
      gap: 5px;
    }

    .dnd-hero__title-block--top {
      display: block;
      font-size: 1.45rem;
      line-height: 1.06;
      text-transform: uppercase;
      letter-spacing: 0.02em;
      white-space: nowrap;
    }

    .dnd-hero__title-block--bottom {
      display: block;
      margin-top: 4px;
      font-size: 1.45rem;
      line-height: 1.04;
      text-transform: uppercase;
      letter-spacing: 0.025em;
      white-space: nowrap;
    }

    .dnd-hero__title-line {
      display: inline;
      white-space: nowrap;
    }

    .dnd-hero__title-block--bottom .dnd-hero__title-line {
      display: inline;
    }

    .dnd-hero__divider {
      display: grid;
      grid-template-columns: minmax(28px, 1fr) 10px minmax(28px, 1fr);
      align-items: center;
      gap: 9px;
      width: 132px;
      margin: 8px 0;
      color: rgba(255, 250, 241, 0.58);
    }

    .dnd-hero__divider-line {
      height: 1px;
      background: currentColor;
    }

    .dnd-hero__divider-circle {
      width: 10px;
      height: 10px;
      border: 1px solid currentColor;
      border-radius: 50%;
    }

    .dnd-hero__desc {
      margin-top: 22px;
