---
const brevoFormUrl =
  "https://d45cbe7c.sibforms.com/v2/serve/MUIFACKpKPrp0nwNuackNku75WN9hdMxMVAUPvYNULPddmR-aQ4pe1wxLyqg6u4d21Jo-blvV37HVRZKbvxuYftYLIkN6S7ajl9qCjOx18tAN6JKJwNJ_IFZ8T734t6kjJYrFHDFd5IInkVVxIBf41DiExIF0RJi2TBTLktGdUqc9bo-P7h-0a1ue324AI-1mna3XHb3kWqPfmpycQ==";
// [CHANGE 2026-08-11 22:05] Hungarian newsletter popup copy changed from formal to informal address.
---

<div class="dnd-newsletter-popup" data-dnd-newsletter-popup>
  <aside class="dnd-newsletter-popup__card" data-dnd-newsletter-card hidden aria-labelledby="dnd-newsletter-popup-title">
    <button class="dnd-newsletter-popup__dismiss" type="button" data-dnd-newsletter-dismiss aria-label="Hírlevélkártya bezárása">×</button>
    <span class="dnd-newsletter-popup__kicker">Dandelion hírlevél</span>
    <h2 id="dnd-newsletter-popup-title">Maradjon képben a balatoni élményekkel</h2>
    <p>Inspirációk, különleges ajánlatok és balatoni élmények közvetlenül az e-mail-fiókodba.</p>
    <button class="dnd-newsletter-popup__trigger" type="button" data-dnd-newsletter-open>Feliratkozom</button>
  </aside>

  <dialog class="dnd-newsletter-popup__dialog" data-dnd-newsletter-dialog aria-labelledby="dnd-newsletter-dialog-title">
    <div class="dnd-newsletter-popup__surface">
      <div class="dnd-newsletter-popup__dialog-head">
        <div>
          <span class="dnd-newsletter-popup__kicker">Dandelion hírlevél</span>
          <h2 id="dnd-newsletter-dialog-title">Iratkozz fel a Dandelion hírlevelére</h2>
        </div>
        <button class="dnd-newsletter-popup__close" type="button" data-dnd-newsletter-close aria-label="Feliratkozási ablak bezárása">×</button>
      </div>
      <iframe
        title="Dandelion hírlevél feliratkozás"
        data-src={brevoFormUrl}
        loading="lazy"
        referrerpolicy="strict-origin-when-cross-origin"
        scrolling="auto"
      ></iframe>
    </div>
  </dialog>
</div>

<script is:inline>
  (() => {
    const root = document.querySelector("[data-dnd-newsletter-popup]");

    if (!root) {
      return;
    }

    const card = root.querySelector("[data-dnd-newsletter-card]");
    const dialog = root.querySelector("[data-dnd-newsletter-dialog]");
    const openButton = root.querySelector("[data-dnd-newsletter-open]");
    const closeButton = root.querySelector("[data-dnd-newsletter-close]");
    const dismissButton = root.querySelector("[data-dnd-newsletter-dismiss]");
    const formFrame = root.querySelector("iframe[data-src]");
    const storageKey = "dnd-newsletter-popup-dismissed-at";
    const suppressionWindow = 30 * 24 * 60 * 60 * 1000;
    const dwellTime = 60 * 1000;
    let hasShownCard = false;
    let scrollFrame = 0;

    const canShow = () => {
      try {
        const dismissedAt = Number(window.localStorage.getItem(storageKey) || 0);
        return !dismissedAt || Date.now() - dismissedAt > suppressionWindow;
      } catch {
        return true;
      }
    };

    const pushEvent = (eventName) => {
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({ event: eventName });
    };

    const suppress = () => {
      try {
        window.localStorage.setItem(storageKey, String(Date.now()));
      } catch {
        // Local storage may be unavailable in restrictive browser contexts.
      }
    };

    const showCard = () => {
      if (hasShownCard || !card || !canShow()) {
        return;
      }

      hasShownCard = true;
      card.hidden = false;
      pushEvent("dnd_newsletter_popup_impression");
    };

    const handleScroll = () => {
      scrollFrame = 0;
      const pageHeight = document.documentElement.scrollHeight - window.innerHeight;

      if (pageHeight > 0 && window.scrollY / pageHeight >= 0.6) {
        showCard();
        window.removeEventListener("scroll", queueScrollCheck);
      }
    };

    const queueScrollCheck = () => {
      if (!scrollFrame) {
        scrollFrame = window.requestAnimationFrame(handleScroll);
      }
    };

    const hideCard = () => {
      if (card) {
        card.hidden = true;
      }
      suppress();
    };

    const closeDialog = () => {
      if (dialog?.open) {
        dialog.close();
      }
      suppress();
      pushEvent("dnd_newsletter_popup_close");
    };

    window.setTimeout(showCard, dwellTime);
    window.addEventListener("scroll", queueScrollCheck, { passive: true });
    openButton?.addEventListener("click", () => {
      if (!dialog) {
        return;
      }

      card.hidden = true;
      pushEvent("dnd_newsletter_popup_open");

      if (formFrame instanceof HTMLIFrameElement && !formFrame.getAttribute("src")) {
        const source = formFrame.dataset.src;
        if (source) formFrame.src = source;
      }

      if (typeof dialog.showModal === "function") {
        dialog.showModal();
      } else {
        dialog.setAttribute("open", "");
      }
    });
    closeButton?.addEventListener("click", closeDialog);
    dismissButton?.addEventListener("click", () => {
      hideCard();
      pushEvent("dnd_newsletter_popup_dismiss");
    });
    dialog?.addEventListener("cancel", (event) => {
      event.preventDefault();
      closeDialog();
    });
  })();
</script>

<style>
  .dnd-newsletter-popup {
    position: relative;
    z-index: 70;
    pointer-events: none;
  }

  .dnd-newsletter-popup__card {
    position: fixed;
    right: 20px;
    bottom: 20px;
    display: grid;
    width: min(360px, calc(100vw - 40px));
    gap: 9px;
    padding: 20px 22px 22px;
    border: 1px solid rgba(91, 70, 42, 0.14);
    border-radius: 8px;
    background: #fdfbf7;
    color: #2d241c;
    box-shadow: 0 14px 34px rgba(49, 36, 22, 0.16);
    pointer-events: auto;
    animation: dnd-newsletter-popup-in 0.28s ease-out both;
  }

  .dnd-newsletter-popup__card[hidden] {
    display: none;
  }

  html[data-dnd-menu-open="true"] .dnd-newsletter-popup__card {
    display: none;
  }

  .dnd-newsletter-popup__kicker {
    color: #9c7124;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.14em;
    line-height: 1.35;
    text-transform: uppercase;
  }

  .dnd-newsletter-popup h2 {
    margin: 0;
    color: #2d241c;
    font-family: var(--dnd-font-display);
    font-size: 1.45rem;
    font-weight: 400;
    line-height: 1.1;
  }

  .dnd-newsletter-popup__card p {
    margin: 0;
    color: rgba(45, 36, 28, 0.72);
    font-size: 0.94rem;
    line-height: 1.5;
  }

  .dnd-newsletter-popup__trigger {
    min-height: 44px;
    margin-top: 4px;
    padding: 0 18px;
    border: 1px solid #b17d1f;
    border-radius: 5px;
    background: #b17d1f;
    color: #fffaf0;
    cursor: pointer;
    font: inherit;
    font-size: 0.94rem;
    font-weight: 600;
  }

  .dnd-newsletter-popup__trigger:hover,
  .dnd-newsletter-popup__trigger:focus-visible {
    background: #986d20;
  }

  .dnd-newsletter-popup__dismiss,
  .dnd-newsletter-popup__close {
    display: grid;
    width: 32px;
    height: 32px;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(45, 36, 28, 0.16);
    border-radius: 50%;
    background: transparent;
    color: #5c4b3c;
    cursor: pointer;
    font: inherit;
    font-size: 1.35rem;
    line-height: 1;
  }

  .dnd-newsletter-popup__dismiss {
    position: absolute;
    top: 10px;
    right: 10px;
  }

  .dnd-newsletter-popup__dismiss:hover,
  .dnd-newsletter-popup__dismiss:focus-visible,
  .dnd-newsletter-popup__close:hover,
  .dnd-newsletter-popup__close:focus-visible {
    border-color: rgba(177, 125, 31, 0.62);
    color: #986d20;
  }

  .dnd-newsletter-popup__dialog {
    width: min(600px, calc(100% - 32px));
    max-height: min(92vh, 600px);
    margin: auto;
    padding: 0;
    border: 0;
    border-radius: 8px;
    background: #fdfbf7;
    color: #2d241c;
    box-shadow: 0 20px 60px rgba(32, 24, 17, 0.24);
    pointer-events: auto;
  }

  .dnd-newsletter-popup__dialog::backdrop {
    background: rgba(32, 24, 17, 0.48);
  }

  .dnd-newsletter-popup__surface {
    overflow: auto;
    padding: 24px 26px 26px;
  }

  .dnd-newsletter-popup__dialog-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 18px;
    margin-bottom: 8px;
  }

  .dnd-newsletter-popup__dialog h2 {
    margin-top: 5px;
    font-size: 1.65rem;
  }

  .dnd-newsletter-popup__dialog iframe {
    display: block;
    width: 100%;
    height: 420px;
    max-width: 100%;
    margin: 0;
    border: 0;
  }

  @keyframes dnd-newsletter-popup-in {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 640px) {
    .dnd-newsletter-popup__card {
      position: relative;
      right: auto;
      bottom: auto;
      width: min(calc(100% - 24px), 360px);
      margin: 20px auto 0;
      padding: 16px 16px 17px;
    }

    .dnd-newsletter-popup h2 {
      font-size: 1.25rem;
    }

    .dnd-newsletter-popup__card p {
      font-size: 0.86rem;
      line-height: 1.42;
    }

    .dnd-newsletter-popup__trigger {
      min-height: 40px;
      padding-right: 14px;
      padding-left: 14px;
      font-size: 0.88rem;
    }

    .dnd-newsletter-popup__dialog {
      width: 100%;
      max-height: 92vh;
      margin: auto 0 0;
      border-radius: 8px 8px 0 0;
    }

    .dnd-newsletter-popup__surface {
      padding: 20px 16px 22px;
    }

    .dnd-newsletter-popup__dialog h2 {
      font-size: 1.45rem;
    }

    .dnd-newsletter-popup__dialog iframe {
      height: 560px;
    }
  }
</style>
