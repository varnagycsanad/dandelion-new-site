---
interface Props {
  lang?: "hu" | "en" | "de" | "cs" | "sk";
}

const { lang = "hu" } = Astro.props as Props;
const copyByLang = {
  hu: {
    kicker: "Balaton-felvidék",
    title: "Merre találod a házakat?",
    text:
      "A Dandelion házak a Tapolcai-medence, a Káli-medence és a Balaton nyugati oldala között helyezkednek el. Egy térképen gyorsan látod, melyik környék áll hozzád közelebb.",
    iframeTitle: "Dandelion Balaton-felvidék térkép"
  },
  en: {
    kicker: "Balaton Uplands",
    title: "Where are the houses?",
    text:
      "The Dandelion houses sit between the Tapolca Basin, the Káli Basin and the western side of Lake Balaton. The map makes it easier to compare the areas at a glance.",
    iframeTitle: "Dandelion Balaton Uplands map"
  },
  de: {
    kicker: "Balaton-Oberland",
    title: "Wo liegen die Häuser?",
    text:
      "Die Dandelion Häuser liegen zwischen Tapolca-Becken, Káli-Becken und der westlichen Seite des Balaton. Auf der Karte lassen sich die Regionen schnell vergleichen.",
    iframeTitle: "Dandelion Karte Balaton-Oberland"
  },
  cs: {
    kicker: "Balatonská vrchovina",
    title: "Kde najdete naše domy?",
    text:
      "Domy Dandelion leží mezi Tapolcai pánví, oblastí Káli a západní stranou Balatonu. Na mapě rychle porovnáte, která oblast je pro vás nejvhodnější.",
    iframeTitle: "Mapa Dandelion v Balatonské vrchovině"
  },
  sk: {
    kicker: "Balatonská vrchovina",
    title: "Kde nájdete naše domy?",
    text:
      "Domy Dandelion ležia medzi Tapolcai-medence, oblasťou Káli a západnou stranou Balatonu. Na mape rýchlo porovnáte, ktorá oblasť vám sedí najviac.",
    iframeTitle: "Mapa Dandelion v Balatonskej vrchovine"
  }
} as const;
const copy = copyByLang[lang];
const mapSrc = "https://www.google.com/maps/d/u/0/embed?mid=1dgmhlWMXHWYPWCpzLV89dI5KAxhqc-I&ehbc=2E312F";
---

<section class="dnd-section dnd-google-region-map">
  <div class="dnd-google-region-map__inner">
    <div class="dnd-google-region-map__content">
      <span class="dnd-google-region-map__kicker">{copy.kicker}</span>
      <h2>{copy.title}</h2>
      <p>{copy.text}</p>
    </div>

    <div class="dnd-google-region-map__card">
      <div class="dnd-google-region-map__frame">
        <iframe
          class="dnd-google-region-map__canvas"
          src={mapSrc}
          title={copy.iframeTitle}
          loading="eager"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
    </div>
  </div>
</section>

<style>
  .dnd-google-region-map {
    padding: 110px 0;
    background: #f7f2e7;
  }

  .dnd-google-region-map__inner {
    display: grid;
    grid-template-columns: minmax(0, 2.4fr) minmax(280px, 0.8fr);
    grid-template-areas: "map text";
    gap: clamp(28px, 4vw, 56px);
    width: min(100% - 96px, 1320px);
    margin: 0 auto;
    align-items: center;
  }

  .dnd-google-region-map__content {
    grid-area: text;
    max-width: 330px;
  }

  .dnd-google-region-map__card {
    grid-area: map;
    position: relative;
    height: 440px;
    min-height: 440px;
    overflow: hidden;
    border: 1px solid rgba(91, 70, 42, 0.12);
    border-radius: 24px;
    background: #fbfaf5;
    box-shadow: 0 24px 56px rgba(80, 57, 31, 0.1);
  }

  .dnd-google-region-map__kicker {
    display: inline-block;
    margin-bottom: 18px;
    color: rgba(121, 93, 48, 0.82);
    font-size: var(--dnd-text-xs);
    font-weight: 600;
    letter-spacing: var(--dnd-tracking-wide);
    text-transform: uppercase;
  }

  .dnd-google-region-map h2 {
    margin: 0;
    color: rgba(39, 32, 24, 0.92);
    font-family: var(--dnd-font-display);
    font-size: clamp(1.6rem, 2vw, 2.35rem);
    font-weight: 400;
    line-height: 1.08;
  }

  .dnd-google-region-map p {
    margin: 18px 0 0;
    max-width: 32ch;
    color: rgba(39, 32, 24, 0.68);
    font-size: var(--dnd-text-md);
    line-height: 1.62;
  }

  .dnd-google-region-map__frame {
    position: absolute;
    inset: 0;
  }

  .dnd-google-region-map__canvas {
    position: absolute;
    top: -64px;
    left: 0;
    display: block;
    width: 100%;
    height: calc(100% + 64px);
    border: 0;
    pointer-events: auto;
  }

  @media (max-width: 860px) {
    .dnd-google-region-map {
      padding: 72px 0;
    }

    .dnd-google-region-map__inner {
      grid-template-columns: 1fr;
      grid-template-areas:
        "text"
        "map";
      width: min(100% - 24px, 620px);
      gap: 30px;
    }

    .dnd-google-region-map__content {
      max-width: none;
      text-align: center;
    }

    .dnd-google-region-map p {
      margin-right: auto;
      margin-left: auto;
      max-width: 36ch;
      line-height: 1.5;
    }

    .dnd-google-region-map h2 {
      font-size: 1.5rem;
      line-height: 1.08;
    }

    .dnd-google-region-map__card {
      height: 380px;
      min-height: 380px;
      border-radius: 18px;
    }
  }
</style>
