---
import { autumn2026OfferMap } from "../data/offers/autumn-2026";
import type { AutumnCampaignOffer, AutumnCampaignOfferId } from "../data/offers/types";
import pairCampaignImage from "../assets/home/experiences/dandelion-home-experience-wine-gastro-01-optimized.webp";
import familyCampaignImage from "../assets/accommodations/d2/gallery/dandelion-d2-source-005.webp";

const featuredOfferIds: AutumnCampaignOfferId[] = [
  "fugehaz_oszi_kettesben_2026",
  "d2_oszi_csaladi_pihenes_2026"
];

const offers = featuredOfferIds.map((offerId) => autumn2026OfferMap[offerId]).filter(Boolean);

if (offers.length !== 2) {
  throw new Error("Autumn campaign homepage block requires exactly two offers.");
}

function pickCardImage(offer: AutumnCampaignOffer) {
  return offer.media.card ?? offer.media.heroDesktop ?? offer.media.galleryPreview[0] ?? null;
}

function pickMobileImage(offer: AutumnCampaignOffer) {
  return offer.media.heroMobile ?? pickCardImage(offer);
}

function pickCampaignVisual(offer: AutumnCampaignOffer) {
  if (offer.audience === "pair") {
    return {
      src: pairCampaignImage.src,
      width: pairCampaignImage.width,
      height: pairCampaignImage.height,
      alt: "Poharakat koccinto par borral a Balaton-felvidek panoramaja elott."
    };
  }

  return {
    src: familyCampaignImage.src,
    width: familyCampaignImage.width,
    height: familyCampaignImage.height,
    alt: "Csaladi hangulatu oszi piknik a D2 kertjeben, hatterben a hegyekkel."
  };
}

function pickCardHighlights(offer: AutumnCampaignOffer) {
  if (offer.audience === "pair") {
    return [offer.services.items[0], offer.services.items[1], offer.services.items[2]].filter(Boolean);
  }

  return [offer.services.items[0], offer.services.items[offer.services.items.length - 1], offer.services.items[1]].filter(
    Boolean
  );
}

function getAudienceTheme(offer: AutumnCampaignOffer) {
  return offer.audience === "pair" ? "is-pair" : "is-family";
}
---

<section class="autumn-home-campaigns dnd-section" aria-labelledby="autumn-home-campaigns-title">
  <div class="dnd-container">
    <div class="autumn-home-campaigns__intro">
      <span class="autumn-home-campaigns__kicker">2026-os őszi ajánlatok</span>
      <h2 id="autumn-home-campaigns-title" class="autumn-home-campaigns__title">
        Két külön kampány-belépési pont pároknak és családoknak
      </h2>
      <p class="autumn-home-campaigns__lead">
        A főoldali blokk a jóváhagyott őszi offer data rekordokból épül, és közvetlenül a két dedikált landing
        oldalra vezet tovább.
      </p>
    </div>

    <div class="autumn-home-campaigns__grid">
      {offers.map((offer) => {
        const cardImage = pickCardImage(offer);
        const mobileImage = pickMobileImage(offer);
        const visualImage = pickCampaignVisual(offer);
        const highlights = pickCardHighlights(offer);
        const imageAlt = visualImage.alt || cardImage?.alt.hu || mobileImage?.alt.hu || offer.hero.title;

        return (
          <article class:list={["autumn-home-campaigns__card", getAudienceTheme(offer)]}>
            <div class="autumn-home-campaigns__media-shell">
              <div class="autumn-home-campaigns__media-badge">
                <span>{offer.audience === "pair" ? "Pároknak" : "Családoknak"}</span>
              </div>
              {visualImage ? (
                <picture class="autumn-home-campaigns__media">
                  {mobileImage?.src && <source media="(max-width: 767px)" srcset={visualImage.src} />}
                  <img
                    src={visualImage.src}
                    alt={imageAlt}
                    width={visualImage.width}
                    height={visualImage.height}
                    loading="lazy"
                    decoding="async"
                  />
                </picture>
              ) : (
                <div class="autumn-home-campaigns__media autumn-home-campaigns__media--empty" aria-hidden="true" />
              )}
            </div>

            <div class="autumn-home-campaigns__content">
              <div class="autumn-home-campaigns__content-accent" aria-hidden="true"></div>
              <div class="autumn-home-campaigns__copy">
                {offer.homepageCard.eyebrow && <p class="autumn-home-campaigns__eyebrow">{offer.homepageCard.eyebrow}</p>}
                <h3 class="autumn-home-campaigns__card-title">{offer.homepageCard.title}</h3>
                <p class="autumn-home-campaigns__text">{offer.homepageCard.text}</p>
              </div>

              <ul class="autumn-home-campaigns__highlights" aria-label={`${offer.homepageCard.title} kiemelt előnyök`}>
                {highlights.map((highlight) => (
                  <li><span>{highlight}</span></li>
                ))}
              </ul>

              <div class="autumn-home-campaigns__footer">
                <a
                  href={offer.routePath}
                  class="autumn-home-campaigns__cta"
                  data-dnd-offer={offer.tracking.offerId}
                  data-dnd-property={offer.tracking.property}
                  data-dnd-campaign={offer.tracking.campaign}
                  data-dnd-placement="homepage-campaign-card"
                  data-dnd-cta-type="learn-more"
                >
                  {offer.homepageCard.ctaLabel}
                </a>
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>

<style>
  .autumn-home-campaigns {
    padding: 28px 0 22px;
  }

  .autumn-home-campaigns__intro {
    max-width: 760px;
    margin: 0 auto 26px;
    text-align: center;
  }

  .autumn-home-campaigns__kicker {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: #9c7a34;
    font-family: var(--dnd-font-display);
    font-size: var(--dnd-text-sm);
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .autumn-home-campaigns__kicker::before,
  .autumn-home-campaigns__kicker::after {
    content: "";
    width: 42px;
    height: 1px;
    background: rgba(156, 122, 52, 0.32);
  }

  .autumn-home-campaigns__title {
    margin: 14px 0 0;
    font-family: var(--dnd-font-display);
    font-size: clamp(1.9rem, 3.2vw, 2.85rem);
    line-height: 1.08;
    font-weight: 500;
  }

  .autumn-home-campaigns__lead {
    margin: 10px auto 0;
    max-width: 620px;
    color: rgba(0, 0, 0, 0.7);
    font-size: var(--dnd-text-md);
    line-height: 1.55;
  }

  .autumn-home-campaigns__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 26px;
  }

  .autumn-home-campaigns__card {
    position: relative;
    min-width: 0;
    padding-bottom: 18px;
  }

  .autumn-home-campaigns__card.is-pair {
    --campaign-accent: #9c7a34;
    --campaign-accent-soft: rgba(156, 122, 52, 0.16);
    --campaign-surface: rgba(255, 248, 238, 0.96);
    --campaign-shadow: rgba(93, 63, 26, 0.18);
  }

  .autumn-home-campaigns__card.is-family {
    --campaign-accent: #315f4b;
    --campaign-accent-soft: rgba(49, 95, 75, 0.14);
    --campaign-surface: rgba(246, 250, 247, 0.97);
    --campaign-shadow: rgba(34, 60, 49, 0.18);
  }

  .autumn-home-campaigns__media-shell {
    position: relative;
    min-width: 0;
    padding: 0 14px 0 0;
  }

  .autumn-home-campaigns__media-shell::after {
    content: "";
    position: absolute;
    inset: 14px 0 0 28%;
    border-radius: 30px;
    background: linear-gradient(135deg, var(--campaign-accent-soft), rgba(255, 255, 255, 0));
    z-index: 0;
  }

  .autumn-home-campaigns__media-badge {
    position: absolute;
    top: 20px;
    left: 20px;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    min-height: 34px;
    padding: 0 14px;
    border-radius: 999px;
    background: rgba(17, 22, 18, 0.64);
    color: #fff;
    backdrop-filter: blur(8px);
    font-size: var(--dnd-text-2xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .autumn-home-campaigns__media {
    display: block;
    position: relative;
    z-index: 1;
    aspect-ratio: 1.02;
    overflow: hidden;
    border-radius: 28px;
    box-shadow: 0 28px 48px rgba(39, 27, 16, 0.18);
  }

  .autumn-home-campaigns__media img,
  .autumn-home-campaigns__media--empty {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .autumn-home-campaigns__media::after {
    content: "";
    position: absolute;
    inset: auto 0 0;
    height: 42%;
    background: linear-gradient(180deg, rgba(15, 15, 15, 0), rgba(15, 15, 15, 0.28));
    pointer-events: none;
  }

  .autumn-home-campaigns__content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 16px;
    min-width: 0;
    width: min(86%, 460px);
    margin: -70px 0 0 auto;
    padding: 22px 22px 22px;
    border: 1px solid rgba(91, 70, 42, 0.1);
    border-radius: 24px;
    background: var(--campaign-surface);
    backdrop-filter: blur(12px);
    box-shadow: 0 24px 40px var(--campaign-shadow);
  }

  .autumn-home-campaigns__content-accent {
    position: absolute;
    inset: 0 auto 0 0;
    width: 5px;
    border-radius: 24px 0 0 24px;
    background: linear-gradient(180deg, var(--campaign-accent), rgba(255, 255, 255, 0));
  }

  .autumn-home-campaigns__copy {
    display: grid;
    gap: 10px;
  }

  .autumn-home-campaigns__eyebrow {
    margin: 0;
    color: var(--campaign-accent);
    font-size: var(--dnd-text-sm);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .autumn-home-campaigns__card-title {
    margin: 0;
    font-family: var(--dnd-font-display);
    font-size: clamp(1.45rem, 2.1vw, 2rem);
    line-height: 1.12;
    font-weight: 500;
  }

  .autumn-home-campaigns__text {
    margin: 0;
    color: rgba(0, 0, 0, 0.74);
    font-size: var(--dnd-text-md);
    line-height: 1.58;
  }

  .autumn-home-campaigns__highlights {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .autumn-home-campaigns__highlights li {
    min-width: 0;
  }

  .autumn-home-campaigns__highlights li span {
    display: inline-flex;
    align-items: center;
    min-height: 34px;
    padding: 8px 12px;
    border-radius: 999px;
    background: var(--campaign-accent-soft);
    color: rgba(0, 0, 0, 0.78);
    font-size: var(--dnd-text-xs);
    font-weight: 600;
    line-height: 1.3;
  }

  .autumn-home-campaigns__footer {
    margin-top: auto;
    padding-top: 6px;
  }

  .autumn-home-campaigns__cta {
    display: inline-flex;
    align-items: center;
    justify-content: flex-start;
    min-height: 48px;
    padding: 0 18px;
    border-radius: 999px;
    border: 1px solid rgba(0, 0, 0, 0.08);
    background: rgba(255, 255, 255, 0.88);
    color: #111;
    font-size: var(--dnd-text-sm);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-decoration: none;
    transition:
      transform 0.2s ease,
      background-color 0.2s ease,
      box-shadow 0.2s ease,
      border-color 0.2s ease;
  }

  .autumn-home-campaigns__cta::after {
    content: "↗";
    margin-left: 10px;
    color: var(--campaign-accent);
    font-size: 1rem;
  }

  .autumn-home-campaigns__cta:hover {
    transform: translateY(-1px);
    border-color: var(--campaign-accent-soft);
    background: #fff;
    box-shadow: 0 14px 28px rgba(31, 31, 31, 0.1);
  }

  .autumn-home-campaigns__cta:focus-visible {
    outline: 3px solid rgba(217, 158, 43, 0.72);
    outline-offset: 3px;
  }

  @media (max-width: 960px) {
    .autumn-home-campaigns__grid {
      gap: 22px;
    }

    .autumn-home-campaigns__content {
      width: calc(100% - 34px);
      margin-top: -56px;
      padding: 20px 18px 20px;
    }
  }

  @media (max-width: 767px) {
    .autumn-home-campaigns {
      padding: 20px 0 14px;
    }

    .autumn-home-campaigns__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }

    .autumn-home-campaigns__intro {
      margin-bottom: 12px;
    }

    .autumn-home-campaigns__kicker {
      gap: 8px;
      font-size: var(--dnd-text-xs);
      letter-spacing: 0.14em;
    }

    .autumn-home-campaigns__kicker::before,
    .autumn-home-campaigns__kicker::after {
      width: 28px;
    }

    .autumn-home-campaigns__title {
      font-size: 1.58rem;
    }

    .autumn-home-campaigns__lead {
      font-size: var(--dnd-text-sm);
      line-height: 1.5;
    }

    .autumn-home-campaigns__card {
      padding-bottom: 8px;
    }

    .autumn-home-campaigns__media-shell {
      padding-right: 6px;
    }

    .autumn-home-campaigns__media-shell::after {
      inset: 10px 0 0 18%;
      border-radius: 22px;
    }

    .autumn-home-campaigns__media-badge {
      top: 12px;
      left: 12px;
      min-height: 28px;
      padding: 0 10px;
      font-size: 0.58rem;
      letter-spacing: 0.06em;
    }

    .autumn-home-campaigns__media {
      aspect-ratio: 0.9;
      border-radius: 20px;
    }

    .autumn-home-campaigns__content {
      width: calc(100% - 10px);
      margin-top: -22px;
      gap: 10px;
      padding: 14px 12px 12px;
      border-radius: 18px;
      box-shadow: 0 14px 26px rgba(31, 31, 31, 0.12);
    }

    .autumn-home-campaigns__card-title {
      font-size: 1.02rem;
      line-height: 1.15;
    }

    .autumn-home-campaigns__eyebrow {
      font-size: 0.62rem;
      letter-spacing: 0.08em;
    }

    .autumn-home-campaigns__text {
      font-size: 0.76rem;
      line-height: 1.45;
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    .autumn-home-campaigns__highlights {
      gap: 6px;
    }

    .autumn-home-campaigns__highlights li:nth-child(n + 3) {
      display: none;
    }

    .autumn-home-campaigns__highlights li span {
      min-height: 26px;
      padding: 5px 8px;
      font-size: 0.66rem;
    }

    .autumn-home-campaigns__cta {
      width: 100%;
      min-height: 38px;
      padding: 0 12px;
      justify-content: center;
      font-size: 0.72rem;
    }

    .autumn-home-campaigns__cta::after {
      margin-left: 6px;
      font-size: 0.8rem;
    }
  }

  @media (max-width: 420px) {
    .autumn-home-campaigns__grid {
      gap: 10px;
    }

    .autumn-home-campaigns__title {
      font-size: 1.46rem;
    }

    .autumn-home-campaigns__lead {
      font-size: 0.82rem;
    }

    .autumn-home-campaigns__media {
      aspect-ratio: 0.82;
    }

    .autumn-home-campaigns__content {
      padding: 12px 10px 10px;
      gap: 8px;
    }

    .autumn-home-campaigns__copy {
      gap: 8px;
    }

    .autumn-home-campaigns__card-title {
      font-size: 0.94rem;
    }

    .autumn-home-campaigns__text {
      font-size: 0.72rem;
      -webkit-line-clamp: 2;
    }

    .autumn-home-campaigns__highlights li span {
      min-height: 24px;
      padding: 4px 7px;
      font-size: 0.62rem;
    }
  }
</style>
