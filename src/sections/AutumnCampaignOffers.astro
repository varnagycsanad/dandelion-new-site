---
import { autumn2026OfferMap } from "../data/offers/autumn-2026";
import type { AutumnCampaignOffer, AutumnCampaignOfferId } from "../data/offers/types";
import pairCampaignImage from "../assets/home/experiences/dandelion-home-experience-wine-gastro-01-optimized.webp";
import familyCampaignImageDesktop from "../assets/campaign/autumn-2026/panorama-hero-poster.webp";
import familyCampaignImageMobile from "../assets/campaign/autumn-2026/panorama-hero-poster-mobile.webp";

interface Props {
  lang?: "hu" | "en" | "de" | "cs" | "sk";
}

const { lang = "hu" } = Astro.props as Props;

const featuredOfferIds: AutumnCampaignOfferId[] = [
  "fugehaz_oszi_kettesben_2026",
  "d2_oszi_csaladi_pihenes_2026"
];

const offers = featuredOfferIds.map((offerId) => autumn2026OfferMap[offerId]).filter(Boolean);

if (offers.length !== 2) {
  throw new Error("Autumn campaign homepage block requires exactly two offers.");
}

const copyByLang = {
  hu: {
    ariaLabel: "Őszi ajánlatok",
    kicker: "Őszi ajánlatok",
    title: "Őszi kikapcsolódás kettesben vagy családdal",
    pairLabel: "Páros pihenés",
    familyLabel: "Családi kalandok",
    pairHighlights: ["Tapolcai-tavasbarlang", "Balatoni panoráma a Csobáncról", "Közeli borászatok"],
    familyHighlights: ["Biciklitúrák a tanúhegyek mellett", "Őszi Balaton", "Családi kirándulások"],
    pairAlt: "Borospoharak a Balaton-felvidéki szőlősorok és tanúhegyek előtt.",
    familyAlt: "Balaton-felvidéki őszi panoráma szőlősorokkal és tanúhegyekkel.",
    cta: "Bővebben"
  },
  en: {
    ariaLabel: "Autumn offers",
    kicker: "Autumn offers",
    title: "An autumn escape for two or the whole family",
    pairLabel: "A getaway for two",
    familyLabel: "Family adventures",
    pairHighlights: ["Tapolca Lake Cave", "Lake Balaton panorama from Csobánc", "Nearby wineries"],
    familyHighlights: ["Bike rides by the witness hills", "Autumn days at Lake Balaton", "Family excursions"],
    pairAlt: "Wine glasses in front of vineyard rows and witness hills in the Balaton Uplands.",
    familyAlt: "Autumn panorama in the Balaton Uplands with vineyards and witness hills.",
    cta: "Learn more"
  },
  de: {
    ariaLabel: "Herbstangebote",
    kicker: "Herbstangebote",
    title: "Herbstzeit zu zweit oder mit der Familie",
    pairLabel: "Auszeit zu zweit",
    familyLabel: "Familienabenteuer",
    pairHighlights: ["Höhlensee von Tapolca", "Balaton-Panorama vom Csobánc", "Nahegelegene Weingüter"],
    familyHighlights: ["Radtouren bei den Zeugenbergen", "Herbsttage am Balaton", "Ausflüge für die ganze Familie"],
    pairAlt: "Weingläser vor Weinreihen und Zeugenbergen im Balaton-Oberland.",
    familyAlt: "Herbstpanorama im Balaton-Oberland mit Weinreihen und Zeugenbergen.",
    cta: "Mehr erfahren"
  },
  cs: {
    ariaLabel: "Podzimní nabídky",
    kicker: "Podzimní nabídky",
    title: "Podzimní odpočinek ve dvou nebo s rodinou",
    pairLabel: "Pobyt ve dvou",
    familyLabel: "Rodinná dobrodružství",
    pairHighlights: ["Jeskyně u Tapolce", "Panorama Balatonu z Csobánce", "Blízká vinařství"],
    familyHighlights: ["Cyklovýlety u svědeckých hor", "Podzimní dny u Balatonu", "Rodinné výlety"],
    pairAlt: "Sklenky vína před vinicemi a svědeckými horami v Balatonské vrchovině.",
    familyAlt: "Podzimní panorama Balatonské vrchoviny s vinicemi a svědeckými horami.",
    cta: "Více informací"
  },
  sk: {
    ariaLabel: "Jesenné ponuky",
    kicker: "Jesenné ponuky",
    title: "Jesenný oddych vo dvojici alebo s rodinou",
    pairLabel: "Pobyt vo dvojici",
    familyLabel: "Rodinné dobrodružstvá",
    pairHighlights: ["Jaskyňa pri Tapolci", "Panoráma Balatonu z Csobánca", "Blízke vinárstva"],
    familyHighlights: ["Cyklovýlety pri svedeckých vrchoch", "Jesenné dni pri Balatone", "Rodinné výlety"],
    pairAlt: "Poháre vína pred vinicami a svedeckými vrchmi v Balatonskej vrchovine.",
    familyAlt: "Jesenná panoráma Balatonskej vrchoviny s vinicami a svedeckými vrchmi.",
    cta: "Zistiť viac"
  }
} as const;

const copy = copyByLang[lang];

function getOfferLabel(offer: AutumnCampaignOffer) {
  return offer.audience === "pair" ? copy.pairLabel : copy.familyLabel;
}

function getHomepageCardTitle(offer: AutumnCampaignOffer) {
  return getOfferLabel(offer);
}

function getCardHighlights(offer: AutumnCampaignOffer) {
  return offer.audience === "pair" ? copy.pairHighlights : copy.familyHighlights;
}

function getCampaignImage(offer: AutumnCampaignOffer) {
  if (offer.audience === "pair") {
      return {
        desktop: pairCampaignImage,
        mobile: pairCampaignImage,
        alt: copy.pairAlt
      };
  }

  return {
    desktop: familyCampaignImageDesktop,
    mobile: familyCampaignImageMobile,
    alt: copy.familyAlt
  };
}
---

<section class="autumn-home-campaigns" aria-label={copy.ariaLabel}>
  <div class="dnd-container">
    <div class="autumn-home-campaigns__desktop">
      <div class="autumn-home-campaigns__intro">
        <span class="autumn-home-campaigns__kicker">{copy.kicker}</span>
        <h2 class="autumn-home-campaigns__title">{copy.title}</h2>
      </div>

      <div class="autumn-home-campaigns__cards">
        {offers.map((offer) => {
          const image = getCampaignImage(offer);
          const highlights = getCardHighlights(offer);

          return (
            <article class="autumn-home-campaigns__card">
              <div class="autumn-home-campaigns__media-shell">
                <span class="autumn-home-campaigns__media-badge">
                  {getOfferLabel(offer)}
                </span>
                <picture class="autumn-home-campaigns__media">
                  <source media="(max-width: 767px)" srcset={image.mobile.src} />
                  <img
                    src={image.desktop.src}
                    alt={image.alt}
                    width={image.desktop.width}
                    height={image.desktop.height}
                    loading="lazy"
                    decoding="async"
                  />
                </picture>
              </div>

              <div class="autumn-home-campaigns__content">
                <h3>{getHomepageCardTitle(offer)}</h3>
                <ul>
                  {highlights.map((highlight) => <li>{highlight}</li>)}
                </ul>
                <a
                  href={offer.routePath}
                  class="autumn-home-campaigns__card-cta"
                  data-dnd-offer={offer.tracking.offerId}
                  data-dnd-property={offer.tracking.property}
                  data-dnd-campaign={offer.tracking.campaign}
                  data-dnd-placement="homepage-campaign-card"
                  data-dnd-cta-type="learn-more"
                >{copy.cta}</a>
              </div>
            </article>
          );
        })}
      </div>
    </div>

    <div class="autumn-home-campaigns__mobile">
      <div class="autumn-home-campaigns__mobile-grid">
        {offers.map((offer) => (
          <a
            href={offer.routePath}
            class="autumn-home-campaigns__mobile-cta"
            data-dnd-offer={offer.tracking.offerId}
            data-dnd-property={offer.tracking.property}
            data-dnd-campaign={offer.tracking.campaign}
            data-dnd-placement="homepage-campaign-card"
            data-dnd-cta-type="learn-more"
          >
            <span>{getOfferLabel(offer)}</span>
            <i aria-hidden="true"></i>
          </a>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .autumn-home-campaigns {
    position: relative;
    z-index: 3;
    padding: 34px 0 42px;
    background: #fbf6ee;
  }

  .autumn-home-campaigns__mobile {
    display: none;
  }

  .autumn-home-campaigns__intro {
    max-width: 980px;
    margin: 0 auto 28px;
    text-align: center;
  }

  .autumn-home-campaigns__kicker {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    color: #b48737;
    font-family: var(--dnd-font-display);
    font-size: clamp(0.85rem, 1.4vw, 1.08rem);
    font-weight: 400;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .autumn-home-campaigns__kicker::before,
  .autumn-home-campaigns__kicker::after {
    content: "";
    width: 46px;
    height: 1px;
    background: rgba(180, 135, 55, 0.72);
  }

  .autumn-home-campaigns__title {
    margin: 16px 0 0;
    color: #11100e;
    font-family: var(--dnd-font-display);
    font-size: clamp(2.2rem, 4.5vw, 4.15rem);
    line-height: 1.04;
    font-weight: 400;
    letter-spacing: -0.025em;
  }

  .autumn-home-campaigns__cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(20px, 2.2vw, 34px);
  }

  .autumn-home-campaigns__card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    overflow: hidden;
    border: 1px solid rgba(98, 71, 34, 0.1);
    border-radius: 28px;
    background: #fffdf9;
    box-shadow: 0 18px 34px rgba(90, 58, 22, 0.16);
  }

  .autumn-home-campaigns__media-shell {
    position: relative;
  }

  .autumn-home-campaigns__media-badge {
    position: absolute;
    top: 22px;
    left: 24px;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    min-height: 42px;
    padding: 0 18px;
    border-radius: 999px;
    background: #222b35;
    color: #fff;
    font-size: clamp(0.78rem, 1vw, 1rem);
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .autumn-home-campaigns__media {
    display: block;
    aspect-ratio: 1.58;
    overflow: hidden;
  }

  .autumn-home-campaigns__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .autumn-home-campaigns__content {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 18px;
    padding: 24px 28px 26px;
  }

  .autumn-home-campaigns__content h3 {
    margin: 0;
    color: #11100e;
    font-family: var(--dnd-font-display);
    font-size: clamp(1.7rem, 2.7vw, 2.55rem);
    line-height: 1.08;
    font-weight: 400;
  }

  .autumn-home-campaigns__content ul {
    display: grid;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .autumn-home-campaigns__content li {
    color: #3a3a38;
    font-size: clamp(0.96rem, 1.25vw, 1.18rem);
    font-weight: 600;
    line-height: 1.35;
  }

  .autumn-home-campaigns__content li::before {
    content: "•";
    margin-right: 12px;
    color: #b48737;
    font-size: 1.4em;
    vertical-align: -0.08em;
  }

  .autumn-home-campaigns__card-cta {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 58px;
    margin-top: auto;
    border-radius: 999px;
    background: #b48737;
    color: #fff;
    font-size: clamp(1rem, 1.4vw, 1.22rem);
    font-weight: 800;
    text-decoration: none;
  }

  .autumn-home-campaigns__card-cta:hover,
  .autumn-home-campaigns__card-cta:focus-visible {
    background: #9c732e;
  }

  .autumn-home-campaigns__mobile-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
  }

  .autumn-home-campaigns__mobile-cta {
    display: flex;
    min-height: 86px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 13px;
    padding: 18px 8px 16px;
    border: 1px solid rgba(190, 141, 63, 0.5);
    border-radius: 12px;
    background: rgba(255, 253, 249, 0.97);
    box-shadow: 0 8px 18px rgba(76, 49, 20, 0.12);
    color: #26221d;
    text-align: center;
    text-decoration: none;
  }

  .autumn-home-campaigns__mobile-cta span {
    font-family: var(--dnd-font-display);
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 0.11em;
    line-height: 1.1;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .autumn-home-campaigns__mobile-cta i {
    display: block;
    width: 34px;
    height: 3px;
    background: #d99e2b;
  }

  .autumn-home-campaigns__card-cta:focus-visible,
  .autumn-home-campaigns__mobile-cta:focus-visible {
    outline: 3px solid rgba(217, 158, 43, 0.72);
    outline-offset: 4px;
  }

  @keyframes autumn-card-reveal {
    from {
      opacity: 0;
      transform: translateY(42px) scale(0.96);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @media (min-width: 768px) {
    .autumn-home-campaigns {
      padding: 26px 0 34px;
    }

    .autumn-home-campaigns > .dnd-container {
      width: min(100% - 32px, 1360px);
    }

    .autumn-home-campaigns__intro {
      max-width: 1100px;
      margin-bottom: 20px;
    }

    .autumn-home-campaigns__title {
      font-size: clamp(2rem, 3.1vw, 3.1rem);
      line-height: 1.06;
    }

    .autumn-home-campaigns__cards {
      gap: 24px;
    }

    .autumn-home-campaigns__card {
      border-radius: 22px;
    }

    .autumn-home-campaigns__media-badge {
      top: 18px;
      left: 18px;
      min-height: 36px;
      padding: 0 14px;
      font-size: 0.86rem;
      font-weight: 700;
    }

    .autumn-home-campaigns__media {
      aspect-ratio: 1.9 / 1;
    }

    .autumn-home-campaigns__content {
      gap: 12px;
      padding: 20px 22px 20px;
    }

    .autumn-home-campaigns__content h3 {
      font-size: clamp(1.45rem, 2vw, 2rem);
    }

    .autumn-home-campaigns__content li {
      font-size: 1rem;
      font-weight: 500;
    }

    .autumn-home-campaigns__card-cta {
      min-height: 48px;
      font-size: 1rem;
      font-weight: 600;
    }

    .autumn-home-campaigns__cards .autumn-home-campaigns__card {
      position: relative;
      display: block;
      height: clamp(340px, calc(30vw - 50px), 410px);
      min-height: 0;
      overflow: hidden;
      border-color: rgba(255, 255, 255, 0.32);
      box-shadow: 0 22px 44px rgba(50, 34, 18, 0.18);
      animation: none;
      transition: transform 260ms ease, box-shadow 260ms ease;
    }

    .autumn-home-campaigns--observe .autumn-home-campaigns__cards .autumn-home-campaigns__card {
      opacity: 0;
      transform: translateY(42px) scale(0.96);
    }

    .autumn-home-campaigns--observe.is-visible .autumn-home-campaigns__cards .autumn-home-campaigns__card {
      animation: autumn-card-reveal 1100ms cubic-bezier(0.22, 1, 0.36, 1) both;
    }

    .autumn-home-campaigns--observe.is-visible .autumn-home-campaigns__cards .autumn-home-campaigns__card:nth-child(2) {
      animation-delay: 240ms;
    }

    .autumn-home-campaigns__cards .autumn-home-campaigns__card:hover {
      transform: translateY(-5px);
      box-shadow: 0 28px 54px rgba(50, 34, 18, 0.24);
    }

    .autumn-home-campaigns__media-shell {
      position: absolute;
      inset: 0;
      z-index: 0;
    }

    .autumn-home-campaigns__media-shell::after {
      position: absolute;
      inset: 0;
      z-index: 1;
      content: "";
      background: linear-gradient(180deg, rgba(17, 16, 13, 0.02) 34%, rgba(17, 16, 13, 0.78) 100%);
      pointer-events: none;
    }

    .autumn-home-campaigns__media {
      height: 100%;
      aspect-ratio: auto;
    }

    .autumn-home-campaigns__media img {
      transition: transform 720ms cubic-bezier(0.22, 1, 0.36, 1);
    }

    .autumn-home-campaigns__cards .autumn-home-campaigns__card:hover .autumn-home-campaigns__media img {
      transform: scale(1.04);
    }

    .autumn-home-campaigns__media-badge {
      z-index: 2;
      min-height: 0;
      padding: 0;
      border-radius: 0;
      background: transparent;
      color: #fffaf2;
      font-family: var(--dnd-font-display);
      font-size: clamp(1.15rem, 1.8vw, 1.55rem);
      font-weight: 400;
      letter-spacing: 0.04em;
      text-transform: none;
      text-shadow:
        0 2px 5px rgba(17, 16, 13, 0.78),
        0 0 18px rgba(17, 16, 13, 0.64);
      backdrop-filter: none;
    }

    .autumn-home-campaigns__media-badge::after {
      display: block;
      width: 40px;
      height: 1px;
      margin-top: 8px;
      content: "";
      background: #e6ad35;
      box-shadow: 0 0 10px rgba(17, 16, 13, 0.52);
    }

    .autumn-home-campaigns__content {
      position: absolute;
      inset: auto 0 0;
      z-index: 2;
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: end;
      gap: 12px;
      padding: 30px 30px 28px;
      color: #fff;
      background: linear-gradient(180deg, rgba(17, 16, 13, 0) 0%, rgba(17, 16, 13, 0.82) 100%);
    }

    .autumn-home-campaigns__content h3 {
      display: none;
      color: #fffaf2;
      font-size: clamp(1.8rem, 2.4vw, 2.35rem);
      line-height: 1.04;
    }

    .autumn-home-campaigns__content ul {
      grid-column: 1;
      gap: 4px;
    }

    .autumn-home-campaigns__content li {
      color: rgba(255, 250, 242, 0.9);
      font-size: 0.98rem;
      font-weight: 400;
    }

    .autumn-home-campaigns__content li::before {
      color: #e6ad35;
    }

    .autumn-home-campaigns__card-cta {
      grid-column: 2;
      grid-row: 1;
      align-self: end;
      width: fit-content;
      min-height: 44px;
      margin-top: 0;
      padding: 0 18px;
      border: 1px solid rgba(255, 250, 242, 0.62);
      background: rgba(255, 250, 242, 0.12);
      color: #fffaf2;
      font-size: 0.9rem;
      font-weight: 500;
      letter-spacing: 0.08em;
      transition: background 220ms ease, border-color 220ms ease;
    }

    .autumn-home-campaigns__card-cta:hover,
    .autumn-home-campaigns__card-cta:focus-visible {
      border-color: #fffaf2;
      background: rgba(255, 250, 242, 0.24);
    }

    @media (prefers-reduced-motion: reduce) {
      .autumn-home-campaigns__cards .autumn-home-campaigns__card,
      .autumn-home-campaigns__media img,
      .autumn-home-campaigns__card-cta {
        animation: none;
        transition: none;
      }

      .autumn-home-campaigns--observe .autumn-home-campaigns__cards .autumn-home-campaigns__card {
        opacity: 1;
        transform: none;
      }
    }
  }

  @media (max-width: 767px) {
    .autumn-home-campaigns {
      margin-top: 0;
      padding: 16px 0 20px;
      background: #fbf6ee;
    }

    .autumn-home-campaigns__desktop {
      display: none;
    }

    .autumn-home-campaigns__mobile {
      display: block;
    }

    .autumn-home-campaigns__mobile-cta {
      min-height: 90px;
      padding: 18px 6px 16px;
    }

    .autumn-home-campaigns__mobile-cta span {
      font-size: clamp(0.7rem, 3.35vw, 0.92rem);
    }
  }
</style>

<script>
  const autumnCampaignSection = document.querySelector(".autumn-home-campaigns");

  if (autumnCampaignSection && window.matchMedia("(min-width: 768px)").matches) {
    autumnCampaignSection.classList.add("autumn-home-campaigns--observe");

    let observer: IntersectionObserver | undefined;
    const revealAutumnCampaign = () => {
      autumnCampaignSection.classList.add("is-visible");
      observer?.disconnect();
    };

    if ("IntersectionObserver" in window) {
      observer = new IntersectionObserver(
        (entries) => {
          if (entries.some((entry) => entry.isIntersecting)) revealAutumnCampaign();
        },
        { threshold: 0.18, rootMargin: "0px 0px -10% 0px" }
      );
      observer.observe(autumnCampaignSection);
    } else {
      revealAutumnCampaign();
    }
  }
</script>
