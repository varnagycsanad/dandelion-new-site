      }
    ]
  }
} as const;
const copy = copyByLang[lang];
const visibleReviews = copy.reviews;
const hiddenReviews = copy.reviews.slice(2);
---

<section class="home-reviews dnd-section" aria-labelledby={`home-reviews-title-${lang}`}>
  <div class="dnd-container">
    <div class="home-reviews__shell">
      <div class="home-reviews__heading">
        <span class="dnd-section-kicker">{copy.kicker}</span>
        <h2 id={`home-reviews-title-${lang}`}>{copy.title}</h2>
        <p>{copy.intro}</p>
      </div>
      <div class="home-reviews__grid">
        {visibleReviews.map((review) => (
          <article class="home-review-card">
            <div class="home-review-card__top">
              {review.source === "Booking.com" ? (
                <span class="home-review-card__booking-wordmark" aria-label={copy.bookingLogoAlt}>Booking</span>
              ) : (
                <img
                  src={review.logoSrc}
                  alt={copy.googleLogoAlt}
                  width={82}
                  height={24}
                  loading="lazy"
                  decoding="async"
                />
              )}
              <span class="home-review-card__stars" aria-hidden="true">★★★★★</span>
            </div>
            <blockquote>{review.quote}</blockquote>
            <p>{review.meta}</p>
          </article>
        ))}
      </div>
      <details class="home-reviews__more">
        <summary>{copy.moreLabel}</summary>
        <div class="home-reviews__grid home-reviews__grid--more">
          {hiddenReviews.map((review) => (
            <article class="home-review-card">
              <div class="home-review-card__top">
                {review.source === "Booking.com" ? (
                  <span class="home-review-card__booking-wordmark" aria-label={copy.bookingLogoAlt}>Booking</span>
                ) : (
                  <img
                    src={review.logoSrc}
                    alt={copy.googleLogoAlt}
                    width={82}
                    height={24}
                    loading="lazy"
                    decoding="async"
                  />
                )}
                <span class="home-review-card__stars" aria-hidden="true">★★★★★</span>
              </div>
              <blockquote>{review.quote}</blockquote>
              <p>{review.meta}</p>
            </article>
          ))}
        </div>
      </details>
      <a class="home-reviews__google-link" href={googleReviewsHref} target="_blank" rel="noopener noreferrer">
        {copy.googleLinkLabel}
      </a>
    </div>
  </div>
</section>

<style>
  .home-reviews {
    padding-top: 18px;
    padding-bottom: 20px;
  }

  .home-reviews__shell {
    padding: 24px 24px 26px;
    border: 1px solid rgba(91, 70, 42, 0.1);
    border-radius: 8px;
    background: linear-gradient(180deg, rgba(253, 251, 247, 0.96), rgba(247, 242, 231, 0.88));
  }

  .home-reviews__heading {
    max-width: 680px;
    margin: 0 auto 18px;
    text-align: center;
  }

  .home-reviews__heading h2 {
    margin: 0;
    color: rgba(0, 0, 0, 0.86);
    font-family: var(--dnd-font-display);
    font-size: clamp(1.65rem, 2.7vw, 2.3rem);
    font-weight: 500;
    line-height: 1.08;
  }

  .home-reviews__heading p {
    margin: 8px 0 0;
    color: rgba(0, 0, 0, 0.64);
    font-size: var(--dnd-text-md);
    line-height: 1.52;
  }

  .home-reviews__grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 14px;
  }

  .home-reviews__grid--more {
    margin-top: 14px;
  }

  .home-review-card {
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
    padding: 14px;
    border: 1px solid rgba(0, 0, 0, 0.06);
    border-radius: 8px;
    background: #ffffff;
  }

  .home-review-card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }

  .home-review-card__top img {
    display: block;
    width: auto;
    max-width: 96px;
    height: 18px;
    object-fit: contain;
    object-position: left center;
  }

  .home-review-card__booking-wordmark {
    display: inline-flex;
    align-items: center;
    min-height: 18px;
    color: #003580;
    font-size: var(--dnd-text-xs);
    font-weight: 700;
    line-height: 1;
  }

  .home-review-card__stars {
    color: rgba(217, 158, 43, 0.85);
    font-size: var(--dnd-text-2xs);
    letter-spacing: 0.08em;
    white-space: nowrap;
  }

  .home-review-card blockquote {
    margin: 0;
    color: rgba(0, 0, 0, 0.78);
    font-size: var(--dnd-text-xs);
    line-height: 1.45;
  }

  .home-review-card p {
    margin: auto 0 0;
    color: rgba(0, 0, 0, 0.7);
    font-size: var(--dnd-text-2xs);
    font-weight: 600;
    line-height: 1.35;
  }

  .home-reviews__more {
    display: none;
    margin-top: 12px;
  }

  .home-reviews__more summary {
    display: flex;
    width: fit-content;
    min-height: 34px;
    align-items: center;
    justify-content: center;
    margin: 0 auto;
    color: rgba(121, 93, 48, 0.92);
    font-size: var(--dnd-text-2xs);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
    cursor: pointer;
    list-style: none;
  }

  .home-reviews__more summary::-webkit-details-marker {
    display: none;
  }

  .home-reviews__more summary::after {
    content: "+";
    margin-left: 8px;
  }

  .home-reviews__more[open] summary::after {
    content: "-";
  }

  .home-reviews__google-link {
    display: flex;
    width: fit-content;
    min-height: 32px;
    align-items: center;
    justify-content: center;
    margin: 12px auto 0;
    color: rgba(0, 0, 0, 0.64);
    font-size: var(--dnd-text-2xs);
    font-weight: 400;
    line-height: 1.2;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }

  @media (max-width: 768px) {
    .home-reviews {
      padding-top: 18px;
      padding-bottom: 18px;
    }

    .home-reviews__shell {
      padding: 22px 14px 18px;
    }

    .home-reviews__heading h2 {
      font-size: 1.5rem;
      line-height: 1.08;
    }

    .home-reviews__heading p {
      font-size: var(--dnd-text-md);
    }

    .home-reviews__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 10px;
    }

    .home-reviews__grid:not(.home-reviews__grid--more) .home-review-card:nth-child(n + 3) {
      display: none;
    }

    .home-reviews__more {
      display: block;
    }

    .home-review-card {
      padding: 12px 10px;
    }

    .home-review-card__top {
      display: grid;
      gap: 8px;
      justify-items: start;
    }

    .home-review-card blockquote {
      display: -webkit-box;
      min-height: 72px;
      overflow: hidden;
      font-size: var(--dnd-text-2xs);
      line-height: 1.35;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 4;
    }

    .home-review-card p {
      font-size: var(--dnd-text-2xs);
    }
  }
</style>
