---
import { Picture } from "astro:assets";
import bikingImage from "../assets/home/experiences/dandelion-home-experience-bike-01-optimized.webp";
import wineTourImage from "../assets/home/experiences/dandelion-home-experience-wine-gastro-01-optimized.webp";
import balatonImage from "../assets/home/experiences/dandelion-home-experience-balaton-01.webp";
import mountainsImage from "../assets/home/experiences/dandelion-home-experience-tanuhegyek-01.webp";

// [CHANGE 2026-05-16 21:30] Homepage experiences kártyaképek saját home assetekre frissítve.
// [CHANGE 2026-05-16 11:45] Homepage experiences copy rövidítve és természetesebbre véve.
// [CHANGE 2026-05-20 00:00] Experiences can receive localized copy and safe localized hrefs.
interface ExperienceCard {
  title: string;
  description: string;
  image: ImageMetadata;
  imageAlt: string;
  href: string;
}

interface Props {
  sectionId?: string;
  title?: string;
  lead?: string;
  ctaLabel?: string;
  ctaHref?: string;
  mobileCtaLabel?: string;
  experiences?: ExperienceCard[];
}

const defaultExperiences = [
  {
    title: "BICIKLI",
    description: "Bringás körök falvak, szőlősorok és panorámák között.",
    image: bikingImage,
    imageAlt: "Kerékpározás a Balaton-felvidék lankái között",
    href: "/elmenyek/kerekpar/"
  },
  {
    title: "BOR ÉS GASZTRONÓMIA",
    description: "Pincék, borteraszok és jó megállók a környéken.",
    image: wineTourImage,
    imageAlt: "Bor és gasztronómia hangulata szabadtéri terítéssel",
    href: "/elmenyek/bor-es-panorama/"
  },
  {
    title: "BALATON",
    description: "Fürdés, balatoni hajózás és könnyű nyári programok.",
    image: balatonImage,
    imageAlt: "Badacsony és a Balaton panorámája tiszta időben",
    href: "/elmenyek/balaton/"
  },
  {
    title: "TANÚHEGYEK",
    description: "Kilátók, rövid és hosszabb túrák a csendesebb ösvényeken.",
    image: mountainsImage,
    imageAlt: "Tanúhegyek panorámája a Balaton-felvidéken",
    href: "/elmenyek/tanuhegyek/"
  }
];

const {
  sectionId = "elmenyek",
  title = "ÉLMÉNYEK",
  lead = "Bringa, bor, Balaton és tanúhegyek a környék legjobb ritmusában.",
  ctaLabel = "ÖSSZES ÉLMÉNY",
  ctaHref = "/elmenyek/",
  mobileCtaLabel = "RÉSZLETEK",
  experiences = defaultExperiences
} = Astro.props;
---

<section class="dnd-section dnd-experiences" id={sectionId}>
  <div class="dnd-experiences__inner">
    <div class="dnd-experiences__intro">
      <h2 class="dnd-experiences__title">{title}</h2>
      <p class="dnd-experiences__lead">{lead}</p>
      <a href={ctaHref} class="dnd-experiences__cta">{ctaLabel}</a>
    </div>

    <div class="dnd-experiences__grid">
      {
        experiences.map((experience) => (
          <a class="dnd-experience-card" href={experience.href}>
            <div class="dnd-experience-card__media">
              <Picture
                src={experience.image}
                alt={experience.imageAlt}
                loading="lazy"
                decoding="async"
                formats={["webp"]}
                fallbackFormat="webp"
                quality={64}
                widths={[320, 480, 640]}
                sizes="(max-width: 767px) 46vw, (max-width: 1180px) 45vw, 22vw"
              />
            </div>
            <div class="dnd-experience-card__body">
              <h3>{experience.title}</h3>
              <p>{experience.description}</p>
              <span class="dnd-experience-card__mobile-cta">{mobileCtaLabel}</span>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .dnd-experiences {
    background: #fbfaf7;
    padding: 92px 0 82px;
    scroll-margin-top: 150px;
  }

  .dnd-experiences__inner {
    display: grid;
    grid-template-columns: minmax(240px, 320px) minmax(0, 1fr);
    gap: 42px;
    width: min(100% - 96px, 1460px);
    margin: 0 auto;
    align-items: start;
  }

  .dnd-experiences__intro {
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    padding: 10px 0 0;
    text-align: left;
  }

  .dnd-experiences__title {
    margin: 0;
    font-family: var(--dnd-font-display);
    font-size: clamp(1.55rem, 1.55vw, 1.95rem);
    font-weight: 400;
    line-height: 1.04;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgba(0, 0, 0, 0.84);
  }

  .dnd-experiences__lead {
    margin: 18px 0 0;
    max-width: 28ch;
    font-size: var(--dnd-text-body);
    line-height: 1.56;
    color: rgba(0, 0, 0, 0.6);
  }

  .dnd-experiences__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: fit-content;
    min-height: 42px;
    margin-top: 22px;
    padding: 0 18px;
    border: 1px solid rgba(121, 93, 48, 0.28);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.72);
    color: rgba(0, 0, 0, 0.78);
    font-size: var(--dnd-text-2xs);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
    align-self: flex-start;
  }

  .dnd-experiences__cta:hover,
  .dnd-experiences__cta:focus-visible {
    border-color: rgba(121, 93, 48, 0.46);
    background: #ffffff;
    color: rgba(0, 0, 0, 0.92);
  }

  .dnd-experiences__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 18px;
    align-items: stretch;
  }

  .dnd-experience-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    min-width: 0;
    padding: 12px 12px 16px;
    border: 1px solid rgba(121, 93, 48, 0.14);
    border-radius: 18px;
    background: linear-gradient(180deg, rgba(255, 253, 248, 0.98), rgba(246, 239, 227, 0.94));
    box-shadow: 0 10px 24px rgba(80, 57, 31, 0.06);
    color: inherit;
    text-decoration: none;
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }

  .dnd-experience-card:hover,
  .dnd-experience-card:focus-visible {
    transform: translateY(-3px);
    border-color: rgba(121, 93, 48, 0.26);
    box-shadow: 0 16px 32px rgba(80, 57, 31, 0.1);
  }

  .dnd-experience-card__media {
    height: clamp(180px, 15vw, 240px);
    overflow: hidden;
    border-radius: 12px;
  }

  .dnd-experience-card__media :global(picture) {
    width: 100%;
    display: block;
    height: 100%;
  }

  .dnd-experience-card__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .dnd-experience-card__body {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    padding: 16px 6px 0;
  }

  .dnd-experience-card h3 {
    margin: 0;
    font-family: var(--dnd-font-display);
    font-size: var(--dnd-text-body);
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: 0.15em;
    color: rgba(0, 0, 0, 0.78);
  }

  .dnd-experience-card h3::after {
    content: "";
    display: block;
    width: 42px;
    height: 1px;
    margin-top: 10px;
    background: rgba(217, 158, 43, 0.72);
  }

  .dnd-experience-card p {
    margin: 10px 0 0;
    max-width: 20ch;
    font-size: var(--dnd-text-md);
    line-height: 1.42;
    color: rgba(0, 0, 0, 0.58);
  }

  .dnd-experience-card__mobile-cta {
    display: inline-flex;
    align-items: center;
    margin-top: auto;
    padding-top: 14px;
    color: rgba(0, 0, 0, 0.76);
    font-size: var(--dnd-text-2xs);
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  @media (max-width: 767px) {
    .dnd-experiences {
      padding: 28px 0 64px;
    }

    .dnd-experiences__inner {
      display: block;
      width: min(100% - 24px, 420px);
    }

    .dnd-experiences__intro {
      align-items: center;
      padding: 0 12px;
      text-align: center;
    }

    .dnd-experiences__title {
      font-size: 1.5rem;
      letter-spacing: 0.14em;
    }

    .dnd-experiences__lead {
      margin-top: 14px;
      max-width: 29ch;
      font-size: var(--dnd-text-md);
      line-height: 1.48;
    }

    .dnd-experiences__cta {
      min-height: 34px;
      margin-top: 14px;
      padding: 0;
      border: 0;
      border-radius: 0;
      background: transparent;
      color: rgba(121, 93, 48, 0.95);
      font-size: var(--dnd-text-2xs);
      letter-spacing: 0.12em;
      text-decoration: underline;
      text-decoration-thickness: 1px;
      text-underline-offset: 4px;
      align-self: center;
    }

    .dnd-experience-card p {
      max-width: none;
    }

    .dnd-experiences__grid {
      grid-template-columns: 1fr;
      gap: 12px;
      margin-top: 28px;
    }

    .dnd-experience-card {
      display: grid;
      grid-template-columns: 112px minmax(0, 1fr);
      gap: 14px;
      align-items: center;
      padding: 10px;
      border-radius: 16px;
    }

    .dnd-experience-card__body {
      min-width: 0;
      padding: 0 4px 0 0;
    }

    .dnd-experience-card__media {
      width: 112px;
      height: 112px;
      aspect-ratio: 1 / 1;
      border-radius: 12px;
    }

    .dnd-experience-card__media :global(picture) {
      height: 100%;
    }

    .dnd-experience-card h3 {
      font-size: var(--dnd-text-xs);
      line-height: 1.2;
      letter-spacing: 0.08em;
    }

    .dnd-experience-card h3::after {
      width: 34px;
      margin-top: 8px;
    }

    .dnd-experience-card p {
      margin-top: 8px;
      font-size: var(--dnd-text-xs);
      line-height: 1.34;
    }

    .dnd-experience-card__mobile-cta {
      margin-top: 9px;
      font-size: var(--dnd-text-2xs);
      letter-spacing: 0.12em;
      padding-top: 0;
    }
  }

  @media (max-width: 380px) {
    .dnd-experience-card {
      grid-template-columns: 96px minmax(0, 1fr);
      gap: 12px;
    }

    .dnd-experience-card__media {
      width: 96px;
      height: 104px;
    }
  }

  @media (min-width: 768px) and (max-width: 1180px) {
    .dnd-experiences__inner {
      grid-template-columns: 1fr;
      width: min(100% - 48px, 1100px);
    }

    .dnd-experiences__intro {
      padding: 0;
      text-align: left;
      max-width: 640px;
    }

    .dnd-experiences__lead {
      max-width: 48ch;
      margin-left: 0;
    }

    .dnd-experiences__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .dnd-experience-card__media {
      height: auto;
      aspect-ratio: 1 / 1;
    }

    .dnd-experience-card__media :global(picture) {
      height: 100%;
    }
  }
</style>
