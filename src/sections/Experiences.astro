---
import { Image } from "astro:assets";
import bikingImage from "../assets/accommodations/szepvolgyi/gallery/dandelion-szepvolgyi-source-001.webp";
import wineTourImage from "../assets/accommodations/szololiget/gallery/dandelion-szololiget-source-001.webp";
import balatonImage from "../assets/accommodations/royal_homes/gallery/dandelion-royal-homes-source-001.webp";
import mountainsImage from "../assets/accommodations/d2/gallery/dandelion-d2-source-005.webp";

// [CHANGE 2026-05-16 11:45] Homepage experiences copy rövidítve és természetesebbre véve.
const experiences = [
  {
    title: "BICIKLI",
    description: "Bringás körök falvak, szőlősorok és panorámák között.",
    image: bikingImage,
    imageAlt: "Kerékpár vidéki környezetben",
    href: "/elmenyek/kerekpar/"
  },
  {
    title: "BOR ÉS GASZTRONÓMIA",
    description: "Pincék, borteraszok és jó megállók a környéken.",
    image: wineTourImage,
    imageAlt: "Borospohár, palack és szőlő",
    href: "/elmenyek/bor-es-panorama/"
  },
  {
    title: "BALATON",
    description: "Fürdés, esti séták és könnyű nyári programok.",
    image: balatonImage,
    imageAlt: "Naplementés vízparti hangulat",
    href: "/elmenyek/balaton/"
  },
  {
    title: "TANÚHEGYEK",
    description: "Kilátók, rövid túrák és csendes ösvények.",
    image: mountainsImage,
    imageAlt: "Tanúhegyek és természet a Balaton-felvidéken",
    href: "/elmenyek/tanuhegyek/"
  }
];
---

<section class="dnd-section dnd-experiences" id="elmenyek">
  <div class="dnd-experiences__inner">
    <div class="dnd-experiences__intro">
      <h2 class="dnd-experiences__title">ÉLMÉNYEK</h2>
      <p class="dnd-experiences__lead">
        Bringa, bor, Balaton és tanúhegyek a környék legjobb ritmusában.
      </p>
      <a href="/elmenyek/" class="dnd-experiences__cta">ÖSSZES ÉLMÉNY</a>
    </div>

    <div class="dnd-experiences__grid">
      {
        experiences.map((experience) => (
          <a class="dnd-experience-card" href={experience.href}>
            <div class="dnd-experience-card__media">
              <Image src={experience.image} alt={experience.imageAlt} loading="lazy" />
            </div>
            <div class="dnd-experience-card__body">
              <h3>{experience.title}</h3>
              <p>{experience.description}</p>
              <span class="dnd-experience-card__mobile-cta">RÉSZLETEK</span>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .dnd-experiences {
    background: #fbfaf7;
    padding: 118px 0 132px;
    scroll-margin-top: 150px;
  }

  .dnd-experiences__inner {
    display: grid;
    grid-template-columns: 310px minmax(0, 1fr);
    gap: 34px;
    width: min(100% - 96px, 1460px);
    margin: 0 auto;
    align-items: start;
  }

  .dnd-experiences__intro {
    padding-top: 86px;
    text-align: center;
  }

  .dnd-experiences__title {
    margin: 0;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(2.15rem, 2.25vw, 2.85rem);
    font-weight: 400;
    line-height: 1.04;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(0, 0, 0, 0.84);
  }

  .dnd-experiences__lead {
    margin: 24px auto 0;
    max-width: 30ch;
    font-size: 0.96rem;
    line-height: 1.6;
    color: rgba(0, 0, 0, 0.6);
  }

  .dnd-experiences__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 196px;
    min-height: 46px;
    margin-top: 30px;
    border: 1px solid rgba(0, 0, 0, 0.52);
    background: transparent;
    color: rgba(0, 0, 0, 0.78);
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }

  .dnd-experiences__cta:hover,
  .dnd-experiences__cta:focus-visible {
    border-color: rgba(0, 0, 0, 0.82);
    background: rgba(0, 0, 0, 0.04);
    color: rgba(0, 0, 0, 0.92);
  }

  .dnd-experiences__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 18px;
    align-items: start;
  }

  .dnd-experience-card {
    min-width: 0;
    color: inherit;
    text-decoration: none;
    transition: transform 0.2s ease;
  }

  .dnd-experience-card:hover,
  .dnd-experience-card:focus-visible {
    transform: translateY(-3px);
  }

  .dnd-experience-card__media {
    height: clamp(180px, 15vw, 240px);
    overflow: hidden;
    border-radius: 12px;
  }

  .dnd-experience-card__media :global(picture) {
    width: 100%;
    display: block;
    height: 100%;
  }

  .dnd-experience-card__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .dnd-experience-card__body {
    padding: 16px 0 0;
  }

  .dnd-experience-card h3 {
    margin: 0;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 0.95rem;
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: 0.15em;
    color: rgba(0, 0, 0, 0.78);
  }

  .dnd-experience-card h3::after {
    content: "";
    display: block;
    width: 42px;
    height: 1px;
    margin-top: 10px;
    background: rgba(217, 158, 43, 0.72);
  }

  .dnd-experience-card p {
    margin: 10px 0 0;
    max-width: 20ch;
    font-size: 0.88rem;
    line-height: 1.42;
    color: rgba(0, 0, 0, 0.58);
  }

  .dnd-experience-card__mobile-cta {
    display: inline-flex;
    align-items: center;
    margin-top: 12px;
    color: rgba(0, 0, 0, 0.76);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  @media (max-width: 767px) {
    .dnd-experiences {
      padding: 64px 0 70px;
    }

    .dnd-experiences__inner {
      display: block;
      width: min(100% - 24px, 420px);
    }

    .dnd-experiences__intro {
      padding-top: 0;
      text-align: left;
    }

    .dnd-experiences__title {
      font-size: 1.55rem;
      letter-spacing: 0.12em;
    }

    .dnd-experiences__lead,
    .dnd-experience-card p {
      max-width: none;
    }

    .dnd-experiences__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 10px;
      margin-top: 24px;
    }

    .dnd-experience-card__body {
      padding: 12px 0 0;
    }

    .dnd-experience-card__media {
      height: auto;
      aspect-ratio: 0.92 / 1;
    }

    .dnd-experience-card__media :global(picture) {
      height: 100%;
    }

    .dnd-experience-card h3 {
      font-size: 0.8rem;
      letter-spacing: 0.12em;
    }

    .dnd-experience-card p {
      margin-top: 8px;
      font-size: 0.74rem;
      line-height: 1.3;
    }

    .dnd-experience-card__mobile-cta {
      margin-top: 10px;
      font-size: 0.58rem;
      letter-spacing: 0.14em;
    }
  }

  @media (min-width: 768px) and (max-width: 1180px) {
    .dnd-experiences__inner {
      grid-template-columns: 1fr;
      width: min(100% - 48px, 1100px);
    }

    .dnd-experiences__intro {
      padding-top: 0;
      text-align: left;
      max-width: 640px;
    }

    .dnd-experiences__lead {
      max-width: 48ch;
      margin-left: 0;
    }

    .dnd-experiences__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .dnd-experience-card__media {
      height: auto;
      aspect-ratio: 1 / 1;
    }

    .dnd-experience-card__media :global(picture) {
      height: 100%;
    }
  }
</style>
