---
interface Props {
  lang?: "hu" | "en" | "de" | "cs";
}

const { lang = "hu" } = Astro.props as Props;
const copyByLang = {
  hu: {
    kicker: "Dandelion hírlevél",
    title: "Akciók és szabad dátumok",
    lead: "Szezonális ajánlatok és felszabaduló időpontok e-mailben.",
    aria: "Hírlevél popup megnyitása",
    button: "Értesítést kérek",
    note: "Egy rövid felugró ablakban tudsz feliratkozni."
  },
  en: {
    kicker: "Dandelion newsletter",
    title: "Offers, special dates and newly available stays by e-mail.",
    lead: "Quiet updates about seasonal offers, direct booking opportunities and free dates.",
    aria: "Open newsletter signup popup",
    button: "Send me updates",
    note: "You can subscribe in a short popup window."
  },
  de: {
    kicker: "Dandelion Newsletter",
    title: "Angebote, besondere Termine und freie Zeiträume per E-Mail.",
    lead: "Diskrete Hinweise zu saisonalen Angeboten, Direktbuchung und frei gewordenen Terminen.",
    aria: "Newsletter-Popup öffnen",
    button: "Updates erhalten",
    note: "Die Anmeldung öffnet sich in einem kurzen Popup-Fenster."
  },
  cs: {
    kicker: "Newsletter Dandelion",
    title: "Nabídky, speciální termíny a uvolněné pobyty e-mailem.",
    lead: "Nenápadné novinky o sezónních nabídkách, přímé rezervaci a volných termínech.",
    aria: "Otevřít přihlášení k newsletteru",
    button: "Chci novinky",
    note: "Přihlášení se otevře v krátkém vyskakovacím okně."
  }
} as const;
const copy = copyByLang[lang];
---

<section class="dnd-section dnd-newsletter-signup" aria-labelledby={`newsletter-signup-title-${lang}`}>
  <div class="dnd-container">
    <div class="dnd-newsletter-signup__shell">
      <div class="dnd-newsletter-signup__copy">
        <div class="dnd-newsletter-signup__intro">
          <span class="dnd-newsletter-signup__kicker">{copy.kicker}</span>
          <h2 id={`newsletter-signup-title-${lang}`}>{copy.title}</h2>
          <p class="dnd-newsletter-signup__lead">{copy.lead}</p>
        </div>

        <div class="dnd-newsletter-signup__form" role="group" aria-label={copy.aria}>
          <button
            type="button"
            class="dnd-btn dnd-btn--primary dnd-newsletter-signup__trigger"
            onclick="ml('show', '4eQILc', true)"
          >
            {copy.button}
          </button>
          <p class="dnd-newsletter-signup__note">{copy.note}</p>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (function(w,d,e,u,f,l,n){w[f]=w[f]||function(){(w[f].q=w[f].q||[]).push(arguments);};
  l=d.createElement(e),l.async=1,l.src=u,n=d.getElementsByTagName(e)[0],n.parentNode.insertBefore(l,n);})
  (window,document,'script','https://assets.mailerlite.com/js/universal.js','ml');
  ml('account', '2003610');
</script>

<style>
  .dnd-newsletter-signup {
    padding: 18px 0 26px;
    background: #fbf8f1;
  }

  .dnd-newsletter-signup__shell {
    padding: 22px 26px 20px;
    border: 1px solid rgba(91, 70, 42, 0.12);
    border-radius: 26px;
    background:
      radial-gradient(circle at top right, rgba(233, 180, 63, 0.1), transparent 28%),
      linear-gradient(135deg, rgba(255, 254, 250, 0.98), rgba(250, 244, 233, 0.94));
    box-shadow: 0 18px 34px rgba(80, 57, 31, 0.06);
  }

  .dnd-newsletter-signup__copy {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
  }

  .dnd-newsletter-signup__intro {
    display: grid;
    gap: 6px;
    flex: 1 1 auto;
    min-width: 0;
    max-width: 760px;
  }

  .dnd-newsletter-signup__kicker {
    display: inline-block;
    color: rgba(121, 93, 48, 0.82);
    font-size: var(--dnd-text-2xs);
    font-weight: 600;
    letter-spacing: var(--dnd-tracking-label);
    text-transform: uppercase;
  }

  .dnd-newsletter-signup h2 {
    margin: 0;
    color: rgba(39, 32, 24, 0.94);
    font-family: var(--dnd-font-display);
    font-size: clamp(1.16rem, 1.8vw, 1.6rem);
    font-weight: 400;
    line-height: 1.06;
  }

  .dnd-newsletter-signup__lead {
    margin: 0;
    color: rgba(39, 32, 24, 0.72);
    font-size: var(--dnd-text-md);
    line-height: 1.48;
  }

  .dnd-newsletter-signup__form {
    display: grid;
    gap: 10px;
    flex: 0 0 auto;
    justify-items: end;
    text-align: right;
  }

  .dnd-newsletter-signup__trigger {
    width: auto;
    min-width: 172px;
    min-height: 50px;
    padding: 0 24px;
    border-radius: 999px;
    font-size: var(--dnd-text-md);
  }

  .dnd-newsletter-signup__note {
    margin: 0;
    max-width: 26ch;
    color: rgba(39, 32, 24, 0.58);
    font-size: var(--dnd-text-xs);
    line-height: 1.35;
    text-align: right;
  }

  @media (max-width: 900px) {
    .dnd-newsletter-signup {
      padding: 10px 0 22px;
    }

    .dnd-newsletter-signup__shell {
      padding: 24px 18px 20px;
      border-radius: 18px;
      background:
        radial-gradient(circle at top right, rgba(233, 180, 63, 0.08), transparent 30%),
        rgba(255, 253, 248, 0.88);
      box-shadow: 0 10px 26px rgba(80, 57, 31, 0.045);
    }

    .dnd-newsletter-signup__copy {
      display: grid;
      gap: 14px;
      justify-items: center;
      text-align: center;
    }

    .dnd-newsletter-signup__intro {
      justify-items: center;
      gap: 8px;
      max-width: 30ch;
    }

    .dnd-newsletter-signup__kicker {
      font-size: var(--dnd-text-2xs);
      letter-spacing: 0.16em;
    }

    .dnd-newsletter-signup h2 {
      font-size: 1.35rem;
      line-height: 1.08;
    }

    .dnd-newsletter-signup__lead {
      font-size: var(--dnd-text-xs);
      line-height: 1.42;
    }

    .dnd-newsletter-signup__form {
      width: 100%;
      gap: 8px;
      justify-items: center;
      text-align: center;
    }

    .dnd-newsletter-signup__trigger {
      width: fit-content;
      min-width: 0;
      min-height: 42px;
      padding: 0 24px;
      font-size: var(--dnd-text-xs);
    }

    .dnd-newsletter-signup__note {
      max-width: 30ch;
      font-size: var(--dnd-text-2xs);
      text-align: center;
      display: none;
    }
  }
</style>
