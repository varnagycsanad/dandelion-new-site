---
import { Image } from "astro:assets";
import kisapatiStoryImage from "../assets/home/region-stories/dandelion-home-tanuhegyek-story-01.webp";
import balatonStoryImage from "../assets/home/region-stories/dandelion-home-balaton-story-02.webp";
import kaliStoryImage from "../assets/accommodations/koveskal/gallery/dandelion-koveskal-source-001.webp";
import stickyBackgroundImage from "../assets/home/region-stories/szent-gyorgy-hegy-sunrise-sticky-bg-mountains-cutout.webp";

const regionStoryWidths = [480, 768, 1040, 1600];
const regionStorySizes =
  "(max-width: 767px) 100vw, (max-width: 1100px) calc(100vw - 48px), 1040px";
const stickyImageWidths = [768, 1280, 1920, 2400];
const stickyImageSizes = "100vw";

// [CHANGE 2026-05-16 11:45] Homepage region copy rövidítve és konkrétabbá téve.
// [CHANGE 2026-05-20 00:00] Region stories accept localized copy while preserving the homepage visual structure.
interface RegionStory {
  kicker: string;
  title: string;
  description: string;
  meta: string;
  ctaLabel: string;
  mobileCtaLabel: string;
  ctaHref: string;
  image: ImageMetadata;
  imageAlt: string;
}

interface Props {
  sectionId?: string;
  kickerLabel?: string;
  heading?: string;
  lead?: string;
  stories?: RegionStory[];
  stickyBackgroundAlt?: string;
}

const defaultRegionStories = [
  {
    kicker: "Kisapáti · Szent György-hegy · Tapolcai-medence",
    title: "Tanúhegyek ölelésében",
    description:
      "Szőlősorok, hegyek és lassabb reggelek. Itt a csend, a panoráma és a kis falvak adják a pihenés alapját.",
    meta: "Kisapáti és a Tapolcai-medence nyugodt oldala.",
    ctaLabel: "Szállások a tanúhegyeknél",
    mobileCtaLabel: "Szállást keresek a Tapolcai-medencében",
    ctaHref: "/szallasok#tanuhegyek",
    image: kisapatiStoryImage,
    imageAlt: "Kisapáti és a tanúhegyek drónfelvételen a Tapolcai-medencében"
  },
  {
    kicker: "Keszthely · Badacsonyörs",
    title: "A Balaton közelében",
    description:
      "A víz közelsége, könnyű programok és balatoni esték adják a ritmust. Lazább, nyitottabb világ, mégis nyugodt Dandelion-hangulattal.",
    meta: "Keszthely és Badacsonyörs környéke könnyű nyári napokhoz.",
    ctaLabel: "Szállások a Balaton közelében",
    mobileCtaLabel: "Szállást keresek a Balaton mellett",
    ctaHref: "/szallasok#balaton-mellett",
    image: balatonStoryImage,
    imageAlt: "Royal Homes vízparti apartmanok saját mólóval a Balaton közelében"
  },
  {
    kicker: "Köveskál · Káli-medence",
    title: "A Káli-medence csendjében",
    description:
      "Kőfalak, csendes utcák és tágas táj. A Káli-medence inkább elvonulós, lassabb tempójú pihenést ad.",
    meta: "Köveskál környéke csendhez és lelassuláshoz.",
    ctaLabel: "Szállások a Káli-medencében",
    mobileCtaLabel: "Szállást keresek a Káli-medencében",
    ctaHref: "/szallasok#kali-medence",
    image: kaliStoryImage,
    imageAlt: "Káli-medence tájképe"
  }
];

const {
  sectionId = "stays",
  kickerLabel = "Szállások",
  heading = "Nem egy helyszín, három külön világ",
  lead = "Három térség, háromféle pihenés: tanúhegyek, Balaton közeli házak és csendes káli falvak.",
  stories = defaultRegionStories,
  stickyBackgroundAlt = "Napfelkelte a Szent György-hegyről a Tapolcai-medencére nézve"
} = Astro.props;
---

<section id={sectionId} class="dnd-section dnd-region-stories">
  <div class="dnd-region-stories__inner dnd-region-stories__content">
    <div class="dnd-region-stories__intro">
      <span class="dnd-section-kicker">{kickerLabel}</span>
      <h2 class="dnd-region-stories__heading">{heading}</h2>
      <p class="dnd-region-stories__lead">{lead}</p>
    </div>

    <div class="dnd-region-stories__list">
      <div class="dnd-region-stories__sticky-layer" aria-hidden="true">
        <div class="dnd-region-stories__sticky-band">
          <Image
            class="dnd-region-stories__sticky-band-image"
            src={stickyBackgroundImage}
            alt={stickyBackgroundAlt}
            loading="lazy"
            widths={stickyImageWidths}
            sizes={stickyImageSizes}
          />
        </div>
      </div>

      {stories.map((story, index) => (
        <article class={`dnd-region-story dnd-region-story--${index + 1}`}>
          <div class="dnd-region-story__media">
            <Image
              src={story.image}
              alt={story.imageAlt}
              loading="lazy"
              widths={regionStoryWidths}
              sizes={regionStorySizes}
            />
            <div class="dnd-region-story__mobile-overlay">
              <p class="dnd-region-story__kicker dnd-region-story__kicker--mobile">{story.kicker}</p>
              <a href={story.ctaHref} class="dnd-region-story__cta dnd-region-story__cta--mobile">
                {story.mobileCtaLabel}
              </a>
            </div>
          </div>

          <div class="dnd-region-story__panel">
            <p class="dnd-region-story__kicker">{story.kicker}</p>
            <h3 class="dnd-region-story__title">{story.title}</h3>
            <p class="dnd-region-story__description dnd-region-story__text">{story.description}</p>
            <p class="dnd-region-story__meta dnd-region-story__text">{story.meta}</p>
            <a href={story.ctaHref} class="dnd-region-story__cta">{story.ctaLabel}</a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .dnd-region-stories {
    position: relative;
    overflow: visible;
    isolation: isolate;
    padding: 48px 0 92px;
    scroll-margin-top: 150px;
  }

  .dnd-region-stories__sticky-layer {
    position: absolute;
    inset: 0 0 36px;
    z-index: 0;
    pointer-events: none;
  }

  .dnd-region-stories__sticky-band {
    position: sticky;
    top: 118px;
    width: 100vw;
    height: calc(100vh - 118px);
    min-height: 520px;
    margin-left: calc(50% - 50vw);
    overflow: hidden;
    isolation: isolate;
  }

  .dnd-region-stories__sticky-band-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 34%;
    display: block;
  }

  .dnd-region-stories__inner {
    width: min(1200px, calc(100% - 48px));
    margin: 0 auto;
  }

  .dnd-region-stories__content {
    position: relative;
    z-index: 1;
  }

  .dnd-region-stories__intro {
    max-width: 760px;
    margin: 0 auto 42px;
    text-align: center;
  }

  .dnd-region-stories__heading {
    margin: 12px auto 0;
    max-width: none;
    font-family: var(--dnd-font-display);
    font-size: clamp(1.1rem, 1.8vw, 1.7rem);
    line-height: 1.1;
    font-weight: 400;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    white-space: nowrap;
    color: rgba(0, 0, 0, 0.78);
  }

  .dnd-region-stories__lead {
    max-width: 48ch;
    margin: 18px auto 0;
    line-height: 1.6;
    color: rgba(0, 0, 0, 0.7);
  }

  .dnd-region-stories__list {
    display: grid;
    gap: 64px;
    position: relative;
    z-index: 1;
    padding-top: max(560px, calc(100vh - 118px + 84px));
  }

  .dnd-region-story {
    position: relative;
    z-index: 1;
    display: grid;
    width: min(100%, 1040px);
    margin-bottom: 0;
  }

  .dnd-region-story__media {
    position: relative;
    z-index: 1;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 32px;
    width: min(100%, 1040px);
    background: #ddd5c8;
  }

  .dnd-region-story__media :is(img, picture) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 40%;
    display: block;
  }

  .dnd-region-story__mobile-overlay {
    display: none;
  }

  .dnd-region-story__panel {
    position: absolute;
    z-index: 2;
    max-width: 420px;
    padding: 32px 28px;
    background: rgba(253, 251, 247, 0.92);
    border: 1px solid rgba(0, 0, 0, 0.04);
  }

  .dnd-region-story__kicker {
    margin: 0 0 14px;
    font-size: var(--dnd-text-2xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #8a8a8a;
  }

  .dnd-region-story__title {
    margin: 0;
    max-width: 10ch;
    font-family: var(--dnd-font-display);
    font-size: clamp(22px, 1.9vw, 34px);
    line-height: 1.1;
    letter-spacing: 0;
    font-weight: 400;
    color: rgba(0, 0, 0, 0.88);
  }

  .dnd-region-story__text {
    font-size: var(--dnd-text-sm);
    line-height: 1.55;
    color: #333;
  }

  .dnd-region-story__description {
    margin: 16px 0 0;
  }

  .dnd-region-story__meta {
    margin: 10px 0 0;
    color: rgba(0, 0, 0, 0.62);
  }

  .dnd-region-story__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 42px;
    margin-top: 22px;
    padding: 0 18px;
    border: 1px solid rgba(0, 0, 0, 0.44);
    color: rgba(0, 0, 0, 0.82);
    font-size: var(--dnd-text-2xs);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background 0.2s ease, border-color 0.2s ease;
  }

  .dnd-region-story__cta:hover,
  .dnd-region-story__cta:focus-visible {
    background: rgba(0, 0, 0, 0.04);
    border-color: rgba(0, 0, 0, 0.75);
  }

  .dnd-region-story--1 {
    justify-items: start;
    width: min(calc(100% - 232px), 1000px);
  }

  .dnd-region-story--1 .dnd-region-story__panel {
    right: -34px;
    bottom: -34px;
  }

  .dnd-region-story--2 {
    justify-items: end;
    width: min(calc(100% - 276px), 1080px);
    margin-left: auto;
  }

  .dnd-region-story--2 .dnd-region-story__panel {
    left: -40px;
    bottom: -34px;
  }

  .dnd-region-story--3 {
    justify-items: start;
    width: min(calc(100% - 248px), 980px);
  }

  .dnd-region-story--3 .dnd-region-story__panel {
    right: -36px;
    bottom: -30px;
  }

  @media (max-width: 1100px) {
    .dnd-region-story,
    .dnd-region-story--1,
    .dnd-region-story--2,
    .dnd-region-story--3 {
      width: 100%;
      max-width: 1040px;
      margin-left: 0;
      justify-items: stretch;
    }

    .dnd-region-story__panel {
      position: relative;
      inset: auto;
      max-width: none;
      margin: 18px 0 0;
    }

    .dnd-region-story__title {
      max-width: none;
    }
  }

  @media (max-width: 767px) {
    .dnd-region-stories {
      padding: 36px 0 64px;
    }

    .dnd-region-stories__inner {
      width: 100%;
    }

    .dnd-region-stories__intro {
      display: none;
    }

    .dnd-region-stories__heading {
      font-size: var(--dnd-text-body);
      white-space: normal;
    }

    .dnd-region-stories__list {
      gap: 28px;
      padding-top: 0;
    }

    .dnd-region-stories__sticky-layer {
      display: none;
    }

    .dnd-region-story,
    .dnd-region-story--1,
    .dnd-region-story--2,
    .dnd-region-story--3 {
      gap: 0;
    }

    .dnd-region-story__media {
      width: 100%;
      aspect-ratio: 4 / 3;
      border-radius: 0;
    }

    .dnd-region-story__mobile-overlay {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      align-items: stretch;
      padding: 18px 16px 16px;
      background: linear-gradient(
        180deg,
        rgba(17, 16, 13, 0.32) 0%,
        rgba(17, 16, 13, 0.1) 34%,
        rgba(17, 16, 13, 0.14) 62%,
        rgba(17, 16, 13, 0.48) 100%
      );
      pointer-events: none;
    }

    .dnd-region-story__kicker--mobile {
      margin: 0;
      font-size: var(--dnd-text-2xs);
      letter-spacing: 0.14em;
      color: rgba(255, 249, 240, 0.94);
      text-shadow: 0 2px 10px rgba(0, 0, 0, 0.28);
    }

    .dnd-region-story__cta--mobile {
      width: fit-content;
      min-width: 0;
      max-width: calc(100% - 8px);
      margin: 0 auto;
      padding: 0 14px;
      border-color: rgba(255, 249, 240, 0.92);
      background: rgba(255, 251, 245, 0.18);
      color: #fff9f0;
      font-size: var(--dnd-text-2xs);
      letter-spacing: 0.08em;
      text-transform: none;
      white-space: nowrap;
      backdrop-filter: blur(4px);
      pointer-events: auto;
    }

    .dnd-region-story__cta--mobile:hover,
    .dnd-region-story__cta--mobile:focus-visible {
      background: rgba(255, 251, 245, 0.28);
      border-color: rgba(255, 249, 240, 1);
    }

    .dnd-region-story__panel {
      display: none;
    }
  }
</style>
