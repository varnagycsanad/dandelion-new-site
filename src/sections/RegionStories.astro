---
import { Image } from "astro:assets";
import kisapatiStoryImage from "../assets/accommodations/d2/gallery/dandelion-d2-source-005.webp";
import balatonStoryImage from "../assets/accommodations/royal_homes/gallery/dandelion-royal-homes-source-001.webp";
import kaliStoryImage from "../assets/accommodations/koveskal/gallery/dandelion-koveskal-source-001.webp";
import stickyBackgroundImage from "../assets/home/region-stories/szent-gyorgy-hegy-sunrise-sticky-bg.webp";

const regionStories = [
  {
    kicker: "Kisapáti · Szent György-hegy · Tapolcai-medence",
    title: "Tanúhegyek ölelésében",
    description:
      "Szőlősorok, tanúhegyek, keskeny utak és lassú reggelek adják ennek a térségnek a ritmusát. Olyan hely ez, ahol a megérkezés legalább annyira fontos, mint maga a pihenés.",
    meta: "Természetközeli nyugalom, panoráma és esti borozások hangulata.",
    ctaLabel: "Szent György-hegy és környéke",
    ctaHref: "/szallasok#tanuhegyek",
    image: kisapatiStoryImage,
    imageAlt: "Tapolcai-medence látképe a tanúhegyekkel"
  },
  {
    kicker: "Keszthely · Badacsonyörs",
    title: "A Balaton közelében",
    description:
      "Itt a víz közelsége, a könnyű programok és a balatoni fények adják a pihenés alapját. Kicsit nyitottabb, lazább világ, amelyben mégis megmarad a Dandelion-féle csend és kényelem.",
    meta: "Balatoni hangulat, könnyed kikapcsolódás és természetes nyári ritmus.",
    ctaLabel: "Balaton közeli pihenés",
    ctaHref: "/szallasok#balaton-mellett",
    image: balatonStoryImage,
    imageAlt: "Balaton-parti hangulatkép"
  },
  {
    kicker: "Köveskál · Káli-medence",
    title: "A Káli-medence csendjében",
    description:
      "Nyitott terek, kőfalak, különös fények és visszafogott vidéki hangulat teszik ezt a térséget igazán sajátossá. Nem harsány, nem sietős, inkább lassan és mélyen hat.",
    meta: "Elvonuláshoz, feltöltődéshez és tiszta, csendes jelenléthez való.",
    ctaLabel: "Káli-medencei menedékek",
    ctaHref: "/szallasok#kali-medence",
    image: kaliStoryImage,
    imageAlt: "Káli-medence tájképe"
  }
];
---

<section id="stays" class="dnd-section dnd-region-stories">
  <div class="dnd-region-stories__inner dnd-region-stories__content">
    <div class="dnd-region-stories__intro">
      <span class="dnd-section-kicker">Szállások</span>
      <h2 class="dnd-region-stories__heading">Nem egy helyszín, három külön világ</h2>
      <p class="dnd-region-stories__lead">
        Vendégházaink a Balaton-felvidék több karakteres térségében találhatók. Van, ahol a tanúhegyek
        adják a hátteret, van, ahol a Balaton közelsége, és van, ahol a csendes Káli-medence hangulata
        viszi a prímet.
      </p>
    </div>

    <div class="dnd-region-stories__list">
      <div class="dnd-region-stories__sticky-layer" aria-hidden="true">
        <div class="dnd-region-stories__sticky-band">
          <Image
            class="dnd-region-stories__sticky-band-image"
            src={stickyBackgroundImage}
            alt="Napfelkelte a Szent György-hegyről a Tapolcai-medencére nézve"
            loading="lazy"
          />
        </div>
      </div>

      <div class="dnd-region-stories__scroll-stage" aria-hidden="true"></div>

      {regionStories.map((story, index) => (
        <article class={`dnd-region-story dnd-region-story--${index + 1}`}>
          <div class="dnd-region-story__media">
            <Image src={story.image} alt={story.imageAlt} loading="lazy" />
          </div>

          <div class="dnd-region-story__panel">
            <p class="dnd-region-story__kicker">{story.kicker}</p>
            <h3 class="dnd-region-story__title">{story.title}</h3>
            <p class="dnd-region-story__description dnd-region-story__text">{story.description}</p>
            <p class="dnd-region-story__meta dnd-region-story__text">{story.meta}</p>
            <a href={story.ctaHref} class="dnd-region-story__cta">{story.ctaLabel}</a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .dnd-region-stories {
    position: relative;
    overflow: visible;
    isolation: isolate;
    padding: 48px 0 150px;
    scroll-margin-top: 150px;
  }

  .dnd-region-stories__sticky-layer {
    position: absolute;
    inset: -14px 0 -100px;
    z-index: 0;
    pointer-events: none;
  }

  .dnd-region-stories__sticky-band {
    position: sticky;
    top: 96px;
    width: 100vw;
    height: 680px;
    margin-left: calc(50% - 50vw);
    overflow: hidden;
  }

  .dnd-region-stories__sticky-band-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 42%;
    display: block;
  }

  .dnd-region-stories__inner {
    width: min(1200px, calc(100% - 48px));
    margin: 0 auto;
  }

  .dnd-region-stories__content {
    position: relative;
    z-index: 1;
  }

  .dnd-region-stories__intro {
    max-width: 760px;
    margin: 0 auto 64px;
    text-align: center;
  }

  .dnd-region-stories__heading {
    margin: 12px auto 0;
    max-width: none;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(1.1rem, 1.8vw, 1.7rem);
    line-height: 1.1;
    font-weight: 400;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    white-space: nowrap;
    color: rgba(0, 0, 0, 0.78);
  }

  .dnd-region-stories__lead {
    max-width: 62ch;
    margin: 22px auto 0;
    line-height: 1.72;
    color: rgba(0, 0, 0, 0.7);
  }

  .dnd-region-stories__list {
    display: grid;
    gap: 84px;
    position: relative;
    z-index: 1;
  }

  .dnd-region-stories__scroll-stage {
    min-height: clamp(240px, 52vw, 620px);
  }

  .dnd-region-story {
    position: relative;
    z-index: 1;
    display: grid;
    margin-bottom: 0;
  }

  .dnd-region-story__media {
    position: relative;
    z-index: 1;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 32px;
    width: min(100%, 1040px);
    background: #ddd5c8;
  }

  .dnd-region-story__media :is(img, picture) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 40%;
    display: block;
  }

  .dnd-region-story__panel {
    position: absolute;
    z-index: 2;
    max-width: 420px;
    padding: 32px 28px;
    background: rgba(253, 251, 247, 0.92);
    border: 1px solid rgba(0, 0, 0, 0.04);
  }

  .dnd-region-story__kicker {
    margin: 0 0 14px;
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #8a8a8a;
  }

  .dnd-region-story__title {
    margin: 0;
    max-width: 10ch;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(22px, 1.9vw, 34px);
    line-height: 1.1;
    letter-spacing: -0.01em;
    font-weight: 400;
    color: rgba(0, 0, 0, 0.88);
  }

  .dnd-region-story__text {
    font-size: 14px;
    line-height: 1.55;
    color: #333;
  }

  .dnd-region-story__description {
    margin: 18px 0 0;
  }

  .dnd-region-story__meta {
    margin: 14px 0 0;
    color: rgba(0, 0, 0, 0.62);
  }

  .dnd-region-story__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 42px;
    margin-top: 22px;
    padding: 0 18px;
    border: 1px solid rgba(0, 0, 0, 0.44);
    color: rgba(0, 0, 0, 0.82);
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background 0.2s ease, border-color 0.2s ease;
  }

  .dnd-region-story__cta:hover,
  .dnd-region-story__cta:focus-visible {
    background: rgba(0, 0, 0, 0.04);
    border-color: rgba(0, 0, 0, 0.75);
  }

  .dnd-region-story--1 {
    justify-items: start;
  }

  .dnd-region-story--1 .dnd-region-story__panel {
    right: 0;
    bottom: -28px;
  }

  .dnd-region-story--2 {
    justify-items: end;
  }

  .dnd-region-story--2 .dnd-region-story__panel {
    left: 0;
    bottom: -30px;
  }

  .dnd-region-story--3 {
    justify-items: start;
  }

  .dnd-region-story--3 .dnd-region-story__panel {
    right: 0;
    bottom: -24px;
  }

  @media (max-width: 1100px) {
    .dnd-region-story__panel {
      position: relative;
      inset: auto;
      max-width: none;
      margin: 18px 0 0;
    }

    .dnd-region-story__title {
      max-width: none;
    }
  }

  @media (max-width: 767px) {
    .dnd-region-stories {
      padding: 36px 0 64px;
    }

    .dnd-region-stories__inner {
      width: min(100% - 24px, 420px);
    }

    .dnd-region-stories__heading {
      font-size: 1rem;
      white-space: normal;
    }

    .dnd-region-stories__list {
      gap: 36px;
    }

    .dnd-region-stories__sticky-layer {
      display: none;
    }

    .dnd-region-stories__scroll-stage {
      display: none;
    }

    .dnd-region-story__media {
      width: 100%;
      border-radius: 18px;
    }

    .dnd-region-story__panel {
      padding: 22px 18px;
    }
  }
</style>
