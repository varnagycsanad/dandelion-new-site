---
const regionStories = [
  {
    kicker: "Kisapáti · Szent György-hegy · Tapolcai-medence",
    title: "Tanúhegyek ölelésében",
    description:
      "Szőlősorok, tanúhegyek, keskeny utak és lassú reggelek adják ennek a térségnek a ritmusát. Olyan hely ez, ahol a megérkezés legalább annyira fontos, mint maga a pihenés.",
    meta: "Természetközeli nyugalom, panoráma és esti borozások hangulata.",
    ctaLabel: "Szent György-hegy és környéke",
    ctaHref: "/szallasok",
    image:
      "https://dandelionhouse.hu/wp-content/uploads/2026/04/DJI_20260407175709_0028_D.jpg.webp",
    imageAlt: "Tapolcai-medence látképe a tanúhegyekkel",
    width: 1600,
    height: 900
  },
  {
    kicker: "Keszthely · Badacsonyörs",
    title: "A Balaton közelében",
    description:
      "Itt a víz közelsége, a könnyű programok és a balatoni fények adják a pihenés alapját. Kicsit nyitottabb, lazább világ, amelyben mégis megmarad a Dandelion-féle csend és kényelem.",
    meta: "Balatoni hangulat, könnyed kikapcsolódás és természetes nyári ritmus.",
    ctaLabel: "Balaton közeli pihenés",
    ctaHref: "/szallasok",
    image:
      "https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=1800&q=80",
    imageAlt: "Balaton-parti hangulatkép",
    width: 1800,
    height: 1013
  },
  {
    kicker: "Köveskál · Káli-medence",
    title: "A Káli-medence csendjében",
    description:
      "Nyitott terek, kőfalak, különös fények és visszafogott vidéki hangulat teszik ezt a térséget igazán sajátossá. Nem harsány, nem sietős, inkább lassan és mélyen hat.",
    meta: "Elvonuláshoz, feltöltődéshez és tiszta, csendes jelenléthez való.",
    ctaLabel: "Káli-medencei menedékek",
    ctaHref: "/szallasok",
    image:
      "https://dandelionhouse.hu/wp-content/uploads/2026/04/2026-04-17-11-49-24.jpeg.webp",
    imageAlt: "Káli-medence tájképe",
    width: 1600,
    height: 900
  }
];
---

<!-- [CHANGE 2026-04-18 13:01] Restore stable RegionStories overlay layout -->
<section id="stays" class="dnd-section dnd-region-stories">
  <div class="dnd-region-stories__inner dnd-region-stories__content">
    <div class="dnd-region-stories__intro">
      <span class="dnd-section-kicker">Szállások</span>
      <h2 class="dnd-region-stories__heading">Nem egy helyszín — három külön világ</h2>
      <p class="dnd-region-stories__lead">
        Vendégházaink a Balaton-felvidék több karakteres térségében találhatók. Van, ahol a tanúhegyek adják a hátteret, van, ahol a Balaton közelsége, és van, ahol a csendes Káli-medence hangulata viszi a prímet.
      </p>
    </div>

    <div class="dnd-region-stories__list">
      <div class="dnd-region-stories__sticky-layer" aria-hidden="true">
        <div class="dnd-region-stories__sticky-band">
          <div class="dnd-region-stories__sticky-band-image"></div>
        </div>
      </div>

      {regionStories.map((story, index) => (
        <article class={`dnd-region-story dnd-region-story--${index + 1}`}>
          <div class="dnd-region-story__media">
            <img
              src={story.image}
              alt={story.imageAlt}
              width={story.width}
              height={story.height}
              loading="lazy"
            />
          </div>

          <div class="dnd-region-story__panel">
            <p class="dnd-region-story__kicker">{story.kicker}</p>
            <h3 class="dnd-region-story__title">{story.title}</h3>
            <p class="dnd-region-story__description dnd-region-story__text">{story.description}</p>
            <p class="dnd-region-story__meta dnd-region-story__text">{story.meta}</p>
            <a href={story.ctaHref} class="dnd-region-story__cta">{story.ctaLabel}</a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .dnd-region-stories {
    position: relative;
    overflow: visible;
    isolation: isolate;
    padding: 48px 0 150px;
    scroll-margin-top: 150px;
  }

  .dnd-region-stories__sticky-layer {
    position: absolute;
    inset: -14px 0 -100px;
    z-index: 0;
    pointer-events: none;
  }

  .dnd-region-stories__sticky-band {
    position: sticky;
    top: 96px;
    width: 100vw;
    height: 680px;
    margin-left: calc(50% - 50vw);
    overflow: hidden;
  }

  .dnd-region-stories__sticky-band-image {
    width: 100%;
    height: 100%;
    background-image: url("https://dandelionhouse.hu/wp-content/uploads/2026/04/dandelion_szololiget_202508-5.jpg.webp");
    background-size: cover;
    background-position: center 35%;
    background-repeat: no-repeat;
  }

  .dnd-region-stories__inner {
    width: min(1200px, calc(100% - 48px));
    margin: 0 auto;
  }

  .dnd-region-stories__content {
    position: relative;
    z-index: 1;
  }

  .dnd-region-stories__intro {
    max-width: 760px;
    margin: 0 auto 64px;
    text-align: center;
  }

  .dnd-region-stories__heading {
    margin: 12px auto 0;
    max-width: none;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(1.1rem, 1.8vw, 1.7rem);
    line-height: 1.1;
    font-weight: 400;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    white-space: nowrap;
    color: rgba(0, 0, 0, 0.78);
  }

  .dnd-region-stories__lead {
    max-width: 62ch;
    margin: 22px auto 0;
    line-height: 1.72;
    color: rgba(0, 0, 0, 0.7);
  }

  .dnd-region-stories__list {
    display: grid;
    gap: 84px;
    position: relative;
    z-index: 1;
  }

  .dnd-region-story {
    position: relative;
    z-index: 1;
    display: grid;
    margin-bottom: 0;
  }

  .dnd-region-story__media {
    position: relative;
    z-index: 1;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 32px;
    width: min(100%, 1040px);
    background: #ddd5c8;
  }

  .dnd-region-story__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 40%;
    display: block;
  }

  .dnd-region-story__panel {
    position: absolute;
    z-index: 2;
    max-width: 420px;
    padding: 32px 28px;
    background: rgba(253, 251, 247, 0.92);
    border: 1px solid rgba(0, 0, 0, 0.04);
  }

  .dnd-region-story__kicker {
    margin: 0 0 14px;
    font-size: 10px;
    letter-spacing: 0.10em;
    text-transform: uppercase;
    color: #8a8a8a;
  }

  .dnd-region-story__title {
    margin: 0;
    max-width: 10ch;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(22px, 1.9vw, 34px);
    line-height: 1.1;
    letter-spacing: -0.01em;
    font-weight: 400;
    color: rgba(0, 0, 0, 0.88);
  }

  .dnd-region-story__text {
    font-size: 14px;
    line-height: 1.55;
    color: #333;
  }

  .dnd-region-story__description {
    margin: 18px 0 0;
  }

  .dnd-region-story__meta {
    margin: 12px 0 0;
  }

  .dnd-region-story__cta {
    display: inline-flex;
    align-items: center;
    margin-top: 26px;
    padding-bottom: 4px;
    border-bottom: 1px solid rgba(0, 0, 0, 0.22);
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: rgba(0, 0, 0, 0.8);
    transition: border-color 0.2s ease, color 0.2s ease;
  }

  .dnd-region-story__cta:hover,
  .dnd-region-story__cta:focus-visible {
    color: rgba(0, 0, 0, 0.94);
    border-color: rgba(0, 0, 0, 0.46);
  }

  .dnd-region-story--1 .dnd-region-story__media,
  .dnd-region-story--3 .dnd-region-story__media {
    margin-right: auto;
  }

  .dnd-region-story--2 .dnd-region-story__media {
    margin-left: auto;
  }

  .dnd-region-story--3 .dnd-region-story__media img {
    object-position: center 30%;
  }

  .dnd-region-story--1 .dnd-region-story__panel {
    right: -40px;
    bottom: 48px;
  }

  .dnd-region-story--2 .dnd-region-story__panel {
    left: -48px;
    top: 56px;
  }

  .dnd-region-story--3 .dnd-region-story__panel {
    right: -56px;
    top: 72px;
  }

  @media (min-width: 1280px) {
    .dnd-region-stories__list {
      --dnd-story-offset: clamp(110px, 9vw, 190px);
    }

    .dnd-region-story--1,
    .dnd-region-story--3 {
      transform: translateX(calc(var(--dnd-story-offset) * -1));
    }

    .dnd-region-story--2 {
      transform: translateX(var(--dnd-story-offset));
    }
  }

  @media (max-width: 1199px) {
    .dnd-region-story__media {
      width: 100%;
      margin-left: 0;
      margin-right: 0;
    }

    .dnd-region-story--1 .dnd-region-story__panel,
    .dnd-region-story--3 .dnd-region-story__panel {
      right: 20px;
    }

    .dnd-region-story--2 .dnd-region-story__panel {
      left: 20px;
    }
  }

  @media (max-width: 960px) {
    .dnd-region-stories__list {
      gap: 56px;
    }

    .dnd-region-story {
      margin-bottom: 0;
    }

    .dnd-region-story__panel {
      position: relative;
      left: auto !important;
      right: auto !important;
      top: auto !important;
      bottom: auto !important;
      transform: none !important;
      margin: -60px 16px 0 16px;
      width: auto;
      max-width: none;
    }
  }

  @media (max-width: 768px) {
    .dnd-region-stories__sticky-layer {
      display: none;
    }
  }

  @media (max-width: 767px) {
    .dnd-region-stories {
      padding: 40px 0 0;
    }

    .dnd-region-stories__inner {
      width: min(100% - 24px, 1200px);
    }

    .dnd-region-stories__intro {
      margin-bottom: 44px;
    }

    .dnd-region-stories__heading {
      max-width: 24ch;
      font-size: 1.3rem;
      white-space: normal;
    }

    .dnd-region-stories__lead {
      margin-top: 16px;
      line-height: 1.68;
    }

    .dnd-region-story__media {
      min-height: 300px;
      border-radius: 22px;
    }

    .dnd-region-story__panel {
      padding: 24px 22px 22px;
    }

    .dnd-region-story__kicker {
      margin-bottom: 12px;
      font-size: 11.5px;
      line-height: 1.45;
      letter-spacing: 0.08em;
      color: rgba(0, 0, 0, 0.62);
    }

    .dnd-region-story__title {
      font-size: 22px;
    }

    .dnd-region-story__text {
      font-size: 13.2px;
      line-height: 1.5;
      color: rgba(0, 0, 0, 0.62);
    }

    .dnd-region-story__description {
      margin-top: 14px;
    }

    .dnd-region-story__meta {
      margin-top: 10px;
    }

    .dnd-region-story__cta {
      margin-top: 20px;
      padding: 10px 14px;
      border: 1px solid rgba(55, 40, 28, 0.18);
      border-radius: 999px;
      background: rgba(73, 52, 34, 0.08);
      font-size: 0.78rem;
      letter-spacing: 0.03em;
    }

    .dnd-region-story__cta::after {
      content: "→";
      margin-left: 10px;
      font-size: 0.9em;
    }
  }
</style>
