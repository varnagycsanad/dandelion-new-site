---
import { panoramaPoolImages } from "../data/images/panorama-pool-images";

const poolHighlightImage = panoramaPoolImages.find((image) => image.usageHint === "hero") ?? panoramaPoolImages[0];
---

<section class="pool-highlight dnd-section" aria-labelledby="pool-highlight-title">
  <div class="dnd-container">
    <div class="pool-highlight__shell">
      <div class="pool-highlight__content">
        <span class="dnd-section-kicker pool-highlight__kicker">ÚJ 2026-TÓL</span>
        <h2 id="pool-highlight-title" class="pool-highlight__title">
          Panoráma medence a Szent György-hegy oldalában
        </h2>
        <p class="pool-highlight__text">
          A D1, D2 és Fügeház vendégei 2026. június 1-től a házak melletti dombon található panoráma
          medencét is használhatják. Egy nyugodt hely napozáshoz, fürdéshez és a tanúhegyek látványához.
        </p>
        <a href="/panorama-pool/" class="dnd-btn dnd-btn--primary pool-highlight__cta">
          <span>Megnézem a medencét</span>
          <span class="pool-highlight__cta-icon" aria-hidden="true">
            <svg viewBox="0 0 20 20" focusable="false">
              <path
                d="M4.5 10h10m0 0-3.6-3.6M14.5 10l-3.6 3.6"
                fill="none"
                stroke="currentColor"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.8"
              />
            </svg>
          </span>
        </a>
      </div>

      <figure class="pool-highlight__visual">
        <img
          src={poolHighlightImage.src}
          alt={poolHighlightImage.altHu}
          title={poolHighlightImage.titleHu}
          width="1800"
          height="1350"
          class="pool-highlight__image"
          loading="lazy"
          decoding="async"
        />
        <figcaption class="pool-highlight__caption">{poolHighlightImage.captionHu}</figcaption>
        <div class="pool-highlight__card">
          <span class="pool-highlight__card-label">Elérhető</span>
          <strong>D1, D2 és Fügeház</strong>
          <p>2026. június 1-től használható panoráma medence csendes, napos környezetben.</p>
        </div>
      </figure>
    </div>
  </div>
</section>

<style>
  .pool-highlight {
    padding-top: 32px;
    padding-bottom: 34px;
  }

  .pool-highlight__shell {
    display: grid;
    gap: 22px;
    align-items: center;
    padding: 28px;
    border: 1px solid rgba(120, 91, 50, 0.14);
    border-radius: 12px;
    background:
      radial-gradient(circle at top left, rgba(217, 158, 43, 0.14), transparent 30%),
      linear-gradient(135deg, rgba(255, 252, 246, 0.98), rgba(245, 237, 223, 0.94));
    box-shadow: 0 18px 40px rgba(85, 61, 33, 0.08);
    overflow: hidden;
  }

  .pool-highlight__content {
    max-width: 680px;
  }

  .pool-highlight__kicker {
    margin-bottom: 14px;
  }

  .pool-highlight__title {
    margin: 0;
    font-family: "Playfair Display", Georgia, "Times New Roman", serif;
    font-size: clamp(1.9rem, 3vw, 2.65rem);
    line-height: 1.08;
    font-weight: 500;
    color: #2f2418;
  }

  .pool-highlight__text {
    margin: 14px 0 0;
    max-width: 58ch;
    font-size: 1rem;
    line-height: 1.72;
    color: rgba(47, 36, 24, 0.78);
  }

  .pool-highlight__cta {
    margin-top: 22px;
    min-width: 240px;
    justify-content: space-between;
    gap: 14px;
    padding: 0 12px 0 22px;
    border-color: rgba(116, 78, 18, 0.12);
    border-radius: 999px;
    background: linear-gradient(180deg, #e6ad35 0%, #cf9321 100%);
    color: #23160a;
    box-shadow:
      0 16px 34px rgba(181, 126, 26, 0.22),
      inset 0 1px 0 rgba(255, 248, 229, 0.5);
    transition:
      transform 0.24s ease,
      box-shadow 0.24s ease,
      background 0.24s ease,
      border-color 0.24s ease;
  }

  .pool-highlight__cta span:first-child {
    font-size: 0.98rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .pool-highlight__cta:hover,
  .pool-highlight__cta:focus-visible {
    transform: translateY(-2px);
    border-color: rgba(116, 78, 18, 0.2);
    background: linear-gradient(180deg, #ebb544 0%, #d89d2d 100%);
    box-shadow:
      0 22px 38px rgba(181, 126, 26, 0.28),
      inset 0 1px 0 rgba(255, 248, 229, 0.6);
  }

  .pool-highlight__cta:focus-visible {
    outline: 3px solid rgba(217, 158, 43, 0.28);
    outline-offset: 4px;
  }

  .pool-highlight__cta-icon {
    display: inline-flex;
    width: 38px;
    height: 38px;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    background: rgba(255, 248, 229, 0.42);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.58);
    flex: 0 0 auto;
  }

  .pool-highlight__cta-icon svg {
    width: 18px;
    height: 18px;
  }

  .pool-highlight__visual {
    position: relative;
    min-height: 320px;
    margin: 0;
    border-radius: 24px;
    border: 1px solid rgba(120, 91, 50, 0.12);
    display: grid;
    align-items: end;
    padding: 20px;
    overflow: hidden;
    box-shadow: 0 24px 42px rgba(58, 40, 18, 0.14);
  }

  .pool-highlight__visual::before {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(14, 18, 21, 0.08) 0%, rgba(14, 18, 21, 0.02) 30%, rgba(14, 18, 21, 0.36) 100%),
      linear-gradient(135deg, rgba(255, 244, 219, 0.14) 0%, rgba(255, 244, 219, 0) 36%);
    z-index: 1;
  }

  .pool-highlight__visual::after {
    content: "";
    position: absolute;
    inset: 16px;
    border-radius: 18px;
    border: 1px solid rgba(255, 255, 255, 0.38);
    z-index: 2;
    pointer-events: none;
  }

  .pool-highlight__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 64%;
  }

  .pool-highlight__caption {
    position: absolute;
    left: 20px;
    right: 20px;
    bottom: 18px;
    z-index: 3;
    max-width: 52%;
    margin: 0;
    color: rgba(255, 250, 243, 0.92);
    font-size: 0.9rem;
    line-height: 1.5;
    text-shadow: 0 4px 18px rgba(14, 18, 21, 0.24);
  }

  .pool-highlight__card {
    position: relative;
    z-index: 4;
    margin-left: auto;
    max-width: 310px;
    padding: 20px 20px 18px;
    border-radius: 20px;
    background: rgba(255, 252, 246, 0.92);
    border: 1px solid rgba(120, 91, 50, 0.16);
    box-shadow: 0 18px 38px rgba(45, 31, 15, 0.18);
    backdrop-filter: blur(10px);
  }

  .pool-highlight__card-label {
    display: inline-block;
    margin-bottom: 8px;
    color: var(--dnd-accent);
    font-size: 0.76rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .pool-highlight__card strong {
    display: block;
    font-size: 1.06rem;
    color: #2f2418;
  }

  .pool-highlight__card p {
    margin: 8px 0 0;
    font-size: 0.92rem;
    line-height: 1.58;
    color: rgba(47, 36, 24, 0.72);
  }

  @media (min-width: 960px) {
    .pool-highlight__shell {
      grid-template-columns: minmax(0, 1.2fr) minmax(280px, 0.8fr);
      padding: 30px 34px;
    }
  }

  @media (max-width: 767px) {
    .pool-highlight {
      padding-top: 20px;
      padding-bottom: 22px;
    }

    .pool-highlight__shell {
      gap: 16px;
      padding: 22px 18px;
    }

    .pool-highlight__title {
      font-size: clamp(1.55rem, 7vw, 2rem);
    }

    .pool-highlight__text {
      font-size: 0.95rem;
      line-height: 1.62;
    }

    .pool-highlight__cta {
      width: 100%;
      min-width: 0;
      padding-right: 10px;
    }

    .pool-highlight__cta span:first-child {
      font-size: 0.95rem;
    }

    .pool-highlight__cta-icon {
      width: 34px;
      height: 34px;
    }

    .pool-highlight__visual {
      min-height: 260px;
      padding: 14px;
      border-radius: 20px;
    }

    .pool-highlight__caption {
      left: 14px;
      right: 14px;
      bottom: 14px;
      max-width: calc(100% - 28px);
      font-size: 0.82rem;
      padding-right: 88px;
    }

    .pool-highlight__card {
      max-width: none;
      padding: 16px 16px 14px;
      border-radius: 16px;
    }
  }
</style>
