---
import { panoramaPoolImages } from "../data/images/panorama-pool-images";

const poolHighlightImage = panoramaPoolImages.find((image) => image.usageHint === "hero") ?? panoramaPoolImages[0];
const poolHighlightSrcSet = [
  "/images/panorama-pool/responsive/dandelion-panorama-pool-hero-480-q72.webp 480w",
  "/images/panorama-pool/responsive/dandelion-panorama-pool-hero-640-q72.webp 640w",
  "/images/panorama-pool/responsive/dandelion-panorama-pool-hero-960-q72.webp 960w",
  "/images/panorama-pool/responsive/dandelion-panorama-pool-hero-1280-q72.webp 1280w"
].join(", ");
const poolHighlightSizes = "(max-width: 767px) calc(100vw - 72px), (max-width: 959px) calc(100vw - 96px), 46vw";
---

<section class="pool-highlight dnd-section" aria-labelledby="pool-highlight-title">
  <div class="dnd-container">
    <div class="pool-highlight__shell">
      <div class="pool-highlight__content">
        <span class="dnd-section-kicker pool-highlight__kicker">ÚJ 2026-TÓL</span>
        <h2 id="pool-highlight-title" class="pool-highlight__title">
          Panoráma medence a Szent György-hegy oldalában
        </h2>
        <p class="pool-highlight__text">
          A D1, D2 és Fügeház vendégei 2026. június 1-től a házak melletti dombon található panoráma
          medencét is használhatják. Egy nyugodt hely napozáshoz, fürdéshez és a tanúhegyek látványához.
        </p>
        <a href="/panorama-pool/" class="dnd-btn dnd-btn--primary pool-highlight__cta">
          <span>Megnézem a medencét</span>
          <span class="pool-highlight__cta-icon" aria-hidden="true">
            <svg viewBox="0 0 20 20" focusable="false">
              <path
                d="M4.5 10h10m0 0-3.6-3.6M14.5 10l-3.6 3.6"
                fill="none"
                stroke="currentColor"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.8"
              />
            </svg>
          </span>
        </a>
      </div>

      <figure class="pool-highlight__visual">
        <img
          src="/images/panorama-pool/responsive/dandelion-panorama-pool-hero-960-q72.webp"
          srcset={poolHighlightSrcSet}
          sizes={poolHighlightSizes}
          alt={poolHighlightImage.altHu}
          title={poolHighlightImage.titleHu}
          width="960"
          height="720"
          class="pool-highlight__image"
          loading="lazy"
          decoding="async"
        />
        <div class="pool-highlight__visual-badge">
          <span class="pool-highlight__visual-kicker">Panorama Pool</span>
          <p>{poolHighlightImage.titleHu}</p>
        </div>
      </figure>
    </div>
  </div>
</section>

<style>
  .pool-highlight {
    padding-top: 32px;
    padding-bottom: 34px;
  }

  .pool-highlight__shell {
    display: grid;
    gap: 28px;
    align-items: center;
    padding: 30px;
    border: 1px solid rgba(120, 91, 50, 0.14);
    border-radius: 20px;
    background:
      radial-gradient(circle at top left, rgba(217, 158, 43, 0.14), transparent 30%),
      linear-gradient(135deg, rgba(255, 252, 246, 0.98), rgba(245, 237, 223, 0.94));
    box-shadow: 0 18px 40px rgba(85, 61, 33, 0.08);
    overflow: hidden;
  }

  .pool-highlight__content {
    max-width: 680px;
  }

  .pool-highlight__kicker {
    margin-bottom: 14px;
  }

  .pool-highlight__title {
    margin: 0;
    font-family: var(--dnd-font-display);
    font-size: clamp(1.9rem, 3vw, 2.65rem);
    line-height: 1.08;
    font-weight: 500;
    color: #2f2418;
  }

  .pool-highlight__text {
    margin: 14px 0 0;
    max-width: 58ch;
    font-size: var(--dnd-text-body);
    line-height: 1.72;
    color: rgba(47, 36, 24, 0.78);
  }

  .pool-highlight__cta {
    margin-top: 22px;
    min-width: 240px;
    justify-content: space-between;
    gap: 14px;
    padding: 0 12px 0 22px;
    border-color: rgba(116, 78, 18, 0.12);
    border-radius: 999px;
    background: linear-gradient(180deg, #e6ad35 0%, #cf9321 100%);
    color: #23160a;
    box-shadow:
      0 16px 34px rgba(181, 126, 26, 0.22),
      inset 0 1px 0 rgba(255, 248, 229, 0.5);
    transition:
      transform 0.24s ease,
      box-shadow 0.24s ease,
      background 0.24s ease,
      border-color 0.24s ease;
  }

  .pool-highlight__cta span:first-child {
    font-size: var(--dnd-text-body);
    font-weight: 600;
    letter-spacing: 0;
  }

  .pool-highlight__cta:hover,
  .pool-highlight__cta:focus-visible {
    transform: translateY(-2px);
    border-color: rgba(116, 78, 18, 0.2);
    background: linear-gradient(180deg, #ebb544 0%, #d89d2d 100%);
    box-shadow:
      0 22px 38px rgba(181, 126, 26, 0.28),
      inset 0 1px 0 rgba(255, 248, 229, 0.6);
  }

  .pool-highlight__cta:focus-visible {
    outline: 3px solid rgba(217, 158, 43, 0.28);
    outline-offset: 4px;
  }

  .pool-highlight__cta-icon {
    display: inline-flex;
    width: 38px;
    height: 38px;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    background: rgba(255, 248, 229, 0.42);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.58);
    flex: 0 0 auto;
  }

  .pool-highlight__cta-icon svg {
    width: 18px;
    height: 18px;
  }

  .pool-highlight__visual {
    position: relative;
    min-height: 360px;
    margin: 0;
    border-radius: 28px;
    border: 1px solid rgba(120, 91, 50, 0.1);
    display: grid;
    align-items: end;
    padding: 24px;
    overflow: hidden;
    box-shadow: 0 24px 42px rgba(58, 40, 18, 0.14);
    background: #ddd;
  }

  .pool-highlight__visual::before {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(15, 18, 20, 0.04) 0%, rgba(15, 18, 20, 0.02) 32%, rgba(15, 18, 20, 0.28) 100%),
      linear-gradient(135deg, rgba(255, 245, 226, 0.1) 0%, rgba(255, 245, 226, 0) 40%);
    z-index: 1;
  }

  .pool-highlight__visual::after {
    content: "";
    position: absolute;
    inset: 18px;
    border-radius: 22px;
    border: 1px solid rgba(255, 255, 255, 0.28);
    z-index: 2;
    pointer-events: none;
  }

  .pool-highlight__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 72%;
  }

  .pool-highlight__visual-badge {
    position: absolute;
    top: 22px;
    left: 22px;
    z-index: 3;
    max-width: 230px;
    padding: 14px 16px 15px;
    border-radius: 18px;
    background: rgba(32, 27, 22, 0.28);
    border: 1px solid rgba(255, 255, 255, 0.16);
    backdrop-filter: blur(8px);
    color: rgba(255, 250, 243, 0.96);
  }

  .pool-highlight__visual-kicker {
    display: inline-block;
    margin-bottom: 8px;
    font-size: var(--dnd-text-2xs);
    font-weight: 600;
    letter-spacing: var(--dnd-tracking-label);
    text-transform: uppercase;
    color: rgba(255, 220, 162, 0.94);
  }

  .pool-highlight__visual-badge p {
    margin: 0;
    font-size: var(--dnd-text-md);
    line-height: 1.42;
  }

  @media (min-width: 960px) {
    .pool-highlight__shell {
      grid-template-columns: minmax(0, 1.05fr) minmax(420px, 0.95fr);
      padding: 34px 38px;
    }
  }

  @media (max-width: 767px) {
    .pool-highlight {
      padding-top: 20px;
      padding-bottom: 22px;
    }

    .pool-highlight__shell {
      gap: 18px;
      padding: 22px 18px;
      border-radius: 18px;
    }

    .pool-highlight__title {
      font-size: clamp(1.55rem, 7vw, 2rem);
    }

    .pool-highlight__text {
      font-size: var(--dnd-text-body);
      line-height: 1.62;
    }

    .pool-highlight__cta {
      width: 100%;
      min-width: 0;
      padding-right: 10px;
    }

    .pool-highlight__cta span:first-child {
      font-size: var(--dnd-text-body);
    }

    .pool-highlight__cta-icon {
      width: 34px;
      height: 34px;
    }

    .pool-highlight__visual {
      min-height: 300px;
      padding: 14px;
      border-radius: 22px;
    }

    .pool-highlight__visual::after {
      inset: 12px;
      border-radius: 16px;
    }

    .pool-highlight__visual-badge {
      top: 14px;
      left: 14px;
      right: 14px;
      max-width: none;
      padding: 12px 14px;
      border-radius: 14px;
    }

    .pool-highlight__visual-badge p {
      font-size: var(--dnd-text-md);
    }
  }
</style>
