---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import { toAbsoluteUrl } from "../data/site-seo";

type Link = {
  label: string;
  href: string;
};

type Card = {
  title: string;
  body: string;
  href?: string;
  linkLabel?: string;
};

type Section = {
  title: string;
  intro?: string;
  cards: Card[];
};

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  breadcrumbName: string;
  eyebrow: string;
  heading: string;
  lead: string[];
  heroImage: ImageMetadata | string;
  heroAlt: string;
  heroVideoDesktopSrc?: string;
  heroVideoMobileSrc?: string;
  heroPosterSrc?: string;
  supportImage?: ImageMetadata | string;
  supportAlt?: string;
  supportTitle?: string;
  supportText?: string;
  highlights: string[];
  sections: Section[];
  primaryLink?: Link;
  secondaryLink?: Link;
}

const {
  title,
  description,
  canonicalPath,
  breadcrumbName,
  eyebrow,
  heading,
  lead,
  heroImage,
  heroAlt,
  heroVideoDesktopSrc,
  heroVideoMobileSrc,
  heroPosterSrc,
  supportImage,
  supportAlt = "",
  supportTitle,
  supportText,
  highlights,
  sections,
  primaryLink,
  secondaryLink
} = Astro.props;

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Startseite", item: toAbsoluteUrl("/de/") },
      { "@type": "ListItem", position: 2, name: breadcrumbName, item: toAbsoluteUrl(canonicalPath) }
    ]
  }
];
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  lang="de"
  ogLocale="de_DE"
  structuredData={structuredData}
>
  <section class="de-topic">
    <div class="dnd-container de-topic__inner">
      <section class="de-topic__hero">
        <div class="de-topic__copy">
          <span class="de-topic__eyebrow">{eyebrow}</span>
          <h1>{heading}</h1>
          {lead.map((paragraph) => <p>{paragraph}</p>)}
          <ul class="de-topic__highlights">
            {highlights.map((highlight) => <li>{highlight}</li>)}
          </ul>
          {(primaryLink || secondaryLink) && (
            <div class="de-topic__actions">
              {primaryLink && <a class="de-topic__button de-topic__button--dark" href={primaryLink.href}>{primaryLink.label}</a>}
              {secondaryLink && <a class="de-topic__button" href={secondaryLink.href}>{secondaryLink.label}</a>}
            </div>
          )}
        </div>
        <figure class="de-topic__media">
          {heroVideoDesktopSrc ? (
            <video
              autoplay
              muted
              loop
              playsinline
              webkit-playsinline
              preload="metadata"
              poster={heroPosterSrc}
              aria-label={heroAlt}
            >
              {heroVideoMobileSrc && <source src={heroVideoMobileSrc} media="(max-width: 767px)" type="video/mp4" />}
              <source src={heroVideoDesktopSrc} type="video/mp4" />
            </video>
          ) : typeof heroImage === "string" ? (
            <img src={heroImage} alt={heroAlt} width="1400" loading="eager" decoding="async" />
          ) : (
            <Image src={heroImage} alt={heroAlt} width={1400} loading="eager" decoding="async" />
          )}
        </figure>
      </section>

      {supportImage && supportTitle && supportText && (
        <section class="de-topic__support">
          <article class="de-topic__support-card">
            <span class="de-topic__eyebrow">Stimmung</span>
            <h2>{supportTitle}</h2>
            <p>{supportText}</p>
          </article>
          <figure class="de-topic__support-card de-topic__support-card--image">
            {typeof supportImage === "string" ? (
              <img src={supportImage} alt={supportAlt} width="1000" loading="lazy" decoding="async" />
            ) : (
              <Image src={supportImage} alt={supportAlt} width={1000} loading="lazy" decoding="async" />
            )}
          </figure>
        </section>
      )}

      <div class="de-topic__sections">
        {sections.map((section, sectionIndex) => (
          <section class="de-topic__section">
            <details open={sectionIndex === 0}>
              <summary>{section.title}</summary>
              <div class="de-topic__details">
                {section.intro && <p class="de-topic__section-intro">{section.intro}</p>}
                {section.cards.map((card) => (
                  <article class="de-topic-card">
                    <h3>{card.title}</h3>
                    <p>{card.body}</p>
                    {card.href && <a href={card.href}>{card.linkLabel ?? "Mehr dazu"}</a>}
                  </article>
                ))}
              </div>
            </details>
          </section>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .de-topic {
    padding: 124px 0 88px;
    background:
      radial-gradient(circle at top left, rgba(168, 129, 64, 0.13), transparent 30%),
      linear-gradient(180deg, #fcfbf7 0%, #f5efe5 100%);
  }

  .de-topic__inner,
  .de-topic__copy,
  .de-topic__sections,
  .de-topic__details,
  .de-topic-card {
    display: grid;
  }

  .de-topic__inner {
    gap: 28px;
  }

  .de-topic__hero,
  .de-topic__support {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(320px, 0.92fr);
    gap: 24px;
    align-items: stretch;
  }

  .de-topic__copy,
  .de-topic__support-card,
  .de-topic__section details {
    border: 1px solid rgba(88, 63, 38, 0.12);
    border-radius: 8px;
    background: rgba(255, 252, 246, 0.9);
  }

  .de-topic__copy,
  .de-topic__support-card {
    gap: 14px;
    padding: 30px;
    align-content: center;
  }

  .de-topic__eyebrow {
    color: #9b6a1d;
    font-size: var(--dnd-text-2xs);
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .de-topic h1,
  .de-topic h2,
  .de-topic h3 {
    margin: 0;
    color: #261d16;
    font-family: var(--dnd-font-display);
    font-weight: 500;
    line-height: 1.08;
  }

  .de-topic h1 {
    max-width: 12ch;
    font-size: clamp(2.25rem, 4.2vw, 4.1rem);
  }

  .de-topic h2 {
    font-size: clamp(1.55rem, 2.4vw, 2.2rem);
  }

  .de-topic h3 {
    font-size: clamp(1.08rem, 1.5vw, 1.28rem);
  }

  .de-topic p,
  .de-topic li {
    margin: 0;
    color: rgba(43, 32, 22, 0.82);
    font-size: var(--dnd-text-body);
    line-height: 1.72;
  }

  .de-topic__highlights {
    display: grid;
    gap: 8px;
    margin: 0;
    padding-left: 1.2rem;
  }

  .de-topic__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 4px;
  }

  .de-topic__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 46px;
    padding: 0 18px;
    border: 1px solid rgba(65, 47, 30, 0.28);
    border-radius: 8px;
    background: #fff;
    color: #2b2016;
    font-size: var(--dnd-text-xs);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .de-topic__button--dark {
    background: #2b2016;
    border-color: #2b2016;
    color: #fff;
  }

  .de-topic__media,
  .de-topic__support-card--image {
    margin: 0;
    overflow: hidden;
    border-radius: 8px;
    background: #ded6c8;
    box-shadow: 0 22px 56px rgba(43, 28, 14, 0.1);
  }

  .de-topic__media :global(picture),
  .de-topic__media :global(img),
  .de-topic__media :global(video),
  .de-topic__support-card--image :global(picture),
  .de-topic__support-card--image :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .de-topic__media :global(img),
  .de-topic__media :global(video),
  .de-topic__support-card--image :global(img) {
    object-fit: cover;
  }

  .de-topic__sections {
    gap: 16px;
  }

  .de-topic__section details {
    overflow: hidden;
  }

  .de-topic__section summary {
    position: relative;
    padding: 22px 68px 22px 24px;
    cursor: pointer;
    list-style: none;
    color: #261d16;
    font-family: var(--dnd-font-display);
    font-size: clamp(1.25rem, 2vw, 1.58rem);
    font-weight: 500;
  }

  .de-topic__section summary::-webkit-details-marker {
    display: none;
  }

  .de-topic__section summary::after {
    content: "+";
    position: absolute;
    right: 24px;
    top: 50%;
    transform: translateY(-50%);
    color: #8b6318;
    font-size: 1.45rem;
  }

  .de-topic__section details[open] summary::after {
    content: "-";
  }

  .de-topic__details {
    gap: 14px;
    padding: 0 24px 24px;
  }

  .de-topic-card {
    gap: 9px;
    padding: 18px;
    border: 1px solid rgba(88, 63, 38, 0.08);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.72);
  }

  .de-topic-card a {
    color: #8b6318;
    font-weight: 700;
    text-decoration: none;
  }

  @media (max-width: 940px) {
    .de-topic__hero,
    .de-topic__support {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 720px) {
    .de-topic {
      padding: 108px 0 72px;
    }

    .de-topic__copy,
    .de-topic__support-card,
    .de-topic__details {
      padding: 20px;
    }

    .de-topic__section summary {
      padding: 18px 56px 18px 20px;
    }

    .de-topic__section summary::after {
      right: 20px;
    }
  }
</style>
