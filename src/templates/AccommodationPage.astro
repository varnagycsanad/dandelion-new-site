    .d2-hero,
    .d2-hero__content {
      min-height: 100vh;
      min-height: 100svh;
    }

    .d2-hero::before {
      inset: 0;
      width: 100%;
      background: linear-gradient(
        180deg,
        rgba(0, 0, 0, 0.24) 0%,
        rgba(0, 0, 0, 0.48) 28%,
        rgba(0, 0, 0, 0.62) 58%,
        rgba(0, 0, 0, 0.32) 100%
      );
    }

    .d2-hero__content {
