  <script define:vars={{ bookingLink, hasSabeeBookingLink, galleryImages, desktopHeroImage, desktopHeroAlt }}>
    if (hasSabeeBookingLink && typeof window.OpenBE !== "function") {
      window.OpenBE = () => {
        window.open(bookingLink, "_blank", "noopener,noreferrer");
      };
    }

    const heroImage = document.querySelector("[data-accommodation-hero-image]");
    const galleryJump = document.querySelector("[data-accommodation-gallery-jump]");
    const lightbox = document.querySelector("[data-accommodation-lightbox]");
    const lightboxImage = document.querySelector("[data-accommodation-lightbox-image]");
    const lightboxCounter = document.querySelector("[data-accommodation-lightbox-counter]");
    const galleryGrid = document.querySelector(".d2-gallery__grid");
    const galleryTriggers = Array.from(document.querySelectorAll("[data-accommodation-gallery-trigger]"));
    const closeButtons = Array.from(document.querySelectorAll("[data-accommodation-lightbox-close]"));
    const prevButton = document.querySelector("[data-accommodation-lightbox-prev]");
    const nextButton = document.querySelector("[data-accommodation-lightbox-next]");
    const navigationEntries =
      typeof performance.getEntriesByType === "function"
        ? performance.getEntriesByType("navigation")
        : [];
    const isReloadNavigation = navigationEntries[0]?.type === "reload";

    if (isReloadNavigation && window.location.hash === "#accommodation-gallery") {
      history.replaceState(null, "", `${window.location.pathname}${window.location.search}`);
      requestAnimationFrame(() => window.scrollTo({ top: 0, left: 0, behavior: "auto" }));
    }

    galleryJump?.addEventListener("click", (event) => {
      const gallery = document.getElementById("accommodation-gallery");

      if (!gallery) {
        return;
      }

      event.preventDefault();
      gallery.scrollIntoView({ behavior: "smooth", block: "start" });
    });

    if (lightbox && lightboxImage && lightboxCounter && galleryTriggers.length && galleryImages.length) {
      let activeIndex = 0;
      let autoplayTimer = null;
      const heroFallback = heroImage
        ? {
            src: heroImage.getAttribute("src") || "",
            alt: heroImage.getAttribute("alt") || ""
          }
        : null;
      const previewItems = galleryTriggers
        .map((trigger) => ({
          trigger,
          figure: trigger.closest(".d2-gallery__item"),
          image: trigger.querySelector("img"),
          badge: trigger.querySelector(".d2-gallery__more-badge")
        }))
        .filter((item) => item.figure && item.image);

      const stopAutoplay = () => {
        if (autoplayTimer) {
          window.clearInterval(autoplayTimer);
          autoplayTimer = null;
        }
      };

      const renderLightbox = () => {
        const currentImage = galleryImages[activeIndex];

        if (!currentImage) {
          return;
        }

        lightboxImage.src = currentImage.src;
        lightboxImage.alt = currentImage.alt;
        lightboxCounter.textContent = `${activeIndex + 1} / ${galleryImages.length}`;
      };

      const renderPreviewGrid = () => {
        if (!galleryGrid || !previewItems.length) {
          return;
        }

        const previewImages = galleryImages.slice(0, previewItems.length);
        const hasMore = galleryImages.length > previewImages.length;
        const moreCount = Math.max(galleryImages.length - previewImages.length, 0);
        const nextFigures = [];

        previewItems.forEach((item, index) => {
          const nextImage = previewImages[index];

          if (!nextImage || !item.image || !item.figure) {
            return;
          }

          item.trigger.setAttribute("data-accommodation-gallery-index", String(index));
          item.trigger.setAttribute("data-accommodation-gallery-id", String(nextImage.id));
          item.image.src = nextImage.thumb || nextImage.src;
          item.image.alt = nextImage.alt;
          item.image.loading = index < 2 ? "eager" : "lazy";

          if (item.badge) {
            item.badge.remove();
          }

          if (hasMore && index === previewImages.length - 1) {
            const nextBadge = document.createElement("span");
            nextBadge.className = "d2-gallery__more-badge";
            nextBadge.textContent = `+${moreCount} kép`;
            item.trigger.appendChild(nextBadge);
          }
          nextFigures.push(item.figure);
        });

        if (nextFigures.length) {
          galleryGrid.replaceChildren(...nextFigures);
        }
      };

      const applyRuntimeGalleryOrder = (galleryAssignments) => {
        if (!Array.isArray(galleryAssignments) || !galleryAssignments.length) {
          return;
        }

        const sortOrderById = new Map(
          galleryAssignments
            .map((item) => {
              const id = Number(item?.id);
              const sortOrder = Number(item?.sortOrder);

              if (!Number.isInteger(id) || id <= 0 || !Number.isFinite(sortOrder)) {
                return null;
              }

              return [id, sortOrder];
            })
            .filter(Boolean)
        );

        if (!sortOrderById.size) {
          return;
        }

        const orderedImages = galleryImages
          .map((image, originalIndex) => ({
            ...image,
            originalIndex,
            sortOrder: sortOrderById.get(Number(image.id))
          }))
          .sort((left, right) => {
            const leftHasSortOrder = typeof left.sortOrder === "number";
            const rightHasSortOrder = typeof right.sortOrder === "number";

            if (leftHasSortOrder && rightHasSortOrder && left.sortOrder !== right.sortOrder) {
              return left.sortOrder - right.sortOrder;
            }

            if (leftHasSortOrder !== rightHasSortOrder) {
              return leftHasSortOrder ? -1 : 1;
            }

            return left.originalIndex - right.originalIndex;
          })
          .map(({ id, src, thumb, alt, title, caption, sortOrder }) => ({
            id,
            src,
            thumb,
            alt,
            title,
            caption,
            sortOrder
          }));

      galleryImages.splice(0, galleryImages.length, ...orderedImages);
      renderPreviewGrid();

      if (!lightbox.hidden) {
        activeIndex = Math.min(activeIndex, galleryImages.length - 1);
        renderLightbox();
      }
    };

      const renderHeroImage = () => {
        if (!heroImage || !heroFallback) {
          return;
        }

      heroImage.src = desktopHeroImage || heroFallback.src;
      heroImage.alt = desktopHeroAlt || heroFallback.alt;
      };

      const startAutoplay = () => {
        stopAutoplay();
        autoplayTimer = window.setInterval(() => {
          activeIndex = (activeIndex + 1) % galleryImages.length;
          renderLightbox();
        }, 4800);
      };

      const openLightbox = (index) => {
        activeIndex = index;
        lightbox.hidden = false;
        document.body.classList.add("d2-lightbox-open");
        renderLightbox();
        startAutoplay();
      };

      const closeLightbox = () => {
        lightbox.hidden = true;
        document.body.classList.remove("d2-lightbox-open");
        stopAutoplay();
      };

      const stepLightbox = (direction) => {
        activeIndex = (activeIndex + direction + galleryImages.length) % galleryImages.length;
        renderLightbox();
        startAutoplay();
      };

      galleryTriggers.forEach((trigger) => {
        trigger.addEventListener("click", () => {
          const nextIndex = Number(trigger.getAttribute("data-accommodation-gallery-index"));
          openLightbox(Number.isFinite(nextIndex) ? nextIndex : 0);
        });
      });

      closeButtons.forEach((button) => {
        button.addEventListener("click", closeLightbox);
      });

      prevButton?.addEventListener("click", () => stepLightbox(-1));
      nextButton?.addEventListener("click", () => stepLightbox(1));

      document.addEventListener("keydown", (event) => {
        if (lightbox.hidden) {
          return;
        }

        if (event.key === "Escape") {
          closeLightbox();
        }

        if (event.key === "ArrowLeft") {
          stepLightbox(-1);
        }

        if (event.key === "ArrowRight") {
          stepLightbox(1);
        }
      });

      renderHeroImage();
    }
  </script>
</BaseLayout>

