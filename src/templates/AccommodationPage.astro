  .d2-featured-experience__note {
    display: inline-flex;
    width: fit-content;
    margin-top: 7px;
    padding: 2px 7px;
    border-radius: 999px;
    background: rgba(217, 158, 43, 0.16);
    color: rgba(94, 67, 24, 0.88);
    font-size: var(--dnd-text-2xs);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .d2-featured-experience__media {
    overflow: hidden;
    border-radius: 7px;
    aspect-ratio: 1.28 / 1;
    min-height: 120px;
    max-height: 134px;
    border: 1px solid rgba(217, 158, 43, 0.22);
    background: linear-gradient(180deg, rgba(217, 158, 43, 0.18), rgba(91, 70, 42, 0.08));
  }

  .d2-featured-experience__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .d2-reasons__grid {
    display: grid;
    gap: 8px;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .d2-reasons__card,
  .d2-amenities__card {
    display: flex;
    gap: 10px;
    align-items: center;
    padding: 8px 9px;
    border: 1px solid rgba(91, 70, 42, 0.07);
    border-radius: 7px;
    background: rgba(255, 255, 255, 0.52);
  }

  .d2-reasons__card strong,
  .d2-reasons__card p,
  .d2-amenities__card > div {
    grid-column: auto;
  }

  .d2-reasons__card {
    min-height: 60px;
    padding: 9px 10px;
    border: 1px solid rgba(217, 158, 43, 0.16);
    background:
      linear-gradient(180deg, rgba(255, 248, 236, 0.94), rgba(255, 255, 255, 0.8));
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.52),
      0 4px 12px rgba(138, 98, 35, 0.03);
  }

  .d2-reasons__card > svg {
    flex: 0 0 18px;
    width: 18px;
    height: 18px;
    padding: 3px;
    border-radius: 999px;
    background: rgba(217, 158, 43, 0.18);
  }

  .d2-reasons__card > div {
    display: grid;
    gap: 2px;
    align-content: center;
  }

  .d2-amenities__grid {
    display: grid;
    column-gap: 14px;
    row-gap: 4px;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .d2-amenities {
    padding: 10px 10px 6px 12px;
    border: 1px solid rgba(217, 158, 43, 0.16);
    border-left-width: 2px;
    border-radius: 8px;
    background:
      linear-gradient(180deg, rgba(255, 248, 235, 0.84), rgba(252, 244, 229, 0.72));
  }

  .d2-overview__card svg,
  .d2-featured-experience__title-row svg,
  .d2-reasons__card svg,
  .d2-amenities__card svg,
  .d2-location__benefit svg {
    flex: 0 0 auto;
    width: 19px;
    height: 19px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.55;
    stroke-linecap: round;
    stroke-linejoin: round;
    color: #c58a17;
  }

  .d2-details__section-head .dnd-section-kicker {
    font-size: var(--dnd-text-xs);
    font-weight: 600;
    letter-spacing: 0.13em;
    color: rgba(197, 138, 23, 0.96);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 24px;
    padding: 2px 12px;
    border-radius: 999px;
    background: rgba(217, 158, 43, 0.09);
  }

  .d2-featured-experience__title-row svg {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    color: rgba(156, 102, 20, 0.86);
  }

  .d2-reasons__card svg,
  .d2-amenities__card svg {
    align-self: center;
  }

  .d2-reasons__card p,
  .d2-amenities__card p {
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .d2-amenities__card {
    align-items: center;
    min-height: 35px;
    padding: 6px 0;
    border: 0;
    border-bottom: 1px solid rgba(217, 158, 43, 0.14);
    border-radius: 0;
    background: transparent;
  }

  .d2-amenities__card strong {
    font-size: var(--dnd-text-sm);
    line-height: 1.18;
    font-weight: 550;
    color: rgba(28, 22, 16, 0.92);
  }

  .d2-amenities__card > div {
    display: flex;
    align-items: center;
    min-width: 0;
  }

  .d2-amenities__card p {
    display: none;
  }

  .d2-amenities__card svg {
    flex: 0 0 16px;
    width: 16px;
    height: 16px;
    color: rgba(197, 138, 23, 0.9);
  }

  .d2-amenities__card:last-child,
  .d2-amenities__card:nth-last-child(2):nth-child(odd) {
    border-bottom-color: transparent;
  }

  .d2-gallery {
    padding-top: 26px;
  }

  .d2-gallery .dnd-container {
    width: min(100% - 16px, 1900px);
  }

  .d2-gallery__heading,
  .d2-related__heading {
    margin-bottom: 24px;
    text-align: center;
  }

  .d2-gallery__hint {
    margin: 10px 0 0;
    color: rgba(0, 0, 0, 0.58);
    font-size: var(--dnd-text-md);
    line-height: 1.55;
  }

  .d2-gallery__grid {
    display: grid;
    gap: 10px;
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .d2-gallery__empty {
    display: grid;
    min-height: 160px;
    place-items: center;
    border: 1px solid rgba(91, 70, 42, 0.12);
    border-radius: 8px;
    background: rgba(246, 240, 228, 0.54);
    color: rgba(39, 32, 24, 0.64);
    font-size: var(--dnd-text-md);
    line-height: 1.6;
    text-align: center;
  }

  .d2-gallery__item {
    margin: 0;
    overflow: hidden;
    border-radius: 8px;
    background: rgba(0, 0, 0, 0.04);
  }

  .d2-gallery__trigger {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
    overflow: hidden;
  }

  .d2-gallery__item img,
  .d2-location__media img,
  .d2-related__card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .d2-gallery__item img {
    aspect-ratio: 4 / 3;
    transform: scale(1);
    transition: transform 0.42s ease, filter 0.28s ease;
  }

  .d2-gallery__hover-label {
    position: absolute;
    left: 14px;
    bottom: 14px;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    padding: 6px 10px;
    border: 1px solid rgba(253, 251, 247, 0.16);
    border-radius: 999px;
    background: rgba(17, 12, 9, 0.44);
    color: rgba(253, 251, 247, 0.94);
    font-size: var(--dnd-text-2xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    line-height: 1;
    text-transform: uppercase;
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.24s ease, transform 0.24s ease, background 0.24s ease;
    pointer-events: none;
  }

  .d2-gallery__more-badge {
    position: absolute;
    right: 14px;
    bottom: 14px;
    z-index: 1;
    padding: 6px 10px;
    border-radius: 999px;
    background: rgba(17, 12, 9, 0.62);
    color: #fdfbf7;
    font-size: var(--dnd-text-2xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  @media (hover: hover) and (pointer: fine) {
    .d2-gallery__trigger:hover img,
    .d2-gallery__trigger:focus-visible img {
      transform: scale(1.035);
      filter: saturate(1.02);
    }

    .d2-gallery__trigger:hover .d2-gallery__hover-label,
    .d2-gallery__trigger:focus-visible .d2-gallery__hover-label {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .d2-map {
    padding-top: 38px;
    padding-bottom: 78px;
    background: linear-gradient(180deg, rgba(253, 251, 247, 0) 0%, rgba(247, 242, 231, 0.72) 100%);
  }

  .d2-map__inner {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    gap: clamp(28px, 4vw, 56px);
    align-items: center;
  }

  .d2-map__copy {
    max-width: 360px;
  }

  .d2-map__copy p {
    margin: 18px 0 0;
    color: rgba(0, 0, 0, 0.66);
    font-size: var(--dnd-text-md);
    line-height: 1.7;
  }

  .d2-location-benefits {
    display: grid;
    gap: 10px;
    margin-top: 20px;
  }

  .d2-location-benefit {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 10px;
    align-items: start;
    padding: 12px 14px;
    border: 1px solid rgba(91, 70, 42, 0.12);
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.72);
  }

  .d2-location-benefit svg {
    width: 22px;
    height: 22px;
    color: rgba(121, 93, 48, 0.88);
    flex: 0 0 auto;
  }

  .d2-location-benefit span {
    color: rgba(0, 0, 0, 0.72);
    font-size: var(--dnd-text-md);
    line-height: 1.5;
  }

  .d2-map__card {
    height: 500px;
    min-height: 500px;
    overflow: hidden;
    border: 1px solid rgba(91, 70, 42, 0.12);
    border-radius: 24px;
    background: #fbfaf5;
    box-shadow: 0 24px 56px rgba(80, 57, 31, 0.1);
  }

  .d2-map__frame {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .d2-map__canvas {
    position: absolute;
    top: -64px;
    left: 0;
    display: block;
    width: 100%;
    height: calc(100% + 64px);
    border: 0;
  }

  .d2-closer {
    padding-top: 12px;
    padding-bottom: 74px;
  }

  .d2-closer__head {
    max-width: 620px;
    margin: 0 auto 14px;
    text-align: center;
  }

  .d2-closer__head p {
    margin: 8px 0 0;
    color: rgba(0, 0, 0, 0.64);
    font-size: var(--dnd-text-md);
    line-height: 1.54;
  }

  .d2-closer__grid {
    display: grid;
    gap: 10px;
    grid-template-columns: repeat(5, minmax(0, 1fr));
  }

  .d2-closer__card {
    overflow: hidden;
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.86);
  }

  .d2-closer__media {
    position: relative;
    overflow: hidden;
    aspect-ratio: 5 / 4;
    background: rgba(0, 0, 0, 0.04);
  }

  .d2-closer__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1);
    transition: transform 0.36s ease, filter 0.24s ease;
  }

  .d2-closer__copy {
    display: grid;
    gap: 4px;
    padding: 12px 14px 14px;
  }

  .d2-closer__copy strong {
    font-size: var(--dnd-text-body);
    line-height: 1.35;
  }

  .d2-closer__copy span {
    color: rgba(0, 0, 0, 0.6);
    font-size: var(--dnd-text-xs);
    line-height: 1.45;
  }

  @media (hover: hover) and (pointer: fine) {
    .d2-closer__card:hover .d2-closer__media img,
    .d2-closer__card:focus-visible .d2-closer__media img {
      transform: scale(1.03);
      filter: saturate(1.02);
    }

  }

  .d2-lightbox {
    position: fixed;
    inset: 0;
    z-index: 120;
    display: grid;
    place-items: center;
    padding: 24px;
  }

  .d2-lightbox[hidden] {
    display: none;
  }

  .d2-lightbox__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(14, 11, 9, 0.62);
    backdrop-filter: blur(3px);
  }

  .d2-lightbox__dialog {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    width: fit-content;
    max-width: min(100%, 1420px);
    max-height: calc(100vh - 48px);
    padding: 0 68px;
  }

  .d2-lightbox__figure {
    position: relative;
    margin: 0;
    overflow: hidden;
    border-radius: 12px;
    background: transparent;
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.24);
  }

  .d2-lightbox__image {
    display: block;
    width: auto;
    max-width: min(calc(100vw - 180px), 1280px);
    max-height: calc(100vh - 108px);
    object-fit: contain;
    background: transparent;
  }

  .d2-lightbox__meta {
    position: absolute;
    right: 16px;
    bottom: 16px;
    display: inline-flex;
    justify-content: flex-end;
    padding: 7px 11px;
    border: 1px solid rgba(253, 251, 247, 0.14);
    border-radius: 999px;
    background: rgba(17, 12, 9, 0.42);
    color: rgba(253, 251, 247, 0.88);
    font-size: var(--dnd-text-sm);
    letter-spacing: 0.08em;
    line-height: 1.5;
    text-transform: uppercase;
    backdrop-filter: blur(8px);
  }

  .d2-lightbox__close,
  .d2-lightbox__nav {
    display: grid;
    place-items: center;
    border: 1px solid rgba(253, 251, 247, 0.16);
    background: rgba(253, 251, 247, 0.07);
    color: #fdfbf7;
    cursor: pointer;
    font: inherit;
    backdrop-filter: blur(8px);
    transition: background 0.18s ease, transform 0.18s ease, border-color 0.18s ease;
  }

  .d2-lightbox__nav {
    position: absolute;
    top: 50%;
    width: 44px;
    height: 58px;
    border-radius: 999px;
    font-size: 1.45rem;
    transform: translateY(-50%);
  }

  .d2-lightbox__close:hover,
  .d2-lightbox__close:focus-visible,
  .d2-lightbox__nav:hover,
  .d2-lightbox__nav:focus-visible {
    background: rgba(253, 251, 247, 0.14);
    border-color: rgba(253, 251, 247, 0.26);
  }

  .d2-lightbox__close:hover,
  .d2-lightbox__close:focus-visible {
    transform: scale(1.03);
  }

  .d2-lightbox__nav:hover,
  .d2-lightbox__nav:focus-visible {
    transform: translateY(-50%) scale(1.03);
  }

  .d2-lightbox__close {
    position: absolute;
    top: 16px;
    right: 16px;
    width: 40px;
    height: 40px;
    border-radius: 999px;
    font-size: 1.15rem;
    z-index: 2;
  }

  .d2-lightbox__nav--prev {
    left: 10px;
  }

  .d2-lightbox__nav--next {
    right: 10px;
  }

  .d2-lightbox-open {
    overflow: hidden;
  }

  @media (max-width: 959px) {
    .d2-details__layout,
    .d2-map__inner,
    .d2-location__grid {
      grid-template-columns: 1fr;
    }

    .d2-details__layout {
      gap: 12px;
      grid-template-areas:
        "story"
        "panel"
        "featured";
    }

    .d2-featured-experience {
      grid-template-columns: 1fr;
    }

    .d2-overview__grid,
    .d2-amenities__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .d2-reasons__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .d2-map__copy {
      max-width: none;
    }

    .d2-location-benefits {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .d2-map__card {
      height: 380px;
      min-height: 380px;
      border-radius: 18px;
    }

    .d2-map__canvas {
      top: -56px;
      height: calc(100% + 56px);
    }

    .d2-gallery__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 8px;
    }

    .d2-closer__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .d2-lightbox__dialog {
      width: min(100%, 980px);
      padding: 0 54px;
    }
  }

