---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import type { AccommodationPageData } from "../data/accommodation-pages/types";
import type { AccommodationImageSet } from "../data/images/image-types";
import {
  buildGalleryImages,
  buildGalleryPreviewState,
  buildHeroImages,
  buildRelatedStays,
  buildReviewDisplayData,
  type AccommodationPageLocale,
  resolveBaseHref
} from "../lib/accommodation-page-adapters";
import { getCanonicalPath, toAbsoluteUrl } from "../data/site-seo";
import { readHomepageImageMapping } from "../lib/homepage-image-mapping";

const {
  pageData,
  imageSet,
  lang = "hu",
  canonicalPath,
  accommodationListingHref: accommodationListingHrefOverride,
  hideHeader = false,
  hideFooter = false
} = Astro.props as {
  pageData: AccommodationPageData;
  imageSet: AccommodationImageSet;
  lang?: AccommodationPageLocale;
  canonicalPath?: string;
  accommodationListingHref?: string;
  hideHeader?: boolean;
  hideFooter?: boolean;
};

// [CHANGE 2026-05-19 00:00] Accommodation template gained minimal locale props for the first English D2 route, with Hungarian defaults preserved.
const localizedTemplateText = {
  hu: {
    bookingTrustLabel: "Közvetlen foglalás · SabeeApp rendszerben",
    homeBreadcrumbLabel: "Főoldal",
    homeBreadcrumbHref: "/",
    secondaryDetailsLabel: "Tudnivalók és programok",
    decisionPanelAriaLabel: "Szállás döntési áttekintés",
    overviewTitle: "Gyors áttekintés",
    reasonsTitle: "Amiért szeretni fogod",
    relatedListingCta: "Nézd meg a többi Dandelion szállást is.",
    galleryMoreSuffix: "kép",
    poolSealTitleLine1: "PANORÁMA",
    poolSealTitleLine2: "MEDENCE",
    poolSealDate: "2026. JÚNIUS 1-TŐL"
  },
  en: {
    bookingTrustLabel: "Direct booking · SabeeApp system",
    homeBreadcrumbLabel: "English home",
    homeBreadcrumbHref: "/en/",
    secondaryDetailsLabel: "Local tips and things to know",
    decisionPanelAriaLabel: "Accommodation decision overview",
    overviewTitle: "Quick overview",
    reasonsTitle: "Why you will love it",
    relatedListingCta: "Back to accommodations.",
    galleryMoreSuffix: "images",
    poolSealTitleLine1: "PANORAMA",
    poolSealTitleLine2: "POOL",
    poolSealDate: "FROM JUNE 1, 2026"
  }
} satisfies Record<AccommodationPageLocale, Record<string, string>>;

const templateText = localizedTemplateText[lang];

const iconKeyAliases: Record<string, string> = {
  guests: "users",
  family: "users",
  animals: "users",
  kitchen: "utensils",
  garden: "leaf",
  grill: "grapes",
  terrace: "terrace",
  balaton: "balaton",
  parking: "car",
  bathroom: "shower",
  pool: "pool",
  home: "home",
  mountain: "mountain",
  sun: "sun",
  spark: "spark"
};

function toSpriteIconKey(iconKey?: string) {
  if (!iconKey) {
    return "spark";
  }

  return iconKeyAliases[iconKey] ?? iconKey;
}

function inferFactIconKey(term: string, value: string) {
  const source = `${term} ${value}`.toLowerCase();

  if (source.includes("fő") || source.includes("csal")) return "guests";
  if (source.includes("terasz")) return "terrace";
  if (source.includes("kert") || source.includes("udvar")) return "garden";
  if (source.includes("konyha")) return "kitchen";
  if (source.includes("grill") || source.includes("rostonsüt")) return "grill";
  if (source.includes("állat")) return "animals";
  if (source.includes("pool") || source.includes("medence")) return "pool";
  if (source.includes("balaton")) return "balaton";
  if (source.includes("panoráma") || source.includes("hegy")) return "mountain";
  if (source.includes("túra") || source.includes("kiránd")) return "trail";
  if (source.includes("parkol")) return "parking";
  if (source.includes("fürd")) return "bathroom";
  if (source.includes("ház") || source.includes("nappali") || source.includes("szoba")) return "home";

  return "spark";
}

function normalizeDescriptionText(value: string) {
  return value
    .toLowerCase()
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .replace(/[^\p{L}\p{N}\s]/gu, " ")
    .replace(/\s+/g, " ")
    .trim();
}

function tokenizeDescriptionText(value: string) {
  return normalizeDescriptionText(value)
    .split(" ")
    .map((token) => token.trim())
    .filter((token) => token.length >= 3);
}

function areDescriptionsSimilar(first?: string, second?: string) {
  if (!first || !second) return false;

  const normalizedFirst = normalizeDescriptionText(first);
  const normalizedSecond = normalizeDescriptionText(second);

  if (!normalizedFirst || !normalizedSecond) return false;
  if (normalizedFirst === normalizedSecond) return true;
  if (normalizedFirst.includes(normalizedSecond) || normalizedSecond.includes(normalizedFirst)) return true;

  const firstTokens = new Set(tokenizeDescriptionText(first));
  const secondTokens = new Set(tokenizeDescriptionText(second));

  if (firstTokens.size === 0 || secondTokens.size === 0) return false;

  let sharedTokens = 0;
  for (const token of firstTokens) {
    if (secondTokens.has(token)) {
      sharedTokens += 1;
    }
  }

  const overlapRatio = sharedTokens / Math.min(firstTokens.size, secondTokens.size);
  return overlapRatio >= 0.72;
}

function resolveDecisionPanelImage(
  experience?: AccommodationPageData["decisionPanel"] extends infer T
    ? T extends { featuredExperience?: infer U }
      ? U
      : never
    : never
) {
  if (experience?.image) {
    return {
      astroSrc: null,
      src: experience.image.src,
      alt: experience.image.alt,
      width: experience.image.width ?? 1600,
      height: experience.image.height ?? 1200
    };
  }

  const imageKey = experience?.imageKey;
  if (!imageKey) return null;

  if (imageKey === "card") return imageSet.card;
  if (imageKey === "hero-desktop") return imageSet.hero.desktop;
  if (imageKey === "hero-mobile") return imageSet.hero.mobile;

  if (imageKey.startsWith("gallery:")) {
    const index = Number.parseInt(imageKey.slice("gallery:".length), 10);
    return Number.isFinite(index) ? imageSet.gallery[index] ?? null : null;
  }

  return null;
}

const bookingLink = pageData.bookingLink;
const hasSabeeBookingLink = bookingLink.includes("ibe.sabeeapp.com");
const hasInternalBookingLink = bookingLink.startsWith("/") && !bookingLink.startsWith("//");
const canRenderBookingCta = hasSabeeBookingLink || hasInternalBookingLink;
const heroVideo = pageData.hero.video ?? null;
const hasPoolHighlight = Boolean(pageData.hero.poolHighlight?.enabled);
const baseHref = resolveBaseHref(import.meta.env.BASE_URL);

const featureGroups = pageData.facts.groups;
const featureHighlights = pageData.features.highlights;
const decisionPanel = pageData.decisionPanel;
const overviewFacts =
  decisionPanel?.overviewFacts && decisionPanel.overviewFacts.length > 0
    ? decisionPanel.overviewFacts
    : featureGroups.flatMap((group) =>
        group.items.map(([term, value]) => ({
          iconKey: inferFactIconKey(term, value),
          title: value,
          text: term
        }))
      );
const featuredExperience = decisionPanel?.featuredExperience ?? null;
const featuredExperienceImage = resolveDecisionPanelImage(featuredExperience);
const decisionReasons = decisionPanel?.reasons ?? [];
const amenityItems =
  pageData.amenities && pageData.amenities.length > 0
    ? pageData.amenities
    : featureHighlights.map((item) => ({
        iconKey: item.icon,
        title: item.label
      }));
const bookingTrustLabel = hasSabeeBookingLink ? templateText.bookingTrustLabel : null;
const locationBenefits = pageData.map.benefits;
const {
  reviewBrandAssets,
  reviews: reviewItems,
  mobileGoogleReviews: mobileGoogleReviews,
  mobileBookingReviews: mobileBookingReviews
} = buildReviewDisplayData({
  reviews: pageData.reviews.items,
  baseHref,
  googleLogoAlt: pageData.labels.googleLogoAlt,
  bookingLogoAlt: pageData.labels.bookingLogoAlt
});
const mobileReviewGridItems = reviewItems.slice(0, 4);
const mobileReviewGridAriaLabel = lang === "en" ? "Guest reviews mobile grid" : "Vendégértékelések mobil rács";

const galleryItems = buildGalleryImages({
  gallery: imageSet.gallery || [],
  baseHref,
  locale: lang
});
// Gallery adapter state from the shared file-based registry.
const {
  galleryImages,
  galleryWarning,
  galleryPreviewImages,
  galleryHasMore,
  galleryMoreCount
} = buildGalleryPreviewState({
  images: galleryItems,
  previewCount: pageData.gallery.previewCount,
  emptyMessage: pageData.gallery.emptyMessage
});

// Hero image assembly with desktop registry image and safe fallback chain.
const {
  mobileHeroImage,
  desktopHeroImage,
  desktopHeroAlt,
  localHeroFallback,
  heroFallback,
  initialHeroImage
} = buildHeroImages({
  desktopHero: imageSet.hero.desktop || null,
  mobileHero: imageSet.hero.mobile || null,
  mobileImagePath: pageData.hero.mobileImagePath,
  galleryImages,
  fallbackAlt: pageData.hero.fallbackAlt,
  locale: lang
});

const imageMapping = await readHomepageImageMapping();
const compactRelatedStays = buildRelatedStays({
  stays: pageData.relatedStays.items,
  imageMapping,
  baseHref
});
const introKicker = pageData.intro.kicker?.trim() || "";
const introTitle = pageData.intro.title?.trim() || "";
const introLead = pageData.intro.lead?.trim() || "";
const hasIntroBlock = Boolean(introKicker || introTitle || introLead);
const shortDescription = pageData.details.shortDescription?.trim() || "";
const visibleDetailsSummary = shortDescription || introLead;
const detailsLongDescription = (pageData.details.longDescription || [])
  .map((paragraph) => paragraph.trim())
  .filter(Boolean)
  .filter((paragraph, index) => {
    if (index === 0 && areDescriptionsSimilar(paragraph, introLead)) {
      return false;
    }

    return !areDescriptionsSimilar(paragraph, visibleDetailsSummary);
  });
const accommodationListingHref =
  accommodationListingHrefOverride ||
  `${baseHref}${lang === "en" ? "en/szallasok/" : "szallasok/"}`;
const accommodationName = pageData.seo.title.split("|")[0]?.trim() || `${pageData.hero.title} ${pageData.hero.titleAccent}`.trim();
const resolvedCanonicalPath = canonicalPath ?? getCanonicalPath(Astro.url.pathname);
const canonicalUrl = toAbsoluteUrl(resolvedCanonicalPath);
const reservationAction = hasSabeeBookingLink
  ? {
      "@type": "ReserveAction",
      target: toAbsoluteUrl(bookingLink)
    }
  : undefined;
const heroSchemaImage = desktopHeroImage || initialHeroImage.src || mobileHeroImage;
const fallbackOgImage =
  imageSet.card?.astroSrc?.src ||
  imageSet.hero.desktop?.astroSrc?.src ||
  imageSet.hero.mobile?.astroSrc?.src ||
  imageSet.gallery[0]?.astroSrc?.src ||
  heroSchemaImage;
const accommodationStructuredData = [
  {
    "@context": "https://schema.org",
    "@type": "LodgingBusiness",
    "@id": `${canonicalUrl}#lodging`,
    name: accommodationName,
    url: canonicalUrl,
    description: pageData.seo.description,
    image: toAbsoluteUrl(heroSchemaImage),
    telephone: "+36207730807",
    // [CHANGE 2026-05-20 00:00] Minimal LodgingBusiness action from the visible SabeeApp CTA href; contact-only stays intentionally omit reservation action.
    potentialAction: reservationAction
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: templateText.homeBreadcrumbLabel,
        item: toAbsoluteUrl(templateText.homeBreadcrumbHref)
      },
      {
        "@type": "ListItem",
        position: 2,
        name: accommodationName,
        item: canonicalUrl
      }
    ]
  }
];
---

<BaseLayout
  title={pageData.seo.title}
  description={pageData.seo.description}
  canonicalPath={resolvedCanonicalPath}
  lang={lang}
  ogLocale={lang === "en" ? "en_US" : "hu_HU"}
  ogImage={fallbackOgImage}
  ogImageAlt={initialHeroImage.alt}
  structuredData={accommodationStructuredData}
  hideHeader={hideHeader}
  hideFooter={hideFooter}
>
  <Fragment slot="head">
    <link
      rel="preload"
      as="image"
      href={mobileHeroImage}
      type="image/webp"
      media="(max-width: 767px)"
      fetchpriority="high"
    />
    <meta name="theme-color" content="#efe4d3" media="(max-width: 767px)" />
  </Fragment>

  <section class="d2-hero">
    {heroVideo ? (
      <div class="d2-hero__picture">
        <video
          class="d2-hero__image"
          autoplay
          muted
          loop
          playsinline
          webkit-playsinline
          preload="auto"
          disablepictureinpicture
          disableremoteplayback
          poster={heroFallback.src}
          aria-hidden="true"
          data-accommodation-hero-video
        >
          <source media="(max-width: 767px)" src={heroVideo.mobile} type="video/mp4" />
          <source media="(min-width: 768px)" src={heroVideo.desktop} type="video/mp4" />
          {heroFallback.astroSrc ? (
            <Image
              src={heroFallback.astroSrc}
              alt={heroFallback.alt}
              class="d2-hero__image"
              loading="eager"
              decoding="async"
              fetchpriority="high"
              data-accommodation-hero-image
            />
          ) : (
            <img
              src={heroFallback.src}
              alt={heroFallback.alt}
              width={heroFallback.width}
              height={heroFallback.height}
              class="d2-hero__image"
              loading="eager"
              decoding="async"
              fetchpriority="high"
              data-accommodation-hero-image
            />
          )}
        </video>
      </div>
    ) : (
      <picture class="d2-hero__picture">
        <source media="(max-width: 767px)" srcset={mobileHeroImage} data-accommodation-hero-mobile-source />
        {initialHeroImage.astroSrc ? (
          <Image
            src={initialHeroImage.astroSrc}
            alt={initialHeroImage.alt}
            class="d2-hero__image"
            loading="eager"
            decoding="async"
            fetchpriority="high"
            data-accommodation-hero-image
          />
        ) : (
          <img
            src={initialHeroImage.src}
            alt={initialHeroImage.alt}
            width={initialHeroImage.width}
            height={initialHeroImage.height}
            class="d2-hero__image"
            loading="eager"
            decoding="async"
            fetchpriority="high"
            data-accommodation-hero-image
          />
        )}
      </picture>
    )}
    <div
      class:list={[
        "dnd-container",
        "d2-hero__content",
        !hasPoolHighlight && "d2-hero__content--no-pool-seal"
      ]}
    >
      <div class="d2-hero__stack">
        {/* [CHANGE 2026-05-17 02:52] A pecsétes mobil hero közös alsó stackre váltott: a pecsét a copy fölött jelenik meg, a teljes blokk pedig leül a hero aljára. */}
        {pageData.hero.poolHighlight?.enabled && (
          <a
            href={pageData.hero.poolHighlight.href}
            class:list={[
              "dnd-pool-seal",
              pageData.hero.poolHighlight.variant === "strong" && "dnd-pool-seal--strong"
            ]}
            aria-label={`${pageData.hero.poolHighlight.label}${pageData.hero.poolHighlight.text ? `. ${pageData.hero.poolHighlight.text}` : ""}${pageData.hero.poolHighlight.ctaLabel ? ` ${pageData.hero.poolHighlight.ctaLabel}.` : ""}`}
            title={pageData.hero.poolHighlight.ctaLabel || pageData.hero.poolHighlight.label}
          >
            <svg viewBox="0 0 260 260" aria-hidden="true" class="dnd-pool-seal__svg">
              <defs>
                <radialGradient id="dndPoolSealGold" cx="34%" cy="22%" r="82%">
                  <stop offset="0%" stop-color="#F3C966"></stop>
                  <stop offset="48%" stop-color="#D99E2B"></stop>
                  <stop offset="100%" stop-color="#9C6614"></stop>
                </radialGradient>
                <filter id="dndPoolSealShadow" x="-25%" y="-25%" width="150%" height="150%">
                  <feDropShadow dx="0" dy="10" stdDeviation="7" flood-color="#000000" flood-opacity="0.32"></feDropShadow>
                </filter>
              </defs>

              <circle cx="130" cy="130" r="112" fill="url(#dndPoolSealGold)" filter="url(#dndPoolSealShadow)"></circle>
              <circle cx="130" cy="130" r="101" fill="none" stroke="rgba(255,255,255,0.82)" stroke-width="2"></circle>

              <path
                d="M47 52 C82 18 142 13 184 34 C224 55 246 104 239 151"
                fill="none"
                stroke="rgba(255,255,255,0.70)"
                stroke-width="2"
                stroke-linecap="round"
              ></path>
              <path
                d="M213 213 C174 246 103 249 58 208"
                fill="none"
                stroke="rgba(255,255,255,0.84)"
                stroke-width="2"
                stroke-linecap="round"
              ></path>

              <g class="dnd-pool-seal__icon" transform="translate(130 70)" stroke="rgba(255,255,255,0.9)" fill="none" stroke-width="2" stroke-linecap="round">
                <path d="M-18 9 C-10 2 -4 2 4 9 C11 15 17 15 24 9"></path>
                <path d="M-13 20 C-6 15 0 15 7 20 C14 25 20 25 27 20"></path>
                <path d="M-10 -2 A15 15 0 0 1 20 -2"></path>
                <path d="M5 -25 V-17"></path>
                <path d="M-18 -16 L-12 -10"></path>
                <path d="M28 -16 L22 -10"></path>
              </g>

              <text x="130" y="118" text-anchor="middle" class="dnd-pool-seal__title">
                <tspan x="130" dy="0">{templateText.poolSealTitleLine1}</tspan>
                <tspan x="130" dy="33">{templateText.poolSealTitleLine2}</tspan>
              </text>

              <text x="130" y="188" text-anchor="middle" class="dnd-pool-seal__date">
                {templateText.poolSealDate}
              </text>

              <path d="M202 213 C219 201 229 186 231 168" fill="none" stroke="rgba(255,255,255,0.92)" stroke-width="3" stroke-linecap="round"></path>
              <path d="M219 169 L232 167 L232 181" fill="none" stroke="rgba(255,255,255,0.92)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </a>
        )}
        <div class="d2-hero__copy">
          <span class="d2-kicker">{pageData.hero.kicker}</span>
          <h1 class:list={{ "d2-hero__title--d2": pageData.hero.titleAccent === "D2" }}>{pageData.hero.title} <span>{pageData.hero.titleAccent}</span></h1>
          <p class="d2-hero__subtitle">{pageData.hero.subtitle}</p>
          <p class="d2-hero__lead">{pageData.hero.lead}</p>
          {/* [CHANGE 2026-05-16 12:45] Opcionális supporting link a hero-ban a kiemelt medence vagy más felső szintű belső link kezelésére. */}
          {pageData.hero.supportingLink && (
            <p class="d2-hero__supporting-link">
              <a href={pageData.hero.supportingLink.href}>{pageData.hero.supportingLink.label}</a>
            </p>
          )}
          <div class="d2-hero__actions">
            {canRenderBookingCta && (
              <a
                href={bookingLink}
                class="dnd-btn dnd-btn--primary d2-hero__booking"
                target={hasSabeeBookingLink ? "_blank" : undefined}
                rel={hasSabeeBookingLink ? "noopener noreferrer" : undefined}
                onclick={hasSabeeBookingLink ? "OpenBE(); return false;" : undefined}
              >
                {pageData.hero.primaryCtaLabel}
              </a>
            )}
            <a href="#accommodation-gallery" class="dnd-btn dnd-btn--secondary" data-accommodation-gallery-jump>{pageData.hero.secondaryCtaLabel}</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="d2-reviews dnd-section" aria-labelledby="accommodation-reviews-title">
    <div class="dnd-container">
      <div class="d2-reviews__shell">
        <div class="d2-reviews__heading">
          <span class="dnd-section-kicker">{pageData.reviews.kicker}</span>
          <h2 id="accommodation-reviews-title" class="d2-reviews__title">{pageData.reviews.title}</h2>
          <p class="d2-reviews__intro">{pageData.reviews.intro}</p>
        </div>

        <div class="d2-reviews__grid">
          {reviewItems.map((review) => (
            <article class="d2-review-card">
              <div class="d2-review-card__top">
                <img
                  src={review.logoSrc}
                  alt={review.logoAlt}
                  width={review.source === "Google" ? 82 : 96}
                  height={24}
                  class:list={["d2-review-card__logo", review.source === "Google" ? "is-google" : "is-booking"]}
                  loading="lazy"
                  decoding="async"
                />
                <span class="d2-review-card__stars" aria-hidden="true">★★★★★</span>
              </div>
              <blockquote class="d2-review-card__quote">{review.quote}</blockquote>
              <p class="d2-review-card__meta">{review.meta}</p>
            </article>
          ))}
        </div>

        <div class="d2-reviews__mobile-grid" aria-label={mobileReviewGridAriaLabel}>
          {mobileReviewGridItems.map((review) => (
            <article class="d2-review-card d2-review-card--mobile-grid">
              <div class="d2-review-card__top d2-review-card__top--mobile-grid">
                {review.source === "Booking.com" ? (
                  <span class="d2-review-card__logo-crop d2-review-card__logo-crop--mobile-booking">
                    <img
                      src={review.logoSrc}
                      alt={review.logoAlt}
                      width={70}
                      height={24}
                      class:list={[
                        "d2-review-card__logo",
                        "is-booking",
                        "d2-review-card__logo--mobile-booking"
                      ]}
                      loading="lazy"
                      decoding="async"
                    />
                  </span>
                ) : (
                  <img
                    src={review.logoSrc}
                    alt={review.logoAlt}
                    width={82}
                    height={24}
                    class:list={["d2-review-card__logo", "is-google"]}
                    loading="lazy"
                    decoding="async"
                  />
                )}
                <span class="d2-review-card__stars" aria-hidden="true">★★★★★</span>
              </div>
              <blockquote class="d2-review-card__quote">{review.quote}</blockquote>
              <p class="d2-review-card__meta">{review.meta}</p>
            </article>
          ))}
        </div>

        <div class="d2-reviews__mobile d2-reviews__mobile--legacy">
          <section class="d2-reviews__mobile-group" aria-label={pageData.reviews.mobileHighlightedAriaLabel}>
            <div class="d2-reviews__mobile-head">
              <img
                src={reviewBrandAssets.Google.logoSrc}
                alt={reviewBrandAssets.Google.logoAlt}
                width={82}
                height={24}
                class="d2-reviews__mobile-logo is-google"
                loading="lazy"
                decoding="async"
              />
            </div>
            <article class="d2-review-card d2-review-card--mobile">
              <div class="d2-review-card__top d2-review-card__top--mobile">
                <span class="d2-review-card__stars" aria-hidden="true">★★★★★</span>
              </div>
              <blockquote class="d2-review-card__quote">{mobileGoogleReviews[0]?.quote}</blockquote>
              <p class="d2-review-card__meta">{mobileGoogleReviews[0]?.meta}</p>
            </article>
          </section>

          <details class="d2-reviews__more">
            <summary>{pageData.reviews.mobileSummaryLabel}</summary>

            <section class="d2-reviews__mobile-group" aria-label={pageData.reviews.mobileMoreGoogleAriaLabel}>
              <div class="d2-reviews__mobile-head">
                <img
                  src={reviewBrandAssets.Google.logoSrc}
                  alt={reviewBrandAssets.Google.logoAlt}
                  width={82}
                  height={24}
                  class="d2-reviews__mobile-logo is-google"
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <div class="d2-reviews__mobile-list">
                {mobileGoogleReviews.slice(1).map((review) => (
                  <article class="d2-review-card d2-review-card--mobile">
                    <div class="d2-review-card__top d2-review-card__top--mobile">
                      <span class="d2-review-card__stars" aria-hidden="true">★★★★★</span>
                    </div>
                    <blockquote class="d2-review-card__quote">{review.quote}</blockquote>
