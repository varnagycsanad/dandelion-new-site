---
import BaseLayout from "../layouts/BaseLayout.astro";
import type { GuideContent, GuideLocale } from "../data/guides/types";
import guidePageStyles from "../styles/guide-page.css?raw";

const { guide, enabledLocales = ["hu", "en", "cs", "de", "sk"] } = Astro.props as {
  guide: GuideContent;
  enabledLocales?: GuideLocale[];
};
const locales: GuideLocale[] = enabledLocales;
const allLocales: GuideLocale[] = ["hu", "en", "cs", "de", "sk"];
const resolveContent = (locale: GuideLocale) =>
  guide.content[locale] ?? guide.content.en ?? guide.content.cs ?? guide.content.de ?? guide.content.hu;
const localeContents = Object.fromEntries(allLocales.map((locale) => [locale, resolveContent(locale)])) as Record<
  GuideLocale,
  NonNullable<ReturnType<typeof resolveContent>>
>;
const pageTitle = `${resolveContent("hu")?.title ?? guide.houseName} | ${guide.houseName}`;
const description = resolveContent("hu")?.intro ?? "";
const localizedPageTitles: Record<GuideLocale, string> = Object.fromEntries(
  allLocales.map((locale) => [locale, `${resolveContent(locale)?.title ?? guide.houseName} | ${guide.houseName}`])
) as Record<GuideLocale, string>;
const languageLabels: Record<GuideLocale, string> = { hu: "HU", en: "EN", cs: "CZ", de: "DE", sk: "SK" };
const importantLabels: Record<GuideLocale, string> = { hu: "Fontos pontok", en: "Key points", cs: "D\u016fle\u017eit\u00e9 body", de: "Wichtige Punkte", sk: "Dôležité body" };
const tocLabels: Record<GuideLocale, string> = { hu: "Ugr\u00e1s a ponthoz", en: "Jump to section", cs: "P\u0159ej\u00edt na sekci", de: "Zum Abschnitt springen", sk: "Prejsť na sekciu" };
const tocPlaceholderLabels: Record<GuideLocale, string> = { hu: "V\u00e1lassz pontot", en: "Choose a section", cs: "Vyberte sekci", de: "Abschnitt w\u00e4hlen", sk: "Vyber sekciu" };
const manualCaptionLabels: Record<GuideLocale, string> = {
  hu: "Whirlpool WIO 3O540 PELG programtáblázat",
  en: "Whirlpool WIO 3O540 PELG programs table",
  cs: "Tabulka programů Whirlpool WIO 3O540 PELG",
  de: "Whirlpool WIO 3O540 PELG programs table",
  sk: "Tabuľka programov Whirlpool WIO 3O540 PELG"
};
---

<BaseLayout
  title={pageTitle}
  description={description}
  canonicalPath={guide.path}
  noindex={true}
  hideHeader={true}
  hideFooter={true}
>
  <style slot="head" is:global set:html={guidePageStyles}></style>
  <section class="guide-page" data-guide-page>
    <div class="guide-shell">
      <a
        class="guide-back"
        href={`/guide/${guide.houseSlug}/`}
        data-guide-label="back"
        data-back-label-hu={resolveContent("hu")?.backLabel ?? ""}
        data-back-label-en={resolveContent("en")?.backLabel ?? ""}
        data-back-label-cs={resolveContent("cs")?.backLabel ?? ""}
        data-back-label-de={resolveContent("de")?.backLabel ?? ""}
        data-back-label-sk={resolveContent("sk")?.backLabel ?? ""}
      >
        {resolveContent("hu")?.backLabel}
      </a>

      <header class="guide-hero">
        <p
          class="guide-eyebrow"
          data-guide-title-hu={localizedPageTitles.hu}
          data-guide-title-en={localizedPageTitles.en}
          data-guide-title-cs={localizedPageTitles.cs}
          data-guide-title-de={localizedPageTitles.de}
          data-guide-description-hu={resolveContent("hu")?.intro ?? ""}
          data-guide-description-en={resolveContent("en")?.intro ?? ""}
          data-guide-description-cs={resolveContent("cs")?.intro ?? ""}
          data-guide-description-de={resolveContent("de")?.intro ?? ""}
          data-guide-description-sk={resolveContent("sk")?.intro ?? ""}
        >
          QR vendégútmutató · {guide.houseName}
        </p>
        <div class="guide-language" aria-label="Guide language selector">
          {locales.map((locale) => (
            <button
              class="guide-language__button"
              type="button"
              data-guide-lang-button={locale}
              aria-pressed={locale === "hu" ? "true" : "false"}
            >
              {languageLabels[locale]}
            </button>
          ))}
        </div>

        {locales.map((locale) => (
          <div data-guide-lang-panel={locale} hidden={locale !== "hu"}>
            <h1>{localeContents[locale]?.title}</h1>
            <p>{localeContents[locale]?.intro}</p>
          </div>
        ))}
      </header>

      {locales.map((locale) => (
        <div data-guide-lang-panel={locale} hidden={locale !== "hu"}>
          {localeContents[locale]?.manualImageSrc ? (
            <article class="guide-manual">
              <div class="guide-manual__actions">
                <a
                  class="guide-manual__button"
                  href={localeContents[locale]?.manualPdfSrc}
                  target="_blank"
                  rel="noreferrer"
                >
                  {localeContents[locale]?.manualButtonLabel}
                </a>
                {localeContents[locale]?.manualFallbackNote && (
                  <p class="guide-manual__note">{localeContents[locale]?.manualFallbackNote}</p>
                )}
              </div>
              <figure class="guide-manual__figure">
                <img
                  class="guide-manual__image"
                  src={localeContents[locale]?.manualImageSrc}
                  alt={localeContents[locale]?.manualImageAlt ?? manualCaptionLabels[locale]}
                  loading="eager"
                />
                <figcaption>{manualCaptionLabels[locale]}</figcaption>
              </figure>
            </article>
          ) : (
            <>
              <section class="guide-important" aria-label={importantLabels[locale]}>
                <h2>{importantLabels[locale]}</h2>
                <ul>
                  {localeContents[locale]?.keyPoints.map((point) => (
                    <li>{point}</li>
                  ))}
                </ul>
              </section>

              <div class="guide-toc" aria-label={locale === "hu" ? "Tartalom" : locale === "en" ? "Contents" : "Obsah"}>
                <label for={`guide-toc-${locale}`}>{tocLabels[locale]}</label>
                <select id={`guide-toc-${locale}`} data-guide-toc-select={locale}>
                  <option value="">{tocPlaceholderLabels[locale]}</option>
                  {localeContents[locale]?.sections.map((section) => (
                    <option value={`${locale}-${section.id}`}>{section.title}</option>
                  ))}
                </select>
              </div>

              <article class="guide-content">
                <h2>{localeContents[locale]?.subtitle}</h2>
                {localeContents[locale]?.sections.map((section) => (
                  <section class="guide-section" id={`${locale}-${section.id}`}>
                    <h3>{section.title}</h3>
                    {section.paragraphs.map((paragraph) => (
                      <p>{paragraph}</p>
                    ))}
                    {section.bullets && (
                      <ul>
                        {section.bullets.map((bullet) => (
                          <li>{bullet}</li>
                        ))}
                      </ul>
                    )}
                    {section.steps && (
                      <ol>
                        {section.steps.map((step) => (
                          <li>{step}</li>
                        ))}
                      </ol>
                    )}
                    {section.important && <p class="guide-note">{section.important}</p>}
                  </section>
                ))}
              </article>
            </>
          )}
        </div>
      ))}
    </div>
  </section>

  <script>
    (() => {
      const root = document.querySelector("[data-guide-page]");
      if (!root) return;

      const buttons = root.querySelectorAll("[data-guide-lang-button]");
      const panels = root.querySelectorAll("[data-guide-lang-panel]");
      const tocSelects = root.querySelectorAll("[data-guide-toc-select]");
      const metaSource = root.querySelector(".guide-eyebrow");
      const descriptionMeta = document.querySelector("meta[name='description']");
      const backLink = root.querySelector("[data-guide-label='back']");
      const backLabels = {
        hu: backLink?.getAttribute("data-back-label-hu") || "",
        en: backLink?.getAttribute("data-back-label-en") || "",
        cs: backLink?.getAttribute("data-back-label-cs") || "",
        de: backLink?.getAttribute("data-back-label-de") || "",
        sk: backLink?.getAttribute("data-back-label-sk") || ""
      };

      const setLanguage = (nextLanguage) => {
        panels.forEach((panel) => {
          panel.hidden = panel.getAttribute("data-guide-lang-panel") !== nextLanguage;
        });

        buttons.forEach((button) => {
          button.setAttribute(
            "aria-pressed",
            button.getAttribute("data-guide-lang-button") === nextLanguage ? "true" : "false"
          );
        });

        if (backLink) {
          backLink.textContent = backLabels[nextLanguage] || backLabels.hu;
        }

        const localizedTitle = metaSource?.getAttribute(`data-guide-title-${nextLanguage}`);
        const localizedDescription = metaSource?.getAttribute(`data-guide-description-${nextLanguage}`);
        if (localizedTitle) document.title = localizedTitle;
        if (descriptionMeta && localizedDescription) {
          descriptionMeta.setAttribute("content", localizedDescription);
        }

        tocSelects.forEach((select) => {
          if (select instanceof HTMLSelectElement) {
            select.value = "";
          }
        });

        document.documentElement.lang = nextLanguage;
      };

      buttons.forEach((button) => {
        button.addEventListener("click", () => {
          const nextLanguage = button.getAttribute("data-guide-lang-button");
          if (nextLanguage) setLanguage(nextLanguage);
        });
      });

      tocSelects.forEach((select) => {
        select.addEventListener("change", () => {
          if (!(select instanceof HTMLSelectElement) || !select.value) {
            return;
          }

          const target = document.getElementById(select.value);
          if (target) {
            target.scrollIntoView({ behavior: "smooth", block: "start" });
          }
        });
      });
    })();
  </script>
</BaseLayout>
