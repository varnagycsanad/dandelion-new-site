---
import BaseLayout from "../layouts/BaseLayout.astro";
import type { GuideContent, GuideLocale } from "../data/guides/types";

const { guide } = Astro.props as { guide: GuideContent };
const locales: GuideLocale[] = ["hu", "en", "cs", "de"];
const pageTitle = `${guide.content.hu.title} | ${guide.houseName}`;
const description = guide.content.hu.intro;
const localizedPageTitles: Record<GuideLocale, string> = Object.fromEntries(
  locales.map((locale) => [locale, `${guide.content[locale].title} | ${guide.houseName}`])
) as Record<GuideLocale, string>;
const languageLabels: Record<GuideLocale, string> = { hu: "HU", en: "EN", cs: "CZ", de: "DE" };
const importantLabels: Record<GuideLocale, string> = { hu: "Fontos pontok", en: "Key points", cs: "D\u016fle\u017eit\u00e9 body", de: "Wichtige Punkte" };
const tocLabels: Record<GuideLocale, string> = { hu: "Ugr\u00e1s a ponthoz", en: "Jump to section", cs: "P\u0159ej\u00edt na sekci", de: "Zum Abschnitt springen" };
const tocPlaceholderLabels: Record<GuideLocale, string> = { hu: "V\u00e1lassz pontot", en: "Choose a section", cs: "Vyberte sekci", de: "Abschnitt w\u00e4hlen" };
---

<BaseLayout
  title={pageTitle}
  description={description}
  canonicalPath={guide.path}
  noindex={true}
  hideHeader={true}
  hideFooter={true}
>
  <section class="guide-page" data-guide-page>
    <div class="guide-shell">
      <a
        class="guide-back"
        href={`/guide/${guide.houseSlug}/`}
        data-guide-label="back"
        data-back-label-hu={guide.content.hu.backLabel}
        data-back-label-en={guide.content.en.backLabel}
        data-back-label-cs={guide.content.cs.backLabel}
        data-back-label-de={guide.content.de.backLabel}
      >
        {guide.content.hu.backLabel}
      </a>

      <header class="guide-hero">
        <p
          class="guide-eyebrow"
          data-guide-title-hu={localizedPageTitles.hu}
          data-guide-title-en={localizedPageTitles.en}
          data-guide-title-cs={localizedPageTitles.cs}
          data-guide-title-de={localizedPageTitles.de}
          data-guide-description-hu={guide.content.hu.intro}
          data-guide-description-en={guide.content.en.intro}
          data-guide-description-cs={guide.content.cs.intro}
          data-guide-description-de={guide.content.de.intro}
        >
          QR vendégútmutató · {guide.houseName}
        </p>
        <div class="guide-language" aria-label="Guide language selector">
          {locales.map((locale) => (
            <button
              class="guide-language__button"
              type="button"
              data-guide-lang-button={locale}
              aria-pressed={locale === "hu" ? "true" : "false"}
            >
              {languageLabels[locale]}
            </button>
          ))}
        </div>

        {locales.map((locale) => (
          <div data-guide-lang-panel={locale} hidden={locale !== "hu"}>
            <h1>{guide.content[locale].title}</h1>
            <p>{guide.content[locale].intro}</p>
          </div>
        ))}
      </header>

      {locales.map((locale) => (
        <div data-guide-lang-panel={locale} hidden={locale !== "hu"}>
          <section class="guide-important" aria-label={importantLabels[locale]}>
            <h2>{importantLabels[locale]}</h2>
            <ul>
              {guide.content[locale].keyPoints.map((point) => (
                <li>{point}</li>
              ))}
            </ul>
          </section>

          <div class="guide-toc" aria-label={locale === "hu" ? "Tartalom" : locale === "en" ? "Contents" : "Obsah"}>
            <label for={`guide-toc-${locale}`}>{tocLabels[locale]}</label>
            <select id={`guide-toc-${locale}`} data-guide-toc-select={locale}>
              <option value="">{tocPlaceholderLabels[locale]}</option>
              {guide.content[locale].sections.map((section) => (
                <option value={`${locale}-${section.id}`}>{section.title}</option>
              ))}
            </select>
          </div>

          <article class="guide-content">
            <h2>{guide.content[locale].subtitle}</h2>
            {guide.content[locale].sections.map((section) => (
              <section class="guide-section" id={`${locale}-${section.id}`}>
                <h3>{section.title}</h3>
                {section.paragraphs.map((paragraph) => (
                  <p>{paragraph}</p>
                ))}
                {section.bullets && (
                  <ul>
                    {section.bullets.map((bullet) => (
                      <li>{bullet}</li>
                    ))}
                  </ul>
                )}
                {section.steps && (
                  <ol>
                    {section.steps.map((step) => (
                      <li>{step}</li>
                    ))}
                  </ol>
                )}
                {section.important && <p class="guide-note">{section.important}</p>}
              </section>
            ))}
          </article>
        </div>
      ))}
    </div>
  </section>

  <script>
    (() => {
      const root = document.querySelector("[data-guide-page]");
      if (!root) return;

      const buttons = root.querySelectorAll("[data-guide-lang-button]");
      const panels = root.querySelectorAll("[data-guide-lang-panel]");
      const tocSelects = root.querySelectorAll("[data-guide-toc-select]");
      const metaSource = root.querySelector(".guide-eyebrow");
      const descriptionMeta = document.querySelector("meta[name='description']");
      const backLink = root.querySelector("[data-guide-label='back']");
      const backLabels = {
        hu: backLink?.getAttribute("data-back-label-hu") || "",
        en: backLink?.getAttribute("data-back-label-en") || "",
        cs: backLink?.getAttribute("data-back-label-cs") || "",
        de: backLink?.getAttribute("data-back-label-de") || ""
      };

      const setLanguage = (nextLanguage) => {
        panels.forEach((panel) => {
          panel.hidden = panel.getAttribute("data-guide-lang-panel") !== nextLanguage;
        });

        buttons.forEach((button) => {
          button.setAttribute(
            "aria-pressed",
            button.getAttribute("data-guide-lang-button") === nextLanguage ? "true" : "false"
          );
        });

        if (backLink) {
          backLink.textContent = backLabels[nextLanguage] || backLabels.hu;
        }

        const localizedTitle = metaSource?.getAttribute(`data-guide-title-${nextLanguage}`);
        const localizedDescription = metaSource?.getAttribute(`data-guide-description-${nextLanguage}`);
        if (localizedTitle) document.title = localizedTitle;
        if (descriptionMeta && localizedDescription) {
          descriptionMeta.setAttribute("content", localizedDescription);
        }

        tocSelects.forEach((select) => {
          if (select instanceof HTMLSelectElement) {
            select.value = "";
          }
        });

        document.documentElement.lang = nextLanguage;
      };

      buttons.forEach((button) => {
        button.addEventListener("click", () => {
          const nextLanguage = button.getAttribute("data-guide-lang-button");
          if (nextLanguage) setLanguage(nextLanguage);
        });
      });

      tocSelects.forEach((select) => {
        select.addEventListener("change", () => {
          if (!(select instanceof HTMLSelectElement) || !select.value) {
            return;
          }

          const target = document.getElementById(select.value);
          if (target) {
            target.scrollIntoView({ behavior: "smooth", block: "start" });
          }
        });
      });
    })();
  </script>
</BaseLayout>

<style>
  :global(body) {
    background: #fdfbf7;
  }

  .guide-page {
    min-height: 100vh;
    padding: 18px 0 48px;
    background: linear-gradient(180deg, #fff8ec 0%, #fdfbf7 42%, #ffffff 100%);
    color: #261d16;
  }

  .guide-shell {
    width: min(100% - 28px, 760px);
    margin: 0 auto;
  }

  .guide-back {
    display: inline-flex;
    align-items: center;
    min-height: 42px;
    margin-bottom: 18px;
    color: #5e4127;
    font-size: var(--dnd-text-sm);
    font-weight: 700;
    text-decoration: none;
  }

  .guide-back::before {
    content: "<";
    margin-right: 8px;
  }

  .guide-hero {
    display: grid;
    gap: 18px;
    padding: 24px 0 22px;
    border-bottom: 1px solid rgba(94, 65, 39, 0.16);
  }

  .guide-eyebrow {
    margin: 0;
    color: #9a6a1e;
    font-size: var(--dnd-text-xs);
    font-weight: 700;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .guide-language {
    display: flex;
    align-items: center;
    gap: 8px;
    width: 100%;
  }

  .guide-language__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 54px;
    min-height: 42px;
    border: 1px solid rgba(94, 65, 39, 0.18);
    border-radius: 8px;
    background: #fffefb;
    color: #5e4127;
    font-family: var(--dnd-font-body);
    font-size: var(--dnd-text-xs);
    font-weight: 700;
    letter-spacing: 0;
  }

  .guide-language__button[aria-pressed="true"] {
    border-color: #d99e2b;
    background: #d99e2b;
    color: #1b140f;
  }

  .guide-hero h1 {
    margin: 0;
    max-width: 28ch;
    font-family: var(--dnd-font-display);
    font-size: clamp(1.2rem, 5.4vw, 1.9rem);
    font-weight: 400;
    line-height: 1.16;
    letter-spacing: 0.03em;
    text-align: center;
    text-transform: uppercase;
  }

  .guide-hero p {
    margin: 14px 0 0;
    color: rgba(38, 29, 22, 0.78);
    font-size: var(--dnd-text-base);
    line-height: 1.58;
  }

  .guide-important {
    margin: 18px 0;
    padding: 12px;
    border: 1px solid rgba(217, 158, 43, 0.34);
    border-radius: 8px;
    background: #fff7e5;
  }

  .guide-important h2,
  .guide-content h2 {
    margin: 0 0 12px;
    font-size: clamp(1rem, 4.2vw, 1.22rem);
    line-height: 1.18;
  }

  .guide-important ul {
    display: grid;
    gap: 5px;
    margin: 0;
    padding-left: 18px;
  }

  .guide-important li {
    font-size: var(--dnd-text-xs);
    line-height: 1.5;
  }

  .guide-toc {
    display: grid;
    gap: 8px;
    margin: 0 0 26px;
    padding: 14px;
    border: 1px solid rgba(94, 65, 39, 0.14);
    border-radius: 8px;
    background: #fffefb;
  }

  .guide-toc label {
    color: rgba(38, 29, 22, 0.68);
    font-size: var(--dnd-text-xs);
    font-weight: 700;
    line-height: 1.35;
  }

  .guide-toc select {
    width: 100%;
    min-height: 48px;
    padding: 0 38px 0 12px;
    border: 1px solid rgba(94, 65, 39, 0.14);
    border-radius: 8px;
    background: #fffefb;
    color: #3a2b1f;
    font-family: var(--dnd-font-body);
    font-size: var(--dnd-text-xs);
    font-weight: 700;
    line-height: 1.4;
  }

  .guide-content {
    display: grid;
    gap: 12px;
  }

  .guide-section {
    padding: 18px 0;
    border-top: 1px solid rgba(94, 65, 39, 0.14);
  }

  .guide-section h3 {
    margin: 0 0 10px;
    font-size: clamp(1rem, 4vw, 1.16rem);
    line-height: 1.24;
  }

  .guide-section p {
    margin: 0 0 10px;
    color: rgba(38, 29, 22, 0.82);
    font-size: var(--dnd-text-sm);
    line-height: 1.58;
  }

  .guide-section ol {
    display: grid;
    gap: 6px;
    margin: 10px 0;
    padding-left: 20px;
  }

  .guide-section ul {
    display: grid;
    gap: 6px;
    margin: 10px 0;
    padding-left: 20px;
  }

  .guide-section li {
    font-size: var(--dnd-text-sm);
    line-height: 1.55;
  }

  .guide-note {
    margin-top: 12px;
    padding: 12px;
    border-left: 4px solid #d99e2b;
    border-radius: 0 8px 8px 0;
    background: #fff7e5;
    color: #261d16;
    font-size: var(--dnd-text-sm);
    font-weight: 700;
  }

  @media (min-width: 760px) {
    .guide-page {
      padding-top: 34px;
    }

    .guide-hero {
      grid-template-columns: 1fr auto;
      align-items: start;
    }

    .guide-language {
      justify-content: flex-end;
    }

    .guide-hero [data-guide-lang-panel] {
      grid-column: 1 / -1;
    }
  }
</style>
