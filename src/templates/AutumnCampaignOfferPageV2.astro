---
import BaseLayout from "../layouts/BaseLayout.astro";
import type { AutumnCampaignFeatureIconKey, AutumnCampaignOffer } from "../data/offers/types";
import type { AutumnCampaignLang } from "../data/offers/autumn-2026-localized";
import { toAbsoluteUrl } from "../data/site-seo";
import CampaignMedia from "../components/campaign/CampaignMedia.astro";
import CampaignHeroVideo from "../components/campaign/CampaignHeroVideo.astro";

const { offer, lang = "hu" } = Astro.props as { offer: AutumnCampaignOffer; lang?: AutumnCampaignLang };
const storyTiles = offer.storyTiles.slice(0, 3);
const wideStoryTile = offer.storyTiles[3];
const heroImage = offer.campaignHero.media.desktop;
const pageUiByLang = {
  hu: {
    benefitsAria: "Közvetlen foglalás előnyei", benefitsKicker: "Közvetlen foglalás", benefitsTitle: "Megéri itt foglalni", benefitsLead: "A közvetlen foglalás előnyei:", benefitsSummary: "Legjobb árak és azonnali bankkártyás fizetés a honlapon.",
    heroBenefits: ["A legjobb árakat a honlapon való foglalással éred el", "Azonnali bankkártyás fizetés", "Gyors, átlátható foglalási folyamat", "Közvetlen kapcsolat a szállásadóval", "Rugalmas ügyintézés"],
    featuresAria: "Szolgáltatások és élmények", storiesAria: "Élmények", featuredAria: "Kiemelt élmény", contactLabel: "ÍRÁSBAN ÉRDEKLŐDÖM", whatsappLabel: "WHATSAPP", homeLabel: "Főoldal"
  },
  en: {
    benefitsAria: "Direct booking benefits", benefitsKicker: "Direct booking", benefitsTitle: "Booking direct is worth it", benefitsLead: "The benefits of booking direct:", benefitsSummary: "Best rates and instant card payment on our website.",
    heroBenefits: ["You get the best rates when booking on our website", "Instant card payment", "Fast, transparent booking process", "Direct contact with your host", "Flexible assistance"],
    featuresAria: "Services and experiences", storiesAria: "Experiences", featuredAria: "Featured experience", contactLabel: "ENQUIRE IN WRITING", whatsappLabel: "WHATSAPP", homeLabel: "Home"
  },
  de: {
    benefitsAria: "Vorteile der Direktbuchung", benefitsKicker: "Direktbuchung", benefitsTitle: "Direkt buchen lohnt sich", benefitsLead: "Die Vorteile einer Direktbuchung:", benefitsSummary: "Beste Preise und sofortige Kartenzahlung über unsere Website.",
    heroBenefits: ["Die besten Preise erhalten Sie bei einer Buchung über unsere Website", "Sofortige Kartenzahlung", "Schneller, transparenter Buchungsablauf", "Direkter Kontakt mit dem Gastgeber", "Flexible Abwicklung"],
    featuresAria: "Services und Erlebnisse", storiesAria: "Erlebnisse", featuredAria: "Hervorgehobenes Erlebnis", contactLabel: "SCHRIFTLICH ANFRAGEN", whatsappLabel: "WHATSAPP", homeLabel: "Startseite"
  },
  cs: {
    benefitsAria: "Výhody přímé rezervace", benefitsKicker: "Přímá rezervace", benefitsTitle: "Přímá rezervace se vyplatí", benefitsLead: "Výhody přímé rezervace:", benefitsSummary: "Nejlepší ceny a okamžitá platba kartou na našem webu.",
    heroBenefits: ["Nejlepší ceny získáte rezervací přímo na našem webu", "Okamžitá platba kartou", "Rychlý a přehledný rezervační proces", "Přímý kontakt s hostitelem", "Flexibilní vyřízení"],
    featuresAria: "Služby a zážitky", storiesAria: "Zážitky", featuredAria: "Doporučený zážitek", contactLabel: "NAPSAT DOTAZ", whatsappLabel: "WHATSAPP", homeLabel: "Úvod"
  },
  sk: {
    benefitsAria: "Výhody priamej rezervácie", benefitsKicker: "Priama rezervácia", benefitsTitle: "Priama rezervácia sa oplatí", benefitsLead: "Výhody priamej rezervácie:", benefitsSummary: "Najlepšie ceny a okamžitá platba kartou na našom webe.",
    heroBenefits: ["Najlepšie ceny získate rezerváciou na našom webe", "Okamžitá platba kartou", "Rýchly a prehľadný rezervačný proces", "Priamy kontakt s hostiteľom", "Flexibilné vybavenie"],
    featuresAria: "Služby a zážitky", storiesAria: "Zážitky", featuredAria: "Odporúčaný zážitok", contactLabel: "NAPÍSAŤ DOPYT", whatsappLabel: "WHATSAPP", homeLabel: "Úvod"
  }
} as const;
const pageUi = pageUiByLang[lang];
const contactHrefByLang: Record<AutumnCampaignLang, string> = {
  hu: "/kapcsolat/",
  en: "/en/contact/",
  de: "/de/kontakt/",
  cs: "/cs/kontakt/",
  sk: "/sk/kontakt/"
};
const contactHref = contactHrefByLang[lang];
const heroBookingBenefits = pageUi.heroBenefits;
const localizedBookingHref = lang === "hu" ? offer.bookingUrl : offer.bookingUrl.replace(/lang=Hu\b/i, "lang=En");
const bookingTrackingAttrs = {
  "data-dnd-property": offer.tracking.property,
  "data-dnd-campaign": offer.tracking.campaign,
  "data-dnd-offer": offer.tracking.offerId
};
const contactTrackingAttrs = {
  "data-dnd-placement": "direct-booking",
  "data-dnd-cta-type": "contact",
  ...bookingTrackingAttrs
};
const whatsappTrackingAttrs = {
  "data-dnd-placement": "direct-booking",
  "data-dnd-cta-type": "whatsapp",
  ...bookingTrackingAttrs
};
const themeStyle = [
  `--v2-accent:${offer.theme.accent}`,
  `--v2-accent-strong:${offer.theme.accentStrong}`,
  `--v2-direct:${offer.theme.directSurface}`,
  "--v2-shell:1480px"
].join(";");

type IconDefinition = {
  viewBox: string;
  paths?: string[];
  circles?: string[];
  rects?: string[];
  text?: string;
};

const icons: Record<AutumnCampaignFeatureIconKey | "climate" | "smokeFree" | "petFriendly" | "noPets", IconDefinition> = {
  pool: {
    viewBox: "0 0 24 24",
    paths: [
      "M4 15c1.2 0 1.2-1 2.4-1s1.2 1 2.4 1 1.2-1 2.4-1 1.2 1 2.4 1 1.2-1 2.4-1 1.2 1 2.4 1 1.2-1 2.4-1",
      "M4 19c1.2 0 1.2-1 2.4-1s1.2 1 2.4 1 1.2-1 2.4-1 1.2 1 2.4 1 1.2-1 2.4-1 1.2 1 2.4 1",
      "M8 9a4 4 0 1 1 8 0"
    ]
  },
  fireplace: {
    viewBox: "0 0 24 24",
    rects: ["6 4 12 15 2"],
    paths: ["M12 17c-2.2-1.3-2.7-3.6-1.5-5.2.5.6 1.1 1 1.5 1.7.3-.9.9-1.6 1.8-2.2.8 1 1.2 2 1.2 3.2 0 1.6-.9 3-3 4.5Z", "M9 21h6"]
  },
  wine: {
    viewBox: "0 0 24 24",
    paths: ["M8 4h8v3a4 4 0 0 1-8 0V4Z", "M12 11v7", "M9 20h6"]
  },
  firepit: {
    viewBox: "0 0 24 24",
    paths: ["M12 5c1.6 1.4 2.5 3 2.5 4.8A3.5 3.5 0 0 1 11 13.2c-.8-.8-1.2-1.8-1.2-2.9 0-1.7.9-3.4 2.2-5.3Z", "M6 18h12", "M8 21l8-6", "M8 15l8 6"]
  },
  bike: {
    viewBox: "0 0 24 24",
    circles: ["6.5 16.5 3.5", "17.5 16.5 3.5"],
    paths: ["M9 8h3l2 4h3", "M9 8l-2.5 8.5", "M12 8l5.5 8.5", "M10 12h5"]
  },
  romance: {
    viewBox: "0 0 24 24",
    paths: ["M12 20s-6.8-4.2-6.8-9.2A3.8 3.8 0 0 1 9 7a4 4 0 0 1 3 1.4A4 4 0 0 1 15 7a3.8 3.8 0 0 1 3.8 3.8C18.8 15.8 12 20 12 20Z"]
  },
  family: {
    viewBox: "0 0 24 24",
    circles: ["9 9 2.3", "15.5 9.5 1.9"],
    paths: ["M5.5 19a3.8 3.8 0 0 1 7.5 0", "M13 19a3.1 3.1 0 0 1 5.5 0", "M4 11.5 12 5l8 6.5"]
  },
  grill: {
    viewBox: "0 0 24 24",
    rects: ["6 9 12 6 2"],
    paths: ["M9 15l-1.5 5", "M15 15l1.5 5", "M10 5c0 1-1 1.4-1 2.4", "M13 4c0 1.1-1 1.6-1 2.7", "M16 5c0 1-.9 1.4-.9 2.4"]
  },
  wifi: {
    viewBox: "0 0 24 24",
    paths: ["M4.5 9.5a11 11 0 0 1 15 0", "M7.5 12.5a7 7 0 0 1 9 0", "M10.5 15.5a3 3 0 0 1 3 0"],
    circles: ["12 19 1"]
  },
  parking: {
    viewBox: "0 0 24 24",
    rects: ["5 4 14 16 3"],
    text: "P"
  },
  climate: {
    viewBox: "0 0 24 24",
    circles: ["12 12 2.6"],
    paths: ["M12 3v3", "M12 18v3", "M4.8 7.2l2.1 2.1", "M17.1 14.7l2.1 2.1", "M3 12h3", "M18 12h3", "M4.8 16.8l2.1-2.1", "M17.1 9.3l2.1-2.1"]
  },
  smokeFree: {
    viewBox: "0 0 24 24",
    circles: ["12 12 8.5"],
    paths: ["M8 8l8 8", "M7 15h6", "M15 15h2", "M16 12.5c0-1-1-1.5-1-2.5"]
  },
  petFriendly: {
    viewBox: "0 0 24 24",
    circles: ["8 9 1.6", "12 7.2 1.6", "16 9 1.6"],
    paths: ["M8.5 16.5c1-1.7 2.3-2.5 3.5-2.5s2.5.8 3.5 2.5c0 1.8-1.5 3-3.5 3s-3.5-1.2-3.5-3Z"]
  },
  noPets: {
    viewBox: "0 0 24 24",
    circles: ["8 9 1.6", "12 7.2 1.6", "16 9 1.6", "12 12 8.5"],
    paths: ["M8.5 16.5c1-1.7 2.3-2.5 3.5-2.5s2.5.8 3.5 2.5c0 1.8-1.5 3-3.5 3s-3.5-1.2-3.5-3Z", "M7 17l10-10"]
  }
};

function amenityIcon(item: string): IconDefinition {
  const normalized = item.toLowerCase();
  if (normalized.includes("wifi")) return icons.wifi;
  if (normalized.includes("parkol")) return icons.parking;
  if (normalized.includes("légkond")) return icons.climate;
  if (normalized.includes("család")) return icons.family;
  if (normalized.includes("nemdohány")) return icons.smokeFree;
  if (normalized.includes("nem hozható")) return icons.noPets;
  if (normalized.includes("engedélyezett")) return icons.petFriendly;
  return icons.wifi;
}

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: pageUi.homeLabel, item: toAbsoluteUrl(lang === "hu" ? "/" : `/${lang}/`) },
      { "@type": "ListItem", position: 2, name: offer.hero.title, item: toAbsoluteUrl(offer.routePath) }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${toAbsoluteUrl(offer.routePath)}#webpage`,
    url: toAbsoluteUrl(offer.routePath),
    name: offer.seo.title,
    description: offer.seo.description,
    inLanguage: lang === "hu" ? "hu-HU" : lang === "en" ? "en-US" : lang === "de" ? "de-DE" : lang === "cs" ? "cs-CZ" : "sk-SK",
    isPartOf: { "@id": `${toAbsoluteUrl("/")}#website` }
  }
];
---

<BaseLayout
  title={offer.seo.title}
  description={offer.seo.description}
  canonicalPath={offer.routePath}
  ogImage={heroImage.src}
  ogImageAlt={heroImage.alt}
  noindex={true}
  structuredData={structuredData}
  headerMode="transparent"
  bookingHrefOverride={localizedBookingHref}
  lang={lang}
>
  <Fragment slot="head">
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&display=swap" />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&display=swap" rel="stylesheet" media="print" onload="this.media='all'" />
    <noscript>
      <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&display=swap" rel="stylesheet" />
    </noscript>
  </Fragment>

  <main class="autumn-v2" style={themeStyle}>
    <section class="autumn-v2__hero">
      {offer.campaignHero.video ? (
        <CampaignHeroVideo media={offer.campaignHero.video} class="autumn-v2__hero-media" fill={true} />
      ) : (
        <CampaignMedia
          media={offer.campaignHero.media}
          class="autumn-v2__hero-media"
          fill={true}
          loading="eager"
          fetchpriority="high"
          replacementLabel={offer.mediaReplacementLabel}
        />
      )}
      <div class="autumn-v2__hero-shade" aria-hidden="true"></div>
      <div class="autumn-v2__hero-content dnd-container">
        <div class="autumn-v2__hero-copy">
          <p class="autumn-v2__eyebrow">{offer.campaignHero.kicker}</p>
          <h1>
            {offer.campaignHero.titleLines.map((line) => <span>{line}</span>)}
          </h1>
          {offer.campaignHero.supportLine && <p class="autumn-v2__hero-support">{offer.campaignHero.supportLine}</p>}
          <div class="autumn-v2__hero-lead">
            {offer.campaignHero.descriptionLines.map((line) => <p>{line}</p>)}
          </div>
          <a href={localizedBookingHref} class="autumn-v2__button autumn-v2__button--hero" target="_blank" rel="noopener noreferrer" data-dnd-placement="hero" {...bookingTrackingAttrs}>
            {offer.ctas.primary}<span aria-hidden="true">→</span>
          </a>
          <p class="autumn-v2__hero-note">{offer.campaignHero.ctaNote}</p>
        </div>
        <aside class="autumn-v2__hero-benefits" aria-label={pageUi.benefitsAria}>
          <span class="autumn-v2__hero-benefits-kicker">{pageUi.benefitsKicker}</span>
          <h2>{pageUi.benefitsTitle}</h2>
          <p class="autumn-v2__hero-benefits-lead">{pageUi.benefitsLead}</p>
          <p class="autumn-v2__hero-benefits-summary">{pageUi.benefitsSummary}</p>
          <ul>
            {heroBookingBenefits.map((benefit) => <li>{benefit}</li>)}
          </ul>
        </aside>
      </div>
    </section>

    <section class="autumn-v2__features" aria-label={pageUi.featuresAria}>
      <div class="autumn-v2__feature-inner dnd-container">
        {offer.experienceItems.map((item) => {
          const icon = icons[item.icon];
          return (
            <article class="autumn-v2__feature">
              <span class="autumn-v2__feature-icon" aria-hidden="true">
                <svg viewBox={icon.viewBox} fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                  {icon.paths?.map((path) => <path d={path}></path>)}
                  {icon.circles?.map((circle) => { const [cx, cy, r] = circle.split(" "); return <circle cx={cx} cy={cy} r={r}></circle>; })}
                  {icon.rects?.map((rect) => { const [x, y, width, height, rx] = rect.split(" "); return <rect x={x} y={y} width={width} height={height} rx={rx}></rect>; })}
                  {icon.text && <text x="12" y="16" text-anchor="middle" font-size="10" font-family="inherit" fill="currentColor" stroke="none">{icon.text}</text>}
                </svg>
              </span>
              <h2>{item.title}</h2>
              <p>{item.details.join(" ")}</p>
              {item.note && <small>{item.note}</small>}
            </article>
          );
        })}
      </div>
    </section>

    <section class="autumn-v2__stories" aria-label={pageUi.storiesAria}>
      <div class="autumn-v2__story-grid">
        {storyTiles.map((tile) => (
          <article class="autumn-v2__story">
            <CampaignMedia media={tile.media} class="autumn-v2__story-media" fill={true} replacementLabel={offer.mediaReplacementLabel} />
            <div class="autumn-v2__story-shade" aria-hidden="true"></div>
            <div class="autumn-v2__story-copy">{tile.titleLines.map((line) => <span>{line}</span>)}</div>
          </article>
        ))}
      </div>
    </section>

    {wideStoryTile && (
      <section class="autumn-v2__wide-story" aria-label={pageUi.featuredAria}>
        <CampaignMedia media={wideStoryTile.media} class="autumn-v2__wide-media" fill={true} replacementLabel={offer.mediaReplacementLabel} />
        <div class="autumn-v2__wide-shade" aria-hidden="true"></div>
        <div class="autumn-v2__wide-copy">{wideStoryTile.titleLines.map((line) => <span>{line}</span>)}</div>
      </section>
    )}

    <section class="autumn-v2__programs">
      <div class="autumn-v2__program-inner dnd-container">
        <div class="autumn-v2__section-heading">
          <h2>{offer.programsSection.title}</h2>
          <p>{offer.programsSection.description}</p>
        </div>
        <div class="autumn-v2__program-grid">
          {offer.programsSection.cards.map((card) => (
            <a href={card.href} class="autumn-v2__program">
              <CampaignMedia media={card.media} class="autumn-v2__program-media" replacementLabel={offer.mediaReplacementLabel} />
              <h3>{card.title}</h3>
              <p>{card.description}</p>
            </a>
          ))}
        </div>
        <a href={offer.programsSection.ctaHref} class="autumn-v2__outline-button">{offer.programsSection.ctaLabel}<span aria-hidden="true">→</span></a>
      </div>
    </section>

    <section class="autumn-v2__closing">
      <article class="autumn-v2__closing-panel">
        <div class="autumn-v2__closing-main">
          <div class="autumn-v2__closing-copy">
            <p class="autumn-v2__eyebrow">{offer.directBooking.eyebrow}</p>
            <h2>{offer.directBooking.titleLines.map((line) => <span>{line}</span>)}</h2>
            <p class="autumn-v2__closing-message">{offer.directBooking.primaryMessage}</p>
            <div class="autumn-v2__closing-offer">
              <div class="autumn-v2__discount">
                <strong>{offer.directBooking.highlightValue}</strong>
                <span>{offer.directBooking.highlightLines.join(" ")}</span>
              </div>
              <ul>
                {offer.directBooking.benefits.slice(0, 3).map((benefit) => <li>{benefit}</li>)}
              </ul>
            </div>
          </div>
          {offer.directBooking.media && (
            <CampaignMedia media={offer.directBooking.media} class="autumn-v2__closing-media" replacementLabel={offer.mediaReplacementLabel} />
          )}
        </div>
        <div class="autumn-v2__closing-ctas">
          <a href={localizedBookingHref} class="autumn-v2__button autumn-v2__button--booking" target="_blank" rel="noopener noreferrer" data-dnd-placement="direct-booking" {...bookingTrackingAttrs}>
            {offer.ctas.primary}<span aria-hidden="true">→</span>
          </a>
          <a href={contactHref} class="autumn-v2__button autumn-v2__button--secondary" {...contactTrackingAttrs}>{pageUi.contactLabel}</a>
          <a href="https://wa.me/36207730807" class="autumn-v2__button autumn-v2__button--secondary" target="_blank" rel="noopener noreferrer" {...whatsappTrackingAttrs}>
            <span class="autumn-v2__whatsapp-icon" aria-hidden="true">◔</span> {pageUi.whatsappLabel}
          </a>
        </div>
        <div class="autumn-v2__amenities">
          <ul>
            {offer.practicalAmenities.items.map((item) => {
              const icon = amenityIcon(item);
              return (
                <li>
                  <span class="autumn-v2__amenity-icon" aria-hidden="true">
                    <svg viewBox={icon.viewBox} fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                      {icon.paths?.map((path) => <path d={path}></path>)}
                      {icon.circles?.map((circle) => { const [cx, cy, r] = circle.split(" "); return <circle cx={cx} cy={cy} r={r}></circle>; })}
                      {icon.rects?.map((rect) => { const [x, y, width, height, rx] = rect.split(" "); return <rect x={x} y={y} width={width} height={height} rx={rx}></rect>; })}
                      {icon.text && <text x="12" y="16" text-anchor="middle" font-size="10" font-family="inherit" fill="currentColor" stroke="none">{icon.text}</text>}
                    </svg>
                  </span>
                  {item}
                </li>
              );
            })}
          </ul>
          <p>{offer.practicalAmenities.supportLabel}: {offer.practicalAmenities.supportItems?.join(", ")}</p>
        </div>
      </article>
    </section>
  </main>
</BaseLayout>

<style>
  .autumn-v2 {
    --v2-body: "Poppins", sans-serif;
    --v2-display: "Cormorant Garamond", serif;
    overflow: hidden;
    background: #fdfbf7;
    color: #17130e;
    font-family: var(--v2-body);
  }

  .autumn-v2 :global(.dnd-container) {
    width: min(100% - 56px, var(--v2-shell));
  }

  .autumn-v2__hero {
    position: relative;
    min-height: min(740px, 82svh);
    color: #fffaf0;
  }

  .autumn-v2__hero-media,
  .autumn-v2__hero-media :global(.campaign-media__picture),
  .autumn-v2__hero-media :global(.campaign-media__image) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .autumn-v2__hero-media :global(.campaign-media__image) {
    object-position: center;
  }

  .autumn-v2__hero-shade,
  .autumn-v2__story-shade,
  .autumn-v2__wide-shade {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .autumn-v2__hero-shade {
    background: linear-gradient(90deg, rgba(17, 12, 7, 0.62), rgba(17, 12, 7, 0.12) 65%, rgba(17, 12, 7, 0.04));
  }

  .autumn-v2__hero-content {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    min-height: min(740px, 82svh);
    padding-top: 112px;
    padding-bottom: 48px;
  }

  .autumn-v2__hero-copy {
    max-width: 620px;
  }

  .autumn-v2__hero-benefits {
    position: absolute;
    right: clamp(24px, 6vw, 88px);
    bottom: 40px;
    z-index: 2;
    width: min(348px, 100%);
    padding: 24px 26px 22px;
    overflow: hidden;
    border: 1px solid rgba(255, 247, 216, 0.72);
    border-radius: 20px;
    background:
      linear-gradient(135deg, rgba(255, 247, 215, 0.96) 0%, rgba(244, 210, 119, 0.97) 58%, rgba(211, 161, 55, 0.96) 100%);
    color: #2d241c;
    box-shadow: 0 18px 44px rgba(16, 13, 8, 0.28), inset 0 1px 0 rgba(255, 255, 255, 0.34);
    backdrop-filter: blur(8px);
  }

  .autumn-v2__hero-benefits::before {
    content: "";
    position: absolute;
    inset: 0 auto 0 0;
    width: 4px;
    background: rgba(112, 75, 18, 0.64);
  }

  .autumn-v2__hero-benefits-kicker {
