<script>
  const priceTrigger = document.querySelector(".autumn-multi__hero-value");
  const priceDialog = document.querySelector("#autumn-price-dialog");
  const priceDialogClose = priceDialog?.querySelector("[data-close-price-dialog]");
  const mobilePriceQuery = window.matchMedia("(max-width: 700px)");

  const closePriceDialog = () => {
    if (!(priceDialog instanceof HTMLDialogElement) || !priceDialog.open) return;
    priceDialog.close();
    priceTrigger?.setAttribute("aria-expanded", "false");
  };

  const openPriceDialog = () => {
    if (!mobilePriceQuery.matches || !(priceDialog instanceof HTMLDialogElement)) return;
    priceDialog.showModal();
    priceTrigger?.setAttribute("aria-expanded", "true");
  };

  priceTrigger?.addEventListener("click", openPriceDialog);
  priceTrigger?.addEventListener("keydown", (event) => {
    if (event.key !== "Enter" && event.key !== " ") return;
    event.preventDefault();
    openPriceDialog();
  });
  priceDialogClose?.addEventListener("click", closePriceDialog);
  priceDialog?.addEventListener("click", (event) => {
    if (event.target === priceDialog) closePriceDialog();
  });
  priceDialog?.addEventListener("close", () => {
    priceTrigger?.setAttribute("aria-expanded", "false");
  });

  const draggableBookingBadge = document.querySelector("[data-draggable-booking-badge]");
  const draggableBadgeQuery = window.matchMedia("(max-width: 700px)");
  let badgeDragging = false;
  let badgeMoved = false;
  let badgePointerId = null;
  let badgeOffsetX = 0;
  let badgeOffsetY = 0;
  let badgeStartX = 0;
  let badgeStartY = 0;

  const clampBadgePosition = (value, min, max) => Math.min(Math.max(value, min), Math.max(min, max));

  if (draggableBookingBadge instanceof HTMLAnchorElement) {
    draggableBookingBadge.addEventListener("pointerdown", (event) => {
      if (!draggableBadgeQuery.matches || (event.pointerType === "mouse" && event.button !== 0)) return;
      event.preventDefault();
      const badgeRect = draggableBookingBadge.getBoundingClientRect();
      const containerRect = draggableBookingBadge.offsetParent?.getBoundingClientRect();
      if (!containerRect) return;
      badgeDragging = true;
      badgeMoved = false;
      badgePointerId = event.pointerId;
      badgeStartX = event.clientX;
      badgeStartY = event.clientY;
      badgeOffsetX = event.clientX - badgeRect.left;
      badgeOffsetY = event.clientY - badgeRect.top;
      draggableBookingBadge.classList.add("is-dragging");
      draggableBookingBadge.setPointerCapture(event.pointerId);
    });

    draggableBookingBadge.addEventListener("pointermove", (event) => {
      if (!badgeDragging || event.pointerId !== badgePointerId) return;
      event.preventDefault();
      if (Math.hypot(event.clientX - badgeStartX, event.clientY - badgeStartY) > 4) badgeMoved = true;
      if (!badgeMoved) return;
      const containerRect = draggableBookingBadge.offsetParent?.getBoundingClientRect();
      const badgeRect = draggableBookingBadge.getBoundingClientRect();
      if (!containerRect) return;
      const left = clampBadgePosition(event.clientX - containerRect.left - badgeOffsetX, 8, containerRect.width - badgeRect.width - 8);
      const top = clampBadgePosition(event.clientY - containerRect.top - badgeOffsetY, 8, containerRect.height - badgeRect.height - 8);
      draggableBookingBadge.style.left = `${left}px`;
      draggableBookingBadge.style.top = `${top}px`;
      draggableBookingBadge.style.right = "auto";
      draggableBookingBadge.style.bottom = "auto";
    });

    const finishBadgeDrag = (event) => {
      if (!badgeDragging || event.pointerId !== badgePointerId) return;
      badgeDragging = false;
      draggableBookingBadge.classList.remove("is-dragging");
      if (draggableBookingBadge.hasPointerCapture(event.pointerId)) draggableBookingBadge.releasePointerCapture(event.pointerId);
    };

    draggableBookingBadge.addEventListener("pointerup", finishBadgeDrag);
    draggableBookingBadge.addEventListener("pointercancel", finishBadgeDrag);
    draggableBookingBadge.addEventListener("click", (event) => {
      if (!badgeMoved) return;
      event.preventDefault();
      event.stopPropagation();
      badgeMoved = false;
    });
  }
</script>
