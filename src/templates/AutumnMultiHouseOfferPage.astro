---
import BaseLayout from "../layouts/BaseLayout.astro";
import CampaignMedia from "../components/campaign/CampaignMedia.astro";
import CampaignHeroVideo from "../components/campaign/CampaignHeroVideo.astro";
import type { AutumnCampaignOffer } from "../data/offers/types";
import { toAbsoluteUrl } from "../data/site-seo";
import { autumnMultiHouseByAudience } from "../data/offers/autumn-multihouse";

const { offer } = Astro.props as { offer: AutumnCampaignOffer };
const audience = offer.tracking.audience === "family" ? "family" : "couple";
const houses = autumnMultiHouseByAudience[audience];
const moodImages = offer.storyTiles.slice(0, 3).map((tile) => tile.media.desktop.src);
const heroImage = offer.campaignHero.media.desktop;
const bookingHref = offer.bookingUrl;
const pageTitle = audience === "family"
  ? "Őszi családi pihenés a Balaton-felvidéken | Dandelion Vendégházak"
  : "Őszi kettesben a Balaton-felvidéken | Dandelion Vendégházak";
const pageDescription = audience === "family"
  ? "Őszi Dandelion-élmény családoknak: közös terek, kert, grillezés és kilenc különböző ház a megfelelő pihenés kiválasztásához."
  : "Őszi Dandelion-élmény pároknak: panoráma, kandalló, borvidéki lassulás és kilenc különböző ház a hozzátok illő pihenés kiválasztásához.";
const heroLead = audience === "family"
  ? ["Vendégeskedjetek családotokkal a Balaton-felvidéki Dandelion-házakban,", "és legyen örök élmény a közös pihenés!"]
  : ["Lassítsatok le. Kapcsoljatok ki.", "Válasszátok ki a hozzátok illő Dandelion-házat."];
const moodCards = audience === "family"
  ? [
      { label: "KÖZÖS RITMUS", title: ["Közös terek,", "közös ritmus."], copy: "Együtt lehet lenni úgy, hogy mindenkinek jut saját helye.", image: moodImages[0] },
      { label: "ESŐS NAPOK", title: ["A rossz idő", "nem programvége."], copy: "Kandalló, beltéri terek és közös vacsorák.", image: moodImages[1] },
      { label: "KINT", title: ["Kert, grillezés,", "tűzrakás."], copy: "A gyerekeknek mozgás, a felnőtteknek nyugodt este.", image: moodImages[2] }
    ]
  : [
      { label: "PANORÁMA", title: ["Reggel másképp", "indul a nap."], copy: "Panoráma, terasz, csend.", image: moodImages[0] },
      { label: "MEGHITTSÉG", title: ["Hideg kint.", "Meleg bent."], copy: "Kandalló, saját tér, meghitt esték.", image: moodImages[1] },
      { label: "BORVIDÉK", title: ["Egy pohár bor.", "Egy hosszú este."], copy: "Borászatok, lassú délutánok, közös beszélgetések.", image: moodImages[2] }
    ];
const selectionBullets = audience === "family"
  ? [
      "Nagyobb közös térhez elsőként a Dandelion D2 és a Dandelion Szépvölgyi kártyáit érdemes megnézni.",
      "A közös beltéri programok ugyanúgy működhetnek, mint a kerti napok — a rossz idő sem állítja meg a pihenést.",
      "A Köveskál, a Vintage vagy a Szőlőliget jó kiindulópont lehet kirándulásokhoz és csendes családi pihenéshez."
    ]
  : [
      "Borozás: fedezzétek fel a környék helyi borászatait, és kóstoljatok együtt a Balaton-felvidék hangulatában.",
      "Biciklizés: nálunk biciklit is bérelhettek, és indulhat a kaland a balatoni bicikliúton.",
      "Kirándulás és aktív időtöltés a Balaton-felvidék tájain.",
      "Romantikus séta a Tapolcai Malom-tónál.",
      "Badacsonyi őszi hangulat, panoráma és bor a hegyoldaláról.",
      "Lazulás a szeptember végéig nyitva tartó medencében.",
      "Pezsgő- és virágbekészítés kérésre.",
      "A Szent György-hegy bazaltorgonái.",
      "Különleges vacsora a Taberna Infinitó balatoni panorámaéttermében, a Szent György-hegyen.",
      "Csodálatos kilátás a Szent György-hegyről a Balatonra, a Szigligeti-hegyekre és Badacsonyra.",
      "A Folly Arborétum és a keszthelyi Festetics-kastély felfedezése."
    ];
const bookingTrackingAttrs = {
  "data-dnd-property": offer.tracking.property,
  "data-dnd-campaign": offer.tracking.campaign,
  "data-dnd-offer": offer.tracking.offerId
};
const contactTrackingAttrs = {
  "data-dnd-placement": "direct-booking",
  "data-dnd-cta-type": "contact",
  ...bookingTrackingAttrs
};
const whatsappTrackingAttrs = {
  "data-dnd-placement": "direct-booking",
  "data-dnd-cta-type": "whatsapp",
  ...bookingTrackingAttrs
};
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Főoldal", item: toAbsoluteUrl("/") },
    { "@type": "ListItem", position: 2, name: pageTitle, item: toAbsoluteUrl(offer.routePath) }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${toAbsoluteUrl(offer.routePath)}#webpage`,
    url: toAbsoluteUrl(offer.routePath),
    name: pageTitle,
    description: pageDescription,
    inLanguage: "hu-HU",
    isPartOf: { "@id": `${toAbsoluteUrl("/")}#website` }
  }
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalPath={offer.routePath}
  ogImage={heroImage.src}
  ogImageAlt={heroImage.alt.hu}
  noindex={true}
  structuredData={structuredData}
  headerMode="transparent"
  bookingHrefOverride={bookingHref}
  lang="hu"
>
  <Fragment slot="head">
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&display=swap" />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&display=swap" rel="stylesheet" media="print" onload="this.media='all'" />
    <noscript>
      <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&display=swap" rel="stylesheet" />
    </noscript>
  </Fragment>

  <main class="autumn-multi" data-autumn-audience={audience}>
    <section class="autumn-multi__hero">
      {offer.campaignHero.video ? (
        <CampaignHeroVideo media={offer.campaignHero.video} class="autumn-multi__hero-media" fill={true} />
      ) : (
        <CampaignMedia media={offer.campaignHero.media} class="autumn-multi__hero-media" fill={true} loading="eager" fetchpriority="high" />
      )}
      <div class="autumn-multi__hero-shade" aria-hidden="true"></div>
      <div class="autumn-multi__hero-content dnd-container">
        <div class="autumn-multi__hero-copy">
          <p class="autumn-multi__eyebrow">{offer.campaignHero.kicker}</p>
          <h1>
            {offer.campaignHero.titleLines.map((line) => <span>{line}</span>)}
            {offer.campaignHero.supportLine && <span class="autumn-multi__hero-support">{offer.campaignHero.supportLine}</span>}
          </h1>
          <div class="autumn-multi__hero-lead">
            {heroLead.map((line) => <p>{line}</p>)}
          </div>
          <div class="autumn-multi__hero-value" role="button" tabindex="0" aria-haspopup="dialog" aria-expanded="false" aria-controls="autumn-price-dialog" aria-label="Mutasd meg, mit jelent a 8% ár-előny">
            <strong>8%</strong>
            <span class="autumn-multi__hero-value-label">ár-előny · részletek</span>
            <span class="autumn-multi__hero-value-action">IDE KATTINTS <span aria-hidden="true">→</span></span>
          </div>
        </div>
        <aside class="autumn-multi__hero-benefits" aria-label="Közvetlen foglalás előnyei">
          <span class="autumn-multi__benefits-kicker">KÖZVETLEN FOGLALÁS</span>
          <h2>Közvetlenül éri meg</h2>
          <p>A közvetlen foglalás előnyei:</p>
          <ul>
            <li>8% ár-előny a portálokhoz képest</li>
            <li>Azonnali bankkártyás fizetés</li>
            <li>Gyors, átlátható foglalási folyamat</li>
            <li>Közvetlen kapcsolat a szállásadóval</li>
          </ul>
        </aside>
        <a class="autumn-multi__hero-booking-badge" href={bookingHref} target="_blank" rel="noopener noreferrer" data-draggable-booking-badge data-dnd-placement="hero-booking-badge" {...bookingTrackingAttrs}>Megéri itt foglalni!</a>
      </div>
    </section>

    <dialog class="autumn-multi__price-dialog" id="autumn-price-dialog" aria-labelledby="autumn-price-dialog-title">
      <div class="autumn-multi__price-dialog-surface">
        <div class="autumn-multi__price-dialog-head">
          <p class="autumn-multi__price-dialog-kicker">KÖZVETLEN FOGLALÁS</p>
          <button type="button" class="autumn-multi__price-dialog-close" data-close-price-dialog aria-label="Bezárás">×</button>
        </div>
        <h2 id="autumn-price-dialog-title">Közvetlenül éri meg</h2>
        <p class="autumn-multi__price-dialog-intro">A szabad időpontokat és az árakat közvetlenül a saját foglalási felületünkön nézhetitek meg.</p>
        <div class="autumn-multi__price-dialog-stat"><strong>8%</strong><span>ár-előny a portálokhoz képest</span></div>
        <ul>
          <li>Közvetlen kapcsolat a szállásadóval</li>
          <li>Gyors visszaigazolás</li>
          <li>Rugalmas ügyintézés</li>
        </ul>
        <a class="autumn-multi__price-dialog-cta" href={bookingHref} target="_blank" rel="noopener noreferrer" data-dnd-placement="hero-price-dialog" {...bookingTrackingAttrs}>Árak és szabad időpontok <span aria-hidden="true">→</span></a>
      </div>
    </dialog>

    <section class="autumn-multi__mood" id="autumn-mood" aria-labelledby="autumn-mood-title">
      <div class="autumn-multi__shell">
        <div class="autumn-multi__mood-layout">
          <div class="autumn-multi__mood-copy">
            <p class="autumn-multi__eyebrow autumn-multi__eyebrow--dark">MIÉRT DANDELION ŐSSZEL?</p>
            <h2 id="autumn-mood-title">{audience === "family" ? "Ősszel a családdal együtt lenni a legjobb!" : "Az ősz itt másképp telik."}</h2>
            <p class="autumn-multi__mood-intro">{audience === "family" ? "Közös reggelik, nagy séták, játékos délutánok és meghitt esték – együtt minden nap emlékezetesebb." : "Borozás, kirándulások, biciklizés, medencés lazulás és a Balaton-felvidék felfedezése — többféle ház, ugyanaz a Dandelion-élmény."}</p>
            <div class="autumn-multi__selection-guide" aria-label="Választást segítő tippek">
              <p class="autumn-multi__selection-kicker">{audience === "family" ? "CSALÁDI ŐSZI ÖTLETEK" : "PÁROS ŐSZI ÖTLETEK"}</p>
              <ul class="autumn-multi__selection-list">
                {selectionBullets.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          </div>
          <div class="autumn-multi__mood-stack" aria-label="Őszi hangulatok">
            {moodCards.map((card) => (
              <article class="autumn-multi__mood-card" style={`--mood-image: url("${card.image}")`}>
                <p>{card.label}</p>
                <h3>{card.title.map((line) => <span>{line}</span>)}</h3>
                <span>{card.copy}</span>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>

    {audience === "family" && (
      <section class="autumn-multi__family-guide" aria-labelledby="autumn-family-guide-title">
        <div class="autumn-multi__shell">
          <p class="autumn-multi__eyebrow autumn-multi__eyebrow--dark">CSALÁDI SZÁLLÁSÖTLETEK</p>
          <h2 id="autumn-family-guide-title">Milyen házakat ajánlunk a családoknak?</h2>
          <p class="autumn-multi__family-guide-lead">A család életkorához és a közös pihenés ritmusához igazítva könnyebb megtalálni a hozzátok illő Dandelion-házat.</p>
          <div class="autumn-multi__family-guide-grid">
            <article>
              <h3>Babával érkezőknek</h3>
              <p><a href="/dandelion-d2/">Dandelion D2</a>, <a href="/fuge/">Dandelion Fügeház</a> és <a href="/royal/">Dandelion Royal Homes</a> – ezekben ingyenesen elérhetők a babafelszerelések.</p>
            </article>
            <article>
              <h3>Nagyobb családoknak</h3>
              <p>A <a href="/szepvolgyi/">Dandelion Szépvölgyi</a> tágas, négy hálószobás háza mellett a <a href="/royal/">Dandelion Royal Homes</a> két hálószobával és jacuzzival is jó választás – a nagyobb gyerekeknek különösen tetszeni fog.</p>
            </article>
            <article>
              <h3>Kamaszokkal nyaralóknak</h3>
              <p>A <a href="/dandelion-d2/">Dandelion D2</a>, a <a href="/dandelion-vintage/">Dandelion Vintage</a> és a <a href="/dandelion-zsalya/">Dandelion Zsálya</a> szeparált szobái lehetőséget adnak a kamaszoknak egy kis önállóságra, miközben a család együtt marad.</p>
            </article>
          </div>
          <div class="autumn-multi__family-guide-bottom">
            <div>
              <p class="autumn-multi__family-guide-label">BABABARÁT KIEGÉSZÍTŐK</p>
              <p>A picik kényelmét szolgáló kiságy, babakád és fellépő térítésmentesen kérhető. Ezek nem minden házban érhetők el, ezért kérjük, előre jelezzétek az igényt.</p>
            </div>
            <div>
              <p class="autumn-multi__family-guide-label">CSALÁDI PROGRAMOK</p>
              <ul>
                <li>Könnyebb és nehezebb túrák a tanúhegyeken.</li>
                <li>Nagyszerű játszótér a faluban.</li>
                <li>Gyönyörű túraútvonalak és aktív pihenés.</li>
                <li>Biciklibérlési lehetőség – érdeklődjetek nálunk.</li>
                <li>Barlangtúra a Tapolcai-tavasbarlangban.</li>
                <li>Családi nap a keszthelyi Festetics-kastélyban.</li>
              </ul>
            </div>
          </div>
        </div>
      </section>
    )}

    <section class="autumn-multi__picker" aria-labelledby="autumn-picker-title">
      <div class="autumn-multi__shell">
        <h2 id="autumn-picker-title">{audience === "family" ? "Melyik ház illik a családotokhoz?" : "Melyik ház illik hozzátok?"}</h2>
        <p class="autumn-multi__picker-lead">Ezeket a házakat különböző őszi pihenésekhez ajánljuk, de természetesen azt válasszátok, amelyik igazán megtetszik nektek.</p>
        <div class="autumn-multi__house-grid">
          {houses.map((house) => (
            <article class:list={[
              "autumn-multi__house-card",
              house.name === "Dandelion D2" && "autumn-multi__house-card--feature-large",
              ["Dandelion D2", "Fügeház"].includes(house.name) && "autumn-multi__house-card--featured"
            ]}>
              <a href={house.href} class="autumn-multi__house-link">
                <img src={house.image.src} alt={house.image.alt.hu} loading="lazy" width={house.image.width} height={house.image.height} />
                <div class="autumn-multi__house-copy">
                  <div class="autumn-multi__house-heading">
                    <h3>{house.name === "Fügeház" ? "Dandelion Fügeház" : house.name}</h3>
                    <p class="autumn-multi__house-label">Akkor válasszátok, ha…</p>
                  </div>
                  {house.name === "Dandelion D2" ? (
                    <ul class="autumn-multi__house-feature-bullets">
                      <li>Őszi estéken a kandalló mellett boroznátok.</li>
                      <li>Kényelmes, felszerelt konyhában készítenétek vacsorát.</li>
                      <li>Csendet szeretnétek.</li>
                      <li>Fontos számotokra a gyors Wi-Fi.</li>
                      <li>Szeptember végéig használható a medence.</li>
                    </ul>
                  ) : house.name === "Fügeház" ? (
                    <ul class="autumn-multi__house-feature-bullets">
                      <li>Szeretnétek a Tanúhegyeket nézve kávézni, és a napfelkeltében gyönyörködni.</li>
                      <li>Fontos számotokra a gyors Wi-Fi.</li>
                      <li>A kert végéből túra indul a bazaltorgonákhoz.</li>
                      <li>Saját, ingyenes parkoló áll rendelkezésre.</li>
                      <li>A kandalló melege vár esténként.</li>
                      <li>Szeptember végéig használható a medence.</li>
                    </ul>
                  ) : (
                    <p>{house.recommendation}</p>
                  )}
                  <span>Megnézem a házat <span aria-hidden="true">→</span></span>
                </div>
              </a>
              <details class="autumn-multi__house-details">
                <summary>Miért ajánljuk? <span aria-hidden="true">+</span></summary>
                <div class="autumn-multi__house-details-body">
                  {house.name === "Dandelion D2" ? (
                    <ul class="autumn-multi__house-feature-bullets">
                      <li>Őszi estéken a kandalló mellett boroznátok.</li>
                      <li>Kényelmes, felszerelt konyhában készítenétek vacsorát.</li>
                      <li>Csendet szeretnétek.</li>
                      <li>Fontos számotokra a gyors Wi-Fi.</li>
                      <li>Szeptember végéig használható a medence.</li>
                    </ul>
                  ) : house.name === "Fügeház" ? (
                    <ul class="autumn-multi__house-feature-bullets">
                      <li>Szeretnétek a Tanúhegyeket nézve kávézni, és a napfelkeltében gyönyörködni.</li>
                      <li>Fontos számotokra a gyors Wi-Fi.</li>
                      <li>A kert végéből túra indul a bazaltorgonákhoz.</li>
                      <li>Saját, ingyenes parkoló áll rendelkezésre.</li>
                      <li>A kandalló melege vár esténként.</li>
                      <li>Szeptember végéig használható a medence.</li>
                    </ul>
                  ) : (
                    <p>{house.recommendation}</p>
                  )}
                  <a href={house.href} class="autumn-multi__house-details-link">Megnézem a házat <span aria-hidden="true">→</span></a>
                </div>
              </details>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="autumn-multi__booking" id="autumn-booking" aria-labelledby="autumn-booking-title">
      <div class="autumn-multi__shell">
        <div class="autumn-multi__booking-layout">
          <div>
            <p class="autumn-multi__eyebrow">{offer.directBooking.eyebrow}</p>
            <h2 id="autumn-booking-title">{offer.directBooking.titleLines.map((line) => <span>{line}</span>)}</h2>
            <p class="autumn-multi__booking-message">{offer.directBooking.primaryMessage}</p>
            <div class="autumn-multi__booking-benefits">
              <div class="autumn-multi__discount"><strong>8%</strong><span>ár-előny a portálokhoz képest</span></div>
              <ul>
                <li>Közvetlen kapcsolat a szállásadóval</li>
                <li>Gyors visszaigazolás</li>
                <li>Rugalmas ügyintézés</li>
              </ul>
            </div>
          </div>
          {offer.directBooking.media && <CampaignMedia media={offer.directBooking.media} class="autumn-multi__booking-media" />}
        </div>
        <div class="autumn-multi__booking-ctas">
          <a href={bookingHref} class="autumn-multi__button autumn-multi__button--primary" target="_blank" rel="noopener noreferrer" data-dnd-placement="direct-booking" {...bookingTrackingAttrs}>Árak és szabad időpontok <span aria-hidden="true">→</span></a>
          <a href="/kapcsolat/" class="autumn-multi__button" {...contactTrackingAttrs}>Írásban érdeklődöm</a>
          <a href="https://wa.me/36207730807" class="autumn-multi__button" target="_blank" rel="noopener noreferrer" {...whatsappTrackingAttrs}>WhatsApp</a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .autumn-multi { --multi-ink: #211b17; --multi-cream: #f7f1e7; --multi-paper: #fffdf8; --multi-gold: #c28b27; --multi-line: #d8cbb9; --multi-night: #3d332c; color: var(--multi-ink); background: var(--multi-cream); font-family: "Manrope", system-ui, sans-serif; }
  .autumn-multi *, .autumn-multi *::before, .autumn-multi *::after { box-sizing: border-box; }
  .autumn-multi__shell { width: min(1180px, calc(100% - 48px)); margin: 0 auto; }
  .autumn-multi__hero { position: relative; min-height: 720px; overflow: hidden; color: #fffaf0; background: #3a2e25; }
  .autumn-multi__hero-media, .autumn-multi__hero-shade { position: absolute; inset: 0; }
  .autumn-multi__hero-shade { background: linear-gradient(90deg, rgba(18, 16, 14, .72), rgba(18, 16, 14, .08) 72%), linear-gradient(180deg, rgba(18, 16, 14, .04) 38%, rgba(18, 16, 14, .76)); }
  .autumn-multi__hero-content { position: relative; z-index: 1; display: grid; grid-template-columns: minmax(0, 1fr) 355px; gap: 54px; align-items: end; min-height: 720px; padding: 220px 24px 72px; }
  .autumn-multi__hero-copy { max-width: 700px; }
  .autumn-multi__eyebrow { margin: 0; color: #e6bd5e; font-size: 11px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; }
  .autumn-multi__eyebrow--dark { color: #9c7124; }
  .autumn-multi h1, .autumn-multi h2, .autumn-multi h3 { font-family: "Cormorant Garamond", Georgia, serif; font-weight: 400; }
  .autumn-multi__hero h1 { max-width: 650px; margin: 18px 0 20px; font-size: clamp(58px, 7vw, 94px); line-height: .86; letter-spacing: -.045em; }
  .autumn-multi__hero h1 span { display: block; }
  .autumn-multi__hero h1 .autumn-multi__hero-support { margin-top: 14px; font-size: .54em; line-height: .96; letter-spacing: -.02em; }
  .autumn-multi__hero-lead p { margin: 0; color: rgba(255, 250, 240, .9); font-size: 15px; line-height: 1.55; }
  .autumn-multi__hero-value { display: flex; align-items: baseline; gap: 12px; width: fit-content; margin-top: 28px; padding: 13px 22px; border: 1px solid rgba(255, 244, 205, .72); border-radius: 10px; background: rgba(167, 111, 17, .86); }
