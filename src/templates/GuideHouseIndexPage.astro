---
import BaseLayout from "../layouts/BaseLayout.astro";
import type { GuideContent, GuideLocale } from "../data/guides/types";

interface GuideIndexItem {
  guide: GuideContent;
  eyebrowHu?: string;
  eyebrowEn?: string;
  eyebrowCs?: string;
  eyebrowDe?: string;
  eyebrowSk?: string;
  titleHu: string;
  titleEn: string;
  titleCs: string;
  titleDe: string;
  titleSk?: string;
  descriptionHu: string;
  descriptionEn: string;
  descriptionCs: string;
  descriptionDe: string;
  descriptionSk?: string;
}

interface GuideQuickInfoLegacyItem {
  labelHu: string;
  labelEn: string;
  labelCs: string;
  labelDe: string;
  labelSk?: string;
  value: string;
}

interface GuideQuickInfoDetailedItem {
  titleHu: string;
  titleEn: string;
  titleCs: string;
  titleDe: string;
  titleSk?: string;
  linesHu: string[];
  linesEn: string[];
  linesCs: string[];
  linesDe: string[];
  linesSk?: string[];
}

type GuideQuickInfoItem = GuideQuickInfoLegacyItem | GuideQuickInfoDetailedItem;

interface GuideIndexGroup {
  titleHu: string;
  titleEn: string;
  titleCs: string;
  titleDe: string;
  titleSk?: string;
  items: GuideIndexItem[];
}

interface Props {
  houseName: string;
  canonicalPath: string;
  title: string;
  description: string;
  introHu: string;
  introEn: string;
  introCs: string;
  introDe: string;
  introSk?: string;
  items: GuideIndexItem[];
  enabledLocales?: GuideLocale[];
  accordion?: boolean;
  quickInfoTitleHu?: string;
  quickInfoTitleEn?: string;
  quickInfoTitleCs?: string;
  quickInfoTitleDe?: string;
  quickInfoTitleSk?: string;
  quickInfoItems?: GuideQuickInfoItem[];
  itemGroups?: GuideIndexGroup[];
  heroImageSrc?: string;
  heroImageAlt?: string;
}

// [CHANGE 2026-05-24 00:00] Kozos QR guide index sablon letrehozva uj hazankenti guide oldalakhoz.
// [CHANGE 2026-06-12 21:45] Opcionális lenyíló guide tartalom hozzáadva, hogy a D2 szabályok ne külön aloldalon jelenjenek meg.
// [CHANGE 2026-06-23 00:00] Opcionális gyorsinfó blokk és csoportosított kártyalisták hozzáadva a vendéglogikára épülő guide kezdőoldalakhoz.
const {
  houseName,
  canonicalPath,
  title,
  description,
  introHu,
  introEn,
  introCs,
  introDe,
  introSk,
  items,
  enabledLocales = ["hu", "en", "cs", "de", "sk"],
  accordion = false,
  quickInfoTitleHu,
  quickInfoTitleEn,
  quickInfoTitleCs,
  quickInfoTitleDe,
  quickInfoTitleSk,
  quickInfoItems = [],
  itemGroups,
  heroImageSrc,
  heroImageAlt
} = Astro.props;
const guideLocales = ["hu", "en", "cs", "de", "sk"] as const;
const activeLocales = enabledLocales;
const localeHeadings = {
  hu: `${houseName} útmutató`,
  en: `${houseName} guide`,
  cs: `${houseName} průvodce`,
  de: `${houseName} Guide`,
  sk: `${houseName} sprievodca`
} as const;
const localeIntros = {
  hu: introHu,
  en: introEn,
  cs: introCs,
  de: introDe,
  sk: introSk ?? introEn
} as const;
const sectionLabels = {
  hu: "Fontos pontok",
  en: "Key points",
  cs: "Důležité body",
  de: "Wichtige Punkte",
  sk: "Dôležité body"
} as const;
const resolveGuideContent = (guide: GuideContent, locale: (typeof guideLocales)[number]) =>
  guide.content[locale] ?? guide.content.en ?? guide.content.cs ?? guide.content.de ?? guide.content.hu;
const resolveIndexCopy = (item: GuideIndexItem, locale: (typeof guideLocales)[number]) => {
  if (locale === "hu") return { title: item.titleHu, description: item.descriptionHu };
  if (locale === "en") return { title: item.titleEn, description: item.descriptionEn };
  if (locale === "cs") return { title: item.titleCs, description: item.descriptionCs };
  if (locale === "de") return { title: item.titleDe, description: item.descriptionDe };

  return {
    title: item.titleSk ?? item.titleEn,
    description: item.descriptionSk ?? item.descriptionEn
  };
};
const resolveQuickInfoLabel = (item: GuideQuickInfoItem, locale: (typeof guideLocales)[number]) => {
  if ("labelHu" in item) {
    if (locale === "hu") return item.labelHu;
    if (locale === "en") return item.labelEn;
    if (locale === "cs") return item.labelCs;
    if (locale === "de") return item.labelDe;

    return item.labelSk ?? item.labelEn;
  }

  if (locale === "hu") return item.titleHu;
  if (locale === "en") return item.titleEn;
  if (locale === "cs") return item.titleCs;
  if (locale === "de") return item.titleDe;

  return item.titleSk ?? item.titleEn;
};
const resolveQuickInfoLines = (item: GuideQuickInfoItem, locale: (typeof guideLocales)[number]) => {
  if ("value" in item) {
    return [item.value];
  }

  if (locale === "hu") return item.linesHu;
  if (locale === "en") return item.linesEn;
  if (locale === "cs") return item.linesCs;
  if (locale === "de") return item.linesDe;

  return item.linesSk ?? item.linesEn;
};
const resolveEyebrow = (item: GuideIndexItem, locale: (typeof guideLocales)[number]) => {
  if (locale === "hu") return item.eyebrowHu;
  if (locale === "en") return item.eyebrowEn;
  if (locale === "cs") return item.eyebrowCs;
  if (locale === "de") return item.eyebrowDe;

  return item.eyebrowSk ?? item.eyebrowEn;
};
const resolveQuickInfoTitle = (locale: (typeof guideLocales)[number]) => {
  if (locale === "hu") return quickInfoTitleHu;
  if (locale === "en") return quickInfoTitleEn;
  if (locale === "cs") return quickInfoTitleCs;
  if (locale === "de") return quickInfoTitleDe;

  return quickInfoTitleSk ?? quickInfoTitleEn;
};
const resolveGroupTitle = (group: GuideIndexGroup, locale: (typeof guideLocales)[number]) => {
  if (locale === "hu") return group.titleHu;
  if (locale === "en") return group.titleEn;
  if (locale === "cs") return group.titleCs;
  if (locale === "de") return group.titleDe;

  return group.titleSk ?? group.titleEn;
};
const groupedItems = itemGroups?.length
  ? itemGroups
  : [{ titleHu: "", titleEn: "", titleCs: "", titleDe: "", titleSk: "", items }];
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  noindex={true}
  hideHeader={true}
  hideFooter={true}
>
  <section class="guide-index" data-guide-index>
    <div class="guide-index__shell">
      <header class="guide-index__header">
        {heroImageSrc && (
          <div class="guide-index__hero-media">
            <img src={heroImageSrc} alt={heroImageAlt ?? `${houseName} guide hero`} loading="eager" />
          </div>
        )}
        <p class="guide-index__eyebrow">QR vendégútmutató · {houseName}</p>
        <div class="guide-language" aria-label="Guide language selector">
          {activeLocales.map((locale) => (
            <button
              class="guide-language__button"
              type="button"
              data-guide-lang-button={locale}
              aria-pressed={locale === "hu" ? "true" : "false"}
            >
              {locale === "hu" ? "HU" : locale === "en" ? "EN" : locale === "cs" ? "CZ" : locale === "de" ? "DE" : "SK"}
            </button>
          ))}
        </div>

        {activeLocales.map((locale) => (
          <div data-guide-lang-panel={locale} hidden={locale !== "hu"}>
            <h1>{localeHeadings[locale]}</h1>
            <p>{localeIntros[locale]}</p>
          </div>
        ))}
      </header>

      {quickInfoItems.length > 0 && (
        <section class="guide-index__quick-info" aria-label="Gyors információk">
          {activeLocales.map((locale) => {
            const quickInfoTitle = resolveQuickInfoTitle(locale);
            return (
              <div data-guide-lang-panel={locale} hidden={locale !== "hu"}>
                {quickInfoTitle && <h2 class="guide-index__quick-info-title">{quickInfoTitle}</h2>}
              </div>
            );
          })}

          <div class="guide-index__quick-info-grid">
            {quickInfoItems.map((item) => (
              <article class="guide-index__quick-info-item">
                {activeLocales.map((locale) => (
                  <div data-guide-lang-panel={locale} hidden={locale !== "hu"}>
                    <h3>{resolveQuickInfoLabel(item, locale)}</h3>
                    <div class="guide-index__quick-info-lines">
                      {resolveQuickInfoLines(item, locale).map((line) => (
                        <p>{line}</p>
                      ))}
                    </div>
                  </div>
                ))}
              </article>
            ))}
          </div>
        </section>
      )}

      {groupedItems.map((group, groupIndex) => (
        <section class="guide-index__group">
          {(group.titleHu || group.titleEn || group.titleCs || group.titleDe || group.titleSk) && (
            <div class="guide-index__group-head">
              {activeLocales.map((locale) => (
                <h2 data-guide-lang-panel={locale} hidden={locale !== "hu"}>
                  {resolveGroupTitle(group, locale)}
                </h2>
              ))}
            </div>
          )}

          <div class:list={["guide-index__list", accordion ? "guide-index__list--accordion" : "guide-index__list--cards"]}>
            {group.items.map((item, itemIndex) => {
              const panelId = `guide-index-panel-${groupIndex}-${itemIndex}`;
              return accordion ? (
                <section class="guide-index__accordion">
                  <button
                    class="guide-index__item guide-index__item--button"
                    type="button"
                    aria-expanded="false"
                    aria-controls={panelId}
                    data-guide-accordion-button
                  >
                    {activeLocales.map((locale) => {
                      const copy = resolveIndexCopy(item, locale);
                      const eyebrow = resolveEyebrow(item, locale);
                      return (
                        <>
                          {eyebrow && <em data-guide-lang-panel={locale} hidden={locale !== "hu"}>{eyebrow}</em>}
                          <span data-guide-lang-panel={locale} hidden={locale !== "hu"}>{copy.title}</span>
                          <small data-guide-lang-panel={locale} hidden={locale !== "hu"}>{copy.description}</small>
                        </>
                      );
                    })}
                  </button>
                  <div class="guide-index__panel" id={panelId} hidden data-guide-accordion-panel>
                    {activeLocales.map((locale) => {
                      const localizedGuide = resolveGuideContent(item.guide, locale);
                      return (
                        <div data-guide-lang-panel={locale} hidden={locale !== "hu"}>
                          <h2>{localizedGuide?.subtitle}</h2>
                          <p>{localizedGuide?.intro}</p>
                          <section class="guide-index__important">
                            <h3>{sectionLabels[locale]}</h3>
                            <ul>
                              {localizedGuide?.keyPoints.map((point) => (
                                <li>{point}</li>
                              ))}
                            </ul>
                          </section>
                          <div class="guide-index__sections">
                            {localizedGuide?.sections.map((section) => (
                              <section class="guide-index__section">
                                <h3>{section.title}</h3>
                                {section.paragraphs.map((paragraph) => (
                                  <p>{paragraph}</p>
                                ))}
                                {section.bullets && (
                                  <ul>
                                    {section.bullets.map((bullet) => (
                                      <li>{bullet}</li>
                                    ))}
                                  </ul>
                                )}
                                {section.steps && (
                                  <ol>
                                    {section.steps.map((step) => (
                                      <li>{step}</li>
                                    ))}
                                  </ol>
                                )}
                                {section.important && <p class="guide-index__note">{section.important}</p>}
                              </section>
                            ))}
                          </div>
                        </div>
                      );
                    })}
                  </div>
                </section>
              ) : (
                <a class="guide-index__item" href={item.guide.path}>
                  {activeLocales.map((locale) => {
                    const copy = resolveIndexCopy(item, locale);
                    const eyebrow = resolveEyebrow(item, locale);
                    return (
                      <>
                        {eyebrow && <em data-guide-lang-panel={locale} hidden={locale !== "hu"}>{eyebrow}</em>}
                        <span data-guide-lang-panel={locale} hidden={locale !== "hu"}>{copy.title}</span>
                        <small data-guide-lang-panel={locale} hidden={locale !== "hu"}>{copy.description}</small>
                      </>
                    );
                  })}
                </a>
              );
            })}
          </div>
        </section>
      ))}
    </div>
  </section>

  <script>
    (() => {
      const root = document.querySelector("[data-guide-index]");
      if (!root) return;

      const buttons = root.querySelectorAll("[data-guide-lang-button]");
      const panels = root.querySelectorAll("[data-guide-lang-panel]");
      const accordionButtons = root.querySelectorAll("[data-guide-accordion-button]");
      const accordionPanels = root.querySelectorAll("[data-guide-accordion-panel]");

      const setLanguage = (nextLanguage) => {
        panels.forEach((panel) => {
          panel.hidden = panel.getAttribute("data-guide-lang-panel") !== nextLanguage;
        });
        buttons.forEach((button) => {
          button.setAttribute(
            "aria-pressed",
            button.getAttribute("data-guide-lang-button") === nextLanguage ? "true" : "false"
          );
        });
        document.documentElement.lang = nextLanguage;
      };

      buttons.forEach((button) => {
        button.addEventListener("click", () => {
          const nextLanguage = button.getAttribute("data-guide-lang-button");
          if (nextLanguage) setLanguage(nextLanguage);
        });
      });

      accordionButtons.forEach((button) => {
        button.addEventListener("click", () => {
          const targetId = button.getAttribute("aria-controls");
          const targetPanel = targetId ? document.getElementById(targetId) : null;
          const wasOpen = button.getAttribute("aria-expanded") === "true";

          accordionButtons.forEach((otherButton) => {
            otherButton.setAttribute("aria-expanded", "false");
          });
          accordionPanels.forEach((panel) => {
            panel.hidden = true;
          });

          if (!wasOpen && targetPanel) {
            button.setAttribute("aria-expanded", "true");
            targetPanel.hidden = false;
          }
        });
      });
    })();
  </script>
</BaseLayout>

<style>
  :global(body) {
    background: #fdfbf7;
  }

  .guide-index {
    min-height: 100vh;
    padding: 22px 0 48px;
    background: linear-gradient(180deg, #fff8ec 0%, #fdfbf7 44%, #ffffff 100%);
    color: #261d16;
  }

  .guide-index__shell {
    width: min(100% - 24px, 980px);
    margin: 0 auto;
  }

  .guide-index__header {
    display: grid;
    gap: 18px;
    padding: 24px 0 22px;
    border-bottom: 1px solid rgba(94, 65, 39, 0.16);
  }

  .guide-index__hero-media {
    overflow: hidden;
    border-radius: 18px;
    aspect-ratio: 16 / 8.5;
    box-shadow: 0 24px 50px rgba(49, 36, 22, 0.16);
  }

  .guide-index__hero-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .guide-index__eyebrow {
    margin: 0;
    color: #9a6a1e;
    font-size: var(--dnd-text-xs);
    font-weight: 700;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .guide-index h1 {
    margin: 0;
    font-family: var(--dnd-font-display);
    font-size: clamp(2.4rem, 12vw, 4rem);
    font-weight: 500;
    line-height: 1.02;
  }

  .guide-index p {
    margin: 14px 0 0;
    color: rgba(38, 29, 22, 0.78);
    font-size: var(--dnd-text-lead);
    line-height: 1.65;
  }

  .guide-language {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .guide-language__button,
  .guide-language__pending {
    display: inline-flex;
    flex: 1 1 0;
    align-items: center;
    justify-content: center;
    min-width: 0;
    min-height: 42px;
    border: 1px solid rgba(94, 65, 39, 0.18);
    border-radius: 8px;
    background: #fffefb;
    color: #5e4127;
    font-family: var(--dnd-font-body);
    font-size: var(--dnd-text-xs);
    font-weight: 700;
    letter-spacing: 0;
  }

  .guide-language__button[aria-pressed="true"] {
    border-color: #d99e2b;
    background: #d99e2b;
    color: #1b140f;
  }

  .guide-language__pending {
    opacity: 0.45;
  }

  .guide-index__quick-info {
    display: grid;
    gap: 14px;
    margin-top: 22px;
    padding: 18px;
    border: 1px solid rgba(94, 65, 39, 0.12);
    border-radius: 18px;
    background: linear-gradient(180deg, rgba(255, 250, 241, 0.96) 0%, rgba(255, 255, 255, 0.98) 100%);
    box-shadow: 0 16px 38px rgba(49, 36, 22, 0.08);
  }

  .guide-index__quick-info-title {
    margin: 0;
    font-size: clamp(1.05rem, 4vw, 1.28rem);
    line-height: 1.2;
  }

  .guide-index__quick-info-grid {
    display: grid;
    gap: 10px;
  }

  .guide-index__quick-info-item {
    min-height: 100%;
    padding: 14px;
    border: 1px solid rgba(94, 65, 39, 0.12);
    border-radius: 12px;
    background: rgba(255, 254, 251, 0.92);
  }

  .guide-index__quick-info-item h3 {
    margin: 0;
    font-size: var(--dnd-text-sm);
    line-height: 1.3;
  }

  .guide-index__quick-info-lines {
    display: grid;
    gap: 6px;
    margin-top: 10px;
  }

  .guide-index__quick-info-item p {
    margin: 0;
    color: rgba(38, 29, 22, 0.8);
    font-size: var(--dnd-text-sm);
    line-height: 1.5;
  }

  .guide-index__group {
    display: grid;
    gap: 14px;
    margin-top: 28px;
  }

  .guide-index__group-head h2 {
    margin: 0;
    font-size: clamp(1.05rem, 4.2vw, 1.3rem);
    line-height: 1.2;
  }

  .guide-index__list {
    display: grid;
    gap: 14px;
  }

  .guide-index__list--accordion {
    grid-template-columns: 1fr;
  }

  .guide-index__quick-info-grid,
  .guide-index__list--cards {
    grid-template-columns: 1fr;
  }

  .guide-index__item {
    display: grid;
    gap: 8px;
    width: 100%;
    min-height: 100%;
    padding: 18px;
    border: 1px solid rgba(94, 65, 39, 0.16);
    border-radius: 8px;
    background: #fffefb;
    color: #261d16;
    text-decoration: none;
  }

  .guide-index__item--button {
    position: relative;
    cursor: pointer;
    font-family: var(--dnd-font-body);
    text-align: left;
  }

  .guide-index__item--button::after {
    content: "+";
    position: absolute;
    top: 18px;
    right: 18px;
    color: #9a6a1e;
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1;
  }

  .guide-index__item--button[aria-expanded="true"]::after {
    content: "-";
  }

  .guide-index__item span {
    padding-right: 28px;
    font-size: var(--dnd-heading-xs);
    font-weight: 700;
    line-height: 1.2;
  }

  .guide-index__item em {
    color: #9a6a1e;
    font-size: 0.72rem;
    font-style: normal;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .guide-index__item small {
    color: rgba(38, 29, 22, 0.72);
    font-size: var(--dnd-text-sm);
    line-height: 1.55;
  }

  .guide-index__accordion {
    display: grid;
    gap: 10px;
  }

  .guide-index__panel {
    padding: 18px;
    border: 1px solid rgba(94, 65, 39, 0.14);
    border-radius: 8px;
    background: #fffefb;
  }

  .guide-index__panel h2,
  .guide-index__panel h3 {
    margin: 0;
    color: #261d16;
    font-family: var(--dnd-font-body);
    font-weight: 750;
    line-height: 1.25;
  }

  .guide-index__panel h2 {
    font-size: var(--dnd-heading-xs);
  }

  .guide-index__panel h3 {
    font-size: var(--dnd-text-lg);
  }

  .guide-index__panel p {
    margin: 10px 0 0;
    font-size: var(--dnd-text-sm);
    line-height: 1.6;
  }

  .guide-index__important,
  .guide-index__sections {
    display: grid;
    gap: 14px;
    margin-top: 18px;
  }

  .guide-index__section {
    padding-top: 16px;
    border-top: 1px solid rgba(94, 65, 39, 0.12);
  }

  .guide-index__panel ul,
  .guide-index__panel ol {
    display: grid;
    gap: 8px;
    margin: 10px 0 0;
    padding-left: 20px;
    color: rgba(38, 29, 22, 0.78);
    font-size: var(--dnd-text-sm);
    line-height: 1.55;
  }

  .guide-index__note {
    padding: 12px;
    border-left: 3px solid #d99e2b;
    border-radius: 8px;
    background: rgba(217, 158, 43, 0.12);
    font-weight: 700;
  }

  @media (min-width: 760px) {
    .guide-index {
      padding-top: 36px;
    }

    .guide-index__shell {
      width: min(100% - 48px, 1180px);
    }

    .guide-index__header {
      grid-template-columns: 1fr auto;
      align-items: start;
    }

    .guide-index__header [data-guide-lang-panel] {
      grid-column: 1 / -1;
    }

    .guide-language__button,
    .guide-language__pending {
      flex: 0 0 auto;
      min-width: 54px;
    }

    .guide-index__quick-info-grid,
    .guide-index__list--cards {
      gap: 18px;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .guide-index__item {
      padding: 22px;
      border-radius: 16px;
    }

    .guide-index__item span {
      font-size: clamp(1.1rem, 1.8vw, 1.45rem);
    }

    .guide-index__item small {
      font-size: var(--dnd-text-base);
    }
  }

  @media (min-width: 1040px) {
    .guide-index__quick-info-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
