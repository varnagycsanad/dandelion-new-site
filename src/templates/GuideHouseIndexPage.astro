---
import BaseLayout from "../layouts/BaseLayout.astro";
import type { GuideContent } from "../data/guides/types";

interface GuideIndexItem {
  guide: GuideContent;
  titleHu: string;
  titleEn: string;
  titleCs: string;
  titleDe: string;
  descriptionHu: string;
  descriptionEn: string;
  descriptionCs: string;
  descriptionDe: string;
}

interface GuideQuickInfoItem {
  labelHu: string;
  labelEn: string;
  labelCs: string;
  labelDe: string;
  value: string;
}

interface Props {
  houseName: string;
  canonicalPath: string;
  title: string;
  description: string;
  introHu: string;
  introEn: string;
  introCs: string;
  introDe: string;
  items: GuideIndexItem[];
  accordion?: boolean;
  quickInfoItems?: GuideQuickInfoItem[];
}

// [CHANGE 2026-05-24 00:00] Kozos QR guide index sablon letrehozva uj hazankenti guide oldalakhoz.
// [CHANGE 2026-06-12 21:45] Opcionális lenyíló guide tartalom hozzáadva, hogy a D2 szabályok ne külön aloldalon jelenjenek meg.
const {
  houseName,
  canonicalPath,
  title,
  description,
  introHu,
  introEn,
  introCs,
  introDe,
  items,
  accordion = false,
  quickInfoItems = []
} = Astro.props;
const guideLocales = ["hu", "en", "cs", "de"] as const;
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  noindex={true}
  hideHeader={true}
  hideFooter={true}
>
  <section class="guide-index" data-guide-index>
    <div class="guide-index__shell">
      <header class="guide-index__header">
        <p class="guide-index__eyebrow">QR vendégútmutató · {houseName}</p>
        <div class="guide-language" aria-label="Guide language selector">
          <button class="guide-language__button" type="button" data-guide-lang-button="hu" aria-pressed="true">HU</button>
          <button class="guide-language__button" type="button" data-guide-lang-button="en" aria-pressed="false">EN</button>
          <button class="guide-language__button" type="button" data-guide-lang-button="cs" aria-pressed="false">CZ</button>
          <button class="guide-language__button" type="button" data-guide-lang-button="de" aria-pressed="false">DE</button>
        </div>

        <div data-guide-lang-panel="hu">
          <h1>{houseName} útmutató</h1>
          <p>{introHu}</p>
        </div>
        <div data-guide-lang-panel="en" hidden>
          <h1>{houseName} guide</h1>
          <p>{introEn}</p>
        </div>
        <div data-guide-lang-panel="cs" hidden>
          <h1>{houseName} průvodce</h1>
          <p>{introCs}</p>
        </div>
        <div data-guide-lang-panel="de" hidden>
          <h1>{houseName} Guide</h1>
          <p>{introDe}</p>
        </div>
      </header>

      {quickInfoItems.length > 0 && (
        <section class="guide-index__quick-info" aria-label="Gyors információk">
          {quickInfoItems.map((item) => (
            <article class="guide-index__quick-info-item">
              <span data-guide-lang-panel="hu">{item.labelHu}</span>
              <span data-guide-lang-panel="en" hidden>{item.labelEn}</span>
              <span data-guide-lang-panel="cs" hidden>{item.labelCs}</span>
              <span data-guide-lang-panel="de" hidden>{item.labelDe}</span>
              <strong>{item.value}</strong>
            </article>
          ))}
        </section>
      )}

      <div class="guide-index__list">
        {items.map((item, itemIndex) => {
          const panelId = `guide-index-panel-${itemIndex}`;
          return accordion ? (
            <section class="guide-index__accordion">
              <button
                class="guide-index__item guide-index__item--button"
                type="button"
                aria-expanded="false"
                aria-controls={panelId}
                data-guide-accordion-button
              >
                <span data-guide-lang-panel="hu">{item.titleHu}</span>
                <span data-guide-lang-panel="en" hidden>{item.titleEn}</span>
                <span data-guide-lang-panel="cs" hidden>{item.titleCs}</span>
                <span data-guide-lang-panel="de" hidden>{item.titleDe}</span>
                <small data-guide-lang-panel="hu">{item.descriptionHu}</small>
                <small data-guide-lang-panel="en" hidden>{item.descriptionEn}</small>
                <small data-guide-lang-panel="cs" hidden>{item.descriptionCs}</small>
                <small data-guide-lang-panel="de" hidden>{item.descriptionDe}</small>
              </button>
              <div class="guide-index__panel" id={panelId} hidden data-guide-accordion-panel>
                {guideLocales.map((locale) => (
                  <div data-guide-lang-panel={locale} hidden={locale !== "hu"}>
                    <h2>{item.guide.content[locale].subtitle}</h2>
                    <p>{item.guide.content[locale].intro}</p>
                    <section class="guide-index__important">
                      <h3>{locale === "hu" ? "Fontos pontok" : locale === "en" ? "Key points" : locale === "cs" ? "Důležité body" : "Wichtige Punkte"}</h3>
                      <ul>
                        {item.guide.content[locale].keyPoints.map((point) => (
                          <li>{point}</li>
                        ))}
                      </ul>
                    </section>
                    <div class="guide-index__sections">
                      {item.guide.content[locale].sections.map((section) => (
                        <section class="guide-index__section">
                          <h3>{section.title}</h3>
                          {section.paragraphs.map((paragraph) => (
                            <p>{paragraph}</p>
                          ))}
                          {section.bullets && (
                            <ul>
                              {section.bullets.map((bullet) => (
                                <li>{bullet}</li>
                              ))}
                            </ul>
                          )}
                          {section.steps && (
                            <ol>
                              {section.steps.map((step) => (
                                <li>{step}</li>
                              ))}
                            </ol>
                          )}
                          {section.important && <p class="guide-index__note">{section.important}</p>}
                        </section>
                      ))}
                    </div>
                  </div>
                ))}
              </div>
            </section>
          ) : (
            <a class="guide-index__item" href={item.guide.path}>
              <span data-guide-lang-panel="hu">{item.titleHu}</span>
              <span data-guide-lang-panel="en" hidden>{item.titleEn}</span>
              <span data-guide-lang-panel="cs" hidden>{item.titleCs}</span>
              <span data-guide-lang-panel="de" hidden>{item.titleDe}</span>
              <small data-guide-lang-panel="hu">{item.descriptionHu}</small>
              <small data-guide-lang-panel="en" hidden>{item.descriptionEn}</small>
              <small data-guide-lang-panel="cs" hidden>{item.descriptionCs}</small>
              <small data-guide-lang-panel="de" hidden>{item.descriptionDe}</small>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <script>
    (() => {
      const root = document.querySelector("[data-guide-index]");
      if (!root) return;

      const buttons = root.querySelectorAll("[data-guide-lang-button]");
      const panels = root.querySelectorAll("[data-guide-lang-panel]");
      const accordionButtons = root.querySelectorAll("[data-guide-accordion-button]");
      const accordionPanels = root.querySelectorAll("[data-guide-accordion-panel]");

      const setLanguage = (nextLanguage) => {
        panels.forEach((panel) => {
          panel.hidden = panel.getAttribute("data-guide-lang-panel") !== nextLanguage;
        });
        buttons.forEach((button) => {
          button.setAttribute(
            "aria-pressed",
            button.getAttribute("data-guide-lang-button") === nextLanguage ? "true" : "false"
          );
        });
        document.documentElement.lang = nextLanguage;
      };

      buttons.forEach((button) => {
        button.addEventListener("click", () => {
          const nextLanguage = button.getAttribute("data-guide-lang-button");
          if (nextLanguage) setLanguage(nextLanguage);
        });
      });

      accordionButtons.forEach((button) => {
        button.addEventListener("click", () => {
          const targetId = button.getAttribute("aria-controls");
          const targetPanel = targetId ? document.getElementById(targetId) : null;
          const wasOpen = button.getAttribute("aria-expanded") === "true";

          accordionButtons.forEach((otherButton) => {
            otherButton.setAttribute("aria-expanded", "false");
          });
          accordionPanels.forEach((panel) => {
            panel.hidden = true;
          });

          if (!wasOpen && targetPanel) {
            button.setAttribute("aria-expanded", "true");
            targetPanel.hidden = false;
          }
        });
      });
    })();
  </script>
</BaseLayout>

<style>
  :global(body) {
    background: #fdfbf7;
  }

  .guide-index {
    min-height: 100vh;
    padding: 22px 0 48px;
    background: linear-gradient(180deg, #fff8ec 0%, #fdfbf7 44%, #ffffff 100%);
    color: #261d16;
  }

  .guide-index__shell {
    width: min(100% - 28px, 720px);
    margin: 0 auto;
  }

  .guide-index__header {
    display: grid;
    gap: 18px;
    padding: 24px 0 22px;
    border-bottom: 1px solid rgba(94, 65, 39, 0.16);
  }

  .guide-index__eyebrow {
    margin: 0;
    color: #9a6a1e;
    font-size: var(--dnd-text-xs);
    font-weight: 700;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .guide-index h1 {
    margin: 0;
    font-family: var(--dnd-font-display);
    font-size: clamp(2.4rem, 12vw, 4rem);
    font-weight: 500;
    line-height: 1.02;
  }

  .guide-index p {
    margin: 14px 0 0;
    color: rgba(38, 29, 22, 0.78);
    font-size: var(--dnd-text-lead);
    line-height: 1.65;
  }

  .guide-language {
    display: flex;
    gap: 8px;
  }

  .guide-language__button,
  .guide-language__pending {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 54px;
    min-height: 42px;
    border: 1px solid rgba(94, 65, 39, 0.18);
    border-radius: 8px;
    background: #fffefb;
    color: #5e4127;
    font-family: var(--dnd-font-body);
    font-size: var(--dnd-text-xs);
    font-weight: 700;
    letter-spacing: 0;
  }

  .guide-language__button[aria-pressed="true"] {
    border-color: #d99e2b;
    background: #d99e2b;
    color: #1b140f;
  }

  .guide-language__pending {
    opacity: 0.45;
  }

  .guide-index__list {
    display: grid;
    gap: 14px;
    margin-top: 24px;
  }

  .guide-index__quick-info {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 18px;
  }

  .guide-index__quick-info-item {
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
    min-height: 34px;
    padding: 7px 10px;
    border: 1px solid rgba(94, 65, 39, 0.14);
    border-radius: 8px;
    background: #fffefb;
  }

  .guide-index__quick-info-item span {
    color: rgba(38, 29, 22, 0.58);
    font-size: var(--dnd-text-xs);
    font-weight: 700;
    letter-spacing: 0;
  }

  .guide-index__quick-info-item strong {
    color: #1f2937;
    font-size: var(--dnd-text-sm);
    font-weight: 750;
    line-height: 1.2;
  }

  .guide-index__item {
    display: grid;
    gap: 8px;
    width: 100%;
    padding: 18px;
    border: 1px solid rgba(94, 65, 39, 0.16);
    border-radius: 8px;
    background: #fffefb;
    color: #261d16;
    text-decoration: none;
  }

  .guide-index__item--button {
    position: relative;
    cursor: pointer;
    font-family: var(--dnd-font-body);
    text-align: left;
  }

  .guide-index__item--button::after {
    content: "+";
    position: absolute;
    top: 18px;
    right: 18px;
    color: #9a6a1e;
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1;
  }

  .guide-index__item--button[aria-expanded="true"]::after {
    content: "-";
  }

  .guide-index__item span {
    padding-right: 28px;
    font-size: var(--dnd-heading-xs);
    font-weight: 700;
    line-height: 1.2;
  }

  .guide-index__item small {
    color: rgba(38, 29, 22, 0.72);
    font-size: var(--dnd-text-sm);
    line-height: 1.55;
  }

  .guide-index__accordion {
    display: grid;
    gap: 10px;
  }

  .guide-index__panel {
    padding: 18px;
    border: 1px solid rgba(94, 65, 39, 0.14);
    border-radius: 8px;
    background: #fffefb;
  }

  .guide-index__panel h2,
  .guide-index__panel h3 {
    margin: 0;
    color: #261d16;
    font-family: var(--dnd-font-body);
    font-weight: 750;
    line-height: 1.25;
  }

  .guide-index__panel h2 {
    font-size: var(--dnd-heading-xs);
  }

  .guide-index__panel h3 {
    font-size: var(--dnd-text-lg);
  }

  .guide-index__panel p {
    margin: 10px 0 0;
    font-size: var(--dnd-text-sm);
    line-height: 1.6;
  }

  .guide-index__important,
  .guide-index__sections {
    display: grid;
    gap: 14px;
    margin-top: 18px;
  }

  .guide-index__section {
    padding-top: 16px;
    border-top: 1px solid rgba(94, 65, 39, 0.12);
  }

  .guide-index__panel ul,
  .guide-index__panel ol {
    display: grid;
    gap: 8px;
    margin: 10px 0 0;
    padding-left: 20px;
    color: rgba(38, 29, 22, 0.78);
    font-size: var(--dnd-text-sm);
    line-height: 1.55;
  }

  .guide-index__note {
    padding: 12px;
    border-left: 3px solid #d99e2b;
    border-radius: 8px;
    background: rgba(217, 158, 43, 0.12);
    font-weight: 700;
  }

  @media (min-width: 760px) {
    .guide-index {
      padding-top: 36px;
    }

    .guide-index__header {
      grid-template-columns: 1fr auto;
      align-items: start;
    }

    .guide-index__header [data-guide-lang-panel] {
      grid-column: 1 / -1;
    }

  }
</style>
