};
const poolStructuredData = [poolVideoStructuredData, poolWebPageStructuredData, poolFaqStructuredData];

const getStayImage = (key: "d1" | "d2" | "fugehaz") => {
  const localizedD2CardCopy = {
    hu: {
      alt: "Dandelion D2 fedett terasza sárga székekkel és kertkapcsolattal Kisapátiban",
      title: "Dandelion D2 terasz"
    },
    en: {
      alt: "Covered terrace of Dandelion D2 with yellow chairs and direct garden access in Kisapáti",
      title: "Dandelion D2 terrace"
    },
    de: {
      alt: "Überdachte Terrasse von Dandelion D2 mit gelben Stühlen und Gartenzugang in Kisapáti",
      title: "Dandelion D2 Terrasse"
    },
    cs: {
      alt: "Krytá terasa Dandelion D2 se žlutými židlemi a vstupem do zahrady v Kisapáti",
      title: "Terasa Dandelion D2"
    },
    sk: {
      alt: "Krytá terasa Dandelion D2 so žltými stoličkami a priamym vstupom do záhrady v Kisapáti",
      title: "Terasa Dandelion D2"
    }
  } satisfies Record<PoolRulesLocale, { alt: string; title: string }>;

  if (key === "d2") {
    const d2CardImage = requireAccommodationLocalAssetPath(
      "d2",
      "card",
      "dandelion-d2-kisapati-card-01.webp",
      "panorama pool D2 stay card image"
    );

    return {
      desktopSrc: d2CardImage,
      mobileSrc: d2CardImage,
      alt: localizedD2CardCopy[locale].alt,
      title: localizedD2CardCopy[locale].title
    };
  }

  const pageDataMap = {
    d1: d1PageData,
    d2: d2PageData,
    fugehaz: fugehazPageData
  } as const;
  const pageData = pageDataMap[key];
  const fallbackTitleMap = {
    hu: {
      d1: "Dandelion D1",
      d2: "Dandelion D2",
      fugehaz: "Fügeház"
    },
    en: {
      d1: "Dandelion D1",
      d2: "Dandelion D2",
      fugehaz: "Fugehaz"
    },
    de: {
      d1: "Dandelion D1",
      d2: "Dandelion D2",
      fugehaz: "Fügeház"
    },
    cs: {
      d1: "Dandelion D1",
      d2: "Dandelion D2",
      fugehaz: "Fügeház"
    },
    sk: {
      d1: "Dandelion D1",
      d2: "Dandelion D2",
      fugehaz: "Fügeház"
    }
  } as const;
  const localizedAltKey = {
    hu: "altHu",
    en: "altEn",
    de: "altDe",
    cs: "altCs",
    sk: "altSk"
  } as const;

  return {
    desktopSrc: pageData.hero.mobileImagePath,
    mobileSrc: pageData.hero.mobileImagePath,
    alt: heroImage[localizedAltKey[locale]],
    title: fallbackTitleMap[locale][key]
  };
};

const staysByLocale = {
  hu: [
    {
      title: "Dandelion D1",
      href: resolveHref("/dandelion-d1/"),
      image: getStayImage("d1"),
      description: "3 hálószoba + nappali, akár 8 fő. Légkondicionált, pergola, 2 fürdőszoba.",
      location: "Kisapáti / Balaton-felvidék",
      highlights: ["6-8 fő", "3 szoba + nappali"]
    },
    {
      title: "Dandelion D2",
      href: resolveHref("/dandelion-d2/"),
      image: getStayImage("d2"),
      description: "4-6 főnek kényelmes. Légkondicionált, nagy terasz és udvar.",
      location: "Kisapáti / Balaton-felvidék",
      highlights: ["4-6 fő", "2 háló + nappali"]
    },
    {
      title: "Fügeház",
      href: resolveHref("/fuge/"),
      image: getStayImage("fugehaz"),
      description: "4 főre kényelmes, pótággyal akár 6 fő. Légkondicionált, terasz a tanúhegyekre.",
      location: "Szent György-hegy közelében",
      highlights: ["4-6 fő", "2 szint / 2 szoba"]
    }
  ],
  en: [
    {
      title: "Dandelion D1",
      href: resolveHref("/en/dandelion-d1/"),
      image: getStayImage("d1"),
      description: "3 bedrooms + living room, up to 8 guests. Air-conditioned, pergola, 2 bathrooms.",
      location: "Kisapáti / Balaton Uplands",
      highlights: ["6-8 guests", "3 bedrooms + living room"]
    },
    {
      title: "Dandelion D2",
      href: resolveHref("/en/dandelion-d2/"),
      image: getStayImage("d2"),
      description: "Comfortable for 4-6 guests. Air-conditioned, large terrace and garden.",
      location: "Kisapáti / Balaton Uplands",
      highlights: ["4-6 guests", "2 bedrooms + living room"]
    },
    {
      title: "Fügeház",
      href: resolveHref("/en/dandelion-fugehaz/"),
      image: getStayImage("fugehaz"),
      description: "Comfortable for 4 guests, extendable up to 6 with an extra bed. Air-conditioned, terrace with open hillside views.",
      location: "Near Szent György Hill",
      highlights: ["4-6 guests", "2 levels / 2 rooms"]
    }
  ],
  de: [
    {
      title: "Dandelion D1",
      href: resolveHref("/de/dandelion-d1/"),
      image: getStayImage("d1"),
      description: "3 Schlafzimmer + Wohnzimmer, bis zu 8 Gäste. Klimaanlage, Pergola, 2 Badezimmer.",
      location: "Kisapáti / Balaton-Oberland",
      highlights: ["6-8 Gäste", "3 Schlafzimmer + Wohnzimmer"]
    },
    {
      title: "Dandelion D2",
      href: resolveHref("/de/dandelion-d2/"),
      image: getStayImage("d2"),
      description: "Bequem für 4-6 Gäste. Klimaanlage, große Terrasse und Garten.",
      location: "Kisapáti / Balaton-Oberland",
      highlights: ["4-6 Gäste", "2 Schlafzimmer + Wohnzimmer"]
    },
    {
      title: "Fügeház",
      href: resolveHref("/de/dandelion-fugehaz/"),
      image: getStayImage("fugehaz"),
      description: "Bequem für 4 Gäste, mit Zusatzbett bis zu 6. Klimaanlage, Terrasse mit offenem Blick in die Hügellandschaft.",
      location: "Nahe dem Szent György-hegy",
      highlights: ["4-6 Gäste", "2 Ebenen / 2 Zimmer"]
    }
  ],
  cs: [
    {
      title: "Dandelion D1",
      href: resolveHref("/cs/dandelion-d1/"),
      image: getStayImage("d1"),
      description: "3 ložnice + obývací pokoj, až pro 8 hostů. Klimatizace, pergola, 2 koupelny.",
      location: "Kisapáti / Balatonská vrchovina",
      highlights: ["6-8 hostů", "3 ložnice + obývací pokoj"]
    },
    {
      title: "Dandelion D2",
      href: resolveHref("/cs/dandelion-d2/"),
      image: getStayImage("d2"),
      description: "Pohodlné pro 4-6 hostů. Klimatizace, velká terasa a zahrada.",
      location: "Kisapáti / Balatonská vrchovina",
      highlights: ["4-6 hostů", "2 ložnice + obývací pokoj"]
    },
    {
      title: "Fügeház",
      href: resolveHref("/cs/dandelion-fugehaz/"),
      image: getStayImage("fugehaz"),
      description: "Pohodlné pro 4 hosty, s přistýlkou až pro 6. Klimatizace a terasa s otevřeným výhledem do krajiny.",
      location: "Blízko Szent György-hegy",
      highlights: ["4-6 hostů", "2 podlaží / 2 pokoje"]
    }
  ],
  sk: [
    {
      title: "Dandelion D1",
      href: resolveHref("/sk/dandelion-d1/"),
      image: getStayImage("d1"),
      description: "3 spálne + obývačka, až pre 8 hostí. Klimatizácia, pergola, 2 kúpeľne.",
      location: "Kisapáti / Balatonská vrchovina",
      highlights: ["6-8 hostí", "3 spálne + obývačka"]
    },
    {
      title: "Dandelion D2",
      href: resolveHref("/sk/dandelion-d2/"),
      image: getStayImage("d2"),
      description: "Pohodlné pre 4-6 hostí. Klimatizácia, veľká terasa a záhrada.",
      location: "Kisapáti / Balatonská vrchovina",
      highlights: ["4-6 hostí", "2 spálne + obývačka"]
    },
    {
      title: "Fügeház",
      href: resolveHref("/sk/dandelion-fugehaz/"),
      image: getStayImage("fugehaz"),
      description: "Pohodlné pre 4 hostí, s prístelkou až pre 6. Klimatizácia a terasa s otvoreným výhľadom do krajiny.",
      location: "Blízko Szent György-hegy",
      highlights: ["4-6 hostí", "2 podlažia / 2 izby"]
    }
  ]
};
const stays = staysByLocale[locale];

const localizedAltKey = {
  hu: "altHu",
  en: "altEn",
  de: "altDe",
  cs: "altCs",
  sk: "altSk"
} as const;
const localizedHeroAlt = heroImage[localizedAltKey[locale]];
const poolTemperatureFallback = pageText.fallbackText;
const poolLiveWidgetSrc = import.meta.env.DEV
  ? "http://127.0.0.1:8091/api/pool-live-widget.php"
  : "/api/pool-live-widget.php";
const poolRulesContent = getPoolRulesContent(locale);
const poolClientText = {
  fallbackText: pageText.fallbackText,
  airPrefix: pageText.airPrefix,
  updatedPrefix: pageText.updatedPrefix,
  localeCode: pageText.schemaLanguage
};
---

<BaseLayout
  title={pageText.pageTitle}
  description={pageText.pageDescription}
  canonicalPath={pageText.canonicalPath}
  ogImage={panoramaPoolHero.desktop}
  ogImageAlt={localizedHeroAlt}
  structuredData={poolStructuredData}
  lang={pageText.lang}
  ogLocale={pageText.ogLocale}
>
  <section class="pool-page" data-page="panorama-pool" data-locale={locale}>
    <Hero
      kicker="Panorama Pool"
      title={pageText.heroTitle}
      description={pageText.heroDescription}
      ctas={[{ label: pageText.ctaPrimary, href: "#pool-stays" }]}
      secondaryCtas={[{ label: pageText.ctaSecondary, href: "#pool-stays" }]}
      videoSrc=""
      videoDesktopSrc={poolHeroVideos.desktop}
      videoMobileSrc={poolHeroVideos.mobile}
      posterDesktopSrc={panoramaPoolHero.desktop}
      posterMobileSrc={panoramaPoolHero.mobile}
      posterAlt={localizedHeroAlt}
      videoFallbackText={pageText.videoFallbackText}
      overlay={true}
    >
      <aside
        slot="aside"
        class="pool-temperature pool-temperature--hero"
        data-pool-temperature
        data-endpoint="/api/pool-temperature.json"
        aria-live="polite"
      >
        <span class="pool-temperature__label">{pageText.waterLabel}</span>
        <p class="pool-temperature__value" data-pool-temperature-value>{poolTemperatureFallback}</p>
        <p class="pool-temperature__air" data-pool-air-temperature hidden></p>
        <p class="pool-temperature__updated" data-pool-temperature-updated hidden></p>
      </aside>
    </Hero>

    <section class="pool-section pool-section--live">
      <div class="dnd-container pool-shell">
        <div class="pool-live-panel" aria-live="polite">
          <div class="pool-section-heading pool-live-panel__heading">
            <span class="pool-eyebrow">Panorama Pool</span>
            <h2>{pageText.liveTitle}</h2>
          </div>

          <iframe
            class="pool-live-frame"
            src={poolLiveWidgetSrc}
            data-src-default={poolLiveWidgetSrc}
            data-src-compact={`${poolLiveWidgetSrc}${poolLiveWidgetSrc.includes("?") ? "&" : "?"}compact=1`}
            title={pageText.liveFrameTitle}
            loading="lazy"
            scrolling="no"
          ></iframe>

          <div class="pool-live-compact" aria-hidden="true">
            <div class="pool-live-compact__item pool-live-compact__item--water">
              <span class="pool-live-compact__label">{pageText.compactWater}</span>
              <strong data-pool-compact-value="temperature">{poolTemperatureFallback}</strong>
            </div>
            <div class="pool-live-compact__item">
              <span class="pool-live-compact__label">{pageText.compactAir}</span>
              <strong data-pool-compact-value="air">{poolTemperatureFallback}</strong>
            </div>
            <div class="pool-live-compact__item">
              <span class="pool-live-compact__label">{pageText.compactHumidity}</span>
              <strong data-pool-compact-value="humidity">{poolTemperatureFallback}</strong>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="pool-section pool-section--intro pool-section--info">
      <div class="dnd-container pool-shell pool-info-layout">
        <div class="pool-intro">
          <span class="pool-eyebrow">{pageText.introEyebrow}</span>
          <h2>{pageText.introTitle}</h2>
          <p>{pageText.introBody}</p>
          <p class="pool-intro__summary">{pageText.geoSummary}</p>
          <div class="pool-quick-facts" aria-label={pageText.quickFactsTitle}>
            {pageText.quickFacts.map((fact) => (
              <div class="pool-quick-facts__item">
                <span class="pool-quick-facts__label">{fact.label}</span>
                <strong class="pool-quick-facts__value">{fact.value}</strong>
              </div>
            ))}
          </div>
          <a class="pool-text-link pool-intro__cta" href={pageText.poolLandingHref}>{pageText.introCta}</a>
        </div>
        <aside class="pool-geo-faq" aria-labelledby="pool-geo-faq-title">
          <span class="pool-eyebrow">{pageText.faqEyebrow}</span>
          <h2 id="pool-geo-faq-title">{pageText.faqTitle}</h2>
          <div class="pool-geo-faq__list">
            {pageText.faqItems.map((item) => (
              <details class="pool-geo-faq__item">
                <summary>
                  <h3>{item.question}</h3>
                  <span class="pool-geo-faq__toggle">{pageText.faqToggle}</span>
                </summary>
                <p>{item.answer}</p>
              </details>
            ))}
          </div>
        </aside>
      </div>
    </section>

    <section id="pool-stays" class="pool-section pool-section--stays">
      <div class="dnd-container pool-shell pool-section-shell">
        <div class="pool-stays">
          {stays.map((stay) => (
            <a href={stay.href} class="pool-stay-card">
              <figure class="pool-stay-card__media">
                <picture>
                  {stay.image.mobileSrc && <source media="(max-width: 767px)" srcset={stay.image.mobileSrc} />}
                  <img
                    src={stay.image.desktopSrc}
                    alt={stay.image.alt}
                    title={stay.image.title}
                    width="1600"
                    height="1200"
                    loading="lazy"
                    decoding="async"
                  />
                </picture>
              </figure>
              <div class="pool-stay-card__body">
                <h3>{stay.title}</h3>
                <span class="pool-stay-card__location">{stay.location}</span>
                <div class="pool-stay-card__highlights" aria-label={`${stay.title} ${pageText.stayHighlightsAriaSuffix}`}>
                  {stay.highlights.map((highlight) => (
                    <span class="pool-stay-card__chip">{highlight}</span>
                  ))}
                </div>
                <p>{stay.description}</p>
                <span class="pool-stay-card__cta">{pageText.stayCta}</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <PoolGalleryLightbox images={galleryImages} locale={locale} ariaLabel={pageText.galleryAria} />
    <PoolRulesSection content={poolRulesContent} />

    <section class="pool-section pool-section--closing">
      <div class="dnd-container pool-shell">
        <div class="pool-closing">
          <span class="pool-eyebrow">{pageText.closingEyebrow}</span>
          <h2>{pageText.closingTitle}</h2>
          <p>{pageText.closingBody}</p>
          <a href="#pool-stays" class="pool-button">{pageText.closingCta}</a>
        </div>
      </div>
    </section>
  </section>

  <script define:vars={{ poolClientText }}>
    (() => {
      const applyPoolHeaderState = () => {
        const header = document.querySelector("[data-dnd-header]");
        if (header) {
          header.classList.toggle("is-pool-visible", window.scrollY > 12);
        }
      };

      const applyPoolLiveCompactState = () => {
        const liveSection = document.querySelector(".pool-section--live");
        const liveFrame = liveSection ? liveSection.querySelector(".pool-live-frame") : null;
        const heroSection = document.querySelector(".pool-page .dnd-hero");
        if (!liveSection || !liveFrame) return;

        const isMobile = window.matchMedia("(max-width: 767px)").matches;
        const heroBottom = heroSection ? heroSection.getBoundingClientRect().bottom : Number.POSITIVE_INFINITY;
        const shouldCompact = isMobile && heroBottom <= 72;
        liveSection.classList.toggle("is-compact", shouldCompact);
      };

      const refreshIntervalMs = 5 * 60 * 1000;

      const updatePoolTemperature = async () => {
        const widget = document.querySelector("[data-pool-temperature]");
        const valueNode = widget ? widget.querySelector("[data-pool-temperature-value]") : null;
        const airValueNode = widget ? widget.querySelector("[data-pool-air-temperature]") : null;
        const updatedNode = widget ? widget.querySelector("[data-pool-temperature-updated]") : null;
        const compactTemperatureNode = document.querySelector("[data-pool-compact-value='temperature']");
        const compactAirNode = document.querySelector("[data-pool-compact-value='air']");
        const compactHumidityNode = document.querySelector("[data-pool-compact-value='humidity']");
        const endpoint = widget ? widget.getAttribute("data-endpoint") || "/api/pool-temperature.json" : "/api/pool-temperature.json";
        const fallbackText = poolClientText.fallbackText;
        const localeCode = poolClientText.localeCode;
        const buildEndpointUrl = () => {
          const url = new URL(endpoint, window.location.href);
          url.searchParams.set("refresh", Date.now().toString());
          return url.toString();
        };
        const formatMeasurement = (value, locale, options = {}) => {
          const numericValue = typeof value === "number" || typeof value === "string" ? Number(value) : Number.NaN;
          if (!Number.isFinite(numericValue)) return "";

          return numericValue.toLocaleString(locale, {
            minimumFractionDigits: 1,
            maximumFractionDigits: 1,
            ...options
          });
        };

        try {
          const response = await fetch(buildEndpointUrl(), {
            headers: { Accept: "application/json" },
            cache: "no-store"
          });

          if (!response.ok) {
            throw new Error("Pool temperature is unavailable.");
          }

          const data = await response.json();
          const rawTemperature = data.temperature;
          const temperature =
            typeof rawTemperature === "number" || typeof rawTemperature === "string" ? Number(rawTemperature) : Number.NaN;

          if (!Number.isFinite(temperature)) {
            throw new Error("Pool temperature is invalid.");
          }

          const unit = typeof data.unit === "string" && data.unit.trim() ? data.unit.trim() : "°C";
          const rawAirTemperature =
            data.airTemperature !== undefined && data.airTemperature !== null
              ? data.airTemperature
              : data.air_temperature !== undefined && data.air_temperature !== null
                ? data.air_temperature
                : data.outdoorTemperature;
          const airTemperature =
            typeof rawAirTemperature === "number" || typeof rawAirTemperature === "string"
              ? Number(rawAirTemperature)
              : Number.NaN;
          const airUnit = typeof data.airUnit === "string" && data.airUnit.trim() ? data.airUnit.trim() : unit;
          const formattedTemperature = formatMeasurement(temperature, localeCode);
          const formattedAirTemperature = formatMeasurement(airTemperature, localeCode);
          const updatedAt = typeof data.updatedAt === "string" ? new Date(data.updatedAt) : null;
          const hasValidUpdatedAt = Boolean(updatedAt && !Number.isNaN(updatedAt.getTime()));

          if (widget) {
            widget.classList.add("has-temperature");
          }
          if (valueNode) {
            valueNode.textContent = `${formattedTemperature} ${unit}`;
          }
          if (compactTemperatureNode) {
            compactTemperatureNode.textContent = `${formattedTemperature} ${unit}`;
          }
          if (Number.isFinite(airTemperature)) {
            if (widget) {
              widget.classList.add("has-air-temperature");
            }
            if (airValueNode) {
              airValueNode.textContent = `${poolClientText.airPrefix}: ${formattedAirTemperature} ${airUnit}`;
              airValueNode.removeAttribute("hidden");
            }
            if (compactAirNode) {
              compactAirNode.textContent = `${formattedAirTemperature} ${airUnit}`;
            }
          } else {
            if (widget) {
              widget.classList.remove("has-air-temperature");
            }
            if (airValueNode) {
              airValueNode.setAttribute("hidden", "");
            }
            if (compactAirNode) {
              compactAirNode.textContent = fallbackText;
            }
          }

          const rawHumidity = data.humidity;
          const humidity =
            typeof rawHumidity === "number" || typeof rawHumidity === "string" ? Number(rawHumidity) : Number.NaN;
          const humidityUnit = typeof data.humidityUnit === "string" && data.humidityUnit.trim() ? data.humidityUnit.trim() : "%";
          if (compactHumidityNode) {
            compactHumidityNode.textContent = Number.isFinite(humidity)
              ? `${formatMeasurement(humidity, localeCode, { minimumFractionDigits: 0, maximumFractionDigits: 0 })} ${humidityUnit}`
              : fallbackText;
          }

          if (updatedNode) {
            if (hasValidUpdatedAt) {
              const updatedText = `${poolClientText.updatedPrefix}: ${updatedAt.toLocaleTimeString(localeCode, {
                hour: "2-digit",
                minute: "2-digit"
              })}`;
              updatedNode.textContent = updatedText;
              updatedNode.removeAttribute("hidden");
            } else {
              updatedNode.setAttribute("hidden", "");
            }
          }
        } catch {
          if (widget) {
            widget.classList.remove("has-temperature");
            widget.classList.remove("has-air-temperature");
          }
          if (valueNode) valueNode.textContent = fallbackText;
          if (compactTemperatureNode) compactTemperatureNode.textContent = fallbackText;
          if (airValueNode) {
            airValueNode.setAttribute("hidden", "");
          }
          if (compactAirNode) compactAirNode.textContent = fallbackText;
          if (compactHumidityNode) compactHumidityNode.textContent = fallbackText;
          if (updatedNode) {
            updatedNode.setAttribute("hidden", "");
          }
        }
      };

      if (document.readyState === "loading") {
        document.addEventListener(
          "DOMContentLoaded",
          () => {
            applyPoolHeaderState();
            applyPoolLiveCompactState();
            updatePoolTemperature();
            window.setInterval(updatePoolTemperature, refreshIntervalMs);
            window.addEventListener("scroll", applyPoolHeaderState, { passive: true });
            window.addEventListener("scroll", applyPoolLiveCompactState, { passive: true });
            window.addEventListener("resize", applyPoolLiveCompactState, { passive: true });
          },
          { once: true }
        );
      } else {
        applyPoolHeaderState();
        applyPoolLiveCompactState();
        updatePoolTemperature();
        window.setInterval(updatePoolTemperature, refreshIntervalMs);
        window.addEventListener("scroll", applyPoolHeaderState, { passive: true });
        window.addEventListener("scroll", applyPoolLiveCompactState, { passive: true });
        window.addEventListener("resize", applyPoolLiveCompactState, { passive: true });
      }
    })();
  </script>
</BaseLayout>

<style>
  :global(.dnd-header.is-pool-visible) {
    background: rgba(239, 228, 211, 0.94);
    border-bottom: 1px solid rgba(111, 87, 59, 0.1);
    box-shadow: 0 14px 34px rgba(79, 52, 29, 0.08);
    color: #2d241c;
    backdrop-filter: blur(12px);
  }

  :global(.dnd-header.is-pool-visible .dnd-logo img) {
    filter: none;
  }

  :global(.dnd-header.is-pool-visible .dnd-header__contact a) {
    border-color: rgba(94, 65, 39, 0.18);
    background: rgba(255, 252, 246, 0.22);
  }

  :global(.dnd-header.is-pool-visible .dnd-header__contact a:hover),
  :global(.dnd-header.is-pool-visible .dnd-header__contact a:focus-visible) {
    border-color: rgba(94, 65, 39, 0.36);
    background: rgba(255, 252, 246, 0.56);
  }

  :global(.dnd-header.is-pool-visible .dnd-nav) {
    border-top-color: rgba(94, 65, 39, 0.12);
  }

  :global(.dnd-header.is-pool-visible .dnd-header-cta) {
    border-color: rgba(94, 65, 39, 0.16);
    background: rgba(255, 252, 246, 0.46);
