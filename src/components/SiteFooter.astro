---
import { accommodations } from "../data/accommodations";

// [CHANGE 2026-05-20 00:00] English footer copy and safe English links added while preserving the Hungarian footer layout.
interface Props {
  lang?: "hu" | "en" | "de" | "sk" | "pl" | "cs";
}

const { lang = "hu" } = Astro.props as Props;
const isEnglishFooter = lang === "en";
const isGermanFooter = lang === "de";

const homeHref = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const resolveLocalHref = (href: string) => {
  if (href.startsWith("http")) {
    return href;
  }

  return href.startsWith("/") ? `${homeHref}${href.replace(/^\/+/, "")}` : `${homeHref}${href}`;
};

const buildStayHref = (slug: string, url: string) =>
  slug === "dandelion-d2"
    ? `${homeHref}dandelion-d2/`
    : slug === "fugehaz"
      ? `${homeHref}fuge/`
      : slug === "royal-homes"
        ? `${homeHref}royal/`
        : resolveLocalHref(url);

const footerStayLabelOverrides: Record<string, string> = {
  fugehaz: "Dandelion Fügeház",
  "vintage-vendeghaz": "Dandelion Vintage"
};

const footerStayBySlug = new Map(
  accommodations.map((stay) => [
    stay.slug,
    {
      label: footerStayLabelOverrides[stay.slug] ?? stay.name,
      href: buildStayHref(stay.slug, stay.url)
    }
  ])
);

const footerStayColumns = [
  ["dandelion-d1", "dandelion-d2", "fugehaz", "szololiget-vendeghaz"],
  ["zsalya-vendeghaz", "vintage-vendeghaz", "royal-homes", "szepvolgyi-vendeghaz", "dandelion-koveskal"]
].map((column) =>
  column
    .map((slug) => footerStayBySlug.get(slug))
    .filter((stay): stay is { label: string; href: string } => Boolean(stay))
);

const englishStayHrefOverrides: Record<string, string> = {
  "dandelion-d1": `${homeHref}en/dandelion-d1/`,
  "dandelion-d2": `${homeHref}en/dandelion-d2/`,
  fugehaz: `${homeHref}en/dandelion-fugehaz/`,
  "szololiget-vendeghaz": `${homeHref}en/szololiget/`,
  "zsalya-vendeghaz": `${homeHref}en/dandelion-zsalya/`,
  "vintage-vendeghaz": `${homeHref}en/dandelion-vintage/`,
  "royal-homes": `${homeHref}en/royal/`,
  "szepvolgyi-vendeghaz": `${homeHref}en/szepvolgyi/`,
  "dandelion-koveskal": `${homeHref}en/dandelion-koveskal/`
};

const englishStayLabelOverrides: Record<string, string> = {
  fugehaz: "Dandelion Fugehaz",
  "zsalya-vendeghaz": "Dandelion Zsalya",
  "szololiget-vendeghaz": "Dandelion Szololiget",
  "szepvolgyi-vendeghaz": "Dandelion Szepvolgyi",
  "vintage-vendeghaz": "Dandelion Vintage"
};

const englishFooterStayBySlug = new Map(
  accommodations.map((stay) => [
    stay.slug,
    {
      label: englishStayLabelOverrides[stay.slug] ?? footerStayLabelOverrides[stay.slug] ?? stay.name,
      href: englishStayHrefOverrides[stay.slug] ?? buildStayHref(stay.slug, stay.url)
    }
  ])
);

const englishFooterStayColumns = [
  ["dandelion-d1", "dandelion-d2", "fugehaz", "szololiget-vendeghaz"],
  ["zsalya-vendeghaz", "vintage-vendeghaz", "royal-homes", "szepvolgyi-vendeghaz", "dandelion-koveskal"]
].map((column) =>
  column
    .map((slug) => englishFooterStayBySlug.get(slug))
    .filter((stay): stay is { label: string; href: string } => Boolean(stay))
);

const germanStayHrefOverrides: Record<string, string> = {
  "dandelion-d1": `${homeHref}de/unterkuenfte/#dandelion-d1`,
  "dandelion-d2": `${homeHref}de/unterkuenfte/#dandelion-d2`,
  fugehaz: `${homeHref}de/unterkuenfte/#fugehaz`,
  "szololiget-vendeghaz": `${homeHref}de/unterkuenfte/#szololiget-vendeghaz`,
  "zsalya-vendeghaz": `${homeHref}de/unterkuenfte/#zsalya-vendeghaz`,
  "vintage-vendeghaz": `${homeHref}de/unterkuenfte/#vintage-vendeghaz`,
  "royal-homes": `${homeHref}de/unterkuenfte/#royal-homes`,
  "szepvolgyi-vendeghaz": `${homeHref}de/unterkuenfte/#szepvolgyi-vendeghaz`,
  "dandelion-koveskal": `${homeHref}de/unterkuenfte/#dandelion-koveskal`
};

const germanStayLabelOverrides: Record<string, string> = {
  fugehaz: "Dandelion Fugehaz",
  "zsalya-vendeghaz": "Dandelion Zsalya",
  "szololiget-vendeghaz": "Dandelion Szololiget",
  "szepvolgyi-vendeghaz": "Dandelion Szepvolgyi",
  "vintage-vendeghaz": "Dandelion Vintage"
};

const germanFooterStayBySlug = new Map(
  accommodations.map((stay) => [
    stay.slug,
    {
      label: germanStayLabelOverrides[stay.slug] ?? footerStayLabelOverrides[stay.slug] ?? stay.name,
      href: germanStayHrefOverrides[stay.slug] ?? buildStayHref(stay.slug, stay.url)
    }
  ])
);

const germanFooterStayColumns = [
  ["dandelion-d1", "dandelion-d2", "fugehaz", "szololiget-vendeghaz"],
  ["zsalya-vendeghaz", "vintage-vendeghaz", "royal-homes", "szepvolgyi-vendeghaz", "dandelion-koveskal"]
].map((column) =>
  column
    .map((slug) => germanFooterStayBySlug.get(slug))
    .filter((stay): stay is { label: string; href: string } => Boolean(stay))
);

const bookingLanguage = isEnglishFooter ? "En" : "Hu";
const bookingHref = isGermanFooter
  ? `${homeHref}de/kontakt/`
  : `https://ibe.sabeeapp.com/v3/p/Dandelion-Vendégházak?p=3970b30e1042d58f&lang=${bookingLanguage}`;
const englishFooterNav = [
  { label: "Home", href: `${homeHref}en/` },
  { label: "Accommodations", href: `${homeHref}en/szallasok/` },
  { label: "Experiences", href: `${homeHref}en/experiences/` },
  { label: "Contact", href: `${homeHref}en/contact/` }
];
const englishLanguageLinks = [
  { label: "HU", href: homeHref },
  { label: "EN", href: `${homeHref}en/` }
];
const englishLegalLinks = [
  { label: "Terms and Conditions", href: `${homeHref}en/terms-and-conditions/` },
  { label: "Privacy Policy", href: `${homeHref}en/privacy-policy/` },
  { label: "Imprint", href: `${homeHref}en/imprint/` }
];
const germanFooterNav = [
  { label: "Startseite", href: `${homeHref}de/` },
  { label: "Unterkunfte", href: `${homeHref}de/unterkuenfte/` },
  { label: "Erlebnisse", href: `${homeHref}de/` },
  { label: "Kontakt", href: `${homeHref}de/kontakt/` }
];
const germanLanguageLinks = [
  { label: "HU", href: homeHref },
  { label: "EN", href: `${homeHref}en/` },
  { label: "DE", href: `${homeHref}de/` }
];
---

<footer class="dnd-site-footer" aria-labelledby="site-footer-title">
  <div class="dnd-container dnd-site-footer__inner">
    <div class="dnd-site-footer__brand">
      <a href={isGermanFooter ? `${homeHref}de/` : isEnglishFooter ? `${homeHref}en/` : homeHref} class="dnd-site-footer__brand-link" aria-label={isGermanFooter ? "Dandelion Gastehauser Startseite" : isEnglishFooter ? "Dandelion Guesthouses home" : "Dandelion Vendégházak főoldal"}>
        {isGermanFooter ? "Dandelion Gastehauser" : isEnglishFooter ? "Dandelion Guesthouses" : "Dandelion Vendégházak"}
      </a>
      <p id="site-footer-title">
        {isGermanFooter
          ? "Ruhige Gastehauser und Apartments im Balaton-Oberland."
          : isEnglishFooter
          ? "Peaceful countryside guesthouses and apartments in the Balaton Uplands."
          : "Természetközeli vendégházak a Balaton-felvidéken, családoknak, pároknak és nyugodt elvonuláshoz."}
      </p>
    </div>

    {isGermanFooter ? (
      <nav class="dnd-site-footer__group dnd-site-footer__group--stays" aria-label="Unterkunfte">
        <h2>Unterkunfte</h2>
        <div class="dnd-site-footer__stay-columns">
          {germanFooterStayColumns.map((column) => (
            <ul>
              {column.map((stay) => (
                <li><a href={stay.href}>{stay.label}</a></li>
              ))}
            </ul>
          ))}
        </div>
      </nav>
    ) : isEnglishFooter ? (
      <nav class="dnd-site-footer__group dnd-site-footer__group--stays" aria-label="Accommodations">
        <h2>Accommodations</h2>
        <div class="dnd-site-footer__stay-columns">
          {englishFooterStayColumns.map((column) => (
            <ul>
              {column.map((stay) => (
                <li><a href={stay.href}>{stay.label}</a></li>
              ))}
            </ul>
          ))}
        </div>
      </nav>
    ) : (
      <nav class="dnd-site-footer__group dnd-site-footer__group--stays" aria-label="Szállások">
        <h2>Szállások</h2>
        <div class="dnd-site-footer__stay-columns">
          {footerStayColumns.map((column) => (
            <ul>
              {column.map((stay) => (
                <li><a href={stay.href}>{stay.label}</a></li>
              ))}
            </ul>
          ))}
        </div>
      </nav>
    )}

    {isGermanFooter ? (
      <nav class="dnd-site-footer__group" aria-label="Buchung">
        <h2>Nutzliche Links</h2>
        <ul>
          {germanFooterNav.map((item) => (
            <li><a href={item.href}>{item.label}</a></li>
          ))}
          <li><a href={bookingHref}>Verfugbarkeit prufen</a></li>
          <li><a href={bookingHref}>Jetzt buchen</a></li>
        </ul>
      </nav>
    ) : isEnglishFooter ? (
      <nav class="dnd-site-footer__group" aria-label="Booking">
        <h2>Useful links</h2>
        <ul>
          {englishFooterNav.map((item) => (
            <li><a href={item.href}>{item.label}</a></li>
          ))}
          <li><a href={bookingHref}>Check availability</a></li>
          <li><a href={bookingHref}>Book now</a></li>
        </ul>
      </nav>
    ) : (
      <nav class="dnd-site-footer__group" aria-label="Hasznos linkek">
        <h2>Hasznos linkek</h2>
        <ul>
          <li><a href={resolveLocalHref("/")}>Főoldal</a></li>
          <li><a href={resolveLocalHref("/szallasok/")}>Szállások</a></li>
          <li><a href={resolveLocalHref("/#elmenyek")}>Élmények</a></li>
          <li><a href={resolveLocalHref("/kapcsolat/")}>Kapcsolat</a></li>
          <li><a href={bookingHref}>Foglalás</a></li>
        </ul>
      </nav>
    )}

    {isGermanFooter ? (
      <nav class="dnd-site-footer__group" aria-label="Sprachen">
        <h2>Sprachen</h2>
        <ul>
          {germanLanguageLinks.map((item) => (
            <li class="dnd-site-footer__language-link"><a href={item.href}>{item.label}</a></li>
          ))}
        </ul>
      </nav>
    ) : isEnglishFooter ? (
      <nav class="dnd-site-footer__group" aria-label="Languages">
        <h2>Legal</h2>
        <ul>
          {englishLegalLinks.map((item) => (
            <li><a href={item.href}>{item.label}</a></li>
          ))}
          {englishLanguageLinks.map((item) => (
            <li class="dnd-site-footer__language-link"><a href={item.href}>{item.label}</a></li>
          ))}
        </ul>
      </nav>
    ) : (
      <nav class="dnd-site-footer__group" aria-label="Jogi információk">
        <h2>Jogi</h2>
        <ul>
          <li><a href={resolveLocalHref("/aszf/")}>ÁSZF</a></li>
          <li><a href={resolveLocalHref("/adatkezelesi-tajekoztato/")}>Adatkezelési tájékoztató</a></li>
          <li><a href={resolveLocalHref("/impresszum/")}>Impresszum</a></li>
        </ul>
      </nav>
    )}
  </div>

  <div class="dnd-container dnd-site-footer__bottom">
    <span>© {isGermanFooter ? "Dandelion Gastehauser" : isEnglishFooter ? "Dandelion Guesthouses" : "Dandelion Vendégházak"}</span>
  </div>
</footer>

<style>
  .dnd-site-footer {
    margin-top: 32px;
    padding: 56px 0 22px;
    background: linear-gradient(180deg, #201913 0%, #17120e 100%);
    color: rgba(253, 251, 247, 0.88);
    border-top: 1px solid rgba(217, 158, 43, 0.14);
  }

  .dnd-site-footer__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) repeat(3, minmax(0, 0.85fr));
    gap: clamp(28px, 4vw, 48px);
    align-items: start;
  }

  .dnd-site-footer__brand {
    max-width: 360px;
  }

  .dnd-site-footer__brand-link {
    display: inline-flex;
    margin-bottom: 14px;
    color: #fdfbf7;
    font-family: var(--dnd-font-display);
    font-size: clamp(1.25rem, 1.65vw, 1.55rem);
    line-height: 1.12;
    font-weight: 500;
  }

  .dnd-site-footer__brand p {
    margin: 0;
    color: rgba(253, 251, 247, 0.72);
    font-size: var(--dnd-text-md);
    line-height: 1.7;
  }

  .dnd-site-footer__group h2 {
    margin: 0 0 14px;
    color: rgba(217, 158, 43, 0.96);
    font-size: var(--dnd-text-xs);
    font-weight: 700;
    letter-spacing: var(--dnd-tracking-wide);
    line-height: 1.4;
    text-transform: uppercase;
  }

  .dnd-site-footer__group ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .dnd-site-footer__stay-columns {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px 24px;
  }

  .dnd-site-footer__group li + li {
    margin-top: 10px;
  }

  .dnd-site-footer__group a {
    display: inline-flex;
    color: rgba(253, 251, 247, 0.82);
    font-size: var(--dnd-text-md);
    line-height: 1.45;
    transition: color 0.18s ease, transform 0.18s ease;
  }

  .dnd-site-footer__group a:hover,
  .dnd-site-footer__group a:focus-visible {
    color: #fdfbf7;
    transform: translateX(1px);
  }

  .dnd-site-footer__bottom {
    margin-top: 34px;
    padding-top: 16px;
    border-top: 1px solid rgba(253, 251, 247, 0.08);
    color: rgba(253, 251, 247, 0.58);
    font-size: var(--dnd-text-xs);
    line-height: 1.45;
  }

  @media (max-width: 960px) {
    .dnd-site-footer {
      padding: 44px 0 20px;
    }

    .dnd-site-footer__inner {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .dnd-site-footer__brand {
      max-width: none;
      grid-column: 1 / -1;
    }

    .dnd-site-footer__group--stays {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 720px) {
    .dnd-site-footer {
      margin-top: 24px;
      padding: 40px 0 18px;
    }

    .dnd-site-footer__inner {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 22px;
    }

    .dnd-site-footer__brand {
      grid-column: 1 / -1;
      text-align: center;
      justify-self: center;
    }

    .dnd-site-footer__group h2 {
      margin-bottom: 10px;
    }

    .dnd-site-footer__stay-columns {
      gap: 12px 18px;
    }

    .dnd-site-footer__group li + li {
      margin-top: 8px;
    }

    .dnd-site-footer__group a {
      font-size: var(--dnd-text-md);
    }

    .dnd-site-footer__bottom {
      margin-top: 26px;
      padding-top: 14px;
    }
  }
</style>
