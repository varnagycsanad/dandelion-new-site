</style>

<script>
  const newsletterDialog = document.querySelector("[data-newsletter-dialog]");
  const newsletterEmail = newsletterDialog?.querySelector("[data-newsletter-email]");
  const newsletterForm = newsletterDialog?.querySelector("[data-newsletter-submit]");
  const newsletterSuccess = newsletterDialog?.querySelector("[data-newsletter-success]");
  const newsletterResponse = newsletterDialog?.querySelector("[data-newsletter-response]");

  if (
    newsletterDialog instanceof HTMLDialogElement &&
    newsletterEmail instanceof HTMLInputElement &&
    newsletterForm instanceof HTMLFormElement &&
    newsletterSuccess instanceof HTMLElement
  ) {
    document.querySelectorAll("[data-newsletter-trigger]").forEach((trigger) => {
      trigger.addEventListener("submit", (event) => {
        event.preventDefault();

        const emailInput = trigger.querySelector('input[name="email"]');
        if (!(emailInput instanceof HTMLInputElement) || !emailInput.value.trim()) {
          return;
        }

        newsletterForm.hidden = false;
        newsletterSuccess.hidden = true;
        newsletterForm.reset();
        newsletterEmail.value = emailInput.value.trim();
        if (newsletterResponse instanceof HTMLIFrameElement) {
          newsletterResponse.hidden = true;
          newsletterResponse.src = "about:blank";
        }
        newsletterDialog.showModal();
        newsletterEmail.focus();
      });
    });

    newsletterDialog.querySelectorAll("[data-newsletter-close]").forEach((closeButton) => {
      closeButton.addEventListener("click", () => newsletterDialog.close());
    });

    newsletterDialog.addEventListener("click", (event) => {
      if (event.target === newsletterDialog) {
        newsletterDialog.close();
      }
    });

    newsletterForm.addEventListener("submit", () => {
      newsletterForm.hidden = true;
      newsletterSuccess.hidden = false;
      newsletterSuccess.focus();
      if (newsletterResponse instanceof HTMLIFrameElement) {
        newsletterResponse.hidden = true;
      }
    });
  }
</script>
