{isSlovakFooter && (
  <footer class="dnd-site-footer" aria-labelledby="site-footer-title">
    <div class="dnd-container dnd-site-footer__newsletter" aria-labelledby="footer-newsletter-title">
      <div>
        <h2 id="footer-newsletter-title">{newsletterCopy.title}</h2>
        <p>{newsletterCopy.text}</p>
      </div>
    <form class="dnd-site-footer__newsletter-form" data-newsletter-trigger>
      <label class="dnd-sr-only" for={`footer-newsletter-email-${lang}`}>{newsletterUiCopy.emailLabel}</label>
      <input id={`footer-newsletter-email-${lang}`} name="email" type="email" placeholder={newsletterUiCopy.emailPlaceholder} autocomplete="email" required />
      <button type="submit" aria-label={newsletterUiCopy.openLabel}>
        <span aria-hidden="true">→</span>
      </button>
    </form>
    </div>

    <div class="dnd-container dnd-site-footer__inner">
      <div class="dnd-site-footer__brand">
        <a href={`${homeHref}sk/`} class="dnd-site-footer__brand-link" aria-label="Dandelion ubytovanie úvod">
          <img src={footerLogoSrc} alt="Dandelion ubytovanie" width="220" height="134" />
        </a>
        <p id="site-footer-title">Pokojné penzióny a apartmány pri Balatone a v Balatonskej vrchovine.</p>
      </div>

      <nav class="dnd-site-footer__group dnd-site-footer__group--stays" aria-label="Ubytovanie">
        <h2>Ubytovanie</h2>
        <div class="dnd-site-footer__stay-columns">
          {slovakFooterStayColumns.map((column) => (
            <ul>
              {column.map((stay) => (
                <li><a href={stay.href}>{stay.label}</a></li>
              ))}
            </ul>
          ))}
        </div>
      </nav>

      <nav class="dnd-site-footer__group" aria-label="Užitočné odkazy">
        <h2>Užitočné odkazy</h2>
        <ul>
          {slovakFooterNav.map((item) => (
            <li><a href={item.href}>{item.label}</a></li>
          ))}
          <li><a href={resolvedBookingHref}>Overiť dostupnosť</a></li>
          <li><a href={resolvedBookingHref}>Rezervácia</a></li>
        </ul>
      </nav>

      <nav class="dnd-site-footer__group" aria-label="Jazyky">
        <h2>Jazyky</h2>
