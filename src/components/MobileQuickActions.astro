---

<nav class="dnd-mobile-quick-actions" aria-label={copy.groupLabel} data-dnd-mobile-quick-actions>
  <button
    class="dnd-mobile-quick-actions__button dnd-mobile-quick-actions__button--booking"
    type="button"
    aria-haspopup="dialog"
    aria-controls="dnd-mobile-booking-dialog"
    aria-expanded="false"
    aria-label={copy.bookingAria}
    data-dnd-mobile-booking-open
  >
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 3 2.6 5.3 5.9.9-4.3 4.2 1 5.9-5.2-2.8-5.2 2.8 1-5.9-4.3-4.2 5.9-.9L12 3Z" /></svg>
    <span class="dnd-mobile-quick-actions__sr-only">{copy.bookingButton}</span>
  </button>
  <a class="dnd-mobile-quick-actions__button dnd-mobile-quick-actions__button--contact" href="tel:+36207730807" aria-label={copy.phoneAria}>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.6 10.8c1.5 3 3.6 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1.1-.3 1.2.4 2.4.6 3.7.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.7 21 3 13.3 3 3.8c0-.6.4-1 1-1h3.6c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.7.1.4 0 .8-.3 1.1l-2.3 2.2Z" /></svg>
    <span class="dnd-mobile-quick-actions__sr-only">{copy.phone}</span>
  </a>
  <a class="dnd-mobile-quick-actions__button dnd-mobile-quick-actions__button--contact" href="https://wa.me/36207730807" target="_blank" rel="noopener noreferrer" aria-label={copy.whatsappAria}>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4.2 20 5.4 16.5A8.2 8.2 0 1 1 8 19l-3.8 1Z" /><path d="M9.1 8.4c.2-.4.4-.4.7-.4h.5c.2 0 .4.1.5.4l.7 1.6c.1.2.1.4 0 .6l-.5.6c-.1.1-.1.3 0 .5.5.9 1.3 1.7 2.2 2.2.2.1.4.1.5 0l.7-.6c.2-.1.4-.2.6-.1l1.6.8c.3.1.4.3.4.6v.5c0 .3-.1.5-.4.7-.5.3-1.2.5-1.9.4-3.4-.5-6.1-3.2-6.6-6.6-.1-.7.1-1.3.4-1.8Z" /></svg>
    <span class="dnd-mobile-quick-actions__sr-only">{copy.whatsapp}</span>
  </a>
</nav>

<dialog class="dnd-mobile-booking-dialog" id="dnd-mobile-booking-dialog" aria-labelledby="dnd-mobile-booking-dialog-title" aria-describedby="dnd-mobile-booking-dialog-lead" data-dnd-mobile-booking-dialog>
  <div class="dnd-mobile-booking-dialog__card">
    <button class="dnd-mobile-booking-dialog__close" type="button" aria-label={copy.dialogClose} data-dnd-mobile-booking-close>×</button>
    <span class="dnd-mobile-booking-dialog__kicker">{copy.dialogKicker}</span>
    <h2 id="dnd-mobile-booking-dialog-title">{copy.dialogTitle}</h2>
    <p id="dnd-mobile-booking-dialog-lead">{copy.dialogLead}</p>
    <ul>
      {copy.benefits.map((benefit) => <li>{benefit}</li>)}
    </ul>
  </div>
</dialog>

<script is:inline>
  (() => {
    const setup = () => {
      const openButton = document.querySelector("[data-dnd-mobile-booking-open]");
      const dialog = document.querySelector("[data-dnd-mobile-booking-dialog]");
      const closeButton = dialog?.querySelector("[data-dnd-mobile-booking-close]");

      if (!(openButton instanceof HTMLButtonElement) || !(dialog instanceof HTMLDialogElement)) {
        return;
      }

      let returnFocusElement = null;
      const setExpanded = (expanded) => openButton.setAttribute("aria-expanded", String(expanded));
      const closeDialog = () => {
        if (dialog.open) {
          dialog.close();
        }
        setExpanded(false);
        returnFocusElement?.focus?.();
        returnFocusElement = null;
      };

      openButton.addEventListener("click", () => {
        returnFocusElement = document.activeElement;
        dialog.showModal();
        setExpanded(true);
        closeButton?.focus?.();
      });
      closeButton?.addEventListener("click", closeDialog);
      dialog.addEventListener("click", (event) => {
        if (event.target === dialog) {
          closeDialog();
        }
      });
      dialog.addEventListener("close", () => {
        setExpanded(false);
        returnFocusElement?.focus?.();
        returnFocusElement = null;
      });
    };

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", setup, { once: true });
    } else {
      setup();
    }
  })();
</script>

<style>
  .dnd-mobile-quick-actions {
    display: none;
  }

  @media (max-width: 767px) {
    .dnd-mobile-quick-actions {
      position: fixed;
      right: max(14px, env(safe-area-inset-right));
      bottom: max(14px, env(safe-area-inset-bottom));
      z-index: 60;
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      gap: 8px;
      pointer-events: none;
    }

    .dnd-mobile-quick-actions__button {
      display: grid;
      place-items: center;
      flex: 0 0 auto;
      border: 1px solid rgba(255, 247, 216, 0.82);
      border-radius: 50%;
      color: #fff8e9;
      text-decoration: none;
      box-shadow: 0 10px 25px rgba(16, 13, 8, 0.24), inset 0 0 0 1px rgba(72, 46, 11, 0.28);
      pointer-events: auto;
      -webkit-tap-highlight-color: transparent;
    }

    .dnd-mobile-quick-actions__button:hover,
    .dnd-mobile-quick-actions__button:focus-visible {
      transform: translateY(-2px);
      outline: 2px solid rgba(255, 247, 216, 0.96);
      outline-offset: 3px;
    }

    .dnd-mobile-quick-actions__button--booking {
      width: 48px;
      height: 48px;
      min-height: 0;
      aspect-ratio: 1;
      padding: 0;
      background: radial-gradient(circle at 35% 28%, rgba(255, 242, 192, 0.25), transparent 34%), linear-gradient(145deg, #d3a84d 0%, #ae7d2d 52%, #8d611f 100%);
    }

    .dnd-mobile-quick-actions__button--booking svg {
      width: 20px;
      height: 20px;
      fill: rgba(255, 248, 233, 0.16);
      stroke: currentColor;
      stroke-linecap: round;
      stroke-linejoin: round;
      stroke-width: 1.35;
    }

    .dnd-mobile-quick-actions__button--contact {
      width: 48px;
      height: 48px;
      background: linear-gradient(145deg, #677257 0%, #4f5b47 100%);
    }

    .dnd-mobile-quick-actions__button--contact svg {
      width: 20px;
      height: 20px;
      fill: none;
      stroke: #fff8e9;
      stroke-linecap: round;
      stroke-linejoin: round;
      stroke-width: 1.45;
    }

    .dnd-mobile-booking-dialog {
      width: min(348px, calc(100% - 32px));
      max-width: calc(100% - 32px);
      padding: 0;
      border: 0;
      background: transparent;
      color: #2d241c;
    }

    .dnd-mobile-booking-dialog::backdrop {
      background: rgba(20, 16, 10, 0.58);
      backdrop-filter: blur(3px);
    }

    .dnd-mobile-booking-dialog__card {
      position: relative;
      padding: 24px 26px 22px;
      overflow: hidden;
      border: 1px solid rgba(255, 247, 216, 0.72);
      border-radius: 20px;
      background: linear-gradient(135deg, rgba(255, 247, 215, 0.98) 0%, rgba(244, 210, 119, 0.98) 58%, rgba(211, 161, 55, 0.98) 100%);
      box-shadow: 0 18px 44px rgba(16, 13, 8, 0.28), inset 0 1px 0 rgba(255, 255, 255, 0.34);
    }

    .dnd-mobile-booking-dialog__kicker {
      display: block;
      margin-bottom: 10px;
      font-size: 0.6rem;
      font-weight: 700;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: rgba(45, 36, 28, 0.68);
    }

    .dnd-mobile-booking-dialog h2 {
      margin: 0;
      padding-right: 28px;
      font-family: var(--dnd-font-display);
      font-size: 1.75rem;
      font-weight: 400;
      line-height: 1;
    }

    .dnd-mobile-booking-dialog p {
      margin: 10px 0 12px;
      font-size: 0.8rem;
      line-height: 1.45;
    }

    .dnd-mobile-booking-dialog ul {
      display: grid;
      gap: 0;
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .dnd-mobile-booking-dialog li {
      position: relative;
      padding: 8px 0 8px 18px;
      border-top: 1px solid rgba(45, 36, 28, 0.16);
      font-size: 0.8rem;
      line-height: 1.35;
    }

    .dnd-mobile-booking-dialog li::before {
      content: "✦";
      position: absolute;
      left: 0;
      top: 8px;
      color: rgba(109, 72, 18, 0.82);
    }

    .dnd-mobile-booking-dialog__close {
      position: absolute;
      top: 10px;
      right: 12px;
      display: grid;
      place-items: center;
      width: 32px;
      height: 32px;
      border: 1px solid rgba(45, 36, 28, 0.2);
      border-radius: 50%;
      background: rgba(255, 247, 215, 0.4);
      color: #2d241c;
      font: 400 1.35rem/1 var(--dnd-font-body);
      cursor: pointer;
    }

    .dnd-mobile-booking-dialog__close:hover,
    .dnd-mobile-booking-dialog__close:focus-visible {
      background: rgba(255, 247, 215, 0.78);
      outline: 2px solid rgba(112, 75, 18, 0.48);
      outline-offset: 2px;
    }
  }

  .dnd-mobile-quick-actions__sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
