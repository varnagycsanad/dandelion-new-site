    closingSecondary: "Rezervácia / ceny",
    stays: [
      {
        name: "Dandelion D1",
        href: "/sk/dandelion-d1/",
        bookingHref: d1SlovakPageData.bookingLink,
        image: d1SlovakPageData.hero.mobileImagePath,
        imageAlt: d1SlovakPageData.hero.fallbackAlt,
        label: "až 8 hostí",
        title: "Priestranný dom pre väčšie rodiny a skupiny",
        text: "D1 je najlepší, keď chcete viac spální, väčšie spoločné priestory a sezónny prístup k bazénu v jednom pobyte.",
