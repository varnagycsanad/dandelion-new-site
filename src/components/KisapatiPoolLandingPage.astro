      },
      {
        name: "Dandelion D2",
        href: "/sk/dandelion-d2/",
        bookingHref: d2SlovakPageData.bookingLink,
        image: requireAccommodationLocalAssetPath("d2", "card", "dandelion-d2-kisapati-card-01.webp", "sk kisapati pool landing D2 card image"),
        imageAlt: "Krytá terasa Dandelion D2 so žltými stoličkami a priamym vstupom do záhrady v Kisapáti",
        label: "4-6 hostí",
        title: "Rodinný dom s veľkou záhradou a krytou terasou",
        text: "D2 je najjednoduchšia rodinná voľba: veľký vonkajší priestor, krytá terasa a v sezóne Panorama Pool.",
        facts: ["veľká záhrada", "krytá terasa", "Panorama Pool"]
      },
      {
        name: "Dandelion Fügeház",
        href: "/sk/dandelion-fugehaz/",
        bookingHref: fugehazSlovakPageData.bookingLink,
        image: fugehazSlovakPageData.hero.mobileImagePath,
        imageAlt: fugehazSlovakPageData.hero.fallbackAlt,
        label: "4 hostia, rozšíriteľné prístelkou",
        title: "Pokojnejší terasový pobyt s výhľadom na svedecké vrchy",
        text: "Fügeház sa hodí hlavne na pokojné panoramatické dni, kde letnú atmosféru vytvára terasa a Panorama Pool.",
        facts: ["terasový pobyt", "panoráma", "Panorama Pool"]
      }
    ]
  }
} as const;

const currentPage = pageText[locale];

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: currentPage.breadcrumbHome,
        item: toAbsoluteUrl(currentPage.homePath)
      },
      {
        "@type": "ListItem",
        position: 2,
        name: currentPage.breadcrumbCurrent,
        item: toAbsoluteUrl(currentPage.pagePath)
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "@id": `${toAbsoluteUrl(currentPage.pagePath)}#collection`,
    name: currentPage.collectionName,
    url: toAbsoluteUrl(currentPage.pagePath),
    inLanguage: currentPage.schemaLanguage,
    description: currentPage.collectionDescription,
    isPartOf: {
      "@id": `${toAbsoluteUrl(currentPage.homePath)}#website`
    },
    about: currentPage.about,
    provider: {
      "@type": "LodgingBusiness",
      name: SITE_NAME,
      url: toAbsoluteUrl(currentPage.homePath)
    },
    mainEntity: {
      "@type": "ItemList",
      itemListElement: currentPage.stays.map((stay, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: stay.name,
        url: toAbsoluteUrl(stay.href)
      }))
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "@id": `${toAbsoluteUrl(currentPage.pagePath)}#faq`,
    inLanguage: currentPage.schemaLanguage,
    mainEntity: currentPage.faqItems.map((item) => ({
      "@type": "Question",
      name: item.question,
      acceptedAnswer: {
        "@type": "Answer",
        text: item.answer
      }
    }))
  }
];
---

<BaseLayout
  title={currentPage.title}
  description={currentPage.description}
  canonicalPath={currentPage.pagePath}
  lang={currentPage.lang}
  ogLocale={currentPage.ogLocale}
  ogImage={panoramaPoolHero.desktop}
  ogImageAlt={getPoolImageAlt(heroImage)}
  structuredData={structuredData}
  headerMode="transparent"
>
  <div class="pool-landing">
    <section class="pool-landing-hero">
      <picture>
        <source media="(max-width: 767px)" srcset={panoramaPoolHero.mobile} />
        <img
          class="pool-landing-hero__image"
          src={panoramaPoolHero.desktop}
          alt={getPoolImageAlt(heroImage)}
          width="1920"
          height="1280"
          decoding="async"
          fetchpriority="high"
        />
      </picture>
      <div class="pool-landing-hero__overlay" aria-hidden="true"></div>
      <div class="pool-landing-hero__content">
        <div class="dnd-container pool-landing-hero__inner">
          <p class="pool-landing__eyebrow">{currentPage.heroEyebrow}</p>
          <h1>{currentPage.heroTitle}</h1>
          <p>{currentPage.heroLead}</p>
          <div class="pool-landing-hero__actions">
            <a href="#hazak" class="pool-landing__button pool-landing__button--primary">{currentPage.primaryCta}</a>
            <a href={bookingHrefByLocale[locale]} class="pool-landing__button pool-landing__button--secondary" target="_blank" rel="noopener noreferrer">
              {currentPage.secondaryCta}
            </a>
          </div>
        </div>
      </div>
    </section>

    <section class="pool-landing-intro">
      <div class="dnd-container pool-landing-intro__layout">
        <div>
          <p class="pool-landing__eyebrow">{currentPage.introEyebrow}</p>
          <h2>{currentPage.introTitle}</h2>
        </div>
        <div class="pool-landing-intro__text">
          <p>{currentPage.introBodyOne}</p>
          <p>{currentPage.introBodyTwo}</p>
        </div>
      </div>
    </section>

    <section class="pool-landing-audience">
      <div class="dnd-container">
        <div class="pool-landing-section-head">
          <p class="pool-landing__eyebrow">{currentPage.audienceEyebrow}</p>
          <h2>{currentPage.audienceTitle}</h2>
          <p>{currentPage.audienceLead}</p>
        </div>
        <div class="pool-landing-audience__grid">
          {currentPage.audienceItems.map((item) => (
            <article>
              <h3>{item.title}</h3>
              <p>{item.answer}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="pool-landing-facts" aria-label={currentPage.factsAria}>
      <div class="dnd-container pool-landing-facts__grid">
        {currentPage.facts.map((fact) => (
          <article>
            <span>{fact.number}</span>
            <h2>{fact.title}</h2>
            <p>{fact.text}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="pool-landing-answers">
      <div class="dnd-container">
        <div class="pool-landing-section-head">
          <p class="pool-landing__eyebrow">{currentPage.answersEyebrow}</p>
          <h2>{currentPage.answersTitle}</h2>
          <p>{currentPage.answersLead}</p>
        </div>
        <div class="pool-landing-answers__grid">
          {currentPage.quickAnswerItems.map((item) => (
            <article>
              <h3>{item.question}</h3>
              <p>{item.answer}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="hazak" class="pool-landing-stays">
      <div class="dnd-container">
        <div class="pool-landing-section-head">
          <p class="pool-landing__eyebrow">{currentPage.staysEyebrow}</p>
          <h2>{currentPage.staysTitle}</h2>
          <p>{currentPage.staysLead}</p>
        </div>

        <div class="pool-landing-stays__grid">
          {currentPage.stays.map((stay) => (
            <article class="pool-landing-stay-card">
              <a href={stay.href} class="pool-landing-stay-card__media" aria-label={stay.name}>
                <img src={stay.image} alt={stay.imageAlt} loading="lazy" decoding="async" width="1200" height="900" />
              </a>
              <div class="pool-landing-stay-card__body">
                <span>{stay.label}</span>
                <h3>{stay.name}</h3>
                <h4>{stay.title}</h4>
                <p>{stay.text}</p>
                <ul aria-label={`${stay.name} ${currentPage.stayFactsLabelSuffix}`}>
                  {stay.facts.map((fact) => (
                    <li>{fact}</li>
                  ))}
                </ul>
                <div class="pool-landing-stay-card__actions">
                  <a href={stay.href}>{currentPage.detailsCta}</a>
                  <a href={stay.bookingHref} target="_blank" rel="noopener noreferrer">{currentPage.secondaryCta}</a>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="pool-landing-compare">
      <div class="dnd-container">
        <div class="pool-landing-section-head">
          <p class="pool-landing__eyebrow">{currentPage.compareEyebrow}</p>
          <h2>{currentPage.compareTitle}</h2>
          <p>{currentPage.compareLead}</p>
        </div>
        <div class="pool-landing-compare__table-wrap">
          <table class="pool-landing-compare__table">
            <thead>
              <tr>
                {currentPage.compareColumns.map((column) => (
                  <th>{column}</th>
                ))}
              </tr>
            </thead>
            <tbody>
              {currentPage.comparisonRows.map((row) => (
                <tr>
                  <th>{row.label}</th>
                  <td>{row.d1}</td>
                  <td>{row.d2}</td>
                  <td>{row.fugehaz}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section class="pool-landing-pool">
      <div class="dnd-container pool-landing-pool__layout">
        <div class="pool-landing-pool__copy">
          <p class="pool-landing__eyebrow">{currentPage.poolEyebrow}</p>
          <h2>{currentPage.poolTitle}</h2>
          <p>{currentPage.poolBody}</p>
          <a class="pool-landing__text-link" href={currentPage.panoramaPoolPath}>{currentPage.poolCta}</a>
        </div>
        <div class="pool-landing-pool__gallery" aria-label="Panorama Pool gallery">
          {teaserImages.map((image) => (
            <figure>
              <picture>
                {image.mobileSrc && <source media="(max-width: 767px)" srcset={image.mobileSrc} />}
                <img src={image.src} alt={getPoolImageAlt(image)} loading="lazy" decoding="async" width="1200" height="900" />
              </picture>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <section class="pool-landing-reasons">
      <div class="dnd-container pool-landing-reasons__layout">
        <div>
          <p class="pool-landing__eyebrow">{currentPage.reasonsEyebrow}</p>
          <h2>{currentPage.reasonsTitle}</h2>
        </div>
        <div class="pool-landing-reasons__grid">
          {currentPage.reasons.map((item) => (
            <article>
              <p>{item}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="faq" class="pool-landing-faq">
      <div class="dnd-container pool-landing-faq__layout">
        <div class="pool-landing-faq__intro">
          <p class="pool-landing__eyebrow">{currentPage.faqEyebrow}</p>
          <h2>{currentPage.faqTitle}</h2>
          <p>{currentPage.faqLead}</p>
        </div>
        <div class="pool-landing-faq__grid">
          {currentPage.faqItems.map((item) => (
            <article>
              <h3>{item.question}</h3>
              <p>{item.answer}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="pool-landing-closing">
      <div class="dnd-container pool-landing-closing__panel">
        <p class="pool-landing__eyebrow">{currentPage.closingEyebrow}</p>
        <h2>{currentPage.closingTitle}</h2>
        <p>{currentPage.closingBody}</p>
        <div class="pool-landing-closing__actions">
          <a href="#hazak" class="pool-landing__button pool-landing__button--primary">{currentPage.closingPrimary}</a>
          <a href={bookingHrefByLocale[locale]} class="pool-landing__button pool-landing__button--secondary" target="_blank" rel="noopener noreferrer">
            {currentPage.closingSecondary}
          </a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .pool-landing {
    background: #fdfbf7;
    color: #1f2937;
  }

  .pool-landing-hero {
    position: relative;
    min-height: 720px;
    height: 92vh;
    overflow: hidden;
    background: #15120e;
  }

  .pool-landing-hero__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .pool-landing-hero__overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(13, 11, 8, 0.72), rgba(13, 11, 8, 0.24) 58%, rgba(13, 11, 8, 0.16)),
      linear-gradient(180deg, rgba(13, 11, 8, 0.3), rgba(13, 11, 8, 0.66));
  }

  .pool-landing-hero__content {
    position: relative;
    z-index: 1;
    display: flex;
    min-height: 100%;
    align-items: center;
    color: #fffaf1;
  }

  .pool-landing-hero__inner {
    max-width: 1120px;
    padding-top: 132px;
  }

  .pool-landing__eyebrow {
    margin: 0 0 14px;
    color: #d99e2b;
    font-size: var(--dnd-text-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    line-height: 1.35;
    text-transform: uppercase;
  }

  .pool-landing-hero h1 {
    max-width: 14ch;
    margin: 0;
    font-family: var(--dnd-font-display);
    font-size: clamp(3rem, 6vw, 5.4rem);
    font-weight: 500;
    line-height: 0.98;
    letter-spacing: 0;
  }

  .pool-landing-hero p:not(.pool-landing__eyebrow) {
    max-width: 650px;
    margin: 22px 0 0;
    color: rgba(255, 250, 241, 0.9);
    font-size: var(--dnd-text-lead);
    line-height: 1.65;
  }

  .pool-landing-hero__actions,
  .pool-landing-closing__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 30px;
  }

  .pool-landing__button {
    display: inline-flex;
    min-height: 48px;
    align-items: center;
    justify-content: center;
    padding: 0 20px;
    border: 1px solid transparent;
    border-radius: 8px;
    font-size: var(--dnd-text-sm);
    font-weight: 700;
    line-height: 1.25;
  }

  .pool-landing__button--primary {
    background: #d99e2b;
    color: #18120b;
  }

  .pool-landing__button--secondary {
    border-color: rgba(255, 250, 241, 0.52);
    background: rgba(255, 250, 241, 0.1);
    color: #fffaf1;
  }

  .pool-landing-intro,
  .pool-landing-audience,
  .pool-landing-facts,
  .pool-landing-answers,
  .pool-landing-stays,
  .pool-landing-compare,
