# [CHANGE 2026-05-06 13:20] Serve Astro static files from the domain root.
# [CHANGE 2026-05-29 00:00] Redirect legacy WordPress URLs from Search Console coverage reports.
DirectoryIndex index.html
Options -MultiViews

<IfModule mod_mime.c>
  AddDefaultCharset UTF-8
  AddCharset UTF-8 .html .htm .css .js .mjs .json .xml .svg .txt
  AddType text/css .css
  AddType application/javascript .js .mjs
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On

  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"
  ExpiresByType application/json "access plus 1 day"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType font/otf "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 month"
  ExpiresByType video/webm "access plus 1 month"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(?:html?)$">
    Header always set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>

  <FilesMatch "^(?:asset|chunk|entry)-.*\.(?:css|js|mjs|webp|jpg|jpeg|png|svg|avif|gif|woff2?|ttf|otf)$">
    Header always set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "^(?!(?:asset|chunk|entry)-).+\.(?:css|js|mjs|webp|jpg|jpeg|png|svg|avif|gif|ico|woff2?|ttf|otf|mp4|webm)$">
    Header always set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Canonicalize the public host to the apex domain to avoid split cache/docroot behavior.
  RewriteCond %{HTTP_HOST} ^www\.dandelionhouse\.hu$ [NC]
  RewriteRule ^ https://dandelionhouse.hu%{REQUEST_URI} [L,R=301]

  # Force HTTPS for all non-secure requests.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # [CHANGE 2026-05-29 08:55] Keep legacy sitemap index URLs pointing to the live sitemap.
  RewriteRule ^sitemap[_-]index\.xml$ /sitemap.xml [R=301,L]

  # Legacy WordPress technical endpoints should disappear cleanly.
  RewriteRule ^wp-admin/ - [G,L]
  RewriteRule ^wp-json/ - [G,L]

  # Legacy home and test URLs.
  RewriteRule ^(?:home|fooldal|test|test-2|valami)/?$ /? [R=301,L]
  RewriteRule ^ipv6\.dandelionhouse\.hu/?$ /? [R=301,L]
  RewriteCond %{QUERY_STRING} ^et_core_page_resource$ [NC]
  RewriteRule ^(?:fooldal/?)?$ /? [R=301,L]

  # Legacy contact, legal and booking information URLs.
  RewriteRule ^(?:hu/)?kapcsolat-2/?$ /kapcsolat/? [R=301,L]
  RewriteRule ^(?:hu/)?arak-es-foglalasi-feltetelek/?$ /szallasok/? [R=301,L]
  RewriteRule ^altalanos-szerzodesi-feltetelek/?$ /aszf/? [R=301,L]
  RewriteRule ^adatvedelem/?$ /adatkezelesi-tajekoztato/? [R=301,L]

  # Legacy accommodation URLs.
  RewriteRule ^zsalya/?$ /dandelion-zsalya/? [R=301,L]
  RewriteRule ^koveskal/?$ /dandelion-koveskal/? [R=301,L]
  RewriteRule ^vintage/?$ /dandelion-vintage/? [R=301,L]
  RewriteRule ^fuge-vendeghaz/?$ /fuge/? [R=301,L]
  RewriteRule ^badacsonyhaz/?$ /szepvolgyi/? [R=301,L]
  RewriteRule ^dandelion-2-d2/zsalya/?$ /dandelion-zsalya/? [R=301,L]
  RewriteRule ^szallas-kisapati/?$ /szallasok/? [R=301,L]
  RewriteRule ^szallas-kisapatin-d2-(?:apartman|vendeghaz)-a-szent-gyorgy-hegy-labanal-dandelion-vendeghazak/?$ /dandelion-d2/? [R=301,L]

  # Legacy blog, category and tag URLs.
  RewriteRule ^blog/?$ /elmenyek/? [R=301,L]
  RewriteRule ^hasznos(?:-[23])?/?$ /elmenyek/? [R=301,L]
  RewriteRule ^hu/hasznos-2/?$ /elmenyek/? [R=301,L]
  RewriteRule ^project/?$ /szallasok/? [R=301,L]
  RewriteRule ^project/fooldali-haz-bemutato/?$ /szallasok/? [R=301,L]
  RewriteRule ^category/(?:kornyek|kornyek/programtippek|kornyek/turak|nevezetessegek|hegyek)/?$ /elmenyek/? [R=301,L]
  RewriteRule ^category/dandelion-hazakkal-kapcsolatos-informaciok/?$ /szallasok/? [R=301,L]
  RewriteRule ^category/dandelion-vendeghazak-szent-gyorgy-hegy-2/?$ /szallasok/? [R=301,L]
  RewriteRule ^category/egyeb-kategoria-hu/?$ /? [R=301,L]
  RewriteRule ^tag/(?:tavmunka|workation|digitalis-nomad|hosszutavu-szallas)/?(?:feed/?)?$ /szallasok/? [R=301,L]
  RewriteRule ^tag/balaton-felvidek/?$ /elmenyek/? [R=301,L]
  RewriteRule ^author/vilona/?(?:feed/?)?$ /? [R=301,L]

  # Legacy article URLs mapped to the closest current editorial pages.
  RewriteRule ^szent-gyorgy-hegyi-kirandulas/?$ /elmenyek/tanuhegyek/? [R=301,L]
  RewriteRule ^szent-gyorgy-hegy-bazaltorgonak-tura-es-panorama-a-balaton-felvideken-dandelion-vendeghazak/?$ /elmenyek/tanuhegyek/? [R=301,L]
  RewriteRule ^szureti-felvonulas-szent-gyorgy-hegy-hegymagas-raposka-kisapati-2025-okt-11-dandelion/?$ /elmenyek/bor-es-panorama/? [R=301,L]
  RewriteRule ^dolgozz-onnan-ahol-mas-nyaral-digitalis-nomad-szallas-a-balaton-felvideken/?$ /szallasok/? [R=301,L]
  RewriteRule ^digitalis-nomad-szallas-balaton-felvidek/?$ /szallasok/? [R=301,L]

  # Astro build assets should be served directly from /assets/.
  RewriteRule ^assets/ - [END]
  RewriteRule ^deploy-check\.txt$ - [END]
  RewriteRule ^favicon\.(ico|png|svg)$ - [END]

  # Serve the English Panorama Pool route through the uploaded alias file.
  RewriteRule ^en/panorama-pool/?$ en/panorama-pool.html [L]

  # Canonicalize directory routes before Apache's own directory handler runs.
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^(.+)$ /$1/ [R=301,L]

  # Serve directory-backed static routes via their concrete index.html file.
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.+?)/$ /$1/index.html [END]

  # Existing Astro build files and folders must be served directly.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [END]

  # Keep the root entry point on the static Astro index.
  RewriteRule ^$ index.html [END]
  RewriteRule ^index\.html$ - [END]
</IfModule>
