# [CHANGE 2026-05-06 13:20] Serve Astro static files from the domain root.
DirectoryIndex index.html
Options -MultiViews

<IfModule mod_mime.c>
  AddType text/css .css
  AddType application/javascript .js .mjs
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Force HTTPS for all non-secure requests.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Astro build assets should be served directly from /assets/.
  RewriteRule ^assets/ - [END]
  RewriteRule ^deploy-check\.txt$ - [END]
  RewriteRule ^favicon\.(ico|svg)$ - [END]

  # Existing Astro build files and folders must be served directly.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [END]

  # Keep the root entry point on the static Astro index.
  RewriteRule ^$ index.html [END]
  RewriteRule ^index\.html$ - [END]
</IfModule>
