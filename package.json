{
  "name": "dandelion-astro",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/postbuild-copy-static-files.mjs",
    "check:root": "node scripts/check-ujsite-deploy.mjs",
    "check:ujsite": "node scripts/check-ujsite-deploy.mjs",
    "images:dry-run": "node scripts/process-accommodation-images.mjs",
    "images:intake": "node scripts/images-intake.mjs",
    "images:select": "node scripts/images-select.mjs",
    "images:process": "node scripts/process-accommodation-images.mjs",
    "images:publish": "node scripts/images-publish.mjs",
    "preview": "astro preview",
    "speed": "npm run build && node scripts/run-lighthouse.mjs",
    "speed:view": "npm run build && node scripts/run-lighthouse.mjs --view",
    "speed:json": "npm run build && node scripts/run-lighthouse.mjs --json",
    "speed:desktop": "npm run build && node scripts/run-lighthouse.mjs --desktop",
    "speed:desktop:json": "npm run build && node scripts/run-lighthouse.mjs --desktop --json",
    "astro": "astro"
  },
  "dependencies": {
    "astro": "^6.1.5",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "lighthouse": "^13.3.0"
  }
}
