{
  "name": "dandelion-astro",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/postbuild-copy-static-files.mjs",
    "newsletter:dev": "node newsletter-service/server.mjs",
    "newsletter:start": "node newsletter-service/server.mjs",
    "check:root": "node scripts/check-ujsite-deploy.mjs",
    "check:ujsite": "node scripts/check-ujsite-deploy.mjs",
    "geo:check-auth": "node scripts/geo/check-geo-auth-env.mjs",
    "geo:create-token": "node scripts/geo/create-geo-oauth-token.mjs",
    "geo:create-gsc-token": "node scripts/geo/create-gsc-oauth-token.mjs",
    "geo:fetch:gsc": "node scripts/geo/fetch-gsc-data.mjs",
    "geo:fetch:ga4": "node scripts/geo/fetch-ga4-data.mjs",
    "geo:fetch": "node scripts/geo/fetch-geo-data.mjs",
    "meta:check": "node scripts/meta/meta-ads.mjs check-auth",
    "meta:accounts": "node scripts/meta/meta-ads.mjs accounts",
    "meta:campaigns": "node scripts/meta/meta-ads.mjs campaigns",
    "meta:insights": "node scripts/meta/meta-ads.mjs insights",
    "images:dry-run": "node scripts/process-accommodation-images.mjs",
    "images:intake": "node scripts/images-intake.mjs",
    "images:select": "node scripts/images-select.mjs",
    "images:process": "node scripts/process-accommodation-images.mjs",
    "images:publish": "node scripts/images-publish.mjs",
    "preview": "astro preview",
    "speed": "npm run build && node scripts/run-lighthouse.mjs",
    "speed:view": "npm run build && node scripts/run-lighthouse.mjs --view",
    "speed:json": "npm run build && node scripts/run-lighthouse.mjs --json",
    "speed:desktop": "npm run build && node scripts/run-lighthouse.mjs --desktop",
    "speed:desktop:json": "npm run build && node scripts/run-lighthouse.mjs --desktop --json",
    "astro": "astro"
  },
  "dependencies": {
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.1",
    "astro": "^6.1.5",
    "nodemailer": "^9.0.1",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "lighthouse": "^13.3.0"
  }
}
